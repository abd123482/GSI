  --primary-foreground: #2b2622;
  --secondary: #383330;
  --secondary-foreground: #f7f5f0;
  --muted: #383330;
  --muted-foreground: #aea69c;
  --accent: #3f3a36;
  --accent-foreground: #f7f5f0;
  --destructive: #ef4444;
  --border: #3f3a36;
  --input: #3f3a36;
