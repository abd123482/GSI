'use client';

import { useMemo } from 'react';
import { useAuth } from '@clerk/nextjs';
import { useQuery } from '@tanstack/react-query';
import { useApi } from './use-api';
import {
  REQUIRED_CREATE_PERMISSION,
  REQUIRED_UPDATE_PERMISSION,
  REQUIRED_DELETE_PERMISSION,
} from '@/services/shelf.service';

export interface AuthMeResponse {
  userId: string;
  clerkUserId: string;
  userName: string | null;
  userEmail: string | null;
  roleId: string | null;
  roleName: string | null;
  permissions: string[];
  status: string | null;
  isAdmin?: boolean;
}

export const ALL_SYSTEM_PERMISSIONS: string[] = [
  'equipment.read',
  'equipment.create',
  'equipment.update',
  'equipment.delete',
  'serial-number.read',
  'serial-number.create',
  'serial-number.update',
  'serial-number.delete',
  'movement.read',
  'movement.create',
  'shelf.read',
  'shelf.create',
  'shelf.update',
  'shelf.delete',
  'stock.read',
  'stock.create',
  'stock.update',
  'stock.delete',
  'user.manage',
  'role.manage',
  'dashboard.read',
  'inventory.read',
  'inventory.create',
  'inventory.count',
  'inventory.adjudicate',
  'inventory.launch',
  'inventory.finalize',
  'inventory.delete',
];

const EMPTY_PERMISSIONS: string[] = [];

/**
 * Hook for cached, fast authentication & authorization inspection.
 * Fetches user identity, role, and permissions from /auth/me with Clerk session token.
 * Universal bypass for ADMIN role ensures full access everywhere across the UI.
 */
export function usePermissions() {
  const { isSignedIn, isLoaded } = useAuth();
  const api = useApi();

  const { data: authUser, isLoading, error, refetch } = useQuery<AuthMeResponse>({
    queryKey: ['auth', 'me'],
    queryFn: async () => {
      const response = await api.get<AuthMeResponse>('/auth/me');
      return response.data;
    },
    enabled: !!isSignedIn && isLoaded,
    staleTime: 5 * 60 * 1000, // 5 minutes fresh
    gcTime: 10 * 60 * 1000,
  });

  const isAdmin =
    authUser?.roleName?.trim().toUpperCase() === 'ADMIN' ||
    authUser?.isAdmin === true;

  const permissions = useMemo(() => {
    if (isAdmin) {
      const set = new Set([
        ...ALL_SYSTEM_PERMISSIONS,
        ...(authUser?.permissions ?? []),
      ]);
      return Array.from(set);
    }
    return authUser?.permissions ?? EMPTY_PERMISSIONS;
  }, [authUser?.permissions, isAdmin]);

  const hasPermission = useMemo(() => {
    return (permission: string): boolean => {
      if (isAdmin) return true;
      if (!permissions || permissions.length === 0) return false;
      return permissions.includes(permission);
    };
  }, [permissions, isAdmin]);

  const canReadShelf = isAdmin || hasPermission('shelf.read');
  const canCreateShelf = isAdmin || hasPermission(REQUIRED_CREATE_PERMISSION);
  const canUpdateShelf = isAdmin || hasPermission(REQUIRED_UPDATE_PERMISSION);
  const canDeleteShelf = isAdmin || hasPermission(REQUIRED_DELETE_PERMISSION);

  const canReadStock = isAdmin || hasPermission('stock.read');
  const canCreateStock = isAdmin || hasPermission('stock.create');
  const canUpdateStock = isAdmin || hasPermission('stock.update');
  const canDeleteStock = isAdmin || hasPermission('stock.delete');

  const canReadEquipment = isAdmin || hasPermission('equipment.read');
  const canCreateEquipment =
    isAdmin ||
    hasPermission('equipment.create') ||
    hasPermission('movement.create');
  const canUpdateEquipment = isAdmin || hasPermission('equipment.update');
  const canDeleteEquipment = isAdmin || hasPermission('equipment.delete');
  const canCreateSerialNumber = isAdmin || hasPermission('serial-number.create');
  const canUpdateSerialNumber = isAdmin || hasPermission('serial-number.update');
  const canDeleteSerialNumber = isAdmin || hasPermission('serial-number.delete');

  const canManageUsers = isAdmin || hasPermission('user.manage');
  const canManageRoles = isAdmin || hasPermission('role.manage');
  const canReadDashboard = isAdmin || hasPermission('dashboard.read');

  const canReadInventory = isAdmin || hasPermission('inventory.read');
  const canCreateInventory = isAdmin || hasPermission('inventory.create');
  const canLaunchInventory = isAdmin || hasPermission('inventory.launch');
  const canCountInventory = isAdmin || hasPermission('inventory.count');
  const canAdjudicateInventory = isAdmin || hasPermission('inventory.adjudicate');
  const canFinalizeInventory = isAdmin || hasPermission('inventory.finalize');
  const canDeleteInventory = isAdmin || hasPermission('inventory.delete');

  return useMemo(
    () => ({
      user: authUser ?? null,
      authUser: authUser ?? null,
      permissions,
      roleName: authUser?.roleName ?? null,
      isAdmin,
      canReadDashboard,
      canReadEquipment,
      canReadShelf,
      canReadStock,
      canCreateShelf,
      canUpdateShelf,
      canDeleteShelf,
      canCreateStock,
      canUpdateStock,
      canDeleteStock,
      canCreateEquipment,
      canUpdateEquipment,
      canDeleteEquipment,
      canCreateSerialNumber,
      canUpdateSerialNumber,
      canDeleteSerialNumber,
      canManageUsers,
      canManageRoles,
      canReadInventory,
      canCreateInventory,
      canLaunchInventory,
      canCountInventory,
      canAdjudicateInventory,
      canFinalizeInventory,
      canDeleteInventory,
      hasPermission,
      isLoading: !isLoaded || (isSignedIn && isLoading),
      error,
      refetch,
    }),
    [
      authUser,
      permissions,
      isAdmin,
      canReadDashboard,
      canReadEquipment,
      canReadShelf,
      canReadStock,
      canCreateShelf,
      canUpdateShelf,
      canDeleteShelf,
      canCreateStock,
      canUpdateStock,
      canDeleteStock,
      canCreateEquipment,
      canUpdateEquipment,
      canDeleteEquipment,
      canCreateSerialNumber,
      canUpdateSerialNumber,
      canDeleteSerialNumber,
      canManageUsers,
      canManageRoles,
      hasPermission,
      isLoaded,
      isSignedIn,
      isLoading,
      error,
      refetch,
    ],
  );
}
</file>

<file path="src/hooks/use-serial-numbers.ts">
'use client';

import {
    keepPreviousData,
    useMutation,
    useQuery,
    useQueryClient,
} from '@tanstack/react-query';
import { toast } from 'sonner';

import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import { getErrorMessage } from '@/lib/error-message';
import {
    SerialNumberService,
    type CreateBatchSerialNumbersInput,
    type CreateSerialNumberInput,
    type SerialNumberQuery,
    type UpdateSerialNumberInput,
} from '@/services/serial-number.service';

export function useSerialNumbers(
    query: SerialNumberQuery = {},
    enabled = true,
) {
    const api = useApi();
    const { permissions } = usePermissions();

    const normalizedQuery: SerialNumberQuery = {
        page: query.page ?? 1,
        limit: query.limit ?? 20,
        serialNumberCode: query.serialNumberCode,
        serialNumberStatus: query.serialNumberStatus,
        equipmentId: query.equipmentId,
        shelfId: query.shelfId,
    };

    return useQuery({
        queryKey: ['serial-numbers', normalizedQuery],
        queryFn: () =>
            SerialNumberService.getSerialNumbers(
                api,
                normalizedQuery,
                permissions,
            ),
        enabled,
        placeholderData: keepPreviousData,
        staleTime: 20_000,
    });
}

export function useSerialNumber(
    id?: string | null,
    enabled = true,
) {
    const api = useApi();
    const { permissions } = usePermissions();

    return useQuery({
        queryKey: ['serial-numbers', 'detail', id],
        queryFn: () =>
            SerialNumberService.getSerialNumberById(
                api,
                id!,
                permissions,
            ),
        enabled: enabled && Boolean(id),
        staleTime: 30_000,
    });
}

export function useCreateSerialNumber() {
    const api = useApi();
    const queryClient = useQueryClient();
    const { permissions } = usePermissions();

    return useMutation({
        mutationFn: (input: CreateSerialNumberInput) =>
            SerialNumberService.createSerialNumber(
                api,
                input,
                permissions,
            ),

        onSuccess: async (serialNumber) => {
            await Promise.all([
                queryClient.invalidateQueries({
                    queryKey: ['serial-numbers'],
                }),
                queryClient.invalidateQueries({
                    queryKey: ['equipments'],
                }),
            ]);

            toast.success('Numéro de série créé', {
                description:
                    serialNumber.serialNumberCode ??
                    serialNumber.serialNumberId,
            });
        },

        onError: (error: unknown) => {
            toast.error('Création impossible', {
                description: getErrorMessage(
                    error,
                    'Impossible de créer le numéro de série.',
                ),
            });
        },
    });
}

export function useCreateBatchSerialNumbers() {
    const api = useApi();
    const queryClient = useQueryClient();
    const { permissions } = usePermissions();

    return useMutation({
        mutationFn: (
            input: CreateBatchSerialNumbersInput,
        ) =>
            SerialNumberService.createBatchSerialNumbers(
                api,
                input,
                permissions,
            ),

        onSuccess: async (result) => {
            await Promise.all([
                queryClient.invalidateQueries({
                    queryKey: ['serial-numbers'],
                }),
                queryClient.invalidateQueries({
                    queryKey: ['equipments'],
                }),
            ]);

            toast.success('Numéros de série créés', {
                description: `${result.count} numéro(s) enregistré(s).`,
            });
        },

        onError: (error: unknown) => {
            toast.error('Création du lot impossible', {
                description: getErrorMessage(
                    error,
                    'Impossible de créer les numéros de série.',
                ),
            });
        },
    });
}

export function useUpdateSerialNumber() {
    const api = useApi();
    const queryClient = useQueryClient();
    const { permissions } = usePermissions();

    return useMutation({
        mutationFn: ({
            id,
            input,
        }: {
            id: string;
            input: UpdateSerialNumberInput;
        }) =>
            SerialNumberService.updateSerialNumber(
                api,
                id,
                input,
                permissions,
            ),

        onSuccess: async (serialNumber) => {
            await Promise.all([
                queryClient.invalidateQueries({
                    queryKey: ['serial-numbers'],
                }),
                queryClient.invalidateQueries({
                    queryKey: [
                        'serial-numbers',
                        'detail',
                        serialNumber.serialNumberId,
                    ],
                }),
                queryClient.invalidateQueries({
                    queryKey: ['equipments'],
                }),
            ]);

            toast.success('Numéro de série mis à jour');
        },

        onError: (error: unknown) => {
            toast.error('Modification impossible', {
                description: getErrorMessage(
                    error,
                    'Impossible de modifier le numéro de série.',
                ),
            });
        },
    });
}

export function useUpdateSerialNumberStatus() {
    const api = useApi();
    const queryClient = useQueryClient();
    const { permissions } = usePermissions();

    return useMutation({
        mutationFn: ({
            id,
            serialNumberStatus,
        }: {
            id: string;
            serialNumberStatus: string;
        }) =>
            SerialNumberService.updateSerialNumberStatus(
                api,
                id,
                serialNumberStatus,
                permissions,
            ),

        onSuccess: async (serialNumber) => {
            await Promise.all([
                queryClient.invalidateQueries({
                    queryKey: ['serial-numbers'],
                }),
                queryClient.invalidateQueries({
                    queryKey: [
                        'serial-numbers',
                        'detail',
                        serialNumber.serialNumberId,
                    ],
                }),
                queryClient.invalidateQueries({
                    queryKey: ['equipments'],
                }),
            ]);
        },

        onError: (error: unknown) => {
            toast.error('Modification du statut impossible', {
                description: getErrorMessage(
                    error,
                    'Impossible de modifier le statut.',
                ),
            });
        },
    });
}

export function useDeleteSerialNumber() {
    const api = useApi();
    const queryClient = useQueryClient();
    const { permissions } = usePermissions();

    return useMutation({
        mutationFn: (id: string) =>
            SerialNumberService.deleteSerialNumber(
                api,
                id,
                permissions,
            ),

        onSuccess: async () => {
            await Promise.all([
                queryClient.invalidateQueries({
                    queryKey: ['serial-numbers'],
                }),
                queryClient.invalidateQueries({
                    queryKey: ['equipments'],
                }),
                queryClient.invalidateQueries({
                    queryKey: ['shelves'],
                }),
            ]);

            toast.success('Numéro de série supprimé');
        },

        onError: (error: unknown) => {
            toast.error('Suppression impossible', {
                description: getErrorMessage(
                    error,
                    'Le numéro de série ne peut pas être supprimé.',
                ),
            });
        },
    });
}
