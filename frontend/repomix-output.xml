<file path="src/components/shelf/ShelfDetailModal.tsx">
'use client';

import { useEffect, useMemo, useState, type ReactNode } from 'react';
import {
  Boxes,
  ChevronDown,
  ChevronRight,
  Hash,
  Layers,
  Loader2,
  Package,
  RefreshCw,
  Warehouse,
  X,
} from 'lucide-react';

import type { Shelf } from '@/types/shelf';
import type { SerialNumber } from '@/types/equipment';
import { useShelfContents } from '@/hooks/use-shelves';

interface ShelfDetailModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  isLoading?: boolean;
}

export function ShelfDetailModal({ shelf, isOpen, onClose, onRefresh, isLoading = false }: ShelfDetailModalProps) {
  const [expanded, setExpanded] = useState<Set<string>>(new Set());

  useEffect(() => {
    setExpanded(new Set());
  }, [shelf?.shelfId, isOpen]);

  const contentsQuery = useShelfContents(shelf?.shelfId, isOpen);

  const serialsByEquipment = useMemo(() => {
    const map = new Map<string, SerialNumber[]>();
    for (const serial of contentsQuery.data?.serialNumbers ?? []) {
      if (!serial.equipmentId) continue;
      const list = map.get(serial.equipmentId) ?? [];
      list.push(serial);
      map.set(serial.equipmentId, list);
    }
    return map;
  }, [contentsQuery.data]);

  if (!isOpen || !shelf) return null;

  const allocations = contentsQuery.data?.allocations ?? [];
  const busy = isLoading || contentsQuery.isFetching;

  function toggle(equipmentId: string) {
    setExpanded((current) => {
      const next = new Set(current);
      if (next.has(equipmentId)) next.delete(equipmentId);
      else next.add(equipmentId);
      return next;
    });
  }

  async function refresh() {
    await contentsQuery.refetch();
    onRefresh?.();
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-5 py-4">
          <div>
            <h2 className="text-base font-semibold">{shelf.shelfName ?? 'Emplacement sans nom'}</h2>
            <p className="mt-0.5 flex items-center gap-1.5 text-[10px] text-white/45"><Warehouse className="h-3 w-3" />{shelf.stock?.stockName ?? 'Stock'}</p>
          </div>
          <div className="flex gap-1">
            <button type="button" onClick={refresh} disabled={busy} className="rounded p-2 text-white/60 hover:bg-white/10 disabled:opacity-40" title="Actualiser"><RefreshCw className={`h-4 w-4 ${busy ? 'animate-spin' : ''}`} /></button>
            <button type="button" onClick={onClose} className="rounded p-2 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
          </div>
        </header>

        <div className="flex-1 overflow-y-auto p-5">
          <div className="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <InfoBox label="Quantité actuelle" value={`${shelf.shelfQuantity} u.`} icon={<Hash className="h-3.5 w-3.5" />} />
            <InfoBox label="Stock" value={shelf.stock?.stockName ?? 'Stock'} icon={<Warehouse className="h-3.5 w-3.5" />} />
            <InfoBox label="Statut stock" value={shelf.stock?.stockStatus?.stockStatusName ?? 'ACTIVE'} icon={<Layers className="h-3.5 w-3.5" />} />
          </div>

          <section className="overflow-hidden rounded-lg border border-[#3f3a36]">
            <div className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-4 py-3">
              <h3 className="flex items-center gap-1.5 text-xs font-semibold"><Boxes className="h-3.5 w-3.5" />Articles présents</h3>
              <span className="text-[10px] text-white/45">{allocations.length} article{allocations.length > 1 ? 's' : ''}</span>
            </div>

            {contentsQuery.isLoading ? (
              <div className="flex items-center justify-center gap-2 py-12 text-xs text-white/45"><Loader2 className="h-4 w-4 animate-spin" />Chargement...</div>
            ) : contentsQuery.isError ? (
              <div className="m-4 rounded-lg border border-rose-500/30 bg-rose-950/25 p-4 text-xs text-rose-200">Impossible de charger le contenu de cet emplacement.</div>
            ) : allocations.length === 0 ? (
              <div className="m-4 flex min-h-32 items-center justify-center rounded-lg border border-dashed border-[#4b4540] bg-[#2b2622]/45 p-6 text-center text-sm text-[#c9c0ad]">Aucun article dans cet emplacement.</div>
            ) : (
              <div className="divide-y divide-[#3f3a36]">
                {allocations.map((allocation) => {
                  const equipment = allocation.equipment;
                  const serialized = Boolean(equipment?.hasSerialNumber);
                  const serials = serialsByEquipment.get(allocation.equipmentId) ?? [];
                  const open = expanded.has(allocation.equipmentId);

                  return (
                    <div key={allocation.equipmentShelfId} className="bg-[#383330]">
                      <button
                        type="button"
                        onClick={() => serialized && toggle(allocation.equipmentId)}
                        className={`flex w-full items-center justify-between gap-3 px-4 py-3 text-left ${serialized ? 'cursor-pointer hover:bg-[#2f2a26]' : 'cursor-default'}`}
                      >
                        <div className="flex min-w-0 items-center gap-3">
                          <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded border border-[#48423d] bg-[#2b2622]"><Package className="h-4 w-4 text-[#dad2c1]" /></div>
                          <div className="min-w-0">
                            <p className="truncate text-xs font-semibold">{equipment?.equipmentName ?? 'Article'}</p>
                            <div className="mt-1 flex flex-wrap items-center gap-2 text-[10px] text-white/45">
                              <span>{serialized ? 'Sérialisé' : 'Standard'}</span><span>•</span><span>{equipment?.equipmentStatus ?? 'ACTIVE'}</span>
                              {serialized && <><span>•</span><span>{serials.length} série{serials.length > 1 ? 's' : ''}</span></>}
                            </div>
                          </div>
                        </div>
                        <div className="flex items-center gap-3">
                          <span className="rounded border border-[#45403c] bg-[#2b2622] px-2 py-1 font-mono text-[11px]">{allocation.equipmentQuantity} u.</span>
                          {serialized && (open ? <ChevronDown className="h-4 w-4 text-[#aea69c]" /> : <ChevronRight className="h-4 w-4 text-[#aea69c]" />)}
                        </div>
                      </button>

                      {serialized && open && (
                        <div className="border-t border-[#3f3a36] bg-[#2b2622]/55 px-4 py-3">
                          {serials.length === 0 ? (
                            <p className="text-[11px] text-[#aea69c]">Aucun numéro de série n’est actuellement alloué à cet article dans cet emplacement.</p>
                          ) : (
                            <div className="ml-5 space-y-1.5 border-l border-[#4a4540] pl-4">
                              {serials.map((serial) => (
                                <div key={serial.serialNumberId} className="rounded border border-[#403b37] bg-[#383330]/60 px-3 py-2">
                                  <p className="truncate font-mono text-[11px] font-semibold text-[#f7f5f0]">{serial.serialNumberCode ?? 'Série'}</p>
                                  <p className="mt-0.5 text-[9px] text-[#aea69c]">{serial.serialNumberStatus ?? '—'}</p>
                                </div>
                              ))}
                            </div>
                          )}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </section>
        </div>

        <footer className="flex justify-end border-t border-[#3f3a36] bg-[#2b2622] px-5 py-3">
          <button type="button" onClick={onClose} className="rounded bg-[#f7f5f0] px-4 py-2 text-xs font-medium text-[#2b2622]">Fermer</button>
        </footer>
      </div>
    </div>
  );
}

function InfoBox({ label, value, icon }: { label: string; value: string; icon: ReactNode }) {
  return (
    <div className="rounded-lg border border-[#3f3a36] bg-[#2b2622]/65 p-3">
      <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-white/40">{icon}{label}</div>
      <p className="mt-2 truncate text-xs font-medium">{value}</p>
    </div>
  );
}
</file>

<file path="src/components/shelf/ShelfListTable.tsx">
'use client';

import { useMemo } from 'react';
import {
  Boxes,
  ChevronLeft,
  ChevronRight,
  Eye,
  Hash,
  Layers,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  Trash2,
  Warehouse,
} from 'lucide-react';

import type { Shelf } from '@/types/shelf';

interface ShelfListTableProps {
  shelves: Shelf[];
  totalShelves: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  onSearchChange: (search: string) => void;
  onPageChange: (page: number) => void;
  onLimitChange: (limit: number) => void;
  onSelectShelf: (shelf: Shelf) => void;
  onOpenUpdate?: (shelf: Shelf) => void;
  onOpenDelete?: (shelf: Shelf) => void;
  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateShelf: boolean;
  canUpdateShelf?: boolean;
  canDeleteShelf?: boolean;
}

export function ShelfListTable({
  shelves,
  totalShelves,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  onSearchChange,
  onPageChange,
  onLimitChange,
  onSelectShelf,
  onOpenUpdate,
  onOpenDelete,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateShelf,
  canUpdateShelf = true,
  canDeleteShelf = true,
}: ShelfListTableProps) {
  const startItem = totalShelves === 0 ? 0 : (currentPage - 1) * limit + 1;
  const endItem = Math.min(currentPage * limit, totalShelves);

  const pageNumbers = useMemo(() => {
    const start = Math.max(1, currentPage - 2);
    const end = Math.min(totalPages, start + 4);
    return Array.from({ length: Math.max(0, end - start + 1) }, (_, i) => start + i);
  }, [currentPage, totalPages]);

  return (
    <div className="overflow-hidden rounded-lg border border-[#3f3a36] bg-[#383330]">
      <div className="flex flex-col gap-3 border-b border-[#3f3a36] p-3 lg:flex-row lg:items-center lg:justify-between">
        <div className="relative w-full max-w-lg">
          <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#aea69c]" />
          <input
            value={searchTerm}
            onChange={(event) => onSearchChange(event.target.value)}
            placeholder="Rechercher par nom d’emplacement..."
            className="h-9 w-full rounded border border-[#3f3a36] bg-[#2b2622] pl-9 pr-3 text-xs text-[#f7f5f0] outline-none placeholder:text-[#aea69c] focus:border-[#dad2c1]"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <select
            value={limit}
            onChange={(event) => onLimitChange(Number(event.target.value))}
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-2 text-xs text-[#f7f5f0]"
          >
            <option value={6}>6 / page</option>
            <option value={12}>12 / page</option>
            <option value={24}>24 / page</option>
            <option value={48}>48 / page</option>
          </select>

          <button type="button" onClick={onRefresh} disabled={isLoading} className="inline-flex h-9 items-center gap-1.5 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs text-[#dad2c1] disabled:opacity-40">
            <RefreshCw className={`h-3.5 w-3.5 ${isLoading ? 'animate-spin' : ''}`} />
            Actualiser
          </button>

          {canCreateShelf && (
            <button type="button" onClick={onOpenCreateModal} className="inline-flex h-9 items-center gap-1.5 rounded bg-[#f7f5f0] px-3 text-xs font-semibold text-[#2b2622]">
              <Plus className="h-3.5 w-3.5" />Nouvel emplacement
            </button>
          )}
        </div>
      </div>

      <div className="p-4">
        {isLoading && shelves.length === 0 ? (
          <div className="flex min-h-48 items-center justify-center gap-2 text-xs text-[#aea69c]">
            <RefreshCw className="h-4 w-4 animate-spin" />Chargement des emplacements...
          </div>
        ) : shelves.length === 0 ? (
          <div className="flex min-h-48 flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-[#4b4540] bg-[#2b2622]/45 p-6 text-center">
            <Boxes className="h-7 w-7 text-[#aea69c]" />
            <p className="text-sm font-medium text-[#f7f5f0]">Aucun emplacement disponible</p>
            <p className="text-xs text-[#aea69c]">{searchTerm ? 'Aucun emplacement ne correspond à cette recherche.' : 'Créez un emplacement dans un stock ACTIVE.'}</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {shelves.map((shelf, index) => {
              const globalIndex = (currentPage - 1) * limit + index + 1;
              const stockStatus = shelf.stock?.stockStatus?.stockStatusName ?? 'ACTIVE';

              return (
                <article key={shelf.shelfId} className="group overflow-hidden rounded-lg border border-[#45403c] bg-[#2b2622] transition hover:border-[#6b625b]">
                  <button type="button" onClick={() => onSelectShelf(shelf)} className="w-full p-4 text-left">
                    <div className="flex items-start justify-between gap-3">
                      <div className="flex min-w-0 items-start gap-3">
                        <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#4a4540] bg-[#383330]">
                          <Layers className="h-5 w-5 text-[#dad2c1]" />
                        </div>
                        <div className="min-w-0">
                          <h3 className="truncate text-sm font-semibold text-[#f7f5f0]">{shelf.shelfName ?? 'Emplacement sans nom'}</h3>
                          <p className="mt-1 flex items-center gap-1.5 truncate text-[11px] text-[#aea69c]">
                            <Warehouse className="h-3 w-3 shrink-0" />{shelf.stock?.stockName ?? 'Stock'}
                          </p>
                        </div>
                      </div>
                      <span className="rounded border border-[#4a4540] bg-[#383330] px-1.5 py-0.5 font-mono text-[10px] text-[#aea69c]">#{String(globalIndex).padStart(2, '0')}</span>
                    </div>

                    <div className="mt-4 grid grid-cols-2 gap-2">
                      <div className="rounded border border-[#403b37] bg-[#383330]/65 p-2.5">
                        <p className="text-[10px] uppercase tracking-wide text-[#8f867d]">Quantité</p>
                        <p className="mt-1 flex items-center gap-1.5 font-mono text-sm font-semibold"><Hash className="h-3.5 w-3.5 text-[#aea69c]" />{shelf.shelfQuantity}</p>
                      </div>
                      <div className="rounded border border-[#403b37] bg-[#383330]/65 p-2.5">
                        <p className="text-[10px] uppercase tracking-wide text-[#8f867d]">Stock</p>
                        <p className={`mt-1 text-xs font-semibold ${stockStatus === 'ACTIVE' ? 'text-emerald-300' : 'text-amber-300'}`}>{stockStatus}</p>
                      </div>
                    </div>
                  </button>

                  <div className="flex items-center justify-end gap-1 border-t border-[#403b37] px-3 py-2">
                    <button type="button" onClick={() => onSelectShelf(shelf)} className="rounded p-2 text-[#aea69c] hover:bg-[#383330] hover:text-white" title="Voir"><Eye className="h-3.5 w-3.5" /></button>
                    {onOpenUpdate && (
                      <button type="button" onClick={() => onOpenUpdate(shelf)} disabled={!canUpdateShelf} className="rounded p-2 text-[#aea69c] hover:bg-[#383330] hover:text-white disabled:opacity-30" title="Modifier"><Pencil className="h-3.5 w-3.5" /></button>
                    )}
                    {onOpenDelete && (
                      <button type="button" onClick={() => onOpenDelete(shelf)} disabled={!canDeleteShelf} className="rounded p-2 text-rose-300 hover:bg-rose-950/25 disabled:opacity-30" title="Supprimer"><Trash2 className="h-3.5 w-3.5" /></button>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>

      <div className="flex flex-col gap-3 border-t border-[#3f3a36] bg-[#2b2622] px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <p className="text-[11px] text-[#aea69c]">{startItem}–{endItem} sur {totalShelves} emplacement{totalShelves > 1 ? 's' : ''}</p>
        <div className="flex items-center gap-1">
          <button type="button" disabled={currentPage <= 1} onClick={() => onPageChange(currentPage - 1)} className="rounded border border-[#3f3a36] p-2 text-[#aea69c] disabled:opacity-30"><ChevronLeft className="h-3.5 w-3.5" /></button>
          {pageNumbers.map((page) => (
            <button type="button" key={page} onClick={() => onPageChange(page)} className={`h-8 min-w-8 rounded border px-2 text-xs ${page === currentPage ? 'border-[#dad2c1] bg-[#f7f5f0] text-[#2b2622]' : 'border-[#3f3a36] text-[#aea69c]'}`}>{page}</button>
          ))}
          <button type="button" disabled={currentPage >= totalPages} onClick={() => onPageChange(currentPage + 1)} className="rounded border border-[#3f3a36] p-2 text-[#aea69c] disabled:opacity-30"><ChevronRight className="h-3.5 w-3.5" /></button>
        </div>
      </div>
    </div>
  );
}
