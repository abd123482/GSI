<file path="src/components/navigation/NotificationBell.tsx">
'use client';

import { useState } from 'react';
import { Bell, CheckCheck, ExternalLink, Inbox, Loader2 } from 'lucide-react';
import { useRouter } from 'next/navigation';
import {
  useNotifications,
  useUnreadNotificationsCount,
  useMarkNotificationRead,
  useMarkAllNotificationsRead,
  AppNotification,
} from '@/hooks/use-notifications';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';

export function NotificationBell() {
  const router = useRouter();
  const [open, setOpen] = useState(false);

  const { data: notifications, isLoading } = useNotifications();
  const { data: unreadData } = useUnreadNotificationsCount();
  const { mutateAsync: markRead } = useMarkNotificationRead();
  const { mutateAsync: markAllRead, isPending: isMarkingAll } = useMarkAllNotificationsRead();

  const unreadCount = unreadData?.count ?? 0;

  const handleNotificationClick = async (notif: AppNotification) => {
    try {
      if (!notif.readAt) {
        await markRead(notif.notificationId);
      }
    } catch {
      // Non-blocking
    }

    setOpen(false);

    const isTask =
      notif.eventType === 'INVENTORY_TASK_AVAILABLE' ||
      notif.eventType === 'INVENTORY_COUNT_REQUIRED' ||
      notif.eventType === 'INVENTORY_THIRD_COUNT_REQUIRED' ||
      notif.eventType === 'TASK';

    const isAdjudication =
      notif.eventType === 'INVENTORY_ADJUDICATION_ASSIGNED' ||
      notif.eventType === 'INVENTORY_ADJUDICATION_REQUIRED';

    if (notif.payload?.taskId) {
      router.push(`/inventory/tasks/${notif.payload.taskId}`);
    } else if (isAdjudication && notif.payload?.unitId) {
      router.push(`/inventory/adjudicate/${notif.payload.unitId}`);
    } else if (isTask) {
      router.push('/inventory/tasks');
    } else if (notif.payload?.unitId) {
      router.push(`/inventory/adjudicate/${notif.payload.unitId}`);
    } else if (notif.payload?.inventoryId) {
      router.push(`/inventory/${notif.payload.inventoryId}`);
    } else {
      router.push('/inventory/tasks');
    }
  };


  return (
    <DropdownMenu open={open} onOpenChange={setOpen}>
      <DropdownMenuTrigger
        aria-label="Notifications"
        className="relative p-2 rounded-[3px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#383330] border border-transparent hover:border-[#3f3a36] transition-colors cursor-pointer outline-none focus:ring-1 focus:ring-[#10b981]"
      >
        <Bell className="w-4 h-4" />
        {unreadCount > 0 && (
          <span className="absolute -top-0.5 -right-0.5 min-w-[17px] h-[17px] px-1 bg-[#10b981] text-[#1f1b18] text-[10px] font-bold rounded-full flex items-center justify-center font-mono shadow-sm animate-pulse">
            {unreadCount > 9 ? '9+' : unreadCount}
          </span>
        )}
      </DropdownMenuTrigger>

      <DropdownMenuContent
        align="end"
        className="w-80 sm:w-96 bg-[#26221f] border border-[#3f3a36] rounded-[4px] p-0 shadow-xl text-[#f7f5f0] z-50 overflow-hidden"
      >
        {/* Header */}
        <div className="p-3 border-b border-[#3f3a36] flex items-center justify-between bg-[#2f2a26]">
          <div className="flex items-center gap-2">
            <Bell className="w-3.5 h-3.5 text-[#10b981]" />
            <span className="text-xs font-semibold uppercase tracking-wider text-[#f7f5f0]">
              Notifications
            </span>
            {unreadCount > 0 && (
              <span className="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/40">
                {unreadCount} non lue(s)
              </span>
            )}
          </div>

          {unreadCount > 0 && (
            <button
              type="button"
              disabled={isMarkingAll}
              onClick={async (e) => {
                e.preventDefault();
                await markAllRead();
              }}
              className="text-[11px] text-[#aea69c] hover:text-[#10b981] flex items-center gap-1 cursor-pointer transition-colors"
            >
              <CheckCheck className="w-3 h-3" />
              <span>Tout marquer lu</span>
            </button>
          )}
        </div>

        {/* Notifications List */}
        <div className="max-h-80 overflow-y-auto divide-y divide-[#383330]">
          {isLoading ? (
            <div className="p-6 text-center text-xs text-[#aea69c] flex items-center justify-center gap-2">
              <Loader2 className="w-4 h-4 animate-spin" />
              <span>Chargement des alertes...</span>
            </div>
          ) : !notifications || notifications.length === 0 ? (
            <div className="p-8 text-center space-y-1.5">
              <Inbox className="w-6 h-6 text-[#5c544d] mx-auto" />
              <p className="text-xs text-[#aea69c]">Aucune notification pour le moment.</p>
              <p className="text-[11px] text-[#6a625b]">
                Vous recevrez une alerte dès qu'un autre compteur termine son unité de comptage.
              </p>
            </div>
          ) : (
            notifications.map((n) => {
              const isUnread = !n.readAt;
              const hasLink = !!(n.payload?.taskId || n.payload?.inventoryId);

              return (
                <div
                  key={n.notificationId}
                  onClick={() => handleNotificationClick(n)}
                  className={`p-3 transition-colors cursor-pointer flex items-start gap-2.5 ${
                    isUnread ? 'bg-[#10b981]/10 hover:bg-[#10b981]/15' : 'hover:bg-[#2f2a26]'
                  }`}
                >
                  <div className="mt-1 shrink-0">
                    <span
                      className={`block w-2 h-2 rounded-full ${
                        isUnread ? 'bg-[#10b981]' : 'bg-[#5c544d]'
                      }`}
                    />
                  </div>

                  <div className="flex-1 min-w-0 space-y-1">
                    <div className="flex items-center justify-between gap-1">
                      <span className="text-xs font-semibold text-[#f7f5f0] truncate block">
                        {n.payload?.title || 'Notification d’inventaire'}
                      </span>
                      <span className="text-[10px] font-mono text-[#8a8075] shrink-0">
                        {new Date(n.createdAt).toLocaleTimeString([], {
                          hour: '2-digit',
                          minute: '2-digit',
                        })}
                      </span>
                    </div>

                    <p className="text-[11px] text-[#aea69c] leading-relaxed">
                      {n.payload?.message}
                    </p>

                    {hasLink && (
                      <div className="pt-0.5 flex items-center gap-1 text-[10px] font-mono text-[#10b981]">
                        <span>Cliquer pour ouvrir la tâche</span>
                        <ExternalLink className="w-2.5 h-2.5" />
                      </div>
                    )}
                  </div>
                </div>
              );
            })
          )}
        </div>
      </DropdownMenuContent>
    </DropdownMenu>
  );
}
</file>

<file path="src/components/shelf/CreateShelfModal.tsx">
'use client';

import { useEffect, useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AlertCircle, Info, Layers, Loader2, Plus, Warehouse, X } from 'lucide-react';

import { createShelfSchema, type CreateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import type { Stock } from '@/types/stock';
import { getErrorMessage } from '@/lib/error-message';

interface CreateShelfModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function CreateShelfModal({ isOpen, onClose, onSuccess }: CreateShelfModalProps) {
  const api = useApi();
  const { createShelf, isCreating } = useShelves({ enabled: false });
  const { canCreateShelf } = usePermissions();
  const [stocks, setStocks] = useState<Stock[]>([]);
  const [loadingStocks, setLoadingStocks] = useState(false);
  const [serverError, setServerError] = useState<string | null>(null);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<CreateShelfFormValues>({
    resolver: zodResolver(createShelfSchema),
    defaultValues: { shelfName: '', stockId: '' },
  });

  useEffect(() => {
    if (!isOpen) return;
    let active = true;
    setLoadingStocks(true);
    setServerError(null);

    StockService.getActiveStocks(api, { page: 1, limit: 100 })
      .then((result) => {
        if (active) setStocks(result.stocks);
      })
      .catch((cause: unknown) => {
        if (!active) return;
        setStocks([]);
        setServerError(
          getErrorMessage(cause, 'Impossible de charger les stocks actifs.'),
        );
      })
      .finally(() => {
        if (active) setLoadingStocks(false);
      });

    return () => {
      active = false;
    };
  }, [api, isOpen]);

  useEffect(() => {
    if (!isOpen) reset({ shelfName: '', stockId: '' });
  }, [isOpen, reset]);

  if (!isOpen) return null;

  const busy = isCreating || isSubmitting;

  async function submit(values: CreateShelfFormValues) {
    setServerError(null);
    if (!canCreateShelf) {
      setServerError("Permission 'shelf.create' requise.");
      return;
    }

    try {
      await createShelf({
        shelfName: values.shelfName.trim(),
        stockId: values.stockId,
      });
      reset({ shelfName: '', stockId: '' });
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setServerError(
        getErrorMessage(cause, 'Échec de la création de l’emplacement.'),
      );
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-lg overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-5 py-4">
          <h2 className="flex items-center gap-2 text-sm font-semibold">
            <Layers className="h-4 w-4" />
            Nouvel emplacement
          </h2>
          <button type="button" onClick={onClose} disabled={busy} className="rounded p-1.5 text-white/60 hover:bg-white/10 hover:text-white">
            <X className="h-4 w-4" />
          </button>
        </header>

        <form onSubmit={handleSubmit(submit)} className="space-y-4 p-5">
          {serverError && (
            <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/40 p-3 text-xs text-rose-200">
              <AlertCircle className="h-4 w-4 shrink-0" />
              {serverError}
            </div>
          )}

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Nom de l’emplacement *</span>
            <input
              {...register('shelfName')}
              placeholder="Ex: Rayon A-01"
              className="h-10 w-full rounded-lg border border-[#3f3a36] bg-[#2b2622] px-3 text-xs outline-none focus:border-white/50"
            />
            {errors.shelfName && <p className="text-[11px] text-rose-300">{errors.shelfName.message}</p>}
          </label>

          <label className="block space-y-1.5">
            <span className="flex items-center gap-1.5 text-xs font-semibold">
              <Warehouse className="h-3.5 w-3.5" />
              Stock actif *
            </span>
            <select
              {...register('stockId')}
              disabled={busy || loadingStocks}
              className="h-10 w-full rounded-lg border border-[#3f3a36] bg-[#2b2622] px-3 text-xs outline-none focus:border-white/50"
            >
              <option value="">Sélectionnez un stock actif</option>
              {stocks.map((stock) => (
                <option key={stock.stockId} value={stock.stockId}>
                  {stock.stockName ?? 'Stock sans nom'}
                </option>
              ))}
            </select>
            {errors.stockId && <p className="text-[11px] text-rose-300">{errors.stockId.message}</p>}
          </label>

          {!loadingStocks && stocks.length === 0 && (
            <div className="rounded-lg border border-amber-400/25 bg-amber-400/10 p-3 text-[11px] text-amber-100">
              Aucun stock ACTIVE n’est disponible. Activez ou créez un stock avant de créer un emplacement.
            </div>
          )}

          <div className="flex gap-2 rounded-lg border border-sky-400/20 bg-sky-400/5 p-3 text-[11px] text-sky-100">
            <Info className="mt-0.5 h-4 w-4 shrink-0" />
            <p>Un emplacement doit toujours appartenir à un stock ACTIVE. Sa quantité physique démarre à 0 et change uniquement via les mouvements.</p>
          </div>

          <footer className="flex justify-end gap-2 border-t border-[#3f3a36] pt-4">
            <button type="button" onClick={onClose} disabled={busy} className="rounded border border-[#3f3a36] px-4 py-2 text-xs">Annuler</button>
            <button
              type="submit"
              disabled={busy || !canCreateShelf || stocks.length === 0}
              className="inline-flex items-center gap-1.5 rounded bg-[#f7f5f0] px-4 py-2 text-xs font-semibold text-[#2b2622] disabled:opacity-40"
            >
              {busy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Plus className="h-3.5 w-3.5" />}
              Créer
            </button>
          </footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/shelf/DeleteShelfModal.tsx">
'use client';

import { useState } from 'react';
import { AlertTriangle, Loader2, ShieldAlert, Trash2, X } from 'lucide-react';

import type { Shelf } from '@/types/shelf';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { getErrorMessage } from '@/lib/error-message';

interface DeleteShelfModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function DeleteShelfModal({ shelf, isOpen, onClose, onSuccess }: DeleteShelfModalProps) {
  const { deleteShelf, isDeleting } = useShelves({ enabled: false });
  const { canDeleteShelf } = usePermissions();
  const [error, setError] = useState<string | null>(null);

  if (!isOpen || !shelf) return null;

  async function handleDelete() {
    setError(null);
    if (!canDeleteShelf) {
      setError("Permission 'shelf.delete' requise.");
      return;
    }

    try {
      await deleteShelf(shelf!.shelfId);
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setError(getErrorMessage(cause, 'Impossible de supprimer cet emplacement.'));
    }
  }

  return (
    <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-md overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-5 py-4">
          <h2 className="flex items-center gap-2 text-sm font-semibold"><Trash2 className="h-4 w-4 text-rose-300" />Supprimer l’emplacement</h2>
          <button type="button" onClick={onClose} className="rounded p-1.5 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
        </header>

        <div className="space-y-4 p-5">
          {error && <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/40 p-3 text-xs text-rose-200"><ShieldAlert className="h-4 w-4 shrink-0" />{error}</div>}
          <div className="flex gap-2.5 rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-[11px] text-amber-100">
            <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
            <div className="space-y-1"><p className="font-semibold">Suppression protégée.</p><p>Le backend refusera la suppression si l’emplacement contient du stock, un numéro de série ou un historique de mouvements.</p></div>
          </div>
          <div className="rounded-lg border border-[#3f3a36] bg-[#2b2622]/65 p-3 text-xs">
            <p className="font-semibold">{shelf.shelfName ?? 'Emplacement sans nom'}</p>
            <p className="mt-2 text-white/55">Quantité actuelle : <strong className="font-mono text-white">{shelf.shelfQuantity}</strong></p>
          </div>
        </div>

        <footer className="flex justify-end gap-2 border-t border-[#3f3a36] bg-[#2b2622] px-5 py-3">
          <button type="button" onClick={onClose} disabled={isDeleting} className="rounded border border-[#3f3a36] px-3 py-1.5 text-xs">Annuler</button>
          <button type="button" onClick={handleDelete} disabled={isDeleting || !canDeleteShelf} className="inline-flex items-center gap-1.5 rounded bg-rose-600 px-3.5 py-1.5 text-xs disabled:opacity-40">
            {isDeleting && <Loader2 className="h-3.5 w-3.5 animate-spin" />}Supprimer
          </button>
        </footer>
      </div>
    </div>
  );
}
