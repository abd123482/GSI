        REQUIRED_DELETE_PERMISSION,
        `Permission refusée : Vous n'avez pas le droit '${REQUIRED_DELETE_PERMISSION}' pour supprimer cet emplacement.`,
      );
    }

    try {
      const response = await client.delete<Shelf>(`/shelves/${id}`);
