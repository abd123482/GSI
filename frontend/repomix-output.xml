                  className="p-1.5 text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#2b2622] rounded-[3px] transition-colors cursor-pointer"
                  title="Modifier le rôle"
                >
                  <Edit2 className="w-3.5 h-3.5" />
                </button>
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
}
