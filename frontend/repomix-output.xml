<file path="src/components/equipment/CreateMovementModal.tsx">
"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import {
  AlertCircle,
  ArrowRightLeft,
  Check,
  Loader2,
  Plus,
  Search,
  Trash2,
  X,
} from "lucide-react";
import type { Equipment } from "@/types/equipment";
import { useEquipments } from "@/hooks/use-equipments";
import { useShelves } from "@/hooks/use-shelves";
import { getErrorMessage } from "@/lib/error-message";
import {
  buildMovementItems,
  createMovementDraft,
  type MovementDraft,
} from "@/lib/movement-draft";

interface CreateMovementModalProps {
  isOpen: boolean;
  onClose: () => void;
  equipment: Equipment | null;
  equipmentsList?: Equipment[];
  onSelectEquipment?: (equipment: Equipment) => void;
  onSuccess?: () => void;
}

const inputClass =
  "w-full h-9 px-2.5 bg-[#26221f] text-white border border-[#57504a] rounded-lg text-xs outline-none focus:border-emerald-400 disabled:opacity-50";
type ShelfOption = { shelfId: string; shelfName: string | null };

export function CreateMovementModal(props: CreateMovementModalProps) {
  return props.isOpen ? <MovementComposer {...props} /> : null;
}

function MovementComposer({
  equipment,
  equipmentsList = [],
  onClose,
  onSuccess,
}: CreateMovementModalProps) {
  const equipmentQuery = useEquipments({ limit: 100 });
  const shelfQuery = useShelves({ limit: 100 });
  const [drafts, setDrafts] = useState<MovementDraft[]>(() =>
    equipment ? [createMovementDraft(equipment)] : [],
  );
  const [error, setError] = useState<string | null>(null);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const submitting = useRef(false);
  const [shelfCache, setShelfCache] = useState<ShelfOption[]>([]);
  const busy = isSubmitting || equipmentQuery.isCreatingBatchMovements;
  const rightPanelRef = useRef<HTMLDivElement>(null);
  const prevDraftsLen = useRef(drafts.length);

  // Auto-scroll right panel to bottom when a new article is added
  useEffect(() => {
    if (drafts.length > prevDraftsLen.current && rightPanelRef.current) {
      rightPanelRef.current.scrollTo({
        top: rightPanelRef.current.scrollHeight,
        behavior: "smooth",
      });
    }
    prevDraftsLen.current = drafts.length;
  }, [drafts.length]);

  const selectedIds = new Set(
    drafts.map((draft) => draft.equipment.equipmentId),
  );
  const visibleEquipments = useMemo(() => {
    const candidates =
      equipmentQuery.searchTerm.trim() || equipmentQuery.currentPage > 1
        ? equipmentQuery.equipments
        : [
            ...equipmentsList,
            ...equipmentQuery.equipments,
            ...(equipment ? [equipment] : []),
          ];
    return Array.from(
      new Map(candidates.map((item) => [item.equipmentId, item])).values(),
    );
  }, [
    equipmentQuery.searchTerm,
    equipmentQuery.currentPage,
    equipmentQuery.equipments,
    equipmentsList,
    equipment,
  ]);
  const shelfOptions = Array.from(
    new Map(
      [
        ...shelfCache,
        ...drafts.flatMap((draft) => [
          ...(draft.equipment.equipmentShelfs ?? []).map((row) => ({
            shelfId: row.shelfId,
            shelfName: row.shelf?.shelfName ?? row.shelfId,
          })),
          ...(draft.equipment.serialNumbers ?? []).flatMap((serial) =>
            serial.shelfId
              ? [
                  {
                    shelfId: serial.shelfId,
                    shelfName: serial.shelf?.shelfName ?? serial.shelfId,
                  },
                ]
              : [],
          ),
        ]),
        ...shelfQuery.shelves,
      ].map((shelf) => [shelf.shelfId, shelf]),
    ).values(),
  );
  const lineCount = drafts.reduce(
    (sum, draft) =>
      sum + (draft.equipment.hasSerialNumber ? draft.serialIds.length : 1),
    0,
  );

  function updateDraft(id: string, update: Partial<MovementDraft>) {
    setError(null);
    setDrafts((previous) =>
      previous.map((draft) =>
        draft.id === id ? { ...draft, ...update } : draft,
      ),
    );
  }
  function rememberShelf(id: string) {
    const shelf = shelfOptions.find((item) => item.shelfId === id);
    if (shelf)
      setShelfCache((previous) => [
        ...previous.filter((item) => item.shelfId !== id),
        shelf,
      ]);
  }
  function toggleEquipment(item: Equipment) {
    setError(null);
    setDrafts((previous) =>
      previous.some((draft) => draft.equipment.equipmentId === item.equipmentId)
        ? previous.filter(
            (draft) => draft.equipment.equipmentId !== item.equipmentId,
          )
        : [...previous, createMovementDraft(item)],
    );
  }
  async function save(event: React.FormEvent) {
    event.preventDefault();
    if (submitting.current) return;
    setError(null);
    let items;
    try {
      items = buildMovementItems(drafts);
    } catch (cause) {
      setError(getErrorMessage(cause, "Vérifiez les articles du mouvement."));
      return;
    }
    submitting.current = true;
    setIsSubmitting(true);
    try {
      await equipmentQuery.createBatchMovements(items);
    } catch (cause) {
      setError(
        getErrorMessage(cause, "Impossible d’enregistrer le mouvement."),
      );
      submitting.current = false;
      setIsSubmitting(false);
      return;
    }
    onSuccess?.();
    onClose();
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-3 sm:p-5">
      <section
        role="dialog"
        aria-modal="true"
        aria-labelledby="movement-modal-title"
        className="w-full max-w-6xl h-[92dvh] flex flex-col rounded-xl border border-[#57504a] bg-[#383330] text-white shadow-2xl overflow-hidden"
      >
        <header className="shrink-0 flex items-center justify-between gap-3 p-4 sm:px-6 border-b border-[#57504a] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <ArrowRightLeft className="w-5 h-5 text-emerald-300" />
            <div>
              <h2 id="movement-modal-title" className="font-semibold">
                Nouveau mouvement
              </h2>
              <p className="text-xs text-white/65 mt-1">
                Sélectionnez un ou plusieurs articles, puis enregistrez-les
                ensemble.
              </p>
            </div>
          </div>
          <button
            type="button"
            disabled={busy}
            onClick={onClose}
            aria-label="Fermer"
            className="p-2 hover:bg-white/10 rounded-lg disabled:opacity-40"
          >
            <X className="w-5 h-5" />
          </button>
        </header>
        <form onSubmit={save} className="min-h-0 flex flex-col flex-1">
          <fieldset disabled={busy} className="relative min-h-0 min-w-0 flex-1">
            <div className="absolute inset-0 p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] lg:grid-rows-[minmax(0,1fr)] gap-5 overflow-y-auto lg:overflow-hidden">
              <aside className="space-y-3 min-w-0 min-h-0 flex flex-col lg:overflow-hidden">
                <div>
                  <h3 className="font-semibold text-sm">
                    1. Choisir les articles
                  </h3>
                  <p className="text-xs text-white/60 mt-1">
                    Cochez directement tous les articles à inclure.
                  </p>
                </div>
                <div className="relative">
                  <Search className="absolute left-2.5 top-2.5 w-4 h-4 text-white/50" />
                  <input
                    type="search"
                    aria-label="Rechercher un article"
                    placeholder="Rechercher un article…"
                    value={equipmentQuery.searchTerm}
                    onChange={(event) =>
                      equipmentQuery.setSearchTerm(event.target.value)
                    }
                    className={`${inputClass} pl-9`}
                  />
                </div>
                <button
                  type="button"
                  disabled={
                    !visibleEquipments.length || equipmentQuery.isFetching
                  }
                  onClick={() => {
                    setError(null);
                    setDrafts((previous) => [
                      ...previous,
                      ...visibleEquipments
                        .filter(
                          (item) =>
                            !previous.some(
                              (draft) =>
                                draft.equipment.equipmentId ===
                                item.equipmentId,
                            ),
                        )
                        .map((item) => createMovementDraft(item)),
                    ]);
                  }}
                  className="text-xs text-emerald-300 hover:underline disabled:opacity-40"
                >
                  Tout sélectionner sur cette page
                </button>
                <div className="flex-1 min-h-0 max-h-72 lg:max-h-none overflow-y-auto overscroll-contain rounded-lg border border-[#57504a] divide-y divide-[#57504a]">
                  {equipmentQuery.isFetching && (
                    <p role="status" className="p-3 text-xs text-white/60">
                      Chargement des articles…
                    </p>
                  )}
                  {equipmentQuery.isError && (
                    <p role="alert" className="p-3 text-xs text-rose-300">
                      Impossible de charger les articles.{" "}
                      <button
                        type="button"
                        onClick={() => equipmentQuery.refetch()}
                        className="underline"
                      >
                        Réessayer
                      </button>
                    </p>
                  )}
                  {!equipmentQuery.isFetching && !visibleEquipments.length && (
                    <p className="p-3 text-xs text-white/60">
                      Aucun article trouvé.
                    </p>
                  )}
                  {visibleEquipments.map((item) => (
                    <label
                      key={item.equipmentId}
                      className={`flex gap-2.5 p-3 cursor-pointer hover:bg-white/5 ${selectedIds.has(item.equipmentId) ? "bg-emerald-950/30" : "bg-[#2b2622]/40"}`}
                    >
                      <input
                        type="checkbox"
                        checked={selectedIds.has(item.equipmentId)}
                        onChange={() => toggleEquipment(item)}
                        className="mt-0.5 accent-emerald-400"
                      />
                      <span className="min-w-0 text-xs">
                        <span className="block font-medium break-words">
                          {item.equipmentName ?? "Sans nom"}
                        </span>
                        <span className="block text-white/55 mt-1">
                          {item.equipmentQuantity} unité(s) ·{" "}
                          {item.hasSerialNumber
                            ? "Avec n° de série"
                            : "Standard"}
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
                <div className="flex items-center justify-between gap-2 text-xs">
                  <button
                    type="button"
                    disabled={
                      equipmentQuery.currentPage <= 1 ||
                      equipmentQuery.isFetching
                    }
                    onClick={() => equipmentQuery.setPage((page) => page - 1)}
                    className="disabled:opacity-30"
                  >
                    Précédent
                  </button>
                  <span className="text-white/60">
                    Page {equipmentQuery.currentPage}
                  </span>
                  <button
                    type="button"
                    disabled={
                      equipmentQuery.currentPage >= equipmentQuery.totalPages ||
                      equipmentQuery.isFetching
                    }
                    onClick={() => equipmentQuery.setPage((page) => page + 1)}
                    className="disabled:opacity-30"
                  >
                    Suivant
                  </button>
                </div>
              </aside>
              <div
                ref={rightPanelRef}
                role="region"
                aria-label="Articles du mouvement"
                tabIndex={0}
                className="space-y-3 min-w-0 min-h-0 max-h-[60dvh] lg:max-h-none overflow-y-auto overscroll-contain [scrollbar-gutter:stable] pr-2 focus-visible:outline-emerald-400"
              >
                <div>
                  <h3 className="font-semibold text-sm">
                    2. Compléter le mouvement
                  </h3>
                  <p aria-live="polite" className="text-xs text-white/60 mt-1">
                    {selectedIds.size} article(s) sélectionné(s) · {lineCount}{" "}
                    ligne(s) · Un seul mouvement
                  </p>
                </div>
                {!!drafts.length && (
                  <input
                    type="search"
                    aria-label="Rechercher un emplacement"
                    placeholder="Rechercher un emplacement de destination…"
                    value={shelfQuery.searchTerm}
                    onChange={(event) =>
                      shelfQuery.setSearchTerm(event.target.value)
                    }
                    className={inputClass}
                  />
                )}
                {shelfQuery.isError && (
                  <p role="alert" className="text-xs text-rose-300">
                    Impossible de charger les emplacements.{" "}
                    <button
                      type="button"
                      onClick={() => shelfQuery.refetch()}
                      className="underline"
                    >
                      Réessayer
                    </button>
                  </p>
                )}
                {!drafts.length && (
                  <div className="rounded-xl border border-dashed border-[#736b62] p-8 text-center text-white/60 text-sm">
                    Cochez un ou plusieurs articles dans la liste. Leurs
                    quantités et emplacements apparaîtront ici.
                  </div>
                )}
                {drafts.map((draft, index) => (
                  <article
                    key={draft.id}
                    className="rounded-xl border border-[#57504a] bg-[#2b2622]/50 p-3.5 space-y-3"
                  >
                    <div className="flex items-center justify-between gap-2">
                      <h4 className="text-sm font-semibold break-words">
                        <span className="text-emerald-300 mr-2">
                          {index + 1}.
                        </span>
                        {draft.equipment.equipmentName}
                      </h4>
                      <button
                        type="button"
                        aria-label={`Retirer ${draft.equipment.equipmentName}`}
                        onClick={() => {
                          setDrafts((previous) =>
                            previous.filter((row) => row.id !== draft.id),
                          );
                          setError(null);
                        }}
                        className="p-1.5 hover:bg-white/10 rounded"
                      >
                        <Trash2 className="w-4 h-4 text-white/60" />
                      </button>
                    </div>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <label className="text-xs space-y-1 block">
                        <span>Type de mouvement</span>
                        <select
                          aria-label={`Type — ${draft.equipment.equipmentName}`}
                          value={draft.type}
                          onChange={(event) =>
                            updateDraft(draft.id, {
                              type: event.target.value as MovementDraft["type"],
                            })
                          }
                          className={inputClass}
                        >
                          <option value="TRANSFER">Transfert</option>
                          <option value="IN">Entrée</option>
                          <option value="OUT">Sortie</option>
                        </select>
                      </label>
                      {!draft.equipment.hasSerialNumber && (
                        <label className="text-xs space-y-1 block">
                          <span>Quantité</span>
                          <input
                            aria-label={`Quantité — ${draft.equipment.equipmentName}`}
                            type="number"
                            min={1}
                            max={2147483647}
                            step={1}
                            value={draft.quantity || ""}
                            onChange={(event) =>
                              updateDraft(draft.id, {
                                quantity: Number(event.target.value),
                              })
                            }
                            className={inputClass}
                          />
                        </label>
                      )}
                      {!draft.equipment.hasSerialNumber &&
                        draft.type !== "IN" && (
                          <label className="text-xs space-y-1 block">
                            <span>Emplacement source</span>
                            <select
                              value={draft.sourceShelfId}
                              onChange={(event) => {
                                rememberShelf(event.target.value);
                                updateDraft(draft.id, {
                                  sourceShelfId: event.target.value,
                                });
                              }}
                              className={inputClass}
                            >
                              <option value="">Choisir la source</option>
                              {shelfOptions.map((shelf) => (
                                <option
                                  key={shelf.shelfId}
                                  value={shelf.shelfId}
                                >
                                  {shelf.shelfName} (
                                  {draft.equipment.equipmentShelfs
                                    ?.filter(
                                      (row) => row.shelfId === shelf.shelfId,
                                    )
                                    .reduce(
                                      (sum, row) => sum + row.equipmentQuantity,
                                      0,
                                    ) ?? 0}{" "}
                                  en stock)
                                </option>
                              ))}
                            </select>
                          </label>
                        )}
                      {draft.type !== "OUT" && (
                        <label className="text-xs space-y-1 block">
                          <span>
                            {draft.equipment.hasSerialNumber
                              ? "Destination commune (facultative)"
                              : "Emplacement destination"}
                          </span>
                          <select
                            value={draft.destinationShelfId}
                            onChange={(event) => {
                              rememberShelf(event.target.value);
                              updateDraft(draft.id, {
                                destinationShelfId: event.target.value,
                                serialDestinations: {},
                              });
                            }}
                            className={inputClass}
                          >
                            <option value="">Choisir la destination</option>
                            {shelfOptions.map((shelf) => (
                              <option key={shelf.shelfId} value={shelf.shelfId}>
                                {shelf.shelfName}
                              </option>
                            ))}
                          </select>
                        </label>
                      )}
                    </div>
                    {draft.equipment.hasSerialNumber && (
                      <SerialSelection
                        draft={draft}
                        shelves={shelfOptions}
                        onChange={(update) => updateDraft(draft.id, update)}
                        onShelf={rememberShelf}
                      />
                    )}
                    {!draft.equipment.hasSerialNumber && (
                      <button
                        type="button"
                        onClick={() =>
                          setDrafts((previous) => [
                            ...previous,
                            {
                              ...createMovementDraft(
                                draft.equipment,
                                crypto.randomUUID(),
                              ),
                              type: draft.type,
                            },
                          ])
                        }
                        className="inline-flex items-center gap-1 text-xs text-white/60 hover:text-white"
                      >
                        <Plus className="w-3.5 h-3.5" />
                        Autre emplacement pour cet article
                      </button>
                    )}
                  </article>
                ))}
              </div>
            </div>
          </fieldset>
          <footer className="shrink-0 border-t border-[#57504a] bg-[#2b2622] p-4 sm:px-6 space-y-3">
            {error && (
              <div
                role="alert"
                className="flex items-start gap-2 text-sm text-rose-200"
              >
                <AlertCircle className="w-4 h-4 mt-0.5 shrink-0" />
                {error}
              </div>
            )}
            <div className="flex items-center justify-between gap-3 flex-wrap">
              <p className="text-xs text-white/60">
                Tous les articles seront enregistrés dans le même mouvement.
              </p>
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  disabled={busy}
                  onClick={onClose}
                  className="px-4 py-2 text-xs rounded-lg border border-[#57504a] hover:bg-white/10 disabled:opacity-40"
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  disabled={busy || !drafts.length}
                  className="inline-flex items-center gap-2 px-4 py-2 bg-emerald-800 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg disabled:opacity-40"
                >
                  {busy ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <Check className="w-4 h-4" />
                  )}
                  {busy
                    ? "Enregistrement…"
                    : `Enregistrer le mouvement (${selectedIds.size} article(s))`}
                </button>
              </div>
            </div>
          </footer>
        </form>
      </section>
    </div>
  );
}

function SerialSelection({
  draft,
  shelves,
  onChange,
  onShelf,
}: {
  draft: MovementDraft;
  shelves: ShelfOption[];
  onChange: (update: Partial<MovementDraft>) => void;
  onShelf: (id: string) => void;
}) {
  const [search, setSearch] = useState("");
  const serials = (draft.equipment.serialNumbers ?? []).filter((serial) =>
    (serial.serialNumberCode ?? "")
      .toLowerCase()
      .includes(search.toLowerCase()),
  );
  const eligible = serials.filter((serial) =>
    draft.type === "IN"
      ? !serial.shelfId
      : draft.type === "OUT"
        ? !!serial.shelfId
        : true,
  );
  return (
    <div className="space-y-2 border-t border-white/10 pt-3">
      <div className="flex items-center justify-between gap-2 flex-wrap text-xs">
        <span>Numéros de série ({draft.serialIds.length} sélectionné(s))</span>
        <div className="flex gap-3">
          <button
            type="button"
            onClick={() =>
              onChange({
                serialIds: [
                  ...new Set([
                    ...draft.serialIds,
                    ...eligible.map((serial) => serial.serialNumberId),
                  ]),
                ],
              })
            }
            className="text-emerald-300 hover:underline"
          >
            Tout sélectionner
          </button>
          <button
            type="button"
            onClick={() => onChange({ serialIds: [] })}
            className="text-white/60 hover:underline"
          >
            Tout retirer
          </button>
        </div>
      </div>
      <input
        type="search"
        aria-label={`Rechercher un numéro — ${draft.equipment.equipmentName}`}
        placeholder="Rechercher un numéro de série…"
        value={search}
        onChange={(event) => setSearch(event.target.value)}
        className={inputClass}
      />
      <div className="max-h-48 overflow-y-auto space-y-2">
        {!serials.length && (
          <p className="text-xs text-white/60">
            Aucun numéro de série disponible.
          </p>
        )}
        {serials.map((serial) => {
          const checked = draft.serialIds.includes(serial.serialNumberId);
          return (
            <div
              key={serial.serialNumberId}
              className="flex items-center gap-3 text-xs flex-wrap rounded-lg bg-black/10 p-2"
            >
              <label className="flex items-center gap-2 flex-1 min-w-32 cursor-pointer">
                <input
                  type="checkbox"
                  checked={checked}
                  onChange={() =>
                    onChange({
                      serialIds: checked
                        ? draft.serialIds.filter(
                            (id) => id !== serial.serialNumberId,
                          )
                        : [...draft.serialIds, serial.serialNumberId],
                    })
                  }
                  className="accent-emerald-400"
                />
                <span>
                  <span className="block font-mono">
                    {serial.serialNumberCode ?? serial.serialNumberId}
                  </span>
                  <span className="block text-white/50 mt-0.5">
                    Source : {serial.shelf?.shelfName ?? "Non assigné"}
                  </span>
                </span>
              </label>
              {draft.type !== "OUT" ? (
                <select
                  aria-label={`Destination — ${serial.serialNumberCode ?? serial.serialNumberId}`}
                  disabled={!checked}
                  value={
                    draft.serialDestinations[serial.serialNumberId] ||
                    draft.destinationShelfId
                  }
                  onChange={(event) => {
                    onShelf(event.target.value);
                    onChange({
                      serialDestinations: {
                        ...draft.serialDestinations,
                        [serial.serialNumberId]: event.target.value,
                      },
                    });
                  }}
                  className={`${inputClass} sm:max-w-56`}
                >
                  <option value="">Choisir la destination</option>
                  {shelves.map((shelf) => (
                    <option key={shelf.shelfId} value={shelf.shelfId}>
                      {shelf.shelfName}
                    </option>
                  ))}
                </select>
              ) : (
                <span className="text-amber-300">Sortie du stock</span>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}
</file>

<file path="src/components/equipment/DeleteEquipmentModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import React, { useState } from 'react';
import { Equipment } from '@/types/equipment';
import { usePermissions } from '@/hooks/use-permissions';
import {
  X,
  Trash2,
  Loader2,
  ShieldAlert,
  AlertTriangle,
  Cpu,
  Layers,
  Barcode,
} from 'lucide-react';

interface DeleteEquipmentModalProps {
  equipment: Equipment | null;
  isOpen: boolean;
  onClose: () => void;
  onDelete: (id: string) => Promise<void>;
  isDeleting: boolean;
  onSuccess?: () => void;
}

export function DeleteEquipmentModal({
  equipment,
  isOpen,
  onClose,
  onDelete,
  isDeleting,
  onSuccess,
}: DeleteEquipmentModalProps) {
  const { canDeleteEquipment, roleName } = usePermissions();
  const [error, setError] = useState<string | null>(null);

  if (!isOpen || !equipment) return null;

  const serialCount = equipment.serialNumbers?.length ?? 0;

  const handleDelete = async () => {
    setError(null);

    if (!canDeleteEquipment) {
      setError(
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne possède pas la permission 'equipment.delete' pour supprimer cet article.`,
      );
      return;
    }

    try {
      await onDelete(equipment.equipmentId);
      onClose();
      if (onSuccess) onSuccess();
    } catch (err: unknown) {
      console.error('[DeleteEquipmentModal] Delete failed:', err);
      setError(getErrorMessage(err, 'Impossible de supprimer cet article.'));
    }
  };

  const displayQty = equipment.hasSerialNumber ? (equipment.serialNumbers?.length ?? equipment.equipmentQuantity) : equipment.equipmentQuantity;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-in fade-in duration-150">
      <div
        className="w-full max-w-md bg-[#383330] border border-[#3f3a36] rounded-xl shadow-2xl overflow-hidden animate-in zoom-in-95 duration-150 text-left text-white"
        role="dialog"
        aria-modal="true"
        aria-labelledby="delete-equipment-title"
      >
        {/* Header */}
        <div className="flex items-center justify-between px-5 py-4 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-lg bg-rose-500/20 border border-rose-400/40 flex items-center justify-center text-rose-200">
              <Trash2 className="w-4 h-4" />
            </div>
            <div>
              <h3 id="delete-equipment-title" className="text-sm font-semibold text-white">
                Supprimer l’article
              </h3>
              <p className="text-[11px] text-white/70">Confirmation de suppression définitive</p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-1 rounded-md text-white/80 hover:text-white hover:bg-white/10 transition-colors"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Body */}
        <div className="p-5 space-y-4">
          {/* Permission Guard Error */}
          {error && (
            <div className="p-3 bg-rose-950/50 border border-rose-500/50 rounded-lg flex items-start gap-2.5 text-xs text-rose-200">
              <ShieldAlert className="w-4 h-4 mt-0.5 shrink-0" />
              <span>{error}</span>
            </div>
          )}

          {/* Warning Banner */}
          <div className="p-3.5 bg-rose-950/40 border border-rose-500/40 rounded-lg flex items-start gap-3">
            <AlertTriangle className="w-5 h-5 text-rose-300 shrink-0 mt-0.5" />
            <div className="text-xs text-rose-100 space-y-1">
              <p className="font-semibold">Attention : Cette action est irréversible.</p>
              <p className="text-[11px] leading-relaxed text-rose-200/90">
                L’article <span className="font-bold text-white">&quot;{equipment.equipmentName}&quot;</span> sera définitivement supprimé du système.
              </p>
            </div>
          </div>

          {/* Record Details */}
          <div className="p-3 bg-[#2b2622]/60 rounded-lg border border-[#3f3a36] space-y-2 text-xs">
            <div className="flex items-center justify-between text-white/80">
              <span className="flex items-center gap-1.5 font-medium text-white/90">
                <Cpu className="w-3.5 h-3.5 text-white/70" />
                Nom de l’article :
              </span>
              <span className="font-semibold text-white">{equipment.equipmentName}</span>
            </div>
            <div className="flex items-center justify-between text-white/80">
              <span className="flex items-center gap-1.5 font-medium text-white/90">
                <Layers className="w-3.5 h-3.5 text-white/70" />
                Quantité en stock :
              </span>
              <span className="font-semibold text-white">{displayQty} unité(s)</span>
            </div>
            {equipment.hasSerialNumber && (
              <div className="flex items-center justify-between text-white/80">
                <span className="flex items-center gap-1.5 font-medium text-white/90">
                  <Barcode className="w-3.5 h-3.5 text-emerald-300" />
                  Numéros de série enfants :
                </span>
                <span className="font-semibold px-2 py-0.5 rounded bg-[#2b2622] text-emerald-300 border border-emerald-400/30">
                  {serialCount} code(s) (seront également supprimés)
                </span>
              </div>
            )}
            <div className="flex items-center justify-between text-white/60 text-[11px] pt-1 border-t border-white/15">
              <span>UUID :</span>
              <code className="font-mono text-[10px] text-white/90">{equipment.equipmentId}</code>
            </div>
          </div>
        </div>

        {/* Actions Footer */}
        <div className="flex items-center justify-end gap-2.5 px-5 py-3.5 bg-[#2b2622] border-t border-[#3f3a36]">
          <button
            type="button"
            onClick={onClose}
            disabled={isDeleting}
            className="px-3.5 py-1.5 text-xs font-medium text-white bg-white/10 border border-white/20 rounded-lg hover:bg-white/20 transition-colors cursor-pointer"
          >
            Annuler
          </button>
          <button
            type="button"
            onClick={handleDelete}
            disabled={isDeleting || !canDeleteEquipment}
            className="px-4 py-1.5 text-xs font-medium text-white bg-rose-600 hover:bg-rose-700 active:bg-rose-800 rounded-lg shadow-sm transition-colors flex items-center gap-1.5 disabled:opacity-50 cursor-pointer"
          >
            {isDeleting ? (
              <>
                <Loader2 className="w-3.5 h-3.5 animate-spin" />
                Suppression...
              </>
            ) : (
              <>
                <Trash2 className="w-3.5 h-3.5" />
                Supprimer définitivement
              </>
            )}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

