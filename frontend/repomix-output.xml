<file path="src/components/shelf/ShelfListTable.tsx">
'use client';

import { useState } from 'react';
import { Shelf } from '@/types/shelf';
import {
  Search,
  RefreshCw,
  Copy,
  Check,
  Database,
  Hash,
  Archive,
  ChevronLeft,
  ChevronRight,
  ChevronsLeft,
  ChevronsRight,
  LayoutGrid,
  Table as TableIcon,
  Eye,
  ArrowRight,
  Pencil,
  Trash2,
  Plus,
  Warehouse,
} from 'lucide-react';
import { toast } from 'sonner';

interface ShelfListTableProps {
  shelves: Shelf[];
  totalShelves: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  onSearchChange: (search: string) => void;
  onPageChange: (page: number) => void;
  onLimitChange: (limit: number) => void;
  onSelectShelf: (shelf: Shelf) => void;
  onLookupById?: (id: string) => void;
  onOpenUpdate?: (shelf: Shelf) => void;
  onOpenDelete?: (shelf: Shelf) => void;
  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateShelf: boolean;
  canUpdateShelf?: boolean;
  canDeleteShelf?: boolean;
}

export function ShelfListTable({
  shelves,
  totalShelves,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  onSearchChange,
  onPageChange,
  onLimitChange,
  onSelectShelf,
  onLookupById,
  onOpenUpdate,
  onOpenDelete,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateShelf,
  canUpdateShelf = true,
  canDeleteShelf = true,
}: ShelfListTableProps) {
  const [copiedId, setCopiedId] = useState<string | null>(null);
  const [viewMode, setViewMode] = useState<'table' | 'grid'>('table');
  const [idLookupInput, setIdLookupInput] = useState('');

  const handleCopyId = (e: React.MouseEvent, id: string) => {
    e.stopPropagation();
    navigator.clipboard.writeText(id);
    setCopiedId(id);
    toast.success('Identifiant copié dans le presse-papier !');
    setTimeout(() => setCopiedId(null), 2000);
  };

  const handleLookupSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!idLookupInput.trim()) return;
    if (onLookupById) {
      onLookupById(idLookupInput.trim());
    }
  };

  // Calculate indexing ranges
  const startItem = totalShelves === 0 ? 0 : (currentPage - 1) * limit + 1;
  const endItem = Math.min(currentPage * limit, totalShelves);

  return (
    <div className="w-full bg-[#383330] border border-[#3f3a36] rounded-[4px] shadow-xs overflow-hidden text-left space-y-0">
      {/* Table Toolbar & Search by Name */}
      <div className="p-3 border-b border-[#3f3a36] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3 bg-[#383330]">
        {/* Search by Name input */}
        <div className="flex items-center gap-2 w-full lg:w-auto flex-1 max-w-lg">
          <div className="relative w-full">
            <Search className="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-[#aea69c]" />
            <input
              type="text"
              value={searchTerm}
              onChange={(e) => onSearchChange(e.target.value)}
              placeholder="Rechercher par nom d'emplacement..."
              className="w-full h-8 pl-8 pr-7 bg-[#2b2622] text-xs font-mono text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] outline-none focus:border-[#f7f5f0] placeholder:text-[#aea69c] transition-colors"
            />
            {searchTerm && (
              <button
                type="button"
                onClick={() => onSearchChange('')}
                className="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-[#aea69c] hover:text-[#f7f5f0] cursor-pointer"
              >
                ×
              </button>
            )}
          </div>
        </div>

        {/* Quick UUID Lookup Input */}
        <form
          onSubmit={handleLookupSubmit}
          className="flex items-center gap-1.5 w-full sm:w-auto max-w-sm"
        >
          <div className="relative flex-1">
            <Database className="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-[#aea69c]" />
            <input
              type="text"
              value={idLookupInput}
              onChange={(e) => setIdLookupInput(e.target.value)}
              placeholder="Inspecter par UUID..."
              className="w-full h-8 pl-8 pr-2 bg-[#2b2622] text-xs font-mono text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] outline-none focus:border-[#f7f5f0] placeholder:text-[#aea69c] transition-colors"
            />
          </div>
          <button
            type="submit"
            disabled={!idLookupInput.trim() || isLoading}
            className="h-8 px-2.5 bg-[#2b2622] hover:bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors cursor-pointer disabled:opacity-40 flex items-center gap-1"
            title="Consulter l'emplacement par UUID (GET /shelves/:id)"
          >
            <span>Ouvrir</span>
            <ArrowRight className="w-3 h-3" />
          </button>
        </form>

        {/* View Mode & Page Limit & Refresh Controls */}
        <div className="flex items-center flex-wrap gap-2 w-full lg:w-auto justify-between lg:justify-end">
          {/* View Mode Toggle */}
          <div className="inline-flex items-center bg-[#2b2622] p-0.5 rounded-[3px] border border-[#3f3a36]">
            <button
              type="button"
              onClick={() => setViewMode('table')}
              className={`px-2 py-1 rounded-[2px] text-xs font-medium flex items-center gap-1.5 transition-all cursor-pointer ${
                viewMode === 'table'
                  ? 'bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] shadow-xs'
                  : 'text-[#aea69c] hover:text-[#f7f5f0]'
              }`}
              title="Vue Liste / Table"
            >
              <TableIcon className="w-3.5 h-3.5" />
              <span>Table</span>
            </button>
            <button
              type="button"
              onClick={() => setViewMode('grid')}
              className={`px-2 py-1 rounded-[2px] text-xs font-medium flex items-center gap-1.5 transition-all cursor-pointer ${
                viewMode === 'grid'
                  ? 'bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] shadow-xs'
                  : 'text-[#aea69c] hover:text-[#f7f5f0]'
              }`}
              title="Vue Galerie / Cartes"
            >
              <LayoutGrid className="w-3.5 h-3.5" />
              <span>Galerie</span>
            </button>
          </div>

          {/* Page size limit selector */}
          <div className="flex items-center gap-1.5 text-xs text-[#c9c0ad]">
            <select
              value={limit}
              onChange={(e) => onLimitChange(Number(e.target.value))}
              className="h-8 px-2 bg-[#2b2622] border border-[#3f3a36] rounded-[3px] text-xs font-mono text-[#f7f5f0] outline-none focus:border-[#f7f5f0] cursor-pointer"
            >
              <option value={5}>5 / page</option>
              <option value={10}>10 / page</option>
              <option value={20}>20 / page</option>
              <option value={50}>50 / page</option>
            </select>
          </div>

          {/* Refresh button */}
          <button
            type="button"
            onClick={onRefresh}
            disabled={isLoading}
            className="h-8 px-2.5 bg-[#2b2622] hover:bg-[#383330] text-[#c9c0ad] hover:text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer disabled:opacity-40"
            title="Actualiser"
          >
            <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? 'animate-spin text-[#f7f5f0]' : ''}`} />
            <span className="hidden sm:inline">Actualiser</span>
          </button>
        </div>
      </div>

      {/* Main View: Table View OR Grid View */}
      {viewMode === 'table' ? (
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs">
            <thead>
              <tr className="border-b border-[#3f3a36] bg-[#2b2622] text-[11px] font-mono text-[#aea69c] tracking-wider uppercase">
                <th className="py-2.5 px-4 w-16 text-center">Index</th>
                <th className="py-2.5 px-4">Emplacement</th>
                <th className="py-2.5 px-4 text-center">Quantité Stockée</th>
                <th className="py-2.5 px-4">Identifiant</th>
                <th className="py-2.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-[#3f3a36] text-xs text-[#f7f5f0]">
              {isLoading && shelves.length === 0 ? (
                <tr>
                  <td colSpan={5} className="py-16 text-center text-[#aea69c]">
                    <div className="flex flex-col items-center justify-center gap-2">
                      <RefreshCw className="w-5 h-5 animate-spin text-[#f7f5f0]" />
                      <p className="text-xs font-mono">Chargement des emplacements...</p>
                    </div>
                  </td>
                </tr>
              ) : shelves.length === 0 ? (
                <tr>
                  <td colSpan={5} className="py-16 text-center text-[#aea69c]">
                    <div className="flex flex-col items-center justify-center gap-3">
                      <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#aea69c]">
                        <Archive className="w-5 h-5" />
                      </div>
                      <div className="space-y-1">
                        <p className="text-sm font-medium text-[#f7f5f0]">Aucun emplacement trouvé</p>
                        <p className="text-xs text-[#c9c0ad] max-w-sm">
                          {searchTerm
                            ? `Aucun emplacement ne correspond à "${searchTerm}".`
                            : 'Aucun emplacement enregistré pour le moment.'}
                        </p>
                      </div>
                      {canCreateShelf && !searchTerm && (
                        <button
                          type="button"
                          onClick={onOpenCreateModal}
                          className="mt-1 px-3.5 py-1.5 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] rounded-[3px] text-xs font-medium cursor-pointer transition-colors inline-flex items-center gap-1.5"
                        >
                          <Plus className="w-3.5 h-3.5" />
                          <span>Créer un emplacement</span>
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ) : (
                shelves.map((shelf, idx) => {
                  const globalIndex = (currentPage - 1) * limit + idx + 1;
                  const formattedIndex = String(globalIndex).padStart(2, '0');

                  return (
                    <tr
                      key={shelf.shelfId}
                      onClick={() => onSelectShelf(shelf)}
                      className="hover:bg-[#2b2622]/50 transition-colors group cursor-pointer"
                    >
                      {/* 1. Global Index Number */}
                      <td className="py-3 px-4 text-center font-mono text-xs text-[#aea69c]">
                        <span className="inline-block px-1.5 py-0.5 rounded-[2px] bg-[#2b2622] border border-[#3f3a36] text-[#dad2c1] text-[10px]">
                          #{formattedIndex}
                        </span>
                      </td>

                      {/* 2. Shelf Name */}
                      <td className="py-3 px-4 font-medium text-[#f7f5f0]">
                        <div className="flex items-center gap-2.5">
                          <div className="min-w-0">
                            <p className="font-medium text-xs text-[#f7f5f0] truncate max-w-xs group-hover:text-white transition-colors">
                              {shelf.shelfName ?? 'Emplacement sans nom'}
                            </p>
                            <span className="text-[11px] font-mono text-[#aea69c] flex items-center gap-1">
                              <span>Emplacement</span>
                              {shelf.stock?.stockName && (
                                <>
                                  <span>•</span>
                                  <span className="text-[#f7f5f0] flex items-center gap-0.5">
                                    <Warehouse className="w-3 h-3" />
                                    {shelf.stock.stockName}
                                  </span>
                                </>
                              )}
                              <span>•</span>
                              <span className="text-[#dad2c1]">
                                RACK-{formattedIndex}
                              </span>
                            </span>
                          </div>
                        </div>
                      </td>

                      {/* 3. Quantity Badge */}
                      <td className="py-3 px-4 text-center">
                        <span
                          className={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] font-mono text-[10px] border ${
                            shelf.shelfQuantity > 0
                              ? 'bg-[#162b22] text-[#10b981] border-[#1e3d30]'
                              : 'bg-[#2d1616] text-[#ef4444] border-[#451e1e]'
                          }`}
                        >
                          <Hash className="w-3 h-3" />
                          <span>
                            {shelf.shelfQuantity} {shelf.shelfQuantity > 1 ? 'unités' : 'unité'}
                          </span>
                        </span>
                      </td>

                      {/* 4. GUID (shelfId) */}
                      <td className="py-3 px-4">
                        <div className="flex items-center gap-1.5 font-mono text-xs text-[#aea69c]">
                          <span className="truncate max-w-[160px]">{shelf.shelfId}</span>
                          <button
                            type="button"
                            onClick={(e) => handleCopyId(e, shelf.shelfId)}
                            className="p-1 text-[#aea69c] hover:text-[#f7f5f0] rounded-[2px] hover:bg-[#2b2622] transition-colors cursor-pointer"
                            title="Copier l'identifiant"
                          >
                            {copiedId === shelf.shelfId ? (
                              <Check className="w-3.5 h-3.5 text-[#10b981]" />
                            ) : (
                              <Copy className="w-3.5 h-3.5" />
                            )}
                          </button>
                        </div>
                      </td>

                      {/* 5. Actions */}
                      <td className="py-3 px-4 text-right">
                        <div className="inline-flex items-center gap-1" onClick={(e) => e.stopPropagation()}>
                          <button
                            type="button"
                            onClick={() => onSelectShelf(shelf)}
                            className="p-1.5 rounded-[2px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#2b2622] transition-colors cursor-pointer"
                            title="Consulter les détails"
                          >
                            <Eye className="w-3.5 h-3.5" />
                          </button>

                          <button
                            type="button"
                            onClick={() => onOpenUpdate && onOpenUpdate(shelf)}
                            disabled={!canUpdateShelf}
                            className="p-1.5 rounded-[2px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#2b2622] transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            title={canUpdateShelf ? "Modifier l'emplacement" : "Permission manquante"}
                          >
                            <Pencil className="w-3.5 h-3.5" />
                          </button>

                          <button
                            type="button"
                            onClick={() => onOpenDelete && onOpenDelete(shelf)}
                            disabled={!canDeleteShelf}
                            className="p-1.5 rounded-[2px] text-[#ef4444] hover:bg-[#2d1616] transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            title={canDeleteShelf ? "Supprimer l'emplacement" : "Permission manquante"}
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      ) : (
        /* GALLERY / GRID VIEW */
        <div className="p-4 bg-[#2b2622]">
          {isLoading && shelves.length === 0 ? (
            <div className="py-14 text-center text-[#aea69c] flex flex-col items-center justify-center gap-2">
              <RefreshCw className="w-5 h-5 animate-spin text-[#f7f5f0]" />
              <p className="text-xs font-mono">Chargement des cartes emplacements...</p>
            </div>
          ) : shelves.length === 0 ? (
            <div className="py-14 text-center text-[#aea69c] flex flex-col items-center justify-center gap-2">
              <Archive className="w-8 h-8 text-[#aea69c]" />
              <p className="text-sm font-medium text-[#f7f5f0]">Aucun emplacement disponible</p>
            </div>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {shelves.map((shelf, idx) => {
                const globalIndex = (currentPage - 1) * limit + idx + 1;
                const formattedIndex = String(globalIndex).padStart(2, '0');

                return (
                  <div
                    key={shelf.shelfId}
                    onClick={() => onSelectShelf(shelf)}
                    className="bg-[#383330] border border-[#3f3a36] hover:border-[#4d4742] rounded-[4px] p-4 shadow-xs transition-all text-left space-y-3 relative group cursor-pointer"
                  >
                    {/* Header */}
                    <div className="flex items-center justify-between">
                      <span className="px-1.5 py-0.5 rounded-[2px] bg-[#2b2622] border border-[#3f3a36] text-[10px] font-mono text-[#dad2c1]">
                        INDEX #{formattedIndex}
                      </span>
                    </div>

                    {/* Title */}
                    <div className="flex items-start gap-3">
                      <div className="min-w-0 flex-1">
                        <h3 className="font-medium text-xs text-[#f7f5f0] truncate group-hover:text-white transition-colors">
                          {shelf.shelfName ?? 'Emplacement sans nom'}
                        </h3>
                      </div>
                    </div>

                    {/* Stats & Quantity */}
                    <div className="pt-2 border-t border-[#3f3a36] flex items-center justify-between text-xs">
                      <span className="text-[#aea69c] font-mono text-[11px] flex items-center gap-1">
                        {shelf.stock?.stockName ? (
                          <>
                            <Warehouse className="w-3 h-3 text-[#f7f5f0]" />
                            <span className="text-[#f7f5f0] truncate max-w-[110px]">{shelf.stock.stockName}</span>
                          </>
                        ) : (
                          'Stock initial :'
                        )}
                      </span>
                      <span
                        className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-[2px] text-[10px] font-mono border ${
                          shelf.shelfQuantity > 0
                            ? 'bg-[#162b22] text-[#10b981] border-[#1e3d30]'
                            : 'bg-[#2d1616] text-[#ef4444] border-[#451e1e]'
                        }`}
                      >
                        {shelf.shelfQuantity} unités
                      </span>
                    </div>

                    {/* Action Bar */}
                    <div className="bg-[#2b2622] border border-[#3f3a36] rounded-[3px] p-2 flex items-center justify-between text-[11px] font-mono text-[#aea69c]">
                      <span className="truncate max-w-[140px]">{shelf.shelfId}</span>
                      <div className="flex items-center gap-1" onClick={(e) => e.stopPropagation()}>
                        <button
                          type="button"
                          onClick={(e) => handleCopyId(e, shelf.shelfId)}
                          className="p-1 hover:text-[#f7f5f0] rounded-[2px] transition-colors"
                          title="Copier le GUID"
                        >
                          {copiedId === shelf.shelfId ? (
                            <Check className="w-3.5 h-3.5 text-[#10b981]" />
                          ) : (
                            <Copy className="w-3.5 h-3.5" />
                          )}
                        </button>
                        <button
                          type="button"
                          onClick={() => onSelectShelf(shelf)}
                          className="p-1 hover:text-[#f7f5f0] rounded-[2px] transition-colors"
                          title="Voir les détails"
                        >
                          <Eye className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => onOpenUpdate?.(shelf)}
                          disabled={!canUpdateShelf}
                          className="p-1 hover:text-[#f7f5f0] rounded-[2px] transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
                          title={canUpdateShelf ? "Modifier" : "Permission manquante"}
                        >
                          <Pencil className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => onOpenDelete?.(shelf)}
                          disabled={!canDeleteShelf}
                          className="p-1 text-[#ef4444] hover:bg-[#2d1616] rounded-[2px] transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
                          title={canDeleteShelf ? "Supprimer" : "Permission manquante"}
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* Pagination Footer */}
      {totalPages > 1 && (
        <div className="px-4 py-2.5 bg-[#2b2622] border-t border-[#3f3a36] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#aea69c] font-mono">
          <div>
            Page <span className="text-[#f7f5f0]">{currentPage}</span> /{' '}
            <span className="text-[#f7f5f0]">{totalPages}</span> ({totalShelves} emplacements)
          </div>

          <div className="flex items-center gap-1">
            <button
              type="button"
              onClick={() => onPageChange(1)}
              disabled={currentPage <= 1 || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Première page"
            >
              <ChevronsLeft className="w-3.5 h-3.5" />
            </button>
            <button
              type="button"
              onClick={() => onPageChange(Math.max(1, currentPage - 1))}
              disabled={currentPage <= 1 || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Page précédente"
            >
              <ChevronLeft className="w-3.5 h-3.5" />
            </button>

            {/* Page buttons */}
            <div className="flex items-center gap-1 px-1">
              {(() => {
                const pages: number[] = [];
                if (totalPages <= 5) {
                  for (let i = 1; i <= Math.max(totalPages, 1); i++) pages.push(i);
                } else if (currentPage <= 3) {
                  pages.push(1, 2, 3, 4, 5);
                } else if (currentPage >= totalPages - 2) {
                  for (let i = totalPages - 4; i <= totalPages; i++) pages.push(i);
                } else {
                  pages.push(currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2);
                }

                return pages.map((pageNum) => {
                  const isActive = pageNum === currentPage;
                  return (
                    <button
                      key={`page-btn-${pageNum}`}
                      type="button"
                      onClick={() => onPageChange(pageNum)}
                      disabled={isLoading}
                      className={`w-6 h-6 rounded-[2px] text-xs font-mono transition-colors cursor-pointer flex items-center justify-center ${
                        isActive
                          ? 'bg-[#f7f5f0] text-[#2b2622] font-semibold'
                          : 'bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] border border-[#3f3a36]'
                      }`}
                    >
                      {pageNum}
                    </button>
                  );
                });
              })()}
            </div>

            <button
              type="button"
              onClick={() => onPageChange(Math.min(totalPages, currentPage + 1))}
              disabled={currentPage >= totalPages || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Page suivante"
            >
              <ChevronRight className="w-3.5 h-3.5" />
            </button>
            <button
              type="button"
              onClick={() => onPageChange(totalPages)}
              disabled={currentPage >= totalPages || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Dernière page"
            >
              <ChevronsRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/shelf/UpdateShelfModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState, useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { updateShelfSchema, UpdateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import { Stock } from '@/types/stock';
import { REQUIRED_UPDATE_PERMISSION } from '@/services/shelf.service';
import { InsufficientPermissionException } from '@/services/shelf.errors';
import { Shelf } from '@/types/shelf';
import {
  X,
  Edit3,
  Loader2,
  ShieldAlert,
  Hash,
  Warehouse,
  Database,
  AlertCircle,
} from 'lucide-react';

const DEFAULT_STOCK_ID = '606d4178-e0a8-48b9-be6d-9538fa61135a';

interface UpdateShelfModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateShelfModal(props: UpdateShelfModalProps) {
  if (!props.isOpen || !props.shelf) return null;

  return (
    <UpdateShelfModalContent
      key={`${props.shelf.shelfId}:${props.shelf.shelfName}:${props.shelf.stockId ?? ''}`}
      {...props}
    />
  );
}

function UpdateShelfModalContent({
  shelf,
  isOpen,
  onClose,
  onSuccess,
}: UpdateShelfModalProps) {
  const api = useApi();
  const { updateShelf, isUpdating } = useShelves();
  const { canUpdateShelf, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [stocks, setStocks] = useState<Stock[]>([]);
  const [isLoadingStocks, setIsLoadingStocks] = useState(false);

  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<UpdateShelfFormValues>({
    resolver: zodResolver(updateShelfSchema),
    defaultValues: {
      shelfName: shelf?.shelfName ?? '',
      stockId: shelf?.stockId ?? DEFAULT_STOCK_ID,
    },
    mode: 'onChange',
  });

  useEffect(() => {
    if (isOpen) {
      let isMounted = true;
      setIsLoadingStocks(true);
      StockService.getAllStocks(api, { limit: 100 })
        .then((res) => {
          if (isMounted && res?.stocks) {
            setStocks(res.stocks);
          }
        })
        .catch((err) => {
          console.warn('[UpdateShelfModal] Failed to load stocks list:', err);
        })
        .finally(() => {
          if (isMounted) setIsLoadingStocks(false);
        });
      return () => {
        isMounted = false;
      };
    }
  }, [isOpen, api]);

  if (!isOpen || !shelf) return null;

  const onSubmit = async (values: UpdateShelfFormValues) => {
    setServerError(null);

    // Client-side permission guard check
    if (!canUpdateShelf) {
      const err = new InsufficientPermissionException(
        REQUIRED_UPDATE_PERMISSION,
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne possède pas la permission '${REQUIRED_UPDATE_PERMISSION}' pour modifier cet emplacement.`,
      );
      setServerError(err.message);
      throw err;
    }

    try {
      await updateShelf({
        id: shelf.shelfId,
        data: values,
      });
      onClose();
      if (onSuccess) onSuccess();
    } catch (err: unknown) {
      console.error('[UpdateShelfModal] Update failed:', err);
      setServerError(getErrorMessage(err, 'Échec de la modification de l’emplacement.'));
    }
  };

  return (
    <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-xs p-4 animate-in fade-in duration-150">
      {/* Modal Surface (#6b7b97 Theme) */}
      <div
        className="w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-xl overflow-hidden animate-in zoom-in-95 duration-150"
        role="dialog"
        aria-modal="true"
        aria-labelledby="update-shelf-title"
      >
        {/* Modal Header */}
        <div className="px-6 py-5 border-b border-[#3f3a36] flex items-center justify-between bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0]">
              <Edit3 className="w-5 h-5" />
            </div>
            <div>
              <h2 id="update-shelf-title" className="text-lg font-semibold text-white tracking-tight">
                Modifier l’emplacement
              </h2>
            </div>
          </div>

          <button
            type="button"
            onClick={onClose}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer"
            aria-label="Fermer"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Security & Entitlement Warning Banner */}
        {!canUpdateShelf && (
          <div className="mx-6 mt-5 p-3.5 bg-amber-950/50 border border-amber-500/50 rounded-lg flex items-start gap-3 text-left">
            <ShieldAlert className="w-5 h-5 text-amber-300 shrink-0 mt-0.5" />
            <div className="text-xs text-amber-200 space-y-1">
              <p className="font-semibold">Autorisation requise : {REQUIRED_UPDATE_PERMISSION}</p>
              <p>
                Votre rôle ne dispose pas de la permission nécessaire pour exécuter la méthode PATCH sur cet emplacement.
              </p>
            </div>
          </div>
        )}

        {/* Error Alert */}
        {serverError && (
          <div className="mx-6 mt-4 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg flex items-start gap-3 text-left">
            <AlertCircle className="w-5 h-5 text-rose-300 shrink-0 mt-0.5" />
            <div className="text-xs text-rose-200 space-y-0.5">
              <p className="font-semibold">Erreur de modification</p>
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Target Shelf UUID info */}
          <div className="p-3 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg text-xs space-y-1 text-white">
            <div className="flex items-center justify-between text-white/85">
              <span className="font-medium flex items-center gap-1.5">
                <Database className="w-3.5 h-3.5 text-white" />
                Identifiant
              </span>
              <span className="font-mono text-[11px] text-white truncate max-w-[200px]">
                {shelf.shelfId}
              </span>
            </div>
          </div>

          {/* Field: shelfName */}
          <div className="space-y-1.5">
            <label
              htmlFor="edit-shelfName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom de l’emplacement</span>
              <span className="text-[11px] text-white/70">1 à 100 caractères</span>
            </label>
            <input
              id="edit-shelfName"
              type="text"
              disabled={isUpdating || isSubmitting}
              className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                errors.shelfName
                  ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                  : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
              }`}
              {...register('shelfName')}
            />
            {errors.shelfName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.shelfName.message}
              </p>
            )}
          </div>

          {/* Field: stockId (Rattachement Stock) */}
          <div className="space-y-1.5">
            <label
              htmlFor="edit-stockId"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span className="flex items-center gap-1.5">
                <Warehouse className="w-3.5 h-3.5 text-[#f7f5f0]" />
                Stock / Entrepôt de rattachement
              </span>
            </label>
            <div className="relative">
              <select
                id="edit-stockId"
                disabled={isUpdating || isSubmitting || isLoadingStocks}
                className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20 cursor-pointer disabled:opacity-50"
                {...register('stockId')}
              >
                {stocks.length > 0 ? (
                  stocks.map((stock) => (
                    <option key={stock.stockId} value={stock.stockId} className="bg-[#2b2622] text-white">
                      {stock.stockName || 'Stock sans nom'} {stock.stockId === DEFAULT_STOCK_ID ? '(Principal)' : ''}
                    </option>
                  ))
                ) : (
                  <option value={DEFAULT_STOCK_ID} className="bg-[#2b2622] text-white">
                    Stock Principal Yacine
                  </option>
                )}
              </select>
            </div>
            {errors.stockId && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockId.message}
              </p>
            )}
          </div>

          {/* Read-only Shelf Quantity Card */}
          <div className="p-3.5 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg text-xs flex items-center justify-between">
            <div className="space-y-0.5">
              <span className="font-semibold text-white flex items-center gap-1.5">
                <Hash className="w-3.5 h-3.5 text-white" />
                Quantité en stock actuelle
              </span>
              <p className="text-[11px] text-white/75">
                Les stocks sont gérés exclusivement via les mouvements d&apos;entrée et de transfert.
              </p>
            </div>
            <span className="text-base font-bold font-mono px-3 py-1 bg-[#2b2622] border border-[#3f3a36] rounded-md text-white">
              {shelf.shelfQuantity}
            </span>
          </div>

          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isUpdating || isSubmitting}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isUpdating || isSubmitting || !canUpdateShelf}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isUpdating || isSubmitting ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Edit3 className="w-4 h-4" />
                  <span>Enregistrer les modifications</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/stock/CreateStockModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { createStockSchema, CreateStockFormValues } from '@/schemas/stock.schema';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import {
  X,
  Plus,
  Loader2,
  ShieldAlert,
  Warehouse,
  AlertCircle,
  Database,
} from 'lucide-react';

interface CreateStockModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function CreateStockModal({ isOpen, onClose, onSuccess }: CreateStockModalProps) {
  const api = useApi();
  const { canCreateStock, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [isSubmittingManual, setIsSubmittingManual] = useState(false);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<CreateStockFormValues>({
    resolver: zodResolver(createStockSchema),
    defaultValues: {
      stockName: '',
      stockStatus: 'ACTIVE',
    },
    mode: 'onChange',
  });

  if (!isOpen) return null;

  const onSubmit = async (values: CreateStockFormValues) => {
    setServerError(null);

    if (!canCreateStock) {
      setServerError(
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne dispose pas de la permission requise pour créer un stock.`,
      );
      return;
    }

    try {
      setIsSubmittingManual(true);
      await StockService.createStock(api, {
        stockName: values.stockName.trim(),
        stockStatus: values.stockStatus,
      });

      reset();
      if (onSuccess) onSuccess();
      onClose();
    } catch (err: unknown) {
      setServerError(getErrorMessage(err, 'Erreur lors de la création du stock'));
    } finally {
      setIsSubmittingManual(false);
    }
  };

  const isBusy = isSubmitting || isSubmittingManual;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#111]/40 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        className="relative w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden transform transition-all"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        {/* Modal Header */}
        <div className="flex items-center justify-between px-6 py-4.5 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] flex items-center justify-center shadow-2xs">
              <Warehouse className="w-5 h-5" />
            </div>
            <div>
              <h2 id="modal-title" className="text-base font-semibold text-white leading-tight">
                Nouveau Stock / Entrepôt
              </h2>
              <p className="text-xs text-white/80 mt-0.5">
                Enregistrer un nouvel emplacement de stockage principal
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            disabled={isBusy}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer disabled:opacity-50"
            aria-label="Fermer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Permission Advisory Banner */}
        {!canCreateStock && (
          <div className="px-6 py-3 bg-amber-950/50 border-b border-amber-500/50 flex items-start gap-2.5 text-xs text-amber-200">
            <ShieldAlert className="w-4 h-4 shrink-0 text-amber-300 mt-0.5" />
            <div>
              <span className="font-semibold">Droits insuffisants : </span>
              Votre profil ({roleName ?? 'Utilisateur'}) ne possède pas la permission de création de stock.
            </div>
          </div>
        )}

        {/* Server / Validation Error Feedback */}
        {serverError && (
          <div className="m-6 mb-0 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg text-xs text-rose-200 flex items-start gap-2.5 animate-in fade-in duration-200">
            <AlertCircle className="w-4 h-4 shrink-0 text-rose-300 mt-0.5" />
            <div className="flex-1 font-medium leading-relaxed">
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Field: stockName */}
          <div className="space-y-1.5">
            <label
              htmlFor="stockName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom du Stock <span className="text-rose-300">*</span></span>
              <span className="text-[11px] text-white/70">5 à 50 caractères</span>
            </label>
            <input
              id="stockName"
              type="text"
              disabled={isBusy}
              placeholder="ex: Stock Principal Yacine, Entrepôt Ouest..."
              className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                errors.stockName
                  ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                  : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
              }`}
              {...register('stockName')}
            />
            {errors.stockName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockName.message}
              </p>
            )}
          </div>

          {/* Field: stockStatus */}
          <div className="space-y-1.5">
            <label
              htmlFor="stockStatus"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Statut opérationnel</span>
              <span className="text-[11px] text-white/70">Table StockStatus</span>
            </label>
            <select
              id="stockStatus"
              disabled={isBusy}
              className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20"
              {...register('stockStatus')}
            >
              <option value="ACTIVE" className="bg-[#2b2622] text-white">ACTIVE (En activité)</option>
              <option value="INACTIVE" className="bg-[#2b2622] text-white">INACTIVE (En pause)</option>
              <option value="ARCHIVED" className="bg-[#2b2622] text-white">ARCHIVED (Archivé)</option>
            </select>
          </div>


          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isBusy}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isBusy || !canCreateStock}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isBusy ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Plus className="w-4 h-4" />
                  <span>Créer l’emplacement</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/stock/StockDetailModal.tsx">
'use client';

import { useQuery } from '@tanstack/react-query';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import {
  X,
  Warehouse,
  Layers,
  Database,
  CheckCircle2,
  AlertTriangle,
  Archive,
  Loader2,
  ArrowUpRight,
} from 'lucide-react';
import Link from 'next/link';

interface StockDetailModalProps {
  stockId: string | null;
  isOpen: boolean;
  onClose: () => void;
}

export function StockDetailModal({ stockId, isOpen, onClose }: StockDetailModalProps) {
  const api = useApi();

  const { data: stock, isLoading, error } = useQuery({
    queryKey: ['stock-detail', stockId],
    queryFn: () => (stockId ? StockService.getStockById(api, stockId) : null),
    enabled: isOpen && !!stockId,
    staleTime: 10 * 1000,
  });

  if (!isOpen || !stockId) return null;

  const statusName = stock?.stockStatus?.stockStatusName || 'ACTIVE';

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#111]/40 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        className="relative w-full max-w-2xl bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden transform transition-all max-h-[90vh] flex flex-col text-left"
        role="dialog"
        aria-modal="true"
      >
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4.5 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] flex items-center justify-center shadow-2xs">
              <Warehouse className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-base font-semibold text-white leading-tight">
                  {stock?.stockName ?? 'Détails du Stock'}
                </h2>
                {stock && (
                  <span
                    className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wide uppercase ${
                      statusName === 'ACTIVE'
                        ? 'bg-emerald-950/40 text-emerald-200 border border-emerald-400/40'
                        : statusName === 'INACTIVE'
                        ? 'bg-amber-950/40 text-amber-200 border border-amber-400/40'
                        : 'bg-slate-900/40 text-slate-200 border border-slate-400/40'
                    }`}
                  >
                    {statusName === 'ACTIVE' && <CheckCircle2 className="w-3 h-3" />}
                    {statusName === 'INACTIVE' && <AlertTriangle className="w-3 h-3" />}
                    {statusName === 'ARCHIVED' && <Archive className="w-3 h-3" />}
                    {statusName}
                  </span>
                )}
              </div>
              <p className="text-xs text-white/80 mt-0.5 font-mono">
                UUID : {stockId}
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer"
            aria-label="Fermer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Modal Content */}
        <div className="p-6 overflow-y-auto space-y-6 flex-1 text-left">
          {isLoading ? (
            <div className="py-12 flex flex-col items-center justify-center gap-2 text-sm text-white/80">
              <Loader2 className="w-6 h-6 animate-spin text-white" />
              <span>Chargement des détails du stock...</span>
            </div>
          ) : error ? (
            <div className="p-4 rounded-lg bg-rose-950/50 border border-rose-500/50 text-rose-200 text-xs">
              Impossible de charger les données de ce stock.
            </div>
          ) : stock ? (
            <>
              {/* Summary Metric Cards */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className="p-4 rounded-lg bg-[#2b2622]/60 border border-[#3f3a36] space-y-1 text-white">
                  <div className="flex items-center justify-between text-xs text-white/85">
                    <span>Emplacements associés</span>
                    <Layers className="w-4 h-4 text-white" />
                  </div>
                  <div className="text-2xl font-bold text-white">
                    {stock._count?.shelves ?? stock.shelves?.length ?? 0}
                  </div>
                  <p className="text-[11px] text-white/80">
                    Emplacements physiques rattachés
                  </p>
                </div>

                <div className="p-4 rounded-lg bg-[#2b2622]/60 border border-[#3f3a36] space-y-1 text-white">
                  <div className="flex items-center justify-between text-xs text-white/85">
                    <span>Statut</span>
                    <Database className="w-4 h-4 text-white" />
                  </div>
                  <div className="text-sm font-semibold text-white flex items-center gap-1.5 pt-1">
                    <span className="w-2 h-2 rounded-full bg-emerald-400" />
                    <span>{statusName}</span>
                  </div>
                </div>
              </div>

              {/* Associated Shelves Section */}
              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <h3 className="text-xs font-semibold uppercase tracking-wider text-white flex items-center gap-1.5">
                    <Layers className="w-3.5 h-3.5 text-white" />
                    Emplacements contenus dans ce stock ({stock.shelves?.length ?? 0})
                  </h3>
                  <Link
                    href="/shelves"
                    className="text-xs text-white hover:text-white/80 underline flex items-center gap-1 font-medium"
                  >
                    <span>Voir tous les emplacements</span>
                    <ArrowUpRight className="w-3.5 h-3.5" />
                  </Link>
                </div>

                {(!stock.shelves || stock.shelves.length === 0) ? (
                  <div className="p-6 text-center border border-dashed border-[#3f3a36] rounded-lg text-xs text-white/80 bg-[#2b2622]/30">
                    Aucun emplacement rattaché pour le moment à cet entrepôt.
                  </div>
                ) : (
                  <div className="border border-[#3f3a36] rounded-lg overflow-hidden max-h-60 overflow-y-auto bg-[#2b2622]/60">
                    <table className="w-full text-xs text-left">
                      <thead className="bg-[#2b2622] text-white font-medium border-b border-[#3f3a36]">
                        <tr>
                          <th className="px-3 py-2">Nom de l&apos;emplacement</th>
                          <th className="px-3 py-2 text-right">Quantité d&apos;articles</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-[#455268]">
                        {stock.shelves.map((sh) => (
                          <tr key={sh.shelfId} className="hover:bg-white/10 transition-colors">
                            <td className="px-3 py-2.5 font-medium text-white">
                              {sh.shelfName || 'Emplacement sans nom'}
                            </td>
                            <td className="px-3 py-2.5 text-right font-mono text-white/90">
                              <span className="px-2 py-0.5 rounded-full bg-[#2b2622] border border-[#3f3a36] text-white">
                                {sh.shelfQuantity} {sh.shelfQuantity > 1 ? 'unités' : 'unité'}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            </>
          ) : null}
        </div>

        {/* Footer */}
        <div className="px-6 py-3.5 bg-[#2b2622] border-t border-[#3f3a36] flex items-center justify-end">
          <button
            type="button"
            onClick={onClose}
            className="px-4.5 py-2 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-xs font-medium rounded-lg transition-colors cursor-pointer"
          >
            Fermer
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/stock/UpdateStockModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { updateStockSchema, UpdateStockFormValues } from '@/schemas/stock.schema';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import { Stock } from '@/types/stock';
import {
  X,
  Save,
  Loader2,
  ShieldAlert,
  Warehouse,
  AlertCircle,
} from 'lucide-react';

interface UpdateStockModalProps {
  stock: Stock | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateStockModal(props: UpdateStockModalProps) {
  if (!props.isOpen || !props.stock) return null;

  return (
    <UpdateStockModalContent
      key={`${props.stock.stockId}:${props.stock.stockName}:${props.stock.stockStatus?.stockStatusName ?? ''}`}
      {...props}
    />
  );
}

function UpdateStockModalContent({ stock, isOpen, onClose, onSuccess }: UpdateStockModalProps) {
  const api = useApi();
  const { canUpdateStock, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [isSubmittingManual, setIsSubmittingManual] = useState(false);

  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<UpdateStockFormValues>({
    resolver: zodResolver(updateStockSchema),
    defaultValues: {
      stockName: stock?.stockName ?? '',
      stockStatus: stock?.stockStatus?.stockStatusName ?? 'ACTIVE',
    },
    mode: 'onChange',
  });

  if (!isOpen || !stock) return null;

  const onSubmit = async (values: UpdateStockFormValues) => {
    setServerError(null);

    if (!canUpdateStock) {
      setServerError(
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne dispose pas de la permission requise pour modifier ce stock.`,
      );
      return;
    }

    try {
      setIsSubmittingManual(true);
      await StockService.updateStock(api, stock.stockId, {
        stockName: values.stockName?.trim(),
        stockStatus: values.stockStatus,
      });

      if (onSuccess) onSuccess();
      onClose();
    } catch (err: unknown) {
      setServerError(getErrorMessage(err, 'Erreur lors de la modification du stock'));
    } finally {
      setIsSubmittingManual(false);
    }
  };

  const isBusy = isSubmitting || isSubmittingManual;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#111]/40 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        className="relative w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden transform transition-all"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-update-stock-title"
      >
        {/* Modal Header */}
        <div className="flex items-center justify-between px-6 py-4.5 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] flex items-center justify-center shadow-2xs">
              <Warehouse className="w-5 h-5" />
            </div>
            <div>
              <h2 id="modal-update-stock-title" className="text-base font-semibold text-white leading-tight">
                Modifier le Stock
              </h2>
              <p className="text-xs text-white/80 mt-0.5">
                ID : <span className="font-mono text-[11px] text-white">{stock.stockId.slice(0, 8)}...</span>
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            disabled={isBusy}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer disabled:opacity-50"
            aria-label="Fermer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Permission Advisory Banner */}
        {!canUpdateStock && (
          <div className="px-6 py-3 bg-amber-950/50 border-b border-amber-500/50 flex items-start gap-2.5 text-xs text-amber-200">
            <ShieldAlert className="w-4 h-4 shrink-0 text-amber-300 mt-0.5" />
            <div>
              <span className="font-semibold">Droits insuffisants : </span>
              Votre profil ({roleName ?? 'Utilisateur'}) ne possède pas la permission de modification de stock.
            </div>
          </div>
        )}

        {/* Server / Validation Error Feedback */}
        {serverError && (
          <div className="m-6 mb-0 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg text-xs text-rose-200 flex items-start gap-2.5 animate-in fade-in duration-200">
            <AlertCircle className="w-4 h-4 shrink-0 text-rose-300 mt-0.5" />
            <div className="flex-1 font-medium leading-relaxed">
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Field: stockName */}
          <div className="space-y-1.5">
            <label
              htmlFor="editStockName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom du Stock <span className="text-rose-300">*</span></span>
              <span className="text-[11px] text-white/70">5 à 50 caractères</span>
            </label>
            <input
              id="editStockName"
              type="text"
              disabled={isBusy}
              className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                errors.stockName
                  ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                  : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
              }`}
              {...register('stockName')}
            />
            {errors.stockName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockName.message}
              </p>
            )}
          </div>

          {/* Field: stockStatus */}
          <div className="space-y-1.5">
            <label
              htmlFor="editStockStatus"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Statut opérationnel</span>
              <span className="text-[11px] text-white/70">Table StockStatus</span>
            </label>
            <select
              id="editStockStatus"
              disabled={isBusy}
              className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20"
              {...register('stockStatus')}
            >
              <option value="ACTIVE" className="bg-[#2b2622] text-white">ACTIVE (En activité)</option>
              <option value="INACTIVE" className="bg-[#2b2622] text-white">INACTIVE (En pause)</option>
              <option value="ARCHIVED" className="bg-[#2b2622] text-white">ARCHIVED (Archivé)</option>
            </select>
          </div>

          {/* Associated Shelves Count info */}
          <div className="p-3 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg flex items-center justify-between text-xs text-white">
            <span className="text-white/85">Emplacements rattachés à ce stock :</span>
            <span className="px-2 py-0.5 rounded-full bg-[#2b2622] border border-[#3f3a36] text-white font-semibold text-xs">
              {stock._count?.shelves ?? stock.shelves?.length ?? 0} emplacements
            </span>
          </div>

          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isBusy}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isBusy || !canUpdateStock}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isBusy ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Save className="w-4 h-4" />
                  <span>Enregistrer les modifications</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

