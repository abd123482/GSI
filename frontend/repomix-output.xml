const sharp = require('sharp');

async function analyzeColors() {
  const inputPath = "C:/Users/KS/.gemini/antigravity-ide/brain/4451d9fd-4801-474f-a377-b6aaaf90d930/.user_uploaded/media_1789310526414.png";
  const { data, info } = await sharp(inputPath).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  const { width, height, channels } = info;

  let cyanSum = [0, 0, 0], cyanCount = 0;
  let navySum = [0, 0, 0], navyCount = 0;

  for (let i = 0; i < data.length; i += channels) {
    const r = data[i], g = data[i + 1], b = data[i + 2];
    if (r > 240 && g > 240 && b > 240) continue; // skip white
    
    // Distinguish cyan vs navy:
    // Cyan has high blue & high green (e.g. b > 180, g > 150)
    // Navy has low r, g, and moderate/low b (e.g. r < 50, g < 70, b < 120)
    if (g > 120 && b > 160) {
      cyanSum[0] += r; cyanSum[1] += g; cyanSum[2] += b;
      cyanCount++;
    } else {
      navySum[0] += r; navySum[1] += g; navySum[2] += b;
      navyCount++;
    }
  }

  console.log(`Cyan pixels: ${cyanCount}, avg color: rgb(${Math.round(cyanSum[0]/cyanCount)}, ${Math.round(cyanSum[1]/cyanCount)}, ${Math.round(cyanSum[2]/cyanCount)})`);
  console.log(`Navy pixels: ${navyCount}, avg color: rgb(${Math.round(navySum[0]/navyCount)}, ${Math.round(navySum[1]/navyCount)}, ${Math.round(navySum[2]/navyCount)})`);
}

analyzeColors().catch(console.error);
</file>

<file path="scripts/analyze-logo.js">
const sharp = require('sharp');
const path = require('path');
const fs = require('fs');

const inputPath = "C:/Users/KS/.gemini/antigravity-ide/brain/4451d9fd-4801-474f-a377-b6aaaf90d930/.user_uploaded/media_1789310526414.png";

async function analyzeConnectivity() {
  const { data, info } = await sharp(inputPath)
    .ensureAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });

  const { width, height, channels } = info;

  // Let's find bounding box of non-white pixels
  // Define white as: r > 240 && g > 240 && b > 240
  let minX = width, maxX = 0, minY = height, maxY = 0;
  let nonWhiteCount = 0;

  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      const idx = (y * width + x) * channels;
      const r = data[idx];
      const g = data[idx + 1];
      const b = data[idx + 2];
      
      const isWhite = (r > 235 && g > 235 && b > 235);
      if (!isWhite) {
        nonWhiteCount++;
        if (x < minX) minX = x;
        if (x > maxX) maxX = x;
        if (y < minY) minY = y;
        if (y > maxY) maxY = y;
      }
    }
  }

  console.log(`Non-white pixels: ${nonWhiteCount} / ${width * height} (${((nonWhiteCount / (width * height)) * 100).toFixed(1)}%)`);
  console.log(`Bounding box: x: [${minX}, ${maxX}], y: [${minY}, ${maxY}] (width: ${maxX - minX + 1}, height: ${maxY - minY + 1})`);
}

analyzeConnectivity().catch(console.error);
</file>

<file path="scripts/build-assets.js">
const sharp = require('sharp');
const path = require('path');
const fs = require('fs');

async function buildAssets() {
  const publicDir = path.join(__dirname, '../public');
  
  // The dark-mode optimized logo buffer
  const darkLogoPath = path.join(publicDir, 'somepharm-logo-dark.png');
  const mainLogoPath = path.join(publicDir, 'somepharm-logo.png');

  // Copy dark-mode optimized version to somepharm-logo.png as default
  fs.copyFileSync(darkLogoPath, mainLogoPath);
  console.log('Copied somepharm-logo-dark.png to somepharm-logo.png');

  // Create high-res square versions with slight padding for icons (192, 512, apple-icon)
  // Square container: 512x512, transparent
  await sharp(mainLogoPath)
    .resize(440, 440, { fit: 'contain', background: { r: 0, g: 0, b: 0, alpha: 0 } })
    .extend({
      top: 36,
      bottom: 36,
      left: 36,
      right: 36,
      background: { r: 0, g: 0, b: 0, alpha: 0 }
    })
    .png()
    .toFile(path.join(publicDir, 'icon-512.png'));

  // 192x192
  await sharp(path.join(publicDir, 'icon-512.png'))
    .resize(192, 192)
    .png()
    .toFile(path.join(publicDir, 'icon-192.png'));

  // apple-icon.png (180x180)
  await sharp(path.join(publicDir, 'icon-512.png'))
    .resize(180, 180)
    .png()
    .toFile(path.join(publicDir, 'apple-icon.png'));

  // 32x32 for favicon.ico
  await sharp(path.join(publicDir, 'icon-512.png'))
    .resize(32, 32)
    .png()
    .toFile(path.join(publicDir, 'favicon.png'));

  console.log('All branding assets generated successfully!');
}

buildAssets().catch(console.error);
</file>

