      authUser:
        authUser ?? null,

      permissions,

      roleName:
        authUser?.roleName ??
        null,

      isAdmin,

      canReadDashboard,

      canReadEquipment,
      canCreateEquipment,
      canUpdateEquipment,
      canDeleteEquipment,

      canReadSerialNumber,
      canCreateSerialNumber,
      canUpdateSerialNumber,
      canDeleteSerialNumber,

      canReadMovement,
      canCreateMovement,

      canReadShelf,
      canCreateShelf,
      canUpdateShelf,
      canDeleteShelf,

      canReadStock,
      canCreateStock,
      canUpdateStock,
      canDeleteStock,

      canManageUsers,
      canManageRoles,

      canReadInventory,
      canCreateInventory,
      canLaunchInventory,
      canCountInventory,
      canAdjudicateInventory,
      canFinalizeInventory,
      canDeleteInventory,

      hasPermission,

      isLoading:
        !isLoaded ||
