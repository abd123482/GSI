        </div>
      </div>

      {mobileOpen && (
        <div className="space-y-1 border-t border-[#3f3a36] bg-[#2b2622] px-4 py-3 sm:hidden">
          <MobileLink
            href="/stocks"
            text="Vue d'ensemble"
            active={active.stocks}
            close={() => setMobileOpen(false)}
          />
          <MobileLink
            href="/shelves"
            text="Emplacements"
            active={active.shelves}
            close={() => setMobileOpen(false)}
          />
          <MobileLink
            href="/equipment"
            text="Articles"
            active={active.equipment}
            close={() => setMobileOpen(false)}
          />

          {permissions.canReadMovement && (
            <MobileLink
              href="/movements"
              text="Mouvements"
              active={active.movements}
              close={() => setMobileOpen(false)}
            />
          )}

          {permissions.canReadInventory && (
            <MobileLink
              href="/inventory"
              text="Inventaires"
              active={active.inventory}
              close={() => setMobileOpen(false)}
            />
          )}
        </div>
      )}
    </header>
  );
}

function NavItem({
  href,
  icon,
  text,
}: {
  href: string;
  icon: React.ReactNode;
  text: string;
}) {
  return (
    <DropdownMenuItem className="cursor-pointer focus:bg-[#383330] focus:text-[#f7f5f0]">
      <Link
        href={href}
        className="flex w-full items-center gap-2"
      >
        {icon}
        {text}
      </Link>
    </DropdownMenuItem>
  );
}

function MobileLink({
  href,
  text,
  active,
  close,
}: {
  href: string;
  text: string;
  active: boolean;
  close: () => void;
}) {
  return (
    <Link
      href={href}
      onClick={close}
      className={`block rounded-[3px] p-2 text-xs font-medium ${active
        ? 'border border-[#3f3a36] bg-[#383330] text-[#f7f5f0]'
        : 'text-[#c9c0ad] hover:bg-[#383330]'
        }`}
    >
      {text}
    </Link>
  );
}
