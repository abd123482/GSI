<file path="tests/movement-draft.test.mts">
import { test } from "node:test";
import assert from "node:assert/strict";
// @ts-expect-error Node's type stripping uses the source extension.
import * as movementDraft from "../src/lib/movement-draft.ts";
const { buildMovementItems, createMovementDraft } = movementDraft;
import type { Equipment } from "../src/types/equipment";

const equipment: Equipment = {
  equipmentId: "equipment-a",
  equipmentName: "Article A",
  equipmentQuantity: 10,
  minequipmentQuantity: 0,
  hasSerialNumber: false,
  equipmentShelfs: [
    {
      equipmentShelfId: "allocation",
      equipmentId: "equipment-a",
      shelfId: "source",
      equipmentQuantity: 10,
    },
  ],
};

test("several selected articles become one complete submission payload", () => {
  const first = {
    ...createMovementDraft(equipment),
    quantity: 3,
    destinationShelfId: "destination",
  };
  const second = {
    ...createMovementDraft({
      ...equipment,
      equipmentId: "equipment-b",
      equipmentName: "Article B",
    }),
    quantity: 2,
    destinationShelfId: "destination",
  };
  const items = buildMovementItems([first, second]);
  assert.equal(items.length, 2);
  assert.deepEqual(
    items.map((item) => item.equipmentId),
    ["equipment-a", "equipment-b"],
  );
  assert.deepEqual(
    items.map((item) => item.movementQuantity),
    [3, 2],
  );
  assert.equal(first.quantity, 3);
});

test("one article can be confirmed directly without a staging step", () => {
  const items = buildMovementItems([
    { ...createMovementDraft(equipment), destinationShelfId: "destination" },
  ]);
  assert.equal(items.length, 1);
  assert.equal(items[0].movementQuantity, 1);
});

test("an incomplete article blocks submission of the entire document", () => {
  assert.throws(
    () =>
      buildMovementItems([
        {
          ...createMovementDraft(equipment),
          destinationShelfId: "destination",
        },
        createMovementDraft({ ...equipment, equipmentName: "Article B" }),
      ]),
    /Article B/,
  );
});

test("split routes cannot overdraw the same equipment allocation", () => {
  assert.throws(
    () =>
      buildMovementItems([
        {
          ...createMovementDraft(equipment),
          quantity: 6,
          destinationShelfId: "destination",
        },
        {
          ...createMovementDraft(equipment, "split"),
          quantity: 6,
          destinationShelfId: "other",
        },
      ]),
    /stock disponible/,
  );
});

const serialized: Equipment = {
  ...equipment,
  equipmentId: "serialized",
  hasSerialNumber: true,
  serialNumbers: [
    {
      serialNumberId: "sn1",
      serialNumberCode: "SN001",
      serialNumberStatus: "AVAILABLE",
      equipmentId: "serialized",
      shelfId: "source",
    },
    {
      serialNumberId: "sn2",
      serialNumberCode: "SN002",
      serialNumberStatus: "AVAILABLE",
      equipmentId: "serialized",
      shelfId: null,
    },
  ],
};

test("serials keep their own source and individual destination in the same payload", () => {
  const items = buildMovementItems([
    {
      ...createMovementDraft(serialized),
      type: "TRANSFER",
      serialIds: ["sn1", "sn2"],
      destinationShelfId: "destination",
      serialDestinations: { sn2: "other" },
    },
  ]);
  assert.equal(items[0].sourceShelfId, "source");
  assert.equal(items[0].movementType, "TRANSFER");
  assert.equal(items[1].sourceShelfId, undefined);
  assert.equal(items[1].destinationShelfId, "other");
  assert.equal(items[1].movementType, "IN");
});

test("invalid serial selections and duplicate serials block saving", () => {
  assert.throws(
    () => buildMovementItems([createMovementDraft(serialized)]),
    /numéro de série/,
  );
  assert.throws(
    () =>
      buildMovementItems([
        {
          ...createMovementDraft(serialized),
          serialIds: ["sn1", "sn1"],
          destinationShelfId: "destination",
        },
      ]),
    /plusieurs fois/,
  );
});

test("line cap and empty-document checks happen before submission", () => {
  assert.throws(() => buildMovementItems([]), /au moins/);
  assert.throws(
    () =>
      buildMovementItems(
        Array.from({ length: 101 }, (_, i) => ({
          ...createMovementDraft(equipment, String(i)),
          type: "IN",
          destinationShelfId: "destination",
        })),
      ),
    /100 lignes/,
  );
});
</file>

<file path="tests/movement-ledger.test.mts">
import { test } from 'node:test';
import assert from 'node:assert/strict';
// Node executes this pure TypeScript module without a browser or added dependencies.
// @ts-expect-error Node's type stripping requires a source extension.
import { calculateMovementAudit, flattenMovementLines } from '../src/lib/movement-ledger.ts';
import type { Movement } from '../src/types/movement';

const base: Movement = { mouvementId: 'header', mouvementQuantity: 12, mouvementStatus: 'MIXED', equipmentId: null, serialNumberId: null, sourceShelfId: null, destinationShelfId: null, createdAt: '2026-09-20T12:00:00Z' };
const header: Movement = { ...base, items: [
  { ...base, mouvementEquipmentId: 'line-a', equipmentId: 'eq-a', mouvementQuantity: 5, mouvementStatus: 'IN', destinationShelfId: 'shelf' },
  { ...base, mouvementEquipmentId: 'line-b', equipmentId: 'eq-b', mouvementQuantity: 7, mouvementStatus: 'OUT', sourceShelfId: 'shelf' },
] };

test('equipment ledger uses only matching child quantities, not the header total', () => {
  const audit = calculateMovementAudit([header], 10, 'EQ-A');
  assert.equal(audit.totalIn, 5);
  assert.equal(audit.totalOut, 0);
  assert.equal(audit.ledger.length, 1);
  assert.equal(audit.ledger[0].runningBalance, 10);
});
test('legacy rows and new rows coexist without counting a backfilled header twice', () => {
  const legacy = { ...base, mouvementId: 'legacy', equipmentId: 'eq-a', mouvementQuantity: 2, mouvementStatus: 'EXIT', sourceShelfId: 'shelf', createdAt: '2026-09-19T12:00:00Z' };
  const audit = calculateMovementAudit([header, legacy, header], 8, 'eq-a');
  assert.equal(audit.totalOut, 2);
  assert.equal(audit.totalIn, 5);
  assert.equal(audit.ledger.length, 2);
  assert.equal(audit.ledger[0].movement.mouvementId, 'legacy');
  assert.equal(audit.ledger[1].runningBalance, 8);
});
test('an unscoped multi-equipment ledger is rejected', () => {
  assert.throws(() => calculateMovementAudit([header], 10), /equipment ID/);
});
test('already projected legacy-compatible lines retain distinct serial lines', () => {
  const lines = flattenMovementLines([header]);
  assert.equal(flattenMovementLines(lines).length, 2);
  assert.equal(lines[0].mouvementId, lines[1].mouvementId);
});
</file>

