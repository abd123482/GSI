    shelves:
      pathname?.startsWith(
        '/shelves',
      ),

    equipment:
      pathname?.startsWith(
        '/equipment',
      ) ||
      pathname?.startsWith(
        '/equipments',
      ),

    movements:
      pathname?.startsWith(
        '/movements',
      ),

    inventory:
      pathname?.startsWith(
        '/inventory',
      ),
  };

  const stockAreaActive =
    active.stocks ||
    active.shelves ||
    active.equipment ||
    active.movements;

  return (
    <header className="sticky top-0 z-40 w-full border-b border-[#3f3a36] bg-[#2b2622]/95 backdrop-blur-md">
