              className="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#383330] hover:bg-[#453f3a] text-[#f7f5f0] border border-[#3f3a36] text-xs font-mono rounded-[2px] transition-colors cursor-pointer"
            >
