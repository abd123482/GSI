<file path="src/components/equipment/ViewEquipmentShelvesModal.tsx">
'use client';

import React, { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { Equipment, EquipmentWithShelvesResponse } from '@/types/equipment';
import { EquipmentService } from '@/services/equipment.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import {
  Layers,
  X,
  Copy,
  Check,
  Package,
  AlertTriangle,
  Info,
  RefreshCw,
  Barcode,
  Hash,
} from 'lucide-react';
import { toast } from 'sonner';

interface ViewEquipmentShelvesModalProps {
  isOpen: boolean;
  equipment: Equipment | null;
  onClose: () => void;
}

export const ViewEquipmentShelvesModal: React.FC<ViewEquipmentShelvesModalProps> = ({
  isOpen,
  equipment,
  onClose,
}) => {
  const api = useApi();
  const { permissions } = usePermissions();
  const [copiedId, setCopiedId] = useState<string | null>(null);

  const { data: remoteData, isLoading, refetch } = useQuery<EquipmentWithShelvesResponse>({
    queryKey: ['equipment-shelves', equipment?.equipmentId],
    queryFn: () =>
      EquipmentService.getEquipmentShelves(
        api,
        equipment!.equipmentId,
        permissions,
      ),
    enabled: isOpen && !!equipment?.equipmentId,
    staleTime: 10 * 1000,
  });

  const data = remoteData ?? (equipment as EquipmentWithShelvesResponse | null);

  if (!isOpen || !equipment) return null;

  const handleCopy = (e: React.MouseEvent, text: string, label: string) => {
    e.stopPropagation();
    navigator.clipboard.writeText(text);
    setCopiedId(text);
    toast.success(`${label} copié dans le presse-papier !`);
    setTimeout(() => setCopiedId(null), 2000);
  };

  const isSerialized = data?.hasSerialNumber ?? equipment.hasSerialNumber;
  const tuples = data?.equipmentShelfs ?? equipment.equipmentShelfs ?? [];
  const serials = data?.serialNumbers ?? equipment.serialNumbers ?? [];

  const totalStock = isSerialized
    ? serials.length
    : (data?.equipmentQuantity ?? equipment.equipmentQuantity ?? 0);

  // Calculate metrics
  const totalAllocated = isSerialized
    ? serials.filter((s) => s.shelfId !== null).length
    : tuples.reduce((sum, t) => sum + (t.equipmentQuantity || 0), 0);

  const unallocated = Math.max(0, totalStock - totalAllocated);
  const distinctShelvesCount = isSerialized
    ? new Set(serials.map((s) => s.shelfId).filter(Boolean)).size
    : tuples.length;

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs transition-opacity animate-in fade-in duration-200"
      onClick={onClose}
    >
      <div
        className="relative w-full max-w-2xl max-h-[90vh] bg-[#383330] text-white rounded-xl shadow-2xl border border-[#3f3a36] overflow-hidden flex flex-col animate-in zoom-in-95 duration-200"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg bg-[#2b2622] border border-white/20 flex items-center justify-center text-[#f7f5f0] shrink-0 shadow-2xs">
              <Layers className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-base font-semibold text-white">
                  Emplacements associés
                </h2>
                <span className="px-2 py-0.5 rounded text-[11px] font-medium bg-black/30 border border-white/20 text-white/90">
                  {isSerialized ? 'Sérialisé' : 'Standard'}
                </span>
              </div>
              <p className="text-xs text-white/70 truncate max-w-md">
                {equipment.equipmentName ?? 'Article sans nom'}
              </p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={() => refetch()}
              disabled={isLoading}
              className="p-1.5 text-white/80 hover:text-white hover:bg-white/10 rounded-md transition-colors cursor-pointer"
              title="Actualiser les emplacements"
            >
              <RefreshCw className={`w-4 h-4 ${isLoading ? 'animate-spin' : ''}`} />
            </button>
            <button
              type="button"
              onClick={onClose}
              className="p-1.5 text-white/80 hover:text-white hover:bg-white/10 rounded-md transition-colors cursor-pointer"
              title="Fermer"
            >
              <X className="w-4 h-4" />
            </button>
          </div>
        </div>

        {/* Modal Body */}
        <div className="p-6 overflow-y-auto space-y-5">
          {/* Metric Cards Grid */}
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div className="p-3 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg">
              <span className="text-[11px] font-medium text-white/70 flex items-center gap-1 mb-1">
                <Package className="w-3.5 h-3.5 text-white" />
                Stock Total
              </span>
              <p className="text-lg font-bold text-white">
                {totalStock} <span className="text-xs font-normal text-white/70">unités</span>
              </p>
            </div>

            <div className="p-3 bg-[#2b2622]/70 border border-emerald-400/40 rounded-lg">
              <span className="text-[11px] font-medium text-emerald-300 flex items-center gap-1 mb-1">
                <Check className="w-3.5 h-3.5" />
                Alloué en Emplacements
              </span>
              <p className="text-lg font-bold text-emerald-300">
                {totalAllocated} <span className="text-xs font-normal text-emerald-300/80">unités</span>
              </p>
            </div>

            <div className={`p-3 rounded-lg border ${
              unallocated > 0
                ? 'bg-amber-950/40 border-amber-400/40'
                : 'bg-[#2b2622]/60 border border-[#3f3a36]'
            }`}>
              <span className={`text-[11px] font-medium flex items-center gap-1 mb-1 ${
                unallocated > 0 ? 'text-amber-300' : 'text-white/70'
              }`}>
                <AlertTriangle className="w-3.5 h-3.5" />
                Non Alloué
              </span>
              <p className={`text-lg font-bold ${
                unallocated > 0 ? 'text-amber-300' : 'text-white'
              }`}>
                {unallocated} <span className="text-xs font-normal">unités</span>
              </p>
            </div>

            <div className="p-3 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg">
              <span className="text-[11px] font-medium text-white/70 flex items-center gap-1 mb-1">
                <Layers className="w-3.5 h-3.5 text-white" />
                Emplacements
              </span>
              <p className="text-lg font-bold text-white">
                {distinctShelvesCount} <span className="text-xs font-normal text-white/70">emplacements</span>
              </p>
            </div>
          </div>

          {/* Shelves Breakdown Table / List */}
          <div>
            <div className="flex items-center justify-between mb-2.5">
              <h3 className="text-xs font-semibold text-white uppercase tracking-wider">
                Emplacements de l&apos;Article
              </h3>
              <span className="text-[11px] text-white/70">
                {tuples.length} emplacement{tuples.length > 1 ? 's' : ''} enregistré{tuples.length > 1 ? 's' : ''}
              </span>
            </div>

            {tuples.length > 0 ? (
              <div className="border border-[#3f3a36] rounded-lg overflow-hidden divide-y divide-[#8191ad]/50 bg-[#2b2622]/60">
                <div className="bg-[#2b2622] px-4 py-2 text-[11px] font-semibold text-white/90 grid grid-cols-12 gap-2">
                  <span className="col-span-5">Emplacement</span>
                  <span className="col-span-3 text-center">Quantité Allouée</span>
                  <span className="col-span-4 text-right">Part du Stock</span>
                </div>

                {tuples.map((t) => {
                  const shelfName = t.shelf?.shelfName ?? 'Emplacement inconnu';
                  const qty = t.equipmentQuantity || 0;
                  const percent = totalStock > 0 ? Math.round((qty / totalStock) * 100) : 0;
                  return (
                    <div
                      key={t.equipmentShelfId || t.shelfId}
                      className="px-4 py-3 grid grid-cols-12 gap-2 items-center hover:bg-white/10 transition-colors"
                    >
                      <div className="col-span-5 min-w-0">
                        <div className="flex items-center gap-2">
                          <Layers className="w-4 h-4 text-[#f7f5f0] shrink-0" />
                          <span className="font-semibold text-xs text-white truncate">
                            {shelfName}
                          </span>
                        </div>
                        <div className="flex items-center gap-1.5 mt-0.5">
                          <span className="text-[10px] font-mono text-white/60 truncate max-w-[140px]">
                            {t.shelfId}
                          </span>
                          <button
                            type="button"
                            onClick={(e) => handleCopy(e, t.shelfId, "ID d'emplacement")}
                            className="text-white/60 hover:text-white transition-colors cursor-pointer"
                            title="Copier le GUID de l'emplacement"
                          >
                            {copiedId === t.shelfId ? (
                              <Check className="w-3 h-3 text-emerald-400" />
                            ) : (
                              <Copy className="w-3 h-3" />
                            )}
                          </button>
                        </div>
                      </div>

                      <div className="col-span-3 text-center">
                        <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#2b2622] text-emerald-300 border border-emerald-400/40 text-xs font-semibold">
                          <Hash className="w-3 h-3" />
                          {qty} {qty > 1 ? 'unités' : 'unité'}
                        </span>
                      </div>

                      <div className="col-span-4">
                        <div className="flex items-center justify-end gap-2">
                          <div className="w-24 bg-black/30 h-2 rounded-full overflow-hidden shrink-0">
                            <div
                              className="bg-[#38bdf8] h-full rounded-full transition-all duration-300"
                              style={{ width: `${Math.min(100, percent)}%` }}
                            />
                          </div>
                          <span className="text-[11px] font-medium text-white/80 w-9 text-right font-mono">
                            {percent}%
                          </span>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : (
              <div className="text-center py-8 border border-dashed border-[#3f3a36] rounded-lg bg-[#2b2622]/40 px-4">
                <Layers className="w-8 h-8 text-white/50 mx-auto mb-2" />
                <p className="text-xs font-semibold text-white mb-1">
                  Aucun emplacement assigné
                </p>
                <p className="text-[11px] text-white/70 max-w-sm mx-auto">
                  Cet article n&apos;a pas encore d&apos;unités réparties dans des emplacements. Enregistrez un mouvement d&apos;entrée ou de transfert pour assigner des emplacements.
                </p>
              </div>
            )}
          </div>

          {/* Child Serial Numbers Breakdown (If Serialized) */}
          {isSerialized && (
            <div>
              <div className="flex items-center justify-between mb-2.5">
                <h3 className="text-xs font-semibold text-white uppercase tracking-wider">
                  Numéros de Série & Emplacements Associés
                </h3>
                <span className="text-[11px] text-white/70">
                  {serials.length} numéro{serials.length > 1 ? 's' : ''} de série
                </span>
              </div>

              {serials.length > 0 ? (
                <div className="max-h-52 overflow-y-auto border border-[#3f3a36] rounded-lg divide-y divide-[#8191ad]/50 bg-[#2b2622]/60">
                  {serials.map((sn) => (
                    <div
                      key={sn.serialNumberId}
                      className="px-4 py-2 text-xs flex items-center justify-between hover:bg-white/10"
                    >
                      <div className="flex items-center gap-2">
                        <Barcode className="w-3.5 h-3.5 text-emerald-300" />
                        <span className="font-mono font-medium text-white">
                          {sn.serialNumberCode ?? 'S/N sans code'}
                        </span>
                      </div>
                      <div className="flex items-center gap-2">
                        {sn.shelf ? (
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[#2b2622] border border-white/20 text-[11px] font-medium text-white">
                            <Layers className="w-3 h-3 text-[#f7f5f0]" />
                            {sn.shelf.shelfName}
                          </span>
                        ) : (
                          <span className="text-[11px] text-white/60 italic">
                            Non assigné
                          </span>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <p className="text-xs text-white/70 italic">
                  Aucun numéro de série enregistré pour cet article.
                </p>
              )}
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="flex items-center justify-between px-6 py-3.5 border-t border-[#3f3a36] bg-[#2b2622]">
          <div className="text-[11px] text-white/70 flex items-center gap-1">
            <Info className="w-3.5 h-3.5 text-white/80" />
            <span>Consultation en lecture seule</span>
          </div>

          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={onClose}
              className="px-4 py-1.5 text-xs font-medium text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg transition-colors cursor-pointer"
            >
              Fermer
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/components/movement/MovementDetailModal.tsx">
'use client';

import {
    ArrowDownToLine,
    ArrowRight,
    ArrowRightLeft,
    ArrowUpFromLine,
    Barcode,
    CalendarClock,
    Copy,
    Hash,
    Package,
    UserRound,
    X,
} from 'lucide-react';
import { toast } from 'sonner';

import type { Movement } from '@/types/movement';

interface MovementDetailModalProps {
    movement: Movement | null;
    isOpen: boolean;
    onClose: () => void;
}

type MovementWithCreator = Movement & {
    createdByUser?: {
        userId: string;
        userName: string | null;
        userEmail: string | null;
    } | null;
};

function typeOf(
    movement: Movement,
): 'IN' | 'OUT' | 'TRANSFER' {
    const value =
        movement.mouvementStatus?.toUpperCase();

    if (value === 'IN') return 'IN';
    if (value === 'OUT') return 'OUT';

    return 'TRANSFER';
}

function formatDate(value?: string | null) {
    if (!value) return '—';

    const parsed = new Date(value);

    if (Number.isNaN(parsed.getTime())) {
        return value;
    }

    return new Intl.DateTimeFormat('fr-DZ', {
        dateStyle: 'medium',
        timeStyle: 'medium',
    }).format(parsed);
}

function routeName(
    shelf:
        | {
            shelfId: string;
            shelfName: string | null;
        }
        | null
        | undefined,
    id: string | null,
) {
    return shelf?.shelfName ?? id ?? '—';
}

export function MovementDetailModal({
    movement,
    isOpen,
    onClose,
}: MovementDetailModalProps) {
    if (!isOpen || !movement) return null;

    const typed = movement as MovementWithCreator;
    const type = typeOf(movement);

    const copyMovementId = async () => {
        await navigator.clipboard.writeText(
            movement.mouvementId,
        );

        toast.success('GUID copié');
    };

    const TypeIcon =
        type === 'IN'
            ? ArrowDownToLine
            : type === 'OUT'
                ? ArrowUpFromLine
                : ArrowRightLeft;

    const typeClass =
        type === 'IN'
            ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300'
            : type === 'OUT'
                ? 'border-rose-500/30 bg-rose-500/10 text-rose-300'
                : 'border-sky-500/30 bg-sky-500/10 text-sky-300';

    return (
        <div
            className="fixed inset-0 z-50 flex items-center justify-center bg-black/65 p-4 backdrop-blur-sm"
            onMouseDown={(event) => {
                if (event.target === event.currentTarget) {
                    onClose();
                }
            }}
        >
            <div className="max-h-[92vh] w-full max-w-4xl overflow-hidden rounded-[6px] border border-[#3f3a36] bg-[#2f2a26] shadow-2xl">
                <div className="flex items-start justify-between border-b border-[#3f3a36] bg-[#383330]/70 px-5 py-4">
                    <div className="min-w-0">
                        <div className="flex flex-wrap items-center gap-2">
                            <span
                                className={`inline-flex items-center gap-1.5 rounded-[3px] border px-2 py-1 text-[10px] font-semibold ${typeClass}`}
                            >
                                <TypeIcon className="h-3.5 w-3.5" />
                                {type === 'IN'
                                    ? 'ENTRÉE'
                                    : type === 'OUT'
                                        ? 'SORTIE'
                                        : 'TRANSFERT'}
                            </span>

                            <span className="font-mono text-[10px] text-[#8c827a]">
                                {movement.mouvementId}
                            </span>
                        </div>

                        <h2 className="mt-2 text-lg font-medium text-[#f7f5f0]">
                            Détail du mouvement
                        </h2>

                        <p className="mt-1 text-xs text-[#aea69c]">
                            Un document · une direction ·{' '}
                            {movement.items?.length ?? 0} ligne(s)
                        </p>
                    </div>

                    <button
                        type="button"
                        onClick={onClose}
                        className="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#2b2622] text-[#aea69c] transition-colors hover:text-[#f7f5f0]"
                        aria-label="Fermer"
                    >
                        <X className="h-4 w-4" />
                    </button>
                </div>

                <div className="max-h-[calc(92vh-145px)] overflow-y-auto p-5">
                    <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                        <InfoCard
                            icon={CalendarClock}
                            label="Date"
                            value={formatDate(movement.createdAt)}
                        />

                        <InfoCard
                            icon={Package}
                            label="Quantité totale"
                            value={`${movement.mouvementQuantity ?? 0} unité(s)`}
                        />

                        <InfoCard
                            icon={Hash}
                            label="Nombre de lignes"
                            value={`${movement.items?.length ?? 0}`}
                        />

                        <InfoCard
                            icon={UserRound}
                            label="Créé par"
                            value={
                                typed.createdByUser?.userName ??
                                typed.createdByUser?.userEmail ??
                                '—'
                            }
                        />
                    </div>

                    <div className="mt-4 rounded-[4px] border border-[#3f3a36] bg-[#2b2622] p-4">
                        <p className="mb-3 text-[10px] font-semibold uppercase tracking-wider text-[#8c827a]">
                            Trajet commun
                        </p>

                        <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
                            <RouteBox
                                label="Source"
                                value={routeName(
                                    movement.sourceShelf,
                                    movement.sourceShelfId,
                                )}
                            />

                            <ArrowRight className="mx-auto h-4 w-4 shrink-0 rotate-90 text-[#5c544d] sm:rotate-0" />

                            <RouteBox
                                label="Destination"
                                value={routeName(
                                    movement.destinationShelf,
                                    movement.destinationShelfId,
                                )}
                            />
                        </div>
                    </div>

                    <div className="mt-4 overflow-hidden rounded-[4px] border border-[#3f3a36]">
                        <div className="flex items-center justify-between border-b border-[#3f3a36] bg-[#383330]/55 px-4 py-3">
                            <div>
                                <h3 className="text-xs font-semibold text-[#f7f5f0]">
                                    Lignes du mouvement
                                </h3>
                                <p className="mt-0.5 text-[10px] text-[#8c827a]">
                                    Toutes les lignes partagent le même type et le même trajet.
                                </p>
                            </div>

                            <span className="font-mono text-xs text-[#aea69c]">
                                {movement.items?.length ?? 0}
                            </span>
                        </div>

                        <div className="divide-y divide-[#3f3a36]">
                            {(movement.items ?? []).map(
                                (item, index) => (
                                    <div
                                        key={
                                            item.mouvementEquipmentId ??
                                            `${item.equipmentId}-${item.serialNumberId ?? index}`
                                        }
                                        className="grid grid-cols-1 gap-3 px-4 py-3 sm:grid-cols-[42px_minmax(0,1fr)_minmax(0,1fr)_100px] sm:items-center"
                                    >
                                        <div className="flex h-8 w-8 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#383330] font-mono text-[10px] text-[#aea69c]">
                                            {String(index + 1).padStart(
                                                2,
                                                '0',
                                            )}
                                        </div>

                                        <div className="min-w-0">
                                            <p className="truncate text-xs font-medium text-[#f7f5f0]">
                                                {item.equipment?.equipmentName ??
                                                    item.equipmentId}
                                            </p>
                                            <p className="mt-1 truncate font-mono text-[10px] text-[#6f665f]">
                                                {item.equipmentId}
                                            </p>
                                        </div>

                                        <div className="min-w-0">
                                            {item.serialNumberId ? (
                                                <>
                                                    <p className="flex items-center gap-1.5 truncate text-xs text-[#c9c0ad]">
                                                        <Barcode className="h-3.5 w-3.5 shrink-0 text-[#8c827a]" />
                                                        {item.serialNumber
                                                            ?.serialNumberCode ??
                                                            item.serialNumberId}
                                                    </p>
                                                    <p className="mt-1 truncate font-mono text-[10px] text-[#6f665f]">
                                                        {item.serialNumberId}
                                                    </p>
                                                </>
                                            ) : (
                                                <span className="text-xs text-[#6f665f]">
                                                    Article quantitatif
                                                </span>
                                            )}
                                        </div>

                                        <div className="text-left sm:text-right">
                                            <span className="inline-flex rounded-[3px] border border-[#3f3a36] bg-[#383330] px-2 py-1 font-mono text-xs font-semibold text-[#f7f5f0]">
                                                {item.mouvementQuantity} u.
                                            </span>
                                        </div>
                                    </div>
                                ),
                            )}

                            {!movement.items?.length && (
                                <div className="px-4 py-8 text-center text-xs text-[#8c827a]">
                                    Aucune ligne enregistrée.
                                </div>
                            )}
                        </div>
                    </div>
                </div>

                <div className="flex items-center justify-between border-t border-[#3f3a36] bg-[#2b2622] px-5 py-3">
                    <button
                        type="button"
                        onClick={copyMovementId}
                        className="inline-flex items-center gap-1.5 rounded-[3px] border border-[#3f3a36] bg-[#383330] px-3 py-2 text-xs text-[#c9c0ad] transition-colors hover:text-[#f7f5f0]"
                    >
                        <Copy className="h-3.5 w-3.5" />
                        Copier GUID
                    </button>

                    <button
                        type="button"
                        onClick={onClose}
                        className="rounded-[3px] bg-[#f7f5f0] px-4 py-2 text-xs font-medium text-[#2b2622] transition-colors hover:bg-[#dad2c1]"
                    >
                        Fermer
                    </button>
                </div>
            </div>
        </div>
    );
}

function InfoCard({
    icon: Icon,
    label,
    value,
}: {
    icon: typeof Package;
    label: string;
    value: string;
}) {
    return (
        <div className="rounded-[4px] border border-[#3f3a36] bg-[#2b2622] p-3">
            <div className="flex items-center gap-2 text-[#8c827a]">
                <Icon className="h-3.5 w-3.5" />
                <span className="text-[10px] uppercase tracking-wider">
                    {label}
                </span>
            </div>
            <p className="mt-2 break-words text-xs font-medium text-[#f7f5f0]">
                {value}
            </p>
        </div>
    );
}

function RouteBox({
    label,
    value,
}: {
    label: string;
    value: string;
}) {
    return (
        <div className="min-w-0 flex-1 rounded-[3px] border border-[#3f3a36] bg-[#383330]/55 p-3">
            <p className="text-[10px] uppercase tracking-wider text-[#8c827a]">
                {label}
            </p>
            <p className="mt-1 truncate text-xs font-medium text-[#f7f5f0]">
                {value}
            </p>
        </div>
    );
}
</file>

<file path="src/components/movement/MovementListTable.tsx">
'use client';

import {
    ArrowDownToLine,
    ArrowRight,
    ArrowRightLeft,
    ArrowUpFromLine,
    ChevronLeft,
    ChevronRight,
    Eye,
    Loader2,
    Package,
} from 'lucide-react';

import type { Movement } from '@/types/movement';

interface MovementListTableProps {
    movements: Movement[];
    totalMovements: number;
    currentPage: number;
    totalPages: number;
    limit: number;
    isLoading?: boolean;
    isFetching?: boolean;
    onPageChange: (page: number) => void;
    onSelectMovement: (movement: Movement) => void;
}

type MovementWithCreator = Movement & {
    createdByUser?: {
        userId: string;
        userName: string | null;
        userEmail: string | null;
    } | null;
};

function movementType(
    movement: Movement,
): 'IN' | 'OUT' | 'TRANSFER' {
    const status = movement.mouvementStatus?.toUpperCase();

    if (status === 'IN') return 'IN';
    if (status === 'OUT') return 'OUT';

    return 'TRANSFER';
}

function MovementTypeBadge({
    movement,
}: {
    movement: Movement;
}) {
    const type = movementType(movement);

    if (type === 'IN') {
        return (
            <span className="inline-flex items-center gap-1 rounded-[3px] border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-[10px] font-semibold text-emerald-300">
                <ArrowDownToLine className="h-3 w-3" />
                ENTRÉE
            </span>
        );
    }

    if (type === 'OUT') {
        return (
            <span className="inline-flex items-center gap-1 rounded-[3px] border border-rose-500/30 bg-rose-500/10 px-2 py-1 text-[10px] font-semibold text-rose-300">
                <ArrowUpFromLine className="h-3 w-3" />
                SORTIE
            </span>
        );
    }

    return (
        <span className="inline-flex items-center gap-1 rounded-[3px] border border-sky-500/30 bg-sky-500/10 px-2 py-1 text-[10px] font-semibold text-sky-300">
            <ArrowRightLeft className="h-3 w-3" />
            TRANSFERT
        </span>
    );
}

function formatDate(value?: string | null) {
    if (!value) return '—';

    const parsed = new Date(value);

    if (Number.isNaN(parsed.getTime())) return value;

    return new Intl.DateTimeFormat('fr-DZ', {
        dateStyle: 'short',
        timeStyle: 'short',
    }).format(parsed);
}

function sourceName(movement: Movement) {
    return movement.sourceShelf?.shelfName ??
        movement.sourceShelfId ??
        '—';
}

function destinationName(movement: Movement) {
    return movement.destinationShelf?.shelfName ??
        movement.destinationShelfId ??
        '—';
}

export function MovementListTable({
    movements,
    totalMovements,
    currentPage,
    totalPages,
    limit,
    isLoading = false,
    isFetching = false,
    onPageChange,
    onSelectMovement,
}: MovementListTableProps) {
    if (isLoading) {
        return (
            <div className="flex min-h-64 items-center justify-center rounded-[4px] border border-[#3f3a36] bg-[#2f2a26]">
                <div className="flex items-center gap-2 text-xs text-[#aea69c]">
                    <Loader2 className="h-4 w-4 animate-spin" />
                    Chargement des mouvements...
                </div>
            </div>
        );
    }

    if (!movements.length) {
        return (
            <div className="flex min-h-64 flex-col items-center justify-center gap-3 rounded-[4px] border border-[#3f3a36] bg-[#2f2a26] px-6 text-center">
                <div className="flex h-10 w-10 items-center justify-center rounded-[4px] border border-[#3f3a36] bg-[#383330]">
                    <ArrowRightLeft className="h-5 w-5 text-[#aea69c]" />
                </div>
                <div>
                    <p className="text-sm font-medium text-[#f7f5f0]">
                        Aucun mouvement
                    </p>
                    <p className="mt-1 text-xs text-[#8c827a]">
                        Aucun document ne correspond aux filtres actuels.
                    </p>
                </div>
            </div>
        );
    }

    const start = (currentPage - 1) * limit + 1;
    const end = Math.min(
        currentPage * limit,
        totalMovements,
    );

    return (
        <div className="overflow-hidden rounded-[4px] border border-[#3f3a36] bg-[#2f2a26]">
            <div className="hidden overflow-x-auto md:block">
                <table className="w-full border-collapse">
                    <thead className="border-b border-[#3f3a36] bg-[#383330]/60">
                        <tr className="text-left text-[10px] uppercase tracking-wider text-[#8c827a]">
                            <th className="px-4 py-3 font-medium">Date</th>
                            <th className="px-4 py-3 font-medium">Type</th>
                            <th className="px-4 py-3 font-medium">Trajet</th>
                            <th className="px-4 py-3 font-medium">Lignes</th>
                            <th className="px-4 py-3 text-right font-medium">
                                Quantité
                            </th>
                            <th className="px-4 py-3 font-medium">Utilisateur</th>
                            <th className="w-14 px-4 py-3" />
                        </tr>
                    </thead>

                    <tbody className="divide-y divide-[#3f3a36]">
                        {movements.map((movement) => {
                            const typed =
                                movement as MovementWithCreator;

                            return (
                                <tr
                                    key={movement.mouvementId}
                                    onClick={() =>
                                        onSelectMovement(movement)
                                    }
                                    className="cursor-pointer transition-colors hover:bg-[#383330]/55"
                                >
                                    <td className="whitespace-nowrap px-4 py-3 text-xs text-[#c9c0ad]">
                                        {formatDate(movement.createdAt)}
                                    </td>

                                    <td className="px-4 py-3">
                                        <MovementTypeBadge
                                            movement={movement}
                                        />
                                    </td>

                                    <td className="px-4 py-3">
                                        <div className="flex min-w-52 items-center gap-2 text-xs">
                                            <span className="max-w-32 truncate text-[#c9c0ad]">
                                                {sourceName(movement)}
                                            </span>
                                            <ArrowRight className="h-3 w-3 shrink-0 text-[#5c544d]" />
                                            <span className="max-w-32 truncate text-[#f7f5f0]">
                                                {destinationName(movement)}
                                            </span>
                                        </div>
                                    </td>

                                    <td className="px-4 py-3">
                                        <span className="inline-flex items-center gap-1.5 text-xs text-[#c9c0ad]">
                                            <Package className="h-3.5 w-3.5 text-[#8c827a]" />
                                            {movement.items?.length ?? 0}
                                        </span>
                                    </td>

                                    <td className="px-4 py-3 text-right font-mono text-xs font-semibold text-[#f7f5f0]">
                                        {movement.mouvementQuantity ?? 0}
                                    </td>

                                    <td className="px-4 py-3 text-xs text-[#aea69c]">
                                        {typed.createdByUser?.userName ??
                                            typed.createdByUser?.userEmail ??
                                            '—'}
                                    </td>

                                    <td className="px-4 py-3 text-right">
                                        <button
                                            type="button"
                                            onClick={(event) => {
                                                event.stopPropagation();
                                                onSelectMovement(movement);
                                            }}
                                            className="inline-flex h-7 w-7 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#383330] text-[#aea69c] transition-colors hover:text-[#f7f5f0]"
                                            title="Voir le mouvement"
                                        >
                                            <Eye className="h-3.5 w-3.5" />
                                        </button>
                                    </td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>

            <div className="divide-y divide-[#3f3a36] md:hidden">
                {movements.map((movement) => {
                    const typed =
                        movement as MovementWithCreator;

                    return (
                        <button
                            key={movement.mouvementId}
                            type="button"
                            onClick={() =>
                                onSelectMovement(movement)
                            }
                            className="block w-full p-4 text-left transition-colors hover:bg-[#383330]/55"
                        >
                            <div className="flex items-start justify-between gap-3">
                                <div>
                                    <MovementTypeBadge
                                        movement={movement}
                                    />
                                    <p className="mt-2 text-xs text-[#8c827a]">
                                        {formatDate(movement.createdAt)}
                                    </p>
                                </div>

                                <span className="font-mono text-sm font-semibold text-[#f7f5f0]">
                                    {movement.mouvementQuantity ?? 0} u.
                                </span>
                            </div>

                            <div className="mt-3 flex items-center gap-2 text-xs">
                                <span className="truncate text-[#c9c0ad]">
                                    {sourceName(movement)}
                                </span>
                                <ArrowRight className="h-3 w-3 shrink-0 text-[#5c544d]" />
                                <span className="truncate text-[#f7f5f0]">
                                    {destinationName(movement)}
                                </span>
                            </div>

                            <div className="mt-3 flex items-center justify-between text-[11px] text-[#8c827a]">
                                <span>
                                    {movement.items?.length ?? 0} ligne(s)
                                </span>
                                <span>
                                    {typed.createdByUser?.userName ??
                                        typed.createdByUser?.userEmail ??
                                        '—'}
                                </span>
                            </div>
                        </button>
                    );
                })}
            </div>

            <div className="flex flex-col gap-3 border-t border-[#3f3a36] bg-[#2b2622]/70 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                <div className="flex items-center gap-2 text-[11px] text-[#8c827a]">
                    {isFetching && (
                        <Loader2 className="h-3 w-3 animate-spin" />
                    )}
                    <span>
                        {start}–{end} sur {totalMovements}
                    </span>
                </div>

                <div className="flex items-center gap-2">
                    <button
                        type="button"
                        disabled={currentPage <= 1 || isFetching}
                        onClick={() =>
                            onPageChange(
                                Math.max(1, currentPage - 1),
                            )
                        }
                        className="inline-flex h-8 items-center gap-1 rounded-[3px] border border-[#3f3a36] bg-[#383330] px-2.5 text-xs text-[#c9c0ad] disabled:cursor-not-allowed disabled:opacity-40"
                    >
                        <ChevronLeft className="h-3.5 w-3.5" />
                        Précédent
                    </button>

                    <span className="min-w-16 text-center font-mono text-xs text-[#aea69c]">
                        {currentPage} / {Math.max(totalPages, 1)}
                    </span>

                    <button
                        type="button"
                        disabled={
                            currentPage >= totalPages ||
                            isFetching
                        }
                        onClick={() =>
                            onPageChange(
                                Math.min(
                                    totalPages,
                                    currentPage + 1,
                                ),
                            )
                        }
                        className="inline-flex h-8 items-center gap-1 rounded-[3px] border border-[#3f3a36] bg-[#383330] px-2.5 text-xs text-[#c9c0ad] disabled:cursor-not-allowed disabled:opacity-40"
                    >
                        Suivant
                        <ChevronRight className="h-3.5 w-3.5" />
                    </button>
                </div>
            </div>
        </div>
    );
}
</file>

