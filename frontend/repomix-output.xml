<file path="src/app/stocks/page.tsx">
'use client';

import { useState } from 'react';
import { useAuth, SignInButton } from '@clerk/nextjs';
import { keepPreviousData, useQuery } from '@tanstack/react-query';
import Link from 'next/link';
import {
  ChevronLeft,
  ChevronRight,
  Eye,
  Layers,
  Loader2,
  Pencil,
  Plus,
  Search,
  Warehouse,
} from 'lucide-react';

import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import type { Stock, StockStatusName } from '@/types/stock';
import { CreateStockModal } from '@/components/stock/CreateStockModal';
import { StockDetailModal } from '@/components/stock/StockDetailModal';
import { UpdateStockModal } from '@/components/stock/UpdateStockModal';

type StatusFilter = 'ALL' | StockStatusName;

export default function StocksPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const api = useApi();
  const { canCreateStock, canUpdateStock } = usePermissions();
  const [searchTerm, setSearchTerm] = useState('');
  const [statusFilter, setStatusFilter] = useState<StatusFilter>('ALL');
  const [currentPage, setCurrentPage] = useState(1);
  const [limit, setLimit] = useState(10);
  const [isCreateOpen, setIsCreateOpen] = useState(false);
  const [selectedStockId, setSelectedStockId] = useState<string | null>(null);
  const [editingStock, setEditingStock] = useState<Stock | null>(null);

  const { data, isLoading, isFetching, refetch } = useQuery({
    queryKey: ['stocks', searchTerm, statusFilter, currentPage, limit],
    queryFn: () => {
      if (searchTerm.trim() || statusFilter !== 'ALL') {
        return StockService.searchStocks(
          api,
          {
            stockName: searchTerm.trim() || undefined,
            stockStatus: statusFilter === 'ALL' ? undefined : statusFilter,
          },
          { page: currentPage, limit },
        );
      }
      return StockService.getAllStocks(api, { page: currentPage, limit });
    },
    enabled: Boolean(isSignedIn && isLoaded),
    placeholderData: keepPreviousData,
  });

  const stocks = data?.stocks ?? [];
  const totalStocks = data?.totalStocks ?? 0;
  const totalPages = data?.totalPages ?? 1;

  if (!isLoaded) {
    return <main className="flex min-h-screen items-center justify-center bg-[#2b2622] text-[#f7f5f0]"><div className="flex items-center gap-2 text-xs text-[#aea69c]"><Loader2 className="h-4 w-4 animate-spin" />Chargement des stocks...</div></main>;
  }

  if (!isSignedIn) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-[#2b2622] p-6 text-[#f7f5f0]">
        <div className="w-full max-w-md space-y-4 rounded-lg border border-[#3f3a36] bg-[#383330] p-8 text-center"><Warehouse className="mx-auto h-8 w-8" /><h1 className="text-base font-semibold">Connexion requise</h1><SignInButton mode="modal"><button type="button" className="w-full rounded bg-[#f7f5f0] px-4 py-2 text-xs font-semibold text-[#2b2622]">Se connecter</button></SignInButton></div>
      </main>
    );
  }

  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0]">
      <div className="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6">
        <div className="flex flex-col justify-between gap-4 border-b border-[#3f3a36] pb-4 sm:flex-row sm:items-center">
          <div><div className="mb-1 flex items-center gap-2 font-mono text-xs text-[#aea69c]"><Link href="/" className="hover:text-white">somepharm</Link><span>/</span><span className="text-white">stocks</span></div><h1 className="text-2xl font-normal tracking-tight">Gestion des Stocks</h1><p className="mt-1 text-xs text-[#c9c0ad]">Statuts disponibles : ACTIVE et INACTIVE uniquement. Aucun UUID n’est affiché.</p></div>
          <button type="button" onClick={() => setIsCreateOpen(true)} disabled={!canCreateStock} className="inline-flex items-center justify-center gap-2 rounded bg-[#f7f5f0] px-3.5 py-2 text-xs font-semibold text-[#2b2622] disabled:opacity-40"><Plus className="h-3.5 w-3.5" />Nouveau stock</button>
        </div>

        <div className="overflow-hidden rounded-lg border border-[#3f3a36] bg-[#383330]">
          <div className="flex flex-col gap-3 border-b border-[#3f3a36] p-3 lg:flex-row lg:items-center lg:justify-between">
            <div className="relative w-full max-w-lg"><Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#aea69c]" /><input value={searchTerm} onChange={(event) => { setSearchTerm(event.target.value); setCurrentPage(1); }} placeholder="Rechercher un stock par nom..." className="h-9 w-full rounded border border-[#3f3a36] bg-[#2b2622] pl-9 pr-3 text-xs outline-none placeholder:text-[#aea69c]" /></div>
            <div className="flex flex-wrap items-center gap-2">
              <select value={statusFilter} onChange={(event) => { setStatusFilter(event.target.value as StatusFilter); setCurrentPage(1); }} className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"><option value="ALL">Tous les statuts</option><option value="ACTIVE">ACTIVE</option><option value="INACTIVE">INACTIVE</option></select>
              <select value={limit} onChange={(event) => { setLimit(Number(event.target.value)); setCurrentPage(1); }} className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"><option value={10}>10 / page</option><option value={20}>20 / page</option><option value={50}>50 / page</option></select>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead className="border-b border-[#3f3a36] bg-[#2b2622] text-[10px] uppercase tracking-wide text-[#aea69c]"><tr><th className="px-4 py-3">Stock</th><th className="px-4 py-3">Statut</th><th className="px-4 py-3">Emplacements</th><th className="px-4 py-3 text-right">Actions</th></tr></thead>
              <tbody className="divide-y divide-[#3f3a36]">
                {isLoading && stocks.length === 0 ? (
                  <tr><td colSpan={4} className="px-4 py-14 text-center text-[#aea69c]"><Loader2 className="mx-auto mb-2 h-4 w-4 animate-spin" />Chargement...</td></tr>
                ) : stocks.length === 0 ? (
                  <tr><td colSpan={4} className="px-4 py-14 text-center text-[#aea69c]">Aucun stock disponible.</td></tr>
                ) : stocks.map((stock) => {
                  const status = stock.stockStatus?.stockStatusName ?? 'ACTIVE';
                  const shelves = stock._count?.shelves ?? stock.shelves?.length ?? 0;
                  return (
                    <tr key={stock.stockId} className="hover:bg-[#2f2a26]">
                      <td className="px-4 py-3"><div className="flex items-center gap-2.5"><div className="flex h-8 w-8 items-center justify-center rounded border border-[#45403c] bg-[#2b2622]"><Warehouse className="h-4 w-4" /></div><span className="font-semibold">{stock.stockName ?? 'Stock sans nom'}</span></div></td>
                      <td className="px-4 py-3"><span className={`inline-flex rounded border px-2 py-1 text-[10px] font-semibold ${status === 'ACTIVE' ? 'border-emerald-400/25 bg-emerald-950/25 text-emerald-300' : 'border-amber-400/25 bg-amber-950/25 text-amber-300'}`}>{status}</span></td>
                      <td className="px-4 py-3"><span className="inline-flex items-center gap-1.5 text-[#c9c0ad]"><Layers className="h-3.5 w-3.5" />{shelves}</span></td>
                      <td className="px-4 py-3 text-right"><div className="inline-flex items-center gap-1"><button type="button" onClick={() => setSelectedStockId(stock.stockId)} className="rounded p-2 text-[#aea69c] hover:bg-[#2b2622] hover:text-white" title="Voir"><Eye className="h-3.5 w-3.5" /></button><button type="button" onClick={() => setEditingStock(stock)} disabled={!canUpdateStock} className="rounded p-2 text-[#aea69c] hover:bg-[#2b2622] hover:text-white disabled:opacity-30" title="Modifier"><Pencil className="h-3.5 w-3.5" /></button></div></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div className="flex items-center justify-between border-t border-[#3f3a36] bg-[#2b2622] px-4 py-3"><p className="text-[11px] text-[#aea69c]">{totalStocks} stock{totalStocks > 1 ? 's' : ''}{isFetching ? ' • actualisation...' : ''}</p><div className="flex items-center gap-1"><button type="button" disabled={currentPage <= 1} onClick={() => setCurrentPage((page) => page - 1)} className="rounded border border-[#3f3a36] p-2 disabled:opacity-30"><ChevronLeft className="h-3.5 w-3.5" /></button><span className="px-2 text-[11px] text-[#aea69c]">{currentPage} / {Math.max(1, totalPages)}</span><button type="button" disabled={currentPage >= totalPages} onClick={() => setCurrentPage((page) => page + 1)} className="rounded border border-[#3f3a36] p-2 disabled:opacity-30"><ChevronRight className="h-3.5 w-3.5" /></button></div></div>
        </div>
      </div>

      <CreateStockModal isOpen={isCreateOpen} onClose={() => setIsCreateOpen(false)} onSuccess={() => { void refetch(); }} />
      <StockDetailModal stockId={selectedStockId} isOpen={Boolean(selectedStockId)} onClose={() => setSelectedStockId(null)} />
      <UpdateStockModal stock={editingStock} isOpen={Boolean(editingStock)} onClose={() => setEditingStock(null)} onSuccess={() => { setEditingStock(null); void refetch(); }} />
    </main>
  );
}
</file>

<file path="src/app/users/page.tsx">
'use client';

import { useState } from 'react';
import { useAuth, SignInButton } from '@clerk/nextjs';
import Link from 'next/link';
import {
  Users,
  ShieldCheck,
  ShieldAlert,
  Plus,
  Search,
  RefreshCw,
} from 'lucide-react';
import { useAdminUsers } from '@/hooks/use-admin-users';
import { usePermissions } from '@/hooks/use-permissions';
import { UserListTable } from '@/components/users/UserListTable';
import { RoleListCards } from '@/components/users/RoleListCards';
import { CreateRoleModal } from '@/components/users/CreateRoleModal';
import { EditRoleModal } from '@/components/users/EditRoleModal';
import { UserStatus, Role } from '@/types/user-role';

export default function UsersAndRolesPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const { canManageUsers, canManageRoles, roleName, user: currentAuthUser, isAdmin } =
    usePermissions();

  const [activeTab, setActiveTab] = useState<'users' | 'roles'>('users');
  const [isCreateRoleModalOpen, setIsCreateRoleModalOpen] = useState(false);
  const [isEditRoleModalOpen, setIsEditRoleModalOpen] = useState(false);
  const [roleToEdit, setRoleToEdit] = useState<Role | null>(null);

  const {
    users,
    totalUsers,
    totalPages,
    currentPage,
    statusFilter,
    searchTerm,
    roles,
    availablePermissions,
    isUsersLoading,
    isUsersFetching,
    isRolesLoading,
    isCreatingRole,
    setPage,
    setStatusFilter,
    setSearchTerm,
    refetchUsers,
    refetchRoles,
    createRole,
    editRole,
    isEditingRole,
    assignRole,
    updateStatus,
  } = useAdminUsers({ initialLimit: 10 });

  // Unauthenticated screen
  if (isLoaded && !isSignedIn) {
    return (
      <div className="max-w-4xl mx-auto px-4 py-16 text-center">
        <div className="p-8 bg-[#383330] rounded-[4px] border border-[#3f3a36] max-w-md mx-auto space-y-4 shadow-xl">
          <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] text-[#f7f5f0] border border-[#3f3a36] flex items-center justify-center mx-auto">
            <Users className="w-5 h-5" />
          </div>
          <h2 className="text-base font-medium text-[#f7f5f0]">Connexion requise</h2>
          <p className="text-xs text-[#c9c0ad]">
            Veuillez vous authentifier pour accéder au panneau de gestion des utilisateurs et des rôles.
          </p>
          <div className="pt-2">
            <SignInButton mode="modal">
              <button
                type="button"
                className="w-full py-2 px-4 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
              >
                Se connecter
              </button>
            </SignInButton>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] py-8 text-[#f7f5f0]">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 space-y-6">
        {/* Header Breadcrumb & Actions */}
        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <div className="flex items-center gap-2 text-xs text-[#aea69c] mb-1 font-mono">
              <Link href="/" className="hover:text-[#f7f5f0] transition-colors">
                somepharm
              </Link>
              <span>/</span>
              <span className="text-[#dad2c1]">admin</span>
              <span>/</span>
              <span className="text-[#f7f5f0]">users-and-roles</span>
            </div>
            <div className="flex items-center gap-3">
              <div className="w-8 h-8 rounded-[3px] bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] flex items-center justify-center">
                <Users className="w-4 h-4" />
              </div>
              <div>
                <h1 className="text-xl sm:text-2xl font-normal tracking-tight text-[#f7f5f0]">
                  Gouvernance des Utilisateurs & Rôles
                </h1>
                <p className="text-xs text-[#c9c0ad]">
                  Attribution de rôles RBAC, configuration des permissions et supervision des comptes.
                </p>
              </div>
            </div>
          </div>

          {/* Action Buttons */}
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={() => {
                refetchUsers();
                refetchRoles();
              }}
              disabled={isUsersFetching}
              title="Rafraîchir les données"
              className="p-2 bg-[#383330] hover:bg-[#3f3a36] border border-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] rounded-[3px] transition-colors cursor-pointer disabled:opacity-50"
            >
              <RefreshCw
                className={`w-3.5 h-3.5 ${isUsersFetching ? 'animate-spin text-[#f7f5f0]' : ''}`}
              />
            </button>

            {canManageRoles && (
              <button
                type="button"
                onClick={() => setIsCreateRoleModalOpen(true)}
                className="flex items-center gap-2 px-3.5 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] transition-colors shadow-2xs cursor-pointer"
              >
                <Plus className="w-3.5 h-3.5" />
                <span>Nouveau Rôle</span>
              </button>
            )}
          </div>
        </div>

        {/* Access Status Banner */}
        {isSignedIn && !isAdmin && !canManageRoles && !canManageUsers && (
          <div className="p-3 bg-[#383330] border border-[#453316] rounded-[4px] text-xs text-[#f59e0b] flex items-center gap-2">
            <ShieldAlert className="w-4 h-4 shrink-0 text-[#f59e0b]" />
            <span>
              Mode lecture seule : Votre profil actuel ({roleName || 'Sans rôle'})
              ne possède pas les privilèges requis pour modifier les rôles ou statuts.
            </span>
          </div>
        )}

        {/* Navigation Tabs */}
        <div className="border-b border-[#3f3a36] flex items-center gap-6">
          <button
            type="button"
            onClick={() => setActiveTab('users')}
            className={`pb-2.5 text-xs font-medium transition-colors relative flex items-center gap-2 cursor-pointer ${
              activeTab === 'users'
                ? 'text-[#f7f5f0]'
                : 'text-[#aea69c] hover:text-[#f7f5f0]'
            }`}
          >
            <Users className="w-3.5 h-3.5" />
            <span>Utilisateurs Enregistrés</span>
            <span
              className={`px-1.5 py-0.5 rounded-[2px] font-mono text-[10px] border ${
                activeTab === 'users'
                  ? 'bg-[#f7f5f0] text-[#2b2622] border-[#f7f5f0]'
                  : 'bg-[#383330] text-[#dad2c1] border-[#3f3a36]'
              }`}
            >
              {totalUsers}
            </span>
            {activeTab === 'users' && (
              <div className="absolute bottom-0 left-0 right-0 h-[2px] bg-[#f7f5f0]" />
            )}
          </button>

          <button
            type="button"
            onClick={() => setActiveTab('roles')}
            className={`pb-2.5 text-xs font-medium transition-colors relative flex items-center gap-2 cursor-pointer ${
              activeTab === 'roles'
                ? 'text-[#f7f5f0]'
                : 'text-[#aea69c] hover:text-[#f7f5f0]'
            }`}
          >
            <ShieldCheck className="w-3.5 h-3.5" />
            <span>Rôles & Permissions</span>
            <span
              className={`px-1.5 py-0.5 rounded-[2px] font-mono text-[10px] border ${
                activeTab === 'roles'
                  ? 'bg-[#f7f5f0] text-[#2b2622] border-[#f7f5f0]'
                  : 'bg-[#383330] text-[#dad2c1] border-[#3f3a36]'
              }`}
            >
              {roles.length}
            </span>
            {activeTab === 'roles' && (
              <div className="absolute bottom-0 left-0 right-0 h-[2px] bg-[#f7f5f0]" />
            )}
          </button>
        </div>

        {/* Tab 1: Users View */}
        {activeTab === 'users' && (
          <div className="space-y-4">
            {/* Filter Bar */}
            <div className="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-[#383330] p-3 rounded-[4px] border border-[#3f3a36]">
              <div className="relative flex-1">
                <Search className="w-3.5 h-3.5 absolute left-3 top-2.5 text-[#aea69c]" />
                <input
                  type="text"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  placeholder="Rechercher par identifiant, nom, email ou rôle..."
                  className="w-full pl-9 pr-3 py-1.5 text-xs bg-[#2b2622] text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] focus:outline-none focus:border-[#f7f5f0] placeholder:text-[#aea69c] transition-colors"
                />
              </div>

              <div className="flex items-center gap-2 border-t sm:border-t-0 pt-2 sm:pt-0 border-[#3f3a36]">
                <span className="text-xs text-[#c9c0ad] whitespace-nowrap font-mono text-[11px]">
                  Filtre :
                </span>
                <select
                  value={statusFilter ?? ''}
                  onChange={(e) => {
                    const val = e.target.value;
                    setStatusFilter(val ? (val as UserStatus) : undefined);
                    setPage(1);
                  }}
                  className="text-xs font-medium py-1.5 px-2.5 rounded-[3px] border border-[#3f3a36] bg-[#2b2622] text-[#f7f5f0] focus:outline-none focus:border-[#f7f5f0] cursor-pointer"
                >
                  <option value="">Tous les statuts</option>
                  <option value="ACTIVE">Actif uniquement</option>
                  <option value="PENDING">En attente uniquement</option>
                  <option value="DISABLED">Désactivé uniquement</option>
                </select>
              </div>
            </div>

            {/* Users Table */}
            <UserListTable
              users={users}
              roles={roles}
              isLoading={isUsersLoading}
              totalUsers={totalUsers}
              totalPages={totalPages}
              currentPage={currentPage}
              onPageChange={setPage}
              onAssignRole={async (userId, roleId) => {
                await assignRole({ userId, roleId });
              }}
              onUpdateStatus={async (userId, status) => {
                await updateStatus({ userId, status });
              }}
              canManageUsers={canManageUsers}
              canManageRoles={canManageRoles}
              currentUserId={currentAuthUser?.userId}
            />
          </div>
        )}

        {/* Tab 2: Roles View */}
        {activeTab === 'roles' && (
          <div className="space-y-4">
            <RoleListCards
              roles={roles}
              isLoading={isRolesLoading}
              onOpenCreateRole={() => setIsCreateRoleModalOpen(true)}
              onOpenEditRole={(role) => {
                setRoleToEdit(role);
                setIsEditRoleModalOpen(true);
              }}
              canManageRoles={canManageRoles}
            />
          </div>
        )}

        {/* Modal: Create Role */}
        <CreateRoleModal
          isOpen={isCreateRoleModalOpen}
          onClose={() => setIsCreateRoleModalOpen(false)}
          availablePermissions={availablePermissions}
          onSubmitRole={async (input) => {
            await createRole(input);
          }}
          isSubmitting={isCreatingRole}
        />

        {/* Modal: Edit Role */}
        <EditRoleModal
          isOpen={isEditRoleModalOpen}
          onClose={() => {
            setIsEditRoleModalOpen(false);
            setRoleToEdit(null);
          }}
          availablePermissions={availablePermissions}
          roleToEdit={roleToEdit}
          onSubmitRole={async (input) => {
            await editRole(input);
          }}
          isSubmitting={isEditingRole}
        />
      </div>
    </div>
  );
}
</file>

<file path="src/app/globals.css">
@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-canvas: #2b2622;
  --color-canvas-soft: #383330;
  --color-hairline: #3f3a36;
  --color-hairline-light: #4d4742;
  --color-ink: #f7f5f0;
  --color-body-strong: #dad2c1;
  --color-body: #c9c0ad;
  --color-mute: #aea69c;
  --color-primary-warp: #f7f5f0;
  --color-on-primary-warp: #2b2622;

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-inter), system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: var(--font-dm-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  --font-serif: var(--font-instrument-serif), Georgia, "Times New Roman", serif;

  --radius-xs: 2px;
  --radius-sm: 3px;
  --radius-md: 4px;
  --radius-lg: 6px;
  --radius: 4px;
}

:root {
  /* Warp Warm Near-Charcoal Palette by default */
  --background: #2b2622;
  --foreground: #f7f5f0;
  --card: #383330;
  --card-foreground: #f7f5f0;
  --popover: #383330;
  --popover-foreground: #f7f5f0;
  --primary: #f7f5f0;
  --primary-foreground: #2b2622;
  --secondary: #383330;
  --secondary-foreground: #f7f5f0;
  --muted: #383330;
  --muted-foreground: #aea69c;
  --accent: #3f3a36;
  --accent-foreground: #f7f5f0;
  --destructive: #ef4444;
  --border: #3f3a36;
  --input: #3f3a36;
  --ring: #f7f5f0;
  --radius: 4px;
}

@layer base {
  * {
    border-color: #3f3a36;
  }
  body {
    background-color: #2b2622;
    color: #f7f5f0;
    font-family: var(--font-inter), system-ui, sans-serif;
    letter-spacing: -0.01em;
  }
  html {
    color-scheme: dark;
  }
}

/* Warp Primitives & Utility Classes */
.bg-canvas {
  background-color: #2b2622;
}

.bg-canvas-soft {
  background-color: #383330;
}

.border-hairline {
  border-color: #3f3a36;
}

.text-ink {
  color: #f7f5f0;
}

.text-body-strong {
  color: #dad2c1;
}

.text-body {
  color: #c9c0ad;
}

.text-mute {
  color: #aea69c;
}

.font-serif-italic {
  font-family: var(--font-instrument-serif), Georgia, serif;
  font-style: italic;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #2b2622;
}
::-webkit-scrollbar-thumb {
  background: #3f3a36;
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: #4d4742;
}

/* Hide Clerk watermarks and dev mode badges */
.cl-userButtonPopoverFooter,
.cl-footer,
.cl-internal-1dauvpw,
.cl-internal-phgxti {
  display: none !important;
}
</file>

