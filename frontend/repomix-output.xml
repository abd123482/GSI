} from '@/hooks/use-permissions';
import {
  getErrorMessage,
} from '@/lib/error-message';

import {
  SerialNumberService,
  type CreateBatchSerialNumbersInput,
  type CreateSerialNumberInput,
  type SerialNumberQuery,
  type UpdateSerialNumberInput,
} from '@/services/serial-number.service';

export function useSerialNumbers(
  query: SerialNumberQuery = {},
  enabled = true,
) {
  const api = useApi();

  const {
    permissions,
  } = usePermissions();

  const normalizedQuery:
    SerialNumberQuery = {
      page:
        query.page ?? 1,
      limit:
        query.limit ?? 20,
      serialNumberCode:
        query.serialNumberCode,
      serialNumberStatus:
        query.serialNumberStatus,
      equipmentId:
        query.equipmentId,
      shelfId:
        query.shelfId,
    };

  return useQuery({
    queryKey: [
      'serial-numbers',
      normalizedQuery,
    ],

    queryFn: () =>
      SerialNumberService.getSerialNumbers(
        api,
        normalizedQuery,
        permissions,
      ),

    enabled,

    placeholderData:
      keepPreviousData,

    staleTime: 20_000,
  });
}

export function useCreateSerialNumber() {
  const api = useApi();
  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  return useMutation({
    mutationFn: (
      input: CreateSerialNumberInput,
    ) =>
      SerialNumberService.createSerialNumber(
        api,
        input,
        permissions,
      ),

    onSuccess:
      async (serial) => {
        await Promise.all([
          queryClient.invalidateQueries({
            queryKey: [
              'serial-numbers',
            ],
          }),
          queryClient.invalidateQueries({
            queryKey: [
              'equipments',
            ],
          }),
        ]);

        toast.success(
          'Numéro de série créé',
          {
            description:
              serial.serialNumberCode,
          },
        );
      },

    onError: (
      error: unknown,
    ) => {
      toast.error(
        'Création impossible',
