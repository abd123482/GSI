                className="w-52 border-[#3f3a36] bg-[#2f2a26] text-[#c9c0ad]"
              >
                <NavItem
                  href="/stocks"
                  icon={<Warehouse className="h-3.5 w-3.5" />}
                  text="Vue d'ensemble"
                />
                <NavItem
                  href="/shelves"
                  icon={<Layers className="h-3.5 w-3.5" />}
                  text="Emplacements"
                />
                <NavItem
                  href="/equipment"
                  icon={<Cpu className="h-3.5 w-3.5" />}
