<file path="src/components/equipment/EquipmentDetailModal.tsx">
'use client';

import {
  useEffect,
  useState,
} from 'react';
import {
  AlertCircle,
  ArrowDownToLine,
  ArrowRightLeft,
  ArrowUpFromLine,
  Barcode,
  Loader2,
  Package,
  Pencil,
  Plus,
  Search,
  X,
} from 'lucide-react';

import type {
  Equipment,
  SerialNumber,
} from '@/types/equipment';

import type {
  Movement,
} from '@/types/movement';

import {
  useMovements,
} from '@/hooks/use-movements';

import {
  useCreateSerialNumber,
  useSerialNumbers,
} from '@/hooks/use-serial-numbers';

import {
  usePermissions,
} from '@/hooks/use-permissions';

interface EquipmentDetailModalProps {
  equipment: Equipment | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  onEditSerialNumber?: (
    serial: SerialNumber,
  ) => void;
  isLoading?: boolean;
}

function movementLabel(
  movement: Movement,
) {
  const status =
    movement.mouvementStatus
      ?.toUpperCase();

  if (
    status === 'IN' ||
    status === 'ENTRY' ||
    status === 'ENTRÉE'
  ) {
    return {
      text: 'ENTRÉE',
      icon:
        ArrowDownToLine,
    };
  }

  if (
    status === 'OUT' ||
    status === 'EXIT' ||
    status === 'SORTIE'
  ) {
    return {
      text: 'SORTIE',
      icon:
        ArrowUpFromLine,
    };
  }

  return {
    text: 'TRANSFERT',
    icon:
      ArrowRightLeft,
  };
}

function formatDate(
  value?: string | null,
) {
  if (!value) {
    return '—';
  }

  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return value;
  }

  return new Intl.DateTimeFormat(
    'fr-DZ',
    {
      dateStyle: 'short',
      timeStyle: 'short',
    },
  ).format(date);
}

export function EquipmentDetailModal({
  equipment,
  isOpen,
  onClose,
  onRefresh,
  onEditSerialNumber,
  isLoading = false,
}: EquipmentDetailModalProps) {
  const [
    serialPage,
    setSerialPage,
  ] = useState(1);

  const [
    movementPage,
    setMovementPage,
  ] = useState(1);

  const [
    serialSearch,
    setSerialSearch,
  ] = useState('');

  const [
    newSerialCode,
    setNewSerialCode,
  ] = useState('');

  const {
    canCreateSerialNumber,
    canUpdateSerialNumber,
  } = usePermissions();

  const createSerial =
    useCreateSerialNumber();

  useEffect(() => {
    setSerialPage(1);
    setMovementPage(1);
    setSerialSearch('');
    setNewSerialCode('');
  }, [
    equipment?.equipmentId,
    isOpen,
  ]);

  const serialized =
    Boolean(
      equipment
        ?.hasSerialNumber,
    );

  const serialQuery =
    useSerialNumbers(
      {
        page: serialPage,
        limit: 20,
        equipmentId:
          equipment
            ?.equipmentId,
        serialNumberCode:
          serialSearch.trim() ||
          undefined,
      },
      isOpen &&
        serialized &&
        Boolean(
          equipment
            ?.equipmentId,
        ),
    );

  const movementQuery =
    useMovements(
      {
        page:
          movementPage,
        limit: 20,
        equipmentId:
          equipment
            ?.equipmentId,
      },
      isOpen &&
        Boolean(
          equipment
            ?.equipmentId,
        ),
    );

  if (
    !isOpen ||
    !equipment
  ) {
    return null;
  }

  async function addSerial() {
    const code =
      newSerialCode.trim();

    if (
      !code ||
      !equipment
    ) {
      return;
    }

    await createSerial.mutateAsync({
      serialNumberCode:
        code,
      equipmentId:
        equipment.equipmentId,
      serialNumberStatus:
        'AVAILABLE',
    });

    setNewSerialCode('');

    await serialQuery.refetch();
    onRefresh?.();
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 backdrop-blur-sm sm:p-5">
      <div className="flex max-h-[94vh] w-full max-w-5xl flex-col overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#26221f] px-5 py-4">
          <div>
            <h2 className="text-base font-semibold">
              {equipment.equipmentName ??
                'Article sans nom'}
            </h2>

            <p className="mt-0.5 text-[10px] text-white/45">
              {serialized
                ? 'Article sérialisé'
                : 'Article standard'}
              {' • '}
              {
                equipment.equipmentStatus
              }
            </p>
          </div>

          <div className="flex gap-1">
            {onRefresh && (
              <button
                type="button"
                onClick={
                  onRefresh
                }
                disabled={
                  isLoading
                }
                className="rounded p-2 text-white/60 hover:bg-white/10"
              >
                <Loader2
                  className={`h-4 w-4 ${
                    isLoading
                      ? 'animate-spin'
                      : ''
                  }`}
                />
              </button>
            )}

            <button
              type="button"
              onClick={onClose}
              className="rounded p-2 text-white/60 hover:bg-white/10"
            >
              <X className="h-4 w-4" />
            </button>
          </div>
        </header>

        <div className="flex-1 space-y-5 overflow-y-auto p-5">
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <Stat
              label="Quantité physique"
              value={String(
                equipment.equipmentQuantity,
              )}
              icon={
                <Package className="h-3.5 w-3.5" />
              }
            />

            <Stat
              label="Minimum"
              value={String(
                equipment.minequipmentQuantity,
              )}
            />

            <Stat
              label="Mode"
              value={
                serialized
                  ? 'Sérialisé'
                  : 'Standard'
              }
              icon={
                <Barcode className="h-3.5 w-3.5" />
              }
            />

            <Stat
              label="Statut"
              value={
                equipment.equipmentStatus
              }
            />
          </div>

          {serialized && (
            <section className="overflow-hidden rounded-xl border border-[#3f3a36] bg-[#2b2622]/55">
              <div className="space-y-3 border-b border-[#3f3a36] px-4 py-3">
                <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h3 className="text-xs font-semibold">
                      Numéros de série
                    </h3>

                    <p className="mt-0.5 text-[10px] text-white/45">
                      Le code est immuable après création. Seul le statut peut être modifié.
                    </p>
                  </div>

                  <div className="relative sm:w-64">
                    <Search className="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-white/40" />

                    <input
                      value={
                        serialSearch
                      }
                      onChange={(
                        event,
                      ) => {
                        setSerialSearch(
                          event.target
                            .value,
                        );
                        setSerialPage(
                          1,
                        );
                      }}
                      placeholder="Rechercher un S/N..."
                      className="h-8 w-full rounded border border-[#3f3a36] bg-[#1f1b18] pl-8 pr-2 text-xs"
                    />
                  </div>
                </div>

                {canCreateSerialNumber && (
                  <div className="flex gap-2">
                    <input
                      value={
                        newSerialCode
                      }
                      onChange={(
                        event,
                      ) =>
                        setNewSerialCode(
                          event.target
                            .value,
                        )
                      }
                      placeholder="Saisir manuellement le nouveau code série"
                      className="h-9 min-w-0 flex-1 rounded border border-[#3f3a36] bg-[#1f1b18] px-3 font-mono text-xs"
                    />

                    <button
                      type="button"
                      onClick={() => {
                        void addSerial();
                      }}
                      disabled={
                        !newSerialCode.trim() ||
                        createSerial.isPending
                      }
                      className="inline-flex items-center gap-1.5 rounded bg-[#f7f5f0] px-3 text-xs font-semibold text-[#2b2622] disabled:opacity-40"
                    >
                      <Plus className="h-3.5 w-3.5" />
                      Ajouter
                    </button>
                  </div>
                )}
              </div>

              {serialQuery.isLoading ? (
                <LoadingRow text="Chargement des numéros de série..." />
              ) : (
                <>
                  <div className="divide-y divide-[#3f3a36]">
                    {(serialQuery.data
                      ?.serialNumbers ??
                      []).map(
                      (serial) => (
                        <div
                          key={
                            serial.serialNumberId
                          }
                          className="flex items-center justify-between gap-3 px-4 py-3 text-xs"
                        >
                          <div className="min-w-0">
                            <p className="truncate font-mono font-semibold">
                              {
                                serial.serialNumberCode
                              }
                            </p>

                            <p className="mt-0.5 text-[9px] text-white/40">
                              {
                                serial.serialNumberStatus
                              }
                            </p>
                          </div>

                          {canUpdateSerialNumber &&
                            onEditSerialNumber && (
                              <button
                                type="button"
                                onClick={() =>
                                  onEditSerialNumber(
                                    serial,
                                  )
                                }
                                className="inline-flex items-center gap-1 rounded border border-[#4a4540] px-2.5 py-1.5 text-[10px] text-[#c9c0ad] hover:text-white"
                              >
                                <Pencil className="h-3 w-3" />
                                Statut
                              </button>
                            )}
                        </div>
                      ),
                    )}

                    {!serialQuery.data
                      ?.serialNumbers
                      ?.length && (
                      <div className="px-4 py-8 text-center text-xs text-white/45">
                        Aucun numéro de série.
                      </div>
                    )}
                  </div>

                  <Pager
                    page={
                      serialQuery.data
                        ?.currentPage ??
                      serialPage
                    }
                    totalPages={
                      serialQuery.data
                        ?.totalPages ??
                      1
                    }
                    onPage={
                      setSerialPage
                    }
                  />
                </>
              )}
            </section>
          )}

          <section className="overflow-hidden rounded-xl border border-[#3f3a36] bg-[#2b2622]/55">
            <div className="border-b border-[#3f3a36] px-4 py-3">
              <h3 className="text-xs font-semibold">
                Historique des mouvements
              </h3>

              <p className="mt-0.5 text-[10px] text-white/45">
                Consultation uniquement. Aucun mouvement ne se crée depuis la fiche article.
              </p>
            </div>

            {movementQuery.isLoading ? (
              <LoadingRow text="Chargement des mouvements..." />
            ) : (
              <>
                <div className="divide-y divide-[#3f3a36]">
                  {(movementQuery.data
                    ?.movements ??
                    []).map(
                    (movement) => {
                      const descriptor =
                        movementLabel(
                          movement,
                        );

                      const Icon =
                        descriptor.icon;

                      const line =
                        movement.items?.find(
                          (item) =>
                            item.equipmentId
                              .toLowerCase() ===
                            equipment.equipmentId
                              .toLowerCase(),
                        );

                      const quantity =
                        line
                          ?.mouvementQuantity ??
                        movement.mouvementQuantity ??
                        0;

                      return (
                        <div
                          key={
                            movement.mouvementId
                          }
                          className="grid grid-cols-[100px_minmax(0,1fr)_70px] items-center gap-3 px-4 py-3 text-xs"
                        >
                          <span className="inline-flex items-center gap-1 text-white/70">
                            <Icon className="h-3.5 w-3.5" />
                            {
                              descriptor.text
                            }
                          </span>

                          <div className="min-w-0">
                            <p className="truncate text-white/75">
                              {movement
                                .sourceShelf
                                ?.shelfName ??
                                'Extérieur'}
                              {' → '}
                              {movement
                                .destinationShelf
                                ?.shelfName ??
                                'Extérieur'}
                            </p>

                            <p className="mt-0.5 text-[9px] text-white/35">
                              {formatDate(
                                movement.createdAt,
                              )}
                            </p>
                          </div>

                          <span className="text-right font-mono font-semibold">
                            {
                              quantity
                            }{' '}
                            u.
                          </span>
                        </div>
                      );
                    },
                  )}

                  {!movementQuery.data
                    ?.movements
                    ?.length && (
                    <div className="px-4 py-8 text-center text-xs text-white/45">
                      Aucun mouvement enregistré.
                    </div>
                  )}
                </div>

                <Pager
                  page={
                    movementQuery.data
                      ?.currentPage ??
                    movementPage
                  }
                  totalPages={
                    movementQuery.data
                      ?.totalPages ??
                    1
                  }
                  onPage={
                    setMovementPage
                  }
                />
              </>
            )}
          </section>
        </div>

        <footer className="flex justify-end border-t border-[#3f3a36] bg-[#26221f] px-5 py-3">
          <button
            type="button"
            onClick={onClose}
            className="rounded bg-[#f7f5f0] px-4 py-2 text-xs font-semibold text-[#2b2622]"
          >
            Fermer
          </button>
        </footer>
      </div>
    </div>
  );
}

function Stat({
  label,
  value,
  icon,
}: {
  label: string;
  value: string;
  icon?: React.ReactNode;
}) {
  return (
    <div className="rounded-lg border border-[#3f3a36] bg-[#2b2622]/65 p-3">
      <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-white/40">
        {icon}
        {label}
      </div>

      <p className="mt-2 text-sm font-semibold">
        {value}
      </p>
    </div>
  );
}

function LoadingRow({
  text,
}: {
  text: string;
}) {
  return (
    <div className="flex items-center justify-center gap-2 px-4 py-7 text-xs text-white/45">
      <Loader2 className="h-4 w-4 animate-spin" />
      {text}
    </div>
  );
}

function Pager({
  page,
  totalPages,
  onPage,
}: {
  page: number;
  totalPages: number;
  onPage: (
    page: number,
  ) => void;
}) {
  if (
    totalPages <= 1
  ) {
    return null;
  }

  return (
    <div className="flex items-center justify-end gap-2 border-t border-[#3f3a36] px-4 py-2">
      <button
        type="button"
        disabled={
          page <= 1
        }
        onClick={() =>
          onPage(
            page - 1,
          )
        }
        className="rounded border border-[#3f3a36] px-2 py-1 text-[10px] disabled:opacity-30"
      >
        Préc.
      </button>

      <span className="text-[10px] text-white/45">
        {page} /{' '}
        {totalPages}
      </span>

      <button
        type="button"
        disabled={
          page >= totalPages
        }
        onClick={() =>
          onPage(
            page + 1,
          )
        }
        className="rounded border border-[#3f3a36] px-2 py-1 text-[10px] disabled:opacity-30"
      >
        Suiv.
      </button>
    </div>
  );
}
</file>

<file path="src/components/equipment/EquipmentListTable.tsx">
'use client';

import {
  ChevronLeft,
  ChevronRight,
  Eye,
  PackagePlus,
  Pencil,
  RefreshCw,
  Search,
  Trash2,
} from 'lucide-react';

import type {
  Equipment,
  EquipmentStatus,
} from '@/types/equipment';

interface EquipmentListTableProps {
  equipments: Equipment[];
  totalEquipments: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  equipmentStatus?:
    | EquipmentStatus;
  hasSerialNumber?:
    | boolean;

  onSearchChange: (
    value: string,
  ) => void;

  onEquipmentStatusChange: (
    value:
      | EquipmentStatus
      | undefined,
  ) => void;

  onSerialModeChange: (
    value:
      | boolean
      | undefined,
  ) => void;

  onPageChange: (
    page: number,
  ) => void;

  onLimitChange: (
    limit: number,
  ) => void;

  onSelectEquipment: (
    equipment: Equipment,
  ) => void;

  onEditEquipment?: (
    equipment: Equipment,
  ) => void;

  onDeleteEquipment?: (
    equipment: Equipment,
  ) => void;

  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateEquipment: boolean;
  canUpdateEquipment?: boolean;
  canDeleteEquipment?: boolean;
}

export function EquipmentListTable({
  equipments,
  totalEquipments,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  equipmentStatus,
  hasSerialNumber,
  onSearchChange,
  onEquipmentStatusChange,
  onSerialModeChange,
  onPageChange,
  onLimitChange,
  onSelectEquipment,
  onEditEquipment,
  onDeleteEquipment,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateEquipment,
  canUpdateEquipment = true,
  canDeleteEquipment = true,
}: EquipmentListTableProps) {
  return (
    <div className="overflow-hidden rounded-lg border border-[#3f3a36] bg-[#383330]">
      <div className="flex flex-col gap-3 border-b border-[#3f3a36] p-3 xl:flex-row xl:items-center xl:justify-between">
        <div className="relative w-full max-w-lg">
          <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#aea69c]" />

          <input
            value={searchTerm}
            onChange={(event) =>
              onSearchChange(
                event.target.value,
              )
            }
            placeholder="Rechercher par nom d’article..."
            className="h-9 w-full rounded border border-[#3f3a36] bg-[#2b2622] pl-9 pr-3 text-xs outline-none placeholder:text-[#aea69c]"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <select
            value={
              equipmentStatus ??
              'ALL'
            }
            onChange={(event) =>
              onEquipmentStatusChange(
                event.target.value ===
                  'ALL'
                  ? undefined
                  : (event.target
                      .value as EquipmentStatus),
              )
            }
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"
          >
            <option value="ALL">
              Tous les statuts
            </option>
            <option value="ACTIVE">
              ACTIVE
            </option>
            <option value="INACTIVE">
              INACTIVE
            </option>
          </select>

          <select
            value={
              hasSerialNumber ===
              undefined
                ? 'ALL'
                : hasSerialNumber
                  ? 'SERIALIZED'
                  : 'STANDARD'
            }
            onChange={(event) =>
              onSerialModeChange(
                event.target.value ===
                  'ALL'
                  ? undefined
                  : event.target
                      .value ===
                    'SERIALIZED',
              )
            }
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"
          >
            <option value="ALL">
              Tous les modes
            </option>
            <option value="STANDARD">
              Standard
            </option>
            <option value="SERIALIZED">
              Sérialisé
            </option>
          </select>

          <select
            value={limit}
            onChange={(event) =>
              onLimitChange(
                Number(
                  event.target.value,
                ),
              )
            }
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-2 text-xs"
          >
            <option value={10}>
              10 / page
            </option>
            <option value={20}>
              20 / page
            </option>
            <option value={50}>
              50 / page
            </option>
          </select>

          <button
            type="button"
            onClick={onRefresh}
            disabled={isLoading}
            className="inline-flex h-9 items-center gap-1.5 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs disabled:opacity-40"
          >
            <RefreshCw
              className={`h-3.5 w-3.5 ${
                isLoading
                  ? 'animate-spin'
                  : ''
              }`}
            />
            Actualiser
          </button>

          {canCreateEquipment && (
            <button
              type="button"
              onClick={
                onOpenCreateModal
              }
              className="inline-flex h-9 items-center gap-1.5 rounded bg-[#f7f5f0] px-3 text-xs font-semibold text-[#2b2622]"
            >
              <PackagePlus className="h-3.5 w-3.5" />
              Nouvel article
            </button>
          )}
        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead className="border-b border-[#3f3a36] bg-[#2b2622] text-[10px] uppercase tracking-wide text-[#aea69c]">
            <tr>
              <th className="px-4 py-3">
                Article
              </th>
              <th className="px-4 py-3">
                Mode
              </th>
              <th className="px-4 py-3">
                Statut
              </th>
              <th className="px-4 py-3 text-center">
                Quantité
              </th>
              <th className="px-4 py-3 text-center">
                Minimum
              </th>
              <th className="px-4 py-3 text-right">
                Actions
              </th>
            </tr>
          </thead>

          <tbody className="divide-y divide-[#3f3a36]">
            {isLoading &&
            equipments.length ===
              0 ? (
              <tr>
                <td
                  colSpan={6}
                  className="px-4 py-14 text-center text-[#aea69c]"
                >
                  Chargement...
                </td>
              </tr>
            ) : equipments.length ===
              0 ? (
              <tr>
                <td
                  colSpan={6}
                  className="px-4 py-14 text-center text-[#aea69c]"
                >
                  Aucun article disponible.
                </td>
              </tr>
            ) : (
              equipments.map(
                (equipment) => (
                  <tr
                    key={
                      equipment.equipmentId
                    }
                    className="hover:bg-[#2f2a26]"
                  >
                    <td className="px-4 py-3">
                      <button
                        type="button"
                        onClick={() =>
                          onSelectEquipment(
                            equipment,
                          )
                        }
                        className="max-w-[340px] truncate text-left font-semibold hover:underline"
                      >
                        {equipment.equipmentName ??
                          'Article sans nom'}
                      </button>
                    </td>

                    <td className="px-4 py-3">
                      <span className="rounded border border-[#4a4540] bg-[#2b2622] px-2 py-1 text-[10px]">
                        {equipment.hasSerialNumber
                          ? 'SÉRIALISÉ'
                          : 'STANDARD'}
                      </span>
                    </td>

                    <td className="px-4 py-3">
                      <span
                        className={`rounded border px-2 py-1 text-[10px] font-semibold ${
                          equipment.equipmentStatus ===
                          'ACTIVE'
                            ? 'border-emerald-400/25 bg-emerald-950/25 text-emerald-300'
                            : 'border-amber-400/25 bg-amber-950/25 text-amber-300'
                        }`}
                      >
                        {
                          equipment.equipmentStatus
                        }
                      </span>
                    </td>

                    <td className="px-4 py-3 text-center font-mono">
                      {
                        equipment.equipmentQuantity
                      }
                    </td>

                    <td className="px-4 py-3 text-center font-mono">
                      {
                        equipment.minequipmentQuantity
                      }
                    </td>

                    <td className="px-4 py-3 text-right">
                      <div className="inline-flex items-center gap-1">
                        <button
                          type="button"
                          onClick={() =>
                            onSelectEquipment(
                              equipment,
                            )
                          }
                          className="rounded p-2 text-[#aea69c] hover:bg-[#2b2622] hover:text-white"
                          title="Voir"
                        >
                          <Eye className="h-3.5 w-3.5" />
                        </button>

                        {onEditEquipment && (
                          <button
                            type="button"
                            onClick={() =>
                              onEditEquipment(
                                equipment,
                              )
                            }
                            disabled={
                              !canUpdateEquipment
                            }
                            className="rounded p-2 text-[#aea69c] hover:bg-[#2b2622] hover:text-white disabled:opacity-30"
                            title="Modifier"
                          >
                            <Pencil className="h-3.5 w-3.5" />
                          </button>
                        )}

                        {onDeleteEquipment && (
                          <button
                            type="button"
                            onClick={() =>
                              onDeleteEquipment(
                                equipment,
                              )
                            }
                            disabled={
                              !canDeleteEquipment
                            }
                            className="rounded p-2 text-rose-300 hover:bg-rose-950/25 disabled:opacity-30"
                            title="Supprimer"
                          >
                            <Trash2 className="h-3.5 w-3.5" />
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ),
              )
            )}
          </tbody>
        </table>
      </div>

      <div className="flex items-center justify-between border-t border-[#3f3a36] bg-[#2b2622] px-4 py-3">
        <p className="text-[11px] text-[#aea69c]">
          {totalEquipments} article
          {totalEquipments > 1
            ? 's'
            : ''}
        </p>

        <div className="flex items-center gap-2">
          <button
            type="button"
            disabled={
              currentPage <= 1
            }
            onClick={() =>
              onPageChange(
                currentPage - 1,
              )
            }
            className="rounded border border-[#3f3a36] p-2 disabled:opacity-30"
          >
            <ChevronLeft className="h-3.5 w-3.5" />
          </button>

          <span className="text-[11px] text-[#aea69c]">
            {currentPage} /{' '}
            {Math.max(
              1,
              totalPages,
            )}
          </span>

          <button
            type="button"
            disabled={
              currentPage >=
              totalPages
            }
            onClick={() =>
              onPageChange(
                currentPage + 1,
              )
            }
            className="rounded border border-[#3f3a36] p-2 disabled:opacity-30"
          >
            <ChevronRight className="h-3.5 w-3.5" />
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/equipment/ViewEquipmentShelvesModal.tsx">
'use client';

import {
  useState,
} from 'react';
import {
  useQuery,
} from '@tanstack/react-query';
import {
  AlertTriangle,
  Check,
  Copy,
  Hash,
  Layers,
  Package,
  RefreshCw,
  X,
} from 'lucide-react';
import {
  toast,
} from 'sonner';

import type {
  Equipment,
  EquipmentWithShelvesResponse,
} from '@/types/equipment';
import {
  EquipmentService,
} from '@/services/equipment.service';
import {
  useApi,
} from '@/hooks/use-api';
import {
  usePermissions,
} from '@/hooks/use-permissions';

interface ViewEquipmentShelvesModalProps {
  isOpen: boolean;
  equipment: Equipment | null;
  onClose: () => void;
}

export function ViewEquipmentShelvesModal({
  isOpen,
  equipment,
  onClose,
}: ViewEquipmentShelvesModalProps) {
  const api = useApi();
  const {
    permissions,
  } = usePermissions();

  const [
    copied,
    setCopied,
  ] =
    useState<string | null>(
      null,
    );

  const query =
    useQuery<EquipmentWithShelvesResponse>({
      queryKey: [
        'equipment-shelves',
        equipment?.equipmentId,
      ],

      queryFn: () =>
        EquipmentService.getEquipmentShelves(
          api,
          equipment!.equipmentId,
          permissions,
        ),

      enabled:
        isOpen &&
        Boolean(
          equipment?.equipmentId,
        ),

      staleTime: 10_000,
    });

  if (
    !isOpen ||
    !equipment
  ) {
    return null;
  }

  const data =
    query.data ??
    (equipment as EquipmentWithShelvesResponse);

  const allocations =
    data.equipmentShelfs ?? [];

  const totalStock =
    data.equipmentQuantity ??
    0;

  const totalAllocated =
    data.totalAllocated ??
    allocations.reduce(
      (sum, allocation) =>
        sum +
        Number(
          allocation.equipmentQuantity ||
          0,
        ),
      0,
    );

  const unallocated =
    data.unallocatedQuantity ??
    Math.max(
      0,
      totalStock -
      totalAllocated,
    );

  const shelvesCount =
    data.shelvesCount ??
    allocations.length;

  async function copyShelf(
    shelfId: string,
  ) {
    await navigator.clipboard.writeText(
      shelfId,
    );

    setCopied(shelfId);
    toast.success('GUID emplacement copié');

    setTimeout(
      () =>
        setCopied(null),
      1500,
    );
  }

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
      onMouseDown={(event) => {
        if (
          event.target ===
          event.currentTarget
        ) {
          onClose();
        }
      }}
    >
      <div className="flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-5 py-4">
          <div>
            <h2 className="text-sm font-semibold">
              Emplacements associés
            </h2>

            <p className="mt-0.5 text-[10px] text-white/50">
              {equipment.equipmentName ??
                equipment.equipmentId}
            </p>
          </div>

          <div className="flex gap-1">
            <button
              type="button"
              onClick={() =>
                query.refetch()
              }
              className="rounded p-2 text-white/60 hover:bg-white/10 hover:text-white"
            >
              <RefreshCw
                className={`h-4 w-4 ${query.isFetching
                    ? 'animate-spin'
                    : ''
                  }`}
              />
            </button>

            <button
              type="button"
              onClick={onClose}
              className="rounded p-2 text-white/60 hover:bg-white/10 hover:text-white"
            >
              <X className="h-4 w-4" />
            </button>
          </div>
        </header>

        <div className="flex-1 space-y-4 overflow-y-auto p-5">
          <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <Metric
              label="Global"
              value={totalStock}
              icon={
                <Package className="h-3.5 w-3.5" />
              }
            />
            <Metric
              label="Alloué"
              value={totalAllocated}
              icon={
                <Check className="h-3.5 w-3.5" />
              }
            />
            <Metric
              label="Non alloué"
              value={unallocated}
              warning={
                unallocated > 0
              }
              icon={
                <AlertTriangle className="h-3.5 w-3.5" />
              }
            />
            <Metric
              label="Emplacements"
              value={shelvesCount}
              icon={
                <Layers className="h-3.5 w-3.5" />
              }
            />
          </div>

          <p className="text-[10px] leading-relaxed text-white/45">
            Pour un article sérialisé, la quantité globale correspond au nombre
            d’identités série enregistrées. La répartition physique est suivie
            par les allocations/emplacements et les mouvements.
          </p>

          {query.isLoading ? (
            <div className="py-8 text-center text-xs text-white/45">
              Chargement...
            </div>
          ) : allocations.length ? (
            <div className="overflow-hidden rounded-lg border border-[#3f3a36]">
              <div className="grid grid-cols-[minmax(0,1fr)_90px] border-b border-[#3f3a36] bg-[#2b2622] px-4 py-2 text-[10px] uppercase text-white/45">
                <span>
                  Emplacement
                </span>
                <span className="text-right">
                  Quantité
                </span>
              </div>

              <div className="divide-y divide-[#3f3a36]">
                {allocations.map(
                  (allocation) => (
                    <div
                      key={
                        allocation.equipmentShelfId
                      }
                      className="grid grid-cols-[minmax(0,1fr)_90px] items-center px-4 py-3 text-xs"
                    >
                      <div className="min-w-0">
                        <p className="truncate font-medium">
                          {allocation.shelf?.shelfName ??
                            allocation.shelfId}
                        </p>

                        <div className="mt-1 flex items-center gap-1">
                          <span className="truncate font-mono text-[9px] text-white/35">
                            {allocation.shelfId}
                          </span>

                          <button
                            type="button"
                            onClick={() =>
                              copyShelf(
                                allocation.shelfId,
                              )
                            }
                            className="text-white/45 hover:text-white"
                          >
                            {copied ===
                              allocation.shelfId ? (
                              <Check className="h-3 w-3 text-emerald-300" />
                            ) : (
                              <Copy className="h-3 w-3" />
                            )}
                          </button>
                        </div>
                      </div>

                      <span className="text-right font-mono font-semibold">
                        {allocation.equipmentQuantity}
                      </span>
                    </div>
                  ),
                )}
              </div>
            </div>
          ) : (
            <div className="rounded-lg border border-dashed border-[#3f3a36] py-8 text-center text-xs text-white/45">
              Aucun emplacement actuellement alloué.
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

function Metric({
  label,
  value,
  icon,
  warning = false,
}: {
  label: string;
  value: number;
  icon: React.ReactNode;
  warning?: boolean;
}) {
  return (
    <div
      className={`rounded-lg border p-3 ${warning
          ? 'border-amber-400/30 bg-amber-400/10'
          : 'border-[#3f3a36] bg-[#2b2622]/65'
        }`}
    >
      <div className="flex items-center gap-1.5 text-[10px] text-white/45">
        {icon}
        {label}
      </div>

      <div className="mt-2 flex items-center gap-1 font-mono text-lg font-semibold">
        <Hash className="h-3 w-3 text-white/35" />
        {value}
      </div>
    </div>
  );
}
</file>

<file path="src/components/movement/MovementDetailModal.tsx">
'use client';

import {
    ArrowDownToLine,
    ArrowRight,
    ArrowRightLeft,
    ArrowUpFromLine,
    Barcode,
    CalendarClock,
    Copy,
    Hash,
    Package,
    UserRound,
    X,
} from 'lucide-react';
import { toast } from 'sonner';

import type { Movement } from '@/types/movement';

interface MovementDetailModalProps {
    movement: Movement | null;
    isOpen: boolean;
    onClose: () => void;
}

type MovementWithCreator = Movement & {
    createdByUser?: {
        userId: string;
        userName: string | null;
        userEmail: string | null;
    } | null;
};

function typeOf(
    movement: Movement,
): 'IN' | 'OUT' | 'TRANSFER' {
    const value =
        movement.mouvementStatus?.toUpperCase();

    if (value === 'IN') return 'IN';
    if (value === 'OUT') return 'OUT';

    return 'TRANSFER';
}

function formatDate(value?: string | null) {
    if (!value) return '—';

    const parsed = new Date(value);

    if (Number.isNaN(parsed.getTime())) {
        return value;
    }

    return new Intl.DateTimeFormat('fr-DZ', {
        dateStyle: 'medium',
        timeStyle: 'medium',
    }).format(parsed);
}

function routeName(
    shelf:
        | {
            shelfId: string;
            shelfName: string | null;
        }
        | null
        | undefined,
    id: string | null,
) {
    return shelf?.shelfName ?? id ?? '—';
}

export function MovementDetailModal({
    movement,
    isOpen,
    onClose,
}: MovementDetailModalProps) {
    if (!isOpen || !movement) return null;

    const typed = movement as MovementWithCreator;
    const type = typeOf(movement);

    const copyMovementId = async () => {
        await navigator.clipboard.writeText(
            movement.mouvementId,
        );

        toast.success('GUID copié');
    };

    const TypeIcon =
        type === 'IN'
            ? ArrowDownToLine
            : type === 'OUT'
                ? ArrowUpFromLine
                : ArrowRightLeft;

    const typeClass =
        type === 'IN'
            ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300'
            : type === 'OUT'
                ? 'border-rose-500/30 bg-rose-500/10 text-rose-300'
                : 'border-sky-500/30 bg-sky-500/10 text-sky-300';

    return (
        <div
            className="fixed inset-0 z-50 flex items-center justify-center bg-black/65 p-4 backdrop-blur-sm"
            onMouseDown={(event) => {
                if (event.target === event.currentTarget) {
                    onClose();
                }
            }}
        >
            <div className="max-h-[92vh] w-full max-w-4xl overflow-hidden rounded-[6px] border border-[#3f3a36] bg-[#2f2a26] shadow-2xl">
                <div className="flex items-start justify-between border-b border-[#3f3a36] bg-[#383330]/70 px-5 py-4">
                    <div className="min-w-0">
                        <div className="flex flex-wrap items-center gap-2">
                            <span
                                className={`inline-flex items-center gap-1.5 rounded-[3px] border px-2 py-1 text-[10px] font-semibold ${typeClass}`}
                            >
                                <TypeIcon className="h-3.5 w-3.5" />
                                {type === 'IN'
                                    ? 'ENTRÉE'
                                    : type === 'OUT'
                                        ? 'SORTIE'
                                        : 'TRANSFERT'}
                            </span>

                            <span className="font-mono text-[10px] text-[#8c827a]">
                                {movement.mouvementId}
                            </span>
                        </div>

                        <h2 className="mt-2 text-lg font-medium text-[#f7f5f0]">
                            Détail du mouvement
                        </h2>

                        <p className="mt-1 text-xs text-[#aea69c]">
                            Un document · une direction ·{' '}
                            {movement.items?.length ?? 0} ligne(s)
                        </p>
                    </div>

                    <button
                        type="button"
                        onClick={onClose}
                        className="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#2b2622] text-[#aea69c] transition-colors hover:text-[#f7f5f0]"
                        aria-label="Fermer"
                    >
                        <X className="h-4 w-4" />
                    </button>
                </div>

                <div className="max-h-[calc(92vh-145px)] overflow-y-auto p-5">
                    <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                        <InfoCard
                            icon={CalendarClock}
                            label="Date"
                            value={formatDate(movement.createdAt)}
                        />

                        <InfoCard
                            icon={Package}
                            label="Quantité totale"
                            value={`${movement.mouvementQuantity ?? 0} unité(s)`}
                        />

                        <InfoCard
                            icon={Hash}
                            label="Nombre de lignes"
                            value={`${movement.items?.length ?? 0}`}
                        />

                        <InfoCard
                            icon={UserRound}
                            label="Créé par"
                            value={
                                typed.createdByUser?.userName ??
                                typed.createdByUser?.userEmail ??
                                '—'
                            }
                        />
                    </div>

                    <div className="mt-4 rounded-[4px] border border-[#3f3a36] bg-[#2b2622] p-4">
                        <p className="mb-3 text-[10px] font-semibold uppercase tracking-wider text-[#8c827a]">
                            Trajet commun
                        </p>

                        <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
                            <RouteBox
                                label="Source"
                                value={routeName(
                                    movement.sourceShelf,
                                    movement.sourceShelfId,
                                )}
                            />

                            <ArrowRight className="mx-auto h-4 w-4 shrink-0 rotate-90 text-[#5c544d] sm:rotate-0" />

                            <RouteBox
                                label="Destination"
                                value={routeName(
                                    movement.destinationShelf,
                                    movement.destinationShelfId,
                                )}
                            />
                        </div>
                    </div>

                    <div className="mt-4 overflow-hidden rounded-[4px] border border-[#3f3a36]">
                        <div className="flex items-center justify-between border-b border-[#3f3a36] bg-[#383330]/55 px-4 py-3">
                            <div>
                                <h3 className="text-xs font-semibold text-[#f7f5f0]">
                                    Lignes du mouvement
                                </h3>
                                <p className="mt-0.5 text-[10px] text-[#8c827a]">
                                    Toutes les lignes partagent le même type et le même trajet.
                                </p>
                            </div>

                            <span className="font-mono text-xs text-[#aea69c]">
                                {movement.items?.length ?? 0}
                            </span>
                        </div>

                        <div className="divide-y divide-[#3f3a36]">
                            {(movement.items ?? []).map(
                                (item, index) => (
                                    <div
                                        key={
                                            item.mouvementEquipmentId ??
                                            `${item.equipmentId}-${item.serialNumberId ?? index}`
                                        }
                                        className="grid grid-cols-1 gap-3 px-4 py-3 sm:grid-cols-[42px_minmax(0,1fr)_minmax(0,1fr)_100px] sm:items-center"
                                    >
                                        <div className="flex h-8 w-8 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#383330] font-mono text-[10px] text-[#aea69c]">
                                            {String(index + 1).padStart(
                                                2,
                                                '0',
                                            )}
                                        </div>

                                        <div className="min-w-0">
                                            <p className="truncate text-xs font-medium text-[#f7f5f0]">
                                                {item.equipment?.equipmentName ??
                                                    item.equipmentId}
                                            </p>
                                            <p className="mt-1 truncate font-mono text-[10px] text-[#6f665f]">
                                                {item.equipmentId}
                                            </p>
                                        </div>

                                        <div className="min-w-0">
                                            {item.serialNumberId ? (
                                                <>
                                                    <p className="flex items-center gap-1.5 truncate text-xs text-[#c9c0ad]">
                                                        <Barcode className="h-3.5 w-3.5 shrink-0 text-[#8c827a]" />
                                                        {item.serialNumber
                                                            ?.serialNumberCode ??
                                                            item.serialNumberId}
                                                    </p>
                                                    <p className="mt-1 truncate font-mono text-[10px] text-[#6f665f]">
                                                        {item.serialNumberId}
                                                    </p>
                                                </>
                                            ) : (
                                                <span className="text-xs text-[#6f665f]">
                                                    Article quantitatif
                                                </span>
                                            )}
                                        </div>

                                        <div className="text-left sm:text-right">
                                            <span className="inline-flex rounded-[3px] border border-[#3f3a36] bg-[#383330] px-2 py-1 font-mono text-xs font-semibold text-[#f7f5f0]">
                                                {item.mouvementQuantity} u.
                                            </span>
                                        </div>
                                    </div>
                                ),
                            )}

                            {!movement.items?.length && (
                                <div className="px-4 py-8 text-center text-xs text-[#8c827a]">
                                    Aucune ligne enregistrée.
                                </div>
                            )}
                        </div>
                    </div>
                </div>

                <div className="flex items-center justify-between border-t border-[#3f3a36] bg-[#2b2622] px-5 py-3">
                    <button
                        type="button"
                        onClick={copyMovementId}
                        className="inline-flex items-center gap-1.5 rounded-[3px] border border-[#3f3a36] bg-[#383330] px-3 py-2 text-xs text-[#c9c0ad] transition-colors hover:text-[#f7f5f0]"
                    >
                        <Copy className="h-3.5 w-3.5" />
                        Copier GUID
                    </button>

                    <button
                        type="button"
                        onClick={onClose}
                        className="rounded-[3px] bg-[#f7f5f0] px-4 py-2 text-xs font-medium text-[#2b2622] transition-colors hover:bg-[#dad2c1]"
                    >
                        Fermer
                    </button>
                </div>
            </div>
        </div>
    );
}

function InfoCard({
    icon: Icon,
    label,
    value,
}: {
    icon: typeof Package;
    label: string;
    value: string;
}) {
    return (
        <div className="rounded-[4px] border border-[#3f3a36] bg-[#2b2622] p-3">
            <div className="flex items-center gap-2 text-[#8c827a]">
                <Icon className="h-3.5 w-3.5" />
                <span className="text-[10px] uppercase tracking-wider">
                    {label}
                </span>
            </div>
            <p className="mt-2 break-words text-xs font-medium text-[#f7f5f0]">
                {value}
            </p>
        </div>
    );
}

function RouteBox({
    label,
    value,
}: {
    label: string;
    value: string;
}) {
    return (
        <div className="min-w-0 flex-1 rounded-[3px] border border-[#3f3a36] bg-[#383330]/55 p-3">
            <p className="text-[10px] uppercase tracking-wider text-[#8c827a]">
                {label}
            </p>
            <p className="mt-1 truncate text-xs font-medium text-[#f7f5f0]">
                {value}
            </p>
        </div>
    );
}
