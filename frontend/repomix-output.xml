<file path="src/lib/movement-draft.ts">
import type { Equipment } from "@/types/equipment";
import type { CreateEquipmentMovementInput } from "@/types/movement";

export interface MovementDraft {
  id: string;
  equipment: Equipment;
  type: "IN" | "OUT" | "TRANSFER";
  sourceShelfId: string;
  destinationShelfId: string;
  quantity: number;
  serialIds: string[];
  serialDestinations: Record<string, string>;
}

export function createMovementDraft(
  equipment: Equipment,
  id = equipment.equipmentId,
): MovementDraft {
  const source =
    equipment.equipmentShelfs?.find((row) => row.equipmentQuantity > 0)
      ?.shelfId ?? "";
  const hasSource = equipment.hasSerialNumber
    ? equipment.serialNumbers?.some((serial) => serial.shelfId)
    : !!source;
  return {
    id,
    equipment,
    type: hasSource ? "TRANSFER" : "IN",
    sourceShelfId: source,
    destinationShelfId: "",
    quantity: 1,
    serialIds: [],
    serialDestinations: {},
  };
}

// Build the entire document locally. Only the final confirmation sends these lines.
export function buildMovementItems(
  drafts: MovementDraft[],
): CreateEquipmentMovementInput[] {
  if (!drafts.length) throw new Error("Sélectionnez au moins un article.");
  const items: CreateEquipmentMovementInput[] = [];
  const serials = new Set<string>();
  const balances = new Map<string, number>();
  for (const draft of drafts) {
    const equipment = draft.equipment;
    const name = equipment.equipmentName ?? equipment.equipmentId;
    const fail = (message: string): never => {
      throw new Error(`${name} : ${message}`);
    };
    if (equipment.hasSerialNumber) {
      if (!draft.serialIds.length)
        fail("sélectionnez au moins un numéro de série.");
      for (const id of draft.serialIds) {
        const serial = equipment.serialNumbers?.find(
          (row) => row.serialNumberId === id,
        );
        if (!serial) fail("numéro de série introuvable.");
        if (serials.has(id.toLowerCase()))
          fail("un numéro de série est sélectionné plusieurs fois.");
        serials.add(id.toLowerCase());
        const sourceShelfId = serial!.shelfId ?? undefined;
        const destinationShelfId =
          draft.type === "OUT"
            ? undefined
            : draft.serialDestinations[id] ||
              draft.destinationShelfId ||
              undefined;
        if (draft.type === "IN" && sourceShelfId)
          fail("ce numéro est déjà placé ; choisissez un transfert.");
        if (draft.type === "OUT" && !sourceShelfId)
          fail("ce numéro ne possède pas d’emplacement source.");
        if (draft.type !== "OUT" && !destinationShelfId)
          fail("choisissez la destination de chaque numéro.");
        if (
          sourceShelfId &&
          sourceShelfId.toLowerCase() === destinationShelfId?.toLowerCase()
        )
          fail("la source et la destination doivent être différentes.");
        items.push({
          equipmentId: equipment.equipmentId,
          serialNumberId: id,
          sourceShelfId,
          destinationShelfId,
          movementQuantity: 1,
          movementType: !sourceShelfId
            ? "IN"
            : !destinationShelfId
              ? "OUT"
              : "TRANSFER",
        });
      }
    } else {
      const sourceShelfId =
        draft.type === "IN" ? undefined : draft.sourceShelfId || undefined;
      const destinationShelfId =
        draft.type === "OUT"
          ? undefined
          : draft.destinationShelfId || undefined;
      if (
        !Number.isInteger(draft.quantity) ||
        draft.quantity <= 0 ||
        draft.quantity > 2147483647
      )
        fail("saisissez une quantité entière positive.");
      if (draft.type !== "IN" && !sourceShelfId)
        fail("choisissez un emplacement source.");
      if (draft.type !== "OUT" && !destinationShelfId)
        fail("choisissez un emplacement de destination.");
      if (
        sourceShelfId &&
        sourceShelfId.toLowerCase() === destinationShelfId?.toLowerCase()
      )
        fail("la source et la destination doivent être différentes.");
      const balance = (shelfId: string) => {
        const key = `${equipment.equipmentId}:${shelfId}`.toLowerCase();
        const allocations =
          equipment.equipmentShelfs?.filter(
            (row) => row.shelfId.toLowerCase() === shelfId.toLowerCase(),
          ) ?? [];
        if (allocations.length > 1)
          fail(
            "plusieurs allocations existent pour cet emplacement ; vérifiez le stock.",
          );
        if (!balances.has(key))
          balances.set(key, allocations[0]?.equipmentQuantity ?? 0);
        return key;
      };
      if (sourceShelfId) {
        const key = balance(sourceShelfId);
        if (balances.get(key)! < draft.quantity)
          fail("la quantité dépasse le stock disponible sur la source.");
        balances.set(key, balances.get(key)! - draft.quantity);
      }
      if (destinationShelfId) {
        const key = balance(destinationShelfId);
        balances.set(key, balances.get(key)! + draft.quantity);
      }
      items.push({
        equipmentId: equipment.equipmentId,
        sourceShelfId,
        destinationShelfId,
        movementQuantity: draft.quantity,
        movementType: draft.type,
      });
    }
  }
  if (items.length > 100)
    throw new Error("Un mouvement accepte au maximum 100 lignes.");
  if (items.reduce((sum, item) => sum + item.movementQuantity, 0) > 2147483647)
    throw new Error("La quantité totale du mouvement est trop élevée.");
  return items;
}
</file>

<file path="src/lib/movement-ledger.ts">
import type { Movement, MovementAuditSummary, MovementLedgerEntry } from '@/types/movement';

export function flattenMovementLines(movements: Movement[], equipmentId?: string): Movement[] {
  const unique = new Map<string, Movement>();
  for (const header of movements) {
    const lines = header.items?.length ? header.items.map(item => ({ ...header, ...item, items: undefined })) : [header];
    for (const line of lines) {
      if (equipmentId && line.equipmentId?.toLowerCase() !== equipmentId.toLowerCase()) continue;
      const key = (line.mouvementEquipmentId ?? line.mouvementId).toLowerCase();
      unique.set(key, line);
    }
  }
  return [...unique.values()].sort((a, b) => {
    const time = (value?: string | null) => value && Number.isFinite(Date.parse(value)) ? Date.parse(value) : 0;
    return time(a.createdAt) - time(b.createdAt) || a.mouvementId.localeCompare(b.mouvementId) || (a.mouvementEquipmentId ?? '').localeCompare(b.mouvementEquipmentId ?? '');
  });
}

export function calculateMovementAudit(movements: Movement[], currentStock: number, equipmentId?: string): MovementAuditSummary {
  const lines = flattenMovementLines(movements, equipmentId);
  if (new Set(lines.map(line => line.equipmentId?.toLowerCase()).filter(Boolean)).size > 1) {
    throw new Error('An equipment ID is required to calculate a multi-equipment ledger');
  }
  const classify = (line: Movement): MovementLedgerEntry['type'] => {
    const status = line.mouvementStatus?.toUpperCase();
    if (['IN', 'ENTRY', 'ENTRÉE'].includes(status ?? '') || (!line.sourceShelfId && !!line.destinationShelfId)) return 'IN';
    if (['OUT', 'EXIT', 'SORTIE'].includes(status ?? '') || (!!line.sourceShelfId && !line.destinationShelfId)) return 'OUT';
    return 'TRANSFER';
  };
  let totalIn = 0;
  let totalOut = 0;
  for (const line of lines) {
    if (classify(line) === 'IN') totalIn += line.mouvementQuantity ?? 1;
    if (classify(line) === 'OUT') totalOut += line.mouvementQuantity ?? 1;
  }
  const initialQuantity = Math.max(0, currentStock - totalIn + totalOut);
  let runningBalance = initialQuantity;
  const ledger = lines.map(movement => {
    const type = classify(movement);
    const quantity = movement.mouvementQuantity ?? 1;
    const delta = type === 'IN' ? quantity : type === 'OUT' ? -quantity : 0;
    runningBalance += delta;
    return { movement, type, delta, runningBalance };
  });
  return { initialQuantity, totalIn, totalOut, currentQuantity: currentStock, ledger };
}
</file>

