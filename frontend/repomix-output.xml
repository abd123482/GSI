<file path="src/app/inventory/page.tsx">
'use client';

import { useState } from 'react';
import { useAuth, SignInButton } from '@clerk/nextjs';
import Link from 'next/link';
import {
  ClipboardList,
  Loader2,
  Plus,
  PlayCircle,
  Trash2,
  AlertTriangle,
} from 'lucide-react';
import { useInventories, useLaunchInventory, useDeleteInventory } from '@/hooks/use-inventory';
import { usePermissions } from '@/hooks/use-permissions';
import { toast } from 'sonner';

export default function InventoryPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const { hasPermission, isAdmin, canDeleteInventory, isLoading: isPermissionsLoading } = usePermissions();
  
  const { data, isLoading } = useInventories();
  const { mutateAsync: launchInventory } = useLaunchInventory();
  const { mutateAsync: deleteInventory, isPending: isDeleting } = useDeleteInventory();
  const [inventoryToDelete, setInventoryToDelete] = useState<any | null>(null);

  const inventoriesList = data?.inventories || [];

  if (!isLoaded || isLoading || isPermissionsLoading) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
        <div className="flex items-center gap-2 text-xs font-mono text-[#aea69c]">
          <Loader2 className="w-4 h-4 animate-spin text-[#f7f5f0]" />
          <span>Chargement des inventaires...</span>
        </div>
      </main>
    );
  }

  if (!isSignedIn) {
    return (
      <main className="min-h-screen flex items-center justify-center p-6 bg-[#2b2622] text-[#f7f5f0]">
        <div className="w-full max-w-md bg-[#383330] border border-[#3f3a36] rounded-[4px] p-8 shadow-xl text-center space-y-4">
          <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0] mx-auto">
            <ClipboardList className="w-5 h-5" />
          </div>
          <div className="space-y-1">
            <h1 className="text-base font-medium text-[#f7f5f0]">Connexion requise</h1>
            <p className="text-xs text-[#c9c0ad]">
              Veuillez vous connecter pour gérer les inventaires.
            </p>
          </div>
          <div className="flex flex-col sm:flex-row gap-2 pt-2">
            <SignInButton mode="modal">
              <button
                type="button"
                className="flex-1 px-4 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
              >
                Se connecter
              </button>
            </SignInButton>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
      <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
        {/* Page Hero Section */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#3f3a36]">
          <div className="space-y-1">
            <div className="flex items-center gap-2 text-xs text-[#aea69c] mb-1 font-mono">
              <Link href="/" className="hover:text-[#f7f5f0] transition-colors">
                somepharm
              </Link>
              <span>/</span>
              <span className="text-[#f7f5f0]">inventory</span>
            </div>
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-xl sm:text-2xl font-normal tracking-tight text-[#f7f5f0]">
                Inventaires & Réconciliations
              </h1>
            </div>
            <p className="text-xs text-[#c9c0ad]">
              Workflow d'inventaire complet avec comptage en double aveugle et adjudication.
            </p>
          </div>

          <div className="flex items-center gap-2 shrink-0">
            <Link
              href="/inventory/tasks"
              className="inline-flex items-center justify-center gap-2 px-3 py-2 bg-[#383330] hover:bg-[#3f3a36] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
            >
              <PlayCircle className="w-3.5 h-3.5 text-[#aea69c]" />
              <span>Mes Tâches</span>
            </Link>

            {hasPermission('inventory.create') && (
              <Link
                href="/inventory/create"
                className="inline-flex items-center justify-center gap-2 px-3.5 py-2 bg-[#10b981] hover:bg-[#059669] text-[#1f1b18] text-xs font-semibold rounded-[3px] shadow-xs transition-colors cursor-pointer"
              >
                <Plus className="w-3.5 h-3.5" />
                <span>Nouvel Inventaire</span>
              </Link>
            )}
          </div>
        </div>

        {/* Empty State / List */}
        {inventoriesList.length === 0 ? (
          <div className="flex flex-col items-center justify-center py-20 border border-dashed border-[#3f3a36] rounded-[4px] bg-[#2f2a26]">
            <ClipboardList className="w-8 h-8 text-[#5c544d] mb-3" />
            <p className="text-sm text-[#aea69c]">Aucun inventaire trouvé.</p>
            <Link href="/inventory/create" className="mt-4 text-xs font-medium text-[#10b981] underline underline-offset-2 hover:text-[#059669]">
              Créer votre premier inventaire
            </Link>
          </div>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
             {inventoriesList.map((inv: any) => (
                <div key={inv.inventoryId} className="p-4 rounded-[4px] border border-[#3f3a36] bg-[#2f2a26] flex flex-col justify-between hover:border-[#aea69c] transition-colors">
                   <div className="space-y-2">
                      <div className="flex justify-between items-start">
                         <h3 className="font-medium text-[#f7f5f0]">{inv.title}</h3>
                         <span className={`text-[10px] font-mono px-2 py-0.5 rounded-[2px] border font-medium ${
                           inv.status === 'FINALIZED' || inv.status === 'COMPLETED'
                             ? 'bg-[#10b981]/15 text-[#10b981] border-[#10b981]/30'
                             : inv.status === 'THIRD_COUNT_REQUIRED'
                             ? 'bg-red-500/15 text-red-400 border-red-500/30'
                             : 'bg-[#383330] text-[#c9c0ad] border-[#3f3a36]'
                         }`}>
                           {inv.status === 'THIRD_COUNT_REQUIRED' ? 'ARBITRAGE REQUIS' : inv.status}
                         </span>
                      </div>
                      <p className="text-xs text-[#c9c0ad]">Type: {inv.typeInventory}</p>
                   </div>
                   
                   <div className="mt-4 pt-4 border-t border-[#3f3a36] flex items-center justify-between gap-2">
                      <div>
                        {(isAdmin || canDeleteInventory) && (
                          <button
                            type="button"
                            onClick={() => setInventoryToDelete(inv)}
                            className="p-1.5 rounded-[3px] text-[#aea69c] hover:text-red-400 hover:bg-red-500/10 border border-transparent hover:border-red-500/20 transition-all cursor-pointer"
                            title="Supprimer l'inventaire"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        )}
                      </div>

                      <div className="flex items-center gap-2">
                        {inv.status === 'DRAFT' && (
                           <button 
                             onClick={async () => {
                               try {
                                 await launchInventory(inv.inventoryId);
                                 toast.success('Inventaire lancé!');
                               } catch (e) {
                                 toast.error('Erreur lancement');
                               }
                             }}
                             className="text-xs bg-[#10b981] hover:bg-[#059669] text-[#1f1b18] px-3 py-1.5 rounded-[3px] font-semibold transition-colors cursor-pointer"
                           >
                             Lancer
                           </button>
                        )}
                        {(inv.status === 'IN_PROGRESS' || inv.status === 'THIRD_COUNT_REQUIRED' || inv.status === 'COMPLETED') && (
                           <Link href={`/inventory/${inv.inventoryId}/report`} className="text-xs border border-[#3f3a36] text-[#c9c0ad] px-3 py-1.5 rounded-[3px] font-medium hover:text-[#f7f5f0] hover:bg-[#383330] transition-colors">
                             Voir l'avancement
                           </Link>
                        )}
                        {inv.status === 'FINALIZED' && (
                           <Link href={`/inventory/${inv.inventoryId}/report`} className="text-xs border border-[#10b981]/40 bg-[#10b981]/10 text-[#10b981] px-3 py-1.5 rounded-[3px] font-medium hover:bg-[#10b981]/20 transition-colors">
                             Rapport final
                           </Link>
                        )}
                      </div>
                   </div>
                </div>
             ))}
          </div>
        )}
      </div>

      {/* Delete Confirmation Modal */}
      {inventoryToDelete && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-in fade-in duration-150">
          <div className="w-full max-w-md bg-[#383330] border border-[#3f3a36] rounded-[4px] p-6 shadow-2xl space-y-4">
            <div className="flex items-start gap-3">
              <div className="w-9 h-9 rounded-[3px] bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 shrink-0">
                <AlertTriangle className="w-4 h-4" />
              </div>
              <div className="space-y-1">
                <h2 className="text-sm font-medium text-[#f7f5f0]">
                  Supprimer l'inventaire ?
                </h2>
                <p className="text-xs text-[#c9c0ad] leading-relaxed">
                  Êtes-vous sûr de vouloir supprimer définitivement{' '}
                  <strong className="text-[#f7f5f0]">
                    "{inventoryToDelete.title || 'Inventaire sans titre'}"
                  </strong>{' '}
                  ? Cette action est irréversible et supprimera tous les comptages, tâches et réconciliations liés.
                </p>
              </div>
            </div>

            <div className="flex justify-end gap-2 pt-2 border-t border-[#3f3a36]">
              <button
                type="button"
                disabled={isDeleting}
                onClick={() => setInventoryToDelete(null)}
                className="px-3 py-1.5 rounded-[3px] border border-[#3f3a36] bg-[#2b2622] hover:bg-[#3f3a36] text-[#f7f5f0] text-xs font-medium transition-colors cursor-pointer disabled:opacity-50"
              >
                Annuler
              </button>
              <button
                type="button"
                disabled={isDeleting}
                onClick={async () => {
                  try {
                    await deleteInventory(inventoryToDelete.inventoryId);
                    toast.success('Inventaire supprimé avec succès');
                    setInventoryToDelete(null);
                  } catch (err: any) {
                    toast.error(err?.response?.data?.message || 'Erreur lors de la suppression');
                  }
                }}
                className="px-3 py-1.5 rounded-[3px] bg-red-600 hover:bg-red-700 text-white text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer disabled:opacity-50"
              >
                {isDeleting ? (
                  <>
                    <Loader2 className="w-3.5 h-3.5 animate-spin" />
                    <span>Suppression en cours...</span>
                  </>
                ) : (
                  <>
                    <Trash2 className="w-3.5 h-3.5" />
                    <span>Supprimer définitivement</span>
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}
    </main>
  );
}
</file>

<file path="src/app/movements/page.tsx">
'use client';

import { useMemo, useState } from 'react';
import Link from 'next/link';
import { SignInButton, useAuth } from '@clerk/nextjs';
import {
    ArrowRightLeft,
    Cpu,
    Loader2,
    RefreshCw,
    ShieldAlert,
    ShieldCheck,
} from 'lucide-react';

import {
    useMovements,
    type MovementTypeV3,
} from '@/hooks/use-movements';
import { usePermissions } from '@/hooks/use-permissions';
import type { Movement } from '@/types/movement';
import { MovementListTable } from '@/components/movement/MovementListTable';
import { MovementDetailModal } from '@/components/movement/MovementDetailModal';

export default function MovementsPage() {
    const { isLoaded, isSignedIn } = useAuth();
    const {
        isAdmin,
        hasPermission,
        isLoading: isPermissionsLoading,
    } = usePermissions();

    const canReadMovement =
        isAdmin || hasPermission('movement.read');

    const canCreateMovement =
        isAdmin || hasPermission('movement.create');

    const [page, setPage] = useState(1);
    const [limit, setLimit] = useState(20);
    const [movementType, setMovementType] =
        useState<MovementTypeV3 | ''>('');

    const [selectedMovement, setSelectedMovement] =
        useState<Movement | null>(null);

    const query = useMemo(
        () => ({
            page,
            limit,
            movementType:
                movementType || undefined,
        }),
        [page, limit, movementType],
    );

    const movementsQuery = useMovements(
        query,
        Boolean(
            isLoaded &&
            isSignedIn &&
            !isPermissionsLoading &&
            canReadMovement,
        ),
    );

    if (!isLoaded || isPermissionsLoading) {
        return (
            <main className="flex min-h-screen items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
                <div className="flex items-center gap-2 text-xs text-[#aea69c]">
                    <Loader2 className="h-4 w-4 animate-spin" />
                    Chargement des mouvements...
                </div>
            </main>
        );
    }

    if (!isSignedIn) {
        return (
            <main className="flex min-h-screen items-center justify-center bg-[#2b2622] p-6 text-[#f7f5f0]">
                <div className="w-full max-w-md rounded-[4px] border border-[#3f3a36] bg-[#383330] p-8 text-center shadow-xl">
                    <div className="mx-auto flex h-10 w-10 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#2b2622]">
                        <ArrowRightLeft className="h-5 w-5" />
                    </div>

                    <h1 className="mt-4 text-base font-medium">
                        Connexion requise
                    </h1>

                    <p className="mt-2 text-xs text-[#c9c0ad]">
                        Connectez-vous pour consulter les mouvements de stock.
                    </p>

                    <div className="mt-5">
                        <SignInButton mode="modal">
                            <button
                                type="button"
                                className="w-full rounded-[3px] bg-[#f7f5f0] px-4 py-2 text-xs font-medium text-[#2b2622] hover:bg-[#dad2c1]"
                            >
                                Se connecter
                            </button>
                        </SignInButton>
                    </div>
                </div>
            </main>
        );
    }

    if (!canReadMovement) {
        return (
            <main className="flex min-h-[calc(100vh-3.5rem)] items-center justify-center bg-[#2b2622] p-6 text-[#f7f5f0]">
                <div className="w-full max-w-lg rounded-[4px] border border-amber-500/25 bg-[#2f2a26] p-7 text-center">
                    <ShieldAlert className="mx-auto h-6 w-6 text-amber-400" />
                    <h1 className="mt-3 text-sm font-semibold">
                        Accès aux mouvements non autorisé
                    </h1>
                    <p className="mt-2 text-xs text-[#aea69c]">
                        La permission{' '}
                        <code className="text-amber-300">
                            movement.read
                        </code>{' '}
                        est requise.
                    </p>
                </div>
            </main>
        );
    }

    return (
        <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0]">
            <div className="mx-auto w-full max-w-7xl space-y-5 px-4 py-6 sm:px-6">
                <div className="flex flex-col gap-4 border-b border-[#3f3a36] pb-4 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <div className="mb-1 flex items-center gap-2 font-mono text-xs text-[#8c827a]">
                            <Link
                                href="/"
                                className="hover:text-[#f7f5f0]"
                            >
                                somepharm
                            </Link>
                            <span>/</span>
                            <span className="text-[#f7f5f0]">
                                mouvements
                            </span>
                        </div>

                        <div className="flex flex-wrap items-center gap-2">
                            <h1 className="text-xl font-normal tracking-tight sm:text-2xl">
                                Mouvements de stock
                            </h1>

                            <span className="inline-flex items-center gap-1.5 rounded-[2px] border border-[#3f3a36] bg-[#383330] px-2 py-0.5 font-mono text-[10px] text-[#c9c0ad]">
                                <ShieldCheck className="h-3 w-3 text-emerald-400" />
                                V3
                            </span>
                        </div>

                        <p className="mt-1 text-xs text-[#aea69c]">
                            Un mouvement possède un type et un trajet communs à toutes ses lignes.
                        </p>
                    </div>

                    <div className="flex items-center gap-2">
                        {canCreateMovement && (
                            <Link
                                href="/equipment"
                                className="inline-flex items-center gap-2 rounded-[3px] border border-[#3f3a36] bg-[#383330] px-3 py-2 text-xs font-medium text-[#f7f5f0] transition-colors hover:bg-[#3f3a36]"
                                title="Ouvrir la page Articles pour créer un mouvement"
                            >
                                <Cpu className="h-3.5 w-3.5 text-[#aea69c]" />
                                Nouveau mouvement
                            </Link>
                        )}

                        <button
                            type="button"
                            onClick={() =>
                                movementsQuery.refetch()
                            }
                            disabled={
                                movementsQuery.isFetching
                            }
                            className="inline-flex h-8 w-8 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-[#383330] text-[#aea69c] transition-colors hover:text-[#f7f5f0] disabled:opacity-50"
                            title="Actualiser"
                        >
                            <RefreshCw
                                className={`h-3.5 w-3.5 ${movementsQuery.isFetching
                                        ? 'animate-spin'
                                        : ''
                                    }`}
                            />
                        </button>
                    </div>
                </div>

                <section className="flex flex-col gap-3 rounded-[4px] border border-[#3f3a36] bg-[#2f2a26] p-4 sm:flex-row sm:items-end">
                    <label className="block min-w-52">
                        <span className="mb-1.5 block text-[10px] font-semibold uppercase tracking-wider text-[#8c827a]">
                            Type
                        </span>

                        <select
                            value={movementType}
                            onChange={(event) => {
                                setMovementType(
                                    event.target.value as
                                    | MovementTypeV3
                                    | '',
                                );
                                setPage(1);
                            }}
                            className="h-9 w-full rounded-[3px] border border-[#3f3a36] bg-[#2b2622] px-3 text-xs text-[#f7f5f0] outline-none focus:border-[#aea69c]"
                        >
                            <option value="">
                                Tous les mouvements
                            </option>
                            <option value="IN">Entrées</option>
                            <option value="OUT">Sorties</option>
                            <option value="TRANSFER">
                                Transferts
                            </option>
                        </select>
                    </label>

                    <label className="block w-32">
                        <span className="mb-1.5 block text-[10px] font-semibold uppercase tracking-wider text-[#8c827a]">
                            Par page
                        </span>

                        <select
                            value={limit}
                            onChange={(event) => {
                                setLimit(
                                    Number(event.target.value),
                                );
                                setPage(1);
                            }}
                            className="h-9 w-full rounded-[3px] border border-[#3f3a36] bg-[#2b2622] px-3 text-xs text-[#f7f5f0] outline-none focus:border-[#aea69c]"
                        >
                            <option value={10}>10</option>
                            <option value={20}>20</option>
                            <option value={50}>50</option>
                            <option value={100}>100</option>
                        </select>
                    </label>

                    <div className="sm:ml-auto">
                        <p className="text-xs text-[#8c827a]">
                            Total :{' '}
                            <span className="font-mono font-semibold text-[#f7f5f0]">
                                {movementsQuery.data?.totalMovements ??
                                    0}
                            </span>
                        </p>
                    </div>
                </section>

                {movementsQuery.isError ? (
                    <div className="rounded-[4px] border border-rose-500/30 bg-rose-500/10 p-4 text-xs text-rose-200">
                        Impossible de charger les mouvements.
                        <button
                            type="button"
                            onClick={() =>
                                movementsQuery.refetch()
                            }
                            className="ml-2 underline"
                        >
                            Réessayer
                        </button>
                    </div>
                ) : (
                    <MovementListTable
                        movements={
                            movementsQuery.data?.movements ??
                            []
                        }
                        totalMovements={
                            movementsQuery.data
                                ?.totalMovements ?? 0
                        }
                        currentPage={
                            movementsQuery.data
                                ?.currentPage ?? page
                        }
                        totalPages={
                            movementsQuery.data?.totalPages ??
                            1
                        }
                        limit={
                            movementsQuery.data?.limit ??
                            limit
                        }
                        isLoading={
                            movementsQuery.isLoading
                        }
                        isFetching={
                            movementsQuery.isFetching
                        }
                        onPageChange={setPage}
                        onSelectMovement={
                            setSelectedMovement
                        }
                    />
                )}
            </div>

            <MovementDetailModal
                movement={selectedMovement}
                isOpen={Boolean(selectedMovement)}
                onClose={() =>
                    setSelectedMovement(null)
                }
            />
        </main>
    );
}
</file>

<file path="src/app/shelves/page.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';
import { useState } from 'react';
import { useAuth, SignInButton } from '@clerk/nextjs';
import Link from 'next/link';
import {
  Layers,
  Plus,
  ShieldCheck,
  ShieldAlert,
  Loader2,
} from 'lucide-react';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { CreateShelfModal } from '@/components/shelf/CreateShelfModal';
import { ShelfListTable } from '@/components/shelf/ShelfListTable';
import { ShelfDetailModal } from '@/components/shelf/ShelfDetailModal';
import { UpdateShelfModal } from '@/components/shelf/UpdateShelfModal';
import { DeleteShelfModal } from '@/components/shelf/DeleteShelfModal';
import { Shelf } from '@/types/shelf';
import { toast } from 'sonner';

export default function ShelvesPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [selectedShelf, setSelectedShelf] = useState<Shelf | null>(null);
  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false);
  const [isLookingUp, setIsLookingUp] = useState(false);

  // States for Update and Delete modals
  const [updatingShelf, setUpdatingShelf] = useState<Shelf | null>(null);
  const [isUpdateModalOpen, setIsUpdateModalOpen] = useState(false);
  const [deletingShelf, setDeletingShelf] = useState<Shelf | null>(null);
  const [isDeleteModalOpen, setIsDeleteModalOpen] = useState(false);

  const {
    shelves,
    totalShelves,
    totalPages,
    currentPage,
    limit,
    searchTerm,
    setSearchTerm,
    setPage,
    setLimit,
    isLoading: isShelvesLoading,
    refetch,
    getShelfById,
    canCreateShelf,
  } = useShelves({ page: 1, limit: 10 });

  const { canUpdateShelf, canDeleteShelf } = usePermissions();

  const handleSelectShelf = (shelf: Shelf) => {
    setSelectedShelf(shelf);
    setIsDetailModalOpen(true);
  };

  const handleLookupById = async (id: string) => {
    setIsLookingUp(true);
    try {
      const shelf = await getShelfById(id);
      setSelectedShelf(shelf);
      setIsDetailModalOpen(true);
      toast.success(`Emplacement trouvé : ${shelf.shelfName ?? shelf.shelfId}`);
    } catch (err: unknown) {
      toast.error('Recherche par ID échouée', {
        description: getErrorMessage(err, `L'emplacement avec le GUID '${id}' est introuvable.`),
      });
    } finally {
      setIsLookingUp(false);
    }
  };

  if (!isLoaded) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
        <div className="flex items-center gap-2 text-xs font-mono text-[#aea69c]">
          <Loader2 className="w-4 h-4 animate-spin text-[#f7f5f0]" />
          <span>Chargement des emplacements...</span>
        </div>
      </main>
    );
  }

  if (!isSignedIn) {
    return (
      <main className="min-h-screen flex items-center justify-center p-6 bg-[#2b2622] text-[#f7f5f0]">
        <div className="w-full max-w-md bg-[#383330] border border-[#3f3a36] rounded-[4px] p-8 shadow-xl text-center space-y-4">
          <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0] mx-auto">
            <Layers className="w-5 h-5" />
          </div>
          <div className="space-y-1">
            <h1 className="text-base font-medium text-[#f7f5f0]">Connexion requise</h1>
            <p className="text-xs text-[#c9c0ad]">
              Veuillez vous connecter pour accéder au registre des emplacements SomePharm.
            </p>
          </div>
          <div className="flex flex-col sm:flex-row gap-2 pt-2">
            <SignInButton mode="modal">
              <button
                type="button"
                className="flex-1 px-4 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
              >
                Se connecter
              </button>
            </SignInButton>
            <Link
              href="/"
              className="flex-1 inline-flex items-center justify-center px-4 py-2 bg-[#2b2622] hover:bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors"
            >
              Accueil
            </Link>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
      {/* Main Workspace Body */}
      <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
        {/* Page Hero Section */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#3f3a36]">
          <div className="space-y-1">
            <div className="flex items-center gap-2 text-xs text-[#aea69c] mb-1 font-mono">
              <Link href="/" className="hover:text-[#f7f5f0] transition-colors">
                somepharm
              </Link>
              <span>/</span>
              <span className="text-[#f7f5f0]">emplacements</span>
            </div>
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-xl sm:text-2xl font-normal tracking-tight text-[#f7f5f0]">
                Gestion des Emplacements
              </h1>
              <div className="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] font-mono text-[10px] bg-[#383330] border border-[#3f3a36] text-[#c9c0ad]">
                {canCreateShelf ? (
                  <>
                    <ShieldCheck className="w-3 h-3 text-[#10b981]" />
                    <span>Création autorisée</span>
                  </>
                ) : (
                  <>
                    <ShieldAlert className="w-3 h-3 text-[#f59e0b]" />
                    <span>Lecture seule</span>
                  </>
                )}
              </div>
            </div>
            <p className="text-xs text-[#c9c0ad]">
              Gestion et suivi des emplacements de stockage.
            </p>
          </div>

          {/* Action CTA: Warp button-primary */}
          <button
            type="button"
            onClick={() => setIsModalOpen(true)}
            className="inline-flex items-center justify-center gap-2 px-3.5 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] shadow-xs transition-colors cursor-pointer shrink-0"
          >
            <Plus className="w-3.5 h-3.5" />
            <span>Nouvel emplacement</span>
          </button>
        </div>

        {/* Shelf List Table Component with Pagination, Search by Name, and Single Shelf Lookup */}
        <ShelfListTable
          shelves={shelves}
          totalShelves={totalShelves}
          totalPages={totalPages}
          currentPage={currentPage}
          limit={limit}
          searchTerm={searchTerm}
          onSearchChange={setSearchTerm}
          onPageChange={setPage}
          onLimitChange={(newLimit) => {
            setLimit(newLimit);
            setPage(1);
          }}
          onSelectShelf={handleSelectShelf}
          onLookupById={handleLookupById}
          onOpenUpdate={(shelf) => {
            setUpdatingShelf(shelf);
            setIsUpdateModalOpen(true);
          }}
          onOpenDelete={(shelf) => {
            setDeletingShelf(shelf);
            setIsDeleteModalOpen(true);
          }}
          isLoading={isShelvesLoading}
          onRefresh={refetch}
          onOpenCreateModal={() => setIsModalOpen(true)}
          canCreateShelf={canCreateShelf}
          canUpdateShelf={canUpdateShelf}
          canDeleteShelf={canDeleteShelf}
        />
      </div>

      {/* Creation Modal Component */}
      <CreateShelfModal
        isOpen={isModalOpen}
        onClose={() => setIsModalOpen(false)}
        onSuccess={() => refetch()}
      />

      {/* Single Shelf Detail Modal */}
      <ShelfDetailModal
        shelf={selectedShelf}
        isOpen={isDetailModalOpen}
        onClose={() => {
          setIsDetailModalOpen(false);
          setSelectedShelf(null);
        }}
        onRefresh={refetch}
        onOpenUpdate={(shelf) => {
          setIsDetailModalOpen(false);
          setUpdatingShelf(shelf);
          setIsUpdateModalOpen(true);
        }}
        onOpenDelete={(shelf) => {
          setIsDetailModalOpen(false);
          setDeletingShelf(shelf);
          setIsDeleteModalOpen(true);
        }}
        canUpdateShelf={canUpdateShelf}
        canDeleteShelf={canDeleteShelf}
        isLoading={isLookingUp}
      />

      {/* Update Shelf Modal Component */}
      <UpdateShelfModal
        shelf={updatingShelf}
        isOpen={isUpdateModalOpen}
        onClose={() => {
          setIsUpdateModalOpen(false);
          setUpdatingShelf(null);
        }}
        onSuccess={() => {
          refetch();
          if (updatingShelf) {
            getShelfById(updatingShelf.shelfId)
              .then((updated) => {
                setSelectedShelf(updated);
                setIsDetailModalOpen(true);
              })
              .catch(() => {});
          }
        }}
      />

      {/* Delete Shelf Modal Component */}
      <DeleteShelfModal
        shelf={deletingShelf}
        isOpen={isDeleteModalOpen}
        onClose={() => {
          setIsDeleteModalOpen(false);
          setDeletingShelf(null);
        }}
        onSuccess={() => {
          refetch();
          setIsDetailModalOpen(false);
          setSelectedShelf(null);
        }}
      />
    </main>
  );
}
</file>

