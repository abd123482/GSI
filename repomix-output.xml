            className="p-2 -ml-2 rounded-md hover:bg-[#383330] text-[#aea69c] transition-colors"
          >
            <ArrowLeft className="w-4 h-4" />
          </Link>
          <div className="flex-1 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
