<file path="frontend/src/components/navigation/NotificationBell.tsx">
'use client';

import { useState } from 'react';
import { Bell, CheckCheck, ExternalLink, Inbox, Loader2 } from 'lucide-react';
import { useRouter } from 'next/navigation';
import {
  useNotifications,
  useUnreadNotificationsCount,
  useMarkNotificationRead,
  useMarkAllNotificationsRead,
  AppNotification,
} from '@/hooks/use-notifications';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';

export function NotificationBell() {
  const router = useRouter();
  const [open, setOpen] = useState(false);

  const { data: notifications, isLoading } = useNotifications();
  const { data: unreadData } = useUnreadNotificationsCount();
  const { mutateAsync: markRead } = useMarkNotificationRead();
  const { mutateAsync: markAllRead, isPending: isMarkingAll } = useMarkAllNotificationsRead();

  const unreadCount = unreadData?.count ?? 0;

  const handleNotificationClick = async (notif: AppNotification) => {
    try {
      if (!notif.readAt) {
        await markRead(notif.notificationId);
      }
    } catch {
      // Non-blocking
    }

    setOpen(false);

    const isTask =
      notif.eventType === 'INVENTORY_TASK_AVAILABLE' ||
      notif.eventType === 'INVENTORY_COUNT_REQUIRED' ||
      notif.eventType === 'INVENTORY_THIRD_COUNT_REQUIRED' ||
      notif.eventType === 'TASK';

    const isAdjudication =
      notif.eventType === 'INVENTORY_ADJUDICATION_ASSIGNED' ||
      notif.eventType === 'INVENTORY_ADJUDICATION_REQUIRED';

    if (notif.payload?.taskId) {
      router.push(`/inventory/tasks/${notif.payload.taskId}`);
    } else if (isAdjudication && notif.payload?.unitId) {
      router.push(`/inventory/adjudicate/${notif.payload.unitId}`);
    } else if (isTask) {
      router.push('/inventory/tasks');
    } else if (notif.payload?.unitId) {
      router.push(`/inventory/adjudicate/${notif.payload.unitId}`);
    } else if (notif.payload?.inventoryId) {
      router.push(`/inventory/${notif.payload.inventoryId}`);
    } else {
      router.push('/inventory/tasks');
    }
  };


  return (
    <DropdownMenu open={open} onOpenChange={setOpen}>
      <DropdownMenuTrigger
        aria-label="Notifications"
        className="relative p-2 rounded-[3px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#383330] border border-transparent hover:border-[#3f3a36] transition-colors cursor-pointer outline-none focus:ring-1 focus:ring-[#10b981]"
      >
        <Bell className="w-4 h-4" />
        {unreadCount > 0 && (
          <span className="absolute -top-0.5 -right-0.5 min-w-[17px] h-[17px] px-1 bg-[#10b981] text-[#1f1b18] text-[10px] font-bold rounded-full flex items-center justify-center font-mono shadow-sm animate-pulse">
            {unreadCount > 9 ? '9+' : unreadCount}
          </span>
        )}
      </DropdownMenuTrigger>

      <DropdownMenuContent
        align="end"
        className="w-80 sm:w-96 bg-[#26221f] border border-[#3f3a36] rounded-[4px] p-0 shadow-xl text-[#f7f5f0] z-50 overflow-hidden"
      >
        {/* Header */}
        <div className="p-3 border-b border-[#3f3a36] flex items-center justify-between bg-[#2f2a26]">
          <div className="flex items-center gap-2">
            <Bell className="w-3.5 h-3.5 text-[#10b981]" />
            <span className="text-xs font-semibold uppercase tracking-wider text-[#f7f5f0]">
              Notifications
            </span>
            {unreadCount > 0 && (
              <span className="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/40">
                {unreadCount} non lue(s)
              </span>
            )}
          </div>

          {unreadCount > 0 && (
            <button
              type="button"
              disabled={isMarkingAll}
              onClick={async (e) => {
                e.preventDefault();
                await markAllRead();
              }}
              className="text-[11px] text-[#aea69c] hover:text-[#10b981] flex items-center gap-1 cursor-pointer transition-colors"
            >
              <CheckCheck className="w-3 h-3" />
              <span>Tout marquer lu</span>
            </button>
          )}
        </div>

        {/* Notifications List */}
        <div className="max-h-80 overflow-y-auto divide-y divide-[#383330]">
          {isLoading ? (
            <div className="p-6 text-center text-xs text-[#aea69c] flex items-center justify-center gap-2">
              <Loader2 className="w-4 h-4 animate-spin" />
              <span>Chargement des alertes...</span>
            </div>
          ) : !notifications || notifications.length === 0 ? (
            <div className="p-8 text-center space-y-1.5">
              <Inbox className="w-6 h-6 text-[#5c544d] mx-auto" />
              <p className="text-xs text-[#aea69c]">Aucune notification pour le moment.</p>
              <p className="text-[11px] text-[#6a625b]">
                Vous recevrez une alerte dès qu'un autre compteur termine son unité de comptage.
              </p>
            </div>
          ) : (
            notifications.map((n) => {
              const isUnread = !n.readAt;
              const hasLink = !!(n.payload?.taskId || n.payload?.inventoryId);

              return (
                <div
                  key={n.notificationId}
                  onClick={() => handleNotificationClick(n)}
                  className={`p-3 transition-colors cursor-pointer flex items-start gap-2.5 ${
                    isUnread ? 'bg-[#10b981]/10 hover:bg-[#10b981]/15' : 'hover:bg-[#2f2a26]'
                  }`}
                >
                  <div className="mt-1 shrink-0">
                    <span
                      className={`block w-2 h-2 rounded-full ${
                        isUnread ? 'bg-[#10b981]' : 'bg-[#5c544d]'
                      }`}
                    />
                  </div>

                  <div className="flex-1 min-w-0 space-y-1">
                    <div className="flex items-center justify-between gap-1">
                      <span className="text-xs font-semibold text-[#f7f5f0] truncate block">
                        {n.payload?.title || 'Notification d’inventaire'}
                      </span>
                      <span className="text-[10px] font-mono text-[#8a8075] shrink-0">
                        {new Date(n.createdAt).toLocaleTimeString([], {
                          hour: '2-digit',
                          minute: '2-digit',
                        })}
                      </span>
                    </div>

                    <p className="text-[11px] text-[#aea69c] leading-relaxed">
                      {n.payload?.message}
                    </p>

                    {hasLink && (
                      <div className="pt-0.5 flex items-center gap-1 text-[10px] font-mono text-[#10b981]">
                        <span>Cliquer pour ouvrir la tâche</span>
                        <ExternalLink className="w-2.5 h-2.5" />
                      </div>
                    )}
                  </div>
                </div>
              );
            })
          )}
        </div>
      </DropdownMenuContent>
    </DropdownMenu>
  );
}
</file>

<file path="frontend/src/components/stock/CreateStockModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { createStockSchema, CreateStockFormValues } from '@/schemas/stock.schema';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import {
  X,
  Plus,
  Loader2,
  ShieldAlert,
  Warehouse,
  AlertCircle,
  Database,
} from 'lucide-react';

interface CreateStockModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function CreateStockModal({ isOpen, onClose, onSuccess }: CreateStockModalProps) {
  const api = useApi();
  const { canCreateStock, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [isSubmittingManual, setIsSubmittingManual] = useState(false);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<CreateStockFormValues>({
    resolver: zodResolver(createStockSchema),
    defaultValues: {
      stockName: '',
      stockStatus: 'ACTIVE',
    },
    mode: 'onChange',
  });

  if (!isOpen) return null;

  const onSubmit = async (values: CreateStockFormValues) => {
    setServerError(null);

    if (!canCreateStock) {
      setServerError(
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne dispose pas de la permission requise pour créer un stock.`,
      );
      return;
    }

    try {
      setIsSubmittingManual(true);
      await StockService.createStock(api, {
        stockName: values.stockName.trim(),
        stockStatus: values.stockStatus,
      });

      reset();
      if (onSuccess) onSuccess();
      onClose();
    } catch (err: unknown) {
      setServerError(getErrorMessage(err, 'Erreur lors de la création du stock'));
    } finally {
      setIsSubmittingManual(false);
    }
  };

  const isBusy = isSubmitting || isSubmittingManual;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#111]/40 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        className="relative w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden transform transition-all"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        {/* Modal Header */}
        <div className="flex items-center justify-between px-6 py-4.5 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] flex items-center justify-center shadow-2xs">
              <Warehouse className="w-5 h-5" />
            </div>
            <div>
              <h2 id="modal-title" className="text-base font-semibold text-white leading-tight">
                Nouveau Stock / Entrepôt
              </h2>
              <p className="text-xs text-white/80 mt-0.5">
                Enregistrer un nouvel emplacement de stockage principal
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            disabled={isBusy}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer disabled:opacity-50"
            aria-label="Fermer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Permission Advisory Banner */}
        {!canCreateStock && (
          <div className="px-6 py-3 bg-amber-950/50 border-b border-amber-500/50 flex items-start gap-2.5 text-xs text-amber-200">
            <ShieldAlert className="w-4 h-4 shrink-0 text-amber-300 mt-0.5" />
            <div>
              <span className="font-semibold">Droits insuffisants : </span>
              Votre profil ({roleName ?? 'Utilisateur'}) ne possède pas la permission de création de stock.
            </div>
          </div>
        )}

        {/* Server / Validation Error Feedback */}
        {serverError && (
          <div className="m-6 mb-0 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg text-xs text-rose-200 flex items-start gap-2.5 animate-in fade-in duration-200">
            <AlertCircle className="w-4 h-4 shrink-0 text-rose-300 mt-0.5" />
            <div className="flex-1 font-medium leading-relaxed">
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Field: stockName */}
          <div className="space-y-1.5">
            <label
              htmlFor="stockName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom du Stock <span className="text-rose-300">*</span></span>
              <span className="text-[11px] text-white/70">5 à 50 caractères</span>
            </label>
            <input
              id="stockName"
              type="text"
              disabled={isBusy}
              placeholder="ex: Stock Principal Yacine, Entrepôt Ouest..."
              className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                errors.stockName
                  ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                  : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
              }`}
              {...register('stockName')}
            />
            {errors.stockName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockName.message}
              </p>
            )}
          </div>

          {/* Field: stockStatus */}
          <div className="space-y-1.5">
            <label
              htmlFor="stockStatus"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Statut opérationnel</span>
              <span className="text-[11px] text-white/70">Table StockStatus</span>
            </label>
            <select
              id="stockStatus"
              disabled={isBusy}
              className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20"
              {...register('stockStatus')}
            >
              <option value="ACTIVE" className="bg-[#2b2622] text-white">ACTIVE (En activité)</option>
              <option value="INACTIVE" className="bg-[#2b2622] text-white">INACTIVE (En pause)</option>
              <option value="ARCHIVED" className="bg-[#2b2622] text-white">ARCHIVED (Archivé)</option>
            </select>
          </div>


          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isBusy}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isBusy || !canCreateStock}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isBusy ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Plus className="w-4 h-4" />
                  <span>Créer l’emplacement</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/stock/StockDetailModal.tsx">
'use client';

import { useQuery } from '@tanstack/react-query';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import {
  X,
  Warehouse,
  Layers,
  Database,
  CheckCircle2,
  AlertTriangle,
  Archive,
  Loader2,
  ArrowUpRight,
} from 'lucide-react';
import Link from 'next/link';

interface StockDetailModalProps {
  stockId: string | null;
  isOpen: boolean;
  onClose: () => void;
}

export function StockDetailModal({ stockId, isOpen, onClose }: StockDetailModalProps) {
  const api = useApi();

  const { data: stock, isLoading, error } = useQuery({
    queryKey: ['stock-detail', stockId],
    queryFn: () => (stockId ? StockService.getStockById(api, stockId) : null),
    enabled: isOpen && !!stockId,
    staleTime: 10 * 1000,
  });

  if (!isOpen || !stockId) return null;

  const statusName = stock?.stockStatus?.stockStatusName || 'ACTIVE';

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#111]/40 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        className="relative w-full max-w-2xl bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden transform transition-all max-h-[90vh] flex flex-col text-left"
        role="dialog"
        aria-modal="true"
      >
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4.5 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] flex items-center justify-center shadow-2xs">
              <Warehouse className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-base font-semibold text-white leading-tight">
                  {stock?.stockName ?? 'Détails du Stock'}
                </h2>
                {stock && (
                  <span
                    className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wide uppercase ${
                      statusName === 'ACTIVE'
                        ? 'bg-emerald-950/40 text-emerald-200 border border-emerald-400/40'
                        : statusName === 'INACTIVE'
                        ? 'bg-amber-950/40 text-amber-200 border border-amber-400/40'
                        : 'bg-slate-900/40 text-slate-200 border border-slate-400/40'
                    }`}
                  >
                    {statusName === 'ACTIVE' && <CheckCircle2 className="w-3 h-3" />}
                    {statusName === 'INACTIVE' && <AlertTriangle className="w-3 h-3" />}
                    {statusName === 'ARCHIVED' && <Archive className="w-3 h-3" />}
                    {statusName}
                  </span>
                )}
              </div>
              <p className="text-xs text-white/80 mt-0.5 font-mono">
                UUID : {stockId}
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer"
            aria-label="Fermer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Modal Content */}
        <div className="p-6 overflow-y-auto space-y-6 flex-1 text-left">
          {isLoading ? (
            <div className="py-12 flex flex-col items-center justify-center gap-2 text-sm text-white/80">
              <Loader2 className="w-6 h-6 animate-spin text-white" />
              <span>Chargement des détails du stock...</span>
            </div>
          ) : error ? (
            <div className="p-4 rounded-lg bg-rose-950/50 border border-rose-500/50 text-rose-200 text-xs">
              Impossible de charger les données de ce stock.
            </div>
          ) : stock ? (
            <>
              {/* Summary Metric Cards */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className="p-4 rounded-lg bg-[#2b2622]/60 border border-[#3f3a36] space-y-1 text-white">
                  <div className="flex items-center justify-between text-xs text-white/85">
                    <span>Emplacements associés</span>
                    <Layers className="w-4 h-4 text-white" />
                  </div>
                  <div className="text-2xl font-bold text-white">
                    {stock._count?.shelves ?? stock.shelves?.length ?? 0}
                  </div>
                  <p className="text-[11px] text-white/80">
                    Emplacements physiques rattachés
                  </p>
                </div>

                <div className="p-4 rounded-lg bg-[#2b2622]/60 border border-[#3f3a36] space-y-1 text-white">
                  <div className="flex items-center justify-between text-xs text-white/85">
                    <span>Statut</span>
                    <Database className="w-4 h-4 text-white" />
                  </div>
                  <div className="text-sm font-semibold text-white flex items-center gap-1.5 pt-1">
                    <span className="w-2 h-2 rounded-full bg-emerald-400" />
                    <span>{statusName}</span>
                  </div>
                </div>
              </div>

              {/* Associated Shelves Section */}
              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <h3 className="text-xs font-semibold uppercase tracking-wider text-white flex items-center gap-1.5">
                    <Layers className="w-3.5 h-3.5 text-white" />
                    Emplacements contenus dans ce stock ({stock.shelves?.length ?? 0})
                  </h3>
                  <Link
                    href="/shelves"
                    className="text-xs text-white hover:text-white/80 underline flex items-center gap-1 font-medium"
                  >
                    <span>Voir tous les emplacements</span>
                    <ArrowUpRight className="w-3.5 h-3.5" />
                  </Link>
                </div>

                {(!stock.shelves || stock.shelves.length === 0) ? (
                  <div className="p-6 text-center border border-dashed border-[#3f3a36] rounded-lg text-xs text-white/80 bg-[#2b2622]/30">
                    Aucun emplacement rattaché pour le moment à cet entrepôt.
                  </div>
                ) : (
                  <div className="border border-[#3f3a36] rounded-lg overflow-hidden max-h-60 overflow-y-auto bg-[#2b2622]/60">
                    <table className="w-full text-xs text-left">
                      <thead className="bg-[#2b2622] text-white font-medium border-b border-[#3f3a36]">
                        <tr>
                          <th className="px-3 py-2">Nom de l&apos;emplacement</th>
                          <th className="px-3 py-2 text-right">Quantité d&apos;articles</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-[#455268]">
                        {stock.shelves.map((sh) => (
                          <tr key={sh.shelfId} className="hover:bg-white/10 transition-colors">
                            <td className="px-3 py-2.5 font-medium text-white">
                              {sh.shelfName || 'Emplacement sans nom'}
                            </td>
                            <td className="px-3 py-2.5 text-right font-mono text-white/90">
                              <span className="px-2 py-0.5 rounded-full bg-[#2b2622] border border-[#3f3a36] text-white">
                                {sh.shelfQuantity} {sh.shelfQuantity > 1 ? 'unités' : 'unité'}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            </>
          ) : null}
        </div>

        {/* Footer */}
        <div className="px-6 py-3.5 bg-[#2b2622] border-t border-[#3f3a36] flex items-center justify-end">
          <button
            type="button"
            onClick={onClose}
            className="px-4.5 py-2 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-xs font-medium rounded-lg transition-colors cursor-pointer"
          >
            Fermer
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/stock/UpdateStockModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { updateStockSchema, UpdateStockFormValues } from '@/schemas/stock.schema';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import { Stock } from '@/types/stock';
import {
  X,
  Save,
  Loader2,
  ShieldAlert,
  Warehouse,
  AlertCircle,
} from 'lucide-react';

interface UpdateStockModalProps {
  stock: Stock | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateStockModal(props: UpdateStockModalProps) {
  if (!props.isOpen || !props.stock) return null;

  return (
    <UpdateStockModalContent
      key={`${props.stock.stockId}:${props.stock.stockName}:${props.stock.stockStatus?.stockStatusName ?? ''}`}
      {...props}
    />
  );
}

function UpdateStockModalContent({ stock, isOpen, onClose, onSuccess }: UpdateStockModalProps) {
  const api = useApi();
  const { canUpdateStock, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [isSubmittingManual, setIsSubmittingManual] = useState(false);

  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<UpdateStockFormValues>({
    resolver: zodResolver(updateStockSchema),
    defaultValues: {
      stockName: stock?.stockName ?? '',
      stockStatus: stock?.stockStatus?.stockStatusName ?? 'ACTIVE',
    },
    mode: 'onChange',
  });

  if (!isOpen || !stock) return null;

  const onSubmit = async (values: UpdateStockFormValues) => {
    setServerError(null);

    if (!canUpdateStock) {
      setServerError(
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne dispose pas de la permission requise pour modifier ce stock.`,
      );
      return;
    }

    try {
      setIsSubmittingManual(true);
      await StockService.updateStock(api, stock.stockId, {
        stockName: values.stockName?.trim(),
        stockStatus: values.stockStatus,
      });

      if (onSuccess) onSuccess();
      onClose();
    } catch (err: unknown) {
      setServerError(getErrorMessage(err, 'Erreur lors de la modification du stock'));
    } finally {
      setIsSubmittingManual(false);
    }
  };

  const isBusy = isSubmitting || isSubmittingManual;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#111]/40 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        className="relative w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden transform transition-all"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-update-stock-title"
      >
        {/* Modal Header */}
        <div className="flex items-center justify-between px-6 py-4.5 border-b border-[#3f3a36] bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] flex items-center justify-center shadow-2xs">
              <Warehouse className="w-5 h-5" />
            </div>
            <div>
              <h2 id="modal-update-stock-title" className="text-base font-semibold text-white leading-tight">
                Modifier le Stock
              </h2>
              <p className="text-xs text-white/80 mt-0.5">
                ID : <span className="font-mono text-[11px] text-white">{stock.stockId.slice(0, 8)}...</span>
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            disabled={isBusy}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer disabled:opacity-50"
            aria-label="Fermer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Permission Advisory Banner */}
        {!canUpdateStock && (
          <div className="px-6 py-3 bg-amber-950/50 border-b border-amber-500/50 flex items-start gap-2.5 text-xs text-amber-200">
            <ShieldAlert className="w-4 h-4 shrink-0 text-amber-300 mt-0.5" />
            <div>
              <span className="font-semibold">Droits insuffisants : </span>
              Votre profil ({roleName ?? 'Utilisateur'}) ne possède pas la permission de modification de stock.
            </div>
          </div>
        )}

        {/* Server / Validation Error Feedback */}
        {serverError && (
          <div className="m-6 mb-0 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg text-xs text-rose-200 flex items-start gap-2.5 animate-in fade-in duration-200">
            <AlertCircle className="w-4 h-4 shrink-0 text-rose-300 mt-0.5" />
            <div className="flex-1 font-medium leading-relaxed">
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Field: stockName */}
          <div className="space-y-1.5">
            <label
              htmlFor="editStockName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom du Stock <span className="text-rose-300">*</span></span>
              <span className="text-[11px] text-white/70">5 à 50 caractères</span>
            </label>
            <input
              id="editStockName"
              type="text"
              disabled={isBusy}
              className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                errors.stockName
                  ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                  : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
              }`}
              {...register('stockName')}
            />
            {errors.stockName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockName.message}
              </p>
            )}
          </div>

          {/* Field: stockStatus */}
          <div className="space-y-1.5">
            <label
              htmlFor="editStockStatus"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Statut opérationnel</span>
              <span className="text-[11px] text-white/70">Table StockStatus</span>
            </label>
            <select
              id="editStockStatus"
              disabled={isBusy}
              className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20"
              {...register('stockStatus')}
            >
              <option value="ACTIVE" className="bg-[#2b2622] text-white">ACTIVE (En activité)</option>
              <option value="INACTIVE" className="bg-[#2b2622] text-white">INACTIVE (En pause)</option>
              <option value="ARCHIVED" className="bg-[#2b2622] text-white">ARCHIVED (Archivé)</option>
            </select>
          </div>

          {/* Associated Shelves Count info */}
          <div className="p-3 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg flex items-center justify-between text-xs text-white">
            <span className="text-white/85">Emplacements rattachés à ce stock :</span>
            <span className="px-2 py-0.5 rounded-full bg-[#2b2622] border border-[#3f3a36] text-white font-semibold text-xs">
              {stock._count?.shelves ?? stock.shelves?.length ?? 0} emplacements
            </span>
          </div>

          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isBusy}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isBusy || !canUpdateStock}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isBusy ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Save className="w-4 h-4" />
                  <span>Enregistrer les modifications</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/users/CreateRoleModal.tsx">
'use client';

import { useState, useMemo } from 'react';
import { X, ShieldCheck, Check, Loader2, AlertCircle } from 'lucide-react';
import { CreateRoleInput } from '@/types/user-role';

interface CreateRoleModalProps {
  isOpen: boolean;
  onClose: () => void;
  availablePermissions: string[];
  onSubmitRole: (input: CreateRoleInput) => Promise<void>;
  isSubmitting?: boolean;
}

const PERMISSION_GROUPS: {
  id: string;
  title: string;
  icon: string;
  permissions: { name: string; label: string }[];
}[] = [
  {
    id: 'equipment',
    title: 'Articles & Mouvements',
    icon: '⚡',
    permissions: [
      { name: 'equipment.read', label: 'Consulter les articles' },
      { name: 'equipment.create', label: 'Créer de nouveaux articles' },
      { name: 'equipment.update', label: 'Modifier les articles' },
      { name: 'equipment.delete', label: 'Supprimer des articles' },
      { name: 'movement.read', label: 'Consulter l’historique des mouvements' },
      { name: 'movement.create', label: 'Effectuer des transferts/mouvements' },
    ],
  },
  {
    id: 'serial',
    title: 'Numéros de Série',
    icon: '🔢',
    permissions: [
      { name: 'serial-number.read', label: 'Consulter les numéros de série' },
      { name: 'serial-number.create', label: 'Ajouter des numéros de série' },
      { name: 'serial-number.update', label: 'Mettre à jour les numéros de série' },
      { name: 'serial-number.delete', label: 'Supprimer des numéros de série' },
    ],
  },
  {
    id: 'shelves',
    title: 'Emplacements & Rangement',
    icon: '🗄️',
    permissions: [
      { name: 'shelf.read', label: 'Consulter les emplacements' },
      { name: 'shelf.create', label: 'Créer de nouveaux emplacements' },
      { name: 'shelf.update', label: 'Modifier les emplacements' },
      { name: 'shelf.delete', label: 'Supprimer des emplacements' },
    ],
  },
  {
    id: 'stocks',
    title: 'Gestion des Stocks',
    icon: '🏭',
    permissions: [
      { name: 'stock.read', label: 'Consulter les stocks' },
      { name: 'stock.create', label: 'Créer des zones de stock' },
      { name: 'stock.update', label: 'Modifier les zones de stock' },
      { name: 'stock.delete', label: 'Supprimer des zones de stock' },
    ],
  },
  {
    id: 'inventory',
    title: 'Inventaires & Réconciliations',
    icon: '📋',
    permissions: [
      { name: 'inventory.read', label: 'Consulter les inventaires et rapports' },
      { name: 'inventory.create', label: 'Créer de nouveaux projets d’inventaire' },
      { name: 'inventory.launch', label: 'Lancer et démarrer un inventaire' },
      { name: 'inventory.count', label: 'Contrôleur d’inventaire (Comptage initial et arbitrage en cas de divergence)' },
      { name: 'inventory.finalize', label: 'Clôturer et ajuster le stock final' },
      { name: 'inventory.delete', label: 'Supprimer un inventaire' },
    ],
  },
  {
    id: 'admin',
    title: 'Administration Système',
    icon: '🛡️',
    permissions: [
      { name: 'dashboard.read', label: 'Consulter le tableau de bord exécutif (Dashboard)' },
      { name: 'user.manage', label: 'Gérer les comptes utilisateurs et statuts' },
      { name: 'role.manage', label: 'Créer des rôles et assigner des permissions' },
    ],
  },
];

export function CreateRoleModal({
  isOpen,
  onClose,
  availablePermissions,
  onSubmitRole,
  isSubmitting = false,
}: CreateRoleModalProps) {
  const [roleName, setRoleName] = useState('');
  const [selectedPermissions, setSelectedPermissions] = useState<string[]>([]);
  const [validationError, setValidationError] = useState<string | null>(null);

  const groupsToDisplay = useMemo(() => {
    const knownPerms = new Set(
      PERMISSION_GROUPS.flatMap((g) => g.permissions.map((p) => p.name)),
    );
    // Exclude inventory.adjudicate as it is internally bundled with inventory.count (Contrôleur)
    const extraPerms = (availablePermissions || []).filter(
      (p) => !knownPerms.has(p) && p !== 'inventory.adjudicate',
    );

    if (extraPerms.length === 0) {
      return PERMISSION_GROUPS;
    }

    return [
      ...PERMISSION_GROUPS,
      {
        id: 'other',
        title: 'Autres Permissions',
        icon: '⚙️',
        permissions: extraPerms.map((name) => ({
          name,
          label: name,
        })),
      },
    ];
  }, [availablePermissions]);

  if (!isOpen) return null;

  const handleTogglePermission = (permName: string) => {
    setSelectedPermissions((prev) =>
      prev.includes(permName)
        ? prev.filter((p) => p !== permName)
        : [...prev, permName],
    );
  };

  const handleToggleGroup = (groupPerms: string[]) => {
    const allSelected = groupPerms.every((p) => selectedPermissions.includes(p));
    if (allSelected) {
      setSelectedPermissions((prev) =>
        prev.filter((p) => !groupPerms.includes(p)),
      );
    } else {
      setSelectedPermissions((prev) =>
        Array.from(new Set([...prev, ...groupPerms])),
      );
    }
  };

  const handleSelectAll = () => {
    const all = groupsToDisplay.flatMap((g) => g.permissions.map((p) => p.name));
    setSelectedPermissions(all);
  };

  const handleDeselectAll = () => {
    setSelectedPermissions([]);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setValidationError(null);

    const trimmed = roleName.trim();
    if (!trimmed) {
      setValidationError('Veuillez renseigner un nom pour le rôle.');
      return;
    }
    if (selectedPermissions.length === 0) {
      setValidationError('Veuillez cocher au moins une permission pour ce rôle.');
      return;
    }

    try {
      const finalPermissions = new Set(selectedPermissions);
      if (finalPermissions.has('inventory.count')) {
        finalPermissions.add('inventory.adjudicate');
      } else {
        finalPermissions.delete('inventory.adjudicate');
      }

      await onSubmitRole({
        roleName: trimmed.toUpperCase(),
        permissions: Array.from(finalPermissions),
      });
      setRoleName('');
      setSelectedPermissions([]);
      onClose();
    } catch {
      // Handled by mutation toast
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-in fade-in duration-150">
      <div className="relative w-full max-w-2xl bg-[#383330] rounded-[4px] shadow-2xl border border-[#3f3a36] flex flex-col max-h-[90vh] overflow-hidden text-[#f7f5f0]">
        {/* Header */}
        <div className="px-6 py-4 border-b border-[#3f3a36] flex items-center justify-between bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-[3px] bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] flex items-center justify-center">
              <ShieldCheck className="w-4 h-4" />
            </div>
            <div>
              <h2 className="text-sm font-medium text-[#f7f5f0]">
                Créer un Nouveau Rôle
              </h2>
              <p className="text-xs text-[#c9c0ad]">
                Définissez un profil d&apos;autorisation RBAC et associez les permissions.
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-1.5 rounded-[3px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#383330] transition-colors"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Content Form */}
        <form onSubmit={handleSubmit} className="flex flex-col flex-1 overflow-hidden">
          <div className="p-6 overflow-y-auto space-y-5">
            {validationError && (
              <div className="p-3 bg-[#2d1616] border border-[#451e1e] rounded-[3px] text-xs text-[#ef4444] flex items-center gap-2">
                <AlertCircle className="w-4 h-4 shrink-0" />
                <span>{validationError}</span>
              </div>
            )}

            {/* Role Name Input */}
            <div>
              <label
                htmlFor="roleName"
                className="block text-[11px] font-mono uppercase tracking-wider text-[#aea69c] mb-1.5"
              >
                Nom du Rôle <span className="text-[#ef4444]">*</span>
              </label>
              <input
                id="roleName"
                type="text"
                value={roleName}
                onChange={(e) => setRoleName(e.target.value)}
                placeholder="Ex: MAGASINIER, AUDITEUR, SUPERVISEUR..."
                className="w-full px-3 py-2 text-xs font-mono bg-[#2b2622] text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] focus:outline-none focus:border-[#f7f5f0] transition-all placeholder:text-[#aea69c]"
                autoFocus
              />
              <p className="text-[11px] text-[#aea69c] mt-1 font-mono">
                Convention : majuscules normalisées (ex: TECHNICIAN, ADMIN).
              </p>
            </div>

            {/* Permissions Selection Header */}
            <div>
              <div className="flex items-center justify-between mb-2">
                <label className="block text-[11px] font-mono uppercase tracking-wider text-[#aea69c]">
                  Permissions ({selectedPermissions.length} cochée
                  {selectedPermissions.length > 1 ? 's' : ''})
                </label>
                <div className="flex items-center gap-2 text-xs font-mono">
                  <button
                    type="button"
                    onClick={handleSelectAll}
                    className="text-[11px] text-[#f7f5f0] hover:underline"
                  >
                    Tout sélectionner
                  </button>
                  <span className="text-[#3f3a36]">•</span>
                  <button
                    type="button"
                    onClick={handleDeselectAll}
                    className="text-[11px] text-[#aea69c] hover:underline"
                  >
                    Tout décocher
                  </button>
                </div>
              </div>

              {/* Grouped Permissions Grid */}
              <div className="space-y-3 border border-[#3f3a36] rounded-[3px] p-3 bg-[#2b2622]">
                {groupsToDisplay.map((group) => {
                  const groupPermNames = group.permissions.map((p) => p.name);
                  const isAllGroupSelected = groupPermNames.every((p) =>
                    selectedPermissions.includes(p),
                  );
                  const isSomeGroupSelected =
                    !isAllGroupSelected &&
                    groupPermNames.some((p) => selectedPermissions.includes(p));

                  return (
                    <div
                      key={group.id}
                      className="bg-[#383330] rounded-[3px] border border-[#3f3a36] p-3"
                    >
                      {/* Group Header */}
                      <div className="flex items-center justify-between pb-2 mb-2 border-b border-[#3f3a36]">
                        <div className="flex items-center gap-2">
                          <span className="text-xs">{group.icon}</span>
                          <span className="text-xs font-medium text-[#f7f5f0]">
                            {group.title}
                          </span>
                        </div>
                        <button
                          type="button"
                          onClick={() => handleToggleGroup(groupPermNames)}
                          className={`text-[10px] font-mono px-2 py-0.5 rounded-[2px] transition-colors border ${
                            isAllGroupSelected
                              ? 'bg-[#2b2622] text-[#f7f5f0] border-[#f7f5f0]'
                              : isSomeGroupSelected
                                ? 'bg-[#2b2622] text-[#dad2c1] border-[#3f3a36]'
                                : 'text-[#aea69c] border-transparent hover:border-[#3f3a36]'
                          }`}
                        >
                          {isAllGroupSelected
                            ? 'Tout désélectionner'
                            : 'Tout cocher'}
                        </button>
                      </div>

                      {/* Group Checkboxes */}
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        {group.permissions.map((perm) => {
                          const isChecked = selectedPermissions.includes(perm.name);
                          return (
                            <label
                              key={perm.name}
                              className={`flex items-start gap-2.5 p-2 rounded-[2px] cursor-pointer text-xs transition-colors border ${
                                isChecked
                                  ? 'bg-[#2b2622] border-[#f7f5f0] text-[#f7f5f0]'
                                  : 'hover:bg-[#2b2622] border-[#3f3a36]/60 text-[#c9c0ad]'
                              }`}
                            >
                              <div
                                className={`w-3.5 h-3.5 rounded-[2px] mt-0.5 flex items-center justify-center border transition-colors shrink-0 ${
                                  isChecked
                                    ? 'bg-[#f7f5f0] border-[#f7f5f0] text-[#2b2622]'
                                    : 'border-[#3f3a36] bg-[#2b2622]'
                                }`}
                              >
                                {isChecked && <Check className="w-2.5 h-2.5 stroke-[3]" />}
                              </div>
                              <div className="flex flex-col">
                                <span className="font-normal text-xs leading-tight text-[#f7f5f0]">
                                  {perm.label}
                                </span>
                                <span className="font-mono text-[10px] text-[#aea69c]">
                                  {perm.name}
                                </span>
                              </div>
                            </label>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Footer Actions */}
          <div className="px-6 py-3 border-t border-[#3f3a36] bg-[#2b2622] flex items-center justify-end gap-2.5">
            <button
              type="button"
              onClick={onClose}
              disabled={isSubmitting}
              className="px-3 py-1.5 text-xs font-medium text-[#c9c0ad] hover:text-[#f7f5f0] hover:bg-[#383330] rounded-[3px] transition-colors cursor-pointer"
            >
              Annuler
            </button>
            <button
              type="submit"
              disabled={isSubmitting}
              className="flex items-center gap-2 px-4 py-1.5 text-xs font-medium text-[#2b2622] bg-[#f7f5f0] hover:bg-[#dad2c1] rounded-[3px] transition-colors shadow-2xs disabled:opacity-50 cursor-pointer"
            >
              {isSubmitting ? (
                <>
                  <Loader2 className="w-3.5 h-3.5 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <ShieldCheck className="w-3.5 h-3.5" />
                  <span>Créer le rôle ({selectedPermissions.length})</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
