<file path="src/inventory/inventory.service.ts">
import {
  BadRequestException,
  ForbiddenException,
  Injectable,
  Logger,
  NotFoundException,
} from '@nestjs/common';

import type { Prisma } from '../generated/prisma/client.js';
import { PrismaService } from '../prisma/prisma.service.js';
import { NotificationsService } from '../notifications/notifications.service.js';

import {
  type AdjudicateDTO,
  type CreateInventoryDTO,
  createInventorySchema,
  type PaginationDTO,
  paginationSchema,
  type ResolveIssueDTO,
  resolveIssueSchema,
  type SaveDraftDTO,
  saveDraftSchema,
  type SubmitTaskDTO,
  submitTaskSchema,
} from './dto/index.js';

type AttemptPurpose =
  | 'PRIMARY_1'
  | 'PRIMARY_2'
  | 'FINAL_RECOUNT';

type UnitReconciliationStatus =
  | 'PENDING'
  | 'PRIMARY_MATCH'
  | 'THIRD_REQUIRED'
  | 'THIRD_RESOLVED';

type CanonicalStandardValue = {
  equipmentId: string;
  shelfId: string;
  quantity: number;
};

type CanonicalSerialValue = {
  serialCode: string;
  serialNumberId: string | null;
  equipmentId: string;
  shelfId: string | null;
};

type CanonicalAttempt = {
  standard: Map<string, CanonicalStandardValue>;
  serials: Map<string, CanonicalSerialValue>;
  unknown: Set<string>;
};

type ReportCell = {
  quantity: number;
  serialNumberCode: string | null;
  serialNumberId: string | null;
  equipmentId: string | null;
  equipmentName: string | null;
  shelfId: string | null;
  shelfName: string | null;
  isUnexpected: boolean;
  notes: string[];
};

const RECONCILED_STATUSES: UnitReconciliationStatus[] = [
  'PRIMARY_MATCH',
  'THIRD_RESOLVED',
];

const NON_LOCKING_INVENTORY_STATUSES = [
  'DRAFT',
  'FINALIZED',
  'CANCELLED',
] as const;

const SQL_INT_MAX = 2_147_483_647;

@Injectable()
export class InventoryService {
  private readonly logger = new Logger(InventoryService.name);

  constructor(
    private readonly prisma: PrismaService,
    private readonly notificationsService: NotificationsService,
  ) {}

  // --------------------------------------------------------------------------
  // Basic CRUD
  // --------------------------------------------------------------------------

  async getInventories(
    pagination: PaginationDTO,
    filterUserId?: string,
  ) {
    const { page, limit } = paginationSchema.parse(
      pagination ?? {},
    );

    const skip = (page - 1) * limit;

    const where: Prisma.InventoryWhereInput =
      filterUserId
        ? {
            Inventory_User: {
              some: {
                userId: filterUserId,
              },
            },
          }
        : {};

    const [inventories, totalInventories] =
      await Promise.all([
        this.prisma.inventory.findMany({
          where,
          skip,
          take: limit,
          orderBy: [
            { createdAt: 'desc' },
            { inventoryId: 'desc' },
          ],
          include: {
            Inventory_User: {
              include: {
                User: {
                  select: {
                    userId: true,
                    userName: true,
                    userEmail: true,
                  },
                },
              },
              orderBy: { sequence: 'asc' },
            },
            workUnits: {
              select: {
                unitId: true,
                unitOrder: true,
                status: true,
                equipmentId: true,
                shelfId: true,
                reconciliationStatus: true,
                acceptedAttemptId: true,
                reconciledAt: true,
              },
              orderBy: { unitOrder: 'asc' },
            },
            _count: {
              select: {
                investigationIssues: true,
              },
            },
          },
        }),
        this.prisma.inventory.count({ where }),
      ]);

    return {
      inventories,
      totalInventories,
      totalPages:
        Math.ceil(totalInventories / limit) || 1,
      currentPage: page,
      limit,
    };
  }

  async getInventoryById(
    inventoryId: string,
  ) {
    const inventory =
      await this.prisma.inventory.findUnique({
        where: { inventoryId },
        include: {
          Inventory_User: {
            include: {
              User: {
                select: {
                  userId: true,
                  userName: true,
                  userEmail: true,
                },
              },
            },
            orderBy: { sequence: 'asc' },
          },
          workUnits: {
            include: {
              acceptedAttempt: {
                select: {
                  attemptId: true,
                  sequence: true,
                  purpose: true,
                  status: true,
                  submittedAt: true,
                  assignedUserId: true,
                },
              },
              attempts: {
                include: {
                  assignedUser: {
                    select: {
                      userId: true,
                      userName: true,
                      userEmail: true,
                    },
                  },
                },
                orderBy: { sequence: 'asc' },
              },
            },
            orderBy: { unitOrder: 'asc' },
          },
          investigationIssues: {
            include: {
              equipment: {
                select: {
                  equipmentId: true,
                  equipmentName: true,
                },
              },
              serialNumber: {
                select: {
                  serialNumberId: true,
                  serialNumberCode: true,
                },
              },
              expectedShelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                },
              },
              finalObservedShelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                },
              },
              resolutionShelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                },
              },
              resolvedByUser: {
                select: {
                  userId: true,
                  userName: true,
                },
              },
            },
          },
        },
      });

    if (!inventory) {
      throw new NotFoundException(
        'Inventaire introuvable',
      );
    }

    return inventory;
  }

  async createInventory(
    dto: CreateInventoryDTO,
    creatorId: string,
  ) {
    const data = createInventorySchema.parse(dto);
    const policyVersion = data.policyVersion ?? 3;
    const users = data.users;

    if (
      policyVersion >= 2 &&
      users.length !== 3
    ) {
      throw new BadRequestException(
        "L'inventaire courant requiert exactement trois contrôleurs distincts.",
      );
    }

    const equipmentIds = [
      ...new Set(
        (data.equipmentIds ?? []).map((id) =>
          id.trim(),
        ),
      ),
    ];

    const shelfIds = [
      ...new Set(
        (data.shelfIds ?? []).map((id) =>
          id.trim(),
        ),
      ),
    ];

    return this.prisma.$transaction(async (tx) => {
      const userRecords = await tx.user.findMany({
        where: {
          userId: {
            in: users.map((item) => item.userId),
          },
        },
        include: {
          role: true,
        },
      });

      if (
        userRecords.length !== users.length
      ) {
        const found = new Set(
          userRecords.map((user) => user.userId),
        );

        const missing = users
          .map((item) => item.userId)
          .filter((id) => !found.has(id));

        throw new NotFoundException(
          `Utilisateur(s) introuvable(s): ${missing.join(', ')}`,
        );
      }

      if (
        data.typeInventory === 'ByEquipment'
      ) {
        const equipmentCount =
          await tx.equipment.count({
            where: {
              equipmentId: {
                in: equipmentIds,
              },
            },
          });

        if (
          equipmentCount !== equipmentIds.length
        ) {
          throw new NotFoundException(
            'Un ou plusieurs articles du périmètre sont introuvables.',
          );
        }
      }

      if (
        data.typeInventory === 'ByShelf'
      ) {
        const shelfCount =
          await tx.shelf.count({
            where: {
              shelfId: {
                in: shelfIds,
              },
            },
          });

        if (
          shelfCount !== shelfIds.length
        ) {
          throw new NotFoundException(
            'Un ou plusieurs emplacements du périmètre sont introuvables.',
          );
        }
      }

      const inventory =
        await tx.inventory.create({
          data: {
            title: data.title,
            typeInventory: data.typeInventory,
            status: 'DRAFT',
            policyVersion,
            creatorId: creatorId || null,
            equipmentScopeIds:
              equipmentIds.length
                ? JSON.stringify(equipmentIds)
                : null,
            shelfScopeIds:
              shelfIds.length
                ? JSON.stringify(shelfIds)
                : null,
            thirdCountRequired: false,
            finalResultSource: null,
          },
        });

      const userMap = new Map(
        userRecords.map((user) => [
          user.userId,
          user,
        ]),
      );

      const participants = users.map(
        (item, index) => {
          const responsibility =
            index === 0
              ? 'PRIMARY_COUNTER_1'
              : index === 1
                ? 'PRIMARY_COUNTER_2'
                : 'FINAL_CONTROLLER';

          const user = userMap.get(item.userId);

          return {
            inventoryId: inventory.inventoryId,
            userId: item.userId,
            sequence: index,
            responsibility:
              policyVersion >= 2
                ? responsibility
                : item.responsibility ??
                  responsibility,
            roleSnapshot:
              user?.role?.roleName ??
              'USER',
          };
        },
      );

      await tx.inventory_User.createMany({
        data: participants,
      });

      return inventory;
    });
  }

  // --------------------------------------------------------------------------
  // Shared movement / inventory race locks
  // --------------------------------------------------------------------------

  private async acquireResourceLocks(
    tx: Prisma.TransactionClient,
    equipmentIds: string[],
    shelfIds: string[],
    serialIds: string[] = [],
  ) {
    const resources = [
      ...equipmentIds.map(
        (id) =>
          `SOMIPHARM:EQUIPMENT:${id.toLowerCase()}`,
      ),
      ...shelfIds.map(
        (id) =>
          `SOMIPHARM:SHELF:${id.toLowerCase()}`,
      ),
      ...serialIds.map(
        (id) =>
          `SOMIPHARM:SERIAL:${id.toLowerCase()}`,
      ),
    ]
      .filter(
        (value, index, array) =>
          array.indexOf(value) === index,
      )
      .sort();

    for (const resource of resources) {
      const result = await tx.$queryRaw<
        Array<{ lockResult: number }>
      >`
        DECLARE @lockResult int;

        EXEC @lockResult =
          sys.sp_getapplock
            @Resource = ${resource},
            @LockMode = 'Exclusive',
            @LockOwner = 'Transaction',
            @LockTimeout = 10000;

        SELECT @lockResult AS lockResult;
      `;

      const lockResult = Number(
        result[0]?.lockResult,
      );

      if (
        !Number.isFinite(lockResult) ||
        lockResult < 0
      ) {
        throw new BadRequestException(
          'Une ressource de stock est occupée par une autre opération. Actualisez puis réessayez.',
        );
      }
    }
  }

  private async assertNoOtherActiveInventory(
    tx: Prisma.TransactionClient,
    inventoryId: string,
    equipmentIds: string[],
    shelfIds: string[],
  ) {
    const scope:
      Prisma.InventoryWorkUnitWhereInput[] = [];

    if (equipmentIds.length) {
      scope.push({
        equipmentId: {
          in: equipmentIds,
        },
      });
    }

    if (shelfIds.length) {
      scope.push({
        shelfId: {
          in: shelfIds,
        },
      });
    }

    if (!scope.length) {
      return;
    }

    const conflict =
      await tx.inventoryWorkUnit.findFirst({
        where: {
          OR: scope,
          inventory: {
            inventoryId: {
              not: inventoryId,
            },
            status: {
              notIn: [
                ...NON_LOCKING_INVENTORY_STATUSES,
              ],
            },
          },
        },
        select: {
          unitId: true,
          inventory: {
            select: {
              inventoryId: true,
              title: true,
              status: true,
            },
          },
        },
      });

    if (conflict) {
      throw new BadRequestException(
        `Le périmètre est déjà contrôlé par l'inventaire actif '${conflict.inventory.title ?? conflict.inventory.inventoryId}'.`,
      );
    }
  }

  // --------------------------------------------------------------------------
  // Launch
  // --------------------------------------------------------------------------

  async launchInventory(
    inventoryId: string,
  ) {
    return this.prisma.$transaction(
      async (tx) => {
        const inventory =
          await tx.inventory.findUnique({
            where: { inventoryId },
            include: {
              Inventory_User: {
                orderBy: {
                  sequence: 'asc',
                },
              },
            },
          });

        if (!inventory) {
          throw new NotFoundException(
            'Inventaire introuvable',
          );
        }

        if (
          inventory.status !== 'DRAFT'
        ) {
          throw new BadRequestException(
            'Seul un inventaire au statut DRAFT peut être lancé.',
          );
        }

        const participants =
          inventory.Inventory_User;

        if (
          participants.length !== 3
        ) {
          throw new BadRequestException(
            'Trois contrôleurs distincts doivent être préassignés avant le lancement.',
          );
        }

        const controller1 = participants[0];
        const controller2 = participants[1];

        const equipmentIds =
          this.parseScopeIds(
            inventory.equipmentScopeIds,
          );

        const shelfIds =
          this.parseScopeIds(
            inventory.shelfScopeIds,
          );

        if (
          inventory.typeInventory ===
            'ByEquipment' &&
          !equipmentIds.length
        ) {
          throw new BadRequestException(
            "Le périmètre article de l'inventaire est vide.",
          );
        }

        if (
          inventory.typeInventory ===
            'ByShelf' &&
          !shelfIds.length
        ) {
          throw new BadRequestException(
            "Le périmètre emplacement de l'inventaire est vide.",
          );
        }

        await this.acquireResourceLocks(
          tx,
          equipmentIds,
          shelfIds,
        );

        await this.assertNoOtherActiveInventory(
          tx,
          inventoryId,
          equipmentIds,
          shelfIds,
        );

        const workUnits: Array<{
          unitId: string;
          unitOrder: number;
          equipmentId: string | null;
          shelfId: string | null;
        }> = [];

        if (
          inventory.typeInventory ===
          'ByEquipment'
        ) {
          const equipmentRows =
            await tx.equipment.findMany({
              where: {
                equipmentId: {
                  in: equipmentIds,
                },
              },
              select: {
                equipmentId: true,
              },
            });

          if (
            equipmentRows.length !==
            equipmentIds.length
          ) {
            throw new NotFoundException(
              'Un article du périmètre a été supprimé ou est introuvable.',
            );
          }

          for (
            let index = 0;
            index < equipmentIds.length;
            index += 1
          ) {
            const equipmentId =
              equipmentIds[index];

            const unit =
              await tx.inventoryWorkUnit.create({
                data: {
                  inventoryId,
                  equipmentId,
                  shelfId: null,
                  unitOrder: index,
                  status: 'COUNTING',
                  reconciliationStatus:
                    'PENDING',
                  acceptedAttemptId: null,
                  reconciledAt: null,
                },
                select: {
                  unitId: true,
                  unitOrder: true,
                  equipmentId: true,
                  shelfId: true,
                },
              });

            workUnits.push(unit);

            await this.snapshotEquipmentAtLaunch(
              tx,
              inventoryId,
              equipmentId,
            );
          }
        } else {
          const shelfRows =
            await tx.shelf.findMany({
              where: {
                shelfId: {
                  in: shelfIds,
                },
              },
              select: {
                shelfId: true,
              },
            });

          if (
            shelfRows.length !==
            shelfIds.length
          ) {
            throw new NotFoundException(
              'Un emplacement du périmètre a été supprimé ou est introuvable.',
            );
          }

          for (
            let index = 0;
            index < shelfIds.length;
            index += 1
          ) {
            const shelfId = shelfIds[index];

            const unit =
              await tx.inventoryWorkUnit.create({
                data: {
                  inventoryId,
                  equipmentId: null,
                  shelfId,
                  unitOrder: index,
                  status: 'COUNTING',
                  reconciliationStatus:
                    'PENDING',
                  acceptedAttemptId: null,
                  reconciledAt: null,
                },
                select: {
                  unitId: true,
                  unitOrder: true,
                  equipmentId: true,
                  shelfId: true,
                },
              });

            workUnits.push(unit);

            await this.snapshotShelfAtLaunch(
              tx,
              inventoryId,
              shelfId,
            );
          }
        }

        let firstC1AttemptId:
          string | null = null;

        for (
          let index = 0;
          index < workUnits.length;
          index += 1
        ) {
          const unit = workUnits[index];

          const c1 =
            await tx.inventoryCountAttempt.create({
              data: {
                unitId: unit.unitId,
                assignedUserId:
                  controller1.userId,
                sequence: 0,
                purpose: 'PRIMARY_1',
                status:
                  index === 0
                    ? 'AVAILABLE'
                    : 'BLOCKED',
              },
            });

          if (index === 0) {
            firstC1AttemptId =
              c1.attemptId;
          }

          await tx.inventoryCountAttempt.create({
            data: {
              unitId: unit.unitId,
              assignedUserId:
                controller2.userId,
              sequence: 1,
              purpose: 'PRIMARY_2',
              status: 'BLOCKED',
            },
          });

          // C3 is intentionally NOT created at launch.
        }

        await tx.inventory.update({
          where: { inventoryId },
          data: {
            status: 'IN_PROGRESS',
            launchedAt: new Date(),
            thirdCountRequired: false,
            finalResultSource:
              'PER_UNIT_RECONCILIATION',
          },
        });

        if (firstC1AttemptId) {
          await tx.notification.create({
            data: {
              recipientId:
                controller1.userId,
              eventType:
                'INVENTORY_TASK_AVAILABLE',
              payload: JSON.stringify({
                inventoryId,
                taskId:
                  firstC1AttemptId,
                title:
                  inventory.title,
                unitOrder: 0,
                message:
                  'La première unité de comptage est disponible.',
              }),
            },
          });
        }

        return {
          success: true,
          inventoryId,
          totalUnits:
            workUnits.length,
        };
      },
      {
        isolationLevel: 'Serializable',
        timeout: 30_000,
      },
    );
  }

  private parseScopeIds(
    raw: string | null,
  ): string[] {
    if (!raw) {
      return [];
    }

    try {
      const parsed = JSON.parse(raw);

      if (!Array.isArray(parsed)) {
        return [];
      }

      return [
        ...new Set(
          parsed
            .filter(
              (value) =>
                typeof value === 'string',
            )
            .map((value) => value.trim())
            .filter(Boolean),
        ),
      ];
    } catch {
      throw new BadRequestException(
        "Le périmètre enregistré de l'inventaire est illisible.",
      );
    }
  }

  private async snapshotEquipmentAtLaunch(
    tx: Prisma.TransactionClient,
    inventoryId: string,
    equipmentId: string,
  ) {
    const allocations: any[] = [];

    if (allocations.length) {
      await tx.inventory_Equipment_Shelf_Snapshot.createMany({
        data: allocations.map((row) => ({
          inventoryId,
          equipmentId: row.equipmentId,
          shelfId: row.shelfId,
          phase: 'LIVE_AT_LAUNCH',
          quantity: row.equipmentQuantity,
          provenance:
            'LIVE_EQUIPMENT_SHELFS',
        })),
      });
    }

    const serials =
      await tx.serialNumber.findMany({
        where: { equipmentId },
        select: {
          serialNumberId: true,
          serialNumberCode: true,
          serialNumberStatus: true,
          equipmentId: true,
          shelfId: true,
        },
      });

    if (serials.length) {
      await tx.inventory_SerialNumber_Snapshot.createMany({
        data: serials.map((serial) => ({
          inventoryId,
          equipmentId: serial.equipmentId,
          shelfId: serial.shelfId,
          serialNumberId:
            serial.serialNumberId,
          serialNumberCode:
            serial.serialNumberCode,
          serialNumberStatus:
            serial.serialNumberStatus,
          phase: 'LIVE_AT_LAUNCH',
          provenance:
            'LIVE_SERIAL_NUMBERS',
        })),
      });
    }
  }

  private async snapshotShelfAtLaunch(
    tx: Prisma.TransactionClient,
    inventoryId: string,
    shelfId: string,
  ) {
    const allocations: any[] = [];

    if (allocations.length) {
      await tx.inventory_Equipment_Shelf_Snapshot.createMany({
        data: allocations.map((row) => ({
          inventoryId,
          equipmentId: row.equipmentId,
          shelfId: row.shelfId,
          phase: 'LIVE_AT_LAUNCH',
          quantity: row.equipmentQuantity,
          provenance:
            'LIVE_EQUIPMENT_SHELFS',
        })),
      });
    }

    const serials =
      await tx.serialNumber.findMany({
        where: { shelfId },
        select: {
          serialNumberId: true,
          serialNumberCode: true,
          serialNumberStatus: true,
          equipmentId: true,
          shelfId: true,
        },
      });

    if (serials.length) {
      await tx.inventory_SerialNumber_Snapshot.createMany({
        data: serials.map((serial) => ({
          inventoryId,
          equipmentId: serial.equipmentId,
          shelfId: serial.shelfId,
          serialNumberId:
            serial.serialNumberId,
          serialNumberCode:
            serial.serialNumberCode,
          serialNumberStatus:
            serial.serialNumberStatus,
          phase: 'LIVE_AT_LAUNCH',
          provenance:
            'LIVE_SERIAL_NUMBERS',
        })),
      });
    }
  }


