<file path="tests/movement-draft.test.mts">
import test from 'node:test';
import assert from 'node:assert/strict';

import {
  buildMovementPayload,
  createMovementDraft,
} from '../src/lib/movement-draft'

function standardEquipment(overrides: Record<string, unknown> = {}) {
  return {
    equipmentId: '11111111-1111-4111-8111-111111111111',
    equipmentName: 'Standard equipment',
    hasSerialNumber: false,
    equipmentQuantity: 10,
    minequipmentQuantity: 0,
    equipmentShelfs: [
      {
        equipmentShelfId: 'a',
        equipmentId: '11111111-1111-4111-8111-111111111111',
        shelfId: '22222222-2222-4222-8222-222222222222',
        equipmentQuantity: 10,
      },
    ],
    ...overrides,
  };
}

function serializedEquipment(overrides: Record<string, unknown> = {}) {
  return {
    equipmentId: '33333333-3333-4333-8333-333333333333',
    equipmentName: 'Serialized equipment',
    hasSerialNumber: true,
    equipmentQuantity: 2,
    minequipmentQuantity: 0,
    equipmentShelfs: [],
    ...overrides,
  };
}

test('builds one V3 IN document with multiple lines and one shared destination', () => {
  const standard = createMovementDraft(
    standardEquipment() as any,
  );
  standard.quantity = 5;

  const serialized = createMovementDraft(
    serializedEquipment() as any,
  );
  serialized.serialNumberIds = ['serial-a', 'serial-b'];

  const payload = buildMovementPayload({
    movementType: 'IN',
    
    drafts: [standard, serialized],
  });

  assert.equal(payload.movementType, 'IN');
  
  
  assert.deepEqual(payload.items, [
    {
      equipmentId: standard.equipment.equipmentId,
      movementQuantity: 5,
    },
    {
      equipmentId: serialized.equipment.equipmentId,
      serialNumberId: 'serial-a',
      movementQuantity: 1,
    },
    {
      equipmentId: serialized.equipment.equipmentId,
      serialNumberId: 'serial-b',
      movementQuantity: 1,
    },
  ]);
});

test('TRANSFER validates the source allocation for standard equipment', () => {
  const draft = createMovementDraft(
    standardEquipment() as any,
  );
  draft.quantity = 4;

  const payload = buildMovementPayload({
    movementType: 'TRANSFER',
    
    
    drafts: [draft],
  });

  assert.equal(payload.items[0].movementQuantity, 4);
});

test('rejects insufficient standard stock at the shared source', () => {
  const draft = createMovementDraft(
    standardEquipment() as any,
  );
  draft.quantity = 11;

  assert.throws(
    () =>
      buildMovementPayload({
        movementType: 'OUT',
        
        drafts: [draft],
      }),
    /stock insuffisant/i,
  );
});

test('rejects an invalid route for IN', () => {
  const draft = createMovementDraft(
    standardEquipment() as any,
  );

  assert.throws(
    () =>
      buildMovementPayload({
        movementType: 'IN',
        
        
        drafts: [draft],
      }),
    /ne doit pas avoir d’emplacement source/i,
  );
});

test('rejects more than 100 child lines', () => {
  const draft = createMovementDraft(
    serializedEquipment() as any,
  );

  draft.serialNumberIds = Array.from(
    { length: 101 },
    (_, index) => `serial-${index}`,
  );

  assert.throws(
    () =>
      buildMovementPayload({
        movementType: 'IN',
        
        drafts: [draft],
      }),
    /100 lignes/i,
  );
});
</file>

<file path="tests/movement-ledger.test.mts">
import test from 'node:test';
import assert from 'node:assert/strict';

import {
  calculateMovementAudit,
  flattenMovementLines,
} from '../src/lib/movement-ledger.ts';

const equipmentId =
  '11111111-1111-4111-8111-111111111111';

function movement(
  id: string,
  status: string,
  quantity: number,
  sourceShelfId: string | null,
  destinationShelfId: string | null,
) {
  return {
    mouvementId: id,
    createdAt: `2026-09-21T10:0${id}:00.000Z`,
    mouvementStatus: status,
    mouvementQuantity: quantity,
    equipmentId,
    serialNumberId: null,
    sourceShelfId,
    destinationShelfId,
    items: [
      {
        mouvementEquipmentId: `line-${id}`,
        mouvementId: id,
        equipmentId,
        serialNumberId: null,
        sourceShelfId,
        destinationShelfId,
        mouvementQuantity: quantity,
        mouvementStatus: status,
      },
    ],
  };
}

test('flattens V3 movement headers into equipment lines', () => {
  const rows = flattenMovementLines(
    [
      movement('1', 'IN', 10, null, 'shelf-a'),
      movement('2', 'TRANSFER', 4, 'shelf-a', 'shelf-b'),
    ] as any,
    equipmentId,
  );

  assert.equal(rows.length, 2);
  assert.equal(rows[0].mouvementEquipmentId, 'line-1');
  assert.equal(rows[1].mouvementEquipmentId, 'line-2');
});

test('standard stock audit ignores TRANSFER in global quantity', () => {
  const summary = calculateMovementAudit(
    [
      movement('1', 'IN', 10, null, 'shelf-a'),
      movement('2', 'TRANSFER', 4, 'shelf-a', 'shelf-b'),
      movement('3', 'OUT', 2, 'shelf-b', null),
    ] as any,
    8,
    equipmentId,
  );

  assert.equal(summary.initialQuantity, 0);
  assert.equal(summary.totalIn, 10);
  assert.equal(summary.totalOut, 2);
  assert.equal(summary.currentQuantity, 8);

  assert.deepEqual(
    summary.ledger.map((entry: any) => entry.delta),
    [10, 0, -2],
  );

  assert.deepEqual(
    summary.ledger.map((entry: any) => entry.runningBalance),
    [10, 10, 8],
  );
});

test('reads historical ENTRY/EXIT aliases without creating them', () => {
  const summary = calculateMovementAudit(
    [
      movement('1', 'ENTRY', 3, null, 'shelf-a'),
      movement('2', 'EXIT', 1, 'shelf-a', null),
    ] as any,
    2,
    equipmentId,
  );

  assert.equal(summary.totalIn, 3);
  assert.equal(summary.totalOut, 1);
});
</file>

