} from 'react';
import {
  useParams,
  useRouter,
} from 'next/navigation';
import {
  Loader2,
} from 'lucide-react';

export default function InventoryIdRedirectPage() {
  const params =
    useParams();

  const router =
    useRouter();

  const inventoryId =
    params?.id as string;

  useEffect(() => {
    if (inventoryId) {
      router.replace(
        `/inventory/${inventoryId}/report`,
      );
    } else {
      router.replace(
        '/inventory',
      );
    }
  }, [
    inventoryId,
    router,
