<file path="frontend/src/components/auth/AuthStatusCard.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState } from 'react';
import { useAuth } from '@clerk/nextjs';
import { useQuery } from '@tanstack/react-query';
import { useApi } from '@/hooks/use-api';
import { CheckCircle2, ShieldCheck, Database, RefreshCw, AlertCircle, Copy, Check } from 'lucide-react';
import { toast } from 'sonner';

interface AuthMeResponse {
  userId: string;
  clerkUserId: string;
  userName: string | null;
  userEmail: string | null;
  roleId: string | null;
  roleName: string | null;
  permissions: string[];
  status: string | null;
}

export function AuthStatusCard() {
  const { isLoaded, isSignedIn, userId, getToken } = useAuth();
  const api = useApi();

  const [copiedToken, setCopiedToken] = useState(false);
  const { data, isFetching: loading, error: queryError, refetch } = useQuery({
    queryKey: ['auth', 'me', userId],
    queryFn: async () => (await api.get<AuthMeResponse>('/auth/me')).data,
    enabled: !!isLoaded && !!isSignedIn && !!userId,
    retry: false,
  });
  const error = queryError
    ? getErrorMessage(queryError, 'Impossible de joindre le serveur NestJS')
    : null;

  const handleCopyToken = async () => {
    try {
      const token = await getToken();
      if (token) {
        await navigator.clipboard.writeText(token);
        setCopiedToken(true);
        toast.success('Token de session Clerk copié dans le presse-papier !');
        setTimeout(() => setCopiedToken(false), 2500);
      } else {
        toast.error('Aucun token de session actif trouvé.');
      }
    } catch {
      toast.error('Impossible de récupérer le token Clerk.');
    }
  };

  if (!isSignedIn) return null;

  return (
    <div className="w-full bg-[#faf9f8] border border-[#e5e3df] rounded-xl p-5 text-left space-y-4 shadow-xs">
      <div className="flex items-center justify-between border-b border-[#eceae6] pb-3 flex-wrap gap-2">
        <div className="flex items-center gap-2.5">
          <div className="w-8 h-8 rounded-lg bg-[#eef6ec] border border-[#cbe4c6] flex items-center justify-center text-[#2b7824]">
            <Database className="w-4 h-4" />
          </div>
          <div>
            <h3 className="text-sm font-semibold text-[#1a1a1a]">
              Synchronisation du compte
            </h3>
            <p className="text-[11px] text-[#787670]">
              Statut de la session Clerk & identité locale NestJS
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={handleCopyToken}
            className="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white hover:bg-[#f0eeec] border border-[#d3d0ca] text-[#37352f] transition-colors cursor-pointer"
            title="Copier le Bearer Token Clerk pour tester dans PowerShell / Postman"
          >
            {copiedToken ? (
              <Check className="w-3.5 h-3.5 text-[#1aae39]" />
            ) : (
              <Copy className="w-3.5 h-3.5 text-[#5645d4]" />
            )}
            <span>{copiedToken ? 'Copié !' : 'Copier Token'}</span>
          </button>

          <button
            type="button"
            onClick={() => void refetch()}
            disabled={loading}
            className="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white hover:bg-[#f0eeec] border border-[#d3d0ca] text-[#37352f] transition-colors cursor-pointer disabled:opacity-50"
          >
            <RefreshCw className={`w-3.5 h-3.5 ${loading ? 'animate-spin' : ''}`} />
            <span>Vérifier</span>
          </button>
        </div>
      </div>

      {loading && !data && (
        <div className="py-4 text-center text-xs text-[#787670] flex items-center justify-center gap-2">
          <RefreshCw className="w-3.5 h-3.5 animate-spin" />
          <span>Validation du token Clerk auprès de NestJS...</span>
        </div>
      )}

      {error && (
        <div className="p-3 bg-[#fdf3f2] border border-[#f5c6cb] rounded-lg text-xs text-[#b82a2a] flex items-start gap-2">
          <AlertCircle className="w-4 h-4 mt-0.5 shrink-0" />
          <div>
            <span className="font-medium">Erreur d&apos;authentification API:</span> {error}
          </div>
        </div>
      )}

      {data && (
        <div className="space-y-2.5 text-xs">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div className="p-2.5 bg-white rounded-lg border border-[#e5e3df]">
              <span className="text-[10px] uppercase font-bold text-[#787670] tracking-wider block">
                Statut du compte
              </span>
              <span className="inline-flex items-center gap-1.5 mt-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#eef6ec] text-[#2b7824]">
                <CheckCircle2 className="w-3 h-3" />
                {data.status ?? 'ACTIVE'}
              </span>
            </div>

            <div className="p-2.5 bg-white rounded-lg border border-[#e5e3df]">
              <span className="text-[10px] uppercase font-bold text-[#787670] tracking-wider block">
                Rôle Applicatif (RBAC)
              </span>
              <span className="inline-flex items-center gap-1.5 mt-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#f0effe] text-[#5645d4]">
                <ShieldCheck className="w-3 h-3" />
                {data.roleName ?? 'Aucun rôle assigné'}
              </span>
            </div>
          </div>

          <div className="p-2.5 bg-white rounded-lg border border-[#e5e3df] space-y-1 font-mono text-[11px]">
            <div className="flex justify-between items-center text-[#5d5b54]">
              <span>Identifiant système:</span>
              <span className="text-[#1a1a1a] font-semibold select-all truncate max-w-[200px]" title={data.userId}>
                {data.userId}
              </span>
            </div>
            <div className="flex justify-between items-center text-[#5d5b54]">
              <span>Clerk User ID:</span>
              <span className="text-[#1a1a1a] font-semibold select-all truncate max-w-[200px]" title={data.clerkUserId}>
                {data.clerkUserId}
              </span>
            </div>
          </div>

          {data.permissions && data.permissions.length > 0 && (
            <div className="p-2.5 bg-white rounded-lg border border-[#e5e3df] space-y-1.5">
              <span className="text-[10px] uppercase font-bold text-[#787670] tracking-wider block">
                Permissions accordées ({data.permissions.length})
              </span>
              <div className="flex flex-wrap gap-1">
                {data.permissions.map((perm) => (
                  <span
                    key={perm}
                    className="px-1.5 py-0.5 bg-[#f0eeec] text-[#37352f] rounded text-[10px] font-mono"
                  >
                    {perm}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/components/movement/MovementDetailModal.tsx">
'use client';

import {
  ArrowDownToLine,
  ArrowRight,
  ArrowRightLeft,
  ArrowUpFromLine,
  Barcode,
  CalendarClock,
  Package,
  UserRound,
  X,
} from 'lucide-react';

import type {
  Movement,
} from '@/types/movement';

interface MovementDetailModalProps {
  movement:
    | Movement
    | null;
  isOpen: boolean;
  onClose: () => void;
}

function movementType(movement: any): 'IN' | 'OUT' | 'TRANSFER' {
  return movement.mouvementStatus ? 'OUT' : 'IN';
}

function formatDate(
  value?: string | null,
) {
  if (!value) {
    return '—';
  }

  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return value;
  }

  return new Intl.DateTimeFormat(
    'fr-DZ',
    {
      dateStyle: 'short',
      timeStyle: 'short',
    },
  ).format(date);
}

function shelfName(
  shelf:
    | {
        shelfName:
          string | null;
      }
    | null
    | undefined,
  externalText: string,
) {
  return (
    shelf?.shelfName ??
    externalText
  );
}

export function MovementDetailModal({
  movement,
  isOpen,
  onClose,
}: MovementDetailModalProps) {
  if (
    !isOpen ||
    !movement
  ) {
    return null;
  }

  const type =
    movementType(
      movement,
    );

  const Icon =
    type === 'IN'
      ? ArrowDownToLine
      : type === 'OUT'
        ? ArrowUpFromLine
        : ArrowRightLeft;

  const typeText =
    type === 'IN'
      ? 'ENTRÉE'
      : type === 'OUT'
        ? 'SORTIE'
        : 'TRANSFERT';

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-sm">
      <div className="flex max-h-[92vh] w-full max-w-4xl flex-col overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#26221f] px-5 py-4">
          <div className="flex items-center gap-3">
            <div className="flex h-9 w-9 items-center justify-center rounded border border-[#3f3f46] bg-[#27272a]">
              <Icon className="h-4 w-4" />
            </div>

            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-sm font-semibold">
                  Mouvement {typeText}
                </h2>

                {movement.origin === false && (
                  <span className="rounded border border-violet-400/30 bg-violet-950/25 px-2 py-0.5 text-[9px] font-semibold text-violet-200">
                    AJUSTEMENT INVENTAIRE
                  </span>
                )}
              </div>

              <p className="mt-0.5 text-[10px] text-white/45">
                Aucun UUID/GUID n’est affiché.
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={onClose}
            className="rounded p-2 text-white/60 hover:bg-white/10"
          >
            <X className="h-4 w-4" />
          </button>
        </header>

        <div className="flex-1 space-y-4 overflow-y-auto p-5">
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <InfoCard
              icon={CalendarClock}
              label="Date d'effet"
              value={formatDate(
                movement.happenedAt,
              )}
            />

            <InfoCard
              icon={CalendarClock}
              label="Créé le"
              value={formatDate(
                movement.createdAt,
              )}
            />

            <InfoCard
              icon={Package}
              label="Quantité totale"
              value={`${(movement.items?.reduce((acc, item) => acc + (item.equipmentQuantity ?? 0), 0) ?? 0) ?? 0} unité(s)`}
            />

            <InfoCard
              icon={ArrowRightLeft}
              label="Type"
              value={typeText}
            />

            <InfoCard
              icon={UserRound}
              label="Créé par"
              value={
                movement.createdByUser
                  ?.userName ??
                movement.createdByUser
                  ?.userEmail ??
                '—'
              }
            />
          </div>

          <section className="rounded-lg border border-[#3f3f46] bg-[#18181b] p-4">
            <p className="mb-3 text-[10px] font-semibold uppercase tracking-wider text-[#71717a]">
              Trajet commun
            </p>

            <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
              <RouteBox
                label="Source"
                value={shelfName(
                  movement.items?.[0]?.sourceShelf,
                  'Extérieur',
                )}
              />

              <ArrowRight className="mx-auto h-4 w-4 shrink-0 rotate-90 text-[#5c544d] sm:rotate-0" />

              <RouteBox
                label="Destination"
                value={shelfName(
                  movement.items?.[0]?.destinationShelf,
                  'Extérieur',
                )}
              />
            </div>
          </section>

          {movement.reason && (
            <section className="rounded-lg border border-violet-400/20 bg-violet-950/15 p-4">
              <p className="text-[10px] font-semibold uppercase tracking-wider text-violet-200/70">
                Motif
              </p>

              <p className="mt-2 text-xs text-violet-100">
                {movement.reason}
              </p>
            </section>
          )}

          <section className="overflow-hidden rounded-lg border border-[#3f3f46]">
            <div className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-4 py-3">
              <div>
                <h3 className="text-xs font-semibold">
                  Lignes du mouvement
                </h3>

                <p className="mt-0.5 text-[10px] text-white/40">
                  Articles et numéros de série concernés.
                </p>
              </div>

              <span className="font-mono text-xs text-[#a1a1aa]">
                {movement.items
                  ?.length ?? 0}
              </span>
            </div>

            <div className="divide-y divide-[#3f3f46]">
              {(movement.items ??
                []).map(
                (
                  item,
                  index,
                ) => (
                  <div
                    key={
                      item.movementEquipmentId ??
                      `${index}-${item.equipmentId}`
                    }
                    className="grid grid-cols-1 gap-3 px-4 py-3 sm:grid-cols-[42px_minmax(0,1fr)_minmax(0,1fr)_100px] sm:items-center"
                  >
                    <div className="flex h-8 w-8 items-center justify-center rounded border border-[#3f3f46] bg-[#27272a] font-mono text-[10px] text-[#a1a1aa]">
                      {String(
                        index + 1,
                      ).padStart(
                        2,
                        '0',
                      )}
                    </div>

                    <div className="min-w-0">
                      <p className="truncate text-xs font-medium">
                        {item.equipment
                          ?.equipmentName ??
                          'Article'}
                      </p>

                      <p className="mt-1 text-[9px] text-white/35">
                        {item.equipmentTypeSnapshot ===
                        'SERIALIZED'
                          ? 'Sérialisé'
                          : item.equipmentTypeSnapshot ===
                              'STANDARD'
                            ? 'Standard'
                            : item.serialNumberId
                              ? 'Sérialisé'
                              : 'Standard'}
                      </p>
                    </div>

                    <div className="min-w-0">
                      {item.serialNumberId ? (
                        <p className="flex items-center gap-1.5 truncate font-mono text-xs text-[#d4d4d8]">
                          <Barcode className="h-3.5 w-3.5 shrink-0" />
                          {item.serialNumber
                            ?.serialNumberCode ??
                            'Numéro de série'}
                        </p>
                      ) : (
                        <span className="text-xs text-[#6f665f]">
                          Article quantitatif
                        </span>
                      )}
                    </div>

                    <div className="text-left sm:text-right">
                      <span className="inline-flex rounded border border-[#3f3f46] bg-[#27272a] px-2 py-1 font-mono text-xs font-semibold">
                        {
                          item.equipmentQuantity
                        }{' '}
                        u.
                      </span>
                    </div>
                  </div>
                ),
              )}

              {!movement.items
                ?.length && (
                <div className="px-4 py-8 text-center text-xs text-[#71717a]">
                  Aucune ligne enregistrée.
                </div>
              )}
            </div>
          </section>
        </div>

        <footer className="flex justify-end border-t border-[#3f3f46] bg-[#26221f] px-5 py-3">
          <button
            type="button"
            onClick={onClose}
            className="rounded bg-[#fafafa] px-4 py-2 text-xs font-semibold text-[#18181b]"
          >
            Fermer
          </button>
        </footer>
      </div>
    </div>
  );
}

function InfoCard({
  icon: Icon,
  label,
  value,
}: {
  icon:
    typeof Package;
  label: string;
  value: string;
}) {
  return (
    <div className="rounded border border-[#3f3f46] bg-[#18181b] p-3">
      <div className="flex items-center gap-2 text-[#71717a]">
        <Icon className="h-3.5 w-3.5" />

        <span className="text-[10px] uppercase tracking-wider">
          {label}
        </span>
      </div>

      <p className="mt-2 break-words text-xs font-medium">
        {value}
      </p>
    </div>
  );
}

function RouteBox({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="min-w-0 flex-1 rounded border border-[#3f3f46] bg-[#27272a]/55 p-3">
      <p className="text-[10px] uppercase tracking-wider text-[#71717a]">
        {label}
      </p>

      <p className="mt-1 truncate text-xs font-medium">
        {value}
      </p>
    </div>
  );
}
