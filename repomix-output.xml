<file path="frontend/src/app/equipment/page.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';
import { useState } from 'react';
import { useAuth, SignInButton } from '@clerk/nextjs';
import Link from 'next/link';
import {
  ArrowRightLeft,
  ShieldCheck,
  ShieldAlert,
  PackagePlus,
  Cpu,
  Loader2,
} from 'lucide-react';
import { useEquipments } from '@/hooks/use-equipments';
import { usePermissions } from '@/hooks/use-permissions';
import { EquipmentListTable } from '@/components/equipment/EquipmentListTable';
import { CreateEquipmentModal } from '@/components/equipment/CreateEquipmentModal';
import { CreateMovementModal } from '@/components/equipment/CreateMovementModal';
import { EquipmentDetailModal } from '@/components/equipment/EquipmentDetailModal';
import { EditEquipmentModal } from '@/components/equipment/EditEquipmentModal';
import { DeleteEquipmentModal } from '@/components/equipment/DeleteEquipmentModal';
import { EditSerialNumberModal } from '@/components/equipment/EditSerialNumberModal';
import { DeleteSerialNumberModal } from '@/components/equipment/DeleteSerialNumberModal';
import { ViewEquipmentShelvesModal } from '@/components/equipment/ViewEquipmentShelvesModal';
import { Equipment, SerialNumber } from '@/types/equipment';
import { toast } from 'sonner';

export default function EquipmentPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [selectedEquipment, setSelectedEquipment] = useState<Equipment | null>(null);
  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false);
  const [isLookingUp, setIsLookingUp] = useState(false);

  // Movement modal state
  const [isMovementModalOpen, setIsMovementModalOpen] = useState(false);
  const [movementEquipment, setMovementEquipment] = useState<Equipment | null>(null);

  // Edit / Delete / View Shelves modals state
  const [editingEquipment, setEditingEquipment] = useState<Equipment | null>(null);
  const [deletingEquipment, setDeletingEquipment] = useState<Equipment | null>(null);
  const [editingSerialNumber, setEditingSerialNumber] = useState<SerialNumber | null>(null);
  const [deletingSerialNumber, setDeletingSerialNumber] = useState<SerialNumber | null>(null);
  const [viewShelvesEquipment, setViewShelvesEquipment] = useState<Equipment | null>(null);

  const {
    equipments,
    totalEquipments,
    totalPages,
    currentPage,
    limit,
    searchTerm,
    setSearchTerm,
    setPage,
    setLimit,
    isLoading: isEquipmentsLoading,
    refetch,
    getEquipmentById,
    updateEquipment,
    isUpdating,
    deleteEquipment,
    isDeleting,
    updateSerialNumber,
    isUpdatingSerialNumber,
    deleteSerialNumber,
    isDeletingSerialNumber,
  } = useEquipments({ page: 1, limit: 10 });

  const {
    canCreateEquipment,
    canUpdateEquipment,
    canDeleteEquipment,
    canCreateSerialNumber,
    canUpdateSerialNumber,
    canDeleteSerialNumber,
  } = usePermissions();
  const canCreateMovement = canCreateEquipment;

  const handleSelectEquipment = (equipment: Equipment) => {
    setSelectedEquipment(equipment);
    setIsDetailModalOpen(true);
  };

  const handleLookupById = async (id: string) => {
    setIsLookingUp(true);
    try {
      const equip = await getEquipmentById(id);
      setSelectedEquipment(equip);
      setIsDetailModalOpen(true);
      toast.success(`Article trouvé : ${equip.equipmentName ?? equip.equipmentId}`);
    } catch (err: unknown) {
      toast.error('Recherche échouée', {
        description: getErrorMessage(err, `L'article avec le GUID '${id}' est introuvable.`),
      });
    } finally {
      setIsLookingUp(false);
    }
  };

  if (!isLoaded) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
        <div className="flex items-center gap-2 text-xs font-mono text-[#aea69c]">
          <Loader2 className="w-4 h-4 animate-spin text-[#f7f5f0]" />
          <span>Chargement des articles...</span>
        </div>
      </main>
    );
  }

  if (!isSignedIn) {
    return (
      <main className="min-h-screen flex items-center justify-center p-6 bg-[#2b2622] text-[#f7f5f0]">
        <div className="w-full max-w-md bg-[#383330] border border-[#3f3a36] rounded-[4px] p-8 shadow-xl text-center space-y-4">
          <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0] mx-auto">
            <Cpu className="w-5 h-5" />
          </div>
          <div className="space-y-1">
            <h1 className="text-base font-medium text-[#f7f5f0]">Connexion requise</h1>
            <p className="text-xs text-[#c9c0ad]">
              Veuillez vous connecter pour gérer les articles, numéros de série et mouvements.
            </p>
          </div>
          <div className="flex flex-col sm:flex-row gap-2 pt-2">
            <SignInButton mode="modal">
              <button
                type="button"
                className="flex-1 px-4 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
              >
                Se connecter
              </button>
            </SignInButton>
            <Link
              href="/"
              className="flex-1 inline-flex items-center justify-center px-4 py-2 bg-[#2b2622] hover:bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors"
            >
              Accueil
            </Link>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
      {/* Main Body */}
      <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
        {/* Page Hero Section */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#3f3a36]">
          <div className="space-y-1">
            <div className="flex items-center gap-2 text-xs text-[#aea69c] mb-1 font-mono">
              <Link href="/" className="hover:text-[#f7f5f0] transition-colors">
                somepharm
              </Link>
              <span>/</span>
              <span className="text-[#f7f5f0]">articles</span>
            </div>
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-xl sm:text-2xl font-normal tracking-tight text-[#f7f5f0]">
                Articles & Numéros de Série
              </h1>
              <div className="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] font-mono text-[10px] bg-[#383330] border border-[#3f3a36] text-[#c9c0ad]">
                {canCreateEquipment ? (
                  <>
                    <ShieldCheck className="w-3 h-3 text-[#10b981]" />
                    <span>Création autorisée</span>
                  </>
                ) : (
                  <>
                    <ShieldAlert className="w-3 h-3 text-[#f59e0b]" />
                    <span>Lecture seule</span>
                  </>
                )}
              </div>
            </div>
          </div>

          {/* Action CTAs: Warp primary and secondary */}
          <div className="flex items-center gap-2 shrink-0">
            <button
              type="button"
              onClick={() => {
                setMovementEquipment(null);
                setIsMovementModalOpen(true);
              }}
              className="inline-flex items-center justify-center gap-2 px-3 py-2 bg-[#383330] hover:bg-[#3f3a36] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
            >
              <ArrowRightLeft className="w-3.5 h-3.5 text-[#aea69c]" />
              <span>Nouveau mouvement</span>
            </button>

            <button
              type="button"
              onClick={() => setIsModalOpen(true)}
              className="inline-flex items-center justify-center gap-2 px-3.5 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] shadow-xs transition-colors cursor-pointer"
            >
              <PackagePlus className="w-3.5 h-3.5" />
              <span>Nouvel article</span>
            </button>
          </div>
        </div>

        {/* Equipment List Table Component */}
        <EquipmentListTable
          equipments={equipments}
          totalEquipments={totalEquipments}
          totalPages={totalPages}
          currentPage={currentPage}
          limit={limit}
          searchTerm={searchTerm}
          onSearchChange={setSearchTerm}
          onPageChange={setPage}
          onLimitChange={(newLimit) => {
            setLimit(newLimit);
            setPage(1);
          }}
          onSelectEquipment={handleSelectEquipment}
          onOpenMovement={(equip) => {
            setMovementEquipment(equip);
            setIsMovementModalOpen(true);
          }}
          onEditEquipment={(equip) => setEditingEquipment(equip)}
          onDeleteEquipment={(equip) => setDeletingEquipment(equip)}
          onEditSerialNumber={(sn) => setEditingSerialNumber(sn)}
          onDeleteSerialNumber={(sn) => setDeletingSerialNumber(sn)}
          onViewEquipmentShelves={(equip) => setViewShelvesEquipment(equip)}
          onLookupById={handleLookupById}
          isLoading={isEquipmentsLoading}
          onRefresh={refetch}
          onOpenCreateModal={() => setIsModalOpen(true)}
          canCreateMovement={canCreateMovement}
          canUpdateEquipment={canUpdateEquipment}
          canDeleteEquipment={canDeleteEquipment}
          canUpdateSerialNumber={canUpdateSerialNumber}
          canDeleteSerialNumber={canDeleteSerialNumber}
        />
      </div>

      {/* View Equipment Shelves Modal Component */}
      <ViewEquipmentShelvesModal
        isOpen={!!viewShelvesEquipment}
        equipment={viewShelvesEquipment}
        onClose={() => setViewShelvesEquipment(null)}
      />

      {/* Direct Equipment Creation Modal Component */}
      <CreateEquipmentModal
        isOpen={isModalOpen}
        onClose={() => setIsModalOpen(false)}
        onSuccess={() => refetch()}
      />

      {/* Equipment Detail Modal Component */}
      <EquipmentDetailModal
        equipment={selectedEquipment}
        isOpen={isDetailModalOpen}
        onClose={() => {
          setIsDetailModalOpen(false);
          setSelectedEquipment(null);
        }}
        onOpenMovement={(equip) => {
          setMovementEquipment(equip);
          setIsMovementModalOpen(true);
        }}
        onRefresh={refetch}
        isLoading={isLookingUp}
      />

      {/* Edit Equipment Modal Component */}
      <EditEquipmentModal
        isOpen={!!editingEquipment}
        onClose={() => setEditingEquipment(null)}
        equipment={editingEquipment}
        onUpdate={async (id, values) => {
          await updateEquipment({ id, input: values });
          refetch();
        }}
        isUpdating={isUpdating}
      />

      {/* Delete Equipment Modal Component */}
      <DeleteEquipmentModal
        isOpen={!!deletingEquipment}
        onClose={() => setDeletingEquipment(null)}
        equipment={deletingEquipment}
        onDelete={async (id) => {
          await deleteEquipment(id);
          refetch();
        }}
        isDeleting={isDeleting}
      />

      {/* Edit Serial Number Modal Component */}
      <EditSerialNumberModal
        isOpen={!!editingSerialNumber}
        onClose={() => setEditingSerialNumber(null)}
        serialNumber={editingSerialNumber}
        onUpdate={async (id, values) => {
          await updateSerialNumber({ id, input: values });
          refetch();
        }}
        isUpdating={isUpdatingSerialNumber}
      />

      {/* Delete Serial Number Modal Component */}
      <DeleteSerialNumberModal
        isOpen={!!deletingSerialNumber}
        onClose={() => setDeletingSerialNumber(null)}
        serialNumber={deletingSerialNumber}
        onDelete={async (id) => {
          await deleteSerialNumber(id);
          refetch();
        }}
        isDeleting={isDeletingSerialNumber}
      />

      {/* Create Movement Modal Component */}
      <CreateMovementModal
        isOpen={isMovementModalOpen}
        onClose={() => {
          setIsMovementModalOpen(false);
          setMovementEquipment(null);
        }}
        equipment={movementEquipment}
        equipmentsList={equipments}
        onSuccess={() => {
          refetch();
          if (selectedEquipment) {
            getEquipmentById(selectedEquipment.equipmentId)
              .then((updated) => setSelectedEquipment(updated))
              .catch(() => {});
          }
        }}
      />
    </main>
  );
}
</file>

<file path="frontend/src/app/inventory/tasks/page.tsx">
'use client';

import { useAuth } from '@clerk/nextjs';
import Link from 'next/link';
import { ClipboardList, Loader2, PlayCircle, ArrowLeft, Package, Layers, MapPin } from 'lucide-react';
import { useMyTasks } from '@/hooks/use-inventory';
import { usePermissions } from '@/hooks/use-permissions';

export default function MyTasksPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const { user, authUser, isLoading: isUserLoading } = usePermissions();
  const currentUserId = user?.userId || authUser?.userId;
  
  const { data: tasks, isLoading: isTasksLoading } = useMyTasks(currentUserId);

  if (!isLoaded || isUserLoading || isTasksLoading) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
        <div className="flex items-center gap-2 text-xs font-mono text-[#aea69c]">
          <Loader2 className="w-4 h-4 animate-spin text-[#f7f5f0]" />
          <span>Chargement de vos tâches...</span>
        </div>
      </main>
    );
  }

  if (!isSignedIn) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
        <span className="text-sm">Connectez-vous pour voir vos tâches.</span>
      </main>
    );
  }

  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
      <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#3f3a36]">
          <div className="space-y-1">
            <div className="flex items-center gap-2 text-xs text-[#aea69c] mb-1 font-mono">
              <Link href="/inventory" className="hover:text-[#f7f5f0] transition-colors flex items-center gap-1">
                <ArrowLeft className="w-3 h-3" />
                Retour aux inventaires
              </Link>
            </div>
            <h1 className="text-xl sm:text-2xl font-normal tracking-tight text-[#f7f5f0]">
              Mes Tâches d'Inventaire
            </h1>
            <p className="text-xs text-[#c9c0ad]">
              Liste des comptages et adjudications qui vous sont assignés avec leurs articles et emplacements.
            </p>
          </div>
        </div>

        {!tasks || tasks.length === 0 ? (
          <div className="flex flex-col items-center justify-center py-20 border border-dashed border-[#3f3a36] rounded-[4px] bg-[#2f2a26]">
            <ClipboardList className="w-8 h-8 text-[#5c544d] mb-3" />
            <p className="text-sm text-[#aea69c]">Aucune tâche en attente.</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {tasks.map((task: any) => {
              const isByEquipment = task.unit?.inventory?.typeInventory === 'ByEquipment';
              const equipment = task.unit?.equipment;
              const shelf = task.unit?.shelf;
              const eqShelves = equipment?.equipmentShelfs || [];
              const totalShelfUnits = (shelf?.equipmentShelfs || []).reduce(
                (sum: number, es: any) => sum + (Number(es.equipmentQuantity) || 0),
                0
              );
              const displayShelfQty = totalShelfUnits > 0 ? totalShelfUnits : (shelf?.shelfQuantity ?? 0);

              return (
                <div
                  key={task.attemptId}
                  className="p-4 rounded-[4px] border border-[#3f3a36] bg-[#2f2a26] flex flex-col justify-between hover:border-[#aea69c] transition-colors space-y-4"
                >
                  <div className="space-y-3">
                    {/* Card Header: Inventory Title + Badges */}
                    <div className="flex justify-between items-start gap-2">
                      <div>
                        <h3 className="font-semibold text-sm text-[#f7f5f0]">
                          {task.unit?.inventory?.title || 'Inventaire sans titre'}
                        </h3>
                        <span className="text-[10px] font-mono text-[#aea69c]">
                          {isByEquipment ? 'Mode: Par Article' : 'Mode: Par Emplacement'}
                        </span>
                      </div>
                      <div className="flex items-center gap-1.5 shrink-0">
                        <span className="text-[10px] font-mono px-2 py-0.5 rounded-[2px] bg-[#383330] text-[#aea69c] border border-[#3f3a36]">
                          {task.purpose === 'INITIAL' ? 'COMPTAGE' : 'ADJUDICATION'}
                        </span>
                      </div>
                    </div>

                    {/* Equipment / Target Section */}
                    {isByEquipment && equipment && (
                      <div className="p-3 bg-[#26221f] rounded-[3px] border border-[#3f3a36] space-y-2">
                        <div className="flex items-center justify-between gap-2">
                          <div className="flex items-center gap-2">
                            <Package className="w-3.5 h-3.5 text-[#10b981] shrink-0" />
                            <span className="text-xs font-medium text-[#f7f5f0] line-clamp-1">
                              {equipment.equipmentName}
                            </span>
                          </div>
                          <span className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#383330] text-[#aea69c] border border-[#3f3a36]">
                            Comptage à l'aveugle
                          </span>
                        </div>

                        {/* Shelves List for this Equipment */}
                        <div className="space-y-1 pt-1 border-t border-[#3f3a36]/60">
                          <span className="text-[10px] font-mono text-[#aea69c] uppercase flex items-center gap-1">
                            <MapPin className="w-3 h-3 text-[#10b981]" />
                            Emplacements à vérifier ({eqShelves.length}) :
                          </span>
                          {eqShelves.length > 0 ? (
                            <div className="flex flex-wrap gap-1.5 pt-0.5">
                              {eqShelves.map((es: any) => (
                                <span
                                  key={es.equipmentShelfId || es.shelfId}
                                  className="text-[10px] font-mono px-2 py-0.5 rounded bg-[#383330] border border-[#3f3a36] text-[#f7f5f0] flex items-center gap-1"
                                >
                                  <span>{es.shelf?.shelfName || 'Emplacement'}</span>
                                </span>
                              ))}
                            </div>
                          ) : (
                            <p className="text-[10px] text-[#8c827a] italic">
                              Stock global non encore réparti sur emplacement spécifique.
                            </p>
                          )}
                        </div>
                      </div>
                    )}

                    {/* ByShelf Target Section */}
                    {!isByEquipment && shelf && (
                      <div className="p-3 bg-[#26221f] rounded-[3px] border border-[#3f3a36] space-y-2">
                        <div className="flex items-center justify-between gap-2">
                          <div className="flex items-center gap-2">
                            <Layers className="w-3.5 h-3.5 text-[#10b981] shrink-0" />
                            <span className="text-xs font-medium text-[#f7f5f0]">
                              Emplacement : {shelf.shelfName}
                            </span>
                          </div>
                          <span className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#383330] text-[#aea69c] border border-[#3f3a36]">
                            Comptage à l'aveugle
                          </span>
                        </div>

                        {shelf.equipmentShelfs && shelf.equipmentShelfs.length > 0 && (
                          <div className="space-y-1 pt-1 border-t border-[#3f3a36]/60">
                            <span className="text-[10px] font-mono text-[#aea69c] uppercase">
                              Articles attendus sur cet emplacement ({shelf.equipmentShelfs.length}) :
                            </span>
                            <div className="flex flex-wrap gap-1.5 pt-0.5">
                              {shelf.equipmentShelfs.map((es: any) => (
                                <span
                                  key={es.equipmentShelfId || es.equipmentId}
                                  className="text-[10px] font-mono px-2 py-0.5 rounded bg-[#383330] border border-[#3f3a36] text-[#f7f5f0]"
                                >
                                  {es.equipment?.equipmentName}
                                </span>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    )}

                    <div className="flex items-center justify-between text-xs text-[#aea69c] pt-1">
                      <span>Statut: <strong className="text-[#f7f5f0]">{task.status}</strong></span>
                      <span className="font-mono text-[10px]">
                        {task.sequence === 0 ? '1er Contrôleur' : task.sequence === 1 ? '2ème Contrôleur' : 'Contrôleur Final'}
                      </span>
                    </div>
                  </div>

                  <div className="pt-3 border-t border-[#3f3a36] flex justify-end gap-2">
                    <Link
                      href={`/inventory/tasks/${task.attemptId}`}
                      className="inline-flex items-center gap-2 text-xs bg-[#f7f5f0] text-[#2b2622] px-3.5 py-1.5 rounded-[3px] font-medium transition-colors hover:bg-[#dad2c1] shadow-xs cursor-pointer"
                    >
                      <PlayCircle className="w-3.5 h-3.5" />
                      Exécuter
                    </Link>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </main>
  );
}
</file>

<file path="frontend/src/app/shelves/page.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';
import { useState } from 'react';
import { useAuth, SignInButton } from '@clerk/nextjs';
import Link from 'next/link';
import {
  Layers,
  Plus,
  ShieldCheck,
  ShieldAlert,
  Loader2,
} from 'lucide-react';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { CreateShelfModal } from '@/components/shelf/CreateShelfModal';
import { ShelfListTable } from '@/components/shelf/ShelfListTable';
import { ShelfDetailModal } from '@/components/shelf/ShelfDetailModal';
import { UpdateShelfModal } from '@/components/shelf/UpdateShelfModal';
import { DeleteShelfModal } from '@/components/shelf/DeleteShelfModal';
import { Shelf } from '@/types/shelf';
import { toast } from 'sonner';

export default function ShelvesPage() {
  const { isSignedIn, isLoaded } = useAuth();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [selectedShelf, setSelectedShelf] = useState<Shelf | null>(null);
  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false);
  const [isLookingUp, setIsLookingUp] = useState(false);

  // States for Update and Delete modals
  const [updatingShelf, setUpdatingShelf] = useState<Shelf | null>(null);
  const [isUpdateModalOpen, setIsUpdateModalOpen] = useState(false);
  const [deletingShelf, setDeletingShelf] = useState<Shelf | null>(null);
  const [isDeleteModalOpen, setIsDeleteModalOpen] = useState(false);

  const {
    shelves,
    totalShelves,
    totalPages,
    currentPage,
    limit,
    searchTerm,
    setSearchTerm,
    setPage,
    setLimit,
    isLoading: isShelvesLoading,
    refetch,
    getShelfById,
    canCreateShelf,
  } = useShelves({ page: 1, limit: 10 });

  const { canUpdateShelf, canDeleteShelf } = usePermissions();

  const handleSelectShelf = (shelf: Shelf) => {
    setSelectedShelf(shelf);
    setIsDetailModalOpen(true);
  };

  const handleLookupById = async (id: string) => {
    setIsLookingUp(true);
    try {
      const shelf = await getShelfById(id);
      setSelectedShelf(shelf);
      setIsDetailModalOpen(true);
      toast.success(`Emplacement trouvé : ${shelf.shelfName ?? shelf.shelfId}`);
    } catch (err: unknown) {
      toast.error('Recherche par ID échouée', {
        description: getErrorMessage(err, `L'emplacement avec le GUID '${id}' est introuvable.`),
      });
    } finally {
      setIsLookingUp(false);
    }
  };

  if (!isLoaded) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-[#2b2622] text-[#f7f5f0]">
        <div className="flex items-center gap-2 text-xs font-mono text-[#aea69c]">
          <Loader2 className="w-4 h-4 animate-spin text-[#f7f5f0]" />
          <span>Chargement des emplacements...</span>
        </div>
      </main>
    );
  }

  if (!isSignedIn) {
    return (
      <main className="min-h-screen flex items-center justify-center p-6 bg-[#2b2622] text-[#f7f5f0]">
        <div className="w-full max-w-md bg-[#383330] border border-[#3f3a36] rounded-[4px] p-8 shadow-xl text-center space-y-4">
          <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0] mx-auto">
            <Layers className="w-5 h-5" />
          </div>
          <div className="space-y-1">
            <h1 className="text-base font-medium text-[#f7f5f0]">Connexion requise</h1>
            <p className="text-xs text-[#c9c0ad]">
              Veuillez vous connecter pour accéder au registre des emplacements SomePharm.
            </p>
          </div>
          <div className="flex flex-col sm:flex-row gap-2 pt-2">
            <SignInButton mode="modal">
              <button
                type="button"
                className="flex-1 px-4 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
              >
                Se connecter
              </button>
            </SignInButton>
            <Link
              href="/"
              className="flex-1 inline-flex items-center justify-center px-4 py-2 bg-[#2b2622] hover:bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors"
            >
              Accueil
            </Link>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
      {/* Main Workspace Body */}
      <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
        {/* Page Hero Section */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#3f3a36]">
          <div className="space-y-1">
            <div className="flex items-center gap-2 text-xs text-[#aea69c] mb-1 font-mono">
              <Link href="/" className="hover:text-[#f7f5f0] transition-colors">
                somepharm
              </Link>
              <span>/</span>
              <span className="text-[#f7f5f0]">emplacements</span>
            </div>
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-xl sm:text-2xl font-normal tracking-tight text-[#f7f5f0]">
                Gestion des Emplacements
              </h1>
              <div className="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] font-mono text-[10px] bg-[#383330] border border-[#3f3a36] text-[#c9c0ad]">
                {canCreateShelf ? (
                  <>
                    <ShieldCheck className="w-3 h-3 text-[#10b981]" />
                    <span>Création autorisée</span>
                  </>
                ) : (
                  <>
                    <ShieldAlert className="w-3 h-3 text-[#f59e0b]" />
                    <span>Lecture seule</span>
                  </>
                )}
              </div>
            </div>
            <p className="text-xs text-[#c9c0ad]">
              Gestion et suivi des emplacements de stockage.
            </p>
          </div>

          {/* Action CTA: Warp button-primary */}
          <button
            type="button"
            onClick={() => setIsModalOpen(true)}
            className="inline-flex items-center justify-center gap-2 px-3.5 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-medium rounded-[3px] shadow-xs transition-colors cursor-pointer shrink-0"
          >
            <Plus className="w-3.5 h-3.5" />
            <span>Nouvel emplacement</span>
          </button>
        </div>

        {/* Shelf List Table Component with Pagination, Search by Name, and Single Shelf Lookup */}
        <ShelfListTable
          shelves={shelves}
          totalShelves={totalShelves}
          totalPages={totalPages}
          currentPage={currentPage}
          limit={limit}
          searchTerm={searchTerm}
          onSearchChange={setSearchTerm}
          onPageChange={setPage}
          onLimitChange={(newLimit) => {
            setLimit(newLimit);
            setPage(1);
          }}
          onSelectShelf={handleSelectShelf}
          onLookupById={handleLookupById}
          onOpenUpdate={(shelf) => {
            setUpdatingShelf(shelf);
            setIsUpdateModalOpen(true);
          }}
          onOpenDelete={(shelf) => {
            setDeletingShelf(shelf);
            setIsDeleteModalOpen(true);
          }}
          isLoading={isShelvesLoading}
          onRefresh={refetch}
          onOpenCreateModal={() => setIsModalOpen(true)}
          canCreateShelf={canCreateShelf}
          canUpdateShelf={canUpdateShelf}
          canDeleteShelf={canDeleteShelf}
        />
      </div>

      {/* Creation Modal Component */}
      <CreateShelfModal
        isOpen={isModalOpen}
        onClose={() => setIsModalOpen(false)}
        onSuccess={() => refetch()}
      />

      {/* Single Shelf Detail Modal */}
      <ShelfDetailModal
        shelf={selectedShelf}
        isOpen={isDetailModalOpen}
        onClose={() => {
          setIsDetailModalOpen(false);
          setSelectedShelf(null);
        }}
        onRefresh={refetch}
        onOpenUpdate={(shelf) => {
          setIsDetailModalOpen(false);
          setUpdatingShelf(shelf);
          setIsUpdateModalOpen(true);
        }}
        onOpenDelete={(shelf) => {
          setIsDetailModalOpen(false);
          setDeletingShelf(shelf);
          setIsDeleteModalOpen(true);
        }}
        canUpdateShelf={canUpdateShelf}
        canDeleteShelf={canDeleteShelf}
        isLoading={isLookingUp}
      />

      {/* Update Shelf Modal Component */}
      <UpdateShelfModal
        shelf={updatingShelf}
        isOpen={isUpdateModalOpen}
        onClose={() => {
          setIsUpdateModalOpen(false);
          setUpdatingShelf(null);
        }}
        onSuccess={() => {
          refetch();
          if (updatingShelf) {
            getShelfById(updatingShelf.shelfId)
              .then((updated) => {
                setSelectedShelf(updated);
                setIsDetailModalOpen(true);
              })
              .catch(() => {});
          }
        }}
      />

      {/* Delete Shelf Modal Component */}
      <DeleteShelfModal
        shelf={deletingShelf}
        isOpen={isDeleteModalOpen}
        onClose={() => {
          setIsDeleteModalOpen(false);
          setDeletingShelf(null);
        }}
        onSuccess={() => {
          refetch();
          setIsDetailModalOpen(false);
          setSelectedShelf(null);
        }}
      />
    </main>
  );
}
</file>

