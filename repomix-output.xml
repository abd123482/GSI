      },
      inventoryInvestigationIssue: {
        create: vi.fn().mockImplementation((args) => Promise.resolve({ issueId: 'iss-1', ...args.data })),
        findUnique: vi.fn(),
        findMany: vi.fn().mockResolvedValue([]),
