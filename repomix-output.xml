<file path="frontend/src/app/globals.css">
@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-canvas: #2b2622;
  --color-canvas-soft: #383330;
  --color-hairline: #3f3a36;
  --color-hairline-light: #4d4742;
  --color-ink: #f7f5f0;
  --color-body-strong: #dad2c1;
  --color-body: #c9c0ad;
  --color-mute: #aea69c;
  --color-primary-warp: #f7f5f0;
  --color-on-primary-warp: #2b2622;

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-inter), system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: var(--font-dm-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  --font-serif: var(--font-instrument-serif), Georgia, "Times New Roman", serif;

  --radius-xs: 2px;
  --radius-sm: 3px;
  --radius-md: 4px;
  --radius-lg: 6px;
  --radius: 4px;
}

:root {
  /* Warp Warm Near-Charcoal Palette by default */
  --background: #2b2622;
  --foreground: #f7f5f0;
  --card: #383330;
  --card-foreground: #f7f5f0;
  --popover: #383330;
  --popover-foreground: #f7f5f0;
  --primary: #f7f5f0;
  --primary-foreground: #2b2622;
  --secondary: #383330;
  --secondary-foreground: #f7f5f0;
  --muted: #383330;
  --muted-foreground: #aea69c;
  --accent: #3f3a36;
  --accent-foreground: #f7f5f0;
  --destructive: #ef4444;
  --border: #3f3a36;
  --input: #3f3a36;
  --ring: #f7f5f0;
  --radius: 4px;
}

@layer base {
  * {
    border-color: #3f3a36;
  }
  body {
    background-color: #2b2622;
    color: #f7f5f0;
    font-family: var(--font-inter), system-ui, sans-serif;
    letter-spacing: -0.01em;
  }
  html {
    color-scheme: dark;
  }
}

/* Warp Primitives & Utility Classes */
.bg-canvas {
  background-color: #2b2622;
}

.bg-canvas-soft {
  background-color: #383330;
}

.border-hairline {
  border-color: #3f3a36;
}

.text-ink {
  color: #f7f5f0;
}

.text-body-strong {
  color: #dad2c1;
}

.text-body {
  color: #c9c0ad;
}

.text-mute {
  color: #aea69c;
}

.font-serif-italic {
  font-family: var(--font-instrument-serif), Georgia, serif;
  font-style: italic;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #2b2622;
}
