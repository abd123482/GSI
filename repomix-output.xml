                    </div>
                  ) : (
                    renderedShelfIds.map((shelfId) => {
                      const shelf = shelves.shelves.find(
                        (s) => s.shelfId === shelfId,
                      );
                      const expected = expectedShelves.find(
                        (a: any) => a.shelfId === shelfId,
                      );
                      const isAdditional = !expected;
                      const rowsInShelf = serialRows.filter(
                        (r) => r.shelfId === shelfId,
