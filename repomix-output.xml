<file path="frontend/src/components/stock/UpdateStockModal.tsx">
'use client';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AlertCircle, Loader2, Save, ShieldAlert, Warehouse, X } from 'lucide-react';

import { updateStockSchema, type UpdateStockFormValues } from '@/schemas/stock.schema';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import type { Stock } from '@/types/stock';
import { getErrorMessage } from '@/lib/error-message';

interface UpdateStockModalProps {
  stock: Stock | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateStockModal(props: UpdateStockModalProps) {
  if (!props.isOpen || !props.stock) return null;
  return <UpdateStockModalContent key={`${props.stock.stockId}:${props.stock.status ?? true}`} {...props} />;
}

function UpdateStockModalContent({ stock, onClose, onSuccess }: UpdateStockModalProps) {
  const api = useApi();
  const { canUpdateStock, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);

  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<UpdateStockFormValues>({
    resolver: zodResolver(updateStockSchema),
    defaultValues: {
      stockName: stock?.stockName ?? '',
      stockStatus: stock?.status ?? true,
    },
  });

  if (!stock) return null;
  const currentStock = stock;
  const busy = saving || isSubmitting;

  async function submit(values: UpdateStockFormValues) {
    setServerError(null);
    if (!canUpdateStock) {
      setServerError(`Action interdite : votre rôle (${roleName ?? 'Utilisateur'}) ne permet pas de modifier ce stock.`);
      return;
    }

    try {
      setSaving(true);
      const payload: Record<string, any> = {};
      const trimmedName = values.stockName?.trim();
      if (trimmedName !== (currentStock.stockName ?? '')) {
        payload.stockName = trimmedName;
      }
      if (values.stockStatus !== currentStock.status) {
        payload.status = values.stockStatus;
      }

      if (Object.keys(payload).length > 0) {
        await StockService.updateStock(api, currentStock.stockId, payload);
      }
      
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setServerError(getErrorMessage(cause, 'Erreur lors de la modification du stock.'));
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-lg overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-5 py-4">
          <div className="flex items-center gap-3"><Warehouse className="h-5 w-5" /><div><h2 className="text-sm font-semibold">Modifier le stock</h2><p className="mt-0.5 text-[10px] text-white/45">{stock.stockName ?? 'Stock'}</p></div></div>
          <button type="button" onClick={onClose} disabled={busy} className="rounded p-1.5 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
        </header>

        {!canUpdateStock && <div className="flex gap-2 border-b border-amber-500/30 bg-amber-950/25 px-5 py-3 text-xs text-amber-200"><ShieldAlert className="h-4 w-4 shrink-0" />Permission stock.update requise.</div>}

        <form onSubmit={handleSubmit(submit)} className="space-y-5 p-5">
          {serverError && <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/30 p-3 text-xs text-rose-200"><AlertCircle className="h-4 w-4 shrink-0" />{serverError}</div>}
          <label className="block space-y-1.5"><span className="text-xs font-semibold">Nom du stock *</span><input {...register('stockName')} className="h-10 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50" />{errors.stockName && <p className="text-[11px] text-rose-300">{errors.stockName.message}</p>}</label>
          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Statut</span>
            <select 
              {...register('stockStatus')} 
              className="h-10 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
            >
              <option value="true">ACTIVE</option>
              <option 
                value="false" 
                disabled={stock.shelves?.some(s => s.status === true)}
                title={stock.shelves?.some(s => s.status === true) ? "Veuillez désactiver tous les emplacements avant de désactiver le stock" : undefined}
              >
                INACTIVE
              </option>
            </select>
            {stock.shelves?.some(s => s.status === true) && (
              <p className="text-[11px] text-amber-400">
                Impossible de désactiver un stock contenant des emplacements actifs.
              </p>
            )}
          </label>
          <div className="rounded-lg border border-[#3f3f46] bg-[#18181b]/55 p-3 text-xs text-[#d4d4d8]">
            Emplacements rattachés : <span className="font-mono text-white">{stock._count?.shelves ?? stock.shelves?.length ?? 0}</span>
            {stock.shelves?.some(s => s.status === true) && (
              <span className="ml-2 text-emerald-400">
                ({stock.shelves.filter(s => s.status === true).length} actifs)
              </span>
            )}
          </div>
          <footer className="flex justify-end gap-2 border-t border-[#3f3f46] pt-4"><button type="button" onClick={onClose} disabled={busy} className="rounded border border-[#3f3f46] px-4 py-2 text-xs">Annuler</button><button type="submit" disabled={busy || !canUpdateStock} className="inline-flex items-center gap-1.5 rounded bg-[#fafafa] px-4 py-2 text-xs font-semibold text-[#18181b] disabled:opacity-40">{busy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Save className="h-3.5 w-3.5" />}Enregistrer</button></footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="backend/src/dashboard/dashboard.service.ts">
import { Injectable } from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service.js';

export interface DashboardStatsResponse {
  stockOverview: {
    totalArticles: number;
    totalUnits: number;
    totalSerials: number;
    serialsWithShelf: number;
    lowStockCount: number;
    totalShelves: number;
    totalStocks: number;
    lowStockItems: Array<{
      equipmentId: string;
      equipmentName: string;
      equipmentQuantity: number;
      minequipmentQuantity: number;
    }>;
    stockDistribution: Array<{
      stockId: string;
      stockName: string;
      totalUnits: number;
      shelvesCount: number;
    }>;
  };
  movementOverview: {
    totalMovements: number;
    inCount: number;
    outCount: number;
    transferCount: number;
    mixedCount?: number;
    otherCount?: number;
    recentMovements: Array<{
      mouvementId: string;
      mouvementStatus: string | boolean;
      mouvementQuantity: number;
      equipmentName: string;
      sourceShelfName: string | null;
      destinationShelfName: string | null;
      serialNumberCode: string | null;
      items?: Array<{
        mouvementEquipmentId: string;
        mouvementStatus: string | boolean;
        mouvementQuantity: number;
        equipmentName: string;
        sourceShelfName: string | null;
        destinationShelfName: string | null;
        serialNumberCode: string | null;
      }>;
    }>;
  };
  inventoryOverview: {
    totalInventories: number;
    activeInventoriesCount: number;
    completedInventoriesCount: number;
    pendingAdjudications: number;
    activeCampaigns: Array<{
      inventoryId: string;
      title: string;
      typeInventory: string;
      status: string;
      createdAt: string | null;
      totalWorkUnits: number;
      completedWorkUnits: number;
      progressPercent: number;
    }>;
  };
}

@Injectable()
export class DashboardService {
  constructor(private readonly prisma: PrismaService) {}

  async getDashboardStats(): Promise<DashboardStatsResponse> {
    const [
      totalArticles,
      unitsAgg,
      totalSerials,
      serialsWithShelf,
      totalShelves,
      totalStocks,
      lowStockCountRaw,
      lowStockItemsRaw,
      stockDistributionRaw,
      totalMovements,
      movementsByType,
      recentMouvementsRaw,
      inventories,
      pendingAdjudicationsCount,
    ] = await Promise.all([
      this.prisma.equipment.count(),
      this.prisma.equipment.aggregate({
        _sum: { minequipmentQuantity: true },
      }).then(() => this.prisma.$queryRaw`
        SELECT SUM(
          CASE 
            WHEN destinationShelfId IS NOT NULL THEN equipmentQuantity 
            WHEN sourceShelfId IS NOT NULL THEN -equipmentQuantity 
            ELSE 0 
          END
        ) as total
        FROM dbo.MovementEquipment
      `).then((res: any) => ({ _sum: { equipmentQuantity: Number(res[0]?.total ?? 0) } })),
      this.prisma.serialNumber.count(),
      this.prisma.$queryRaw`
        WITH CurrentSerials AS (
          SELECT serialNumberId FROM (
            SELECT serialNumberId, CONVERT(bigint, equipmentQuantity) AS delta
            FROM dbo.MovementEquipment
            WHERE destinationShelfId IS NOT NULL AND serialNumberId IS NOT NULL
            UNION ALL
            SELECT serialNumberId, -CONVERT(bigint, equipmentQuantity) AS delta
            FROM dbo.MovementEquipment
            WHERE sourceShelfId IS NOT NULL AND serialNumberId IS NOT NULL
          ) AS entries
          GROUP BY serialNumberId HAVING SUM(delta) > 0
        )
        SELECT COUNT(*) as count FROM CurrentSerials
      `.then((res: any) => Number(res[0]?.count ?? 0)),
      this.prisma.shelf.count(),
      this.prisma.stock.count(),
      this.prisma.$queryRaw<Array<{ count: bigint | number }>>`
        WITH EquipmentStock AS (
          SELECT e.equipmentId, e.minequipmentQuantity,
            SUM(CASE WHEN m.destinationShelfId IS NOT NULL THEN m.equipmentQuantity ELSE 0 END) -
            SUM(CASE WHEN m.sourceShelfId IS NOT NULL THEN m.equipmentQuantity ELSE 0 END) AS equipmentQuantity
          FROM dbo.Equipment e
          LEFT JOIN dbo.MovementEquipment m ON e.equipmentId = m.equipmentId
          GROUP BY e.equipmentId, e.minequipmentQuantity
        )
        SELECT COUNT(*) as [count] 
        FROM EquipmentStock 
        WHERE equipmentQuantity <= minequipmentQuantity AND minequipmentQuantity > 0
      `,
      this.prisma.$queryRaw<Array<{
        equipmentId: string;
        equipmentName: string;
        equipmentQuantity: number;
        minequipmentQuantity: number;
      }>>`
        WITH EquipmentStock AS (
          SELECT e.equipmentId, e.equipmentName, e.minequipmentQuantity,
            SUM(CASE WHEN m.destinationShelfId IS NOT NULL THEN m.equipmentQuantity ELSE 0 END) -
            SUM(CASE WHEN m.sourceShelfId IS NOT NULL THEN m.equipmentQuantity ELSE 0 END) AS equipmentQuantity
          FROM dbo.Equipment e
          LEFT JOIN dbo.MovementEquipment m ON e.equipmentId = m.equipmentId
          GROUP BY e.equipmentId, e.equipmentName, e.minequipmentQuantity
        )
        SELECT TOP 5 equipmentId, equipmentName, COALESCE(equipmentQuantity, 0) as equipmentQuantity, minequipmentQuantity 
        FROM EquipmentStock 
        WHERE equipmentQuantity <= minequipmentQuantity AND minequipmentQuantity > 0
        ORDER BY equipmentQuantity ASC
      `,
      this.prisma.$queryRaw<Array<{
        stockId: string;
        stockName: string;
        shelvesCount: bigint | number;
        totalUnits: bigint | number;
      }>>`
        SELECT s.stockId, COALESCE(s.stockName, 'Stock Principal') as stockName,
               COUNT(DISTINCT sh.shelfId) as shelvesCount,
               COALESCE(SUM(
                  CASE WHEN m.destinationShelfId = sh.shelfId THEN m.equipmentQuantity ELSE 0 END
               ) - SUM(
                  CASE WHEN m.sourceShelfId = sh.shelfId THEN m.equipmentQuantity ELSE 0 END
               ), 0) as totalUnits
        FROM dbo.Stock s
        LEFT JOIN dbo.Shelf sh ON s.stockId = sh.stockId
        LEFT JOIN dbo.MovementEquipment m ON (m.destinationShelfId = sh.shelfId OR m.sourceShelfId = sh.shelfId)
        GROUP BY s.stockId, s.stockName
      `,
      this.prisma.mouvement.count(),
      this.prisma.mouvement.groupBy({
        by: ['mouvementStatus'],
        _count: { mouvementId: true },
      }),
      this.prisma.mouvement.findMany({
        take: 8,
        orderBy: [{ createdAt: 'desc' }, { mouvementId: 'asc' }],
        include: {
          items: { include: { equipment: true, sourceShelf: true, destinationShelf: true, serialNumber: true } },
          
        },
      }),
      this.prisma.inventory.findMany({
        take: 5,
        select: {
          inventoryId: true,
          title: true,
          typeInventory: true,
          status: true,
          createdAt: true,
          units: {
            select: { status: true },
          },
        },
        orderBy: { createdAt: 'desc' },
      }),
      this.prisma.inventoryUnit.count({
        where: { status: 'COUNTED' },
      }),
    ]);

    const lowStockCount = Number(lowStockCountRaw[0]?.count ?? 0);
    const lowStockItems = lowStockItemsRaw.map((item: any) => ({
      equipmentId: String(item.equipmentId),
      equipmentName: item.equipmentName,
      equipmentQuantity: Number(item.equipmentQuantity),
      minequipmentQuantity: Number(item.minequipmentQuantity),
    }));

    const stockDistribution = stockDistributionRaw.map((s: any) => ({
      stockId: String(s.stockId),
      stockName: s.stockName,
      totalUnits: Number(s.totalUnits),
      shelvesCount: Number(s.shelvesCount),
    }));

    // Compute Movement Stats
    let inCount = 0;
    let outCount = 0;
    let transferCount = 0;
    let mixedCount = 0;
    let otherCount = 0;
    for (const group of movementsByType) {
      const isOut = group.mouvementStatus;
      const count = group._count.mouvementId || 0;
      if (isOut) outCount += count;
      else inCount += count;
    }

    const recentMovements = recentMouvementsRaw.map((m: any) => ({
      mouvementId: m.mouvementId,
      mouvementStatus: m.mouvementStatus || 'TRANSFER',
      mouvementQuantity: m.mouvementQuantity ?? 1,
      equipmentName: (m.items.length ? [...new Set(m.items.map((item: any) => item.equipment.equipmentName))].join(', ') : m.equipment?.equipmentName) || 'Article non spécifié',
      sourceShelfName: (m.items.length ? [...new Set(m.items.map((item: any) => item.sourceShelf?.shelfName).filter(Boolean))].join(', ') : m.sourceShelf?.shelfName) || null,
      destinationShelfName: (m.items.length ? [...new Set(m.items.map((item: any) => item.destinationShelf?.shelfName).filter(Boolean))].join(', ') : m.destinationShelf?.shelfName) || null,
      serialNumberCode: m.items.length === 1 ? m.items[0].serialNumber?.serialNumberCode ?? null : m.serialNumber?.serialNumberCode ?? null,
      items: m.items.map((item: any) => ({
        mouvementEquipmentId: item.mouvementEquipmentId,
        mouvementStatus: item.mouvementStatus,
        mouvementQuantity: item.mouvementQuantity,
        equipmentName: item.equipment.equipmentName,
        sourceShelfName: item.sourceShelf?.shelfName ?? null,
        destinationShelfName: item.destinationShelf?.shelfName ?? null,
        serialNumberCode: item.serialNumber?.serialNumberCode ?? null,
      })),
    }));

    // Compute Inventory Stats
    const activeInventoriesList = inventories.map((inv: any) => {
      const unitsList = inv.units ?? inv.workUnits ?? [];
      const totalWorkUnits = unitsList.length;
      const completedWorkUnits = unitsList.filter((u: any) =>
        ['COUNTED', 'ADJUDICATED', 'FINALIZED'].includes(u.status.toUpperCase()),
      ).length;
      const progressPercent = totalWorkUnits > 0 ? Math.round((completedWorkUnits / totalWorkUnits) * 100) : 0;
      return {
        inventoryId: inv.inventoryId,
        title: inv.title || `Inventaire ${inv.typeInventory || ''}`,
        typeInventory: inv.typeInventory || 'Général',
        status: inv.status,
        createdAt: inv.createdAt ? inv.createdAt.toISOString() : null,
        totalWorkUnits,
        completedWorkUnits,
        progressPercent,
      };
    });

    const activeInventoriesCount = inventories.filter((inv: any) =>
      ['DRAFT', 'ACTIVE', 'IN_PROGRESS', 'ADJUDICATION'].includes(inv.status.toUpperCase()),
    ).length;

    const completedInventoriesCount = inventories.filter((inv: any) =>
      ['COMPLETED', 'FINALIZED'].includes(inv.status.toUpperCase()),
    ).length;

    return {
      stockOverview: {
        totalArticles,
        totalUnits: unitsAgg._sum.equipmentQuantity || 0,
        totalSerials,
        serialsWithShelf,
        lowStockCount,
        totalShelves,
        totalStocks,
        lowStockItems,
        stockDistribution,
      },
      movementOverview: {
        totalMovements,
        inCount,
        outCount,
        transferCount,
        mixedCount,
        otherCount,
        recentMovements,
      },
      inventoryOverview: {
        totalInventories: inventories.length,
        activeInventoriesCount,
        completedInventoriesCount,
        pendingAdjudications: pendingAdjudicationsCount,
        activeCampaigns: activeInventoriesList,
      },
    };
  }
}
