<file path="frontend/src/hooks/use-api.ts">
'use client';

import { useMemo } from 'react';
import { useAuth } from '@clerk/nextjs';
import axios, { AxiosInstance } from 'axios';
import { API_BASE_URL } from '@/lib/api';

/**
 * Reusable hook providing an Axios client that automatically fetches and
 * attaches the current Clerk session Bearer token for NestJS API requests.
 */
export function useApi(): AxiosInstance {
  const { getToken, isSignedIn } = useAuth();

  const api = useMemo(() => {
    const client = axios.create({
      baseURL: API_BASE_URL,
      headers: {
        'Content-Type': 'application/json',
      },
      timeout: 15000,
    });

    client.interceptors.request.use(
      async (config) => {
        if (!isSignedIn) {
          return Promise.reject(new Error('User is not signed in'));
        }
        
        try {
          const token = await getToken();
          if (token) {
            if (config.headers && typeof config.headers.set === 'function') {
              config.headers.set('Authorization', `Bearer ${token}`);
            } else {
              config.headers.Authorization = `Bearer ${token}`;
            }
          } else {
            return Promise.reject(new Error('Failed to acquire Clerk token'));
          }
        } catch (err) {
          console.error('[useApi] Error acquiring Clerk session token:', err);
          return Promise.reject(err);
        }
        
        return config;
      },
      (error) => Promise.reject(error),
    );
    
    client.interceptors.response.use(
      (response) => response,
      async (error) => {
        const originalRequest = error.config;
        
        // Single retry for 401s
        if (error.response?.status === 401 && originalRequest && !originalRequest._retry) {
          originalRequest._retry = true;
          try {
            // Force a refresh of the token by skipping the cache if possible
            // We pass { skipCache: true } if supported, otherwise just re-request
            const token = await getToken();
            if (token) {
              if (originalRequest.headers && typeof originalRequest.headers.set === 'function') {
                originalRequest.headers.set('Authorization', `Bearer ${token}`);
              } else {
                originalRequest.headers.Authorization = `Bearer ${token}`;
              }
              return client(originalRequest);
            }
          } catch (e) {
            return Promise.reject(e);
          }
        }
        
        return Promise.reject(error);
      }
    );

    return client;
  }, [getToken, isSignedIn]);

  return api;
}
</file>

<file path="frontend/src/hooks/use-serial-numbers.ts">
'use client';

import {
  keepPreviousData,
  useMutation,
  useQuery,
  useQueryClient,
} from '@tanstack/react-query';
import {
  toast,
} from 'sonner';

import {
  useApi,
} from '@/hooks/use-api';
import {
  useAuthQueryContext,
} from '@/hooks/use-auth-query-context';
import {
  usePermissions,
} from '@/hooks/use-permissions';
import {
  getErrorMessage,
} from '@/lib/error-message';

import {
  SerialNumberService,
  type CreateBatchSerialNumbersInput,
  type CreateSerialNumberInput,
  type SerialNumberQuery,
  type UpdateSerialNumberInput,
} from '@/services/serial-number.service';

export function useSerialNumbers(
  query: SerialNumberQuery = {},
  enabled = true,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  const {
    permissions,
  } = usePermissions();

  const normalizedQuery:
    SerialNumberQuery = {
      page:
        query.page ?? 1,
      limit:
        query.limit ?? 20,
      serialNumberCode:
        query.serialNumberCode,
      serialNumberStatus:
        query.serialNumberStatus,
      equipmentId:
        query.equipmentId,
      shelfId:
        query.shelfId,
    };

  return useQuery({
    queryKey: [
      'serial-numbers',
      normalizedQuery, userId],

    queryFn: () =>
      SerialNumberService.getSerialNumbers(
        api,
        normalizedQuery,
        permissions,
      ),

    enabled,

    placeholderData:
      keepPreviousData,

    staleTime: 20_000,
  });
}

export function useCreateSerialNumber() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  return useMutation({
    mutationFn: (
      input: CreateSerialNumberInput,
    ) =>
      SerialNumberService.createSerialNumber(
        api,
        input,
        permissions,
      ),

    onSuccess:
      async (serial) => {
        await Promise.all([
          queryClient.invalidateQueries({
            queryKey: [
              'serial-numbers', userId],
          }),
          queryClient.invalidateQueries({
            queryKey: [
              'equipments', userId],
          }),
        ]);

        toast.success(
          'Numéro de série créé',
          {
            description:
              serial.serialNumberCode,
          },
        );
      },

    onError: (
      error: unknown,
    ) => {
      toast.error(
        'Création impossible',
        {
          description:
            getErrorMessage(
              error,
              'Impossible de créer le numéro de série.',
            ),
        },
      );
    },
  });
}

export function useCreateBatchSerialNumbers() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  return useMutation({
    mutationFn: (
