                                        }
                                        placeholder="Code série observé (ex: SN-...)"
                                        className="h-9 flex-1 rounded border border-[#3f3a36] bg-[#1f1b18] px-3 font-mono text-xs text-white focus:border-amber-500 focus:outline-none"
