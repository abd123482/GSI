                      select: {
                        userId: true,
                        userName: true,
                      },
                    },
                  },
                },
              },
              orderBy: { createdAt: 'asc' },
            },
            acceptedCount: true,
            equipment: true,
            shelf: true,
          },
        },
      },
    });

    if (!inventory) {
      throw new NotFoundException('Inventaire introuvable');
    }

    return {
      ...inventory,
