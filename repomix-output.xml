                  : 'Standard'
              }
              icon={
                <Barcode className="h-3.5 w-3.5" />
              }
            />

            <Stat
              label="Statut"
              value={
                equipment.equipmentStatus ? 'Actif' : 'Inactif'
              }
            />
          </div>

          <section className="overflow-hidden rounded-xl border border-[#3f3a36] bg-[#2b2622]/55">
            <div className="border-b border-[#3f3a36] px-4 py-3">
              <h3 className="text-xs font-semibold">Répartition par emplacement</h3>
              <p className="mt-0.5 text-[10px] text-white/45">
                Où se trouve actuellement cet article.
              </p>
            </div>
            
            {allocationQuery.isLoading || (serialized && allSerialsQuery.isLoading) ? (
              <div className="flex justify-center p-8"><Loader2 className="h-5 w-5 animate-spin text-white/40" /></div>
            ) : (
              <div className="divide-y divide-[#3f3a36]">
                {(allocationQuery.data?.equipmentShelfs ?? []).map((alloc) => (
                  <div key={alloc.equipmentShelfId} className="px-4 py-3 text-xs">
                    <div className="flex items-center justify-between gap-3">
                      <span className="font-semibold text-white/80">{alloc.shelf?.shelfName ?? 'Emplacement inconnu'}</span>
                      <span className="font-mono">{alloc.equipmentQuantity} u.</span>
                    </div>
                    {serialized && allSerialsQuery.data && (
                      <div className="mt-2 flex flex-wrap gap-1.5">
                        {allSerialsQuery.data
                          .filter(s => s.shelfId === alloc.shelfId)
                          .map(s => (
                            <span key={s.serialNumberId} className="rounded bg-[#1f1b18] px-1.5 py-0.5 font-mono text-[10px] text-white/60 border border-[#3f3a36]">
                              {s.serialNumberCode}
                            </span>
                          ))}
                        {allSerialsQuery.data.filter(s => s.shelfId === alloc.shelfId).length === 0 && (
                          <span className="text-[10px] text-white/30 italic">Aucun numéro de série alloué ici</span>
                        )}
                      </div>
                    )}
                  </div>
                ))}
                {!allocationQuery.data?.equipmentShelfs?.length && (
                  <div className="px-4 py-6 text-center text-xs text-white/45">Aucun emplacement alloué.</div>
                )}
              </div>
            )}
          </section>

          {serialized && (
            <section className="overflow-hidden rounded-xl border border-[#3f3a36] bg-[#2b2622]/55">
              <div className="space-y-3 border-b border-[#3f3a36] px-4 py-3">
                <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h3 className="text-xs font-semibold">
                      Numéros de série
                    </h3>

                    <p className="mt-0.5 text-[10px] text-white/45">
                      Le code est immuable après création. Seul le statut peut être modifié.
                    </p>
                  </div>

                  <div className="relative sm:w-64">
                    <Search className="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-white/40" />

                    <input
                      value={
                        serialSearch
                      }
                      onChange={(
                        event,
                      ) => {
                        setSerialSearch(
                          event.target
                            .value,
                        );
                        setSerialPage(
                          1,
                        );
                      }}
                      placeholder="Rechercher un S/N..."
                      className="h-8 w-full rounded border border-[#3f3a36] bg-[#1f1b18] pl-8 pr-2 text-xs"
                    />
                  </div>
                </div>

                {canCreateSerialNumber && (
                  <div className="flex gap-2">
                    <input
                      value={
                        newSerialCode
                      }
                      onChange={(
                        event,
                      ) =>
                        setNewSerialCode(
                          event.target
                            .value,
                        )
                      }
                      placeholder="Saisir manuellement le nouveau code série"
                      className="h-9 min-w-0 flex-1 rounded border border-[#3f3a36] bg-[#1f1b18] px-3 font-mono text-xs"
                    />

                    <button
                      type="button"
                      onClick={() => {
                        void addSerial();
                      }}
                      disabled={
                        !newSerialCode.trim() ||
                        createSerial.isPending
                      }
                      className="inline-flex items-center gap-1.5 rounded bg-[#f7f5f0] px-3 text-xs font-semibold text-[#2b2622] disabled:opacity-40"
                    >
                      <Plus className="h-3.5 w-3.5" />
                      Ajouter
                    </button>
                  </div>
                )}
              </div>

              {serialQuery.isLoading ? (
                <LoadingRow text="Chargement des numéros de série..." />
              ) : (
                <>
                  <div className="divide-y divide-[#3f3a36]">
                    {(serialQuery.data
                      ?.serialNumbers ??
                      []).map(
                      (serial) => (
                        <div
                          key={
                            serial.serialNumberId
                          }
                          className="flex items-center justify-between gap-3 px-4 py-3 text-xs"
                        >
                          <div className="min-w-0">
                            <p className="truncate font-mono font-semibold">
                              {
                                serial.serialNumberCode
                              }
                            </p>

                            <p className="mt-0.5 text-[9px] text-white/40">
                              {
                                serial.serialNumberStatus
                              }
                            </p>
                          </div>

                          {canUpdateSerialNumber &&
                            onEditSerialNumber && (
                              <button
                                type="button"
                                onClick={() =>
                                  onEditSerialNumber(
                                    serial,
                                  )
                                }
                                className="inline-flex items-center gap-1 rounded border border-[#4a4540] px-2.5 py-1.5 text-[10px] text-[#c9c0ad] hover:text-white"
                              >
                                <Pencil className="h-3 w-3" />
                                Statut
                              </button>
                            )}
                        </div>
                      ),
                    )}

                    {!serialQuery.data
                      ?.serialNumbers
                      ?.length && (
                      <div className="px-4 py-8 text-center text-xs text-white/45">
                        Aucun numéro de série.
                      </div>
                    )}
                  </div>

                  <Pager
                    page={
                      serialQuery.data
                        ?.currentPage ??
                      serialPage
                    }
                    totalPages={
                      serialQuery.data
                        ?.totalPages ??
                      1
                    }
                    onPage={
                      setSerialPage
                    }
                  />
                </>
              )}
            </section>
          )}

          <section className="overflow-hidden rounded-xl border border-[#3f3a36] bg-[#2b2622]/55">
            <div className="border-b border-[#3f3a36] px-4 py-3">
              <h3 className="text-xs font-semibold">
                Historique des mouvements
              </h3>

              <p className="mt-0.5 text-[10px] text-white/45">
                Consultation uniquement. Aucun mouvement ne se crée depuis la fiche article.
              </p>
            </div>

            {movementQuery.isLoading ? (
              <LoadingRow text="Chargement des mouvements..." />
            ) : (
              <>
                <div className="divide-y divide-[#3f3a36]">
                  {(movementQuery.data
                    ?.movements ??
                    []).map(
                    (movement) => {
                      const descriptor =
                        movementLabel(
                          movement,
                        );

                      const Icon =
                        descriptor.icon;

                      const line =
                        movement.items?.find(
                          (item) =>
                            item.equipmentId
                              .toLowerCase() ===
                            equipment.equipmentId
                              .toLowerCase(),
                        );

                      const quantity =
                        line
                          ?.mouvementQuantity ??
                        movement.mouvementQuantity ??
                        0;

                      return (
                        <div
                          key={
                            movement.mouvementId
                          }
                          className="grid grid-cols-[100px_minmax(0,1fr)_70px] items-center gap-3 px-4 py-3 text-xs"
                        >
                          <span className="inline-flex items-center gap-1 text-white/70">
                            <Icon className="h-3.5 w-3.5" />
                            {
                              descriptor.text
                            }
                          </span>

                          <div className="min-w-0">
                            <p className="truncate text-white/75">
                              {movement
                                .sourceShelf
                                ?.shelfName ??
                                'Extérieur'}
                              {' → '}
                              {movement
                                .destinationShelf
                                ?.shelfName ??
                                'Extérieur'}
                            </p>

                            <p className="mt-0.5 text-[9px] text-white/35">
                              {formatDate(
                                movement.createdAt,
                              )}
                            </p>
                          </div>

                          <span className="text-right font-mono font-semibold">
                            {
                              quantity
                            }{' '}
                            u.
                          </span>
                        </div>
                      );
                    },
                  )}

                  {!movementQuery.data
                    ?.movements
                    ?.length && (
                    <div className="px-4 py-8 text-center text-xs text-white/45">
                      Aucun mouvement enregistré.
                    </div>
                  )}
                </div>

                <Pager
                  page={
                    movementQuery.data
                      ?.currentPage ??
                    movementPage
                  }
                  totalPages={
                    movementQuery.data
                      ?.totalPages ??
                    1
                  }
                  onPage={
                    setMovementPage
                  }
                />
              </>
            )}
          </section>
        </div>

        <footer className="flex justify-end border-t border-[#3f3a36] bg-[#26221f] px-5 py-3">
          <button
            type="button"
            onClick={onClose}
            className="rounded bg-[#f7f5f0] px-4 py-2 text-xs font-semibold text-[#2b2622]"
          >
            Fermer
          </button>
        </footer>
      </div>
    </div>
  );
}

function Stat({
  label,
  value,
  icon,
}: {
  label: string;
  value: string;
  icon?: React.ReactNode;
}) {
  return (
    <div className="rounded-lg border border-[#3f3a36] bg-[#2b2622]/65 p-3">
      <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-white/40">
        {icon}
        {label}
      </div>

      <p className="mt-2 text-sm font-semibold">
        {value}
      </p>
    </div>
  );
}

function LoadingRow({
  text,
}: {
  text: string;
}) {
  return (
    <div className="flex items-center justify-center gap-2 px-4 py-7 text-xs text-white/45">
      <Loader2 className="h-4 w-4 animate-spin" />
      {text}
    </div>
  );
}

function Pager({
  page,
  totalPages,
  onPage,
}: {
  page: number;
  totalPages: number;
  onPage: (
    page: number,
  ) => void;
}) {
  if (
    totalPages <= 1
  ) {
    return null;
  }

  return (
    <div className="flex items-center justify-end gap-2 border-t border-[#3f3a36] px-4 py-2">
      <button
        type="button"
        disabled={
          page <= 1
        }
        onClick={() =>
          onPage(
            page - 1,
          )
        }
        className="rounded border border-[#3f3a36] px-2 py-1 text-[10px] disabled:opacity-30"
      >
        Préc.
      </button>

      <span className="text-[10px] text-white/45">
        {page} /{' '}
        {totalPages}
      </span>

      <button
        type="button"
        disabled={
          page >= totalPages
        }
        onClick={() =>
          onPage(
            page + 1,
          )
        }
        className="rounded border border-[#3f3a36] px-2 py-1 text-[10px] disabled:opacity-30"
      >
        Suiv.
      </button>
    </div>
  );
}
</file>

<file path="src/components/equipment/EquipmentListTable.tsx">
'use client';

import {
  ChevronLeft,
  ChevronRight,
  Eye,
  PackagePlus,
  Pencil,
  RefreshCw,
  Search,
  Trash2,
} from 'lucide-react';

import type {
  Equipment,
  EquipmentStatus,
} from '@/types/equipment';

interface EquipmentListTableProps {
  equipments: Equipment[];
  totalEquipments: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  equipmentStatus?:
  | EquipmentStatus;
  hasSerialNumber?:
  | boolean;

  onSearchChange: (
    value: string,
  ) => void;

  onEquipmentStatusChange: (
    value:
      | EquipmentStatus
      | undefined,
  ) => void;

  onSerialModeChange: (
    value:
      | boolean
      | undefined,
  ) => void;

  onPageChange: (
    page: number,
  ) => void;

  onLimitChange: (
    limit: number,
  ) => void;

  onSelectEquipment: (
    equipment: Equipment,
  ) => void;

  onEditEquipment?: (
    equipment: Equipment,
  ) => void;

  onDeleteEquipment?: (
    equipment: Equipment,
  ) => void;

  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateEquipment: boolean;
  canUpdateEquipment?: boolean;
  canDeleteEquipment?: boolean;
}

export function EquipmentListTable({
  equipments,
  totalEquipments,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  equipmentStatus,
  hasSerialNumber,
  onSearchChange,
  onEquipmentStatusChange,
  onSerialModeChange,
  onPageChange,
  onLimitChange,
  onSelectEquipment,
  onEditEquipment,
  onDeleteEquipment,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateEquipment,
  canUpdateEquipment = true,
  canDeleteEquipment = true,
}: EquipmentListTableProps) {
  return (
    <div className="overflow-hidden rounded-lg border border-[#3f3a36] bg-[#383330]">
      <div className="flex flex-col gap-3 border-b border-[#3f3a36] p-3 xl:flex-row xl:items-center xl:justify-between">
        <div className="relative w-full max-w-lg">
          <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#aea69c]" />

          <input
            value={searchTerm}
            onChange={(event) =>
              onSearchChange(
                event.target.value,
              )
            }
            placeholder="Rechercher par nom d’article..."
            className="h-9 w-full rounded border border-[#3f3a36] bg-[#2b2622] pl-9 pr-3 text-xs outline-none placeholder:text-[#aea69c]"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <select
            value={
              equipmentStatus === undefined
                ? 'ALL'
                : equipmentStatus
                  ? 'true'
                  : 'false'
            }
            onChange={(event) =>
              onEquipmentStatusChange(
                event.target.value ===
                  'ALL'
                  ? undefined
                  : event.target
                    .value === 'true',
              )
            }
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"
          >
            <option value="ALL">
              Tous les statuts
            </option>
            <option value="true">
              ACTIVE
            </option>
            <option value="false">
              INACTIVE
            </option>
          </select>

          <select
            value={
              hasSerialNumber ===
                undefined
                ? 'ALL'
                : hasSerialNumber
                  ? 'SERIALIZED'
                  : 'STANDARD'
            }
            onChange={(event) =>
              onSerialModeChange(
                event.target.value ===
                  'ALL'
                  ? undefined
                  : event.target
                    .value ===
                  'SERIALIZED',
              )
            }
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"
          >
            <option value="ALL">
              Tous les modes
            </option>
            <option value="STANDARD">
              Standard
            </option>
            <option value="SERIALIZED">
              Sérialisé
            </option>
          </select>

          <select
            value={limit}
            onChange={(event) =>
              onLimitChange(
                Number(
                  event.target.value,
                ),
              )
            }
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-2 text-xs"
          >
            <option value={10}>
              10 / page
            </option>
            <option value={20}>
              20 / page
            </option>
            <option value={50}>
              50 / page
            </option>
          </select>

          <button
            type="button"
            onClick={onRefresh}
            disabled={isLoading}
            className="inline-flex h-9 items-center gap-1.5 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs disabled:opacity-40"
          >
            <RefreshCw
              className={`h-3.5 w-3.5 ${isLoading
                  ? 'animate-spin'
                  : ''
                }`}
            />
            Actualiser
          </button>


        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead className="border-b border-[#3f3a36] bg-[#2b2622] text-[10px] uppercase tracking-wide text-[#aea69c]">
            <tr>
              <th className="px-4 py-3">
                Article
              </th>
              <th className="px-4 py-3">
                Mode
              </th>
              <th className="px-4 py-3">
                Statut
              </th>
              <th className="px-4 py-3 text-center">
                Quantité
              </th>
              <th className="px-4 py-3 text-center">
                Minimum
              </th>
              <th className="px-4 py-3 text-right">
                Actions
              </th>
            </tr>
          </thead>

          <tbody className="divide-y divide-[#3f3a36]">
            {isLoading &&
              equipments.length ===
              0 ? (
              <tr>
                <td
                  colSpan={6}
                  className="px-4 py-14 text-center text-[#aea69c]"
                >
                  Chargement...
                </td>
              </tr>
            ) : equipments.length ===
              0 ? (
              <tr>
                <td
                  colSpan={6}
                  className="px-4 py-14 text-center text-[#aea69c]"
                >
                  Aucun article disponible.
                </td>
              </tr>
            ) : (
              equipments.map(
                (equipment) => (
                  <tr
                    key={
                      equipment.equipmentId
                    }
                    className="hover:bg-[#2f2a26]"
                  >
                    <td className="px-4 py-3">
                      <button
                        type="button"
                        onClick={() =>
                          onSelectEquipment(
                            equipment,
                          )
                        }
                        className="max-w-[340px] truncate text-left font-semibold hover:underline"
                      >
                        {equipment.equipmentName ??
                          'Article sans nom'}
                      </button>
                    </td>

                    <td className="px-4 py-3">
                      <span className="rounded border border-[#4a4540] bg-[#2b2622] px-2 py-1 text-[10px]">
                        {equipment.hasSerialNumber
                          ? 'SÉRIALISÉ'
                          : 'STANDARD'}
                      </span>
                    </td>

                    <td className="px-4 py-3">
                      <span
                        className={`rounded border px-2 py-1 text-[10px] font-semibold ${equipment.equipmentStatus
                            ? 'border-emerald-400/25 bg-emerald-950/25 text-emerald-300'
                            : 'border-amber-400/25 bg-amber-950/25 text-amber-300'
                          }`}
                      >
                        {
                          equipment.equipmentStatus ? 'ACTIVE' : 'INACTIVE'
                        }
                      </span>
                    </td>

                    <td className="px-4 py-3 text-center font-mono">
                      {
                        equipment.equipmentQuantity
                      }
                    </td>

                    <td className="px-4 py-3 text-center font-mono">
                      {
                        equipment.minequipmentQuantity
                      }
                    </td>

                    <td className="px-4 py-3 text-right">
                      <div className="inline-flex items-center gap-1">
                        <button
                          type="button"
                          onClick={() =>
                            onSelectEquipment(
                              equipment,
                            )
                          }
                          className="rounded p-2 text-[#aea69c] hover:bg-[#2b2622] hover:text-white"
                          title="Voir"
                        >
                          <Eye className="h-3.5 w-3.5" />
                        </button>

                        {onEditEquipment && (
                          <button
                            type="button"
                            onClick={() =>
                              onEditEquipment(
                                equipment,
                              )
                            }
                            disabled={
                              !canUpdateEquipment
                            }
                            className="rounded p-2 text-[#aea69c] hover:bg-[#2b2622] hover:text-white disabled:opacity-30"
                            title="Modifier"
                          >
                            <Pencil className="h-3.5 w-3.5" />
                          </button>
                        )}

                        {onDeleteEquipment && (
                          <button
                            type="button"
                            onClick={() =>
                              onDeleteEquipment(
                                equipment,
                              )
                            }
                            disabled={
                              !canDeleteEquipment
                            }
                            className="rounded p-2 text-rose-300 hover:bg-rose-950/25 disabled:opacity-30"
                            title="Supprimer"
                          >
                            <Trash2 className="h-3.5 w-3.5" />
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ),
              )
            )}
          </tbody>
        </table>
      </div>

      <div className="flex items-center justify-between border-t border-[#3f3a36] bg-[#2b2622] px-4 py-3">
        <p className="text-[11px] text-[#aea69c]">
          {totalEquipments} article
          {totalEquipments > 1
            ? 's'
            : ''}
        </p>

        <div className="flex items-center gap-2">
          <button
            type="button"
            disabled={
              currentPage <= 1
            }
            onClick={() =>
              onPageChange(
                currentPage - 1,
              )
            }
            className="rounded border border-[#3f3a36] p-2 disabled:opacity-30"
          >
            <ChevronLeft className="h-3.5 w-3.5" />
          </button>

          <span className="text-[11px] text-[#aea69c]">
            {currentPage} /{' '}
            {Math.max(
              1,
              totalPages,
            )}
          </span>

          <button
            type="button"
            disabled={
              currentPage >=
              totalPages
            }
            onClick={() =>
              onPageChange(
                currentPage + 1,
              )
            }
            className="rounded border border-[#3f3a36] p-2 disabled:opacity-30"
          >
            <ChevronRight className="h-3.5 w-3.5" />
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

