                {tuples.map((t) => {
                  const shelfName = t.shelf?.shelfName ?? 'Emplacement inconnu';
                  const qty = t.equipmentQuantity || 0;
                  const percent = totalStock > 0 ? Math.round((qty / totalStock) * 100) : 0;
                  return (
                    <div
