<file path="frontend/src/schemas/equipment.schema.ts">
import { z } from "zod";

export const equipmentStatusSchema = z.any().transform(
  (val) => val === "true" || val === true
) as unknown as z.ZodType<boolean, z.ZodTypeDef, boolean>;

export const createDirectEquipmentSchema = z.object({
  equipmentName: z
    .string()
    .trim()
    .min(1, "Le nom de l'article est requis")
    .max(200, "Le nom ne peut pas dépasser 200 caractères"),

  hasSerialNumber: z.boolean(),

  minEquipmentQuantity: z
    .number()
    .int("La quantité minimale doit être un entier")
    .min(0, "La quantité minimale ne peut pas être négative"),

  equipmentStatus: equipmentStatusSchema,
});

export type CreateDirectEquipmentFormValues = z.infer<
  typeof createDirectEquipmentSchema
>;

export const updateEquipmentSchema = z
  .object({
    equipmentName: z
      .string()
      .trim()
      .min(1, "Le nom de l'article est requis")
      .max(200, "Le nom ne peut pas dépasser 200 caractères")
      .optional(),

    minEquipmentQuantity: z
      .number()
      .int("La quantité minimale doit être un entier")
      .min(0, "La quantité minimale ne peut pas être négative")
      .optional(),

    equipmentStatus: equipmentStatusSchema.optional(),

    hasSerialNumber: z.literal(true).optional(),
  })
  .superRefine((data, ctx) => {
    const editable =
      data.equipmentName !== undefined ||
      data.minEquipmentQuantity !== undefined ||
      data.equipmentStatus !== undefined ||
      data.hasSerialNumber !== undefined;

    if (!editable) {
      ctx.addIssue({
        code: "custom",
        message: "Aucune modification à enregistrer.",
      });
    }
  });

export type UpdateEquipmentFormValues = z.infer<
  typeof updateEquipmentSchema
>;

export const updateSerialNumberSchema = z.object({
  serialNumberStatus: z
    .string()
    .trim()
    .min(1, "Le statut est requis")
    .max(100, "Le statut ne peut pas dépasser 100 caractères"),
});

export type UpdateSerialNumberFormValues = z.infer<
  typeof updateSerialNumberSchema
>;
</file>

<file path="frontend/src/schemas/shelf.schema.ts">
import { z } from 'zod';

const requiredStockIdSchema = z
  .string()
  .trim()
  .min(1, 'Vous devez sélectionner un stock actif')
  .uuid('Identifiant de stock invalide');

const shelfStatusSchema = z.preprocess(
  (val) => (val === true || val === 'true' ? true : val === false || val === 'false' ? false : val),
  z.boolean(),
) as z.ZodType<boolean, z.ZodTypeDef, boolean>;

export const createShelfSchema = z.object({
  shelfName: z
    .string()
    .trim()
    .min(1, 'Le nom de l’emplacement est obligatoire')
    .max(100, 'Le nom ne peut pas dépasser 100 caractères'),
  stockId: requiredStockIdSchema,
  status: shelfStatusSchema,
});

export type CreateShelfFormValues = z.infer<typeof createShelfSchema>;

export const updateShelfSchema = z
  .object({
    shelfName: z
      .string()
      .trim()
      .min(1, 'Le nom ne peut pas être vide')
      .max(100, 'Le nom ne peut pas dépasser 100 caractères')
      .optional(),
    stockId: requiredStockIdSchema.optional(),
    status: shelfStatusSchema.optional(),
  })
  .refine(
    (data) => data.shelfName !== undefined || data.stockId !== undefined || data.status !== undefined,
    { message: 'Aucune modification à enregistrer.' },
  );

export type UpdateShelfFormValues = z.infer<typeof updateShelfSchema>;
