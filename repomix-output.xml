      },
      equipment: {
        findUnique: vi.fn(),
        update: vi.fn(),
      },
      equipmentShelfs: {
        findMany: vi.fn().mockResolvedValue([]),
        findFirst: vi.fn(),
        create: vi.fn(),
        update: vi.fn(),
      },
      serialNumber: {
        findMany: vi.fn().mockResolvedValue([]),
        findUnique: vi.fn(),
        update: vi.fn(),
      },
      mouvement: {
        findMany: vi.fn().mockResolvedValue([]),
        create: vi.fn(),
      },
      user: {
        findMany: vi.fn().mockResolvedValue([
          { userId: c1UserId, userName: 'Controller 1', role: { roleName: 'CONTROLLER' } },
          { userId: c2UserId, userName: 'Controller 2', role: { roleName: 'CONTROLLER' } },
