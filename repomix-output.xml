<file path="src/components/shelf/ShelfListTable.tsx">
'use client';

import { useMemo } from 'react';
import {
  Boxes,
  ChevronLeft,
  ChevronRight,
  Eye,
  Hash,
  Layers,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  Trash2,
  Warehouse,
} from 'lucide-react';

import type { Shelf } from '@/types/shelf';

interface ShelfListTableProps {
  shelves: Shelf[];
  totalShelves: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  onSearchChange: (search: string) => void;
  onPageChange: (page: number) => void;
  onLimitChange: (limit: number) => void;
  onSelectShelf: (shelf: Shelf) => void;
  onOpenUpdate?: (shelf: Shelf) => void;
  onOpenDelete?: (shelf: Shelf) => void;
  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateShelf: boolean;
  canUpdateShelf?: boolean;
  canDeleteShelf?: boolean;
}

export function ShelfListTable({
  shelves,
  totalShelves,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  onSearchChange,
  onPageChange,
  onLimitChange,
  onSelectShelf,
  onOpenUpdate,
  onOpenDelete,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateShelf,
  canUpdateShelf = true,
  canDeleteShelf = true,
}: ShelfListTableProps) {
  const startItem = totalShelves === 0 ? 0 : (currentPage - 1) * limit + 1;
  const endItem = Math.min(currentPage * limit, totalShelves);

  const pageNumbers = useMemo(() => {
    const start = Math.max(1, currentPage - 2);
    const end = Math.min(totalPages, start + 4);
    return Array.from({ length: Math.max(0, end - start + 1) }, (_, i) => start + i);
  }, [currentPage, totalPages]);

  return (
    <div className="overflow-hidden rounded-lg border border-[#3f3a36] bg-[#383330]">
      <div className="flex flex-col gap-3 border-b border-[#3f3a36] p-3 lg:flex-row lg:items-center lg:justify-between">
        <div className="relative w-full max-w-lg">
          <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#aea69c]" />
          <input
            value={searchTerm}
            onChange={(event) => onSearchChange(event.target.value)}
            placeholder="Rechercher par nom d’emplacement..."
            className="h-9 w-full rounded border border-[#3f3a36] bg-[#2b2622] pl-9 pr-3 text-xs text-[#f7f5f0] outline-none placeholder:text-[#aea69c] focus:border-[#dad2c1]"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <select
            value={searchTerm === 'status:ACTIVE' ? 'ACTIVE' : searchTerm === 'status:INACTIVE' ? 'INACTIVE' : 'ALL'}
            onChange={(event) => {
              if (event.target.value === 'ALL') {
                onSearchChange('');
              } else {
                onSearchChange(`status:${event.target.value}`);
              }
            }}
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs text-[#f7f5f0]"
          >
            <option value="ALL">Tous les statuts</option>
            <option value="true">Actif</option>
            <option value="false">Inactif</option>
          </select>

          <select
            value={limit}
            onChange={(event) => onLimitChange(Number(event.target.value))}
            className="h-9 rounded border border-[#3f3a36] bg-[#2b2622] px-2 text-xs text-[#f7f5f0]"
          >
            <option value={10}>10 / page</option>
            <option value={20}>20 / page</option>
            <option value={50}>50 / page</option>
          </select>

          <button type="button" onClick={onRefresh} disabled={isLoading} className="inline-flex h-9 items-center gap-1.5 rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs text-[#dad2c1] disabled:opacity-40">
            <RefreshCw className={`h-3.5 w-3.5 ${isLoading ? 'animate-spin' : ''}`} />
            Actualiser
          </button>

          {canCreateShelf && (
            <button type="button" onClick={onOpenCreateModal} className="inline-flex h-9 items-center gap-1.5 rounded bg-[#f7f5f0] px-3 text-xs font-semibold text-[#2b2622]">
              <Plus className="h-3.5 w-3.5" />Nouvel emplacement
            </button>
          )}
        </div>
      </div>

      <div className="p-4">
        {isLoading && shelves.length === 0 ? (
          <div className="flex min-h-48 items-center justify-center gap-2 text-xs text-[#aea69c]">
            <RefreshCw className="h-4 w-4 animate-spin" />Chargement des emplacements...
          </div>
        ) : shelves.length === 0 ? (
          <div className="flex min-h-48 flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-[#4b4540] bg-[#2b2622]/45 p-6 text-center">
            <Boxes className="h-7 w-7 text-[#aea69c]" />
            <p className="text-sm font-medium text-[#f7f5f0]">Aucun emplacement disponible</p>
            <p className="text-xs text-[#aea69c]">{searchTerm ? 'Aucun emplacement ne correspond à cette recherche.' : 'Créez un emplacement dans un stock ACTIVE.'}</p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead className="border-b border-[#3f3a36] bg-[#2b2622] text-[10px] uppercase tracking-wide text-[#aea69c]">
                <tr>
                  <th className="px-4 py-3">Emplacement</th>
                  <th className="px-4 py-3">Stock</th>
                  <th className="px-4 py-3">Statut</th>
                  <th className="px-4 py-3 text-center">Quantité</th>
                  <th className="px-4 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#3f3a36]">
                {shelves.map((shelf, index) => {
                  const globalIndex = (currentPage - 1) * limit + index + 1;
                  const stockName = shelf.stock?.stockName ?? 'Stock inconnu';
                  const shelfStatus = shelf.status !== false ? 'ACTIVE' : 'INACTIVE';

                  return (
                    <tr key={shelf.shelfId} className="group transition hover:bg-[#332e29]">
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-3">
                          <div className="flex h-8 w-8 items-center justify-center rounded border border-[#403b37] bg-[#2b2622]">
                            <Layers className="h-4 w-4 text-[#dad2c1]" />
                          </div>
                          <div>
                            <p className="font-semibold text-[#f7f5f0]">{shelf.shelfName ?? 'Emplacement sans nom'}</p>
                            <p className="text-[10px] font-mono text-[#aea69c]">#{String(globalIndex).padStart(2, '0')}</p>
                          </div>
                        </div>
                      </td>
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-1.5 text-[#aea69c]">
                          <Warehouse className="h-3.5 w-3.5" />
                          <span>{stockName}</span>
                        </div>
                      </td>
                      <td className="px-4 py-3">
                        <span className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[10px] font-medium border ${
                          shelfStatus === 'ACTIVE' 
                            ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-400' 
                            : 'border-amber-500/20 bg-amber-500/10 text-amber-400'
                        }`}>
                          <span className={`h-1 w-1 rounded-full ${shelfStatus === 'ACTIVE' ? 'bg-emerald-400' : 'bg-amber-400'}`} />
                          {shelfStatus === 'ACTIVE' ? 'Actif' : 'Inactif'}
                        </span>
                      </td>
                      <td className="px-4 py-3 text-center">
                        <span className="inline-flex items-center justify-center rounded bg-[#2b2622] px-2 py-1 font-mono font-medium border border-[#403b37]">
                          {shelf.shelfQuantity}
                        </span>
                      </td>
                      <td className="px-4 py-3">
                        <div className="flex items-center justify-end gap-1">
                          <button type="button" onClick={() => onSelectShelf(shelf)} className="rounded p-1.5 text-[#aea69c] hover:bg-[#2b2622] hover:text-white" title="Voir">
                            <Eye className="h-3.5 w-3.5" />
                          </button>
                          {onOpenUpdate && (
                            <button type="button" onClick={() => onOpenUpdate(shelf)} disabled={!canUpdateShelf} className="rounded p-1.5 text-[#aea69c] hover:bg-[#2b2622] hover:text-white disabled:opacity-30" title="Modifier">
                              <Pencil className="h-3.5 w-3.5" />
                            </button>
                          )}
                          {onOpenDelete && (
                            <button type="button" onClick={() => onOpenDelete(shelf)} disabled={!canDeleteShelf} className="rounded p-1.5 text-rose-400 hover:bg-rose-950/30 disabled:opacity-30" title="Supprimer">
                              <Trash2 className="h-3.5 w-3.5" />
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <div className="flex flex-col gap-3 border-t border-[#3f3a36] bg-[#2b2622] px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <p className="text-[11px] text-[#aea69c]">{startItem}–{endItem} sur {totalShelves} emplacement{totalShelves > 1 ? 's' : ''}</p>
        <div className="flex items-center gap-1">
          <button type="button" disabled={currentPage <= 1} onClick={() => onPageChange(currentPage - 1)} className="rounded border border-[#3f3a36] p-2 text-[#aea69c] disabled:opacity-30"><ChevronLeft className="h-3.5 w-3.5" /></button>
          {pageNumbers.map((page) => (
            <button type="button" key={page} onClick={() => onPageChange(page)} className={`h-8 min-w-8 rounded border px-2 text-xs ${page === currentPage ? 'border-[#dad2c1] bg-[#f7f5f0] text-[#2b2622]' : 'border-[#3f3a36] text-[#aea69c]'}`}>{page}</button>
          ))}
          <button type="button" disabled={currentPage >= totalPages} onClick={() => onPageChange(currentPage + 1)} className="rounded border border-[#3f3a36] p-2 text-[#aea69c] disabled:opacity-30"><ChevronRight className="h-3.5 w-3.5" /></button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/shelf/UpdateShelfModal.tsx">
'use client';

import { useEffect, useMemo, useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AlertCircle, Edit3, Info, Loader2, Warehouse, X } from 'lucide-react';

import type { Shelf } from '@/types/shelf';
import type { Stock } from '@/types/stock';
import { updateShelfSchema, type UpdateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import { getErrorMessage } from '@/lib/error-message';

interface UpdateShelfModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateShelfModal(props: UpdateShelfModalProps) {
  if (!props.isOpen || !props.shelf) return null;
  return <UpdateShelfContent key={`${props.shelf.shelfId}:${props.shelf.stockId}`} {...props} />;
}

function UpdateShelfContent({ shelf, onClose, onSuccess }: UpdateShelfModalProps) {
  const api = useApi();
  const { updateShelf, isUpdating } = useShelves({ enabled: false });
  const { canUpdateShelf } = usePermissions();
  const [activeStocks, setActiveStocks] = useState<Stock[]>([]);
  const [loadingStocks, setLoadingStocks] = useState(false);
  const [serverError, setServerError] = useState<string | null>(null);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<UpdateShelfFormValues>({
    resolver: zodResolver(updateShelfSchema),
    defaultValues: {
      shelfName: shelf?.shelfName ?? '',
      stockId: shelf?.stockId ?? '',
      status: shelf?.status !== false,
    },
  });

  useEffect(() => {
    if (!shelf) return;
    reset({ shelfName: shelf.shelfName ?? '', stockId: shelf.stockId, status: shelf.status !== false ? true : false });
  }, [shelf, reset]);

  useEffect(() => {
    let active = true;
    setLoadingStocks(true);
    StockService.getActiveStocks(api, { page: 1, limit: 100 })
      .then((result) => {
        if (active) setActiveStocks(result.stocks);
      })
      .catch((cause: unknown) => {
        if (active) setServerError(getErrorMessage(cause, 'Impossible de charger les stocks actifs.'));
      })
      .finally(() => {
        if (active) setLoadingStocks(false);
      });
    return () => {
      active = false;
    };
  }, [api]);

  const stockOptions = useMemo(() => {
    if (!shelf) return activeStocks;
    if (activeStocks.some((stock) => stock.stockId === shelf.stockId)) return activeStocks;
    const current: Stock = {
      stockId: shelf.stockId,
      stockName: shelf.stock?.stockName ?? 'Stock actuel',
      status: false,
    };
    return [current, ...activeStocks];
  }, [activeStocks, shelf]);

  if (!shelf) return null;
  const currentShelf = shelf;
  const busy = isUpdating || isSubmitting;

  async function submit(values: UpdateShelfFormValues) {
    setServerError(null);
    if (!canUpdateShelf) {
      setServerError("Permission 'shelf.update' requise.");
      return;
    }

    const data: { shelfName?: string; stockId?: string; status?: boolean } = {};
    const nextName = values.shelfName?.trim();
    if (nextName && nextName !== (currentShelf.shelfName ?? '')) data.shelfName = nextName;
    if (values.stockId && values.stockId !== currentShelf.stockId) data.stockId = values.stockId;
    if (values.status && values.status !== (currentShelf.status !== false ? true : false)) data.status = values.status;

    if (data.shelfName === undefined && data.stockId === undefined && data.status === undefined) {
      onClose();
      return;
    }

    try {
      await updateShelf({ id: currentShelf.shelfId, data });
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setServerError(getErrorMessage(cause, 'Échec de la modification de l’emplacement.'));
    }
  }

  return (
    <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-lg overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-5 py-4">
          <h2 className="flex items-center gap-2 text-sm font-semibold"><Edit3 className="h-4 w-4" />Modifier l’emplacement</h2>
          <button type="button" onClick={onClose} disabled={busy} className="rounded p-1.5 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
        </header>

        <form onSubmit={handleSubmit(submit)} className="space-y-4 p-5">
          {serverError && <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/40 p-3 text-xs text-rose-200"><AlertCircle className="h-4 w-4 shrink-0" />{serverError}</div>}

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Nom</span>
            <input {...register('shelfName')} className="h-10 w-full rounded-lg border border-[#3f3a36] bg-[#2b2622] px-3 text-xs outline-none focus:border-white/50" />
            {errors.shelfName && <p className="text-[11px] text-rose-300">{errors.shelfName.message}</p>}
          </label>

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Statut de l'emplacement</span>
            <select {...register('status', { setValueAs: (v) => v === 'true' })} disabled={busy} className="h-10 w-full rounded-lg border border-[#3f3a36] bg-[#2b2622] px-3 text-xs outline-none focus:border-white/50">
              <option value="true">Actif (ACTIVE)</option>
              <option value="false" disabled={currentShelf.shelfQuantity > 0}>Inactif (INACTIVE)</option>
            </select>
            {errors.status && <p className="text-[11px] text-rose-300">{errors.status.message}</p>}
            {currentShelf.shelfQuantity > 0 && (
              <p className="text-[10px] text-amber-400">Impossible de désactiver un emplacement contenant des articles.</p>
            )}
          </label>

          <label className="block space-y-1.5">
            <span className="flex items-center gap-1.5 text-xs font-semibold"><Warehouse className="h-3.5 w-3.5" />Stock</span>
            <select {...register('stockId')} disabled={busy || loadingStocks} className="h-10 w-full rounded-lg border border-[#3f3a36] bg-[#2b2622] px-3 text-xs">
              {stockOptions.map((stock) => {
                const inactive = stock.status === false;
                return (
                  <option key={stock.stockId} value={stock.stockId} disabled={inactive && stock.stockId !== currentShelf.stockId}>
                    {stock.stockName ?? 'Stock sans nom'}{inactive ? ' — INACTIVE (actuel)' : ''}
                  </option>
                );
              })}
            </select>
            {errors.stockId && <p className="text-[11px] text-rose-300">{errors.stockId.message}</p>}
          </label>

          <div className="flex gap-2 rounded-lg border border-sky-400/20 bg-sky-400/5 p-3 text-[11px] text-sky-100">
            <Info className="mt-0.5 h-4 w-4 shrink-0" />
            <p>Seuls les stocks ACTIVE peuvent être choisis comme nouvelle destination. La quantité actuelle ({currentShelf.shelfQuantity}) reste en lecture seule.</p>
          </div>

          <footer className="flex justify-end gap-2 border-t border-[#3f3a36] pt-4">
            <button type="button" onClick={onClose} disabled={busy} className="rounded border border-[#3f3a36] px-4 py-2 text-xs">Annuler</button>
            <button type="submit" disabled={busy || !canUpdateShelf} className="inline-flex items-center gap-1.5 rounded bg-[#f7f5f0] px-4 py-2 text-xs font-semibold text-[#2b2622] disabled:opacity-40">
              {busy && <Loader2 className="h-3.5 w-3.5 animate-spin" />}Enregistrer
            </button>
          </footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/stock/CreateStockModal.tsx">
'use client';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AlertCircle, Loader2, Plus, ShieldAlert, Warehouse, X } from 'lucide-react';

import { createStockSchema, type CreateStockFormValues } from '@/schemas/stock.schema';
import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import { getErrorMessage } from '@/lib/error-message';

interface CreateStockModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function CreateStockModal({ isOpen, onClose, onSuccess }: CreateStockModalProps) {
  const api = useApi();
  const { canCreateStock, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<CreateStockFormValues>({
    resolver: zodResolver(createStockSchema),
    defaultValues: { stockName: '', stockStatus: true },
  });

  if (!isOpen) return null;
  const busy = saving || isSubmitting;

  async function submit(values: CreateStockFormValues) {
    setServerError(null);
    if (!canCreateStock) {
      setServerError(`Action interdite : votre rôle (${roleName ?? 'Utilisateur'}) ne permet pas de créer un stock.`);
      return;
    }

    try {
      setSaving(true);
      await StockService.createStock(api, {
        stockName: values.stockName.trim(),
        status: values.stockStatus,
      });
      reset({ stockName: '', stockStatus: true });
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setServerError(getErrorMessage(cause, 'Erreur lors de la création du stock.'));
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-lg overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#2b2622] px-5 py-4">
          <div className="flex items-center gap-3"><Warehouse className="h-5 w-5" /><div><h2 className="text-sm font-semibold">Nouveau stock</h2><p className="mt-0.5 text-[10px] text-white/45">Statuts autorisés : ACTIVE / INACTIVE</p></div></div>
          <button type="button" onClick={onClose} disabled={busy} className="rounded p-1.5 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
        </header>

        {!canCreateStock && <div className="flex gap-2 border-b border-amber-500/30 bg-amber-950/25 px-5 py-3 text-xs text-amber-200"><ShieldAlert className="h-4 w-4 shrink-0" />Permission stock.create requise.</div>}

        <form onSubmit={handleSubmit(submit)} className="space-y-5 p-5">
          {serverError && <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/30 p-3 text-xs text-rose-200"><AlertCircle className="h-4 w-4 shrink-0" />{serverError}</div>}

          <label className="block space-y-1.5"><span className="text-xs font-semibold">Nom du stock *</span><input {...register('stockName')} className="h-10 w-full rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs outline-none focus:border-white/50" placeholder="Ex: Stock Principal" />{errors.stockName && <p className="text-[11px] text-rose-300">{errors.stockName.message}</p>}</label>

          <label className="block space-y-1.5"><span className="text-xs font-semibold">Statut</span><select {...register('stockStatus')} className="h-10 w-full rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"><option value="true">ACTIVE</option><option value="false">INACTIVE</option></select></label>

          <footer className="flex justify-end gap-2 border-t border-[#3f3a36] pt-4">
            <button type="button" onClick={onClose} disabled={busy} className="rounded border border-[#3f3a36] px-4 py-2 text-xs">Annuler</button>
            <button type="submit" disabled={busy || !canCreateStock} className="inline-flex items-center gap-1.5 rounded bg-[#f7f5f0] px-4 py-2 text-xs font-semibold text-[#2b2622] disabled:opacity-40">{busy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Plus className="h-3.5 w-3.5" />}Créer le stock</button>
          </footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/stock/StockDetailModal.tsx">
'use client';

import { useQuery } from '@tanstack/react-query';
import Link from 'next/link';
import {
  AlertTriangle,
  ArrowUpRight,
  CheckCircle2,
  Layers,
  Loader2,
  Warehouse,
  X,
} from 'lucide-react';

import { StockService } from '@/services/stock.service';
import { useApi } from '@/hooks/use-api';

interface StockDetailModalProps {
  stockId: string | null;
  isOpen: boolean;
  onClose: () => void;
}

export function StockDetailModal({ stockId, isOpen, onClose }: StockDetailModalProps) {
  const api = useApi();
  const { data: stock, isLoading, error } = useQuery({
    queryKey: ['stock-detail', stockId],
    queryFn: () => StockService.getStockById(api, stockId!),
    enabled: isOpen && Boolean(stockId),
    staleTime: 10_000,
  });

  if (!isOpen || !stockId) return null;
