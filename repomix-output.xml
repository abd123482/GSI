<file path="backend/src/movements/dto/createEquipmentMovement.dto.ts">
import { z } from 'zod';

import { createEquipmentSchema } from '../../equipment/dto/createEquipment.dto.js';

const uuid = z.string().trim().uuid().transform((id) => id.toLowerCase());
export const movementTypeSchema = z.enum(['IN', 'OUT', 'TRANSFER']);
export const movementItemSchema = z.object({
  equipmentId: uuid.optional(),
  newEquipment: createEquipmentSchema.optional(),
  movementQuantity: z.number().int().positive().max(2_147_483_647),
  serialNumberId: uuid.nullish(),
  serialNumberCode: z.string().trim().min(1).max(200).optional(),
  sourceShelfId: uuid.nullish(),
  destinationShelfId: uuid.nullish(),
}).strict().superRefine((data, ctx) => {
  if (!data.equipmentId && !data.newEquipment) {
    ctx.addIssue({ code: 'custom', message: 'Either equipmentId or newEquipment must be provided' });
  }
  if (data.equipmentId && data.newEquipment) {
    ctx.addIssue({ code: 'custom', message: 'Provide either equipmentId or newEquipment, not both' });
  }
});

export const createEquipmentMovementSchema = z.object({
  movementType: movementTypeSchema,
  happenedAt: z.string().datetime().optional(),
  items: z.array(movementItemSchema).min(1).max(100),
}).strict().superRefine(({ movementType: type, items, happenedAt }, ctx) => {
  if (happenedAt && new Date(happenedAt) > new Date())
    ctx.addIssue({ code: 'custom', path: ['happenedAt'], message: 'La date du mouvement ne peut pas être dans le futur' });

  const ids = new Set<string>(), codes = new Set<string>();
  items.forEach((item, index) => {
    const fail = (message: string) => ctx.addIssue({ code: 'custom', path: ['items', index], message });
    const { sourceShelfId: from, destinationShelfId: to, serialNumberId: id, serialNumberCode: code } = item;
    if (!!from !== (type !== 'IN') || !!to !== (type !== 'OUT') || (from && from === to))
      fail('IN needs a destination only; OUT a source only; TRANSFER two different shelves');
    if (code !== undefined && (type !== 'IN' || id)) fail('New serial codes are IN-only; send a code OR an existing ID');
    if ((id || code !== undefined) && item.movementQuantity !== 1) fail('Each serialized line must have quantity 1');
    if (id && ids.has(id)) fail('The same serial ID cannot appear twice');
    if (code !== undefined && codes.has(code)) fail('Duplicate serial code in the request');
    if (id) ids.add(id);
    if (code !== undefined) codes.add(code);
  });
  if (items.reduce((sum, item) => sum + item.movementQuantity, 0) > 2_147_483_647)
    ctx.addIssue({ code: 'custom', path: ['items'], message: 'Total quantity exceeds SQL INT capacity' });
});

export type MovementType = z.infer<typeof movementTypeSchema>;
export type CreateEquipmentMovementItemDTO = z.input<typeof movementItemSchema>;
export type CreateEquipmentMovementDTO = z.input<typeof createEquipmentMovementSchema>;
</file>

<file path="backend/src/serial-numbers/serialNumber.service.ts">
import { BadRequestException, ConflictException, Injectable, NotFoundException, ServiceUnavailableException } from '@nestjs/common';
import { z, ZodError } from 'zod';
import type { Prisma } from '../generated/prisma/client.js';
import { PrismaService } from '../prisma/prisma.service.js';
import { paginationSchema } from './dto/index.js';

const uuid = z.string().trim().uuid().transform((id) => id.toLowerCase());
const status = z.union([z.boolean(), z.string().trim().toUpperCase()
  .pipe(z.enum(['TRUE', 'FALSE', 'ACTIVE', 'INACTIVE', 'AVAILABLE', 'UNAVAILABLE']))])
  .transform((value) => value === true || value === 'TRUE' || value === 'ACTIVE' || value === 'AVAILABLE' ? 'ACTIVE' : 'INACTIVE');
const updateSchema = z.object({ serialNumberStatus: status }).strict();
const searchSchema = z.object({
  serialNumberCode: z.string().trim().max(200).optional(),
  serialNumberStatus: status.optional(), equipmentId: uuid.optional(),
});
const SERIAL_SELECT = {
  serialNumberId: true, serialNumberCode: true, serialNumberStatus: true, equipmentId: true,
  equipment: { select: { equipmentId: true, equipmentName: true, hasSerialNumber: true, equipmentStatus: true } },
  movementItems: {
    take: 1,
    orderBy: [
      { movement: { happenedAt: 'desc' } },
      { movement: { mouvementStatus: 'asc' } },
      { movementEquipmentId: 'desc' }
    ],
    select: { 
      destinationShelfId: true, 
      destinationShelf: { select: { shelfId: true, shelfName: true } },
      movement: { select: { mouvementStatus: true } }
    }
  }
} satisfies Prisma.SerialNumberSelect;

function mapSerial(s: any) {
  const lastMove = s.movementItems?.[0];
  const isOnShelf = !!lastMove?.destinationShelfId;
  return {
    serialNumberId: s.serialNumberId,
    serialNumberCode: s.serialNumberCode,
    serialNumberStatus: s.serialNumberStatus,
    equipmentId: s.equipmentId,
    equipment: s.equipment,
    shelfId: isOnShelf ? lastMove.destinationShelfId : null,
    shelf: isOnShelf ? lastMove.destinationShelf : null,
  };
}

@Injectable()
export class SerialNumberService {
  constructor(private readonly prisma: PrismaService) { }

  // Keep old controller methods, but never allow standalone serial creation.
  async createSerialNumber(_dto: unknown): Promise<never> {
    throw new BadRequestException('Create serial numbers in POST /movements with movementType IN');
  }
  async createBatchSerialNumbers(dto: unknown): Promise<never> { return this.createSerialNumber(dto); }

  async getSerialNumbers(query: unknown = {}, pagination?: unknown) {
    return this.run(async () => {
      const f = searchSchema.parse(query ?? {}), { page, limit } = paginationSchema.parse(pagination ?? query ?? {});
      const skip = (page - 1) * limit;
      if (!Number.isSafeInteger(skip) || skip > 2_147_483_647) throw new BadRequestException('Page is too large');
      const where: Prisma.SerialNumberWhereInput = {
        ...(f.serialNumberCode ? { serialNumberCode: { contains: f.serialNumberCode } } : {}),
        ...(f.serialNumberStatus !== undefined ? { serialNumberStatus: f.serialNumberStatus } : {}),
        ...(f.equipmentId ? { equipmentId: f.equipmentId } : {}),
      };
      const [serialNumbers, totalSerialNumbers] = await Promise.all([
        this.prisma.serialNumber.findMany({
          where, skip, take: limit, select: SERIAL_SELECT,
          orderBy: [{ serialNumberCode: 'asc' }, { serialNumberId: 'asc' }]
        }),
        this.prisma.serialNumber.count({ where }),
      ]);
      return { serialNumbers: serialNumbers.map(mapSerial), totalSerialNumbers, totalPages: Math.ceil(totalSerialNumbers / limit) || 1, currentPage: page, limit };
    });
  }

  async getSerialNumberById(id: string) {
    return this.run(async () => mapSerial(await this.prisma.serialNumber.findUniqueOrThrow({ where: { serialNumberId: uuid.parse(id) }, select: SERIAL_SELECT })));
  }
  async getSerialNumberByCode(code: string) {
    return this.run(async () => mapSerial(await this.prisma.serialNumber.findUniqueOrThrow({
      where: { serialNumberCode: z.string().trim().min(1).max(200).parse(code) }, select: SERIAL_SELECT,
    })));
  }
  async updateSerialNumber(id: string, dto: unknown) {
    return this.run(async () => mapSerial(await this.prisma.serialNumber.update({
      where: { serialNumberId: uuid.parse(id) }, data: updateSchema.parse(dto), select: SERIAL_SELECT,
    })));
  }
  async updateSerialNumberStatus(id: string, dto: unknown) { return this.updateSerialNumber(id, dto); }

  // Only a never-used legacy identity can be deleted. OUT does not erase history.
  async deleteSerialNumber(id: string) {
    return this.run(async () => {
      const serialNumberId = uuid.parse(id);
      return this.prisma.$transaction(async (tx) => {
        const resource = `SOMIPHARM:SERIAL:${serialNumberId}`;
        const [lock] = await tx.$queryRaw<{ result: number }[]>`
          DECLARE @r int; EXEC @r = sys.sp_getapplock @Resource=${resource},
          @LockMode='Exclusive', @LockOwner='Transaction', @LockTimeout=5000;
          SELECT @r AS result;`;
        if (!lock || (lock.result !== 0 && lock.result !== 1)) throw new ConflictException('Serial is busy; retry');
        const serial = await tx.serialNumber.findUniqueOrThrow({
          where: { serialNumberId },
          select: { ...SERIAL_SELECT, _count: { select: { movementItems: true } } }
        });
        if (Object.values(serial._count).some((count) => count > 0))
          throw new ConflictException('Serial is allocated or has history; deactivate it instead');
        return mapSerial(await tx.serialNumber.delete({ where: { serialNumberId }, select: SERIAL_SELECT }));
      }, { isolationLevel: 'Serializable', maxWait: 5_000, timeout: 15_000 });
    });
  }

  private async run<T>(work: () => PromiseLike<T>): Promise<T> {
    try { return await work(); } catch (error) {
      if (error instanceof ZodError) throw new BadRequestException(error.issues.map((i) => `${i.path.join('.')}: ${i.message}`).join('; '));
      const code = error && typeof error === 'object' && 'code' in error ? error.code : undefined;
      if (code === 'P2025') throw new NotFoundException('Serial number not found');
      if (code === 'P2002' || code === 'P2003' || code === 'P2034') throw new ConflictException('Serial is duplicated, referenced, or changed concurrently');
      if (code === 'P2028') throw new ServiceUnavailableException('Transaction could not complete; refresh before retrying');
      throw error;
    }
  }
}
</file>

