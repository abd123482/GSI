  return useQuery({
    queryKey: ['shelf-serial-numbers', shelfId, page, limit, userId],
    queryFn: () =>
      ShelfService.getShelfSerialNumbers(api, shelfId!, { page, limit }, permissions),
    enabled: enabled && Boolean(shelfId),
    placeholderData: keepPreviousData,
  });
