<file path="sql/backup_current_empty_yacinedb.sql">
/*
  SAFETY BACKUP OF CURRENT YACINEDB
  ---------------------------------
  Run in SSMS as an account allowed to BACKUP DATABASE.

  Even though the database is currently empty, this creates a rollback artifact
  of the exact current state before reconstruction.
*/

USE [master];
GO

DECLARE @BackupDirectory nvarchar(4000) =
    CONVERT(nvarchar(4000), SERVERPROPERTY('InstanceDefaultBackupPath'));

IF @BackupDirectory IS NULL OR LTRIM(RTRIM(@BackupDirectory)) = ''
BEGIN
    THROW 51100,
        'SQL Server InstanceDefaultBackupPath is unavailable. Choose a reviewed backup path manually.',
        1;
END;

DECLARE @File nvarchar(4000) =
    @BackupDirectory +
    CASE
        WHEN RIGHT(@BackupDirectory, 1) IN ('\', '/')
            THEN ''
        ELSE '\'
    END +
    'yacinedb_before_rebuild_' +
    REPLACE(
        REPLACE(
            REPLACE(
                CONVERT(varchar(19), GETDATE(), 120),
                '-',
                ''
            ),
            ':',
            ''
        ),
        ' ',
        '_'
    ) +
    '.bak';

DECLARE @Sql nvarchar(max) =
    N'BACKUP DATABASE [yacinedb] TO DISK = N''' +
    REPLACE(@File, '''', '''''') +
    N''' WITH COPY_ONLY, INIT, CHECKSUM, STATS = 10;';

EXEC sys.sp_executesql @Sql;

SELECT
    @File AS BackupFile;
GO
</file>

<file path="sql/create_baseline_test_database_admin.sql">
/*
  SOMIPHARM - CREATE CLEAN BASELINE TEST DATABASE

  Run in SSMS using Windows/sysadmin credentials.

  Creates ONLY:
    yacinedb_baseline_test

  It never drops or modifies:
    yacinedb
    yacinedb_rebuild_test
*/

USE [master];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;
GO

DECLARE @TargetDatabase sysname = N'yacinedb_baseline_test';
DECLARE @ApplicationLogin sysname = N'admin_semepharm';

IF DB_ID(@TargetDatabase) IS NOT NULL
BEGIN
    THROW 51300,
        'Safety stop: yacinedb_baseline_test already exists. This script never overwrites an existing DB.',
        1;
END;

IF NOT EXISTS (
    SELECT 1
    FROM sys.server_principals
    WHERE name = @ApplicationLogin
)
BEGIN
    THROW 51301,
        'SQL login admin_semepharm does not exist.',
        1;
END;

IF
    IS_SRVROLEMEMBER('sysadmin') <> 1
    AND HAS_PERMS_BY_NAME(NULL, NULL, 'CREATE ANY DATABASE') <> 1
BEGIN
    THROW 51302,
        'Current SSMS login cannot create a database. Use Windows/sysadmin credentials.',
        1;
END;

CREATE DATABASE [yacinedb_baseline_test];
GO

USE [yacinedb_baseline_test];
GO

IF USER_ID(N'admin_semepharm') IS NULL
BEGIN
    CREATE USER [admin_semepharm]
        FOR LOGIN [admin_semepharm]
        WITH DEFAULT_SCHEMA = [dbo];
END;
GO

ALTER ROLE [db_owner]
    ADD MEMBER [admin_semepharm];
GO

SELECT
    @@SERVERNAME AS CurrentServer,
    DB_NAME() AS CurrentDatabase,
    SUSER_SNAME() AS CurrentLogin;

PRINT 'SUCCESS: yacinedb_baseline_test created.';
GO
</file>

<file path="sql/create_rebuild_test_database_admin.sql">
/*
    SOMIPHARM - CREATE ISOLATED REBUILD TEST DATABASE
    -------------------------------------------------
    Run this script in SSMS using a Windows/sysadmin account or another login
    that has CREATE ANY DATABASE permission.

    SAFETY:
    - It creates ONLY [yacinedb_rebuild_test].
    - It NEVER drops or alters [yacinedb].
    - It refuses to continue if [yacinedb_rebuild_test] already exists.
    - It maps the existing SQL login [admin_semepharm] only inside the TEST DB.
*/

USE [master];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;
GO

DECLARE @TargetDatabase sysname = N'yacinedb_rebuild_test';
DECLARE @ApplicationLogin sysname = N'admin_semepharm';

IF DB_ID(@TargetDatabase) IS NOT NULL
BEGIN
    THROW 51040,
        'Safety stop: yacinedb_rebuild_test already exists. This script never overwrites or drops an existing database.',
        1;
END;

IF NOT EXISTS (
    SELECT 1
    FROM sys.server_principals
    WHERE name = @ApplicationLogin
)
BEGIN
    THROW 51041,
        'The SQL login admin_semepharm does not exist on this SQL Server instance.',
        1;
END;

IF
    IS_SRVROLEMEMBER('sysadmin') <> 1
    AND HAS_PERMS_BY_NAME(NULL, NULL, 'CREATE ANY DATABASE') <> 1
BEGIN
    THROW 51042,
        'The current SSMS login does not have permission to create a database. Reconnect with Windows/sysadmin credentials.',
        1;
END;

CREATE DATABASE [yacinedb_rebuild_test];
GO

USE [yacinedb_rebuild_test];
GO

IF USER_ID(N'admin_semepharm') IS NULL
BEGIN
    CREATE USER [admin_semepharm]
        FOR LOGIN [admin_semepharm]
        WITH DEFAULT_SCHEMA = [dbo];
END;
GO

/*
    db_owner is intentionally granted ONLY on this disposable isolated TEST DB
    so the application login can create the generated schema and hardening
    triggers during reconstruction validation.
*/
ALTER ROLE [db_owner]
    ADD MEMBER [admin_semepharm];
GO

SELECT
    @@SERVERNAME AS CurrentServer,
    DB_NAME() AS CurrentDatabase,
    USER_NAME() AS ExecutingDatabaseUser;

SELECT
    sp.name AS LoginName,
    dp.name AS DatabaseUser,
    rp.name AS DatabaseRole
FROM sys.database_principals dp
JOIN master.sys.server_principals sp
    ON sp.sid = dp.sid
LEFT JOIN sys.database_role_members drm
    ON drm.member_principal_id = dp.principal_id
LEFT JOIN sys.database_principals rp
    ON rp.principal_id = drm.role_principal_id
WHERE sp.name = N'admin_semepharm';

PRINT 'SUCCESS: yacinedb_rebuild_test created. Real yacinedb was not modified.';
GO
</file>

