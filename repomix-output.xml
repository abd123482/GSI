<file path="frontend/src/components/equipment/CreateEquipmentModal.tsx">
'use client';

import {
  useState,
} from 'react';
import {
  useForm,
  useWatch,
} from 'react-hook-form';
import {
  zodResolver,
} from '@hookform/resolvers/zod';
import {
  AlertCircle,
  Barcode,
  Info,
  PackagePlus,
  Plus,
  RefreshCw,
  Trash2,
  X,
} from 'lucide-react';

import {
  createDirectEquipmentSchema,
  type CreateDirectEquipmentFormValues,
} from '@/schemas/equipment.schema';

import {
  useEquipments,
} from '@/hooks/use-equipments';
import {
  usePermissions,
} from '@/hooks/use-permissions';
import {
  getErrorMessage,
} from '@/lib/error-message';

interface CreateEquipmentModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
  onSubmitClient?: (data: CreateDirectEquipmentFormValues) => void;
}

export function CreateEquipmentModal({
  isOpen,
  onClose,
  onSuccess,
  onSubmitClient,
}: CreateEquipmentModalProps) {
  const {
    createEquipment,
    isCreatingEquipment,
  } = useEquipments({
    enabled: false,
  });

  const {
    canCreateEquipment,
    canCreateSerialNumber,
  } = usePermissions();



  const [
    serverError,
    setServerError,
  ] =
    useState<string | null>(
      null,
    );

  const {
    register,
    handleSubmit,
    control,
    setValue,
    reset,
    formState: {
      errors,
      isSubmitting,
    },
  } =
    useForm<CreateDirectEquipmentFormValues>({
      resolver:
        zodResolver(
          createDirectEquipmentSchema,
        ),

      defaultValues: {
        equipmentName: '',
        hasSerialNumber:
          false,
        minEquipmentQuantity:
          0,
        equipmentStatus:
          true,
        
      },
    });

  const serialized =
    useWatch({
      control,
      name:
        'hasSerialNumber',
    });

  if (!isOpen) {
    return null;
  }

  const busy =
    isSubmitting ||
    isCreatingEquipment;



  function close() {
    reset();
    setServerError(null);
    onClose();
  }

  async function submit(
    values: CreateDirectEquipmentFormValues,
  ) {
    if (onSubmitClient) {
      onSubmitClient(values);
      close();
      return;
    }

    setServerError(null);

    if (!canCreateEquipment) {
      setServerError(
        "Permission 'equipment.create' requise.",
      );
      return;
    }    try {
      await createEquipment({
        equipmentName:
          values.equipmentName.trim(),
        hasSerialNumber:
          values.hasSerialNumber,
        minEquipmentQuantity:
          values.minEquipmentQuantity,
        equipmentStatus:
          values.equipmentStatus,
      });

      onSuccess?.();
      close();
    } catch (error: unknown) {
      setServerError(
        getErrorMessage(
          error,
          'Échec de la création de l’article.',
        ),
      );
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/55 p-4 backdrop-blur-sm">
      <div className="my-8 w-full max-w-2xl overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-6 py-4">
          <div className="flex items-center gap-2.5">
            <PackagePlus className="h-4 w-4" />

            <div>
              <h2 className="text-sm font-semibold">
                Créer un article
              </h2>

            </div>
          </div>

          <button
            type="button"
            disabled={busy}
            onClick={close}
            className="rounded p-1.5 text-white/60 hover:bg-white/10"
          >
            <X className="h-4 w-4" />
          </button>
        </header>

        <form
          onSubmit={handleSubmit(
            submit,
          )}
          className="space-y-5 p-6"
        >
          {serverError && (
            <div className="flex items-start gap-2 rounded-lg border border-rose-500/40 bg-rose-950/35 p-3 text-xs text-rose-200">
              <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
              {serverError}
            </div>
          )}

          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <label className="space-y-1.5">
              <span className="text-xs font-semibold">
                Nom de l’article *
              </span>

              <input
                {...register(
                  'equipmentName',
                )}
                className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50"
              />

              {errors.equipmentName && (
                <p className="text-[11px] text-rose-300">
                  {
                    errors
                      .equipmentName
                      .message
                  }
                </p>
              )}
            </label>

            <label className="space-y-1.5">
              <span className="text-xs font-semibold">
                Statut
              </span>

              <select
                {...register(
                  'equipmentStatus',
                )}
                className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
              >
                <option value="true">
                  ACTIVE
                </option>
                <option value="false">
                  INACTIVE
                </option>
              </select>
            </label>
          </div>

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">
              Quantité minimale
            </span>

            <input
              type="number"
