              'serial-numbers', userId],
          }),
          queryClient.invalidateQueries({
            queryKey: [
              'equipments', userId],
          }),
        ]);

        toast.success(
          'Numéros de série créés',
          {
            description:
              `${result.count} numéro(s) enregistré(s).`,
          },
        );
      },
  });
}

export function useUpdateSerialNumber() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  return useMutation({
