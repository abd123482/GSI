// @ts-nocheck
import {
  describe,
  expect,
  it,
  vi,
} from 'vitest';

import {
  EquipmentMovementService,
} from './equipmentMovement.service.js';

const equipmentA =
  '11111111-1111-4111-8111-111111111111';

const equipmentB =
  '22222222-2222-4222-8222-222222222222';

const serializedEquipment =
  '33333333-3333-4333-8333-333333333333';

const sourceShelfId =
  '44444444-4444-4444-8444-444444444444';

const destinationShelfId =
  '55555555-5555-4555-8555-555555555555';

const serialId =
  '66666666-6666-4666-8666-666666666666';

const movementId =
  '77777777-7777-4777-8777-777777777777';

const inventoryId =
  '88888888-8888-4888-8888-888888888888';

function activeShelf(
  shelfId: string
) {
  return {
    shelfId,
    shelfName:
      `Shelf-${shelfId.slice(0, 4)}`,
    stockId:
      '99999999-9999-4999-8999-999999999999',
    stock: {
      stockId:
        '99999999-9999-4999-8999-999999999999',
      stockName:
        'Stock Principal',
      status: true,
    },
  };
}

function createHarness() {
  const equipmentRecords =
    new Map([
      [
        equipmentA,
        {
          equipmentId:
            equipmentA,
          equipmentName:
            'Standard A',
          hasSerialNumber:
            false,
          equipmentQuantity:
            20,
          equipmentStatus: true,
        },
      ],

      [
        equipmentB,
        {
          equipmentId:
            equipmentB,
          equipmentName:
            'Standard B',
          hasSerialNumber:
            false,
          equipmentQuantity:
            30,
          equipmentStatus: true,
        },
      ],

      [
        serializedEquipment,
        {
          equipmentId:
            serializedEquipment,
          equipmentName:
            'Serialized',
          hasSerialNumber:
            true,
          equipmentQuantity:
            1,
          equipmentStatus: true,
        },
      ],
    ]);

  const serialRecords =
    new Map<
      string,
      {
        serialNumberId: string;
        equipmentId: string;
        shelfId: string | null;
        serialNumberStatus: string;
      }
    >([
      [
        serialId,
        {
          serialNumberId:
            serialId,
          equipmentId:
            serializedEquipment,
          shelfId:
            sourceShelfId,
          serialNumberStatus: true,
        },
      ],
    ]);

  const allocations =
    new Map<
      string,
      {
        equipmentShelfId:
          string;
        equipmentId:
          string;
        shelfId:
          string;
        equipmentQuantity:
          number;
      }
    >();

  let nextAllocationId =
    1;

  const tx = {
    $queryRaw: vi.fn().mockImplementation(async (sqlObj) => {
      const q = JSON.stringify(sqlObj);
      if (q.includes('sp_getapplock')) return [{ result: 0 }];
      
      if (q.includes('WITH wanted AS')) {
        if (globalThis.__mockBalances) return globalThis.__mockBalances;
        const vals = sqlObj.values || [];
        const balances = [];
        for (let i = 0; i < vals.length; i += 2) {
            balances.push({ equipmentId: vals[i], shelfId: vals[i+1], quantity: 9999n });
        }
        return balances;
      }
      
      if (q.includes('UPDATE e SET equipmentQuantity')) {
        const vals = sqlObj.values || [];
        return [{ changed: vals.length / 2 }];
      }
      
      if (q.includes('UPDATE s SET shelfId = v.destination')) {
        const vals = sqlObj.values || [];
        // values has id, equipment, source, destination -> 4 per row
        return [{ changed: vals.length / 4 }];
      }
      
      return [{ changed: 1 }];
    }),

    shelf: {
      findMany: vi.fn(
        async (
          args: any,
        ) =>
          (
            args.where.shelfId
              .in as string[]
          ).map(
            activeShelf,
          ),
      ),

      update: vi.fn().mockResolvedValue({}),
      updateMany: vi
        .fn()
        .mockResolvedValue({
          count: 1,
        }),

      findUnique: vi
        .fn()
        .mockResolvedValue({
          shelfQuantity: 0,
        }),
    },

    equipment: {
      findMany: vi.fn(
        async (
          args: any,
        ) =>
          (
            args.where.equipmentId
              .in as string[]
          )
            .map(
              (id) =>
                equipmentRecords.get(
                  id,
                ),
            )
            .filter(Boolean),
      ),

      update: vi.fn().mockResolvedValue({}),
      updateMany: vi
        .fn()
        .mockResolvedValue({
          count: 1,
        }),
    },

    serialNumber: {
      findMany: vi.fn(
        async (
          args: any,
        ) =>
          (
            args.where
              .serialNumberId
              .in as string[]
          )
            .map(
              (id) =>
                serialRecords.get(
                  id,
                ),
            )
            .filter(Boolean),
      ),

      update: vi.fn().mockResolvedValue({}),
      updateMany: vi
        .fn()
        .mockResolvedValue({
          count: 1,
        }),
    },

    equipmentShelfs: {
      update: vi.fn().mockResolvedValue({}),
      updateMany: vi
        .fn()
        .mockResolvedValue({
          count: 1,
        }),

      findMany: vi.fn(
        async (
          args: any,
        ) => {
          const ids =
            args.where
              .equipmentId
              .in as string[];

          return ids
            .map((id) =>
              allocations.get(
                `${id}:${args.where.shelfId}`,
              ),
            )
            .filter(Boolean);
        },
      ),

      create: vi.fn(
        async (
          args: any,
        ) => {
          const record = {
            equipmentShelfId:
              `allocation-${nextAllocationId++}`,
            equipmentId:
              args.data
                .equipmentId,
            shelfId:
              args.data.shelfId,
            equipmentQuantity:
              args.data
                .equipmentQuantity,
          };

          allocations.set(
            `${record.equipmentId}:${record.shelfId}`,
            record,
          );

          return record;
        },
      ),
    },

    inventoryWorkUnit: {
      findFirst: vi
        .fn()
        .mockResolvedValue(
          null,
        ),
    },

    mouvement: {
      create: vi
        .fn()
        .mockResolvedValue({
          mouvementId:
            movementId,
        }),

      findUniqueOrThrow:
        vi
          .fn()
          .mockResolvedValue({
            mouvementId:
              movementId,
            mouvementStatus: false,
            mouvementQuantity:
              0,
            origin: 'USER',
            inventoryId: null,
            reason: null,
            items: [],
          }),
    },

    mouvementEquipment: {
      createMany: vi
        .fn()
        .mockResolvedValue({
          count: 1,
        }),
    },
  };

  const transaction =
    vi.fn(
      async (
        callback: (
          client: typeof tx,
        ) => unknown,
        _options?: unknown,
      ) => callback(tx),
    );

  const prisma = {
    $transaction:
      transaction,
  };

  return {
    service:
      new EquipmentMovementService(
        prisma as any,
      ),
    prisma,
    tx,
    transaction,
    equipmentRecords,
    serialRecords,
    allocations,
  };
}

