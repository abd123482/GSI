    searchTerm,
    roles,
    availablePermissions,
    isUsersLoading,
    isUsersFetching,
    isRolesLoading,
    isCreatingRole,
    setPage,
    setStatusFilter,
    setSearchTerm,
    refetchUsers,
    refetchRoles,
    createRole,
    editRole,
    isEditingRole,
    assignRole,
    updateStatus,
  } = useAdminUsers({ initialLimit: 10 });

  // Unauthenticated screen
  if (isLoaded && !isSignedIn) {
    return (
      <div className="max-w-4xl mx-auto px-4 py-16 text-center">
