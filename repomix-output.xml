async getTask(
  attemptId: string,
  currentUserId?: string,
) {
  const attempt =
    await this.prisma.inventoryCountAttempt.findUnique({
      where: { attemptId },
      include: {
        unit: {
          include: {
            inventory: {
              include: {
                Inventory_User: {
                  include: {
                    User: {
                      select: {
                        userId: true,
                        userName: true,
                        userEmail: true,
                      },
                    },
                  },
                  orderBy: {
                    sequence: 'asc',
                  },
                },
              },
            },
          },
        },
        orders: {
          include: {
            serialNumber: {
              select: {
                serialNumberId: true,
                serialNumberCode: true,
              },
            },
            equipment: {
              select: {
                equipmentId: true,
                equipmentName: true,
                hasSerialNumber: true,
              },
            },
            shelf: {
              select: {
                shelfId: true,
                shelfName: true,
              },
            },
          },
        },
      },
    });

  if (!attempt) {
    throw new NotFoundException(
      'Tâche introuvable',
    );
  }

  if (
    currentUserId &&
    attempt.assignedUserId !== currentUserId
  ) {
    throw new ForbiddenException(
      "Vous n'êtes pas le contrôleur assigné à cette tâche.",
    );
  }

  let scopeLabel = 'Unité de travail';
  let isSerialized = false;
  let expectedEquipments: Array<{
    equipmentId: string;
    equipmentName: string;
    hasSerialNumber: boolean;
    quantity: number;
  }> = [];

  let expectedShelves: Array<{
    shelfId: string;
    shelfName: string;
    quantity: number;
  }> = [];

  if (attempt.unit.equipmentId) {
    const equipment =
      await this.prisma.equipment.findUnique({
        where: {
          equipmentId:
            attempt.unit.equipmentId,
        },
        select: {
          equipmentName: true,
          hasSerialNumber: true,
        },
      });

    scopeLabel =
      equipment?.equipmentName ??
      'Article inconnu';

    isSerialized =
      Boolean(
        equipment?.hasSerialNumber,
      );

    const equipmentShelfs = [] as any[];

    const shelfMap = new Map<string, { shelfId: string; shelfName: string; quantity: number }>();
    for (const es of equipmentShelfs) {
      if (es.shelf && es.shelfId) {
        shelfMap.set(es.shelfId, {
          shelfId: es.shelfId,
          shelfName: es.shelf.shelfName ?? 'Emplacement',
          quantity: es.equipmentQuantity,
        });
      }
    }

    if (isSerialized) {
      const serialShelvesCounts = await this.prisma.serialNumber.groupBy({
        by: ['shelfId'],
        where: {
          equipmentId: attempt.unit.equipmentId,
          shelfId: { not: null },
        },
        _count: {
          _all: true,
        },
      });

      const missingShelfIds = serialShelvesCounts
        .map(g => g.shelfId)
        .filter((id): id is string => Boolean(id) && !shelfMap.has(id as string));

      let missingShelvesMap = new Map<string, string>();
      if (missingShelfIds.length > 0) {
        const missingShelves = await this.prisma.shelf.findMany({
          where: { shelfId: { in: missingShelfIds } },
          select: { shelfId: true, shelfName: true },
        });
        for (const s of missingShelves) {
          missingShelvesMap.set(s.shelfId, s.shelfName ?? 'Emplacement');
        }
      }

      for (const group of serialShelvesCounts) {
        if (!group.shelfId) continue;
        const sId = group.shelfId;
        const count = group._count._all;

        const existing = shelfMap.get(sId);
        if (existing) {
          if (count > 0 && existing.quantity === 0) {
            existing.quantity = count;
          }
        } else {
          shelfMap.set(sId, {
            shelfId: sId,
            shelfName: missingShelvesMap.get(sId) ?? 'Emplacement',
            quantity: count,
          });
        }
      }
    }

    expectedShelves = Array.from(shelfMap.values());
  } else if (attempt.unit.shelfId) {
    const shelf =
      await this.prisma.shelf.findUnique({
        where: {
          shelfId:
            attempt.unit.shelfId,
        },
        select: {
          shelfName: true,
        },
      });

    scopeLabel =
      shelf?.shelfName ??
      'Emplacement inconnu';
  }

  return {
    ...attempt,
    scopeLabel,
    isSerialized,
    expectedShelves,
  };
}

async saveDraft(
  attemptId: string,
  userId: string,
  dto: SaveDraftDTO,
) {
  const data =
    saveDraftSchema.parse(dto);

  const attempt =
    await this.prisma.inventoryCountAttempt.findUnique({
      where: { attemptId },
    });

  if (!attempt) {
    throw new NotFoundException(
      'Tâche introuvable',
    );
  }

  if (
    attempt.assignedUserId !== userId
  ) {
    throw new ForbiddenException(
      "Vous n'êtes pas le contrôleur assigné à cette tâche.",
    );
  }

  if (
    ![
      'AVAILABLE',
      'IN_PROGRESS',
    ].includes(attempt.status)
  ) {
    throw new BadRequestException(
      `Cette tâche ne peut plus être modifiée (statut: ${attempt.status}).`,
    );
  }

  await this.prisma.inventoryCountAttempt.update({
    where: { attemptId },
    data: {
      status: 'IN_PROGRESS',
      draftData:
        JSON.stringify(data),
    },
  });

  return {
    success: true,
    message:
      'Brouillon enregistré avec succès.',
  };
}

async submitCountAttempt(
  attemptId: string,
  userId: string,
  dto: SubmitTaskDTO,
) {
  const data =
    submitTaskSchema.parse(dto);

  if (data.isDraft) {
    return this.saveDraft(
      attemptId,
      userId,
      data,
    );
  }

  return this.prisma.$transaction(
    async (tx) => {
      const attempt =
        await tx.inventoryCountAttempt.findUnique({
          where: { attemptId },
          include: {
            unit: {
              include: {
                inventory: true,
              },
            },
          },
        });

      if (!attempt) {
        throw new NotFoundException(
          'Tâche introuvable',
        );
      }

      if (
        attempt.assignedUserId !== userId
      ) {
        throw new ForbiddenException(
          "Vous n'êtes pas le contrôleur assigné à cette tâche.",
        );
      }

      if (
        ![
          'AVAILABLE',
          'IN_PROGRESS',
        ].includes(attempt.status)
      ) {
        throw new BadRequestException(
          `Cette tâche ne peut pas être soumise car elle est au statut '${attempt.status}'.`,
        );
      }

      if (
        attempt.unit.inventory.status !==
        'IN_PROGRESS'
      ) {
        throw new BadRequestException(
          "L'inventaire n'est pas en cours.",
        );
      }

      if (
        attempt.purpose ===
          'FINAL_RECOUNT' &&
        attempt.unit.reconciliationStatus !==
          'THIRD_REQUIRED'
      ) {
        throw new BadRequestException(
          "Cette unité ne nécessite pas de troisième comptage.",
        );
      }

      const inventoryId =
        attempt.unit.inventoryId;

      const unitOrder =
        attempt.unit.unitOrder;

      if (
        attempt.purpose ===
          'PRIMARY_1' ||
        attempt.purpose ===
          'PRIMARY_2'
      ) {
        await this.assertPreviousPrimaryUnitSubmitted(
          tx,
          inventoryId,
          attempt.purpose as AttemptPurpose,
          userId,
          unitOrder,
        );
      }

      const orders =
        await this.buildOrdersFromObservations(
          tx,
          attempt,
          userId,
          data.observations,
        );

      await tx.order.deleteMany({
        where: { attemptId },
      });

      for (const order of orders) {
        await tx.order.create({
          data: order,
        });
      }

      await tx.inventoryCountAttempt.update({
        where: { attemptId },
        data: {
          status: 'SUBMITTED',
          submittedAt: new Date(),
          draftData: null,
        },
      });

      if (
        attempt.purpose ===
        'PRIMARY_1'
      ) {
        await this.advancePrimaryOne(
          tx,
          inventoryId,
          unitOrder,
          userId,
        );
      }

      if (
        attempt.purpose ===
        'PRIMARY_2'
      ) {
        // Compare this exact unit immediately.
        await this.reconcileUnit(
          tx,
          attempt.unitId,
        );

        await this.advancePrimaryTwo(
          tx,
          inventoryId,
          unitOrder,
          userId,
        );
      }

      if (
        attempt.purpose ===
        'FINAL_RECOUNT'
      ) {
        await tx.inventoryWorkUnit.update({
          where: {
            unitId:
              attempt.unitId,
          },
          data: {
            status: 'VALIDATED',
            reconciliationStatus:
              'THIRD_RESOLVED',
            acceptedAttemptId:
              attemptId,
            reconciledAt:
              new Date(),
          },
        });
      }

      await this.refreshInventoryCompletion(
        tx,
        inventoryId,
      );

      return {
        success: true,
        attemptId,
        unitOrder,
      };
    },
    {
      isolationLevel: 'Serializable',
      timeout: 30_000,
    },
  );
}

private async assertPreviousPrimaryUnitSubmitted(
  tx: Prisma.TransactionClient,
  inventoryId: string,
  purpose: AttemptPurpose,
  userId: string,
  unitOrder: number,
) {
  if (unitOrder <= 0) {
    return;
  }

  const previous =
    await tx.inventoryCountAttempt.findFirst({
      where: {
        assignedUserId: userId,
        purpose,
        unit: {
          inventoryId,
          unitOrder:
            unitOrder - 1,
        },
      },
      select: {
        status: true,
      },
    });

  if (
    previous?.status !== 'SUBMITTED'
  ) {
    throw new BadRequestException(
      "L'unité précédente doit être soumise avant celle-ci.",
    );
  }
}

private async buildOrdersFromObservations(
  tx: Prisma.TransactionClient,
  attempt: any,
  userId: string,
  observations: any[],
) {
  const orders:
    Prisma.OrderUncheckedCreateInput[] = [];

  const scanned =
    new Set<string>();

  for (const observation of observations) {
    const targetEquipmentId =
      observation.equipmentId ??
      observation.observedEquipmentId ??
      attempt.unit.equipmentId ??
      null;

    const targetShelfId =
      observation.shelfId ??
      observation.observedShelfId ??
      attempt.unit.shelfId ??
      null;

    if (
      observation.scannedSerialCode
    ) {
      const code =
        observation.scannedSerialCode.trim();

      const codeKey =
        code.toLowerCase();

      if (scanned.has(codeKey)) {
        throw new BadRequestException(
          `Le numéro de série '${code}' a été compté plusieurs fois dans cette même tentative.`,
        );
      }

      scanned.add(codeKey);

      const matches =
        await tx.serialNumber.findMany({
          where: {
            serialNumberCode: code,
          },
          select: {
            serialNumberId: true,
            equipmentId: true,
            shelfId: true,
          },
        });

      const match =
        matches.length === 1
          ? matches[0]
          : null;

      const observedEquipmentId =
        observation.observedEquipmentId ??
        match?.equipmentId ??
        targetEquipmentId;

      const observedShelfId =
        observation.observedShelfId ??
        targetShelfId ??
        match?.shelfId ??
        null;

      const isUnexpected =
        Boolean(
          observation.isUnexpected,
        ) ||
        !match ||
        Boolean(
          targetEquipmentId &&
          match.equipmentId !==
            targetEquipmentId,
        ) ||
        Boolean(
          targetShelfId &&
          match.shelfId !==
            targetShelfId,
        );

      orders.push({
        inventoryId:
          attempt.unit.inventoryId,
        attemptId:
          attempt.attemptId,
        userId,
        equipmentId:
          observedEquipmentId,
        shelfId:
          observedShelfId,
        observedEquipmentId,
        observedShelfId,
        serialNumberId:
          match?.serialNumberId ??
          null,
        scannedSerialCode: code,
        quantityCalculated: 1,
        isExplicitZero: false,
        isUnexpected,
        notes:
          observation.notes ??
          null,
        unknownItemEvidence:
          !match
            ? observation.unknownItemEvidence ??
              `Unknown serial: ${code}`
            : observation.unknownItemEvidence ??
              null,
      });

      continue;
    }

    const quantity =
      Number(
        observation.quantityCalculated ??
          0,
      );

    orders.push({
      inventoryId:
        attempt.unit.inventoryId,
      attemptId:
        attempt.attemptId,
      userId,
      equipmentId:
        targetEquipmentId,
      shelfId:
        targetShelfId,
      observedEquipmentId:
        observation.observedEquipmentId ??
        targetEquipmentId,
      observedShelfId:
        observation.observedShelfId ??
        targetShelfId,
      serialNumberId: null,
      scannedSerialCode: null,
      quantityCalculated: quantity,
      isExplicitZero:
        Boolean(
          observation.isExplicitZero,
        ) ||
        quantity === 0,
      isUnexpected:
        Boolean(
          observation.isUnexpected,
        ),
      notes:
        observation.notes ??
        null,
      unknownItemEvidence:
        observation.unknownItemEvidence ??
        null,
    });
  }

  return orders;
}

private async advancePrimaryOne(
  tx: Prisma.TransactionClient,
  inventoryId: string,
  unitOrder: number,
  userId: string,
) {
  const units =
    await tx.inventoryWorkUnit.findMany({
      where: { inventoryId },
      orderBy: {
        unitOrder: 'asc',
      },
      select: {
        unitId: true,
        unitOrder: true,
      },
    });

  const nextUnit =
    units.find(
      (unit) =>
        unit.unitOrder ===
        unitOrder + 1,
    );

  if (nextUnit) {
    const nextC1 =
      await tx.inventoryCountAttempt.findFirst({
        where: {
          unitId: nextUnit.unitId,
          assignedUserId: userId,
          purpose: 'PRIMARY_1',
        },
      });

    if (
      nextC1?.status === 'BLOCKED'
    ) {
      await tx.inventoryCountAttempt.update({
        where: {
          attemptId:
            nextC1.attemptId,
        },
        data: {
          status: 'AVAILABLE',
        },
      });

      await this.notifyAttemptAvailable(
        tx,
        nextC1.assignedUserId,
        inventoryId,
        nextC1.attemptId,
        nextUnit.unitOrder,
        'PRIMARY_1',
      );
    }
  }

  const currentUnit =
    units.find(
      (unit) =>
        unit.unitOrder ===
        unitOrder,
    );

  if (!currentUnit) {
    return;
  }

  const c2 =
    await tx.inventoryCountAttempt.findFirst({
      where: {
        unitId:
          currentUnit.unitId,
        purpose: 'PRIMARY_2',
      },
    });

  if (
    !c2 ||
    c2.status !== 'BLOCKED'
  ) {
    return;
  }

  let mayUnlock =
    unitOrder === 0;

  if (unitOrder > 0) {
    const previousUnit =
      units.find(
        (unit) =>
          unit.unitOrder ===
          unitOrder - 1,
      );

    if (previousUnit) {
      const previousC2 =
        await tx.inventoryCountAttempt.findFirst({
          where: {
            unitId:
              previousUnit.unitId,
            assignedUserId:
              c2.assignedUserId,
            purpose: 'PRIMARY_2',
            status: 'SUBMITTED',
          },
          select: {
            attemptId: true,
          },
        });

      mayUnlock =
        Boolean(previousC2);
    }
  }

  if (mayUnlock) {
    await tx.inventoryCountAttempt.update({
      where: {
        attemptId:
          c2.attemptId,
      },
      data: {
        status: 'AVAILABLE',
      },
    });

    await this.notifyAttemptAvailable(
      tx,
      c2.assignedUserId,
      inventoryId,
      c2.attemptId,
      unitOrder,
      'PRIMARY_2',
    );
  }
}

private async advancePrimaryTwo(
  tx: Prisma.TransactionClient,
  inventoryId: string,
  unitOrder: number,
  userId: string,
) {
  const nextUnit =
    await tx.inventoryWorkUnit.findFirst({
      where: {
        inventoryId,
        unitOrder:
          unitOrder + 1,
      },
      select: {
        unitId: true,
        unitOrder: true,
      },
    });

  if (!nextUnit) {
    return;
  }

  const nextC1 =
    await tx.inventoryCountAttempt.findFirst({
      where: {
        unitId:
          nextUnit.unitId,
        purpose: 'PRIMARY_1',
        status: 'SUBMITTED',
      },
      select: {
        attemptId: true,
      },
    });

  if (!nextC1) {
    return;
  }

  const nextC2 =
    await tx.inventoryCountAttempt.findFirst({
      where: {
        unitId:
          nextUnit.unitId,
        assignedUserId: userId,
        purpose: 'PRIMARY_2',
      },
    });

  if (
    nextC2?.status === 'BLOCKED'
  ) {
    await tx.inventoryCountAttempt.update({
      where: {
        attemptId:
          nextC2.attemptId,
      },
      data: {
        status: 'AVAILABLE',
      },
    });

    await this.notifyAttemptAvailable(
      tx,
      nextC2.assignedUserId,
      inventoryId,
      nextC2.attemptId,
      nextUnit.unitOrder,
      'PRIMARY_2',
    );
  }
}

private async notifyAttemptAvailable(
  tx: Prisma.TransactionClient,
  recipientId: string,
  inventoryId: string,
  attemptId: string,
  unitOrder: number,
  purpose: AttemptPurpose,
) {
  await tx.notification.create({
    data: {
      recipientId,
      eventType:
        'INVENTORY_TASK_AVAILABLE',
      payload: JSON.stringify({
        inventoryId,
        taskId: attemptId,
        unitOrder,
        purpose,
      }),
    },
  });
}

// --------------------------------------------------------------------------
// Per-unit reconciliation
// --------------------------------------------------------------------------

async reconcilePrimaryInventory(
  inventoryId: string,
  txClient?: Prisma.TransactionClient,
) {
  const run =
    async (
      tx: Prisma.TransactionClient,
    ) => {
      const units =
        await tx.inventoryWorkUnit.findMany({
          where: {
            inventoryId,
            reconciliationStatus:
              'PENDING',
          },
          include: {
            attempts: {
              where: {
                status: 'SUBMITTED',
                purpose: {
                  in: [
                    'PRIMARY_1',
                    'PRIMARY_2',
                  ],
                },
              },
              include: {
                orders: {
                  include: {
                    serialNumber: true,
                    equipment: true,
                    shelf: true,
                  },
                },
              },
            },
          },
          orderBy: {
            unitOrder: 'asc',
          },
        });

      const reconciled: Array<{
        unitId: string;
        result: string;
      }> = [];

      for (const unit of units) {
        const c1 =
          unit.attempts.find(
            (attempt) =>
              attempt.purpose ===
              'PRIMARY_1',
          );

        const c2 =
          unit.attempts.find(
            (attempt) =>
              attempt.purpose ===
              'PRIMARY_2',
          );

        if (!c1 || !c2) {
          continue;
        }

        const result =
          await this.reconcileUnitLoaded(
            tx,
            unit,
            c1,
            c2,
          );

        reconciled.push({
          unitId:
            unit.unitId,
          result,
        });
      }

      await this.refreshInventoryCompletion(
        tx,
        inventoryId,
      );

      return {
        inventoryId,
        reconciled,
      };
    };

  if (txClient) {
    return run(txClient);
  }

  return this.prisma.$transaction(
    run,
    {
      isolationLevel: 'Serializable',
      timeout: 30_000,
    },
  );
}

private async reconcileUnit(
  tx: Prisma.TransactionClient,
  unitId: string,
) {
  const unit =
    await tx.inventoryWorkUnit.findUnique({
      where: { unitId },
      include: {
        attempts: {
          where: {
            status: 'SUBMITTED',
          },
          include: {
            orders: {
              include: {
                serialNumber: true,
                equipment: true,
                shelf: true,
              },
            },
          },
        },
      },
    });

  if (!unit) {
    throw new NotFoundException(
      'Unité de travail introuvable',
    );
  }

  if (
    unit.reconciliationStatus !==
    'PENDING'
  ) {
    return unit.reconciliationStatus;
  }

  const c1 =
    unit.attempts.find(
      (attempt) =>
        attempt.purpose ===
        'PRIMARY_1',
    );

  const c2 =
    unit.attempts.find(
      (attempt) =>
        attempt.purpose ===
        'PRIMARY_2',
    );

  if (!c1 || !c2) {
    return 'PENDING';
  }

  return this.reconcileUnitLoaded(
    tx,
    unit,
    c1,
    c2,
  );
}

private async reconcileUnitLoaded(
  tx: Prisma.TransactionClient,
  unit: any,
  c1: any,
  c2: any,
) {
  const first =
    this.canonicalizeAttempt(
      unit,
      c1,
    );

  const second =
    this.canonicalizeAttempt(
      unit,
      c2,
    );

  if (
    this.canonicalAttemptsEqual(
      first,
      second,
    )
  ) {
    await tx.inventoryWorkUnit.update({
      where: {
        unitId: unit.unitId,
      },
      data: {
        status: 'VALIDATED',
        reconciliationStatus:
          'PRIMARY_MATCH',
        acceptedAttemptId:
          c1.attemptId,
        reconciledAt:
          new Date(),
      },
    });

    return 'PRIMARY_MATCH';
  }

  const inventory =
    await tx.inventory.findUnique({
      where: {
        inventoryId:
          unit.inventoryId,
      },
      include: {
        Inventory_User: {
          orderBy: {
            sequence: 'asc',
          },
        },
      },
    });

  if (!inventory) {
    throw new NotFoundException(
      'Inventaire introuvable',
    );
  }

  const controller3 =
    inventory.Inventory_User.find(
      (participant) =>
        participant.sequence === 2,
    );

  if (!controller3) {
    throw new BadRequestException(
      "Un écart C1/C2 nécessite un troisième contrôleur, mais aucun contrôleur final n'est assigné.",
    );
  }

  let c3 =
    await tx.inventoryCountAttempt.findFirst({
      where: {
        unitId: unit.unitId,
        purpose:
          'FINAL_RECOUNT',
      },
    });

  if (!c3) {
    c3 =
      await tx.inventoryCountAttempt.create({
        data: {
          unitId: unit.unitId,
          assignedUserId:
            controller3.userId,
          sequence: 2,
          purpose:
            'FINAL_RECOUNT',
          status: 'AVAILABLE',
          linkedPriorAttemptId:
            c2.attemptId,
        },
      });
  } else if (
    c3.status === 'BLOCKED'
  ) {
    c3 =
      await tx.inventoryCountAttempt.update({
        where: {
          attemptId:
            c3.attemptId,
        },
        data: {
          status: 'AVAILABLE',
        },
      });
  }

  await tx.inventoryWorkUnit.update({
    where: {
      unitId: unit.unitId,
    },
    data: {
      status:
        'RECOUNT_REQUIRED',
      reconciliationStatus:
        'THIRD_REQUIRED',
      acceptedAttemptId: null,
      reconciledAt: null,
    },
  });

  await tx.inventory.update({
    where: {
      inventoryId:
        unit.inventoryId,
    },
    data: {
      // Compatibility only. Per-unit status is authoritative.
      thirdCountRequired: true,
      finalResultSource:
        'PER_UNIT_ACCEPTED_ATTEMPT',
    },
  });

  await tx.notification.create({
    data: {
      recipientId:
        controller3.userId,
      eventType:
        'INVENTORY_THIRD_COUNT_REQUIRED',
      payload: JSON.stringify({
        inventoryId:
          unit.inventoryId,
        unitId:
          unit.unitId,
        unitOrder:
          unit.unitOrder,
        taskId:
          c3.attemptId,
        message:
          `Un écart C1/C2 a été détecté uniquement sur l'unité #${unit.unitOrder + 1}.`,
      }),
    },
  });

  return 'THIRD_REQUIRED';
}

private canonicalizeAttempt(
  unit: any,
  attempt: any,
): CanonicalAttempt {
  const standard =
    new Map<
      string,
      CanonicalStandardValue
    >();

  const serials =
    new Map<
      string,
      CanonicalSerialValue
    >();

  const unknown =
    new Set<string>();

  for (
    const order of
    attempt.orders ?? []
  ) {
    const equipmentId =
      (
        order.observedEquipmentId ??
        order.equipmentId ??
        unit.equipmentId ??
        ''
      )
        .toString()
        .trim();

    const shelfId =
      (
        order.observedShelfId ??
        order.shelfId ??
        unit.shelfId ??
        ''
      )
        .toString()
        .trim();

    const serialCode =
      (
        order.scannedSerialCode ??
        order.serialNumber
          ?.serialNumberCode ??
        ''
      )
        .toString()
        .trim();

    if (serialCode) {
      serials.set(
        serialCode.toLowerCase(),
        {
          serialCode,
          serialNumberId:
            order.serialNumberId ??
            null,
          equipmentId,
          shelfId:
            shelfId || null,
        },
      );

      continue;
    }

    if (
      equipmentId &&
      shelfId
    ) {
      const key =
        `${equipmentId.toLowerCase()}:${shelfId.toLowerCase()}`;

      const quantity =
        Number(
          order.quantityCalculated ??
            0,
        );

      const existing =
        standard.get(key);

      standard.set(
        key,
        {
          equipmentId,
          shelfId,
          quantity:
            (
              existing
                ?.quantity ??
              0
            ) +
            quantity,
        },
      );

      continue;
    }

    if (
      order.unknownItemEvidence
    ) {
      unknown.add(
        String(
          order.unknownItemEvidence,
        )
          .trim()
          .toLowerCase(),
      );
    }
  }

  return {
    standard,
    serials,
    unknown,
  };
}

private canonicalAttemptsEqual(
  left: CanonicalAttempt,
  right: CanonicalAttempt,
) {
  const standardKeys =
    new Set([
      ...left.standard.keys(),
      ...right.standard.keys(),
    ]);

  for (
    const key of standardKeys
  ) {
    if (
      (
        left.standard.get(key)
          ?.quantity ?? 0
      ) !==
      (
        right.standard.get(key)
          ?.quantity ?? 0
      )
    ) {
      return false;
    }
  }

  if (
    left.serials.size !==
    right.serials.size
  ) {
    return false;
  }

  for (
    const [code, value] of
    left.serials
  ) {
    const other =
      right.serials.get(code);

    if (!other) {
      return false;
    }

    if (
      value.equipmentId.toLowerCase() !==
        other.equipmentId.toLowerCase() ||
      (
        value.shelfId ?? ''
      ).toLowerCase() !==
        (
          other.shelfId ?? ''
        ).toLowerCase()
    ) {
      return false;
    }
  }

  if (
    left.unknown.size !==
    right.unknown.size
  ) {
    return false;
  }

  for (
    const value of left.unknown
  ) {
    if (
      !right.unknown.has(value)
    ) {
      return false;
    }
  }

  return true;
}

private async refreshInventoryCompletion(
  tx: Prisma.TransactionClient,
  inventoryId: string,
) {
  const total =
    await tx.inventoryWorkUnit.count({
      where: { inventoryId },
    });

  if (!total) {
    return;
  }

  const pending =
    await tx.inventoryWorkUnit.count({
      where: {
        inventoryId,
        reconciliationStatus: {
          notIn:
            RECONCILED_STATUSES,
        },
      },
    });

  const thirdRequired =
    await tx.inventoryWorkUnit.count({
      where: {
        inventoryId,
        reconciliationStatus:
          'THIRD_REQUIRED',
      },
    });

  if (pending === 0) {
    const inventory =
      await tx.inventory.update({
        where: { inventoryId },
        data: {
          status: 'COMPLETED',
          thirdCountRequired: false,
          finalResultSource:
            'PER_UNIT_ACCEPTED_ATTEMPT',
        },
      });

    if (inventory.creatorId) {
      await tx.notification.create({
        data: {
          recipientId:
            inventory.creatorId,
          eventType:
            'INVENTORY_COUNTS_COMPLETED',
          payload: JSON.stringify({
            inventoryId,
            title:
              inventory.title,
            message:
              "Toutes les unités ont un résultat accepté. L'inventaire est prêt à être finalisé.",
          }),
        },
      });
    }

    return;
  }

  await tx.inventory.update({
    where: { inventoryId },
    data: {
      status: 'IN_PROGRESS',
      thirdCountRequired:
        thirdRequired > 0,
      finalResultSource:
        'PER_UNIT_ACCEPTED_ATTEMPT',
    },
  });
}


