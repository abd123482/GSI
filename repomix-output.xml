<file path="src/components/users/UserAutocomplete.tsx">
'use client';

import { useState, useRef, useEffect } from 'react';
import { useAdminUsers } from '@/hooks/use-admin-users';
import { Search, Loader2 } from 'lucide-react';

interface UserAutocompleteProps {
  value: string;
  onChange: (userId: string) => void;
  placeholder?: string;
  error?: string;
}

export function UserAutocomplete({ value, onChange, placeholder = "Rechercher un utilisateur...", error }: UserAutocompleteProps) {
  const [isOpen, setIsOpen] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);
  
  // We fetch a larger limit to have options available
  const { users, searchTerm, setSearchTerm, isUsersLoading } = useAdminUsers({ initialLimit: 50 });

  useEffect(() => {
    function handleClickOutside(event: MouseEvent) {
      if (containerRef.current && !containerRef.current.contains(event.target as Node)) {
        setIsOpen(false);
      }
    }
    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, [containerRef]);

  const selectedUser = users.find((u) => u.userId === value);
  const displayValue = isOpen 
    ? searchTerm 
    : (selectedUser ? (selectedUser.userName || selectedUser.userEmail) : value);

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setSearchTerm(e.target.value);
    onChange(''); // Clear selected value when typing
    setIsOpen(true);
  };

  return (
    <div className="relative w-full" ref={containerRef}>
      <div className="relative flex items-center">
        <Search className="absolute left-2.5 w-3.5 h-3.5 text-[#5c544d]" />
        <input
          ref={inputRef}
          type="text"
          value={displayValue}
          onChange={handleInputChange}
          onFocus={() => setIsOpen(true)}
          placeholder={placeholder}
          className={`w-full h-9 bg-[#2b2622] border ${error ? 'border-red-500' : 'border-[#3f3a36]'} rounded-[3px] pl-8 pr-3 text-sm focus:outline-none focus:border-[#aea69c] transition-colors text-[#f7f5f0] placeholder:text-[#5c544d]`}
        />
        {isUsersLoading && (
          <Loader2 className="absolute right-2.5 w-3.5 h-3.5 animate-spin text-[#aea69c]" />
        )}
      </div>
      
      {isOpen && (
        <div className="absolute z-50 w-full mt-1 bg-[#2f2a26] border border-[#3f3a36] rounded-[3px] shadow-lg max-h-60 overflow-y-auto">
          {users.length === 0 && !isUsersLoading ? (
            <div className="px-3 py-2 text-xs text-[#aea69c] text-center">Aucun utilisateur trouvé</div>
          ) : (
            <div className="p-1 space-y-0.5">
              {users.map((user) => (
                <button
                  key={user.userId}
                  type="button"
                  onClick={() => {
                    onChange(user.userId);
                    setSearchTerm('');
                    setIsOpen(false);
                  }}
                  className="w-full text-left px-2.5 py-1.5 rounded-[2px] text-xs transition-colors hover:bg-[#383330] flex flex-col items-start gap-0.5"
                >
                  <span className="font-medium text-[#f7f5f0]">{user.userName || 'Sans nom'}</span>
                  <span className="text-[10px] text-[#aea69c]">{user.userEmail}</span>
                </button>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/users/UserListTable.tsx">
'use client';

import { useState } from 'react';
import {
  AdminUser,
  Role,
  UserStatus,
} from '@/types/user-role';
import {
  UserCheck,
  UserX,
  Clock,
  Shield,
  Loader2,
  ChevronLeft,
  ChevronRight,
} from 'lucide-react';

interface UserListTableProps {
  users: AdminUser[];
  roles: Role[];
  isLoading: boolean;
  totalUsers: number;
  totalPages: number;
  currentPage: number;
  onPageChange: (page: number) => void;
  onAssignRole: (userId: string, roleId: string | null) => Promise<void>;
  onUpdateStatus: (userId: string, status: UserStatus) => Promise<void>;
  isAssigningRole?: boolean;
  canManageUsers?: boolean;
  canManageRoles?: boolean;
  currentUserId?: string | null;
}

export function UserListTable({
  users,
  roles,
  isLoading,
  totalUsers,
  totalPages,
  currentPage,
  onPageChange,
  onAssignRole,
  onUpdateStatus,
  canManageUsers = true,
  canManageRoles = true,
  currentUserId,
}: UserListTableProps) {
  const [updatingUserId, setUpdatingUserId] = useState<string | null>(null);

  const handleRoleChange = async (userId: string, newRoleId: string) => {
    setUpdatingUserId(userId);
    try {
      await onAssignRole(userId, newRoleId === 'none' ? null : newRoleId);
    } finally {
      setUpdatingUserId(null);
    }
  };

  const handleStatusToggle = async (userId: string, currentStatus: UserStatus) => {
    setUpdatingUserId(userId);
    try {
      const nextStatus: UserStatus =
        currentStatus === 'ACTIVE'
          ? 'DISABLED'
          : 'ACTIVE';
      await onUpdateStatus(userId, nextStatus);
    } finally {
      setUpdatingUserId(null);
    }
  };

  const renderStatusBadge = (status: UserStatus) => {
    switch (status) {
      case 'ACTIVE':
        return (
          <span className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] bg-[#162b22] text-[#10b981] text-[11px] font-mono border border-[#1e3d30]">
            <span className="w-1.5 h-1.5 rounded-full bg-[#10b981]" />
            Actif
          </span>
        );
      case 'PENDING':
        return (
          <span className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] bg-[#2d2212] text-[#f59e0b] text-[11px] font-mono border border-[#453316]">
            <Clock className="w-3 h-3 text-[#f59e0b]" />
            En attente
          </span>
        );
      case 'DISABLED':
        return (
          <span className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] bg-[#2d1616] text-[#ef4444] text-[11px] font-mono border border-[#451e1e]">
            <span className="w-1.5 h-1.5 rounded-full bg-[#ef4444]" />
            Désactivé
          </span>
        );
      default:
        return <span className="text-xs font-mono text-[#aea69c]">{status}</span>;
    }
  };

  return (
    <div className="bg-[#383330] rounded-[4px] border border-[#3f3a36] overflow-hidden flex flex-col shadow-xs">
      {/* Table Content */}
      <div className="overflow-x-auto">
        <table className="w-full text-left border-collapse">
          <thead>
            <tr className="bg-[#2b2622] border-b border-[#3f3a36] text-[11px] font-mono uppercase tracking-wider text-[#aea69c]">
              <th className="px-5 py-3">Utilisateur</th>
              <th className="px-5 py-3">Statut</th>
              <th className="px-5 py-3">Rôle Assigné</th>
              <th className="px-5 py-3">Permissions Actives</th>
              <th className="px-5 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-[#3f3a36] text-xs">
            {isLoading ? (
              Array.from({ length: 5 }).map((_, idx) => (
                <tr key={idx} className="animate-pulse">
                  <td className="px-5 py-4">
                    <div className="flex items-center gap-3">
                      <div className="w-7 h-7 rounded-[3px] bg-[#2b2622]" />
                      <div className="space-y-1.5">
                        <div className="w-32 h-3.5 bg-[#2b2622] rounded" />
                        <div className="w-48 h-3 bg-[#2b2622] rounded" />
                      </div>
                    </div>
                  </td>
                  <td className="px-5 py-4">
                    <div className="w-16 h-5 bg-[#2b2622] rounded" />
                  </td>
                  <td className="px-5 py-4">
                    <div className="w-28 h-7 bg-[#2b2622] rounded" />
                  </td>
                  <td className="px-5 py-4">
                    <div className="w-20 h-4 bg-[#2b2622] rounded" />
                  </td>
                  <td className="px-5 py-4 text-right">
                    <div className="w-6 h-6 bg-[#2b2622] rounded inline-block" />
                  </td>
                </tr>
              ))
            ) : users.length === 0 ? (
              <tr>
                <td colSpan={5} className="px-5 py-12 text-center text-[#aea69c]">
                  <div className="flex flex-col items-center justify-center gap-2">
                    <div className="w-9 h-9 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#aea69c]">
                      <Shield className="w-4 h-4" />
                    </div>
                    <p className="font-medium text-sm text-[#f7f5f0]">
                      Aucun utilisateur trouvé
                    </p>
                    <p className="text-xs text-[#aea69c]">
                      Les utilisateurs connectés via Clerk apparaîtront ici.
                    </p>
                  </div>
                </td>
              </tr>
            ) : (
              users.map((user) => {
                const isCurrentUpdating = updatingUserId === user.userId;
                const permissionsCount = user.role?.permissions?.length ?? 0;
                const initial = (user.userName?.[0] || user.userEmail[0] || 'U').toUpperCase();
                const isSelf = !!currentUserId && user.userId === currentUserId;

                return (
                  <tr
                    key={user.userId}
                    className="hover:bg-[#2b2622]/40 transition-colors"
                  >
                    {/* User Profile */}
                    <td className="px-5 py-3">
                      <div className="flex items-center gap-3">
                        <div className="w-7 h-7 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] text-[#f7f5f0] font-mono text-xs flex items-center justify-center shrink-0">
                          {initial}
                        </div>
                        <div className="flex flex-col min-w-0">
                          <div className="flex items-center gap-1.5">
                            <span className="font-medium text-[#f7f5f0] truncate">
                              {user.userName || 'Sans nom'}
                            </span>
                            {isSelf && (
                              <span className="px-1.5 py-0.2 rounded-[2px] text-[10px] font-mono font-medium bg-[#2b2622] text-[#dad2c1] border border-[#3f3a36]">
                                Vous
                              </span>
                            )}
                          </div>
                          <span className="text-[11px] font-mono text-[#aea69c] truncate">
                            {user.userEmail}
                          </span>
                        </div>
                      </div>
                    </td>

                    {/* Status */}
                    <td className="px-5 py-3">
                      {renderStatusBadge(user.userStatus)}
                    </td>

                    {/* Assigned Role Dropdown */}
                    <td className="px-5 py-3">
                      {canManageRoles ? (
                        <div className="relative inline-block w-44">
                          <select
                            value={user.roleId ?? 'none'}
                            disabled={isCurrentUpdating}
                            onChange={(e) =>
                              handleRoleChange(user.userId, e.target.value)
                            }
                            className={`w-full text-xs font-mono py-1 px-2 rounded-[3px] border transition-colors appearance-none cursor-pointer focus:outline-none focus:border-[#f7f5f0] ${
                              user.role
                                ? 'bg-[#2b2622] border-[#3f3a36] text-[#f7f5f0]'
                                : 'bg-[#2b2622] border-[#3f3a36] text-[#aea69c]'
                            }`}
                          >
                            <option value="none">-- Aucun rôle --</option>
                            {roles.map((r) => (
                              <option key={r.roleId} value={r.roleId}>
                                {r.roleName}
                              </option>
                            ))}
                          </select>
                          {isCurrentUpdating && (
                            <div className="absolute right-2 top-2">
                              <Loader2 className="w-3.5 h-3.5 text-[#f7f5f0] animate-spin" />
                            </div>
                          )}
                        </div>
                      ) : (
                        <span
                          className={`inline-block text-xs font-mono px-2 py-0.5 rounded-[2px] border ${
                            user.role
                              ? 'bg-[#2b2622] border-[#3f3a36] text-[#f7f5f0]'
                              : 'text-[#aea69c] border-transparent'
                          }`}
                        >
                          {user.role ? user.role.roleName : 'Aucun'}
                        </span>
                      )}
                    </td>

                    {/* Permissions summary */}
                    <td className="px-5 py-3">
                      <span className="text-xs font-mono text-[#c9c0ad]">
                        {permissionsCount > 0 ? (
                          <span className="text-[#f7f5f0]">
                            {permissionsCount} permission
                            {permissionsCount > 1 ? 's' : ''}
                          </span>
                        ) : (
                          <span className="text-[#aea69c]">Aucune</span>
                        )}
                      </span>
                    </td>

                    {/* Actions */}
                    <td className="px-5 py-3 text-right">
                      {canManageUsers && (
                        <div className="inline-flex items-center gap-1.5">
                          {isSelf ? (
                            <span className="text-[11px] font-mono text-[#aea69c] px-1">
                              Session active
                            </span>
                          ) : user.userStatus === 'PENDING' ? (
                            <button
                              type="button"
                              onClick={() => handleStatusToggle(user.userId, user.userStatus)}
                              disabled={isCurrentUpdating}
                              title="Activer ce compte"
                              className="px-2.5 py-1 text-xs font-medium text-[#2b2622] bg-[#f7f5f0] hover:bg-[#dad2c1] rounded-[3px] transition-colors flex items-center gap-1 cursor-pointer"
                            >
                              <UserCheck className="w-3 h-3" />
                              <span>Activer</span>
                            </button>
                          ) : (
                            <button
                              type="button"
                              onClick={() => handleStatusToggle(user.userId, user.userStatus)}
                              disabled={isCurrentUpdating}
                              title={
                                user.userStatus === 'ACTIVE'
                                  ? 'Désactiver le compte'
                                  : 'Réactiver le compte'
                              }
                              className={`p-1.5 rounded-[3px] transition-colors cursor-pointer ${
                                user.userStatus === 'ACTIVE'
                                  ? 'text-[#aea69c] hover:text-[#ef4444] hover:bg-[#2b2622]'
                                  : 'text-[#10b981] hover:bg-[#2b2622]'
                              }`}
                            >
                              {user.userStatus === 'ACTIVE' ? (
                                <UserX className="w-3.5 h-3.5" />
                              ) : (
                                <UserCheck className="w-3.5 h-3.5" />
                              )}
                            </button>
                          )}
                        </div>
                      )}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      {/* Pagination Footer */}
      <div className="px-5 py-2.5 border-t border-[#3f3a36] bg-[#2b2622] flex items-center justify-between text-xs text-[#aea69c] font-mono">
        <span>
          Total : <strong className="text-[#f7f5f0]">{totalUsers}</strong>{' '}
          compte{totalUsers > 1 ? 's' : ''}
        </span>

        <div className="flex items-center gap-2">
          <span>
            Page {currentPage} / {totalPages || 1}
          </span>
          <div className="flex items-center gap-1">
            <button
              type="button"
              onClick={() => onPageChange(currentPage - 1)}
              disabled={currentPage <= 1 || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            >
              <ChevronLeft className="w-3.5 h-3.5" />
            </button>
            <button
              type="button"
              onClick={() => onPageChange(currentPage + 1)}
              disabled={currentPage >= totalPages || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            >
              <ChevronRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/hooks/use-admin-users.ts">
'use client';

import { useState, useMemo } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { toast } from 'sonner';
import { useApi } from './use-api';
import { AdminUsersService } from '@/services/admin-users.service';
import {
  AdminUser,
  Role,
  CreateRoleInput,
  EditRoleInput,
  AssignRoleInput,
  UpdateUserStatusInput,
  UserStatus,
  PaginatedUsersResponse,
} from '@/types/user-role';
import { getErrorMessage } from '@/lib/error-message';

interface UseAdminUsersOptions {
  initialPage?: number;
  initialLimit?: number;
  initialStatus?: UserStatus;
}

export function useAdminUsers(options: UseAdminUsersOptions = {}) {
  const api = useApi();
  const queryClient = useQueryClient();

  const [page, setPage] = useState(options.initialPage ?? 1);
  const [limit, setLimit] = useState(options.initialLimit ?? 10);
  const [statusFilter, setStatusFilter] = useState<UserStatus | undefined>(
    options.initialStatus,
  );
  const [searchTerm, setSearchTerm] = useState('');

  // 1. Fetch Paginated Users
  const {
    data: usersData,
    isLoading: isUsersLoading,
    isFetching: isUsersFetching,
    error: usersError,
    refetch: refetchUsers,
  } = useQuery<PaginatedUsersResponse>({
    queryKey: ['admin', 'users', { page, limit, status: statusFilter }],
    queryFn: () =>
      AdminUsersService.getUsers(api, {
        page,
        limit,
        status: statusFilter,
      }),
    staleTime: 60 * 1000,
  });

  // 2. Fetch Roles
  const {
    data: roles = [],
    isLoading: isRolesLoading,
    error: rolesError,
    refetch: refetchRoles,
  } = useQuery<Role[]>({
    queryKey: ['admin', 'roles'],
    queryFn: () => AdminUsersService.getRoles(api),
    staleTime: 60 * 1000,
  });

  // 3. Fetch Available Permissions
  const {
    data: availablePermissions = [],
    isLoading: isPermissionsLoading,
  } = useQuery<string[]>({
    queryKey: ['admin', 'permissions'],
    queryFn: () => AdminUsersService.getAvailablePermissions(api),
    staleTime: 5 * 60 * 1000,
  });

  // Client-side search filtering across user name, email, or role
  const filteredUsers = useMemo(() => {
    const rawUsers = usersData?.data ?? [];
    if (!searchTerm.trim()) return rawUsers;

    const term = searchTerm.toLowerCase();
    return rawUsers.filter(
      (u) =>
        u.userName?.toLowerCase().includes(term) ||
        u.userEmail.toLowerCase().includes(term) ||
        u.role?.roleName.toLowerCase().includes(term),
    );
  }, [usersData?.data, searchTerm]);

  // Mutation: Create Role
  const createRoleMutation = useMutation({
    mutationFn: (input: CreateRoleInput) =>
      AdminUsersService.createRole(api, input),
    onSuccess: (newRole) => {
      toast.success(`Le rôle '${newRole.roleName}' a été créé avec succès !`);
      queryClient.invalidateQueries({ queryKey: ['admin', 'roles'] });
      queryClient.invalidateQueries({ queryKey: ['admin', 'permissions'] });
    },
    onError: (err) => {
      const msg = getErrorMessage(err, 'Une erreur est survenue lors de la création du rôle.');
      toast.error(`Échec de création du rôle : ${msg}`);
    },
  });

  // Mutation: Edit Role
  const editRoleMutation = useMutation({
    mutationFn: (input: EditRoleInput) =>
      AdminUsersService.editRole(api, input),
    onSuccess: (updatedRole) => {
      toast.success(`Le rôle '${updatedRole.roleName}' a été modifié avec succès !`);
      queryClient.invalidateQueries({ queryKey: ['admin', 'roles'] });
      queryClient.invalidateQueries({ queryKey: ['admin', 'users'] });
    },
    onError: (err) => {
      const msg = getErrorMessage(err, 'Une erreur est survenue lors de la modification du rôle.');
      toast.error(`Échec de modification du rôle : ${msg}`);
    },
  });

  // Mutation: Assign Role to User
  const assignRoleMutation = useMutation({
    mutationFn: (input: AssignRoleInput) =>
      AdminUsersService.assignUserRole(api, input),
    onSuccess: (updatedUser) => {
      toast.success(
        `Rôle mis à jour pour ${updatedUser.userName || updatedUser.userEmail} !`,
      );
      queryClient.invalidateQueries({ queryKey: ['admin', 'users'] });
      queryClient.invalidateQueries({ queryKey: ['admin', 'roles'] });
    },
    onError: (err) => {
      const msg = getErrorMessage(err, "Une erreur est survenue lors de l'assignation du rôle.");
      toast.error(`Impossible d'assigner le rôle : ${msg}`);
    },
  });

  // Mutation: Update User Status
  const updateStatusMutation = useMutation({
    mutationFn: (input: UpdateUserStatusInput) =>
      AdminUsersService.updateUserStatus(api, input),
    onSuccess: (updatedUser) => {
      toast.success(
        `Statut changé pour ${updatedUser.userName || updatedUser.userEmail} (${updatedUser.userStatus}) !`,
      );
      queryClient.invalidateQueries({ queryKey: ['admin', 'users'] });
    },
    onError: (err) => {
      const msg = getErrorMessage(err, 'Une erreur est survenue lors de la mise à jour du statut.');
      toast.error(`Impossible de modifier le statut : ${msg}`);
    },
  });

  return {
    users: filteredUsers,
    totalUsers: usersData?.meta.total ?? 0,
    totalPages: usersData?.meta.totalPages ?? 1,
    currentPage: page,
    limit,
    statusFilter,
    searchTerm,
    roles,
    availablePermissions,
    isUsersLoading,
    isUsersFetching,
    isRolesLoading,
    isPermissionsLoading,
    usersError,
    rolesError,
    setPage,
    setLimit,
    setStatusFilter,
    setSearchTerm,
    refetchUsers,
    refetchRoles,
    createRole: createRoleMutation.mutateAsync,
    isCreatingRole: createRoleMutation.isPending,
    editRole: editRoleMutation.mutateAsync,
    isEditingRole: editRoleMutation.isPending,
    assignRole: assignRoleMutation.mutateAsync,
    isAssigningRole: assignRoleMutation.isPending,
    updateStatus: updateStatusMutation.mutateAsync,
    isUpdatingStatus: updateStatusMutation.isPending,
  };
}
</file>

<file path="src/hooks/use-api.ts">
'use client';

import { useMemo } from 'react';
import { useAuth } from '@clerk/nextjs';
import axios, { AxiosInstance } from 'axios';
import { API_BASE_URL } from '@/lib/api';

/**
 * Reusable hook providing an Axios client that automatically fetches and
 * attaches the current Clerk session Bearer token for NestJS API requests.
 */
export function useApi(): AxiosInstance {
  const { getToken, isSignedIn } = useAuth();

  const api = useMemo(() => {
    const client = axios.create({
      baseURL: API_BASE_URL,
      headers: {
        'Content-Type': 'application/json',
      },
      timeout: 15000,
    });

    client.interceptors.request.use(
      async (config) => {
        if (!isSignedIn) {
          return Promise.reject(new Error('User is not signed in'));
        }
        
        try {
          const token = await getToken();
          if (token) {
            if (config.headers && typeof config.headers.set === 'function') {
              config.headers.set('Authorization', `Bearer ${token}`);
            } else {
              config.headers.Authorization = `Bearer ${token}`;
            }
          } else {
            return Promise.reject(new Error('Failed to acquire Clerk token'));
          }
        } catch (err) {
          console.error('[useApi] Error acquiring Clerk session token:', err);
          return Promise.reject(err);
        }
        
        return config;
      },
      (error) => Promise.reject(error),
    );
    
    client.interceptors.response.use(
      (response) => response,
      async (error) => {
        const originalRequest = error.config;
        
        // Single retry for 401s
        if (error.response?.status === 401 && originalRequest && !originalRequest._retry) {
          originalRequest._retry = true;
          try {
            // Force a refresh of the token by skipping the cache if possible
            // We pass { skipCache: true } if supported, otherwise just re-request
            const token = await getToken();
            if (token) {
              if (originalRequest.headers && typeof originalRequest.headers.set === 'function') {
                originalRequest.headers.set('Authorization', `Bearer ${token}`);
              } else {
                originalRequest.headers.Authorization = `Bearer ${token}`;
              }
              return client(originalRequest);
            }
          } catch (e) {
            return Promise.reject(e);
          }
        }
        
        return Promise.reject(error);
      }
    );

    return client;
  }, [getToken, isSignedIn]);

  return api;
}
</file>

<file path="src/hooks/use-auth-query-context.ts">
'use client';

import { useAuth } from '@clerk/nextjs';
import { useMemo } from 'react';

/**
 * A specialized hook to provide a unified auth state for React Query.
 * This guarantees that queries are only enabled when Clerk has fully loaded
 * AND the user is signed in, avoiding anonymous 401 leaks and cache spillage.
 */
export function useAuthQueryContext() {
  const { isLoaded, isSignedIn, userId } = useAuth();

  return useMemo(() => {
    return {
      isLoaded,
      isSignedIn: Boolean(isSignedIn),
      userId,
      /** True only if Clerk is fully loaded AND the user is logged in. */
      authReady: isLoaded && Boolean(isSignedIn) && Boolean(userId),
    };
  }, [isLoaded, isSignedIn, userId]);
}
</file>

<file path="src/hooks/use-dashboard.ts">
'use client';

import { useQuery } from '@tanstack/react-query';
import { useApi } from './use-api';
import { useAuthQueryContext } from './use-auth-query-context';
import { usePermissions } from './use-permissions';
import { DashboardService } from '@/services/dashboard.service';
import { DashboardStats } from '@/types/dashboard';

export function useDashboard() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const { canReadDashboard, isLoading: isAuthLoading } = usePermissions();

  const query = useQuery<DashboardStats>({
    queryKey: ['dashboard', 'stats', userId],
    queryFn: async () => {
      return DashboardService.getStats(api);
    },
    enabled: authReady && Boolean(userId) && !isAuthLoading && canReadDashboard,
    staleTime: 60 * 1000, // 1 minute
    refetchInterval: 60 * 1000, // auto background refresh every 60s
  });

  return {
    stats: query.data,
    isLoading: isAuthLoading || query.isLoading,
    isError: query.isError,
    error: query.error,
    refetch: query.refetch,
    isRefetching: query.isRefetching,
  };
}
</file>

<file path="src/hooks/use-equipments.ts">
'use client';

import {
  keepPreviousData,
  useMutation,
  useQuery,
  useQueryClient,
} from '@tanstack/react-query';
import {
  useCallback,
  useState,
} from 'react';
import {
  toast,
} from 'sonner';

import {
  useApi,
} from './use-api';
import { useAuthQueryContext } from './use-auth-query-context';
import {
  usePermissions,
} from './use-permissions';

import {
  EquipmentService,
} from '@/services/equipment.service';

import type {
  CreateEquipmentDirectInput,
  EquipmentPaginationQuery,
  UpdateEquipmentInput,
} from '@/types/equipment';

interface UseEquipmentsOptions
  extends EquipmentPaginationQuery {
  initialSearch?: string;
  enabled?: boolean;
}

export function useEquipments(
  options?: UseEquipmentsOptions,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  const [
    page,
    setPage,
  ] = useState(
    options?.page ?? 1,
  );

  const [
    limit,
    setLimit,
  ] = useState(
    options?.limit ?? 10,
  );

  const [
    searchTerm,
    setSearchTerm,
  ] = useState(
    options?.initialSearch ??
      '',
  );

  const [
    equipmentStatus,
    setEquipmentStatus,
  ] = useState(
    options?.equipmentStatus,
  );

  const [
    hasSerialNumber,
    setHasSerialNumber,
  ] = useState<
    boolean | undefined
  >(
    options?.hasSerialNumber,
  );

  const equipmentsQuery =
    useQuery({
      queryKey: [
        'equipments',
        {
          page,
          limit,
          searchTerm,
          equipmentStatus,
          hasSerialNumber,
        }, userId],

      queryFn: () => {
        const filtered =
          Boolean(
            searchTerm.trim(),
          ) ||
          equipmentStatus !==
            undefined ||
          hasSerialNumber !==
            undefined;

        return filtered
          ? EquipmentService.searchEquipments(
              api,
              {
                page,
                limit,
                equipmentName:
                  searchTerm.trim() ||
                  undefined,
                equipmentStatus,
                hasSerialNumber,
              },
            )
          : EquipmentService.getAllEquipments(
              api,
              {
                page,
                limit,
              },
            );
      },

      enabled:
        options?.enabled ??
        true,

      placeholderData:
        keepPreviousData,

      staleTime: 20_000,
    });

  const createMutation =
    useMutation({
      mutationFn: (
        input: CreateEquipmentDirectInput,
      ) =>
        EquipmentService.createEquipmentDirect(
          api,
          input,
          permissions,
        ),

      onSuccess:
        async (equipment) => {
          await Promise.all([
            queryClient.invalidateQueries({
              queryKey: [
                'equipments', userId],
            }),
            queryClient.invalidateQueries({
              queryKey: [
                'serial-numbers', userId],
            }),
          ]);

          toast.success(
            'Article créé',
            {
              description:
                equipment.equipmentName ??
                'Nouvel article',
            },
          );
        },
    });

  const updateMutation =
    useMutation({
      mutationFn: ({
        id,
        input,
      }: {
        id: string;
        input: UpdateEquipmentInput;
      }) =>
        EquipmentService.updateEquipment(
          api,
          id,
          input,
          permissions,
        ),

      onSuccess:
        async (equipment) => {
          await Promise.all([
            queryClient.invalidateQueries({
              queryKey: [
                'equipments', userId],
            }),
            queryClient.invalidateQueries({
              queryKey: [
                'equipment',
                equipment.equipmentId, userId],
            }),
            queryClient.invalidateQueries({
              queryKey: [
                'serial-numbers', userId],
            }),
          ]);

          toast.success(
            'Article modifié',
          );
        },
    });

  const deleteMutation =
    useMutation({
      mutationFn: (
        id: string,
      ) =>
        EquipmentService.deleteEquipment(
          api,
          id,
          permissions,
        ),

      onSuccess: async () => {
        await queryClient.invalidateQueries({
          queryKey: [
            'equipments', userId],
        });

        toast.success(
          'Article supprimé',
        );
      },
    });

  const handleSearch =
    useCallback(
      (value: string) => {
        setSearchTerm(
          value,
        );
        setPage(1);
      },
      [],
    );

  return {
    equipments:
      equipmentsQuery.data
        ?.equipments ?? [],

    totalEquipments:
      equipmentsQuery.data
        ?.totalEquipments ?? 0,

    totalPages:
      equipmentsQuery.data
        ?.totalPages ?? 1,

    currentPage: page,
    limit,
    searchTerm,
    equipmentStatus,
    hasSerialNumber,

    setSearchTerm:
      handleSearch,

    setEquipmentStatus: (value: boolean | undefined) => {
      setEquipmentStatus(
        value,
      );
      setPage(1);
    },

    setHasSerialNumber: (
      value:
        | boolean
        | undefined,
    ) => {
      setHasSerialNumber(
        value,
      );
      setPage(1);
    },

    setPage,
    setLimit,

    isLoading:
      equipmentsQuery.isLoading,
    isFetching:
      equipmentsQuery.isFetching,
    isError:
      equipmentsQuery.isError,
    error:
      equipmentsQuery.error,
    refetch:
      equipmentsQuery.refetch,

    getEquipmentById:
      (
        id: string,
      ) =>
        EquipmentService.getEquipmentById(
          api,
          id,
        ),

    getEquipmentShelves:
      (
        id: string,
      ) =>
        EquipmentService.getEquipmentShelves(
          api,
          id,
          permissions,
        ),

    createEquipment:
      createMutation.mutateAsync,
    isCreatingEquipment:
      createMutation.isPending,

    updateEquipment:
      updateMutation.mutateAsync,
    isUpdating:
      updateMutation.isPending,

    deleteEquipment:
      deleteMutation.mutateAsync,
    isDeleting:
      deleteMutation.isPending,
  };
}

