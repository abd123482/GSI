              className="h-9 w-full rounded border border-[#3f3a36] bg-[#2b2622] px-3 text-xs"
            >
              <option value={10}>
                10
              </option>
              <option value={20}>
                20
              </option>
              <option value={50}>
                50
              </option>
            </select>
          </label>

          {permissions.canCreateMovement && (
            <button
              type="button"
              onClick={() => setCreateOpen(true)}
              className="mt-3 inline-flex h-9 items-center justify-center gap-2 rounded bg-[#f7f5f0] px-3 text-xs font-semibold text-[#2b2622] sm:ml-auto sm:mt-0"
            >
              <Plus className="h-3.5 w-3.5" />
              Nouveau mouvement
            </button>
          )}
        </section>

        <MovementListTable
          movements={
            movementsQuery.data
              ?.movements ?? []
          }
          totalMovements={
            movementsQuery.data
              ?.totalMovements ?? 0
          }
          currentPage={
            movementsQuery.data
              ?.currentPage ?? page
          }
          totalPages={
            movementsQuery.data
              ?.totalPages ?? 1
          }
          limit={
            movementsQuery.data
              ?.limit ?? limit
          }
          isLoading={
            movementsQuery.isLoading
          }
          isFetching={
            movementsQuery.isFetching
          }
          onPageChange={
            setPage
          }
          onSelectMovement={
            setSelectedMovement
          }
        />
      </div>

      <MovementDetailModal
        movement={
          selectedMovement
        }
        isOpen={
          Boolean(
            selectedMovement,
          )
        }
        onClose={() =>
          setSelectedMovement(
            null,
          )
        }
      />

      <CreateMovementModal
        isOpen={
          createOpen
        }
        onClose={() =>
          setCreateOpen(
            false,
          )
        }
        onSuccess={() => {
          setCreateOpen(
            false,
          );
          void movementsQuery.refetch();
        }}
      />
    </main>
  );
}
