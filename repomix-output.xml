'use client';

import { useState, useCallback } from 'react';
import { useQuery, useMutation, useQueryClient, keepPreviousData } from '@tanstack/react-query';
import { useApi } from './use-api';
import { usePermissions } from './use-permissions';
import {
  EquipmentService,
  REQUIRED_EQUIPMENT_READ_PERMISSION,
} from '@/services/equipment.service';
import {
  Equipment,
  EquipmentWithShelvesResponse,
  EquipmentPaginationQuery,
} from '@/types/equipment';
import {
  MovementService,
  REQUIRED_MOVEMENT_CREATE_PERMISSION,
} from '@/services/movement.service';
import { CreateEquipmentMovementInput, Movement } from '@/types/movement';
import { toast } from 'sonner';

interface UseEquipmentsOptions extends EquipmentPaginationQuery {
  initialSearch?: string;
  enabled?: boolean;
}

export function useEquipments(options?: UseEquipmentsOptions) {
  const api = useApi();
  const queryClient = useQueryClient();
  const { permissions, hasPermission } = usePermissions();

  const [page, setPage] = useState<number>(options?.page ?? 1);
  const [limit, setLimit] = useState<number>(options?.limit ?? 10);
  const [searchTerm, setSearchTerm] = useState<string>(options?.initialSearch ?? '');

  const canCreateMovement = hasPermission(REQUIRED_MOVEMENT_CREATE_PERMISSION);
  const canReadEquipment = hasPermission(REQUIRED_EQUIPMENT_READ_PERMISSION);

  // Query: Paginated equipments list (or search by name)
  const equipmentsQuery = useQuery({
    queryKey: ['equipments', { page, limit, searchTerm }],
    queryFn: async () => {
      if (searchTerm.trim()) {
        return EquipmentService.searchEquipments(api, searchTerm.trim(), { page, limit });
      }
      return EquipmentService.getAllEquipments(api, { page, limit });
    },
    enabled: options?.enabled ?? true,
    placeholderData: keepPreviousData,
    staleTime: 30 * 1000,
  });

  // Query helper for a single equipment
  const fetchEquipmentById = async (id: string): Promise<Equipment> => {
    return EquipmentService.getEquipmentById(api, id);
  };

  // Query helper to get all shelves of an equipment
  const fetchEquipmentShelves = async (id: string): Promise<EquipmentWithShelvesResponse> => {
    return EquipmentService.getEquipmentShelves(api, id, permissions);
  };



  // Mutation: Update equipment
  const updateEquipmentMutation = useMutation({
    mutationFn: async ({
      id,
      input,
    }: {
      id: string;
      input: {
        equipmentName?: string;
        equipmentQuantity?: number;
        minEquipmentQuantity?: number;
        hasSerialNumber?: boolean;
      };
    }) => {
      return EquipmentService.updateEquipment(api, id, input, permissions);
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      toast.success('Article mis à jour', {
        description: `L'article "${data.equipmentName}" a été actualisé.`,
      });
    },
    onError: (error) => {
      toast.error('Erreur de mise à jour', {
        description: error?.message || 'Impossible de modifier cet article.',
      });
    },
  });

  // Mutation: Delete equipment
  const deleteEquipmentMutation = useMutation({
    mutationFn: async (id: string) => {
      return EquipmentService.deleteEquipment(api, id, permissions);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      toast.success('Article supprimé', {
        description: 'L’article et ses éléments associés ont été supprimés.',
      });
    },
    onError: (error) => {
      toast.error('Erreur de suppression', {
        description: error?.message || 'Impossible de supprimer cet article.',
      });
    },
  });

  // Mutation: Update serial number
  const updateSerialNumberMutation = useMutation({
    mutationFn: async ({
      id,
      input,
    }: {
      id: string;
      input: {
        serialNumberCode?: string;
        serialNumberStatus?: string;
      };
    }) => {
      return EquipmentService.updateSerialNumber(api, id, input, permissions);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      toast.success('Numéro de série mis à jour');
    },
    onError: (error) => {
      toast.error('Erreur de mise à jour', {
        description: error?.message || 'Impossible de modifier le numéro de série.',
      });
    },
  });

  // Mutation: Delete serial number
  const deleteSerialNumberMutation = useMutation({
    mutationFn: async (id: string) => {
      return EquipmentService.deleteSerialNumber(api, id, permissions);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      toast.success('Numéro de série supprimé', {
        description: 'Le numéro de série a été retiré et la quantité ajustée.',
      });
    },
    onError: (error) => {
      toast.error('Erreur de suppression', {
        description: error?.message || 'Impossible de supprimer le numéro de série.',
      });
    },
  });

  // Mutation: Create equipment directly via Equipment & SerialNumber controllers
  const createEquipmentMutation = useMutation({
    mutationFn: async (input: import('@/types/equipment').CreateEquipmentDirectInput) => {
      return EquipmentService.createEquipmentDirect(api, input, permissions);
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      toast.success('Article créé avec succès !', {
        description: `L'article "${data.equipmentName}" a été ajouté au stock.`,
      });
    },
    onError: (error) => {
      toast.error('Erreur lors de la création', {
        description: error?.message || 'Impossible de créer l’article.',
      });
    },
  });



  // Query helper for equipment movements
  const fetchEquipmentMovements = async (equipmentId: string): Promise<Movement[]> => {
    return MovementService.getMovementsByEquipmentId(api, equipmentId, { page: 1, limit: 100 }, permissions);
  };

  // Mutation: Create movement (IN, OUT, TRANSFER)
  const createMovementMutation = useMutation({
    mutationFn: async (input: CreateEquipmentMovementInput) => {
      return MovementService.createMovement(api, input, permissions);
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      queryClient.invalidateQueries({ queryKey: ['movements'] });
      queryClient.invalidateQueries({ queryKey: ['equipment-movements'] });
      toast.success('Mouvement enregistré avec succès !', {
        description: `Mouvement de statut ${data.mouvementStatus} (${data.mouvementQuantity ?? 1} unité(s)) validé.`,
      });
    },
    onError: (error) => {
      toast.error('Erreur lors de l’enregistrement du mouvement', {
        description: error?.message || 'Impossible d’enregistrer le mouvement.',
      });
    },
  });

  // Mutation: Create batch movements
  const createBatchMovementsMutation = useMutation({
    mutationFn: async (items: CreateEquipmentMovementInput[]) => {
      return MovementService.createBatchMovements(api, items, permissions);
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['equipments'] });
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      queryClient.invalidateQueries({ queryKey: ['movements'] });
      queryClient.invalidateQueries({ queryKey: ['equipment-movements'] });
      toast.success('Mouvements enregistrés avec succès !', {
        description: `${data.items?.length ?? 1} ligne(s) dans un mouvement validé(s).`,
      });
    },
    onError: (error) => {
      toast.error('Erreur lors de l’enregistrement des mouvements', {
        description: error?.message || 'Impossible d’enregistrer les mouvements.',
      });
    },
  });

  const handleSearchChange = useCallback((query: string) => {
    setSearchTerm(query);
    setPage(1);
  }, []);

  return {
    equipments: equipmentsQuery.data?.equipments ?? [],
    totalEquipments: equipmentsQuery.data?.totalEquipments ?? 0,
    totalPages: equipmentsQuery.data?.totalPages ?? 1,
    currentPage: page,
    limit,
    searchTerm,
    setSearchTerm: handleSearchChange,
    setPage,
    setLimit,
    isLoading: equipmentsQuery.isLoading,
    isFetching: equipmentsQuery.isFetching,
    isError: equipmentsQuery.isError,
    error: equipmentsQuery.error,
    refetch: equipmentsQuery.refetch,
    getEquipmentById: fetchEquipmentById,
    getEquipmentShelves: fetchEquipmentShelves,
    canCreateMovement,
    canReadEquipment,
    createEquipment: createEquipmentMutation.mutateAsync,
    isCreatingEquipment: createEquipmentMutation.isPending,
    updateEquipment: updateEquipmentMutation.mutateAsync,
    isUpdating: updateEquipmentMutation.isPending,
    deleteEquipment: deleteEquipmentMutation.mutateAsync,
    isDeleting: deleteEquipmentMutation.isPending,
    updateSerialNumber: updateSerialNumberMutation.mutateAsync,
    isUpdatingSerialNumber: updateSerialNumberMutation.isPending,
    createMovement: createMovementMutation.mutateAsync,
    isCreatingMovement: createMovementMutation.isPending,
    createBatchMovements: createBatchMovementsMutation.mutateAsync,
    isCreatingBatchMovements: createBatchMovementsMutation.isPending,
    getEquipmentMovements: fetchEquipmentMovements,
    deleteSerialNumber: deleteSerialNumberMutation.mutateAsync,
    isDeletingSerialNumber: deleteSerialNumberMutation.isPending,
  };
}
</file>

<file path="frontend/src/hooks/use-notifications.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useApi } from './use-api';
import { useEffect, useRef } from 'react';
import { toast } from 'sonner';
import { useRouter } from 'next/navigation';

export interface AppNotification {
  notificationId: string;
  recipientId: string;
  eventType: string;
  payload: {
    title?: string;
    message?: string;
    taskId?: string;
    unitId?: string;
    inventoryId?: string;
    inventoryTitle?: string;
    equipmentName?: string;
    submittedBy?: string;
    createdAt?: string;
  };
  createdAt: string;
  readAt: string | null;
}

export function useNotifications() {
  const api = useApi();
  const router = useRouter();
  const knownIdsRef = useRef<Set<string>>(new Set());
  const isInitialLoadRef = useRef(true);

  const query = useQuery<AppNotification[]>({
    queryKey: ['notifications'],
    queryFn: async () => {
      const res = await api.get('/notifications');
      return res.data;
    },
    refetchInterval: 5000, // Poll every 5 seconds for live notification delivery
    staleTime: 4000,
  });

  // Watch for new notifications to trigger live toast
  useEffect(() => {
    if (!query.data) return;

    if (isInitialLoadRef.current) {
      // First load: just record existing IDs
      query.data.forEach((n) => knownIdsRef.current.add(n.notificationId));
      isInitialLoadRef.current = false;
      return;
    }

    // Subsequent polls: check for newly arrived unread notifications
    for (const n of query.data) {
      if (!knownIdsRef.current.has(n.notificationId)) {
        knownIdsRef.current.add(n.notificationId);

        if (!n.readAt) {
          const title = n.payload?.title || 'Nouvelle tâche d’inventaire';
          const msg = n.payload?.message || 'Une nouvelle notification vous est parvenue.';
          const taskId = n.payload?.taskId;
          const unitId = n.payload?.unitId;
          const inventoryId = n.payload?.inventoryId;

          const isTask =
            n.eventType === 'INVENTORY_TASK_AVAILABLE' ||
            n.eventType === 'INVENTORY_COUNT_REQUIRED' ||
            n.eventType === 'INVENTORY_THIRD_COUNT_REQUIRED' ||
            n.eventType === 'TASK';

          const isAdjudication =
            n.eventType === 'INVENTORY_ADJUDICATION_ASSIGNED' ||
            n.eventType === 'INVENTORY_ADJUDICATION_REQUIRED';

          const destination =
            taskId
              ? `/inventory/tasks/${taskId}`
              : isAdjudication && unitId
              ? `/inventory/adjudicate/${unitId}`
              : isTask
              ? `/inventory/tasks`
              : unitId
              ? `/inventory/adjudicate/${unitId}`
              : inventoryId
              ? `/inventory/${inventoryId}`
              : '/inventory/tasks';

          toast.info(title, {
            description: msg,
            duration: 8000,
            action: destination
              ? {
                  label: 'Ouvrir la tâche',
                  onClick: () => router.push(destination),
                }
              : undefined,
          });

        }
      }
    }
  }, [query.data, router]);

  return query;
}

export function useUnreadNotificationsCount() {
  const api = useApi();
  return useQuery<{ count: number }>({
    queryKey: ['notifications', 'unread-count'],
    queryFn: async () => {
      const res = await api.get('/notifications/unread-count');
      return res.data;
    },
    refetchInterval: 5000,
    staleTime: 4000,
  });
}

export function useMarkNotificationRead() {
  const queryClient = useQueryClient();
  const api = useApi();

  return useMutation({
    mutationFn: async (notificationId: string) => {
      const res = await api.patch(`/notifications/${notificationId}/read`);
      return res.data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['notifications'] });
    },
  });
}

export function useMarkAllNotificationsRead() {
  const queryClient = useQueryClient();
  const api = useApi();

  return useMutation({
    mutationFn: async () => {
      const res = await api.patch('/notifications/mark-all-read');
      return res.data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['notifications'] });
    },
  });
}
</file>

<file path="frontend/src/hooks/use-shelves.ts">
'use client';

import { useState, useCallback } from 'react';
import { useQuery, useMutation, useQueryClient, keepPreviousData } from '@tanstack/react-query';
import { useApi } from './use-api';
import { usePermissions } from './use-permissions';
import { ShelfService } from '@/services/shelf.service';
import {
  Shelf,
  CreateShelfInput,
  UpdateShelfInput,
  ShelfPaginationQuery,
  PaginatedShelvesResponse,
} from '@/types/shelf';
import { toast } from 'sonner';

interface UseShelvesOptions extends ShelfPaginationQuery {
  initialSearch?: string;
  enabled?: boolean;
}

/**
 * Hook for managing shelves state, caching, search with pagination, and mutations.
 */
export function useShelves(options?: UseShelvesOptions) {
  const api = useApi();
  const queryClient = useQueryClient();
  const { permissions, canCreateShelf } = usePermissions();

  const [page, setPage] = useState<number>(options?.page ?? 1);
  const [limit, setLimit] = useState<number>(options?.limit ?? 10);
  const [searchTerm, setSearchTerm] = useState<string>(options?.initialSearch ?? '');

  // Query: Fetch shelves list with server-side search and pagination
  const shelvesQuery = useQuery<PaginatedShelvesResponse>({
    queryKey: ['shelves', searchTerm.trim(), page, limit],
    queryFn: () => {
      const cleanSearch = searchTerm.trim();
      if (cleanSearch.length > 0) {
        return ShelfService.searchShelves(api, cleanSearch, { page, limit });
      }
      return ShelfService.getAllShelves(api, { page, limit });
    },
    enabled: options?.enabled ?? true,
    placeholderData: keepPreviousData,
    staleTime: 30 * 1000,
  });

  // Fetch single shelf by ID
  const fetchShelfById = async (id: string): Promise<Shelf> => {
    return ShelfService.getShelfById(api, id);
  };

  // Mutation: Create a new shelf with immediate cache invalidation
  const createShelfMutation = useMutation({
    mutationFn: async (input: CreateShelfInput) => {
      return ShelfService.createShelf(api, input, permissions);
    },
    onSuccess: (newShelf) => {
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      toast.success('Emplacement créé avec succès !', {
        description: `L'emplacement "${newShelf.shelfName}" a été enregistré avec succès.`,
      });
    },
    onError: (error) => {
      const msg = error?.message || 'Impossible de créer l’emplacement.';
      toast.error('Erreur lors de la création', {
        description: msg,
      });
    },
  });

  // Mutation: Update an existing shelf
  const updateShelfMutation = useMutation({
    mutationFn: async ({ id, data }: { id: string; data: UpdateShelfInput }) => {
      return ShelfService.updateShelf(api, id, data, permissions);
    },
    onSuccess: (updatedShelf) => {
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      queryClient.invalidateQueries({ queryKey: ['shelf', updatedShelf.shelfId] });
      toast.success('Emplacement modifié avec succès !', {
        description: `L'emplacement "${updatedShelf.shelfName}" a été mis à jour avec succès.`,
      });
    },
    onError: (error) => {
      const msg = error?.message || 'Impossible de mettre à jour l’emplacement.';
      toast.error('Erreur lors de la modification', {
        description: msg,
      });
    },
  });

  // Mutation: Delete an existing shelf
  const deleteShelfMutation = useMutation({
    mutationFn: async (id: string) => {
      return ShelfService.deleteShelf(api, id, permissions);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['shelves'] });
      toast.success('Emplacement supprimé avec succès !', {
        description: "L'emplacement a été supprimé définitivement.",
      });
    },
    onError: (error) => {
      const msg = error?.message || 'Impossible de supprimer cet emplacement.';
      toast.error('Erreur lors de la suppression', {
        description: msg,
      });
    },
  });

  const handleSearchChange = useCallback((query: string) => {
    setSearchTerm(query);
    setPage(1); // Reset to page 1 whenever search query changes
  }, []);

  const { canUpdateShelf, canDeleteShelf } = usePermissions();

  return {
    shelves: shelvesQuery.data?.shelves ?? [],
    totalShelves: shelvesQuery.data?.totalShelves ?? 0,
    totalPages: shelvesQuery.data?.totalPages ?? 1,
    currentPage: page,
    limit,
    searchTerm,
    setSearchTerm: handleSearchChange,
    setPage,
    setLimit,
    isLoading: shelvesQuery.isLoading,
    isFetching: shelvesQuery.isFetching,
    isError: shelvesQuery.isError,
    error: shelvesQuery.error,
    refetch: shelvesQuery.refetch,
    getShelfById: fetchShelfById,
    canCreateShelf,
    canUpdateShelf,
    canDeleteShelf,
    createShelf: createShelfMutation.mutateAsync,
    isCreating: createShelfMutation.isPending,
    creationError: createShelfMutation.error,
    updateShelf: updateShelfMutation.mutateAsync,
    isUpdating: updateShelfMutation.isPending,
    deleteShelf: deleteShelfMutation.mutateAsync,
    isDeleting: deleteShelfMutation.isPending,
  };
}

/**
 * Hook for fetching a single shelf by ID using Notion design principles.
 */
export function useShelf(id?: string | null) {
  const api = useApi();

  return useQuery<Shelf>({
    queryKey: ['shelf', id],
    queryFn: () => ShelfService.getShelfById(api, id!),
    enabled: !!id,
    staleTime: 60 * 1000,
  });
}
