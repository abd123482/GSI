<file path="frontend/src/components/movement/MovementListTable.tsx">
'use client';

import {
  ArrowDownToLine,
  ArrowRight,
  ArrowRightLeft,
  ArrowUpFromLine,
  ChevronLeft,
  ChevronRight,
  Eye,
  Loader2,
  Package,
} from 'lucide-react';

import type {
  Movement,
} from '@/types/movement';

interface MovementListTableProps {
  movements: Movement[];
  totalMovements: number;
  currentPage: number;
  totalPages: number;
  limit: number;
  isLoading?: boolean;
  isFetching?: boolean;
  onPageChange: (
    page: number,
  ) => void;
  onSelectMovement: (
    movement: Movement,
  ) => void;
}

function movementType(movement: any): 'IN' | 'OUT' | 'TRANSFER' {
  return movement.mouvementStatus ? 'OUT' : 'IN';
}

function typeBadge(
  movement: Movement,
) {
  const type =
    movementType(
      movement,
    );

  if (type === 'IN') {
    return (
      <span className="inline-flex items-center gap-1 rounded border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-[10px] font-semibold text-emerald-300">
        <ArrowDownToLine className="h-3 w-3" />
        ENTRÉE
      </span>
    );
  }

  if (type === 'OUT') {
    return (
      <span className="inline-flex items-center gap-1 rounded border border-rose-500/30 bg-rose-500/10 px-2 py-1 text-[10px] font-semibold text-rose-300">
        <ArrowUpFromLine className="h-3 w-3" />
        SORTIE
      </span>
    );
  }

  return (
    <span className="inline-flex items-center gap-1 rounded border border-sky-500/30 bg-sky-500/10 px-2 py-1 text-[10px] font-semibold text-sky-300">
      <ArrowRightLeft className="h-3 w-3" />
      TRANSFERT
    </span>
  );
}

function formatDate(
  value?: string | null,
) {
  if (!value) {
    return '—';
  }

  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return value;
  }

  return new Intl.DateTimeFormat(
    'fr-DZ',
    {
      dateStyle: 'short',
      timeStyle: 'short',
    },
  ).format(date);
}

function routeName(
  shelf:
    | {
        shelfName:
          string | null;
      }
    | null
    | undefined,
  externalText: string,
) {
  return (
    shelf?.shelfName ??
    externalText
  );
}

export function MovementListTable({
  movements,
  totalMovements,
  currentPage,
  totalPages,
  limit,
  isLoading = false,
  isFetching = false,
  onPageChange,
  onSelectMovement,
}: MovementListTableProps) {
  if (isLoading) {
    return (
      <div className="flex min-h-64 items-center justify-center rounded border border-[#3f3f46] bg-[#27272a]">
        <div className="flex items-center gap-2 text-xs text-[#a1a1aa]">
          <Loader2 className="h-4 w-4 animate-spin" />
          Chargement des mouvements...
        </div>
      </div>
    );
  }

  if (!movements.length) {
    return (
      <div className="flex min-h-64 flex-col items-center justify-center gap-3 rounded border border-[#3f3f46] bg-[#27272a] px-6 text-center">
        <ArrowRightLeft className="h-7 w-7 text-[#a1a1aa]" />

        <div>
          <p className="text-sm font-medium">
            Aucun mouvement
          </p>

          <p className="mt-1 text-xs text-[#71717a]">
            Aucun mouvement ne correspond aux filtres actuels.
          </p>
        </div>
      </div>
    );
  }

  const start =
    (currentPage - 1) *
      limit +
    1;

  const end =
    Math.min(
      currentPage *
        limit,
      totalMovements,
    );

  return (
    <div className="overflow-hidden rounded border border-[#3f3f46] bg-[#27272a]">
      <div className="overflow-x-auto">
        <table className="w-full border-collapse">
          <thead className="border-b border-[#3f3f46] bg-[#27272a]/60">
            <tr className="text-left text-[10px] uppercase tracking-wider text-[#71717a]">
              <th className="px-4 py-3 font-medium">
                Date d'effet
              </th>
              <th className="px-4 py-3 font-medium">
                Créé le
              </th>
              <th className="px-4 py-3 font-medium">
                Type
              </th>
              <th className="px-4 py-3 font-medium">
                Trajet
              </th>
              <th className="px-4 py-3 font-medium">
                Lignes
              </th>
              <th className="px-4 py-3 text-right font-medium">
                Quantité
              </th>
              <th className="px-4 py-3 font-medium">
                Origine
              </th>
              <th className="w-14 px-4 py-3" />
            </tr>
          </thead>

          <tbody className="divide-y divide-[#3f3f46]">
            {movements.map(
              (movement) => (
                <tr
                  key={
                    movement.mouvementId
                  }
                  onClick={() =>
                    onSelectMovement(
                      movement,
                    )
                  }
                  className="cursor-pointer hover:bg-[#27272a]/55"
                >
                  <td className="whitespace-nowrap px-4 py-3 text-xs text-[#d4d4d8]">
                    {formatDate(
                      movement.happenedAt,
                    )}
                  </td>
                  <td className="whitespace-nowrap px-4 py-3 text-xs text-[#71717a]">
                    {formatDate(
                      movement.createdAt,
                    )}
                  </td>

                  <td className="px-4 py-3">
                    {typeBadge(
                      movement,
                    )}
                  </td>

                  <td className="px-4 py-3">
                    <div className="flex min-w-52 items-center gap-2 text-xs">
                      <span className="max-w-32 truncate text-[#d4d4d8]">
                        {routeName(
                          movement.items?.[0]?.sourceShelf,
                          'Extérieur',
                        )}
                      </span>

                      <ArrowRight className="h-3 w-3 shrink-0 text-[#5c544d]" />

                      <span className="max-w-32 truncate">
                        {routeName(
                          movement.items?.[0]?.destinationShelf,
                          'Extérieur',
                        )}
                      </span>
                    </div>
                  </td>

                  <td className="px-4 py-3">
                    <span className="inline-flex items-center gap-1.5 text-xs text-[#d4d4d8]">
                      <Package className="h-3.5 w-3.5" />
                      {movement.items
                        ?.length ??
                        0}
                    </span>
                  </td>

                  <td className="px-4 py-3 text-right font-mono text-xs font-semibold">
                    {(movement.items?.reduce((acc, item) => acc + (item.equipmentQuantity ?? 0), 0) ?? 0) ??
                      0}
                  </td>

                  <td className="px-4 py-3">
                    <span className="text-[10px] text-[#d4d4d8]">
                      {movement.origin === false
                        ? 'Ajustement inventaire'
                        : 'Utilisateur'}
                    </span>
                  </td>

                  <td className="px-4 py-3 text-right">
                    <button
                      type="button"
                      onClick={(
                        event,
                      ) => {
                        event.stopPropagation();
                        onSelectMovement(
                          movement,
                        );
                      }}
                      className="inline-flex h-7 w-7 items-center justify-center rounded border border-[#3f3f46] bg-[#27272a] text-[#a1a1aa] hover:text-white"
                      title="Voir"
                    >
                      <Eye className="h-3.5 w-3.5" />
                    </button>
                  </td>
                </tr>
              ),
            )}
          </tbody>
        </table>
      </div>

      <div className="flex items-center justify-between border-t border-[#3f3f46] bg-[#27272a]/40 px-4 py-3">
        <span className="text-[10px] text-[#71717a]">
          {start}–{end} sur{' '}
          {totalMovements}
          {isFetching &&
            ' • actualisation...'}
        </span>

        <div className="flex items-center gap-2">
          <button
            type="button"
            disabled={
              currentPage <= 1
            }
            onClick={() =>
              onPageChange(
                currentPage - 1,
              )
            }
            className="rounded border border-[#3f3f46] p-2 disabled:opacity-30"
          >
            <ChevronLeft className="h-3.5 w-3.5" />
          </button>

          <span className="text-[10px] text-[#a1a1aa]">
            {currentPage} /{' '}
            {Math.max(
              totalPages,
              1,
            )}
          </span>

          <button
            type="button"
            disabled={
              currentPage >=
              totalPages
            }
            onClick={() =>
              onPageChange(
                currentPage + 1,
              )
            }
            className="rounded border border-[#3f3f46] p-2 disabled:opacity-30"
          >
            <ChevronRight className="h-3.5 w-3.5" />
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/users/CreateRoleModal.tsx">
'use client';

import { useState, useMemo } from 'react';
import { X, ShieldCheck, Check, Loader2, AlertCircle } from 'lucide-react';
import { CreateRoleInput } from '@/types/user-role';

interface CreateRoleModalProps {
  isOpen: boolean;
  onClose: () => void;
  availablePermissions: string[];
  onSubmitRole: (input: CreateRoleInput) => Promise<void>;
  isSubmitting?: boolean;
}

const PERMISSION_GROUPS: {
  id: string;
  title: string;
  icon: string;
  permissions: { name: string; label: string }[];
}[] = [
  {
    id: 'equipment',
    title: 'Articles & Mouvements',
    icon: '⚡',
    permissions: [
      { name: 'equipment.read', label: 'Consulter les articles' },
      { name: 'equipment.create', label: 'Créer de nouveaux articles' },
      { name: 'equipment.update', label: 'Modifier les articles' },
      { name: 'equipment.delete', label: 'Supprimer des articles' },
      { name: 'movement.read', label: 'Consulter l’historique des mouvements' },
      { name: 'movement.create', label: 'Effectuer des transferts/mouvements' },
    ],
  },
  {
    id: 'serial',
    title: 'Numéros de Série',
    icon: '🔢',
    permissions: [
      { name: 'serial-number.read', label: 'Consulter les numéros de série' },
      { name: 'serial-number.create', label: 'Ajouter des numéros de série' },
      { name: 'serial-number.update', label: 'Mettre à jour les numéros de série' },
      { name: 'serial-number.delete', label: 'Supprimer des numéros de série' },
    ],
  },
  {
    id: 'shelves',
    title: 'Emplacements & Rangement',
    icon: '🗄️',
    permissions: [
      { name: 'shelf.read', label: 'Consulter les emplacements' },
      { name: 'shelf.create', label: 'Créer de nouveaux emplacements' },
      { name: 'shelf.update', label: 'Modifier les emplacements' },
      { name: 'shelf.delete', label: 'Supprimer des emplacements' },
    ],
  },
  {
    id: 'stocks',
    title: 'Gestion des Stocks',
    icon: '🏭',
    permissions: [
      { name: 'stock.read', label: 'Consulter les stocks' },
      { name: 'stock.create', label: 'Créer des zones de stock' },
      { name: 'stock.update', label: 'Modifier les zones de stock' },
      { name: 'stock.delete', label: 'Supprimer des zones de stock' },
    ],
  },
  {
    id: 'inventory',
    title: 'Inventaires & Réconciliations',
    icon: '📋',
    permissions: [
      { name: 'inventory.read', label: 'Consulter les inventaires et rapports' },
      { name: 'inventory.create', label: 'Créer de nouveaux projets d’inventaire' },
      { name: 'inventory.launch', label: 'Lancer et démarrer un inventaire' },
      { name: 'inventory.count', label: 'Contrôleur d’inventaire (Comptage initial et arbitrage en cas de divergence)' },
      { name: 'inventory.finalize', label: 'Clôturer et ajuster le stock final' },
      { name: 'inventory.delete', label: 'Supprimer un inventaire' },
    ],
  },
  {
    id: 'admin',
    title: 'Administration Système',
    icon: '🛡️',
    permissions: [
      { name: 'dashboard.read', label: 'Consulter le tableau de bord exécutif (Dashboard)' },
      { name: 'user.manage', label: 'Gérer les comptes utilisateurs et statuts' },
      { name: 'role.manage', label: 'Créer des rôles et assigner des permissions' },
    ],
  },
];

export function CreateRoleModal({
  isOpen,
  onClose,
  availablePermissions,
  onSubmitRole,
  isSubmitting = false,
}: CreateRoleModalProps) {
  const [roleName, setRoleName] = useState('');
  const [selectedPermissions, setSelectedPermissions] = useState<string[]>([]);
  const [validationError, setValidationError] = useState<string | null>(null);

  const groupsToDisplay = useMemo(() => {
    const knownPerms = new Set(
      PERMISSION_GROUPS.flatMap((g) => g.permissions.map((p) => p.name)),
    );
    // Exclude inventory.adjudicate as it is internally bundled with inventory.count (Contrôleur)
    const extraPerms = (availablePermissions || []).filter(
      (p) => !knownPerms.has(p) && p !== 'inventory.adjudicate',
    );

    if (extraPerms.length === 0) {
      return PERMISSION_GROUPS;
    }

    return [
      ...PERMISSION_GROUPS,
      {
        id: 'other',
        title: 'Autres Permissions',
        icon: '⚙️',
        permissions: extraPerms.map((name) => ({
          name,
          label: name,
        })),
      },
    ];
  }, [availablePermissions]);

  if (!isOpen) return null;

  const handleTogglePermission = (permName: string) => {
    setSelectedPermissions((prev) =>
      prev.includes(permName)
        ? prev.filter((p) => p !== permName)
        : [...prev, permName],
    );
  };

  const handleToggleGroup = (groupPerms: string[]) => {
    const allSelected = groupPerms.every((p) => selectedPermissions.includes(p));
    if (allSelected) {
      setSelectedPermissions((prev) =>
        prev.filter((p) => !groupPerms.includes(p)),
      );
    } else {
      setSelectedPermissions((prev) =>
        Array.from(new Set([...prev, ...groupPerms])),
      );
    }
  };

  const handleSelectAll = () => {
    const all = groupsToDisplay.flatMap((g) => g.permissions.map((p) => p.name));
    setSelectedPermissions(all);
  };

  const handleDeselectAll = () => {
    setSelectedPermissions([]);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setValidationError(null);

    const trimmed = roleName.trim();
    if (!trimmed) {
      setValidationError('Veuillez renseigner un nom pour le rôle.');
      return;
    }
    if (selectedPermissions.length === 0) {
      setValidationError('Veuillez cocher au moins une permission pour ce rôle.');
      return;
    }

    try {
      const finalPermissions = new Set(selectedPermissions);
      if (finalPermissions.has('inventory.count')) {
        finalPermissions.add('inventory.adjudicate');
      } else {
        finalPermissions.delete('inventory.adjudicate');
      }

      await onSubmitRole({
        roleName: trimmed.toUpperCase(),
        permissions: Array.from(finalPermissions),
      });
      setRoleName('');
      setSelectedPermissions([]);
      onClose();
    } catch {
      // Handled by mutation toast
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-in fade-in duration-150">
      <div className="relative w-full max-w-2xl bg-[#27272a] rounded-[4px] shadow-2xl border border-[#3f3f46] flex flex-col max-h-[90vh] overflow-hidden text-[#fafafa]">
        {/* Header */}
        <div className="px-6 py-4 border-b border-[#3f3f46] flex items-center justify-between bg-[#18181b]">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-[3px] bg-[#27272a] text-[#fafafa] border border-[#3f3f46] flex items-center justify-center">
              <ShieldCheck className="w-4 h-4" />
            </div>
            <div>
              <h2 className="text-sm font-medium text-[#fafafa]">
                Créer un Nouveau Rôle
              </h2>
              <p className="text-xs text-[#d4d4d8]">
                Définissez un profil d&apos;autorisation RBAC et associez les permissions.
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-1.5 rounded-[3px] text-[#a1a1aa] hover:text-[#fafafa] hover:bg-[#27272a] transition-colors"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Content Form */}
        <form onSubmit={handleSubmit} className="flex flex-col flex-1 overflow-hidden">
          <div className="p-6 overflow-y-auto space-y-5">
            {validationError && (
              <div className="p-3 bg-[#2d1616] border border-[#451e1e] rounded-[3px] text-xs text-[#ef4444] flex items-center gap-2">
                <AlertCircle className="w-4 h-4 shrink-0" />
                <span>{validationError}</span>
              </div>
            )}

            {/* Role Name Input */}
            <div>
              <label
                htmlFor="roleName"
                className="block text-[11px] font-mono uppercase tracking-wider text-[#a1a1aa] mb-1.5"
              >
                Nom du Rôle <span className="text-[#ef4444]">*</span>
              </label>
              <input
                id="roleName"
                type="text"
                value={roleName}
                onChange={(e) => setRoleName(e.target.value)}
                placeholder="Ex: MAGASINIER, AUDITEUR, SUPERVISEUR..."
                className="w-full px-3 py-2 text-xs font-mono bg-[#18181b] text-[#fafafa] border border-[#3f3f46] rounded-[3px] focus:outline-none focus:border-[#fafafa] transition-all placeholder:text-[#a1a1aa]"
                autoFocus
              />
              <p className="text-[11px] text-[#a1a1aa] mt-1 font-mono">
                Convention : majuscules normalisées (ex: TECHNICIAN, ADMIN).
              </p>
            </div>

            {/* Permissions Selection Header */}
            <div>
              <div className="flex items-center justify-between mb-2">
                <label className="block text-[11px] font-mono uppercase tracking-wider text-[#a1a1aa]">
                  Permissions ({selectedPermissions.length} cochée
                  {selectedPermissions.length > 1 ? 's' : ''})
                </label>
                <div className="flex items-center gap-2 text-xs font-mono">
                  <button
                    type="button"
                    onClick={handleSelectAll}
                    className="text-[11px] text-[#fafafa] hover:underline"
                  >
                    Tout sélectionner
                  </button>
                  <span className="text-[#3f3f46]">•</span>
                  <button
                    type="button"
                    onClick={handleDeselectAll}
                    className="text-[11px] text-[#a1a1aa] hover:underline"
                  >
                    Tout décocher
                  </button>
                </div>
              </div>

              {/* Grouped Permissions Grid */}
              <div className="space-y-3 border border-[#3f3f46] rounded-[3px] p-3 bg-[#18181b]">
                {groupsToDisplay.map((group) => {
                  const groupPermNames = group.permissions.map((p) => p.name);
                  const isAllGroupSelected = groupPermNames.every((p) =>
                    selectedPermissions.includes(p),
                  );
                  const isSomeGroupSelected =
                    !isAllGroupSelected &&
                    groupPermNames.some((p) => selectedPermissions.includes(p));

                  return (
                    <div
                      key={group.id}
                      className="bg-[#27272a] rounded-[3px] border border-[#3f3f46] p-3"
                    >
                      {/* Group Header */}
                      <div className="flex items-center justify-between pb-2 mb-2 border-b border-[#3f3f46]">
                        <div className="flex items-center gap-2">
                          <span className="text-xs">{group.icon}</span>
                          <span className="text-xs font-medium text-[#fafafa]">
                            {group.title}
                          </span>
                        </div>
                        <button
                          type="button"
                          onClick={() => handleToggleGroup(groupPermNames)}
                          className={`text-[10px] font-mono px-2 py-0.5 rounded-[2px] transition-colors border ${
                            isAllGroupSelected
                              ? 'bg-[#18181b] text-[#fafafa] border-[#fafafa]'
                              : isSomeGroupSelected
                                ? 'bg-[#18181b] text-[#f4f4f5] border-[#3f3f46]'
                                : 'text-[#a1a1aa] border-transparent hover:border-[#3f3f46]'
                          }`}
                        >
                          {isAllGroupSelected
                            ? 'Tout désélectionner'
                            : 'Tout cocher'}
                        </button>
                      </div>

                      {/* Group Checkboxes */}
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        {group.permissions.map((perm) => {
                          const isChecked = selectedPermissions.includes(perm.name);
                          return (
                            <label
                              key={perm.name}
                              className={`flex items-start gap-2.5 p-2 rounded-[2px] cursor-pointer text-xs transition-colors border ${
                                isChecked
                                  ? 'bg-[#18181b] border-[#fafafa] text-[#fafafa]'
                                  : 'hover:bg-[#18181b] border-[#3f3f46]/60 text-[#d4d4d8]'
                              }`}
                            >
                              <div
                                className={`w-3.5 h-3.5 rounded-[2px] mt-0.5 flex items-center justify-center border transition-colors shrink-0 ${
                                  isChecked
                                    ? 'bg-[#fafafa] border-[#fafafa] text-[#18181b]'
                                    : 'border-[#3f3f46] bg-[#18181b]'
                                }`}
                              >
                                {isChecked && <Check className="w-2.5 h-2.5 stroke-[3]" />}
                              </div>
                              <div className="flex flex-col">
                                <span className="font-normal text-xs leading-tight text-[#fafafa]">
                                  {perm.label}
                                </span>
                                <span className="font-mono text-[10px] text-[#a1a1aa]">
                                  {perm.name}
                                </span>
                              </div>
                            </label>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Footer Actions */}
          <div className="px-6 py-3 border-t border-[#3f3f46] bg-[#18181b] flex items-center justify-end gap-2.5">
            <button
              type="button"
              onClick={onClose}
              disabled={isSubmitting}
              className="px-3 py-1.5 text-xs font-medium text-[#d4d4d8] hover:text-[#fafafa] hover:bg-[#27272a] rounded-[3px] transition-colors cursor-pointer"
            >
              Annuler
            </button>
            <button
              type="submit"
              disabled={isSubmitting}
              className="flex items-center gap-2 px-4 py-1.5 text-xs font-medium text-[#18181b] bg-[#fafafa] hover:bg-[#f4f4f5] rounded-[3px] transition-colors shadow-2xs disabled:opacity-50 cursor-pointer"
            >
              {isSubmitting ? (
                <>
                  <Loader2 className="w-3.5 h-3.5 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <ShieldCheck className="w-3.5 h-3.5" />
                  <span>Créer le rôle ({selectedPermissions.length})</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/users/EditRoleModal.tsx">
'use client';

import { useState, useEffect, useMemo } from 'react';
import { X, ShieldAlert, Check, Loader2, AlertCircle, Edit2 } from 'lucide-react';
import { EditRoleInput, Role } from '@/types/user-role';

interface EditRoleModalProps {
  isOpen: boolean;
  onClose: () => void;
  availablePermissions: string[];
  roleToEdit: Role | null;
  onSubmitRole: (input: EditRoleInput) => Promise<void>;
  isSubmitting?: boolean;
}

const PERMISSION_GROUPS: {
  id: string;
  title: string;
  icon: string;
  permissions: { name: string; label: string }[];
}[] = [
  {
    id: 'equipment',
    title: 'Articles & Mouvements',
    icon: '⚡',
    permissions: [
      { name: 'equipment.read', label: 'Consulter les articles' },
      { name: 'equipment.create', label: 'Créer de nouveaux articles' },
      { name: 'equipment.update', label: 'Modifier les articles' },
      { name: 'equipment.delete', label: 'Supprimer des articles' },
      { name: 'movement.read', label: 'Consulter l’historique des mouvements' },
      { name: 'movement.create', label: 'Effectuer des transferts/mouvements' },
    ],
  },
  {
    id: 'serial',
    title: 'Numéros de Série',
    icon: '🔢',
    permissions: [
      { name: 'serial-number.read', label: 'Consulter les numéros de série' },
      { name: 'serial-number.create', label: 'Ajouter des numéros de série' },
      { name: 'serial-number.update', label: 'Mettre à jour les numéros de série' },
      { name: 'serial-number.delete', label: 'Supprimer des numéros de série' },
    ],
  },
  {
    id: 'shelves',
    title: 'Emplacements & Rangement',
    icon: '🗄️',
    permissions: [
      { name: 'shelf.read', label: 'Consulter les emplacements' },
      { name: 'shelf.create', label: 'Créer de nouveaux emplacements' },
      { name: 'shelf.update', label: 'Modifier les emplacements' },
      { name: 'shelf.delete', label: 'Supprimer des emplacements' },
    ],
  },
  {
    id: 'stocks',
    title: 'Gestion des Stocks',
    icon: '🏭',
    permissions: [
      { name: 'stock.read', label: 'Consulter les stocks' },
      { name: 'stock.create', label: 'Créer des zones de stock' },
      { name: 'stock.update', label: 'Modifier les zones de stock' },
      { name: 'stock.delete', label: 'Supprimer des zones de stock' },
    ],
  },
  {
    id: 'inventory',
    title: 'Inventaires & Réconciliations',
    icon: '📋',
    permissions: [
      { name: 'inventory.read', label: 'Consulter les inventaires et rapports' },
      { name: 'inventory.create', label: 'Créer de nouveaux projets d’inventaire' },
      { name: 'inventory.launch', label: 'Lancer et démarrer un inventaire' },
      { name: 'inventory.count', label: 'Contrôleur d’inventaire (Comptage initial et arbitrage en cas de divergence)' },
      { name: 'inventory.finalize', label: 'Clôturer et ajuster le stock final' },
      { name: 'inventory.delete', label: 'Supprimer un inventaire' },
    ],
  },
  {
    id: 'admin',
    title: 'Administration Système',
    icon: '🛡️',
    permissions: [
      { name: 'dashboard.read', label: 'Consulter le tableau de bord exécutif (Dashboard)' },
      { name: 'user.manage', label: 'Gérer les comptes utilisateurs et statuts' },
      { name: 'role.manage', label: 'Créer des rôles et assigner des permissions' },
    ],
  },
];

export function EditRoleModal({
  isOpen,
  onClose,
  availablePermissions,
  roleToEdit,
  onSubmitRole,
  isSubmitting = false,
}: EditRoleModalProps) {
  const [roleName, setRoleName] = useState('');
  const [selectedPermissions, setSelectedPermissions] = useState<string[]>([]);
  const [validationError, setValidationError] = useState<string | null>(null);

  const groupsToDisplay = useMemo(() => {
    const knownPerms = new Set(
      PERMISSION_GROUPS.flatMap((g) => g.permissions.map((p) => p.name)),
    );
    // Exclude inventory.adjudicate as it is internally bundled with inventory.count (Contrôleur)
    const extraPerms = (availablePermissions || []).filter(
      (p) => !knownPerms.has(p) && p !== 'inventory.adjudicate',
    );

    if (extraPerms.length === 0) {
      return PERMISSION_GROUPS;
    }

    return [
      ...PERMISSION_GROUPS,
      {
        id: 'other',
        title: 'Autres Permissions',
        icon: '⚙️',
        permissions: extraPerms.map((name) => ({
          name,
          label: name,
        })),
      },
    ];
  }, [availablePermissions]);

  useEffect(() => {
    if (isOpen && roleToEdit) {
      setRoleName(roleToEdit.roleName);
      setSelectedPermissions(
        roleToEdit.permissions
          .map((p) => p.permissionName)
          .filter((p) => p !== 'inventory.adjudicate'),
      );
      setValidationError(null);
    }
  }, [isOpen, roleToEdit]);

  if (!isOpen || !roleToEdit) return null;

  const handleTogglePermission = (permName: string) => {
    setSelectedPermissions((prev) =>
      prev.includes(permName)
        ? prev.filter((p) => p !== permName)
        : [...prev, permName],
    );
  };

  const handleToggleGroup = (groupPerms: string[]) => {
    const allSelected = groupPerms.every((p) => selectedPermissions.includes(p));
    if (allSelected) {
      setSelectedPermissions((prev) =>
        prev.filter((p) => !groupPerms.includes(p)),
      );
    } else {
      setSelectedPermissions((prev) =>
        Array.from(new Set([...prev, ...groupPerms])),
      );
    }
  };

  const handleSelectAll = () => {
    const all = groupsToDisplay.flatMap((g) => g.permissions.map((p) => p.name));
    setSelectedPermissions(all);
  };

  const handleDeselectAll = () => {
    setSelectedPermissions([]);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setValidationError(null);

    const trimmed = roleName.trim();
    if (!trimmed) {
      setValidationError('Veuillez renseigner un nom pour le rôle.');
      return;
    }
    if (selectedPermissions.length === 0) {
      setValidationError('Veuillez cocher au moins une permission pour ce rôle.');
      return;
    }

    try {
      const finalPermissions = new Set(selectedPermissions);
      if (finalPermissions.has('inventory.count')) {
        finalPermissions.add('inventory.adjudicate');
      } else {
        finalPermissions.delete('inventory.adjudicate');
      }

      await onSubmitRole({
        roleId: roleToEdit.roleId,
        roleName: trimmed.toUpperCase(),
        permissions: Array.from(finalPermissions),
      });
      onClose();
    } catch {
      // Handled by mutation toast
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-in fade-in duration-150">
      <div className="relative w-full max-w-2xl bg-[#27272a] rounded-[4px] shadow-2xl border border-[#3f3f46] flex flex-col max-h-[90vh] overflow-hidden text-[#fafafa]">
        {/* Header */}
        <div className="px-6 py-4 border-b border-[#3f3f46] flex items-center justify-between bg-[#18181b]">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-[3px] bg-[#27272a] text-[#fafafa] border border-[#3f3f46] flex items-center justify-center">
              <Edit2 className="w-4 h-4" />
            </div>
            <div>
              <h2 className="text-sm font-medium text-[#fafafa]">
                Modifier le Rôle
              </h2>
              <p className="text-xs text-[#d4d4d8]">
                Mettez à jour le nom et les permissions de ce rôle.
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-1.5 rounded-[3px] text-[#a1a1aa] hover:text-[#fafafa] hover:bg-[#27272a] transition-colors cursor-pointer"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Content Form */}
        <form onSubmit={handleSubmit} className="flex flex-col flex-1 overflow-hidden">
          <div className="p-6 overflow-y-auto space-y-5">
            {validationError && (
              <div className="p-3 bg-[#2d1616] border border-[#451e1e] rounded-[3px] text-xs text-[#ef4444] flex items-center gap-2">
                <AlertCircle className="w-4 h-4 shrink-0" />
                <span>{validationError}</span>
              </div>
            )}

            {/* Role Name Input */}
            <div>
              <label
                htmlFor="roleNameEdit"
                className="block text-[11px] font-mono uppercase tracking-wider text-[#a1a1aa] mb-1.5"
              >
                Nom du Rôle <span className="text-[#ef4444]">*</span>
              </label>
              <input
                id="roleNameEdit"
                type="text"
                value={roleName}
                onChange={(e) => setRoleName(e.target.value)}
                placeholder="Ex: MAGASINIER, AUDITEUR..."
                className="w-full px-3 py-2 text-xs font-mono bg-[#18181b] text-[#fafafa] border border-[#3f3f46] rounded-[3px] focus:outline-none focus:border-[#fafafa] transition-all placeholder:text-[#a1a1aa]"
                autoFocus
              />
            </div>

            {/* Permissions Selection Header */}
            <div>
              <div className="flex items-center justify-between mb-2">
                <label className="block text-[11px] font-mono uppercase tracking-wider text-[#a1a1aa]">
                  Permissions ({selectedPermissions.length} cochée
                  {selectedPermissions.length > 1 ? 's' : ''})
                </label>
                <div className="flex items-center gap-2 text-xs font-mono">
                  <button
                    type="button"
                    onClick={handleSelectAll}
                    className="text-[11px] text-[#fafafa] hover:underline cursor-pointer"
                  >
                    Tout sélectionner
                  </button>
                  <span className="text-[#3f3f46]">•</span>
                  <button
                    type="button"
                    onClick={handleDeselectAll}
                    className="text-[11px] text-[#a1a1aa] hover:underline cursor-pointer"
                  >
                    Tout décocher
                  </button>
                </div>
              </div>

              {/* Grouped Permissions Grid */}
              <div className="space-y-3 border border-[#3f3f46] rounded-[3px] p-3 bg-[#18181b]">
                {groupsToDisplay.map((group) => {
                  const groupPermNames = group.permissions.map((p) => p.name);
                  const isAllGroupSelected = groupPermNames.every((p) =>
                    selectedPermissions.includes(p),
                  );
                  const isSomeGroupSelected =
                    !isAllGroupSelected &&
                    groupPermNames.some((p) => selectedPermissions.includes(p));

                  return (
                    <div
                      key={group.id}
                      className="bg-[#27272a] rounded-[3px] border border-[#3f3f46] p-3"
                    >
                      {/* Group Header */}
                      <div className="flex items-center justify-between pb-2 mb-2 border-b border-[#3f3f46]">
                        <div className="flex items-center gap-2">
                          <span className="text-xs">{group.icon}</span>
                          <span className="text-xs font-medium text-[#fafafa]">
                            {group.title}
                          </span>
                        </div>
                        <button
                          type="button"
                          onClick={() => handleToggleGroup(groupPermNames)}
                          className={`text-[10px] font-mono px-2 py-0.5 rounded-[2px] transition-colors border cursor-pointer ${
                            isAllGroupSelected
                              ? 'bg-[#18181b] text-[#fafafa] border-[#fafafa]'
                              : isSomeGroupSelected
                                ? 'bg-[#18181b] text-[#f4f4f5] border-[#3f3f46]'
                                : 'text-[#a1a1aa] border-transparent hover:border-[#3f3f46]'
                          }`}
                        >
                          {isAllGroupSelected
                            ? 'Tout désélectionner'
                            : 'Tout cocher'}
                        </button>
                      </div>

                      {/* Group Checkboxes */}
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        {group.permissions.map((perm) => {
                          const isChecked = selectedPermissions.includes(perm.name);
                          return (
                            <label
                              key={perm.name}
                              className={`flex items-start gap-2.5 p-2 rounded-[2px] cursor-pointer text-xs transition-colors border ${
                                isChecked
                                  ? 'bg-[#18181b] border-[#fafafa] text-[#fafafa]'
                                  : 'hover:bg-[#18181b] border-[#3f3f46]/60 text-[#d4d4d8]'
                              }`}
                            >
                              <div
                                className={`w-3.5 h-3.5 rounded-[2px] mt-0.5 flex items-center justify-center border transition-colors shrink-0 ${
                                  isChecked
                                    ? 'bg-[#fafafa] border-[#fafafa] text-[#18181b]'
                                    : 'border-[#3f3f46] bg-[#18181b]'
                                }`}
                              >
                                {isChecked && <Check className="w-2.5 h-2.5 stroke-[3]" />}
                              </div>
                              <div className="flex flex-col">
                                <span className="font-normal text-xs leading-tight text-[#fafafa]">
                                  {perm.label}
                                </span>
                                <span className="font-mono text-[10px] text-[#a1a1aa]">
                                  {perm.name}
                                </span>
                              </div>
                              {/* Hidden checkbox element to handle toggle natively if needed or just handled by onClick of label implicitly by structure wait no we use div click so we need an input or handleTogglePermission on label */}
                              <input 
                                type="checkbox" 
                                className="hidden" 
                                checked={isChecked} 
                                onChange={() => handleTogglePermission(perm.name)} 
                              />
                            </label>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Footer Actions */}
          <div className="px-6 py-3 border-t border-[#3f3f46] bg-[#18181b] flex items-center justify-between gap-2.5">
            <span className="text-[10px] text-[#a1a1aa] font-mono">ID: {roleToEdit.roleId}</span>
            <div className="flex gap-2.5">
              <button
                type="button"
                onClick={onClose}
                disabled={isSubmitting}
                className="px-3 py-1.5 text-xs font-medium text-[#d4d4d8] hover:text-[#fafafa] hover:bg-[#27272a] rounded-[3px] transition-colors cursor-pointer"
              >
                Annuler
              </button>
              <button
                type="submit"
                disabled={isSubmitting}
                className="flex items-center gap-2 px-4 py-1.5 text-xs font-medium text-[#18181b] bg-[#fafafa] hover:bg-[#f4f4f5] rounded-[3px] transition-colors shadow-2xs disabled:opacity-50 cursor-pointer"
              >
                {isSubmitting ? (
                  <>
                    <Loader2 className="w-3.5 h-3.5 animate-spin" />
                    <span>Enregistrement...</span>
                  </>
                ) : (
                  <>
                    <Check className="w-3.5 h-3.5" />
                    <span>Sauvegarder les modifications</span>
                  </>
                )}
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/users/RoleListCards.tsx">
'use client';

import { Role } from '@/types/user-role';
import { Shield, Users, Lock, Edit2 } from 'lucide-react';

interface RoleListCardsProps {
  roles: Role[];
  isLoading: boolean;
  onOpenCreateRole: () => void;
  onOpenEditRole?: (role: Role) => void;
  canManageRoles?: boolean;
}

export function RoleListCards({
  roles,
  isLoading,
  onOpenCreateRole,
  onOpenEditRole,
  canManageRoles = true,
}: RoleListCardsProps) {
  if (isLoading) {
    return (
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {Array.from({ length: 3 }).map((_, idx) => (
          <div
            key={idx}
            className="p-5 bg-[#27272a] rounded-[4px] border border-[#3f3f46] shadow-xs animate-pulse space-y-3"
          >
            <div className="flex items-center justify-between">
              <div className="w-24 h-4 bg-[#18181b] rounded-[2px]" />
              <div className="w-16 h-3.5 bg-[#18181b] rounded-[2px]" />
            </div>
            <div className="space-y-1.5 pt-2">
              <div className="w-full h-3 bg-[#18181b] rounded-[2px]" />
              <div className="w-4/5 h-3 bg-[#18181b] rounded-[2px]" />
            </div>
          </div>
        ))}
      </div>
    );
  }

  if (roles.length === 0) {
    return (
      <div className="p-12 text-center bg-[#27272a] rounded-[4px] border border-[#3f3f46] shadow-xs">
        <div className="w-10 h-10 rounded-[3px] bg-[#18181b] border border-[#3f3f46] flex items-center justify-center text-[#a1a1aa] mx-auto mb-3">
          <Shield className="w-5 h-5" />
        </div>
        <h3 className="text-sm font-medium text-[#fafafa]">
          Aucun rôle configuré
        </h3>
        <p className="text-xs text-[#d4d4d8] mt-1 mb-4">
          Créez votre premier rôle pour attribuer des permissions granulaires à l&apos;équipe.
        </p>
        {canManageRoles && (
          <button
            type="button"
            onClick={onOpenCreateRole}
            className="px-4 py-2 bg-[#fafafa] hover:bg-[#f4f4f5] text-[#18181b] text-xs font-medium rounded-[3px] transition-colors cursor-pointer"
          >
            + Créer un rôle
          </button>
        )}
      </div>
    );
  }

  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {roles.map((role) => {
        const userCount = role._count?.users ?? 0;
        const permissionsCount = role.permissions.length;
        const isAdmin = role.roleName.toUpperCase() === 'ADMIN';

        return (
          <div
            key={role.roleId}
            className="bg-[#27272a] rounded-[4px] border border-[#3f3f46] p-5 shadow-xs flex flex-col justify-between hover:border-[#52525b] transition-colors"
          >
            <div>
              {/* Header */}
              <div className="flex items-center justify-between gap-2 mb-3">
                <div className="flex items-center gap-2">
                  <div
                    className={`w-6 h-6 rounded-[2px] flex items-center justify-center text-xs font-mono font-bold border ${
                      isAdmin
                        ? 'bg-[#18181b] text-[#fafafa] border-[#fafafa]'
                        : 'bg-[#18181b] text-[#d4d4d8] border-[#3f3f46]'
                    }`}
                  >
                    <Shield className="w-3.5 h-3.5" />
                  </div>
                  <h3 className="text-sm font-medium text-[#fafafa] tracking-tight font-mono">
                    {role.roleName}
                  </h3>
                </div>

                <span className="flex items-center gap-1.5 text-[11px] font-mono text-[#d4d4d8] bg-[#18181b] px-2 py-0.5 rounded-[2px] border border-[#3f3f46]">
                  <Users className="w-3 h-3 text-[#a1a1aa]" />
                  <span>
                    {userCount} membre{userCount > 1 ? 's' : ''}
                  </span>
                </span>
              </div>

              {/* Permissions Header */}
              <div className="flex items-center justify-between text-xs text-[#a1a1aa] mb-2 font-mono">
                <span className="uppercase text-[10px] tracking-wider text-[#a1a1aa]">
                  Permissions ({permissionsCount})
                </span>
              </div>

              {/* Badges */}
              <div className="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto pr-1">
                {role.permissions.map((p) => (
                  <span
                    key={p.permissionId}
                    className="inline-flex items-center px-1.5 py-0.5 rounded-[2px] text-[10px] font-mono bg-[#18181b] text-[#f4f4f5] border border-[#3f3f46]"
                  >
                    {p.permissionName}
                  </span>
                ))}
              </div>
            </div>

            {/* Footer */}
            <div className="pt-3 mt-4 border-t border-[#3f3f46] flex flex-row-reverse items-center justify-between text-xs text-[#a1a1aa] font-mono">
              
              {canManageRoles && !isAdmin && onOpenEditRole && (
                <button
                  type="button"
                  onClick={() => onOpenEditRole(role)}
                  className="p-1.5 text-[#a1a1aa] hover:text-[#fafafa] hover:bg-[#18181b] rounded-[3px] transition-colors cursor-pointer"
                  title="Modifier le rôle"
                >
                  <Edit2 className="w-3.5 h-3.5" />
                </button>
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
}
</file>

<file path="frontend/src/hooks/use-movements.ts">
'use client';

import {
  keepPreviousData,
  useMutation,
  useQuery,
  useQueryClient,
} from '@tanstack/react-query';
import {
  toast,
} from 'sonner';

import {
  useApi,
} from '@/hooks/use-api';

import {
  useAuthQueryContext,
} from '@/hooks/use-auth-query-context';

import {
  usePermissions,
} from '@/hooks/use-permissions';

import {
  getErrorMessage,
} from '@/lib/error-message';

import {
  MovementService,
} from '@/services/movement.service';

import type {
  CreateMovementInput,
  MovementQuery,
} from '@/types/movement';

export function useMovements(
  query: MovementQuery = {},
  enabled = true,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  const {
    permissions,
  } = usePermissions();

  const normalized: MovementQuery = {
    page:
      query.page ?? 1,
    limit:
      query.limit ?? 20,
    movementType:
      query.movementType,
    origin:
      query.origin,
    inventoryId:
      query.inventoryId,
    equipmentId:
      query.equipmentId,
    serialNumberId:
      query.serialNumberId,
    sourceShelfId:
      query.sourceShelfId,
    destinationShelfId:
      query.destinationShelfId,
  };

  return useQuery({
    queryKey: [
      'movements',
      normalized, userId],

    queryFn: () =>
      MovementService.getMovements(
        api,
        normalized,
        permissions,
      ),

    enabled,

    placeholderData:
      keepPreviousData,

    staleTime: 20_000,
  });
}

export function useMovement(
  movementId?: string | null,
  enabled = true,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  const {
    permissions,
  } = usePermissions();

  return useQuery({
    queryKey: [
      'movements',
      'detail',
      movementId, userId],

    queryFn: () =>
      MovementService.getMovementById(
        api,
        movementId!,
        permissions,
      ),

    enabled:
      enabled &&
      Boolean(
        movementId,
      ),

    staleTime: 30_000,
  });
}

export function useCreateMovement() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  return useMutation({
    mutationFn: (
      input: CreateMovementInput,
    ) =>
      MovementService.createMovement(
        api,
        input,
        permissions,
      ),

    onSuccess: async () => {
      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ['movements'] }),
        queryClient.invalidateQueries({ queryKey: ['equipments'] }),
        queryClient.invalidateQueries({ queryKey: ['equipment'] }),
        queryClient.invalidateQueries({ queryKey: ['serial-numbers'] }),
        queryClient.invalidateQueries({ queryKey: ['shelves'] }),
        queryClient.invalidateQueries({ queryKey: ['shelf'] }),
        queryClient.invalidateQueries({ queryKey: ['shelf-equipments'] }),
        queryClient.invalidateQueries({ queryKey: ['shelf-serial-numbers'] }),
        queryClient.invalidateQueries({ queryKey: ['equipment-allocations'] }),
        queryClient.invalidateQueries({ queryKey: ['dashboard'] }),
      ]);

      toast.success(
        'Mouvement enregistré',
      );
    },

    onError: (
      error: unknown,
    ) => {
      toast.error(
        'Mouvement impossible',
        {
          description:
            getErrorMessage(
              error,
              'Le mouvement a été refusé.',
            ),
        },
      );
    },
  });
}

