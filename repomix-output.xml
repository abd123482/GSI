              (unit) => (
                <article
                  key={unit.unitId}
                  className="overflow-hidden rounded-lg border border-[#3f3a36] bg-[#2f2a26]"
                >
                  <div className="flex flex-col gap-2 border-b border-[#3f3a36] bg-[#383330]/45 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <h3 className="text-xs font-semibold">
                        Unité #
                        {unit.unitOrder +
                          1}
                      </h3>

                      <p className="mt-0.5 text-[9px] text-[#8c827a]">
                        Résultat accepté :{' '}
                        {unit.acceptedPurpose ===
                        'FINAL_RECOUNT'
                          ? 'C3'
                          : unit.acceptedPurpose ===
                              'PRIMARY_1'
                            ? 'C1'
                            : 'En attente'}
                      </p>
                    </div>

                    <span
                      className={`w-fit rounded border px-2 py-1 text-[10px] font-semibold ${reconcileClass(
                        unit.reconciliationStatus,
                      )}`}
                    >
                      {
                        unit.reconciliationStatus
                      }
                    </span>
                  </div>

                  <div className="overflow-x-auto">
                    <table className="min-w-[1050px] w-full text-left text-xs">
                      <thead className="border-b border-[#3f3a36] text-[9px] uppercase tracking-wide text-[#8c827a]">
                        <tr>
                          <th className="px-3 py-2">
                            Élément
                          </th>
                          <th className="px-3 py-2">
                            C1
                          </th>
                          <th className="px-3 py-2">
                            C2
                          </th>
                          <th className="px-3 py-2">
                            C3
                          </th>
                          <th className="px-3 py-2">
                            Accepté
                          </th>
                          <th className="px-3 py-2">
                            C1 vs final
                          </th>
                          <th className="px-3 py-2">
                            C2 vs final
                          </th>
                        </tr>
                      </thead>

                      <tbody className="divide-y divide-[#3f3a36]">
                        {unit.rows.map(
                          (row) => (
                            <tr
                              key={
                                row.key
                              }
                            >
                              <td className="px-3 py-3">
                                <p className="font-semibold">
                                  {row.serialNumberCode ??
                                    row.equipmentName ??
                                    'Élément'}
                                </p>

                                <p className="mt-0.5 text-[9px] text-[#8c827a]">
                                  {row.kind}
                                  {row.shelfName
                                    ? ` • ${row.shelfName}`
                                    : ''}
                                </p>
                              </td>

                              <ResultCell
                                value={resultText(
                                  row.controller1,
                                  row.kind,
                                )}
                              />

                              <ResultCell
                                value={resultText(
                                  row.controller2,
                                  row.kind,
                                )}
                              />

                              <ResultCell
                                value={
                                  unit.reconciliationStatus ===
                                    'THIRD_REQUIRED' ||
                                  unit.reconciliationStatus ===
                                    'THIRD_RESOLVED'
                                    ? resultText(
                                        row.controller3,
                                        row.kind,
                                      )
                                    : 'Non requis'
                                }
                              />

                              <ResultCell
                                value={resultText(
                                  row.accepted,
                                  row.kind,
                                )}
                                strong
                              />

                              <ComparisonCell
                                status={
                                  row
                                    .controller1VsAccepted
                                    .status
                                }
                                missing={
                                  row
                                    .controller1VsAccepted
                                    .missing
                                }
                                surplus={
                                  row
                                    .controller1VsAccepted
                                    .surplus
                                }
                              />

                              <ComparisonCell
                                status={
                                  row
                                    .controller2VsAccepted
                                    .status
                                }
                                missing={
                                  row
                                    .controller2VsAccepted
                                    .missing
                                }
                                surplus={
                                  row
                                    .controller2VsAccepted
                                    .surplus
                                }
                              />
                            </tr>
                          ),
                        )}

                        {!unit.rows.length && (
                          <tr>
                            <td
                              colSpan={7}
                              className="px-3 py-8 text-center text-[#8c827a]"
                            >
                              Les résultats de cette unité ne sont pas encore disponibles.
                            </td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </article>
              ),
            )
          )}
        </section>

        <section className="grid grid-cols-1 gap-3 lg:grid-cols-2">
          <div className="rounded-lg border border-[#3f3a36] bg-[#2f2a26] p-4">
            <h2 className="flex items-center gap-2 text-xs font-semibold">
              <AlertTriangle className="h-3.5 w-3.5 text-amber-300" />
              Écarts / investigations
            </h2>

            {r.investigationIssues
              .length ? (
              <div className="mt-3 space-y-2">
                {r.investigationIssues.map(
                  (issue) => (
                    <div
                      key={
                        issue.issueId
                      }
                      className="rounded border border-[#3f3a36] bg-[#383330]/40 p-3 text-xs"
                    >
                      <div className="flex items-center justify-between gap-3">
                        <span className="font-semibold">
                          {
                            issue.issueType
                          }
                        </span>

                        <span className="text-[9px] text-[#aea69c]">
                          {
                            issue.status
                          }
                        </span>
                      </div>

                      <p className="mt-1 text-[10px] text-[#aea69c]">
                        {issue.equipment
                          ?.equipmentName ??
                          issue.serialNumberCode ??
                          'Élément'}
                        {issue.deltaQuantity
                          ? ` • écart ${issue.deltaQuantity}`
                          : ''}
                      </p>
                    </div>
                  ),
                )}
              </div>
            ) : (
              <p className="mt-3 text-xs text-[#8c827a]">
                Aucun écart d’investigation enregistré.
              </p>
            )}
          </div>

          <div className="rounded-lg border border-[#3f3a36] bg-[#2f2a26] p-4">
            <h2 className="flex items-center gap-2 text-xs font-semibold">
              <CheckCircle2 className="h-3.5 w-3.5 text-emerald-300" />
              Traçabilité
            </h2>

            <div className="mt-3 space-y-2 text-xs text-[#c9c0ad]">
              <p>
                Créé :{' '}
                {formatDate(
                  r.inventory
                    .createdAt,
                )}
              </p>

              <p>
                Lancé :{' '}
                {formatDate(
                  r.inventory
                    .launchedAt,
                )}
              </p>

              <p>
                Finalisé :{' '}
                {formatDate(
                  r.inventory
                    .finalizedAt,
                )}
              </p>

              <p>
                Mouvements d’ajustement :{' '}
                {
                  r.adjustmentMovements
                    .length
                }
              </p>
            </div>
          </div>
        </section>
      </div>
    </main>
  );
}

function SummaryCard({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="rounded border border-[#3f3a36] bg-[#2f2a26] p-3">
      <p className="text-[9px] uppercase tracking-wider text-[#8c827a]">
        {label}
      </p>

      <p className="mt-2 font-mono text-lg font-semibold">
        {value}
      </p>
    </div>
  );
}

function ControllerCard({
  title,
  data,
  conditional = false,
}: {
  title: string;
  data: {
    user: {
      userName:
        string | null;
      userEmail:
        string | null;
    } | null;
    completedUnits: number;
    totalUnits?: number;
    requiredUnits?: number;
    isActive?: boolean;
    isFinished: boolean;
  };
  conditional?: boolean;
}) {
  const total =
    conditional
      ? data.requiredUnits ??
        0
      : data.totalUnits ??
        0;

  return (
    <div className="rounded border border-[#3f3a36] bg-[#2f2a26] p-4">
      <div className="flex items-center gap-2">
        <Users className="h-4 w-4 text-[#aea69c]" />

        <div>
          <p className="text-xs font-semibold">
            {title}
          </p>

          <p className="mt-0.5 text-[9px] text-[#8c827a]">
            {data.user
              ?.userName ??
              data.user
                ?.userEmail ??
              'Non assigné'}
          </p>
        </div>
      </div>

      <div className="mt-3 flex items-center justify-between text-xs">
        <span className="text-[#aea69c]">
          {conditional
            ? 'Unités requises'
            : 'Progression'}
        </span>

        <span className="font-mono font-semibold">
          {
            data.completedUnits
          }
          /
          {total}
        </span>
      </div>

      {conditional &&
        total === 0 && (
          <p className="mt-2 text-[10px] text-emerald-200">
            Aucun C3 requis pour le moment.
          </p>
        )}
    </div>
  );
}

function ResultCell({
  value,
  strong = false,
}: {
  value: string;
  strong?: boolean;
}) {
  return (
    <td
      className={`px-3 py-3 ${
        strong
          ? 'font-semibold text-white'
          : 'text-[#c9c0ad]'
      }`}
    >
      {value}
    </td>
  );
}

function ComparisonCell({
  status,
  missing,
  surplus,
}: {
  status: InventoryComparisonStatus;
  missing: number;
  surplus: number;
}) {
  return (
    <td className="px-3 py-3">
      <span
        className={`inline-flex rounded border px-2 py-1 text-[9px] font-semibold ${comparisonClass(
          status,
        )}`}
      >
        {status}
        {missing > 0
          ? ` -${missing}`
          : surplus > 0
            ? ` +${surplus}`
            : ''}
      </span>
    </td>
  );
}
