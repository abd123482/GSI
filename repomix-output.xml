              Mouvements
            </h1>

          </div>

          <div className="flex items-center gap-2">

          </div>
        </div>

        <section className="flex flex-col gap-3 rounded border border-[#3f3f46] bg-[#27272a] p-4 sm:flex-row sm:items-end">
          <label className="block min-w-52">
            <span className="mb-1.5 block text-[10px] font-semibold uppercase tracking-wider text-[#71717a]">
              Type
            </span>

            <select
              value={
                movementType
              }
              onChange={(
                event,
              ) => {
                setMovementType(
                  event.target
                    .value as
                  | MovementType
                  | '',
                );
                setPage(1);
              }}
              className="h-9 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
            >
              <option value="">
                Tous
              </option>
              <option value="IN">
                Entrées
              </option>
              <option value="OUT">
                Sorties
              </option>
              <option value="TRANSFER">
                Transferts
              </option>
            </select>
          </label>

          <label className="block w-32">
            <span className="mb-1.5 block text-[10px] font-semibold uppercase tracking-wider text-[#71717a]">
              Par page
            </span>

            <select
              value={limit}
              onChange={(
                event,
              ) => {
                setLimit(
                  Number(
                    event.target
                      .value,
                  ),
                );
                setPage(1);
              }}
              className="h-9 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
            >
              <option value={10}>
                10
              </option>
              <option value={20}>
                20
              </option>
              <option value={50}>
                50
              </option>
            </select>
          </label>

          {permissions.canCreateMovement && (
            <button
              type="button"
              onClick={() => setCreateOpen(true)}
              className="mt-3 inline-flex h-9 items-center justify-center gap-2 rounded bg-[#fafafa] px-3 text-xs font-semibold text-[#18181b] sm:ml-auto sm:mt-0"
            >
              <Plus className="h-3.5 w-3.5" />
              Nouveau mouvement
            </button>
          )}
        </section>

        <MovementListTable
          movements={
            movementsQuery.data
              ?.movements ?? []
          }
          totalMovements={
            movementsQuery.data
              ?.totalMovements ?? 0
          }
          currentPage={
            movementsQuery.data
              ?.currentPage ?? page
          }
          totalPages={
            movementsQuery.data
              ?.totalPages ?? 1
          }
          limit={
            movementsQuery.data
              ?.limit ?? limit
          }
          isLoading={
            movementsQuery.isLoading
          }
          isFetching={
            movementsQuery.isFetching
          }
          onPageChange={
            setPage
          }
          onSelectMovement={
            setSelectedMovement
          }
        />
      </div>

      <MovementDetailModal
        movement={
          selectedMovement
        }
        isOpen={
          Boolean(
            selectedMovement,
          )
        }
        onClose={() =>
          setSelectedMovement(
            null,
          )
        }
      />

      <CreateMovementModal
        isOpen={
          createOpen
        }
        onClose={() =>
          setCreateOpen(
            false,
          )
        }
        onSuccess={() => {
          setCreateOpen(
            false,
          );
          void movementsQuery.refetch();
        }}
      />
    </main>
  );
}
</file>

