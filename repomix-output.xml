<file path="frontend/src/components/shelf/ShelfDetailModal.tsx">
'use client';

import { useEffect, useState } from 'react';
import type { ReactNode } from 'react';
import {
  Barcode,
  ChevronLeft,
  ChevronRight,
  Layers,
  Loader2,
  Package,
  RefreshCw,
  Warehouse,
  X,
} from 'lucide-react';

import type { Shelf } from '@/types/shelf';
import { useShelfEquipments } from '@/hooks/use-shelves';

interface ShelfDetailModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  isLoading?: boolean;
}

export function ShelfDetailModal({ shelf, isOpen, onClose, onRefresh, isLoading = false }: ShelfDetailModalProps) {
  const [page, setPage] = useState(1);
  const limit = 20;

  useEffect(() => {
    if (isOpen) {
      setPage(1);
    }
  }, [shelf?.shelfId, isOpen]);

  const equipmentsQuery = useShelfEquipments(shelf?.shelfId, page, limit, isOpen);

  if (!isOpen || !shelf) return null;

  const busy = isLoading || equipmentsQuery.isFetching;
  const equipments = equipmentsQuery.data?.equipments ?? [];
  const totalPages = equipmentsQuery.data?.totalPages ?? 1;
  const totalEquipments = equipmentsQuery.data?.totalEquipments ?? 0;
  const totalQuantity = equipmentsQuery.data?.totalQuantity ?? 0;

  async function refresh() {
    await equipmentsQuery.refetch();
    onRefresh?.();
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-5 py-4">
          <div>
            <h2 className="text-base font-semibold">{shelf.shelfName ?? 'Emplacement sans nom'}</h2>
            <p className="mt-0.5 flex items-center gap-1.5 text-[10px] text-white/45"><Warehouse className="h-3 w-3" />{shelf.stock?.stockName ?? 'Stock'}</p>
          </div>
          <div className="flex items-center gap-1">
            <button
              type="button"
              onClick={refresh}
              disabled={busy}
              className="rounded p-2 text-white/60 hover:bg-white/10 hover:text-white disabled:opacity-30"
              title="Actualiser"
            >
              <RefreshCw className={`h-4 w-4 ${busy ? 'animate-spin' : ''}`} />
            </button>
            <button type="button" onClick={onClose} className="rounded p-2 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
          </div>
        </header>

        <div className="flex-1 overflow-y-auto p-5">
          <div className="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <InfoBox label="Stock parent" value={shelf.stock?.stockName ?? 'Inconnu'} icon={<Warehouse className="h-3.5 w-3.5" />} />
            <InfoBox label="Statut de l'emplacement" value={shelf.status !== false ? 'Actif' : 'Inactif'} icon={<Layers className="h-3.5 w-3.5" />} />
          </div>

          <section className="overflow-hidden rounded-lg border border-[#3f3f46] bg-[#18181b]">
            <div className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-4 py-3">
              <h3 className="flex items-center gap-1.5 text-xs font-semibold">
                <Package className="h-3.5 w-3.5 text-white/70" />
                Équipements présents
              </h3>
              <span className="text-[10px] text-white/45">
                {totalEquipments} article{totalEquipments > 1 ? 's' : ''} • {totalQuantity} unité{totalQuantity > 1 ? 's' : ''}
              </span>
            </div>

            {equipmentsQuery.isLoading ? (
              <div className="flex items-center justify-center gap-2 py-12 text-xs text-white/45"><Loader2 className="h-4 w-4 animate-spin" />Chargement...</div>
            ) : equipmentsQuery.isError ? (
              <div className="m-4 rounded-lg border border-rose-500/30 bg-rose-950/25 p-4 text-xs text-rose-200">
                {equipmentsQuery.error?.message || 'Impossible de charger le contenu de cet emplacement.'}
              </div>
            ) : equipments.length === 0 ? (
              <div className="m-4 flex min-h-32 items-center justify-center rounded-lg border border-dashed border-[#4b4540] bg-[#18181b]/45 p-6 text-center text-sm text-[#d4d4d8]">Aucun équipement dans cet emplacement.</div>
            ) : (
              <div>
                <div className="divide-y divide-[#3f3f46]">
                  {equipments.map((eq) => (
                    <div key={eq.equipmentId} className="group relative flex items-center justify-between gap-3 bg-[#27272a] px-4 py-3 hover:bg-[#3f3f46]/50">
                      <div className="flex items-center gap-3">
                        <div className="flex h-8 w-8 items-center justify-center rounded border border-[#403b37] bg-[#18181b] text-white/70">
                          {eq.hasSerialNumber ? <Barcode className="h-4 w-4" /> : <Package className="h-4 w-4" />}
                        </div>
                        <div>
                          <div className="flex items-center gap-2">
                            <p className="text-xs font-semibold text-[#fafafa]">{eq.equipmentName}</p>
                            <span className={`rounded px-1.5 py-0.5 text-[9px] font-medium border ${
                              eq.hasSerialNumber
                                ? 'border-purple-500/30 bg-purple-500/10 text-purple-300'
                                : 'border-blue-500/30 bg-blue-500/10 text-blue-300'
                            }`}>
                              {eq.hasSerialNumber ? 'Sérialisé' : 'Standard'}
                            </span>
                          </div>
                          <p className="text-[10px] text-white/45">
                            {eq.hasSerialNumber
                              ? `${eq.serials.length} numéro(s) de série présent(s)`
                              : 'Article standard'}
                          </p>
                        </div>
                      </div>

                      <div className="flex items-center gap-2">
                        <span className="rounded bg-[#18181b] px-2.5 py-1 font-mono text-xs font-semibold text-[#fafafa] border border-[#3f3f46]">
                          {eq.quantity} u.
                        </span>
                      </div>

                      {/* Hover Tooltip for serial numbers */}
                      {eq.hasSerialNumber && eq.serials.length > 0 && (
                        <div className="pointer-events-none absolute right-4 top-full z-50 mt-1 hidden w-64 rounded-md border border-[#3f3f46] bg-[#18181b] p-3 shadow-xl group-hover:block">
                          <p className="mb-2 text-[10px] font-semibold text-white/45 uppercase tracking-wider">
                            Numéros de série ({eq.serials.length})
                          </p>
                          <div className="flex max-h-36 flex-wrap gap-1.5 overflow-y-auto">
                            {eq.serials.map((s) => (
                              <span key={s.serialNumberId} className="rounded bg-[#27272a] px-1.5 py-0.5 font-mono text-[10px] text-white border border-[#3f3f46]">
                                {s.serialNumberCode ?? 'Série'}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
                </div>

                {totalPages > 1 && (
                  <div className="flex items-center justify-between border-t border-[#3f3f46] p-3 text-xs">
                    <button
                      type="button"
                      disabled={page <= 1}
                      onClick={() => setPage((p) => p - 1)}
                      className="rounded border border-[#3f3f46] p-1.5 text-[#a1a1aa] disabled:opacity-30"
                    >
                      <ChevronLeft className="h-4 w-4" />
                    </button>
                    <span className="text-[#a1a1aa]">
                      Page {page} sur {totalPages}
                    </span>
                    <button
                      type="button"
                      disabled={page >= totalPages}
                      onClick={() => setPage((p) => p + 1)}
                      className="rounded border border-[#3f3f46] p-1.5 text-[#a1a1aa] disabled:opacity-30"
                    >
                      <ChevronRight className="h-4 w-4" />
                    </button>
                  </div>
                )}
              </div>
            )}
          </section>
        </div>

        <footer className="flex justify-end border-t border-[#3f3f46] bg-[#18181b] px-5 py-3">
          <button type="button" onClick={onClose} className="rounded bg-[#fafafa] px-4 py-2 text-xs font-medium text-[#18181b]">Fermer</button>
        </footer>
      </div>
    </div>
  );
}

function InfoBox({ label, value, icon }: { label: string; value: string; icon: ReactNode }) {
  return (
    <div className="rounded-lg border border-[#3f3f46] bg-[#18181b]/65 p-3">
      <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-white/40">{icon}{label}</div>
      <p className="mt-2 truncate text-xs font-medium">{value}</p>
    </div>
  );
}
</file>

<file path="frontend/src/components/shelf/ShelfListTable.tsx">
'use client';

import { useMemo } from 'react';
import {
  Boxes,
  ChevronLeft,
  ChevronRight,
  Eye,
  Hash,
  Layers,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  Trash2,
  Warehouse,
} from 'lucide-react';

import type { Shelf } from '@/types/shelf';

interface ShelfListTableProps {
  shelves: Shelf[];
  totalShelves: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  onSearchChange: (search: string) => void;
  onPageChange: (page: number) => void;
  onLimitChange: (limit: number) => void;
  onSelectShelf: (shelf: Shelf) => void;
  onOpenUpdate?: (shelf: Shelf) => void;
  onOpenDelete?: (shelf: Shelf) => void;
  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateShelf: boolean;
  canUpdateShelf?: boolean;
  canDeleteShelf?: boolean;
}

export function ShelfListTable({
  shelves,
  totalShelves,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  onSearchChange,
  onPageChange,
  onLimitChange,
  onSelectShelf,
  onOpenUpdate,
  onOpenDelete,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateShelf,
  canUpdateShelf = true,
  canDeleteShelf = true,
}: ShelfListTableProps) {
  const startItem = totalShelves === 0 ? 0 : (currentPage - 1) * limit + 1;
  const endItem = Math.min(currentPage * limit, totalShelves);

  const pageNumbers = useMemo(() => {
    const start = Math.max(1, currentPage - 2);
    const end = Math.min(totalPages, start + 4);
    return Array.from({ length: Math.max(0, end - start + 1) }, (_, i) => start + i);
  }, [currentPage, totalPages]);

  return (
    <div className="overflow-hidden rounded-lg border border-[#3f3f46] bg-[#27272a]">
      <div className="flex flex-col gap-3 border-b border-[#3f3f46] p-3 lg:flex-row lg:items-center lg:justify-between">
        <div className="relative w-full max-w-lg">
          <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#a1a1aa]" />
          <input
            value={searchTerm}
            onChange={(event) => onSearchChange(event.target.value)}
            placeholder="Rechercher par nom d’emplacement..."
            className="h-9 w-full rounded border border-[#3f3f46] bg-[#18181b] pl-9 pr-3 text-xs text-[#fafafa] outline-none placeholder:text-[#a1a1aa] focus:border-[#f4f4f5]"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <select
            value={searchTerm === 'status:ACTIVE' ? 'ACTIVE' : searchTerm === 'status:INACTIVE' ? 'INACTIVE' : 'ALL'}
            onChange={(event) => {
              if (event.target.value === 'ALL') {
                onSearchChange('');
              } else {
                onSearchChange(`status:${event.target.value}`);
              }
            }}
            className="h-9 rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs text-[#fafafa]"
          >
            <option value="ALL">Tous les statuts</option>
            <option value="true">Actif</option>
            <option value="false">Inactif</option>
          </select>

          <select
            value={limit}
            onChange={(event) => onLimitChange(Number(event.target.value))}
            className="h-9 rounded border border-[#3f3f46] bg-[#18181b] px-2 text-xs text-[#fafafa]"
          >
            <option value={10}>10 / page</option>
            <option value={20}>20 / page</option>
            <option value={50}>50 / page</option>
          </select>

          {canCreateShelf && (
            <button type="button" onClick={onOpenCreateModal} className="inline-flex h-9 items-center gap-1.5 rounded bg-[#fafafa] px-3 text-xs font-semibold text-[#18181b]">
              <Plus className="h-3.5 w-3.5" />Nouvel emplacement
            </button>
          )}
        </div>
      </div>

      <div className="p-4">
        {isLoading && shelves.length === 0 ? (
          <div className="flex min-h-48 items-center justify-center gap-2 text-xs text-[#a1a1aa]">
            <RefreshCw className="h-4 w-4 animate-spin" />Chargement des emplacements...
          </div>
        ) : shelves.length === 0 ? (
          <div className="flex min-h-48 flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-[#4b4540] bg-[#18181b]/45 p-6 text-center">
            <Boxes className="h-7 w-7 text-[#a1a1aa]" />
            <p className="text-sm font-medium text-[#fafafa]">Aucun emplacement disponible</p>
            <p className="text-xs text-[#a1a1aa]">{searchTerm ? 'Aucun emplacement ne correspond à cette recherche.' : 'Créez un emplacement dans un stock ACTIVE.'}</p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead className="border-b border-[#3f3f46] bg-[#18181b] text-[10px] uppercase tracking-wide text-[#a1a1aa]">
                <tr>
                  <th className="px-4 py-3">Emplacement</th>
                  <th className="px-4 py-3">Stock</th>
                  <th className="px-4 py-3">Statut</th>
                  <th className="px-4 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#3f3f46]">
                {shelves.map((shelf, index) => {
                  const globalIndex = (currentPage - 1) * limit + index + 1;
                  const stockName = shelf.stock?.stockName ?? 'Stock inconnu';
                  const shelfStatus = shelf.status !== false ? 'ACTIVE' : 'INACTIVE';

                  return (
                    <tr key={shelf.shelfId} className="group transition hover:bg-[#332e29]">
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-3">
                          <div className="flex h-8 w-8 items-center justify-center rounded border border-[#403b37] bg-[#18181b]">
                            <Layers className="h-4 w-4 text-[#f4f4f5]" />
                          </div>
                          <div>
                            <p className="font-semibold text-[#fafafa]">{shelf.shelfName ?? 'Emplacement sans nom'}</p>
                            <p className="text-[10px] font-mono text-[#a1a1aa]">#{String(globalIndex).padStart(2, '0')}</p>
                          </div>
                        </div>
                      </td>
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-1.5 text-[#a1a1aa]">
                          <Warehouse className="h-3.5 w-3.5" />
                          <span>{stockName}</span>
                        </div>
                      </td>
                      <td className="px-4 py-3">
                        <span className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[10px] font-medium border ${shelfStatus === 'ACTIVE'
                            ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-400'
                            : 'border-amber-500/20 bg-amber-500/10 text-amber-400'
                          }`}>
                          <span className={`h-1 w-1 rounded-full ${shelfStatus === 'ACTIVE' ? 'bg-emerald-400' : 'bg-amber-400'}`} />
                          {shelfStatus === 'ACTIVE' ? 'Actif' : 'Inactif'}
                        </span>
                      </td>
                      <td className="px-4 py-3">
                        <div className="flex items-center justify-end gap-1">
                          <button type="button" onClick={() => onSelectShelf(shelf)} className="rounded p-1.5 text-[#a1a1aa] hover:bg-[#18181b] hover:text-white" title="Voir">
                            <Eye className="h-3.5 w-3.5" />
                          </button>
                          {onOpenUpdate && (
                            <button type="button" onClick={() => onOpenUpdate(shelf)} disabled={!canUpdateShelf} className="rounded p-1.5 text-[#a1a1aa] hover:bg-[#18181b] hover:text-white disabled:opacity-30" title="Modifier">
                              <Pencil className="h-3.5 w-3.5" />
                            </button>
                          )}
                          {onOpenDelete && (
                            <button type="button" onClick={() => onOpenDelete(shelf)} disabled={!canDeleteShelf} className="rounded p-1.5 text-rose-400 hover:bg-rose-950/30 disabled:opacity-30" title="Supprimer">
                              <Trash2 className="h-3.5 w-3.5" />
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <div className="flex flex-col gap-3 border-t border-[#3f3f46] bg-[#18181b] px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <p className="text-[11px] text-[#a1a1aa]">{startItem}–{endItem} sur {totalShelves} emplacement{totalShelves > 1 ? 's' : ''}</p>
        <div className="flex items-center gap-1">
          <button type="button" disabled={currentPage <= 1} onClick={() => onPageChange(currentPage - 1)} className="rounded border border-[#3f3f46] p-2 text-[#a1a1aa] disabled:opacity-30"><ChevronLeft className="h-3.5 w-3.5" /></button>
          {pageNumbers.map((page) => (
            <button type="button" key={page} onClick={() => onPageChange(page)} className={`h-8 min-w-8 rounded border px-2 text-xs ${page === currentPage ? 'border-[#f4f4f5] bg-[#fafafa] text-[#18181b]' : 'border-[#3f3f46] text-[#a1a1aa]'}`}>{page}</button>
          ))}
          <button type="button" disabled={currentPage >= totalPages} onClick={() => onPageChange(currentPage + 1)} className="rounded border border-[#3f3f46] p-2 text-[#a1a1aa] disabled:opacity-30"><ChevronRight className="h-3.5 w-3.5" /></button>
        </div>
      </div>
    </div>
  );
}
