<file path="backend/src/shelves/shelves.service.ts">
import { setTimeout as delay } from 'node:timers/promises';
import { BadRequestException, ConflictException, Injectable, NotFoundException } from '@nestjs/common';
import { ZodError } from 'zod';
import { Prisma } from '../generated/prisma/client.js';
import { PrismaService } from '../prisma/prisma.service.js';
import {
  createShelfSchema, updateShelfSchema, searchShelfSchema, paginationSchema,
  type CreateShelfDTO, type UpdateShelfDTO, type SearchShelfDTO, type PaginationDTO,
} from './dto/index.js';

const shelfSelect = {
  shelfId: true, shelfName: true, stockId: true, status: true,
  stock: { select: { stockId: true, stockName: true, status: true } },
} satisfies Prisma.ShelfSelect;
const shelfOrder = [{ shelfName: 'asc' }, { shelfId: 'asc' }] satisfies Prisma.ShelfOrderByWithRelationInput[];

type SerialRow = {
  serialNumberId: string; serialNumberCode: string; serialNumberStatus: string;
  equipmentId: string; equipmentName: string; equipmentStatus: string;
};

function parse<T>(schema: { parse(input: unknown): T }, input: unknown): T {
  try { return schema.parse(input); }
  catch (error) {
    if (error instanceof ZodError) throw new BadRequestException(error.issues.map(issue => issue.message));
    throw error;
  }
}

function pageArgs(input: PaginationDTO) {
  const { page, limit } = parse(paginationSchema, input ?? {});
  const skip = (page - 1) * limit;
  if (!Number.isSafeInteger(skip) || skip > 2_147_483_647) throw new BadRequestException('Page is too large');
  return { page, limit, skip };
}

function dbError(error: unknown): never {
  if (error instanceof Prisma.PrismaClientKnownRequestError) {
    if (error.code === 'P2002') throw new BadRequestException('Shelf name or another unique value already exists');
    if (error.code === 'P2025') throw new NotFoundException('Shelf or related record not found');
    if (error.code === 'P2003') throw new BadRequestException('Operation blocked by a stock, movement, or inventory reference');
    if (error.code === 'P2034') throw new ConflictException('Concurrent update; retry the request');
  }
  throw error;
}

function serialsOnShelf(shelfId: string) {
  return Prisma.sql`
    WITH CurrentSerials AS (
      SELECT serialNumberId FROM (
        SELECT serialNumberId, CONVERT(bigint, equipmentQuantity) AS delta
        FROM dbo.MovementEquipment
        WHERE destinationShelfId = CAST(${shelfId} AS uniqueidentifier) AND serialNumberId IS NOT NULL
        UNION ALL
        SELECT serialNumberId, -CONVERT(bigint, equipmentQuantity) AS delta
        FROM dbo.MovementEquipment
        WHERE sourceShelfId = CAST(${shelfId} AS uniqueidentifier) AND serialNumberId IS NOT NULL
      ) AS entries
      GROUP BY serialNumberId HAVING SUM(delta) > 0
    )`;
}
@Injectable()
export class ShelfService {
  constructor(private readonly prisma: PrismaService) { }

  async createShelf(dto: CreateShelfDTO) {
    const { shelfName, stockId, status } = parse(createShelfSchema, dto);
    return this.write(async tx => {
      await this.requireActiveStock(tx, stockId);
      return tx.shelf.create({ data: { shelfName, stockId, status: status ?? true }, select: shelfSelect });
    });
  }

  async updateShelf(shelfId: string, dto: UpdateShelfDTO) {
    const { shelfName, stockId, status } = parse(updateShelfSchema, dto);
    const update = (tx: Prisma.TransactionClient) => tx.shelf.update({
      where: { shelfId },
      data: {
        ...(shelfName !== undefined && { shelfName }),
        ...(stockId !== undefined && { stockId }),
        ...(status !== undefined && { status }),
      },
      select: shelfSelect,
    });
    // Name-only updates rely on the database UNIQUE index; no preliminary read.
    if (stockId === undefined && status === undefined) return update(this.prisma).catch(dbError);
    return this.write(async tx => {
      const current = await tx.shelf.findUniqueOrThrow({ where: { shelfId }, select: { stockId: true } });
      const moving = stockId !== undefined && stockId.toLowerCase() !== current.stockId.toLowerCase();
      if (moving || status === true) await this.requireActiveStock(tx, stockId ?? current.stockId);
      if (status === false) {
        const occupied = await tx.$queryRaw<{ serialNumberId: string }[]>(Prisma.sql`
          ${serialsOnShelf(shelfId)} SELECT TOP (1) serialNumberId FROM CurrentSerials`);
        if (occupied.length) throw new BadRequestException('Cannot deactivate a shelf containing serialized items');
      }
      return update(tx);
    });
  }

  getShelfById(shelfId: string) {
    return this.prisma.shelf.findUniqueOrThrow({ where: { shelfId }, select: shelfSelect }).catch(dbError);
  }

  getAllShelves(pagination: PaginationDTO) {
    return this.list({}, pagination);
  }

  async searchShelves(dto: SearchShelfDTO, pagination: PaginationDTO) {
    const { shelfName, stockId, status } = parse(searchShelfSchema, dto ?? {});
    const where: Prisma.ShelfWhereInput = {};
    if (shelfName) where.shelfName = { contains: shelfName };
    if (stockId) where.stockId = stockId;
    if (status !== undefined) where.status = status;
    return this.list(where, pagination);
  }

  async getShelfByName(name: string, pagination: PaginationDTO) {
    name = name.trim();
    if (!name) throw new BadRequestException('Shelf name is required');
    return this.searchShelves({ shelfName: name }, pagination);
  }

  deleteShelf(shelfId: string) {
    // Requires ENABLED, TRUSTED SQL Server NO ACTION FKs from both movement
    // shelf columns and InventoryUnit.shelfId. Run shelf-db-preflight.sql first.
    return this.prisma.shelf.delete({ where: { shelfId }, select: shelfSelect }).catch(dbError);
  }

  async getShelfSerialNumbers(shelfId: string, pagination: PaginationDTO) {
    const { page, limit, skip } = pageArgs(pagination);
    const cte = serialsOnShelf(shelfId);
    const [rows, totals] = await Promise.all([
      this.prisma.$queryRaw<SerialRow[]>(Prisma.sql`
        ${cte}
        SELECT sn.serialNumberId, sn.serialNumberCode, sn.serialNumberStatus,
               sn.equipmentId, e.equipmentName, e.equipmentStatus
        FROM CurrentSerials c
        JOIN dbo.SerialNumber sn ON sn.serialNumberId = c.serialNumberId
        JOIN dbo.Equipment e ON e.equipmentId = sn.equipmentId
        ORDER BY sn.serialNumberCode, sn.serialNumberId
        OFFSET ${skip} ROWS FETCH NEXT ${limit} ROWS ONLY`),
      this.prisma.$queryRaw<{ total: bigint }[]>(Prisma.sql`
        ${cte}
        SELECT (SELECT COUNT_BIG(*) FROM CurrentSerials c
          JOIN dbo.SerialNumber sn ON sn.serialNumberId = c.serialNumberId
          JOIN dbo.Equipment e ON e.equipmentId = sn.equipmentId) AS total
        FROM dbo.Shelf WHERE shelfId = CAST(${shelfId} AS uniqueidentifier)`),
    ]).catch(dbError);
    if (!totals[0]) throw new NotFoundException('Shelf not found');
    const totalSerialNumbers = Number(totals[0].total);
    if (!Number.isSafeInteger(totalSerialNumbers)) throw new RangeError('Serial count exceeds the safe integer range');
    return {
      serialNumbers: rows.map(({ equipmentName, equipmentStatus, ...serial }) => ({
        ...serial, shelfId,
        equipment: { equipmentId: serial.equipmentId, equipmentName, equipmentStatus },
      })),
      totalSerialNumbers, totalPages: Math.max(1, Math.ceil(totalSerialNumbers / limit)),
      currentPage: page, limit,
    };
  }

  async getShelfEquipments(shelfId: string, pagination: PaginationDTO) {
    const { page, limit, skip } = pageArgs(pagination);
    const [rows, totals] = await Promise.all([
      this.prisma.$queryRaw<Array<{
        equipmentId: string;
        quantity: bigint | number;
        equipmentName: string;
        hasSerialNumber: boolean;
        equipmentStatus: string;
      }>>(Prisma.sql`
        WITH ShelfEquipmentStock AS (
          SELECT 
            m.equipmentId,
            SUM(CASE WHEN m.destinationShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) -
            SUM(CASE WHEN m.sourceShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) AS quantity
          FROM dbo.MovementEquipment m
          WHERE m.destinationShelfId = CAST(${shelfId} AS uniqueidentifier) OR m.sourceShelfId = CAST(${shelfId} AS uniqueidentifier)
          GROUP BY m.equipmentId
          HAVING SUM(CASE WHEN m.destinationShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) -
                 SUM(CASE WHEN m.sourceShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) > 0
        )
        SELECT 
          s.equipmentId,
          s.quantity,
          e.equipmentName,
          e.hasSerialNumber,
          e.equipmentStatus
        FROM ShelfEquipmentStock s
        JOIN dbo.Equipment e ON e.equipmentId = s.equipmentId
        ORDER BY e.equipmentName ASC, s.equipmentId ASC
        OFFSET ${skip} ROWS FETCH NEXT ${limit} ROWS ONLY`),
      this.prisma.$queryRaw<Array<{ total: bigint | number; totalQuantity: bigint | number }>>(Prisma.sql`
        WITH ShelfEquipmentStock AS (
          SELECT 
            m.equipmentId,
            SUM(CASE WHEN m.destinationShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) -
            SUM(CASE WHEN m.sourceShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) AS quantity
          FROM dbo.MovementEquipment m
          WHERE m.destinationShelfId = CAST(${shelfId} AS uniqueidentifier) OR m.sourceShelfId = CAST(${shelfId} AS uniqueidentifier)
          GROUP BY m.equipmentId
          HAVING SUM(CASE WHEN m.destinationShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) -
                 SUM(CASE WHEN m.sourceShelfId = CAST(${shelfId} AS uniqueidentifier) THEN m.equipmentQuantity ELSE 0 END) > 0
        )
        SELECT 
          (SELECT COUNT_BIG(*) FROM ShelfEquipmentStock) AS total,
          (SELECT COALESCE(SUM(CONVERT(bigint, quantity)), 0) FROM ShelfEquipmentStock) AS totalQuantity
        FROM dbo.Shelf WHERE shelfId = CAST(${shelfId} AS uniqueidentifier)`),
    ]).catch(dbError);

    if (!totals[0]) throw new NotFoundException('Shelf not found');
    const totalEquipments = Number(totals[0].total);
    const totalQuantity = Number(totals[0].totalQuantity);
    if (!Number.isSafeInteger(totalEquipments)) throw new RangeError('Equipment count exceeds the safe integer range');

    const serializedIds = rows.filter(r => r.hasSerialNumber).map(r => r.equipmentId);
    const serialsMap = new Map<string, Array<{ serialNumberId: string; serialNumberCode: string; serialNumberStatus: string }>>();

    if (serializedIds.length > 0) {
      const serialRows = await this.prisma.$queryRaw<Array<{
        serialNumberId: string;
        serialNumberCode: string;
        serialNumberStatus: string;
        equipmentId: string;
      }>>(Prisma.sql`
        ${serialsOnShelf(shelfId)}
        SELECT sn.serialNumberId, sn.serialNumberCode, sn.serialNumberStatus, sn.equipmentId
        FROM CurrentSerials c
        JOIN dbo.SerialNumber sn ON sn.serialNumberId = c.serialNumberId
        WHERE sn.equipmentId IN (${Prisma.join(serializedIds.map(id => Prisma.sql`CAST(${id} AS uniqueidentifier)`))})
        ORDER BY sn.serialNumberCode ASC
      `).catch(dbError);

      for (const s of serialRows) {
        const list = serialsMap.get(s.equipmentId) ?? [];
        list.push({
          serialNumberId: s.serialNumberId,
          serialNumberCode: s.serialNumberCode,
          serialNumberStatus: s.serialNumberStatus,
        });
        serialsMap.set(s.equipmentId, list);
      }
    }

    return {
      equipments: rows.map(r => ({
        equipmentId: r.equipmentId,
        equipmentName: r.equipmentName,
        hasSerialNumber: Boolean(r.hasSerialNumber),
        equipmentStatus: r.equipmentStatus,
        quantity: Number(r.quantity),
        serials: serialsMap.get(r.equipmentId) ?? [],
      })),
      totalEquipments,
      totalQuantity,
      totalPages: Math.max(1, Math.ceil(totalEquipments / limit)),
      currentPage: page,
      limit,
    };
  }

  private async list(where: Prisma.ShelfWhereInput, pagination: PaginationDTO) {
    const { page, limit, skip } = pageArgs(pagination);
    const [shelves, totalShelves] = await Promise.all([
      this.prisma.shelf.findMany({ where, skip, take: limit, select: shelfSelect, orderBy: shelfOrder }),
      this.prisma.shelf.count({ where }),
    ]).catch(dbError);
    return { shelves, totalShelves, totalPages: Math.max(1, Math.ceil(totalShelves / limit)), currentPage: page, limit };
  }

  private async requireActiveStock(tx: Prisma.TransactionClient, stockId: string) {
    const stock = await tx.stock.findUnique({ where: { stockId }, select: { status: true } });
    if (!stock) throw new NotFoundException('Stock not found');
    if (!stock.status) throw new BadRequestException('An inactive stock cannot receive or activate shelves');
  }

  private async write<T>(operation: (tx: Prisma.TransactionClient) => Promise<T>): Promise<T> {
    for (let attempt = 0; ; attempt++) {
      try {
        return await this.prisma.$transaction(operation, { isolationLevel: Prisma.TransactionIsolationLevel.Serializable });
      } catch (error) {
        if (!(error instanceof Prisma.PrismaClientKnownRequestError) || error.code !== 'P2034' || attempt >= 2) {
          return dbError(error);
        }
        await delay(20 * 2 ** attempt + Math.floor(Math.random() * 20));
      }
    }
  }
}
</file>

<file path="frontend/src/components/shelf/CreateShelfModal.tsx">
'use client';

import { useEffect, useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AlertCircle, Info, Layers, Loader2, Plus, Warehouse, X } from 'lucide-react';

import { createShelfSchema, type CreateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import type { Stock } from '@/types/stock';
import { getErrorMessage } from '@/lib/error-message';

interface CreateShelfModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function CreateShelfModal({ isOpen, onClose, onSuccess }: CreateShelfModalProps) {
  const api = useApi();
  const { createShelf, isCreating } = useShelves({ enabled: false });
  const { canCreateShelf } = usePermissions();
  const [stocks, setStocks] = useState<Stock[]>([]);
  const [loadingStocks, setLoadingStocks] = useState(false);
  const [serverError, setServerError] = useState<string | null>(null);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<CreateShelfFormValues>({
    resolver: zodResolver(createShelfSchema),
    defaultValues: { shelfName: '', stockId: '', status: true },
  });

  useEffect(() => {
    if (!isOpen) return;
    let active = true;
    setLoadingStocks(true);
    setServerError(null);

    StockService.getActiveStocks(api, { page: 1, limit: 100 })
      .then((result) => {
        if (active) setStocks(result.stocks);
      })
      .catch((cause: unknown) => {
        if (!active) return;
        setStocks([]);
        setServerError(
          getErrorMessage(cause, 'Impossible de charger les stocks actifs.'),
        );
      })
      .finally(() => {
        if (active) setLoadingStocks(false);
      });

    return () => {
      active = false;
    };
  }, [api, isOpen]);

  useEffect(() => {
    if (!isOpen) reset({ shelfName: '', stockId: '', status: true });
  }, [isOpen, reset]);

  if (!isOpen) return null;

  const busy = isCreating || isSubmitting;

  async function submit(values: CreateShelfFormValues) {
    setServerError(null);
    if (!canCreateShelf) {
      setServerError("Permission 'shelf.create' requise.");
      return;
    }

    try {
      await createShelf({
        shelfName: values.shelfName.trim(),
        stockId: values.stockId,
        status: values.status,
      });
      reset({ shelfName: '', stockId: '', status: true });
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setServerError(
        getErrorMessage(cause, 'Échec de la création de l’emplacement.'),
      );
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-lg overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-5 py-4">
          <h2 className="flex items-center gap-2 text-sm font-semibold">
            <Layers className="h-4 w-4" />
            Nouvel emplacement
          </h2>
          <button type="button" onClick={onClose} disabled={busy} className="rounded p-1.5 text-white/60 hover:bg-white/10 hover:text-white">
            <X className="h-4 w-4" />
          </button>
        </header>

        <form onSubmit={handleSubmit(submit)} className="space-y-4 p-5">
          {serverError && (
            <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/40 p-3 text-xs text-rose-200">
              <AlertCircle className="h-4 w-4 shrink-0" />
              {serverError}
            </div>
          )}

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Nom de l’emplacement *</span>
            <input
              {...register('shelfName')}
              placeholder="Ex: Rayon A-01"
              className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50"
            />
            {errors.shelfName && <p className="text-[11px] text-rose-300">{errors.shelfName.message}</p>}
          </label>

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Statut de l'emplacement</span>
            <select
              {...register('status', {
                setValueAs: (v) => v === true || v === 'true',
              })}
              disabled={busy}
              className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50"
            >
              <option value="true">Actif (ACTIVE)</option>
              <option value="false">Inactif (INACTIVE)</option>
            </select>
            {errors.status && <p className="text-[11px] text-rose-300">{errors.status.message}</p>}
          </label>

          <label className="block space-y-1.5">
            <span className="flex items-center gap-1.5 text-xs font-semibold">
              <Warehouse className="h-3.5 w-3.5" />
              Stock actif *
            </span>
            <select
              {...register('stockId')}
              disabled={busy || loadingStocks}
              className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50"
            >
              <option value="">Sélectionnez un stock actif</option>
              {stocks.map((stock) => (
                <option key={stock.stockId} value={stock.stockId}>
                  {stock.stockName ?? 'Stock sans nom'}
                </option>
              ))}
            </select>
            {errors.stockId && <p className="text-[11px] text-rose-300">{errors.stockId.message}</p>}
          </label>

          {!loadingStocks && stocks.length === 0 && (
            <div className="rounded-lg border border-amber-400/25 bg-amber-400/10 p-3 text-[11px] text-amber-100">
              Aucun stock ACTIVE n’est disponible. Activez ou créez un stock avant de créer un emplacement.
            </div>
          )}

          <div className="flex gap-2 rounded-lg border border-sky-400/20 bg-sky-400/5 p-3 text-[11px] text-sky-100">
            <Info className="mt-0.5 h-4 w-4 shrink-0" />
            <p>Un emplacement doit toujours appartenir à un stock ACTIVE.</p>
          </div>

          <footer className="flex justify-end gap-2 border-t border-[#3f3f46] pt-4">
            <button type="button" onClick={onClose} disabled={busy} className="rounded border border-[#3f3f46] px-4 py-2 text-xs">Annuler</button>
            <button
              type="submit"
              disabled={busy || !canCreateShelf || stocks.length === 0}
              className="inline-flex items-center gap-1.5 rounded bg-[#fafafa] px-4 py-2 text-xs font-semibold text-[#18181b] disabled:opacity-40"
            >
              {busy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Plus className="h-3.5 w-3.5" />}
              Créer
            </button>
          </footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/shelf/UpdateShelfModal.tsx">
'use client';

import { useEffect, useMemo, useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { AlertCircle, Edit3, Info, Loader2, Warehouse, X } from 'lucide-react';

import type { Shelf } from '@/types/shelf';
import type { Stock } from '@/types/stock';
import { updateShelfSchema, type UpdateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import { getErrorMessage } from '@/lib/error-message';

interface UpdateShelfModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateShelfModal(props: UpdateShelfModalProps) {
  if (!props.isOpen || !props.shelf) return null;
  return <UpdateShelfContent key={`${props.shelf.shelfId}:${props.shelf.stockId}`} {...props} />;
}

function UpdateShelfContent({ shelf, onClose, onSuccess }: UpdateShelfModalProps) {
  const api = useApi();
  const { updateShelf, isUpdating } = useShelves({ enabled: false });
  const { canUpdateShelf } = usePermissions();
  const [activeStocks, setActiveStocks] = useState<Stock[]>([]);
  const [loadingStocks, setLoadingStocks] = useState(false);
  const [serverError, setServerError] = useState<string | null>(null);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<UpdateShelfFormValues>({
    resolver: zodResolver(updateShelfSchema),
    defaultValues: {
      shelfName: shelf?.shelfName ?? '',
      stockId: shelf?.stockId ?? '',
      status: shelf?.status !== false,
    },
  });

  useEffect(() => {
    if (!shelf) return;
    reset({ shelfName: shelf.shelfName ?? '', stockId: shelf.stockId, status: shelf.status !== false ? true : false });
  }, [shelf, reset]);

  useEffect(() => {
    let active = true;
    setLoadingStocks(true);
    StockService.getActiveStocks(api, { page: 1, limit: 100 })
      .then((result) => {
        if (active) setActiveStocks(result.stocks);
      })
      .catch((cause: unknown) => {
        if (active) setServerError(getErrorMessage(cause, 'Impossible de charger les stocks actifs.'));
      })
      .finally(() => {
        if (active) setLoadingStocks(false);
      });
    return () => {
      active = false;
    };
  }, [api]);

  const stockOptions = useMemo(() => {
    if (!shelf) return activeStocks;
    if (activeStocks.some((stock) => stock.stockId === shelf.stockId)) return activeStocks;
    const current: Stock = {
      stockId: shelf.stockId,
      stockName: shelf.stock?.stockName ?? 'Stock actuel',
      status: false,
    };
    return [current, ...activeStocks];
  }, [activeStocks, shelf]);

  if (!shelf) return null;
  const currentShelf = shelf;
  const busy = isUpdating || isSubmitting;

  async function submit(values: UpdateShelfFormValues) {
    setServerError(null);
    if (!canUpdateShelf) {
      setServerError("Permission 'shelf.update' requise.");
      return;
    }

    const data: { shelfName?: string; stockId?: string; status?: boolean } = {};
    const nextName = values.shelfName?.trim();
    if (nextName && nextName !== (currentShelf.shelfName ?? '')) data.shelfName = nextName;
    if (values.stockId && values.stockId !== currentShelf.stockId) data.stockId = values.stockId;
    if (values.status && values.status !== (currentShelf.status !== false ? true : false)) data.status = values.status;

    if (data.shelfName === undefined && data.stockId === undefined && data.status === undefined) {
      onClose();
      return;
    }

    try {
      await updateShelf({ id: currentShelf.shelfId, data });
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setServerError(getErrorMessage(cause, 'Échec de la modification de l’emplacement.'));
    }
  }

  return (
    <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-lg overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-5 py-4">
          <h2 className="flex items-center gap-2 text-sm font-semibold"><Edit3 className="h-4 w-4" />Modifier l’emplacement</h2>
          <button type="button" onClick={onClose} disabled={busy} className="rounded p-1.5 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
        </header>

        <form onSubmit={handleSubmit(submit)} className="space-y-4 p-5">
          {serverError && <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/40 p-3 text-xs text-rose-200"><AlertCircle className="h-4 w-4 shrink-0" />{serverError}</div>}

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Nom</span>
            <input {...register('shelfName')} className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50" />
            {errors.shelfName && <p className="text-[11px] text-rose-300">{errors.shelfName.message}</p>}
          </label>

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">Statut de l'emplacement</span>
            <select {...register('status', { setValueAs: (v) => v === true || v === 'true' })} disabled={busy} className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs outline-none focus:border-white/50">
              <option value="true">Actif (ACTIVE)</option>
              <option value="false">Inactif (INACTIVE)</option>
            </select>
            {errors.status && <p className="text-[11px] text-rose-300">{errors.status.message}</p>}
          </label>

          <label className="block space-y-1.5">
            <span className="flex items-center gap-1.5 text-xs font-semibold"><Warehouse className="h-3.5 w-3.5" />Stock</span>
            <select {...register('stockId')} disabled={busy || loadingStocks} className="h-10 w-full rounded-lg border border-[#3f3f46] bg-[#18181b] px-3 text-xs">
              {stockOptions.map((stock) => {
                const inactive = stock.status === false;
                return (
                  <option key={stock.stockId} value={stock.stockId} disabled={inactive && stock.stockId !== currentShelf.stockId}>
                    {stock.stockName ?? 'Stock sans nom'}{inactive ? ' — INACTIVE (actuel)' : ''}
                  </option>
                );
              })}
            </select>
            {errors.stockId && <p className="text-[11px] text-rose-300">{errors.stockId.message}</p>}
          </label>

          <div className="flex gap-2 rounded-lg border border-sky-400/20 bg-sky-400/5 p-3 text-[11px] text-sky-100">
            <Info className="mt-0.5 h-4 w-4 shrink-0" />
            <p>Seuls les stocks ACTIVE peuvent être choisis comme nouvelle destination.</p>
          </div>

          <footer className="flex justify-end gap-2 border-t border-[#3f3f46] pt-4">
            <button type="button" onClick={onClose} disabled={busy} className="rounded border border-[#3f3f46] px-4 py-2 text-xs">Annuler</button>
            <button type="submit" disabled={busy || !canUpdateShelf} className="inline-flex items-center gap-1.5 rounded bg-[#fafafa] px-4 py-2 text-xs font-semibold text-[#18181b] disabled:opacity-40">
              {busy && <Loader2 className="h-3.5 w-3.5 animate-spin" />}Enregistrer
            </button>
          </footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="backend/src/equipment/equipment.service.ts">
import {
  BadRequestException,
  ConflictException,
  Injectable,
  NotFoundException,
  ServiceUnavailableException,
} from '@nestjs/common';
import { ZodError } from 'zod';
import { setTimeout as delay } from 'node:timers/promises';
import { Prisma } from '../generated/prisma/client.js';
import { PrismaService } from '../prisma/prisma.service.js';
import {
  type CreateEquipmentDTO, createEquipmentSchema,
  type UpdateEquipmentDTO, updateEquipmentSchema,
  type SearchEquipmentDTO, searchEquipmentSchema,
  type PaginationDTO, paginationSchema,
} from './dto/index.js';

import { equipmentUuidSchema } from './dto/equipment-validation.js';
import {
  buildEquipmentBalancesQuery, buildShelfMatchesCte,
  safeDatabaseInteger, summarizeEquipmentStock, type ShelfBalanceRow,
} from './equipment-stock.js';

const EQUIPMENT_SELECT = {
  equipmentId: true,
  equipmentName: true,
  hasSerialNumber: true,
  minequipmentQuantity: true,
  equipmentStatus: true,
} satisfies Prisma.EquipmentSelect;

const EQUIPMENT_LIST_SELECT = {
  ...EQUIPMENT_SELECT,
  _count: { select: { serialNumbers: true } },
} satisfies Prisma.EquipmentSelect;

type EquipmentWithCount = Prisma.EquipmentGetPayload<{
  select: typeof EQUIPMENT_LIST_SELECT;
}>;
type EquipmentUpdate = ReturnType<typeof updateEquipmentSchema.parse>;
const SERIAL_BATCH_SIZE = 200;
const NON_LOCKING_INVENTORY_STATUSES = ['DRAFT', 'FINALIZED', 'CANCELLED'];
const EQUIPMENT_ORDER = [
  { equipmentName: 'asc' }, { equipmentId: 'asc' },
] satisfies Prisma.EquipmentOrderByWithRelationInput[];

@Injectable()
export class EquipmentService {
  constructor(private readonly prisma: PrismaService) { }

  async createEquipment(dto: CreateEquipmentDTO) {
    return this.operation(async () => {
      const data = createEquipmentSchema.parse(dto);
      await this.assertEquipmentNameAvailable(this.prisma, data.equipmentName);
      return this.prisma.equipment.create({
        data: {
          equipmentName: data.equipmentName,
          hasSerialNumber: data.hasSerialNumber,
          minequipmentQuantity: data.minEquipmentQuantity,
          equipmentStatus: data.equipmentStatus ? 'ACTIVE' : 'INACTIVE',
        },
        select: EQUIPMENT_SELECT,
      });
    });
  }

  async getAllEquipments(query?: PaginationDTO) {
    return this.operation(async () => this.listEquipments({}, paginationSchema.parse(query ?? {})));
  }

  async searchEquipments(query: SearchEquipmentDTO = {}, pagination?: PaginationDTO) {
    return this.operation(async () => {
      const filters = searchEquipmentSchema.parse(query ?? {});
      // The controller passes the query twice; direct callers may pass it once.
      const page = paginationSchema.parse(pagination ?? query ?? {});
      return this.listEquipments(filters, page);
    });
  }

  async getEquipmentById(id: string) {
    return this.operation(async () => {
      const equipmentId = this.parseEquipmentId(id);
      return this.transaction(async (tx) => {
        const equipment = await this.getEquipmentOrThrow(tx, equipmentId);
        const rows = await this.loadBalances(tx, [equipmentId]);
        return this.mapEquipment(equipment, rows);
      });
    });
  }

  async getEquipmentShelves(id: string) {
    // Exactly the same calculation and consistency diagnostics as list/detail.
    return this.getEquipmentById(id);
  }

  async updateEquipment(id: string, dto: UpdateEquipmentDTO) {
    return this.operation(async () => {
      const equipmentId = this.parseEquipmentId(id);
      const data = updateEquipmentSchema.parse(dto);
      return this.transaction(async (tx) => {
        // Same namespace and deterministic lock order as the movement service.
        // Locks MUST precede the reads used to make mutation decisions.
        await this.acquireLocks(tx, [
          `SOMIPHARM:EQUIPMENT:${equipmentId}`,
          ...(data.conversionSerials ?? []).map((item) => `SOMIPHARM:SHELF:${item.shelfId}`),
        ]);
        const current = await this.getEquipmentOrThrow(tx, equipmentId);
        if (current.hasSerialNumber && data.hasSerialNumber === false) {
          throw new BadRequestException('Serialized equipment cannot be converted back to standard equipment');
        }
        const converting = !current.hasSerialNumber && data.hasSerialNumber === true;
        if (!converting && data.conversionSerials !== undefined) {
          throw new BadRequestException('conversionSerials are only valid during Standard -> Serialized conversion');
        }
        if (data.equipmentName !== undefined && data.equipmentName !== current.equipmentName) {
          await this.assertEquipmentNameAvailable(tx, data.equipmentName, equipmentId);
        }
        if (converting) return this.convertStandardToSerialized(tx, current, data);
        return tx.equipment.update({
          where: { equipmentId }, data: this.metadataUpdate(data), select: EQUIPMENT_SELECT,
        });
      });
    });
  }

  async deleteEquipment(id: string) {
    return this.operation(async () => {
      const equipmentId = this.parseEquipmentId(id);
      return this.transaction(async (tx) => {
        await this.acquireLocks(tx, [`SOMIPHARM:EQUIPMENT:${equipmentId}`]);
        const equipment = await tx.equipment.findUnique({
          where: { equipmentId },
          select: {
            ...EQUIPMENT_SELECT,
            _count: {
              select: {
                movementItems: true, serialNumbers: true, inventoryUnits: true,
              }
            },
          },
        });
        if (!equipment) throw new NotFoundException(`Equipment with ID '${equipmentId}' not found`);
        if (equipment._count.movementItems) {
          throw new ConflictException('This equipment has movement history and cannot be physically deleted; mark it INACTIVE instead');
        }
        const rows = await this.loadBalances(tx, [equipmentId]);
        const stock = summarizeEquipmentStock(equipment, rows);
        if (stock.equipmentQuantity !== 0) {
          throw new ConflictException('Equipment with non-zero stock cannot be physically deleted');
        }
        if (equipment._count.serialNumbers) {
          throw new ConflictException('Equipment has serial identities (including inactive ones); mark it INACTIVE instead');
        }
        if (equipment._count.inventoryUnits) {
          throw new ConflictException('Equipment is referenced by inventory records and cannot be physically deleted');
        }
        // These schema fields are logical references, not Equipment relations.
        // Do not rely solely on FK errors or remove historical child records.
        const workUnit = await tx.inventoryUnit.findFirst({
          where: { equipmentId }, select: { unitId: true },
        });

        const scopes = await tx.$queryRaw<Array<{ inventoryId: string }>>`
          SELECT TOP (1) [inventoryId] FROM [dbo].[Inventory]
          WHERE CHARINDEX(${equipmentId}, LOWER([equipmentScopeIds])) > 0
        `;
        if (workUnit || scopes.length > 0) {
          throw new ConflictException('Equipment is referenced by inventory history or scope and cannot be physically deleted');
        }
        return tx.equipment.delete({ where: { equipmentId }, select: EQUIPMENT_SELECT });
      });
    });
  }

  async getSerialNumbersByEquipmentId(id: string, pagination?: PaginationDTO) {
    return this.operation(async () => {
      const equipmentId = this.parseEquipmentId(id);
      const { page, limit } = paginationSchema.parse(pagination ?? {});
      return this.transaction(async (tx) => {
        const equipment = await this.getEquipmentOrThrow(tx, equipmentId);
        if (!equipment.hasSerialNumber && equipment._count.serialNumbers > 0) {
          throw new ConflictException('Standard equipment unexpectedly has serial identities; reconcile the data first');
        }
        const totalSerialNumbers = equipment._count.serialNumbers;
        const serialNumbers = !equipment.hasSerialNumber ? [] : await tx.serialNumber.findMany({
          where: { equipmentId }, skip: (page - 1) * limit, take: limit,
          select: {
            serialNumberId: true, serialNumberCode: true, serialNumberStatus: true,
            equipmentId: true,
            movementItems: { select: { destinationShelf: { select: { shelfId: true, shelfName: true, stockId: true } } }, orderBy: { movementEquipmentId: 'desc' }, take: 1 },
          },
          orderBy: [{ serialNumberCode: 'asc' }, { serialNumberId: 'asc' }],
        });
        return {
          serialNumbers, totalSerialNumbers,
          totalPages: Math.max(1, Math.ceil(totalSerialNumbers / limit)), currentPage: page, limit
        };
      });
    });
  }

  private async listEquipments(
    filters: SearchEquipmentDTO,
    { page, limit }: ReturnType<typeof paginationSchema.parse>,
  ) {
    return this.transaction(async (tx) => {
      const skip = (page - 1) * limit;
      const shelfId = filters.shelfId ?? filters.equipmentShelfId;
      let equipments: EquipmentWithCount[];
      let totalEquipments: number;
      if (shelfId) {
        const cte = buildShelfMatchesCte(shelfId, filters);
        const countRows = await tx.$queryRaw<Array<{ total: bigint | number }>>(
          Prisma.sql`${cte} SELECT COUNT_BIG(*) AS total FROM Matches`,
        );
        totalEquipments = safeDatabaseInteger(countRows[0]?.total ?? 0, 'Equipment count');
        const ids = await tx.$queryRaw<Array<{ equipmentId: string }>>(
          Prisma.sql`${cte} SELECT [equipmentId] FROM Matches
            ORDER BY [equipmentName] ASC, [equipmentId] ASC
            OFFSET ${skip} ROWS FETCH NEXT ${limit} ROWS ONLY`,
        );
        equipments = ids.length === 0 ? [] : await tx.equipment.findMany({
          where: { equipmentId: { in: ids.map((row) => row.equipmentId) } },
          select: EQUIPMENT_LIST_SELECT, orderBy: EQUIPMENT_ORDER,
        });
      } else {
        const where: Prisma.EquipmentWhereInput = {};
        if (filters.equipmentName) where.equipmentName = { contains: filters.equipmentName };
        if (filters.hasSerialNumber !== undefined) where.hasSerialNumber = filters.hasSerialNumber;
        if (filters.equipmentStatus !== undefined) where.equipmentStatus = filters.equipmentStatus ? 'ACTIVE' : 'INACTIVE';
        if (filters.minEquipmentQuantity !== undefined) where.minequipmentQuantity = filters.minEquipmentQuantity;
        totalEquipments = await tx.equipment.count({ where });
        equipments = await tx.equipment.findMany({
          where, skip, take: limit, select: EQUIPMENT_LIST_SELECT, orderBy: EQUIPMENT_ORDER,
        });
      }
      const balances = await this.loadBalances(tx, equipments.map((item) => item.equipmentId));
      return {
        equipments: equipments.map((item) => this.mapEquipment(item, balances)),
        totalEquipments, totalPages: Math.max(1, Math.ceil(totalEquipments / limit)),
        currentPage: page, limit,
      };
    });
  }

  private mapEquipment(equipment: EquipmentWithCount, rows: ShelfBalanceRow[]) {
    const stock = summarizeEquipmentStock(equipment, rows);
    return {
      ...equipment, ...stock,
      _count: { ...equipment._count, equipmentShelfs: stock.shelvesCount }
    };
  }

  private async loadBalances(tx: Prisma.TransactionClient, equipmentIds: string[]): Promise<ShelfBalanceRow[]> {
    if (equipmentIds.length === 0) return [];
    return tx.$queryRaw<ShelfBalanceRow[]>(buildEquipmentBalancesQuery(equipmentIds));
  }

  private async getEquipmentOrThrow(tx: Prisma.TransactionClient, equipmentId: string) {
    const equipment = await tx.equipment.findUnique({
      where: { equipmentId }, select: EQUIPMENT_LIST_SELECT,
    });
    if (!equipment) throw new NotFoundException(`Equipment with ID '${equipmentId}' not found`);
    return equipment;
  }

  private async assertEquipmentNameAvailable(
    tx: Prisma.TransactionClient, equipmentName: string, excludeEquipmentId?: string,
  ): Promise<void> {
    const existing = await tx.equipment.findFirst({
      where: { equipmentName, ...(excludeEquipmentId ? { equipmentId: { not: excludeEquipmentId } } : {}) },
      select: { equipmentId: true },
    });
    if (existing) throw new ConflictException(`Equipment '${equipmentName}' already exists`);
    // The unique DB constraint is still authoritative for concurrent requests.
  }

  private metadataUpdate(data: EquipmentUpdate): Prisma.EquipmentUpdateInput {
    return {
      ...(data.equipmentName !== undefined && { equipmentName: data.equipmentName }),
      ...(data.minEquipmentQuantity !== undefined && { minequipmentQuantity: data.minEquipmentQuantity }),
      ...(data.equipmentStatus !== undefined && { equipmentStatus: data.equipmentStatus ? 'ACTIVE' : 'INACTIVE' }),
    };
  }

  private async convertStandardToSerialized(
    tx: Prisma.TransactionClient, current: EquipmentWithCount, data: EquipmentUpdate,
  ) {
    if (current._count.serialNumbers !== 0) {
      throw new ConflictException('Standard equipment already has serial records and cannot be converted safely');
    }
    const rows = await this.loadBalances(tx, [current.equipmentId]);
    const stock = summarizeEquipmentStock(current, rows);
    // Also check zero-stock equipment: positive/negative balances must not be hidden.
    if (!stock.stockIsConsistent) {
      throw new ConflictException('Equipment physical quantity and movement-derived shelf balances are inconsistent; conversion is blocked');
    }
    const serials = data.conversionSerials ?? [];
    if (serials.length !== stock.equipmentQuantity) {
      throw new BadRequestException(`Conversion requires exactly ${stock.equipmentQuantity} serial codes mapped to the current shelves`);
    }
    const codes = serials.map((item) => item.serialNumberCode);
    if (new Set(codes).size !== codes.length) {
      throw new BadRequestException('Duplicate serial number codes exist in the conversion request');
    }
    const expected = new Map(stock.equipmentShelfs.map((item) => [item.shelfId, item.equipmentQuantity]));
    const provided = new Map<string, number>();
    for (const item of serials) {
      if (!expected.has(item.shelfId)) {
        throw new BadRequestException(`Shelf '${item.shelfId}' does not contain this equipment`);
      }
      provided.set(item.shelfId, (provided.get(item.shelfId) ?? 0) + 1);
    }
    for (const [shelfId, quantity] of expected) {
      if (provided.get(shelfId) !== quantity) {
        throw new BadRequestException(`Serial mapping count does not match physical quantity on shelf '${shelfId}'`);
      }
    }

    const shelfIds = [...expected.keys()];
    // Match the stock-freeze policy already used by EquipmentMovementService.
    for (let offset = 0; offset < Math.max(1, shelfIds.length); offset += SERIAL_BATCH_SIZE) {
      const ids = shelfIds.slice(offset, offset + SERIAL_BATCH_SIZE);
      const inventoryConflict = await tx.inventoryUnit.findFirst({
        where: {
          OR: [{ equipmentId: current.equipmentId },
          ...(ids.length ? [{ shelfId: { in: ids } }] : [])],
          inventory: { status: { notIn: NON_LOCKING_INVENTORY_STATUSES } },
        },
        select: { unitId: true },
      });
      if (inventoryConflict) {
        throw new ConflictException('Conversion is blocked while this equipment or its shelves are controlled by an active inventory');
      }
    }

    // Chunk queries and writes to avoid a single large SQL Server parameter list.
    for (let offset = 0; offset < shelfIds.length; offset += SERIAL_BATCH_SIZE) {
      const ids = shelfIds.slice(offset, offset + SERIAL_BATCH_SIZE);
      const shelves = await tx.shelf.findMany({
        where: { shelfId: { in: ids } },
        select: { shelfId: true, status: true, stock: { select: { status: true } } },
      });
      if (shelves.length !== ids.length || shelves.some((shelf) => !shelf.status || !shelf.stock.status)) {
        throw new ConflictException('Conversion requires existing active shelves in active stocks');
      }
    }
    for (let offset = 0; offset < codes.length; offset += SERIAL_BATCH_SIZE) {
      const existing = await tx.serialNumber.findMany({
        where: { serialNumberCode: { in: codes.slice(offset, offset + SERIAL_BATCH_SIZE) } },
        select: { serialNumberCode: true },
      });
      if (existing.length > 0) {
        throw new ConflictException('One or more conversion serial number codes already exist');
      }
    }

    // IMPORTANT: the SerialNumber guard requires hasSerialNumber=true at INSERT.
    // Both this update and every insert are in the SAME transaction. Any failure
    // rolls back the flag, metadata and all prior batches. No new IN movement:
    // these units are already in stock, and quantity must not be incremented.
    const updated = await tx.equipment.update({
      where: { equipmentId: current.equipmentId },
      data: { ...this.metadataUpdate(data), hasSerialNumber: true }, select: EQUIPMENT_SELECT,
    });
    for (let offset = 0; offset < serials.length; offset += SERIAL_BATCH_SIZE) {
      const batch = serials.slice(offset, offset + SERIAL_BATCH_SIZE);
      const result = await tx.serialNumber.createMany({
        data: batch.map((item) => ({
          equipmentId: current.equipmentId, serialNumberCode: item.serialNumberCode,
          serialNumberStatus: 'ACTIVE',
        })),
      });
      if (result.count !== batch.length) throw new ConflictException('Serial conversion was incomplete; the transaction has been cancelled');
    }
    return updated;
  }

  private parseEquipmentId(id: string): string {
    if (typeof id !== 'string' || id.trim() === '') throw new BadRequestException('Equipment ID is required');
    const parsed = equipmentUuidSchema.safeParse(id);
    if (!parsed.success) throw new BadRequestException('Equipment ID must be a valid UUID');
    return parsed.data;
  }

  private async acquireLocks(tx: Prisma.TransactionClient, resources: string[]): Promise<void> {
    for (const resource of [...new Set(resources)].sort()) {
      const rows = await tx.$queryRaw<Array<{ lockResult: number }>>`
        DECLARE @lockResult int;
        EXEC @lockResult = sys.sp_getapplock
          @Resource = ${resource}, @LockMode = 'Exclusive',
          @LockOwner = 'Transaction', @LockTimeout = 10000;
        SELECT @lockResult AS lockResult;
      `;
      // SQL Server documents only 0 (immediate) and 1 (after waiting) as success.
      if (rows[0]?.lockResult !== 0 && rows[0]?.lockResult !== 1) {
        throw new ConflictException('Equipment or shelf is busy; refresh and retry');
      }
    }
  }

  private async transaction<T>(work: (tx: Prisma.TransactionClient) => Promise<T>): Promise<T> {
    for (let attempt = 0; ; attempt++) {
      try {
        return await this.prisma.$transaction(work, {
          isolationLevel: 'Serializable', maxWait: 5_000, timeout: 30_000,
        });
      } catch (error) {
        // Retry only a documented rolled-back write conflict, not unknown or
        // ambiguous connection failures. Do not perform external side effects here.
        if (this.prismaErrorCode(error) !== 'P2034' || attempt >= 2) throw error;
        await delay(25 * 2 ** attempt);
      }
    }
  }

  private prismaErrorCode(error: unknown): string | undefined {
    if (typeof error !== 'object' || error === null || !('code' in error)) return undefined;
    return typeof error.code === 'string' ? error.code : undefined;
  }

  private async operation<T>(work: () => Promise<T>): Promise<T> {
    try {
      return await work();
    } catch (error) {
      if (error instanceof ZodError) {
        const detail = error.issues.map((issue) => `${issue.path.join('.') || 'request'}: ${issue.message}`).join('; ');
        throw new BadRequestException(`Invalid equipment request: ${detail}`);
      }
      switch (this.prismaErrorCode(error)) {
        case 'P2002': throw new ConflictException('Equipment name or serial number code already exists (database uniqueness rules apply)');
        case 'P2003': throw new ConflictException('A referenced record is missing, changed, or prevents deletion; refresh and retry, or mark equipment INACTIVE');
        case 'P2025': throw new NotFoundException('Equipment or a related record no longer exists');
        case 'P2034': throw new ConflictException('Concurrent stock changes prevented this operation; refresh and retry');
        case 'P2028': throw new ServiceUnavailableException('Database transaction could not complete; refresh the record before retrying');
        case 'P2000':
        case 'P2020': throw new BadRequestException('A value exceeds the database field limits');
        default: throw error;
      }
    }
  }
}
