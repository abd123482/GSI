<file path="frontend/src/components/equipment/EditEquipmentModal.tsx">
'use client';

import {
  useEffect,
  useMemo,
  useState,
} from 'react';
import {
  useQuery,
} from '@tanstack/react-query';
import {
  useForm,
} from 'react-hook-form';
import {
  AlertCircle,
  Barcode,
  Info,
  Pencil,
  X,
} from 'lucide-react';

import type {
  Equipment,
  UpdateEquipmentInput,
} from '@/types/equipment';

import {
  usePermissions,
} from '@/hooks/use-permissions';
import {
  useApi,
} from '@/hooks/use-api';
import {
  EquipmentService,
} from '@/services/equipment.service';
import {
  getErrorMessage,
} from '@/lib/error-message';

interface EditEquipmentModalProps {
  isOpen: boolean;
  onClose: () => void;
  equipment: Equipment | null;
  onUpdate: (
    id: string,
    values: UpdateEquipmentInput,
  ) => Promise<void>;
  isUpdating: boolean;
}

interface BasicForm {
  equipmentName: string;
  minEquipmentQuantity: number;
  equipmentStatus: boolean;
}

export function EditEquipmentModal({
  isOpen,
  onClose,
  equipment,
  onUpdate,
  isUpdating,
}: EditEquipmentModalProps) {
  const api = useApi();

  const {
    permissions,
    canUpdateEquipment,
  } = usePermissions();

  const [
    serverError,
    setServerError,
  ] =
    useState<string | null>(
      null,
    );



  const {
    register,
    handleSubmit,
    watch,
    reset,
    formState: {
      isSubmitting,
    },
  } = useForm<BasicForm>({
    defaultValues: {
      equipmentName: '',
      minEquipmentQuantity:
        0,
      equipmentStatus:
        true,
    },
  });



  useEffect(() => {
    if (!equipment) {
      return;
    }

    reset({
      equipmentName:
        equipment.equipmentName ??
        '',
      minEquipmentQuantity:
        equipment.minequipmentQuantity,
      equipmentStatus:
        equipment.equipmentStatus ??
        true,
    });

    setServerError(
      null,
    );
  }, [
    equipment,
    isOpen,
    reset,
  ]);



  if (
    !isOpen ||
    !equipment
  ) {
    return null;
  }

  const currentEquipment =
    equipment;

  const busy =
    isUpdating ||
    isSubmitting;

  async function submit(
    values: BasicForm,
  ) {
    setServerError(null);

    if (!canUpdateEquipment) {
      setServerError(
        "Permission 'equipment.update' requise.",
      );
      return;
    }



    const payload:
      UpdateEquipmentInput =
      {};

    const nextName =
      values.equipmentName.trim();

    if (
      nextName !==
      (
        currentEquipment.equipmentName ??
        ''
      )
    ) {
      payload.equipmentName =
        nextName;
    }

    if (
      values.minEquipmentQuantity !==
      currentEquipment.minequipmentQuantity
    ) {
      payload.minEquipmentQuantity =
        Number(
          values.minEquipmentQuantity,
        );
    }

    if (
      (values.equipmentStatus) !==
      currentEquipment.equipmentStatus
    ) {
      payload.equipmentStatus =
        values.equipmentStatus;
    }



    if (
      Object.keys(
        payload,
      ).length === 0
    ) {
      onClose();
      return;
    }

    try {
      await onUpdate(
        currentEquipment.equipmentId,
        payload,
      );

      onClose();
    } catch (error: unknown) {
      setServerError(
        getErrorMessage(
          error,
          'Impossible de modifier cet article.',
        ),
      );
    }
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/55 p-4 backdrop-blur-sm">
      <div className="my-8 w-full max-w-2xl overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-5 py-4">
          <div className="flex items-center gap-2.5">
            <Pencil className="h-4 w-4" />

            <div>
              <h2 className="text-sm font-semibold">
                Modifier l’article
              </h2>

            </div>
          </div>

          <button
            type="button"
            disabled={busy}
            onClick={onClose}
            className="rounded p-1.5 text-white/60 hover:bg-white/10"
          >
            <X className="h-4 w-4" />
          </button>
        </header>

        <form
          onSubmit={handleSubmit(
            submit,
          )}
          className="space-y-5 p-5"
        >
          {serverError && (
            <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/35 p-3 text-xs text-rose-200">
              <AlertCircle className="h-4 w-4 shrink-0" />
              {serverError}
            </div>
          )}

          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <label className="space-y-1.5">
              <span className="text-xs font-semibold">
                Nom
              </span>

              <input
                {...register(
                  'equipmentName',
                )}
                className="h-10 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
              />
            </label>

            <label className="space-y-1.5">
              <span className="text-xs font-semibold">
                Statut
              </span>

              <select
                {...register(
                  'equipmentStatus',
                )}
                className="h-10 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
              >
                <option value="true">
                  ACTIVE
                </option>
                <option value="false">
                  INACTIVE
                </option>
              </select>
            </label>
          </div>

          <label className="block space-y-1.5">
            <span className="text-xs font-semibold">
              Quantité minimale
            </span>

            <input
              type="number"
              min={0}
              step={1}
              {...register(
                'minEquipmentQuantity',
                {
                  valueAsNumber:
                    true,
                },
              )}
              className="h-10 w-full rounded border border-[#3f3f46] bg-[#18181b] px-3 font-mono text-xs"
            />
          </label>


          {equipment.hasSerialNumber ? (
            <div className="rounded-lg border border-[#3f3f46] bg-[#18181b]/55 p-4">
              <div className="flex items-center gap-2">
                <Barcode className="h-4 w-4" />

                <div>
                  <p className="text-xs font-semibold">
                    Article sérialisé
                  </p>
                  <p className="mt-0.5 text-[10px] text-white/45">
                    Cet article gère son stock via les numéros de série.
                  </p>
                </div>
              </div>
            </div>
          ) : (
            <div className="rounded-lg border border-[#3f3f46] bg-[#18181b]/55 p-4">
              <div className="flex items-center gap-2">
                <Barcode className="h-4 w-4" />

                <div>
                  <p className="text-xs font-semibold">
                    Article standard
                  </p>
                  <p className="mt-0.5 text-[10px] text-white/45">
                    Cet article gère son stock de manière quantitative.
                  </p>
                </div>
              </div>
            </div>
          )}

          <footer className="flex justify-end gap-2 border-t border-[#3f3f46] pt-4">
            <button
              type="button"
              disabled={busy}
              onClick={onClose}
              className="rounded border border-[#3f3f46] px-4 py-2 text-xs"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={
                busy ||
                !canUpdateEquipment
              }
              className="rounded bg-[#fafafa] px-4 py-2 text-xs font-semibold text-[#18181b] disabled:opacity-40"
            >
              {busy
                ? 'Enregistrement...'
                : 'Enregistrer'}
            </button>
          </footer>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/equipment/EquipmentDetailModal.tsx">
'use client';

import {
  useEffect,
  useState,
} from 'react';
import {
  AlertCircle,
  ArrowDownToLine,
  ArrowRightLeft,
  ArrowUpFromLine,
  Barcode,
  Loader2,
  Package,
  Pencil,
  Plus,
  Search,
  X,
} from 'lucide-react';

import type {
  Equipment,
  SerialNumber,
} from '@/types/equipment';

import type {
  Movement,
} from '@/types/movement';

import {
  useMovements,
} from '@/hooks/use-movements';

import {
  useCreateSerialNumber,
  useSerialNumbers,
} from '@/hooks/use-serial-numbers';

import { useQuery } from '@tanstack/react-query';
import { useApi } from '@/hooks/use-api';
import { EquipmentService } from '@/services/equipment.service';
import { MovementService } from '@/services/movement.service';

import {
  usePermissions,
} from '@/hooks/use-permissions';

interface EquipmentDetailModalProps {
  equipment: Equipment | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  onEditSerialNumber?: (
    serial: SerialNumber,
  ) => void;
  isLoading?: boolean;
}

function movementLabel(
  movement: Movement,
) {
  if (!movement.mouvementStatus) {
    return {
      text: 'ENTRÉE',
      icon:
        ArrowDownToLine,
    };
  }

  return {
    text: 'SORTIE',
    icon:
      ArrowUpFromLine,
  };
}

function formatDate(
  value?: string | null,
) {
  if (!value) {
    return '—';
  }

  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return value;
  }

  return new Intl.DateTimeFormat(
    'fr-DZ',
    {
      dateStyle: 'short',
      timeStyle: 'short',
    },
  ).format(date);
}

export function EquipmentDetailModal({
  equipment,
  isOpen,
  onClose,
  onRefresh,
  onEditSerialNumber,
  isLoading = false,
}: EquipmentDetailModalProps) {
  const [
    serialPage,
    setSerialPage,
  ] = useState(1);

  const [
    movementPage,
    setMovementPage,
  ] = useState(1);

  const [
    serialSearch,
    setSerialSearch,
  ] = useState('');

  const [
    newSerialCode,
    setNewSerialCode,
  ] = useState('');

  const {
    permissions,
    canCreateSerialNumber,
    canUpdateSerialNumber,
  } = usePermissions();

  const createSerial =
    useCreateSerialNumber();

  useEffect(() => {
    setSerialPage(1);
    setMovementPage(1);
    setSerialSearch('');
    setNewSerialCode('');
  }, [
    equipment?.equipmentId,
    isOpen,
  ]);

  const serialized =
    Boolean(
      equipment
        ?.hasSerialNumber,
    );

  const serialQuery =
    useSerialNumbers(
      {
        page: serialPage,
        limit: 20,
        equipmentId:
          equipment
            ?.equipmentId,
        serialNumberCode:
          serialSearch.trim() ||
          undefined,
      },
      isOpen &&
        serialized &&
        Boolean(
          equipment
            ?.equipmentId,
        ),
    );

  const movementQuery =
    useMovements(
      {
        page:
          movementPage,
        limit: 20,
        equipmentId:
          equipment
            ?.equipmentId,
      },
      isOpen &&
        Boolean(
          equipment
            ?.equipmentId,
        ),
    );

  const api = useApi();

  const allocationQuery = useQuery({
    queryKey: ['equipment-allocations', equipment?.equipmentId],
    queryFn: () => EquipmentService.getEquipmentShelves(api, equipment!.equipmentId, permissions),
    enabled: isOpen && Boolean(equipment?.equipmentId),
    staleTime: 10_000,
  });

  const allSerialsQuery = useQuery({
    queryKey: ['equipment-all-serials', equipment?.equipmentId],
    queryFn: () => MovementService.getAllEquipmentSerials(api, equipment!.equipmentId, permissions),
    enabled: isOpen && serialized && Boolean(equipment?.equipmentId),
    staleTime: 60_000,
  });

  if (
    !isOpen ||
    !equipment
  ) {
    return null;
  }

  async function addSerial() {
    const code =
      newSerialCode.trim();

    if (
      !code ||
      !equipment
    ) {
      return;
    }

    await createSerial.mutateAsync({
      serialNumberCode:
        code,
      equipmentId:
        equipment.equipmentId,
      serialNumberStatus:
        'AVAILABLE',
    });

    setNewSerialCode('');

    await serialQuery.refetch();
    onRefresh?.();
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 backdrop-blur-sm sm:p-5">
      <div className="flex max-h-[94vh] w-full max-w-5xl flex-col overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#26221f] px-5 py-4">
          <div>
            <h2 className="text-base font-semibold">
              {equipment.equipmentName ??
                'Article sans nom'}
            </h2>

            <p className="mt-0.5 text-[10px] text-white/45">
              {serialized
                ? 'Article sérialisé'
                : 'Article standard'}
              {' • '}
              {
                equipment.equipmentStatus
              }
            </p>
          </div>

          <div className="flex gap-1">
            {onRefresh && (
              <button
                type="button"
                onClick={
                  onRefresh
                }
                disabled={
                  isLoading
                }
                className="rounded p-2 text-white/60 hover:bg-white/10"
              >
                <Loader2
                  className={`h-4 w-4 ${
                    isLoading
                      ? 'animate-spin'
                      : ''
                  }`}
                />
              </button>
            )}

            <button
              type="button"
              onClick={onClose}
              className="rounded p-2 text-white/60 hover:bg-white/10"
            >
              <X className="h-4 w-4" />
            </button>
          </div>
        </header>

        <div className="flex-1 space-y-5 overflow-y-auto p-5">
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <Stat
              label="Quantité physique"
              value={String(
                equipment.equipmentQuantity,
              )}
              icon={
                <Package className="h-3.5 w-3.5" />
              }
            />

            <Stat
              label="Minimum"
              value={String(
                equipment.minequipmentQuantity,
              )}
            />

            <Stat
              label="Mode"
              value={
                serialized
                  ? 'Sérialisé'
                  : 'Standard'
              }
              icon={
                <Barcode className="h-3.5 w-3.5" />
              }
            />

            <Stat
              label="Statut"
              value={
                equipment.equipmentStatus ? 'Actif' : 'Inactif'
              }
            />
          </div>

          <section className="overflow-hidden rounded-xl border border-[#3f3f46] bg-[#18181b]/55">
            <div className="border-b border-[#3f3f46] px-4 py-3">
              <h3 className="text-xs font-semibold">Répartition par emplacement</h3>
              <p className="mt-0.5 text-[10px] text-white/45">
                Où se trouve actuellement cet article.
              </p>
            </div>
            
            {allocationQuery.isLoading || (serialized && allSerialsQuery.isLoading) ? (
              <div className="flex justify-center p-8"><Loader2 className="h-5 w-5 animate-spin text-white/40" /></div>
            ) : (
              <div className="divide-y divide-[#3f3f46]">
                {(allocationQuery.data?.equipmentShelfs ?? []).map((alloc) => (
                  <div key={alloc.equipmentShelfId} className="px-4 py-3 text-xs">
                    <div className="flex items-center justify-between gap-3">
                      <span className="font-semibold text-white/80">{alloc.shelf?.shelfName ?? 'Emplacement inconnu'}</span>
                      <span className="font-mono">{alloc.equipmentQuantity} u.</span>
                    </div>
                    {serialized && allSerialsQuery.data && (
                      <div className="mt-2 flex flex-wrap gap-1.5">
                        {allSerialsQuery.data
                          .filter(s => s.shelfId === alloc.shelfId)
                          .map(s => (
                            <span key={s.serialNumberId} className="rounded bg-[#1f1b18] px-1.5 py-0.5 font-mono text-[10px] text-white/60 border border-[#3f3f46]">
                              {s.serialNumberCode}
                            </span>
                          ))}
                        {allSerialsQuery.data.filter(s => s.shelfId === alloc.shelfId).length === 0 && (
                          <span className="text-[10px] text-white/30 italic">Aucun numéro de série alloué ici</span>
                        )}
                      </div>
                    )}
                  </div>
                ))}
                {!allocationQuery.data?.equipmentShelfs?.length && (
                  <div className="px-4 py-6 text-center text-xs text-white/45">Aucun emplacement alloué.</div>
                )}
              </div>
            )}
          </section>

          {serialized && (
            <section className="overflow-hidden rounded-xl border border-[#3f3f46] bg-[#18181b]/55">
              <div className="space-y-3 border-b border-[#3f3f46] px-4 py-3">
                <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h3 className="text-xs font-semibold">
                      Numéros de série
                    </h3>

                    <p className="mt-0.5 text-[10px] text-white/45">
                      Le code est immuable après création. Seul le statut peut être modifié.
                    </p>
                  </div>

                  <div className="relative sm:w-64">
                    <Search className="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-white/40" />

                    <input
                      value={
                        serialSearch
                      }
                      onChange={(
                        event,
                      ) => {
                        setSerialSearch(
                          event.target
                            .value,
                        );
                        setSerialPage(
                          1,
                        );
                      }}
                      placeholder="Rechercher un S/N..."
                      className="h-8 w-full rounded border border-[#3f3f46] bg-[#1f1b18] pl-8 pr-2 text-xs"
                    />
                  </div>
                </div>

                {canCreateSerialNumber && (
                  <div className="flex gap-2">
                    <input
                      value={
                        newSerialCode
                      }
                      onChange={(
                        event,
                      ) =>
                        setNewSerialCode(
                          event.target
                            .value,
                        )
                      }
                      placeholder="Saisir manuellement le nouveau code série"
                      className="h-9 min-w-0 flex-1 rounded border border-[#3f3f46] bg-[#1f1b18] px-3 font-mono text-xs"
                    />

                    <button
                      type="button"
                      onClick={() => {
                        void addSerial();
                      }}
                      disabled={
                        !newSerialCode.trim() ||
                        createSerial.isPending
                      }
                      className="inline-flex items-center gap-1.5 rounded bg-[#fafafa] px-3 text-xs font-semibold text-[#18181b] disabled:opacity-40"
                    >
                      <Plus className="h-3.5 w-3.5" />
                      Ajouter
                    </button>
                  </div>
                )}
              </div>

              {serialQuery.isLoading ? (
                <LoadingRow text="Chargement des numéros de série..." />
              ) : (
                <>
                  <div className="divide-y divide-[#3f3f46]">
                    {(serialQuery.data
                      ?.serialNumbers ??
                      []).map(
                      (serial) => (
                        <div
                          key={
                            serial.serialNumberId
                          }
                          className="flex items-center justify-between gap-3 px-4 py-3 text-xs"
                        >
                          <div className="min-w-0">
                            <p className="truncate font-mono font-semibold">
                              {
                                serial.serialNumberCode
                              }
                            </p>

                            <p className="mt-0.5 text-[9px] text-white/40">
                              {
                                serial.serialNumberStatus
                              }
                            </p>
                          </div>

                          {canUpdateSerialNumber &&
                            onEditSerialNumber && (
                              <button
                                type="button"
                                onClick={() =>
                                  onEditSerialNumber(
                                    serial,
                                  )
                                }
                                className="inline-flex items-center gap-1 rounded border border-[#4a4540] px-2.5 py-1.5 text-[10px] text-[#d4d4d8] hover:text-white"
                              >
                                <Pencil className="h-3 w-3" />
                                Statut
                              </button>
                            )}
                        </div>
                      ),
                    )}

                    {!serialQuery.data
                      ?.serialNumbers
                      ?.length && (
                      <div className="px-4 py-8 text-center text-xs text-white/45">
                        Aucun numéro de série.
                      </div>
                    )}
                  </div>

                  <Pager
                    page={
                      serialQuery.data
                        ?.currentPage ??
                      serialPage
                    }
                    totalPages={
                      serialQuery.data
                        ?.totalPages ??
                      1
                    }
                    onPage={
                      setSerialPage
                    }
                  />
                </>
              )}
            </section>
          )}

          <section className="overflow-hidden rounded-xl border border-[#3f3f46] bg-[#18181b]/55">
            <div className="border-b border-[#3f3f46] px-4 py-3">
              <h3 className="text-xs font-semibold">
                Historique des mouvements
              </h3>

              <p className="mt-0.5 text-[10px] text-white/45">
                Consultation uniquement. Aucun mouvement ne se crée depuis la fiche article.
              </p>
            </div>

            {movementQuery.isLoading ? (
              <LoadingRow text="Chargement des mouvements..." />
            ) : (
              <>
                <div className="divide-y divide-[#3f3f46]">
                  {(movementQuery.data
                    ?.movements ??
                    []).map(
                    (movement) => {
                      const descriptor =
                        movementLabel(
                          movement,
                        );

                      const Icon =
                        descriptor.icon;

                      const line =
                        movement.items?.find(
                          (item) =>
                            item.equipmentId
                              .toLowerCase() ===
                            equipment.equipmentId
                              .toLowerCase(),
                        );

                      const quantity =
                        line?.equipmentQuantity ?? 0;

                      return (
                        <div
                          key={
                            movement.mouvementId
                          }
                          className="grid grid-cols-[100px_minmax(0,1fr)_70px] items-center gap-3 px-4 py-3 text-xs"
                        >
                          <span className="inline-flex items-center gap-1 text-white/70">
                            <Icon className="h-3.5 w-3.5" />
                            {
                              descriptor.text
                            }
                          </span>

                          <div className="min-w-0">
                            <p className="truncate text-white/75">
                              {line?.sourceShelf
                                ?.shelfName ??
                                'Extérieur'}
                              {' → '}
                              {line?.destinationShelf
                                ?.shelfName ??
                                'Extérieur'}
                            </p>

                            <p className="mt-0.5 text-[9px] text-white/35">
                              Date d'effet: {formatDate(
                                movement.happenedAt,
                              )} • Créé le: {formatDate(
                                movement.createdAt,
                              )}
                            </p>
                          </div>

                          <span className="text-right font-mono font-semibold">
                            {
                              quantity
                            }{' '}
                            u.
                          </span>
                        </div>
                      );
                    },
                  )}

                  {!movementQuery.data
                    ?.movements
                    ?.length && (
                    <div className="px-4 py-8 text-center text-xs text-white/45">
                      Aucun mouvement enregistré.
                    </div>
                  )}
                </div>

                <Pager
                  page={
                    movementQuery.data
                      ?.currentPage ??
                    movementPage
                  }
                  totalPages={
                    movementQuery.data
                      ?.totalPages ??
                    1
                  }
                  onPage={
                    setMovementPage
                  }
                />
              </>
            )}
          </section>
        </div>

        <footer className="flex justify-end border-t border-[#3f3f46] bg-[#26221f] px-5 py-3">
          <button
            type="button"
            onClick={onClose}
            className="rounded bg-[#fafafa] px-4 py-2 text-xs font-semibold text-[#18181b]"
          >
            Fermer
          </button>
        </footer>
      </div>
    </div>
  );
}

function Stat({
  label,
  value,
  icon,
}: {
  label: string;
  value: string;
  icon?: React.ReactNode;
}) {
  return (
    <div className="rounded-lg border border-[#3f3f46] bg-[#18181b]/65 p-3">
      <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-white/40">
        {icon}
        {label}
      </div>

      <p className="mt-2 text-sm font-semibold">
        {value}
      </p>
    </div>
  );
}

function LoadingRow({
  text,
}: {
  text: string;
}) {
  return (
    <div className="flex items-center justify-center gap-2 px-4 py-7 text-xs text-white/45">
      <Loader2 className="h-4 w-4 animate-spin" />
      {text}
    </div>
  );
}

function Pager({
  page,
  totalPages,
  onPage,
}: {
  page: number;
  totalPages: number;
  onPage: (
    page: number,
  ) => void;
}) {
  if (
    totalPages <= 1
  ) {
    return null;
  }

  return (
    <div className="flex items-center justify-end gap-2 border-t border-[#3f3f46] px-4 py-2">
      <button
        type="button"
        disabled={
          page <= 1
        }
        onClick={() =>
          onPage(
            page - 1,
          )
        }
        className="rounded border border-[#3f3f46] px-2 py-1 text-[10px] disabled:opacity-30"
      >
        Préc.
      </button>

      <span className="text-[10px] text-white/45">
        {page} /{' '}
        {totalPages}
      </span>

      <button
        type="button"
        disabled={
          page >= totalPages
        }
        onClick={() =>
          onPage(
            page + 1,
          )
        }
        className="rounded border border-[#3f3f46] px-2 py-1 text-[10px] disabled:opacity-30"
      >
        Suiv.
      </button>
    </div>
  );
}
</file>

<file path="frontend/src/components/equipment/EquipmentListTable.tsx">
'use client';

import {
  ChevronLeft,
  ChevronRight,
  Eye,
  PackagePlus,
  Pencil,
  RefreshCw,
  Search,
  Trash2,
} from 'lucide-react';

import type {
  Equipment,
  EquipmentStatus,
} from '@/types/equipment';

interface EquipmentListTableProps {
  equipments: Equipment[];
  totalEquipments: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  equipmentStatus?:
  | EquipmentStatus;
  hasSerialNumber?:
  | boolean;

  onSearchChange: (
    value: string,
  ) => void;

  onEquipmentStatusChange: (
    value:
      | EquipmentStatus
      | undefined,
  ) => void;

  onSerialModeChange: (
    value:
      | boolean
      | undefined,
  ) => void;

  onPageChange: (
    page: number,
  ) => void;

  onLimitChange: (
    limit: number,
  ) => void;

  onSelectEquipment: (
    equipment: Equipment,
  ) => void;

  onEditEquipment?: (
    equipment: Equipment,
  ) => void;

  onDeleteEquipment?: (
    equipment: Equipment,
  ) => void;

  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateEquipment: boolean;
  canUpdateEquipment?: boolean;
  canDeleteEquipment?: boolean;
}

export function EquipmentListTable({
  equipments,
  totalEquipments,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  equipmentStatus,
  hasSerialNumber,
  onSearchChange,
  onEquipmentStatusChange,
  onSerialModeChange,
  onPageChange,
  onLimitChange,
  onSelectEquipment,
  onEditEquipment,
  onDeleteEquipment,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateEquipment,
  canUpdateEquipment = true,
  canDeleteEquipment = true,
}: EquipmentListTableProps) {
  return (
    <div className="overflow-hidden rounded-lg border border-[#3f3f46] bg-[#27272a]">
      <div className="flex flex-col gap-3 border-b border-[#3f3f46] p-3 xl:flex-row xl:items-center xl:justify-between">
        <div className="relative w-full max-w-lg">
          <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#a1a1aa]" />

          <input
            value={searchTerm}
            onChange={(event) =>
              onSearchChange(
                event.target.value,
              )
            }
            placeholder="Rechercher par nom d’article..."
            className="h-9 w-full rounded border border-[#3f3f46] bg-[#18181b] pl-9 pr-3 text-xs outline-none placeholder:text-[#a1a1aa]"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <select
            value={
              equipmentStatus === undefined
                ? 'ALL'
                : equipmentStatus
                  ? 'true'
                  : 'false'
            }
            onChange={(event) =>
              onEquipmentStatusChange(
                event.target.value ===
                  'ALL'
                  ? undefined
                  : event.target
                    .value === 'true',
              )
            }
            className="h-9 rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
          >
            <option value="ALL">
              Tous les statuts
            </option>
            <option value="true">
              ACTIVE
            </option>
            <option value="false">
              INACTIVE
            </option>
          </select>

          <select
            value={
              hasSerialNumber ===
                undefined
                ? 'ALL'
                : hasSerialNumber
                  ? 'SERIALIZED'
                  : 'STANDARD'
            }
            onChange={(event) =>
              onSerialModeChange(
                event.target.value ===
                  'ALL'
                  ? undefined
                  : event.target
                    .value ===
                  'SERIALIZED',
              )
            }
            className="h-9 rounded border border-[#3f3f46] bg-[#18181b] px-3 text-xs"
          >
            <option value="ALL">
              Tous les modes
            </option>
            <option value="STANDARD">
              Standard
            </option>
            <option value="SERIALIZED">
              Sérialisé
            </option>
          </select>

          <select
            value={limit}
            onChange={(event) =>
              onLimitChange(
                Number(
                  event.target.value,
                ),
              )
            }
            className="h-9 rounded border border-[#3f3f46] bg-[#18181b] px-2 text-xs"
          >
            <option value={10}>
              10 / page
            </option>
            <option value={20}>
              20 / page
            </option>
            <option value={50}>
              50 / page
            </option>
          </select>



        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead className="border-b border-[#3f3f46] bg-[#18181b] text-[10px] uppercase tracking-wide text-[#a1a1aa]">
            <tr>
              <th className="px-4 py-3">
                Article
              </th>
              <th className="px-4 py-3">
                Mode
              </th>
              <th className="px-4 py-3">
                Statut
              </th>
              <th className="px-4 py-3 text-center">
                Quantité
              </th>
              <th className="px-4 py-3 text-center">
                Minimum
              </th>
              <th className="px-4 py-3 text-right">
                Actions
              </th>
            </tr>
          </thead>

          <tbody className="divide-y divide-[#3f3f46]">
            {isLoading &&
              equipments.length ===
              0 ? (
              <tr>
                <td
                  colSpan={6}
                  className="px-4 py-14 text-center text-[#a1a1aa]"
                >
                  Chargement...
                </td>
              </tr>
            ) : equipments.length ===
              0 ? (
              <tr>
                <td
                  colSpan={6}
                  className="px-4 py-14 text-center text-[#a1a1aa]"
                >
                  Aucun article disponible.
                </td>
              </tr>
            ) : (
              equipments.map(
                (equipment) => (
                  <tr
                    key={
                      equipment.equipmentId
                    }
                    className="hover:bg-[#27272a]"
                  >
                    <td className="px-4 py-3">
                      <button
                        type="button"
                        onClick={() =>
                          onSelectEquipment(
                            equipment,
                          )
                        }
                        className="max-w-[340px] truncate text-left font-semibold hover:underline"
                      >
                        {equipment.equipmentName ??
                          'Article sans nom'}
                      </button>
                    </td>

                    <td className="px-4 py-3">
                      <span className="rounded border border-[#4a4540] bg-[#18181b] px-2 py-1 text-[10px]">
                        {equipment.hasSerialNumber
                          ? 'SÉRIALISÉ'
                          : 'STANDARD'}
                      </span>
                    </td>

                    <td className="px-4 py-3">
                      <span
                        className={`rounded border px-2 py-1 text-[10px] font-semibold ${equipment.equipmentStatus
                          ? 'border-emerald-400/25 bg-emerald-950/25 text-emerald-300'
                          : 'border-amber-400/25 bg-amber-950/25 text-amber-300'
                          }`}
                      >
                        {
                          equipment.equipmentStatus ? 'ACTIVE' : 'INACTIVE'
                        }
                      </span>
                    </td>

                    <td className="px-4 py-3 text-center font-mono">
                      {
                        equipment.equipmentQuantity
                      }
                    </td>

                    <td className="px-4 py-3 text-center font-mono">
                      {
                        equipment.minequipmentQuantity
                      }
                    </td>

                    <td className="px-4 py-3 text-right">
                      <div className="inline-flex items-center gap-1">
                        <button
                          type="button"
                          onClick={() =>
                            onSelectEquipment(
                              equipment,
                            )
                          }
                          className="rounded p-2 text-[#a1a1aa] hover:bg-[#18181b] hover:text-white"
                          title="Voir"
                        >
                          <Eye className="h-3.5 w-3.5" />
                        </button>

                        {onEditEquipment && (
                          <button
                            type="button"
                            onClick={() =>
                              onEditEquipment(
                                equipment,
                              )
                            }
                            disabled={
                              !canUpdateEquipment
                            }
                            className="rounded p-2 text-[#a1a1aa] hover:bg-[#18181b] hover:text-white disabled:opacity-30"
                            title="Modifier"
                          >
                            <Pencil className="h-3.5 w-3.5" />
                          </button>
                        )}

                        {onDeleteEquipment && (
                          <button
                            type="button"
                            onClick={() =>
                              onDeleteEquipment(
                                equipment,
                              )
                            }
                            disabled={
                              !canDeleteEquipment
                            }
                            className="rounded p-2 text-rose-300 hover:bg-rose-950/25 disabled:opacity-30"
                            title="Supprimer"
                          >
                            <Trash2 className="h-3.5 w-3.5" />
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ),
              )
            )}
          </tbody>
        </table>
      </div>

      <div className="flex items-center justify-between border-t border-[#3f3f46] bg-[#18181b] px-4 py-3">
        <p className="text-[11px] text-[#a1a1aa]">
          {totalEquipments} article
          {totalEquipments > 1
            ? 's'
            : ''}
        </p>

        <div className="flex items-center gap-2">
          <button
            type="button"
            disabled={
              currentPage <= 1
            }
            onClick={() =>
              onPageChange(
                currentPage - 1,
              )
            }
            className="rounded border border-[#3f3f46] p-2 disabled:opacity-30"
          >
            <ChevronLeft className="h-3.5 w-3.5" />
          </button>

          <span className="text-[11px] text-[#a1a1aa]">
            {currentPage} /{' '}
            {Math.max(
              1,
              totalPages,
            )}
          </span>

          <button
            type="button"
            disabled={
              currentPage >=
              totalPages
            }
            onClick={() =>
              onPageChange(
                currentPage + 1,
              )
            }
            className="rounded border border-[#3f3f46] p-2 disabled:opacity-30"
          >
            <ChevronRight className="h-3.5 w-3.5" />
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/navigation/Navbar.tsx">
'use client';

import {
  useState,
} from 'react';
import Image from 'next/image';
import Link from 'next/link';
import {
  usePathname,
} from 'next/navigation';
import {
  useAuth,
  UserButton,
} from '@clerk/nextjs';
import {
  ArrowRightLeft,
  ChevronDown,
  ClipboardList,
  Cpu,
  Layers,
  Menu,
  ShieldAlert,
  ShieldCheck,
  Users,
  Warehouse,
  X,
} from 'lucide-react';

import {
  usePermissions,
} from '@/hooks/use-permissions';

import {
  NotificationBell,
} from './NotificationBell';

import { GSILogo } from './GSILogo';

import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';

export function Navbar() {
  const pathname =
    usePathname();

  const {
    isSignedIn,
    isLoaded,
  } = useAuth();

  const permissions =
    usePermissions();

  const [
    mobileOpen,
    setMobileOpen,
  ] = useState(false);

  const active = {
    stocks:
      pathname?.startsWith(
        '/stocks',
      ) ||
      pathname?.startsWith(
        '/stock',
      ),

    shelves:
      pathname?.startsWith(
        '/shelves',
      ),

    equipment:
      pathname?.startsWith(
        '/equipment',
      ) ||
      pathname?.startsWith(
        '/equipments',
      ),

    movements:
      pathname?.startsWith(
        '/movements',
      ),

    inventory:
      pathname?.startsWith(
        '/inventory',
      ),
  };

  const stockAreaActive =
    active.stocks ||
    active.shelves ||
    active.equipment;

  return (
    <header className="sticky top-0 z-40 w-full border-b border-[#3f3f46] bg-[#18181b]/95 backdrop-blur-md">
      <div className="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
        <div className="flex items-center gap-5 sm:gap-8">
          <Link
            href="/"
            className="flex items-center gap-3"
          >

            <GSILogo className="h-9 w-auto text-[#fafafa]" />
          </Link>

          <div className="hidden h-4 w-px bg-[#3f3f46] sm:block" />

          <nav className="hidden items-center gap-1 sm:flex">
            {(permissions.canReadStock || permissions.canReadShelf || permissions.canReadEquipment) && (
              <DropdownMenu>
                <DropdownMenuTrigger
                  className={`flex items-center gap-2 rounded px-2.5 py-1.5 text-xs font-medium ${stockAreaActive
                    ? 'border border-[#3f3f46] bg-[#27272a] text-[#fafafa]'
                    : 'text-[#d4d4d8] hover:bg-[#27272a]/70 hover:text-[#fafafa]'
                    }`}
                >
                  <Warehouse className="h-3.5 w-3.5" />
                  Stocks
                  <ChevronDown className="h-3 w-3" />
                </DropdownMenuTrigger>

                <DropdownMenuContent
                  align="start"
                  className="w-52 border-[#3f3f46] bg-[#27272a] text-[#d4d4d8]"
                >
                  {permissions.canReadStock && (
                    <NavItem
                      href="/stocks"
                      icon={
                        <Warehouse className="h-3.5 w-3.5" />
                      }
                      text="Stocks"
                    />
                  )}

                  {permissions.canReadShelf && (
                    <NavItem
                      href="/shelves"
                      icon={
                        <Layers className="h-3.5 w-3.5" />
                      }
                      text="Emplacements"
                    />
                  )}

                  {permissions.canReadEquipment && (
                    <NavItem
                      href="/equipment"
                      icon={
                        <Cpu className="h-3.5 w-3.5" />
                      }
                      text="Articles"
                    />
                  )}
                </DropdownMenuContent>
              </DropdownMenu>
            )}

            {permissions.canReadMovement && (
              <Link
                href="/movements"
                className={`flex items-center gap-2 rounded px-2.5 py-1.5 text-xs font-medium ${active.movements
                  ? 'border border-[#3f3f46] bg-[#27272a] text-[#fafafa]'
                  : 'text-[#d4d4d8] hover:bg-[#27272a]/70 hover:text-[#fafafa]'
                  }`}
              >
                <ArrowRightLeft className="h-3.5 w-3.5" />
                Mouvements
              </Link>
            )}

            {permissions.canReadInventory && (
              <Link
                href="/inventory"
                className={`flex items-center gap-2 rounded px-2.5 py-1.5 text-xs font-medium ${active.inventory
                  ? 'border border-[#3f3f46] bg-[#27272a] text-[#fafafa]'
                  : 'text-[#d4d4d8] hover:bg-[#27272a]/70 hover:text-[#fafafa]'
                  }`}
              >
                <ClipboardList className="h-3.5 w-3.5" />
                Inventaires
              </Link>
            )}
          </nav>
        </div>

        <div className="flex items-center gap-3">
          {isSignedIn && (
            <div className="hidden items-center gap-1.5 rounded border border-[#3f3f46] bg-[#27272a] px-2.5 py-1 font-mono text-[11px] text-[#d4d4d8] md:flex">
              {permissions.isAdmin ||
                permissions.canCreateEquipment ||
                permissions.canCreateMovement ||
                permissions.canCreateShelf ? (
                <>
                  <ShieldCheck className="h-3 w-3 text-emerald-400" />
                  <span className="text-[#fafafa] uppercase">
                    {permissions.roleName || '...'}
                  </span>
                </>
              ) : (
                <>
                  <ShieldAlert className="h-3 w-3 text-amber-400" />
                  <span className="uppercase">
                    {permissions.roleName || '...'}
                  </span>
                </>
              )}
            </div>
          )}

          {isSignedIn && (
            <NotificationBell />
          )}

          {!isLoaded ? (
            <div className="h-7 w-7 animate-pulse rounded bg-[#27272a]" />
          ) : isSignedIn ? (
            <div className="rounded border border-[#3f3f46] bg-[#27272a] p-0.5">
              <UserButton>
                <UserButton.MenuItems>
                  <UserButton.Action label="manageAccount" />

                  <UserButton.Link
                    label="Rôles & Accès"
                    labelIcon={
                      <Users className="h-4 w-4" />
                    }
                    href="/users"
                  />

                  <UserButton.Action label="signOut" />
                </UserButton.MenuItems>
              </UserButton>
            </div>
          ) : (
            <Link
              href="/sign-in"
              className="rounded bg-[#fafafa] px-3 py-1.5 text-xs font-medium text-[#18181b]"
            >
              Connexion
            </Link>
          )}

          <button
            type="button"
            onClick={() =>
              setMobileOpen(
                (value) =>
                  !value,
              )
            }
            className="rounded p-1.5 text-[#d4d4d8] hover:bg-[#27272a] sm:hidden"
          >
            {mobileOpen ? (
              <X className="h-4 w-4" />
            ) : (
              <Menu className="h-4 w-4" />
            )}
          </button>
        </div>
      </div>

      {mobileOpen && (
        <div className="space-y-1 border-t border-[#3f3f46] bg-[#18181b] px-4 py-3 sm:hidden">
          {permissions.canReadStock && (
            <MobileLink
              href="/stocks"
              text="Stocks"
              active={active.stocks}
              close={() =>
                setMobileOpen(
                  false,
                )
              }
            />
          )}

          {permissions.canReadShelf && (
            <MobileLink
              href="/shelves"
              text="Emplacements"
              active={
                active.shelves
              }
              close={() =>
                setMobileOpen(
                  false,
                )
              }
            />
          )}

          {permissions.canReadEquipment && (
            <MobileLink
              href="/equipment"
              text="Articles"
              active={
                active.equipment
              }
              close={() =>
                setMobileOpen(
                  false,
                )
              }
            />
          )}

          {permissions.canReadMovement && (
            <MobileLink
              href="/movements"
              text="Mouvements"
              active={
                active.movements
              }
              close={() =>
                setMobileOpen(
                  false,
                )
              }
            />
          )}

          {permissions.canReadInventory && (
            <MobileLink
              href="/inventory"
              text="Inventaires"
              active={
                active.inventory
              }
              close={() =>
                setMobileOpen(
                  false,
                )
              }
            />
          )}
        </div>
      )}
    </header>
  );
}

function NavItem({
  href,
  icon,
  text,
}: {
  href: string;
  icon: React.ReactNode;
  text: string;
}) {
  return (
    <DropdownMenuItem className="cursor-pointer focus:bg-[#27272a] focus:text-[#fafafa]">
      <Link
        href={href}
        className="flex w-full items-center gap-2"
      >
        {icon}
        {text}
      </Link>
    </DropdownMenuItem>
  );
}

function MobileLink({
  href,
  text,
  active,
  close,
}: {
  href: string;
  text: string;
  active: boolean;
  close: () => void;
}) {
  return (
    <Link
      href={href}
      onClick={close}
      className={`block rounded p-2 text-xs font-medium ${active
        ? 'border border-[#3f3f46] bg-[#27272a] text-[#fafafa]'
        : 'text-[#d4d4d8] hover:bg-[#27272a]'
        }`}
    >
      {text}
    </Link>
  );
}
