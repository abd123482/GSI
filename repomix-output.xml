<file path="frontend/src/components/equipment/EditEquipmentModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import {
  X,
  Pencil,
  AlertCircle,
  AlertTriangle,
  Sparkles,
  Hash,
  Barcode,
  RefreshCw,
  Copy,
  Check,
} from 'lucide-react';
import { Equipment } from '@/types/equipment';
import {
  updateEquipmentSchema,
  UpdateEquipmentFormValues,
} from '@/schemas/equipment.schema';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { toast } from 'sonner';

interface EditEquipmentModalProps {
  isOpen: boolean;
  onClose: () => void;
  equipment: Equipment | null;
  onUpdate: (id: string, values: {
    equipmentName?: string;
    equipmentQuantity?: number;
    minEquipmentQuantity?: number;
    hasSerialNumber?: boolean;
  }) => Promise<void>;
  isUpdating: boolean;
}

/**
 * Generates a random 32-bit hexadecimal string (8 hex chars).
 */
function generate32BitRandomCode(): string {
  if (typeof window !== 'undefined' && window.crypto && window.crypto.getRandomValues) {
    const uint32 = new Uint32Array(1);
    window.crypto.getRandomValues(uint32);
    return uint32[0].toString(16).toUpperCase().padStart(8, '0');
  }
  return Math.floor(Math.random() * 0xffffffff)
    .toString(16)
    .toUpperCase()
    .padStart(8, '0');
}

function generateSerialCodes(count: number): string[] {
  const codes = new Set<string>();
  while (codes.size < count) {
    codes.add(`SN-${generate32BitRandomCode()}`);
  }
  return Array.from(codes);
}

export function EditEquipmentModal(props: EditEquipmentModalProps) {
  if (!props.isOpen || !props.equipment) return null;

  const equipment = props.equipment;
  return (
    <EditEquipmentModalContent
      key={`${equipment.equipmentId}:${equipment.equipmentName}:${equipment.equipmentQuantity}:${equipment.minequipmentQuantity}:${equipment.hasSerialNumber}`}
      {...props}
    />
  );
}

function EditEquipmentModalContent({
  isOpen,
  onClose,
  equipment,
  onUpdate,
  isUpdating,
}: EditEquipmentModalProps) {
  const api = useApi();
  const { canUpdateEquipment } = usePermissions();

  // Mode state: whether the equipment will have a serial number
  const initialCount = equipment?.equipmentQuantity && equipment.equipmentQuantity > 0
    ? equipment.equipmentQuantity
    : 1;
  const [hasSerialNumber, setHasSerialNumber] = useState(equipment?.hasSerialNumber ?? false);
  const [serialCount, setSerialCount] = useState(initialCount);
  const [serialList, setSerialList] = useState<string[]>([]);
  const [copiedIndex, setCopiedIndex] = useState<number | null>(null);
  const [isSubmittingInternal, setIsSubmittingInternal] = useState(false);

  const {
    register,
    handleSubmit,
    setValue,
    formState: { errors },
  } = useForm<UpdateEquipmentFormValues>({
    resolver: zodResolver(updateEquipmentSchema),
    defaultValues: {
      equipmentName: equipment?.equipmentName ?? '',
      equipmentQuantity: equipment?.equipmentQuantity ?? 0,
      minEquipmentQuantity: equipment?.minequipmentQuantity ?? 0,
      hasSerialNumber: equipment?.hasSerialNumber ?? false,
    },
  });

  if (!isOpen || !equipment) return null;

  const originalHasSerialNumber = equipment.hasSerialNumber;
  const isConvertingToSerialized = !originalHasSerialNumber && hasSerialNumber;
  const isConvertingToStandard = originalHasSerialNumber && !hasSerialNumber;

  // Handler when user clicks toggle
  const handleToggleHasSerialNumber = (checked: boolean) => {
    setHasSerialNumber(checked);
    setValue('hasSerialNumber', checked);

    if (checked && !originalHasSerialNumber) {
      // Transitioning standard -> serialized
      const count = Math.max(1, Number(serialCount) || 1);
      setSerialList(generateSerialCodes(count));
    }
  };

  // Regenerate serial codes
  const handleRegenerateCodes = () => {
    const codes = generateSerialCodes(serialList.length);
    setSerialList(codes);
    toast.success(`${codes.length} code(s) 32-bit régénéré(s) !`);
  };

  // Adjust count of serials to generate
  const handleSerialCountChange = (newCount: number) => {
    const validCount = Math.max(1, Math.min(500, newCount));
    setSerialCount(validCount);
    setSerialList(generateSerialCodes(validCount));
  };

  const handleCopySerial = (code: string, index: number) => {
    navigator.clipboard.writeText(code);
    setCopiedIndex(index);
    toast.success('Code copié !');
    setTimeout(() => setCopiedIndex(null), 1500);
  };

  const onSubmit = async (data: UpdateEquipmentFormValues) => {
    setIsSubmittingInternal(true);
    try {
      if (isConvertingToSerialized) {
        // Validate serials
        const trimmed = serialList.map((s) => s.trim().toUpperCase());
        const hasEmpty = trimmed.some((s) => s.length === 0);
        if (hasEmpty) {
          toast.error('Erreur', { description: 'Tous les numéros de série doivent être renseignés.' });
          setIsSubmittingInternal(false);
          return;
        }
        const uniqueSet = new Set(trimmed);
        if (uniqueSet.size !== trimmed.length) {
          toast.error('Erreur', { description: 'Certains numéros de série sont en double.' });
          setIsSubmittingInternal(false);
          return;
        }

        // 1. Update equipment scalar fields and toggle hasSerialNumber = true (quantity reset to 0 so batch adds exact count)
        await onUpdate(equipment.equipmentId, {
          equipmentName: data.equipmentName?.trim(),
          minEquipmentQuantity: data.minEquipmentQuantity,
          equipmentQuantity: 0,
          hasSerialNumber: true,
        });

        // 2. Create the child serial numbers via batch endpoint
        await api.post('/serial-number/batch', {
          equipmentId: equipment.equipmentId,
          serialNumberCodes: trimmed,
          serialNumberStatus: 'AVAILABLE',
        });

        toast.success('Conversion réussie', {
          description: `Article converti en sérialisé avec ${trimmed.length} numéro(s) de série.`,
        });
      } else if (isConvertingToStandard) {
        // Converting serialized -> standard: deletes serial numbers and sets scalar quantity
        await onUpdate(equipment.equipmentId, {
          equipmentName: data.equipmentName?.trim(),
          minEquipmentQuantity: data.minEquipmentQuantity,
          equipmentQuantity: Number(data.equipmentQuantity ?? equipment.equipmentQuantity),
          hasSerialNumber: false,
        });

        toast.success('Conversion réussie', {
          description: 'Article converti en mode standard (sans numéros de série).',
        });
      } else {
        // Preserving same mode
        await onUpdate(equipment.equipmentId, {
          equipmentName: data.equipmentName?.trim(),
          minEquipmentQuantity: data.minEquipmentQuantity,
          ...(hasSerialNumber
            ? {}
            : { equipmentQuantity: Number(data.equipmentQuantity) }),
          hasSerialNumber,
        });
      }

      onClose();
    } catch (err: unknown) {
      toast.error('Échec de la modification', {
        description: getErrorMessage(err, 'Une erreur est survenue.'),
      });
    } finally {
      setIsSubmittingInternal(false);
    }
  };

  const isBusy = isUpdating || isSubmittingInternal;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-in fade-in duration-200">
      <div
        className="relative w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl transition-all"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className="sticky top-0 z-10 h-14 bg-[#2b2622] px-5 py-4 flex items-center justify-between border-b border-[#3f3a36]">
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-lg bg-[#2b2622] shadow-sm border border-white/20 flex items-center justify-center text-[#f7f5f0]">
              <Pencil className="w-4 h-4" />
            </div>
            <div>
              <span className="text-xs font-semibold uppercase tracking-wider text-white">
                Modifier l’article
              </span>
              <p className="text-[11px] text-white/70">{equipment.equipmentName}</p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-1.5 rounded-md text-white/80 hover:bg-white/10 hover:text-white transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Content Body */}
        <div className="p-6 space-y-5">
          {/* Permission Warning */}
          {!canUpdateEquipment && (
            <div className="rounded-lg bg-amber-500/20 border border-amber-400/40 p-3 flex items-start gap-2 text-amber-100 text-sm">
              <AlertCircle className="w-4 h-4 mt-0.5 flex-shrink-0" />
              <div>
                <span className="font-semibold">Permission manquante :</span> Vous ne détenez pas le droit{' '}
                <code className="bg-black/30 px-1 py-0.5 rounded text-xs">equipment.update</code> pour modifier cet article.
              </div>
            </div>
          )}

          {/* Interactive Serialized Toggle Card */}
          <div className="p-4 rounded-xl border border-[#3f3a36] bg-[#2b2622]/60 transition-all">
            <div className="flex items-center justify-between gap-3">
              <div className="flex items-center gap-3">
                <div
                  className={`w-9 h-9 rounded-lg flex items-center justify-center transition-colors ${
                    hasSerialNumber
                      ? 'bg-[#2b2622] text-[#f7f5f0] border border-white/20'
                      : 'bg-black/20 text-white/60 border border-white/15'
                  }`}
                >
                  <Barcode className="w-4 h-4" />
                </div>
                <div>
                  <div className="text-xs font-semibold text-white flex items-center gap-2">
                    <span>Gestion par numéros de série</span>
                    <span
                      className={`px-2 py-0.5 rounded-full text-[10px] font-medium tracking-wide ${
                        hasSerialNumber
                          ? 'bg-[#2b2622] text-emerald-300 border border-emerald-400/30'
                          : 'bg-black/30 text-white/70 border border-white/20'
                      }`}
                    >
                      {hasSerialNumber ? 'Sérialisé' : 'Standard'}
                    </span>
                  </div>
                  <p className="text-[11px] text-white/70 mt-0.5">
                    {hasSerialNumber
                      ? 'Chaque unité possède son propre numéro de série unique.'
                      : 'Suivi par quantité globale sans numéros de série individuels.'}
                  </p>
                </div>
              </div>

              {/* Toggle Switch */}
              <label className="relative inline-flex items-center cursor-pointer shrink-0">
                <input
                  type="checkbox"
                  checked={hasSerialNumber}
                  onChange={(e) => handleToggleHasSerialNumber(e.target.checked)}
                  disabled={!canUpdateEquipment || isBusy}
                  className="sr-only peer"
                />
                <div className="w-11 h-6 bg-black/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2b2622]" />
              </label>
            </div>
          </div>

          <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
            {/* Equipment Name */}
            <div>
              <label className="block text-xs font-medium text-white mb-1">
                Nom de l’article <span className="text-rose-300">*</span>
              </label>
              <input
                type="text"
                {...register('equipmentName')}
                placeholder="Ex: Barcode Scanner Epson M0289"
                disabled={!canUpdateEquipment || isBusy}
                className="w-full h-10 px-3 rounded-lg border border-[#3f3a36] bg-[#2b2622] text-white placeholder-white/50 text-sm focus:outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20 transition-all"
              />
              {errors.equipmentName && (
                <p className="mt-1 text-xs text-rose-300">{errors.equipmentName.message}</p>
              )}
            </div>

            {/* Mode 1: Converting Standard -> Serialized */}
            {isConvertingToSerialized && (
              <div className="rounded-xl border border-[#3f3a36] bg-[#2b2622]/70 p-4 space-y-3 animate-in fade-in">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-semibold text-white flex items-center gap-1.5">
                    <Sparkles className="w-3.5 h-3.5 text-amber-300" />
                    Conversion en article sérialisé
                  </span>
                  <span className="text-[11px] text-[#f7f5f0] bg-[#2b2622] px-2 py-0.5 rounded font-medium border border-[#38bdf8]/30">
                    {serialList.length} code(s) requis
                  </span>
                </div>

                <p className="text-xs text-white/80">
                  Des numéros de série 32-bit uniques vont être générés et enregistrés pour chaque exemplaire.
                </p>

                <div className="flex items-center gap-2">
                  <label className="text-xs text-white font-medium shrink-0">
                    Quantité à sérialiser :
                  </label>
                  <input
                    type="number"
                    min="1"
                    max="200"
                    value={serialCount}
                    onChange={(e) => handleSerialCountChange(parseInt(e.target.value, 10) || 1)}
                    className="w-20 h-8 px-2 rounded-lg border border-[#3f3a36] bg-[#2b2622] text-white text-xs font-mono font-medium text-center focus:outline-none focus:border-white"
                  />
                  <button
                    type="button"
                    onClick={handleRegenerateCodes}
                    className="ml-auto px-2.5 py-1 text-xs font-medium text-white bg-[#2b2622] border border-white/20 rounded-md hover:bg-[#3f3a36] transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                  >
                    <RefreshCw className="w-3 h-3" />
                    Régénérer les codes
                  </button>
                </div>

                {/* Preview list */}
                <div className="max-h-32 overflow-y-auto space-y-1.5 pr-1 border border-[#3f3a36]/60 rounded-lg p-2 bg-[#2b2622]/50">
                  {serialList.map((code, idx) => (
                    <div
                      key={idx}
                      className="flex items-center justify-between px-2.5 py-1 bg-[#2b2622] border border-[#3f3a36] rounded text-xs font-mono text-white"
                    >
                      <span className="text-[11px] text-white/60">#{idx + 1}</span>
                      <span className="font-semibold text-emerald-300">{code}</span>
                      <button
                        type="button"
                        onClick={() => handleCopySerial(code, idx)}
                        className="text-white/70 hover:text-white p-0.5 rounded cursor-pointer"
                        title="Copier le code"
                      >
                        {copiedIndex === idx ? (
                          <Check className="w-3.5 h-3.5 text-emerald-400" />
                        ) : (
                          <Copy className="w-3.5 h-3.5" />
                        )}
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Mode 2: Converting Serialized -> Standard */}
            {isConvertingToStandard && (
              <div className="rounded-xl border border-amber-500/40 bg-amber-950/40 p-4 space-y-3 animate-in fade-in">
                <div className="flex items-center gap-2 text-xs font-semibold text-amber-200">
                  <AlertTriangle className="w-4 h-4 text-amber-400" />
                  <span>Confirmation : Conversion en article standard</span>
                </div>
                <p className="text-xs text-amber-100/90 leading-relaxed">
                  Attention : les <strong>{equipment.serialNumbers?.length ?? equipment.equipmentQuantity}</strong> numéros de série existants seront <strong>définitivement supprimés</strong> de la base de données.
                </p>
                <div>
                  <label className="block text-xs font-medium text-amber-200 mb-1">
                    Quantité globale en stock conservée <span className="text-rose-300">*</span>
                  </label>
                  <div className="relative">
                    <input
                      type="number"
                      min="0"
                      {...register('equipmentQuantity', { valueAsNumber: true })}
                      className="w-full h-10 px-3 pl-8 rounded-lg border border-amber-400/40 bg-[#2b2622] text-white text-sm focus:outline-none focus:border-white"
                    />
                    <Hash className="w-4 h-4 text-white/60 absolute left-2.5 top-3" />
                  </div>
                </div>
              </div>
            )}

            {/* Mode 3: Already Serialized & Staying Serialized */}
            {!isConvertingToSerialized && !isConvertingToStandard && hasSerialNumber && (
              <div className="rounded-xl border border-[#3f3a36] bg-[#2b2622]/60 p-3.5 space-y-2">
                <div className="flex items-center justify-between text-xs">
                  <span className="font-medium text-white">Quantité en stock</span>
                  <span className="font-semibold px-2 py-0.5 rounded bg-[#2b2622] text-emerald-300 border border-emerald-400/30">
                    {equipment.equipmentQuantity} exemplaire(s)
                  </span>
                </div>
                <p className="text-[11px] text-white/70 leading-relaxed">
                  La quantité d’un article sérialisé correspond au nombre de numéros de série actifs enregistrés ({equipment.serialNumbers?.length ?? 0}). Les unités individuelles peuvent être gérées depuis la fiche détaillée de l&apos;article.
                </p>
              </div>
            )}

            {/* Mode 4: Already Standard & Staying Standard */}
            {!isConvertingToSerialized && !isConvertingToStandard && !hasSerialNumber && (
              <div>
                <label className="block text-xs font-medium text-white mb-1">
                  Quantité en stock <span className="text-rose-300">*</span>
                </label>
                <div className="relative">
                  <input
                    type="number"
                    min="0"
                    {...register('equipmentQuantity', { valueAsNumber: true })}
                    disabled={!canUpdateEquipment || isBusy}
                    className="w-full h-10 px-3 pl-8 rounded-lg border border-[#3f3a36] bg-[#2b2622] text-white placeholder-white/50 text-sm focus:outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20 transition-all"
                  />
                  <Hash className="w-4 h-4 text-white/60 absolute left-2.5 top-3" />
                </div>
                {errors.equipmentQuantity && (
                  <p className="mt-1 text-xs text-rose-300">{errors.equipmentQuantity.message}</p>
                )}
              </div>
            )}

            {/* Min Quantity Alert */}
            <div>
              <label className="block text-xs font-medium text-white mb-1">
                Seuil d’alerte (Quantité minimale)
              </label>
              <input
                type="number"
                min="0"
                {...register('minEquipmentQuantity', { valueAsNumber: true })}
                disabled={!canUpdateEquipment || isBusy}
                className="w-full h-10 px-3 rounded-lg border border-[#3f3a36] bg-[#2b2622] text-white placeholder-white/50 text-sm focus:outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20 transition-all"
              />
              {errors.minEquipmentQuantity && (
                <p className="mt-1 text-xs text-rose-300">{errors.minEquipmentQuantity.message}</p>
              )}
            </div>

            {/* Action Buttons */}
            <div className="flex items-center justify-end gap-3 pt-4 border-t border-[#3f3a36]/50">
              <button
                type="button"
                onClick={onClose}
                disabled={isBusy}
                className="px-4 py-2 text-xs font-medium text-white bg-white/10 border border-white/20 rounded-lg hover:bg-white/20 transition-colors cursor-pointer"
              >
                Annuler
              </button>
              <button
                type="submit"
                disabled={isBusy || !canUpdateEquipment}
                className="px-5 py-2 text-xs font-medium text-white bg-[#2b2622] border border-[#4d4742] rounded-lg hover:bg-[#3f3a36] active:scale-[0.98] disabled:opacity-50 transition-all flex items-center gap-2 shadow-sm cursor-pointer"
              >
                {isBusy && (
                  <div className="w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin" />
                )}
                {isConvertingToSerialized
                  ? 'Convertir en sérialisé & Enregistrer'
                  : isConvertingToStandard
                  ? 'Convertir en standard & Enregistrer'
                  : 'Enregistrer les modifications'}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/equipment/EquipmentDetailModal.tsx">
'use client';

import { useState, useMemo, useEffect } from 'react';
import { useQuery } from '@tanstack/react-query';
import { Equipment } from '@/types/equipment';
import { Movement } from '@/types/movement';
import { MovementService } from '@/services/movement.service';
import { useApi } from '@/hooks/use-api';
import { usePermissions } from '@/hooks/use-permissions';
import { getEquipmentVisualTheme } from './equipment-icons';
import {
  X,
  Copy,
  Check,
  Database,
  Hash,
  Layers,
  Code,
  Barcode,
  AlertTriangle,
  ArrowRightLeft,
  ArrowDownRight,
  ArrowUpRight,
  Package,
  Plus,
  Loader2,
  Search,
} from 'lucide-react';
import { toast } from 'sonner';

interface EquipmentDetailModalProps {
  equipment: Equipment | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  onOpenMovement?: (equipment: Equipment) => void;
  isLoading?: boolean;
}

export function EquipmentDetailModal({
  equipment,
  isOpen,
  onClose,
  onOpenMovement,
}: EquipmentDetailModalProps) {
  const api = useApi();
  const { permissions } = usePermissions();

  const [copiedId, setCopiedId] = useState(false);
  const [copiedSn, setCopiedSn] = useState<string | null>(null);
  const [snSearch, setSnSearch] = useState('');

  // ESC key listener to close modal
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        onClose();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isOpen, onClose]);

  // Movements query with TanStack Query
  const { data: movements = [], isLoading: isLoadingMovements } = useQuery<Movement[]>({
    queryKey: ['equipment-movements', equipment?.equipmentId],
    queryFn: () =>
      MovementService.getMovementsByEquipmentId(
        api,
        equipment!.equipmentId,
        { page: 1, limit: 100 },
        permissions,
      ),
    enabled: isOpen && !!equipment?.equipmentId,
    staleTime: 10 * 1000,
  });

  // Dynamic audit calculation: Initial Quantity + Total IN - Total OUT = Current Quantity
  const auditSummary = useMemo(() => {
    if (!equipment) return null;
    return MovementService.calculateMovementAudit(movements, equipment.equipmentQuantity);
  }, [movements, equipment]);

  const serials = useMemo(() => equipment?.serialNumbers ?? [], [equipment]);

  const filteredSerials = useMemo(() => {
    if (!snSearch.trim()) return serials;
    const term = snSearch.toLowerCase().trim();
    return serials.filter(
      (s) =>
        (s.serialNumberCode || '').toLowerCase().includes(term) ||
        (s.shelf?.shelfName || '').toLowerCase().includes(term) ||
        (s.serialNumberStatus || '').toLowerCase().includes(term)
    );
  }, [serials, snSearch]);

  if (!isOpen || !equipment) return null;

  const visualTheme = getEquipmentVisualTheme(equipment.equipmentName);
  const IconComp = visualTheme.icon;
  const displayQty = equipment.hasSerialNumber
    ? (equipment.serialNumbers?.length ?? equipment.equipmentQuantity)
    : equipment.equipmentQuantity;

  const handleCopyId = () => {
    navigator.clipboard.writeText(equipment.equipmentId);
    setCopiedId(true);
    toast.success('Identifiant copié !');
    setTimeout(() => setCopiedId(false), 2000);
  };

  const handleCopySerial = (code: string) => {
    navigator.clipboard.writeText(code);
    setCopiedSn(code);
    toast.success(`Numéro de série copié : ${code}`);
    setTimeout(() => setCopiedSn(null), 1500);
  };

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 bg-black/60 backdrop-blur-xs animate-in fade-in duration-150"
      onClick={onClose}
    >
      <div
        className="w-full max-w-4xl max-h-[92vh] flex flex-col bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden animate-in zoom-in-95 duration-150 text-left"
        role="dialog"
        aria-modal="true"
        aria-labelledby="equipment-detail-title"
        onClick={(e) => e.stopPropagation()}
      >
        {/* FIXED / STICKY HEADER WITH CLOSE BUTTON PROMINENTLY IN TOP-LEFT */}
        <div className="shrink-0 px-5 py-3.5 bg-[#26221f] border-b border-[#3f3a36] flex items-center justify-between gap-3 shadow-xs">
          {/* Top Left: Close Button + Article Identity */}
          <div className="flex items-center gap-3 min-w-0">
            {/* Top-Left Close Button requested by user */}
            <button
              type="button"
              onClick={onClose}
              className="inline-flex items-center gap-2 px-3 py-1.5 bg-[#383330] hover:bg-[#453f3a] text-white border border-[#4d4742] hover:border-[#6a625b] rounded-lg text-xs font-medium transition-all cursor-pointer shadow-xs group shrink-0"
              aria-label="Fermer la page"
              title="Fermer cette fiche (Échap)"
            >
              <X className="w-4 h-4 text-white/90 group-hover:text-white transition-transform group-hover:scale-110" />
              <span className="font-semibold">Fermer</span>
              <kbd className="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-white/60 bg-black/40 rounded border border-white/10">
                Échap
              </kbd>
            </button>

            <div className="h-5 w-px bg-[#3f3a36] shrink-0" />

            {/* Article icon & Title */}
            <div className="flex items-center gap-2.5 min-w-0">
              <div className="w-8 h-8 rounded-lg bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0] shrink-0">
                <IconComp className="w-4 h-4" />
              </div>
              <div className="min-w-0">
                <h1
                  id="equipment-detail-title"
                  className="text-sm sm:text-base font-semibold text-white truncate max-w-xs sm:max-w-md"
                >
                  {equipment.equipmentName ?? 'Article sans nom'}
                </h1>
                <div className="text-[11px] text-white/70">
                  {equipment.hasSerialNumber ? 'Article avec numéros de série' : 'Article standard'}
                </div>
              </div>
            </div>
          </div>

          {/* Top Right: Status Badge & Secondary Close Button */}
          <div className="flex items-center gap-2 shrink-0">
            <span className="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-950/40 text-emerald-300 border border-emerald-500/40 text-[11px] font-semibold">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
              En stock
            </span>
            <button
              type="button"
              onClick={onClose}
              className="p-1.5 text-white/60 hover:text-white hover:bg-white/10 rounded-md transition-colors cursor-pointer"
              aria-label="Fermer"
              title="Fermer"
            >
              <X className="w-4 h-4" />
            </button>
          </div>
        </div>

        {/* SCROLLABLE MODAL CONTENT */}
        <div className="flex-1 overflow-y-auto p-5 sm:p-6 space-y-6 custom-scrollbar bg-[#383330]">
          {/* Properties Table */}
          <div className="bg-[#2b2622]/80 border border-[#3f3a36] rounded-xl divide-y divide-[#3f3a36] text-xs text-white shadow-xs">
            {/* Property: GUID */}
            <div className="p-3 sm:p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/80 w-44 shrink-0">
                <Database className="w-3.5 h-3.5 text-[#10b981]" />
                <span className="font-medium">Identifiant</span>
              </div>
              <div className="flex items-center gap-2 font-mono text-[11px] text-white min-w-0">
                <span className="truncate max-w-sm sm:max-w-md select-all bg-[#1f1b18] px-2 py-1 rounded border border-[#3f3a36]">
                  {equipment.equipmentId}
                </span>
                <button
                  type="button"
                  onClick={handleCopyId}
                  className="p-1.5 text-white/80 hover:text-white rounded hover:bg-white/20 transition-colors cursor-pointer shrink-0"
                  title="Copier l'identifiant"
                >
                  {copiedId ? (
                    <Check className="w-3.5 h-3.5 text-emerald-300" />
                  ) : (
                    <Copy className="w-3.5 h-3.5" />
                  )}
                </button>
              </div>
            </div>

            {/* Property: Quantity & Stock Level */}
            <div className="p-3 sm:p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/80 w-44 shrink-0">
                <Hash className="w-3.5 h-3.5 text-[#10b981]" />
                <span className="font-medium">Quantité en stock</span>
              </div>
              <div className="flex items-center gap-2 flex-wrap">
                <span
                  className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold ${
                    displayQty > 0
                      ? 'bg-emerald-950/50 text-emerald-300 border border-emerald-500/50 shadow-xs'
                      : 'bg-amber-950/50 text-amber-300 border border-amber-500/50 shadow-xs'
                  }`}
                >
                  <Hash className="w-3 h-3" />
                  {displayQty} unités
                </span>
                {equipment.minequipmentQuantity !== undefined &&
                  displayQty <= equipment.minequipmentQuantity && (
                    <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-950/60 text-amber-200 border border-amber-400/50 text-[10px] font-bold">
                      <AlertTriangle className="w-3 h-3" />
                      Seuil d&apos;alerte ({equipment.minequipmentQuantity})
                    </span>
                  )}
              </div>
            </div>

            {/* Property: Traçabilité / Mode */}
            <div className="p-3 sm:p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/80 w-44 shrink-0">
                <Barcode className="w-3.5 h-3.5 text-[#10b981]" />
                <span className="font-medium">Mode de traçabilité</span>
              </div>
              <div>
                {equipment.hasSerialNumber ? (
                  <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#1f1b18] text-white font-semibold text-xs border border-[#3f3a36]">
                    <Barcode className="w-3.5 h-3.5 text-purple-400" />
                    <span>Sérialisé ({serials.length} numéros de série)</span>
                  </span>
                ) : (
                  <span className="text-white/80 font-medium">Stock quantitatif standard (sans numéro de série)</span>
                )}
              </div>
            </div>

            {/* Property: Emplacements */}
            <div className="p-3 sm:p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/80 w-44 shrink-0">
                <Layers className="w-3.5 h-3.5 text-[#10b981]" />
                <span className="font-medium">Emplacements</span>
              </div>
              <div className="flex flex-wrap gap-1.5 justify-start sm:justify-end">
                {equipment.equipmentShelfs && equipment.equipmentShelfs.length > 0 ? (
                  equipment.equipmentShelfs.map((es) => (
                    <span
                      key={es.equipmentShelfId}
                      className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#1f1b18] border border-[#3f3a36] text-xs font-medium text-white"
                    >
                      <Layers className="w-3 h-3 text-[#10b981]" />
                      <span>{es.shelf?.shelfName ?? 'Emplacement'}</span>
                      <span className="font-mono text-[11px] font-bold text-emerald-400">
                        ({es.equipmentQuantity} u.)
                      </span>
                    </span>
                  ))
                ) : (
                  <span className="text-white/60 italic">Non assigné à un emplacement</span>
                )}
              </div>
            </div>
          </div>

          {/* Child Serial Numbers Detailed Section */}
          {equipment.hasSerialNumber && (
            <div className="space-y-3 p-4 bg-[#2b2622]/60 border border-[#3f3a36] rounded-xl shadow-xs">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div className="flex items-center gap-2">
                  <div className="p-1.5 rounded-md bg-purple-950/40 border border-purple-800/40 text-purple-300">
                    <Barcode className="w-4 h-4" />
                  </div>
                  <div>
                    <h3 className="text-sm font-semibold text-white">
                      Numéros de série ({serials.length})
                    </h3>
                  </div>
                </div>

                {/* Quick search input */}
                {serials.length > 0 && (
                  <div className="relative w-full sm:w-60">
                    <Search className="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-white/50" />
                    <input
                      type="text"
                      value={snSearch}
                      onChange={(e) => setSnSearch(e.target.value)}
                      placeholder="Filtrer S/N ou emplacement..."
                      className="w-full h-8 pl-8 pr-3 bg-[#1f1b18] border border-[#3f3a36] rounded-md text-xs text-white placeholder-white/40 focus:border-[#10b981] focus:outline-none font-mono"
                    />
                    {snSearch && (
                      <button
                        type="button"
                        onClick={() => setSnSearch('')}
                        className="absolute right-2 top-1/2 -translate-y-1/2 text-white/50 hover:text-white"
                      >
                        <X className="w-3 h-3" />
                      </button>
                    )}
                  </div>
                )}
              </div>

              {serials.length === 0 ? (
                <div className="p-6 bg-[#1f1b18] border border-[#3f3a36] rounded-lg text-center text-xs text-white/70 italic">
                  Aucun numéro de série enregistré pour cet article.
                </div>
              ) : (
                <div className="border border-[#3f3a36] rounded-lg overflow-hidden max-h-72 overflow-y-auto bg-[#1f1b18] custom-scrollbar">
                  <table className="w-full text-xs text-left">
                    <thead className="bg-[#26221f] text-white font-semibold border-b border-[#3f3a36] sticky top-0 z-10 shadow-xs">
                      <tr>
                        <th className="py-2.5 px-3 w-12 text-center text-[10px] font-mono text-white/70">#</th>
                        <th className="py-2.5 px-3 text-[10px] font-mono uppercase tracking-wider text-white/70">Code de série</th>
                        <th className="py-2.5 px-3 text-center text-[10px] font-mono uppercase tracking-wider text-white/70">Statut</th>
                        <th className="py-2.5 px-3 text-[10px] font-mono uppercase tracking-wider text-white/70">Emplacement assigné</th>
                        <th className="py-2.5 px-3 text-right text-[10px] font-mono uppercase tracking-wider text-white/70">Action</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-[#332e2a]">
                      {filteredSerials.length === 0 ? (
                        <tr>
                          <td colSpan={5} className="py-6 text-center text-xs text-white/60">
                            Aucun numéro de série ne correspond à votre recherche.
                          </td>
                        </tr>
                      ) : (
                        filteredSerials.map((sn, sIdx) => (
                          <tr key={sn.serialNumberId} className="hover:bg-white/5 transition-colors group">
                            <td className="py-2 px-3 text-center font-mono text-[11px] text-white/50">
                              #{String(sIdx + 1).padStart(2, '0')}
                            </td>
                            <td className="py-2 px-3 font-mono font-medium text-white text-[11px]">
                              <span className="select-all">{sn.serialNumberCode ?? 'S/N inconnu'}</span>
                            </td>
                            <td className="py-2 px-3 text-center">
                              <span
                                className={`px-2 py-0.5 rounded text-[10px] font-semibold font-mono ${
                                  sn.serialNumberStatus === 'AVAILABLE'
                                    ? 'bg-emerald-950/60 text-emerald-300 border border-emerald-600/40'
                                    : 'bg-amber-950/60 text-amber-300 border border-amber-600/40'
                                }`}
                              >
                                {sn.serialNumberStatus ?? 'DISPO'}
                              </span>
                            </td>
                            <td className="py-2 px-3 text-white/80">
                              {sn.shelf?.shelfName ? (
                                <span className="inline-flex items-center gap-1.5 font-medium text-white text-[11px]">
                                  <Layers className="w-3 h-3 text-[#10b981]" />
                                  <span>{sn.shelf.shelfName}</span>
                                </span>
                              ) : (
                                <span className="text-white/40 text-[11px] italic">Non assigné</span>
                              )}
                            </td>
                            <td className="py-2 px-3 text-right">
                              {sn.serialNumberCode && (
                                <button
                                  type="button"
                                  onClick={() => handleCopySerial(sn.serialNumberCode!)}
                                  className="p-1 hover:text-white rounded hover:bg-white/10 transition-colors cursor-pointer inline-flex items-center gap-1 text-[11px] text-white/70"
                                  title="Copier le numéro"
                                >
                                  {copiedSn === sn.serialNumberCode ? (
                                    <Check className="w-3 h-3 text-emerald-300" />
                                  ) : (
                                    <Copy className="w-3 h-3" />
                                  )}
                                  <span className="hidden sm:inline">Copier</span>
                                </button>
                              )}
                            </td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}

          {/* Movement Audit & Quantity Calculation Ledger */}
          <div className="space-y-4 pt-2">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div className="flex items-center gap-2">
                <div className="p-1.5 rounded-md bg-[#2b2622] border border-[#3f3a36] text-[#10b981]">
                  <ArrowRightLeft className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="text-sm font-semibold text-white">
                    Audit & Calcul de Quantité par Mouvement
                  </h3>
                  <p className="text-[11px] text-white/60">
                    Formule dynamique : Stock actuel = Stock Initial + Entrées (IN) - Sorties (OUT)
                  </p>
                </div>
              </div>

              {onOpenMovement && (
                <button
                  type="button"
                  onClick={() => onOpenMovement(equipment)}
                  className="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#2b2622] hover:bg-[#383330] text-white text-xs font-medium rounded-lg border border-[#4d4742] shadow-xs transition-colors cursor-pointer shrink-0"
                >
                  <Plus className="w-3.5 h-3.5 text-[#10b981]" />
                  <span>Nouveau mouvement</span>
                </button>
              )}
            </div>

            {/* Dynamic Calculation 4-Tiles Cards */}
            {auditSummary && (
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                {/* Initial Stock */}
                <div className="p-3.5 bg-[#2b2622] border border-[#3f3a36] rounded-xl text-left space-y-1">
                  <div className="flex items-center justify-between text-white/70">
                    <span className="text-[10px] font-mono font-medium uppercase tracking-wider">Stock Initial</span>
                    <Package className="w-3.5 h-3.5 text-white/60" />
                  </div>
                  <div className="font-mono text-lg font-bold text-white">
                    {auditSummary.initialQuantity}
                  </div>
                  <div className="text-[10px] text-white/50">Origine / Base</div>
                </div>

                {/* Total IN */}
                <div className="p-3.5 bg-emerald-950/40 border border-emerald-500/40 rounded-xl text-left space-y-1 text-emerald-200">
                  <div className="flex items-center justify-between text-emerald-300">
                    <span className="text-[10px] font-mono font-medium uppercase tracking-wider">Entrées (+ IN)</span>
                    <ArrowDownRight className="w-3.5 h-3.5 text-emerald-400" />
                  </div>
                  <div className="font-mono text-lg font-bold text-emerald-300">
                    +{auditSummary.totalIn}
                  </div>
                  <div className="text-[10px] text-emerald-200/70">Total arrivages</div>
                </div>

                {/* Total OUT */}
                <div className="p-3.5 bg-amber-950/40 border border-amber-500/40 rounded-xl text-left space-y-1 text-amber-200">
                  <div className="flex items-center justify-between text-amber-300">
                    <span className="text-[10px] font-mono font-medium uppercase tracking-wider">Sorties (- OUT)</span>
                    <ArrowUpRight className="w-3.5 h-3.5 text-amber-400" />
                  </div>
                  <div className="font-mono text-lg font-bold text-amber-300">
                    -{auditSummary.totalOut}
                  </div>
                  <div className="text-[10px] text-amber-200/70">Consommé / Sorties</div>
                </div>

                {/* Current Total */}
                <div className="p-3.5 bg-[#2b2622] border border-emerald-500/50 rounded-xl text-left space-y-1 shadow-xs">
                  <div className="flex items-center justify-between text-emerald-300">
                    <span className="text-[10px] font-mono font-medium uppercase tracking-wider">Stock Actuel</span>
                    <Hash className="w-3.5 h-3.5 text-emerald-400" />
                  </div>
                  <div className="font-mono text-lg font-bold text-emerald-300">
                    {auditSummary.currentQuantity}
                  </div>
                  <div className="text-[10px] text-emerald-400/80">En temps réel</div>
                </div>
              </div>
            )}

            {/* Chronological Movements Ledger */}
            {isLoadingMovements ? (
              <div className="p-8 bg-[#2b2622]/40 border border-[#3f3a36] rounded-xl text-center text-xs text-white/70 flex items-center justify-center gap-2">
                <Loader2 className="w-4 h-4 animate-spin text-[#10b981]" />
                <span>Chargement de l&apos;historique des mouvements...</span>
              </div>
            ) : movements.length === 0 ? (
              <div className="p-5 bg-[#2b2622]/40 border border-[#3f3a36] rounded-xl text-center text-xs text-white/70 space-y-2">
                <p className="italic">Aucun mouvement individuel enregistré pour cet article.</p>
                {onOpenMovement && (
                  <button
                    type="button"
                    onClick={() => onOpenMovement(equipment)}
                    className="text-[#10b981] hover:underline font-medium inline-flex items-center gap-1 cursor-pointer"
                  >
                    <Plus className="w-3 h-3" />
                    <span>Créer le premier mouvement</span>
                  </button>
                )}
              </div>
            ) : (
              <div className="border border-[#3f3a36] rounded-xl overflow-hidden max-h-64 overflow-y-auto bg-[#1f1b18] custom-scrollbar shadow-xs">
                <table className="w-full text-xs text-left">
                  <thead className="bg-[#26221f] text-white font-semibold border-b border-[#3f3a36] sticky top-0 z-10 shadow-xs">
                    <tr>
                      <th className="py-2.5 px-3 w-10 text-center text-[10px] font-mono text-white/70">#</th>
                      <th className="py-2.5 px-3 text-center text-[10px] font-mono uppercase tracking-wider text-white/70">Type</th>
                      <th className="py-2.5 px-3 text-[10px] font-mono uppercase tracking-wider text-white/70">Source</th>
                      <th className="py-2.5 px-3 text-[10px] font-mono uppercase tracking-wider text-white/70">Destination</th>
                      <th className="py-2.5 px-3 text-[10px] font-mono uppercase tracking-wider text-white/70">Numéro de série</th>
                      <th className="py-2.5 px-3 text-center text-[10px] font-mono uppercase tracking-wider text-white/70">Quantité</th>
                      <th className="py-2.5 px-3 text-right text-[10px] font-mono uppercase tracking-wider text-white/70">Solde cumulé</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-[#332e2a]">
                    {auditSummary?.ledger.map((entry, idx) => {
                      const m = entry.movement;
                      const isEntry = entry.type === 'IN';
                      const isExit = entry.type === 'OUT';

                      return (
                        <tr key={m.mouvementEquipmentId ?? m.mouvementId} className="hover:bg-white/5 transition-colors">
                          <td className="py-2 px-3 text-center font-mono text-white/50 text-[11px]">
                            #{String(idx + 1).padStart(2, '0')}
                          </td>
                          <td className="py-2 px-3 text-center">
                            <span
                              className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold font-mono ${
                                isEntry
                                  ? 'bg-emerald-950/60 text-emerald-300 border border-emerald-500/40'
                                  : isExit
                                  ? 'bg-amber-950/60 text-amber-300 border border-amber-500/40'
                                  : 'bg-[#2b2622] text-white border border-[#3f3a36]'
                              }`}
                            >
                              {isEntry ? (
                                <>
                                  <ArrowDownRight className="w-2.5 h-2.5" />
                                  <span>+ IN</span>
                                </>
                              ) : isExit ? (
                                <>
                                  <ArrowUpRight className="w-2.5 h-2.5" />
                                  <span>- OUT</span>
                                </>
                              ) : (
                                <>
                                  <ArrowRightLeft className="w-2.5 h-2.5" />
                                  <span>TRANSFER</span>
                                </>
                              )}
                            </span>
                          </td>
                          <td className="py-2 px-3 text-white/80">
                            {m.sourceShelf?.shelfName ? (
                              <span className="inline-flex items-center gap-1 font-medium text-white">
                                <Layers className="w-3 h-3 text-[#10b981]" />
                                <span>{m.sourceShelf.shelfName}</span>
                              </span>
                            ) : (
                              <span className="font-mono text-[10px] text-white/60 bg-[#2b2622] border border-[#3f3a36] px-1.5 py-0.5 rounded">
                                INITIAL (Entrée)
                              </span>
                            )}
                          </td>
                          <td className="py-2 px-3 text-white/80">
                            {m.destinationShelf?.shelfName ? (
                              <span className="inline-flex items-center gap-1 font-medium text-white">
                                <Layers className="w-3 h-3 text-[#10b981]" />
                                <span>{m.destinationShelf.shelfName}</span>
                              </span>
                            ) : (
                              <span className="font-mono text-[10px] text-amber-300 bg-amber-950/40 border border-amber-400/40 px-1.5 py-0.5 rounded">
                                SORTIE (Décharge)
                              </span>
                            )}
                          </td>
                          <td className="py-2 px-3 font-mono text-[11px] text-white/90">
                            {m.serialNumber?.serialNumberCode ? (
                              <span className="inline-flex items-center gap-1 text-white font-medium">
                                <Barcode className="w-3 h-3 text-purple-400" />
                                <span>{m.serialNumber.serialNumberCode}</span>
                              </span>
                            ) : (
                              <span className="text-white/40 italic">—</span>
                            )}
                          </td>
                          <td className="py-2 px-3 text-center font-mono font-bold">
                            <span
                              className={
                                isEntry
                                  ? 'text-emerald-400'
                                  : isExit
                                  ? 'text-amber-400'
                                  : 'text-white'
                              }
                            >
                              {entry.delta > 0
                                ? `+${entry.delta}`
                                : entry.delta < 0
                                ? `${entry.delta}`
                                : `${m.mouvementQuantity ?? 1}`}
                            </span>
                          </td>
                          <td className="py-2 px-3 text-right font-mono font-bold text-white">
                            {entry.runningBalance} u.
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </div>

        {/* FIXED MODAL FOOTER */}
        <div className="shrink-0 px-5 py-3.5 bg-[#26221f] border-t border-[#3f3a36] flex items-center justify-between gap-3">
          <button
            type="button"
            onClick={handleCopyId}
            className="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#383330] hover:bg-[#453f3a] text-white border border-[#4d4742] text-xs font-medium rounded-lg transition-colors cursor-pointer shadow-xs"
          >
            <Copy className="w-3.5 h-3.5 text-white/80" />
            <span>Copier l'identifiant</span>
          </button>

          <button
            type="button"
            onClick={onClose}
            className="inline-flex items-center gap-2 px-4.5 py-2 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] text-xs font-semibold rounded-lg shadow-sm transition-colors cursor-pointer"
          >
            <X className="w-3.5 h-3.5" />
            <span>Fermer la fiche</span>
          </button>
        </div>
      </div>
    </div>
  );
}
