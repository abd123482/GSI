'use client';

import {
  useEffect,
  useState,
} from 'react';
import {
  AlertCircle,
  ArrowDownToLine,
  ArrowRightLeft,
  ArrowUpFromLine,
  Barcode,
  Loader2,
  Package,
  Pencil,
  Plus,
  Search,
  X,
} from 'lucide-react';

import type {
  Equipment,
  SerialNumber,
} from '@/types/equipment';

import type {
  Movement,
} from '@/types/movement';

import {
  useMovements,
} from '@/hooks/use-movements';

import {
  useCreateSerialNumber,
  useSerialNumbers,
} from '@/hooks/use-serial-numbers';

import { useQuery } from '@tanstack/react-query';
import { useApi } from '@/hooks/use-api';
import { EquipmentService } from '@/services/equipment.service';
import { MovementService } from '@/services/movement.service';

import {
  usePermissions,
} from '@/hooks/use-permissions';

interface EquipmentDetailModalProps {
  equipment: Equipment | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  onEditSerialNumber?: (
    serial: SerialNumber,
  ) => void;
  isLoading?: boolean;
}

function movementLabel(
  movement: Movement,
) {
  const status =
    movement.mouvementStatus
      ?.toUpperCase();

  if (
    status === 'IN' ||
    status === 'ENTRY' ||
    status === 'ENTRÉE'
  ) {
    return {
      text: 'ENTRÉE',
      icon:
        ArrowDownToLine,
    };
  }

  if (
    status === 'OUT' ||
    status === 'EXIT' ||
    status === 'SORTIE'
  ) {
    return {
      text: 'SORTIE',
      icon:
        ArrowUpFromLine,
    };
  }

  return {
    text: 'TRANSFERT',
    icon:
      ArrowRightLeft,
  };
}

function formatDate(
  value?: string | null,
) {
  if (!value) {
    return '—';
  }

  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return value;
  }

  return new Intl.DateTimeFormat(
    'fr-DZ',
    {
      dateStyle: 'short',
      timeStyle: 'short',
    },
  ).format(date);
}

export function EquipmentDetailModal({
  equipment,
  isOpen,
  onClose,
  onRefresh,
  onEditSerialNumber,
  isLoading = false,
}: EquipmentDetailModalProps) {
  const [
    serialPage,
    setSerialPage,
  ] = useState(1);

  const [
    movementPage,
    setMovementPage,
  ] = useState(1);

  const [
    serialSearch,
    setSerialSearch,
  ] = useState('');

  const [
    newSerialCode,
    setNewSerialCode,
  ] = useState('');

  const {
    permissions,
    canCreateSerialNumber,
    canUpdateSerialNumber,
  } = usePermissions();

  const createSerial =
    useCreateSerialNumber();

  useEffect(() => {
    setSerialPage(1);
    setMovementPage(1);
    setSerialSearch('');
    setNewSerialCode('');
  }, [
    equipment?.equipmentId,
    isOpen,
  ]);

  const serialized =
    Boolean(
      equipment
        ?.hasSerialNumber,
    );

  const serialQuery =
    useSerialNumbers(
      {
        page: serialPage,
        limit: 20,
        equipmentId:
          equipment
            ?.equipmentId,
        serialNumberCode:
          serialSearch.trim() ||
          undefined,
      },
      isOpen &&
        serialized &&
        Boolean(
          equipment
            ?.equipmentId,
        ),
    );

  const movementQuery =
    useMovements(
      {
        page:
          movementPage,
        limit: 20,
        equipmentId:
          equipment
            ?.equipmentId,
      },
      isOpen &&
        Boolean(
          equipment
            ?.equipmentId,
        ),
    );

  const api = useApi();

  const allocationQuery = useQuery({
    queryKey: ['equipment-allocations', equipment?.equipmentId],
    queryFn: () => EquipmentService.getEquipmentShelves(api, equipment!.equipmentId, permissions),
    enabled: isOpen && Boolean(equipment?.equipmentId),
    staleTime: 10_000,
  });

  const allSerialsQuery = useQuery({
    queryKey: ['equipment-all-serials', equipment?.equipmentId],
    queryFn: () => MovementService.getAllEquipmentSerials(api, equipment!.equipmentId, permissions),
    enabled: isOpen && serialized && Boolean(equipment?.equipmentId),
    staleTime: 60_000,
  });

  if (
    !isOpen ||
    !equipment
  ) {
    return null;
  }

  async function addSerial() {
    const code =
      newSerialCode.trim();

    if (
      !code ||
      !equipment
    ) {
      return;
    }

    await createSerial.mutateAsync({
      serialNumberCode:
        code,
      equipmentId:
        equipment.equipmentId,
      serialNumberStatus:
        'AVAILABLE',
    });

    setNewSerialCode('');

    await serialQuery.refetch();
    onRefresh?.();
  }

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3 backdrop-blur-sm sm:p-5">
      <div className="flex max-h-[94vh] w-full max-w-5xl flex-col overflow-hidden rounded-xl border border-[#3f3a36] bg-[#383330] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3a36] bg-[#26221f] px-5 py-4">
          <div>
            <h2 className="text-base font-semibold">
              {equipment.equipmentName ??
                'Article sans nom'}
            </h2>

            <p className="mt-0.5 text-[10px] text-white/45">
              {serialized
                ? 'Article sérialisé'
                : 'Article standard'}
              {' • '}
              {
                equipment.equipmentStatus
              }
            </p>
          </div>

          <div className="flex gap-1">
            {onRefresh && (
              <button
                type="button"
                onClick={
                  onRefresh
                }
                disabled={
                  isLoading
                }
                className="rounded p-2 text-white/60 hover:bg-white/10"
              >
                <Loader2
                  className={`h-4 w-4 ${
                    isLoading
                      ? 'animate-spin'
                      : ''
                  }`}
                />
              </button>
            )}

            <button
              type="button"
              onClick={onClose}
              className="rounded p-2 text-white/60 hover:bg-white/10"
            >
              <X className="h-4 w-4" />
            </button>
          </div>
        </header>

        <div className="flex-1 space-y-5 overflow-y-auto p-5">
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <Stat
              label="Quantité physique"
              value={String(
                equipment.equipmentQuantity,
              )}
              icon={
                <Package className="h-3.5 w-3.5" />
              }
            />

            <Stat
              label="Minimum"
              value={String(
                equipment.minequipmentQuantity,
              )}
            />

            <Stat
              label="Mode"
              value={
                serialized
