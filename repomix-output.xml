<file path="frontend/src/components/dashboard/DashboardCharts.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import {
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  Cell,
  CartesianGrid,
} from 'recharts';
import { ArrowRightLeft, Warehouse } from 'lucide-react';
import { DashboardStats } from '@/types/dashboard';

interface DashboardChartsProps {
  stats: DashboardStats;
}

export function DashboardCharts({ stats }: DashboardChartsProps) {
  const [isMounted, setIsMounted] = useState(false);

  useEffect(() => {
    setIsMounted(true);
  }, []);

  const { movementOverview, stockOverview } = stats;

  const movementData = [
    {
      name: 'Entrées (IN)',
      count: movementOverview.inCount,
      fill: '#10b981',
      description: 'Réceptions et créations',
    },
    {
      name: 'Sorties (OUT)',
      count: movementOverview.outCount,
      fill: '#ef4444',
      description: 'Consommation & maintenance',
    },
    {
      name: 'Transferts',
      count: movementOverview.transferCount,
      fill: '#38bdf8',
      description: 'Déplacements inter-rayons',
    },
    ...(movementOverview.mixedCount ? [{
      name: 'Mixtes', count: movementOverview.mixedCount, fill: '#a78bfa',
      description: 'Un document avec plusieurs directions',
    }] : []),
    ...(movementOverview.otherCount ? [{
      name: 'Autres', count: movementOverview.otherCount, fill: '#a1a1aa',
      description: 'Statuts historiques',
    }] : []),
  ];

  const warehouseData = stockOverview.stockDistribution.map((s) => ({
    name: s.stockName.length > 18 ? `${s.stockName.substring(0, 16)}...` : s.stockName,
    fullName: s.stockName,
    units: s.totalUnits,
    shelves: s.shelvesCount,
  }));

  if (!isMounted) {
    return (
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div className="h-72 bg-[#27272a] border border-[#3f3f46] rounded-[4px] animate-pulse" />
        <div className="h-72 bg-[#27272a] border border-[#3f3f46] rounded-[4px] animate-pulse" />
      </div>
    );
  }

  return (
    <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
      {/* 1. Movement Volume Chart */}
      <div className="p-4 bg-[#27272a] border border-[#3f3f46] rounded-[4px] shadow-2xs space-y-3">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <ArrowRightLeft className="w-4 h-4 text-[#f4f4f5]" />
            <h2 className="text-xs font-mono font-medium text-[#fafafa] uppercase tracking-wider">
              Flux des Mouvements de Stock
            </h2>
          </div>
          <span className="text-[11px] font-mono text-[#a1a1aa]">
            {movementOverview.totalMovements} mouvement{movementOverview.totalMovements > 1 ? 's' : ''} au total
          </span>
        </div>

        <div className="h-56 w-full pt-2">
          {movementOverview.totalMovements === 0 ? (
            <div className="h-full flex items-center justify-center text-xs font-mono text-[#a1a1aa]">
              Aucun mouvement enregistré pour le moment.
            </div>
          ) : (
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={movementData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="#3f3f46" vertical={false} />
                <XAxis
                  dataKey="name"
                  stroke="#a1a1aa"
                  tick={{ fill: '#a1a1aa', fontSize: 11, fontFamily: 'monospace' }}
                  tickLine={false}
                />
                <YAxis
                  stroke="#a1a1aa"
                  tick={{ fill: '#a1a1aa', fontSize: 11, fontFamily: 'monospace' }}
                  tickLine={false}
                  allowDecimals={false}
                />
                <Tooltip
                  content={({ active, payload }) => {
                    if (active && payload && payload.length) {
                      const data = payload[0].payload;
                      return (
                        <div className="bg-[#18181b] border border-[#3f3f46] p-2.5 rounded-[3px] shadow-xl text-xs font-mono">
                          <p className="font-semibold text-white">{data.name}</p>
                          <p className="text-[11px] text-[#a1a1aa]">{data.description}</p>
                          <p className="text-sm font-bold mt-1" style={{ color: data.fill }}>
                            {data.count} transaction{data.count > 1 ? 's' : ''}
                          </p>
                        </div>
                      );
                    }
                    return null;
                  }}
                />
                <Bar dataKey="count" radius={[3, 3, 0, 0]}>
                  {movementData.map((entry, index) => (
                    <Cell key={`cell-${index}`} fill={entry.fill} />
                  ))}
                </Bar>
              </BarChart>
            </ResponsiveContainer>
          )}
        </div>
      </div>

      {/* 2. Stock Distribution by Warehouse */}
      <div className="p-4 bg-[#27272a] border border-[#3f3f46] rounded-[4px] shadow-2xs space-y-3">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <Warehouse className="w-4 h-4 text-[#f4f4f5]" />
            <h2 className="text-xs font-mono font-medium text-[#fafafa] uppercase tracking-wider">
              Répartition du Stock par Dépôt
            </h2>
          </div>
          <span className="text-[11px] font-mono text-[#a1a1aa]">
            {warehouseData.length} entrepôt{warehouseData.length > 1 ? 's' : ''}
          </span>
        </div>

        <div className="h-56 w-full pt-2">
          {warehouseData.length === 0 ? (
            <div className="h-full flex items-center justify-center text-xs font-mono text-[#a1a1aa]">
              Aucun entrepôt configuré.
            </div>
          ) : (
            <ResponsiveContainer width="100%" height="100%">
              <BarChart
                data={warehouseData}
                layout="vertical"
                margin={{ top: 10, right: 20, left: 10, bottom: 0 }}
              >
                <CartesianGrid strokeDasharray="3 3" stroke="#3f3f46" horizontal={false} />
                <XAxis
                  type="number"
                  stroke="#a1a1aa"
                  tick={{ fill: '#a1a1aa', fontSize: 11, fontFamily: 'monospace' }}
                  tickLine={false}
                />
                <YAxis
                  type="category"
                  dataKey="name"
                  stroke="#a1a1aa"
                  tick={{ fill: '#fafafa', fontSize: 11, fontFamily: 'monospace' }}
                  tickLine={false}
                  width={110}
                />
                <Tooltip
                  content={({ active, payload }) => {
                    if (active && payload && payload.length) {
                      const data = payload[0].payload;
                      return (
                        <div className="bg-[#18181b] border border-[#3f3f46] p-2.5 rounded-[3px] shadow-xl text-xs font-mono">
                          <p className="font-semibold text-white">{data.fullName}</p>
                          <p className="text-[11px] text-[#a1a1aa] mt-0.5">{data.shelves} emplacements physiques</p>
                          <p className="text-sm font-bold text-[#10b981] mt-1">
                            {data.units} unité{data.units > 1 ? 's' : ''}
                          </p>
                        </div>
                      );
                    }
                    return null;
                  }}
                />
                <Bar dataKey="units" fill="#d97706" radius={[0, 3, 3, 0]} />
              </BarChart>
            </ResponsiveContainer>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/dashboard/DashboardTables.tsx">
'use client';

import React from 'react';
import Link from 'next/link';
import {
  ArrowRightLeft,
  ClipboardList,
  AlertTriangle,
  ArrowRight,
  CheckCircle2,
} from 'lucide-react';
import { DashboardStats } from '@/types/dashboard';

interface DashboardTablesProps {
  stats: DashboardStats;
}

export function DashboardTables({ stats }: DashboardTablesProps) {
  const { movementOverview, inventoryOverview, stockOverview } = stats;

  return (
    <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
      {/* Panel 1: Recent Movements (Takes 2 cols on lg screens) */}
      <div className="lg:col-span-2 p-4 bg-[#27272a] border border-[#3f3f46] rounded-[4px] shadow-2xs space-y-3">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <ArrowRightLeft className="w-4 h-4 text-[#f4f4f5]" />
            <h2 className="text-xs font-mono font-medium text-[#fafafa] uppercase tracking-wider">
              Derniers Mouvements Enregistrés
            </h2>
          </div>
          <Link
            href="/equipment"
            className="text-[11px] font-mono text-[#a1a1aa] hover:text-[#fafafa] inline-flex items-center gap-1 transition-colors"
          >
            <span>Historique complet</span>
            <ArrowRight className="w-3 h-3" />
          </Link>
        </div>

        {movementOverview.recentMovements.length === 0 ? (
          <div className="py-12 text-center text-xs font-mono text-[#a1a1aa]">
            Aucun mouvement récent enregistré.
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs font-mono">
              <thead className="bg-[#18181b] border-b border-[#3f3f46] text-[#a1a1aa] text-[10px] uppercase">
                <tr>
                  <th className="py-2 px-2.5">Type</th>
                  <th className="py-2 px-2.5">Article</th>
                  <th className="py-2 px-2.5 text-center">Quantité</th>
                  <th className="py-2 px-2.5">Trajet Emplacement</th>
                  <th className="py-2 px-2.5">N° Série</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#3f3f46]/60 text-[#f4f4f5]">
                {movementOverview.recentMovements.flatMap(header =>
                  header.items?.length ? header.items.map(item => ({ ...header, ...item, rowKey: item.mouvementEquipmentId })) : [{ ...header, rowKey: header.mouvementId }],
                ).map((m) => {
                  const typeUpper = m.mouvementStatus ? 'OUT' : 'IN';
                  const isIN = typeUpper === 'IN';
                  const isOUT = typeUpper === 'OUT';

                  return (
                    <tr key={m.rowKey} className="hover:bg-[#18181b]/50 transition-colors">
                      {/* Type Badge */}
                      <td className="py-2 px-2.5 whitespace-nowrap">
                        <span
                          className={`inline-flex items-center px-1.5 py-0.5 rounded-[2px] text-[10px] font-bold border ${
                            isIN
                              ? 'bg-[#162b22] text-[#10b981] border-[#1e3d30]'
                              : isOUT
                              ? 'bg-[#2d1616] text-[#ef4444] border-[#451e1e]'
                              : 'bg-[#152836] text-[#38bdf8] border-[#1c3c54]'
                          }`}
                        >
                          {m.mouvementStatus ? 'OUT' : 'IN'}
                        </span>
                      </td>

                      {/* Equipment Name */}
                      <td className="py-2 px-2.5 whitespace-nowrap font-medium text-[#fafafa] max-w-[180px] truncate">
                        {m.equipmentName}
                        <div className="text-[9px] text-[#a1a1aa]" title={m.mouvementId}>Mvt {m.mouvementId.slice(0, 8)}</div>
                      </td>

                      {/* Quantity */}
                      <td className="py-2 px-2.5 text-center whitespace-nowrap font-bold">
                        {m.mouvementQuantity} u.
                      </td>

                      {/* Path */}
                      <td className="py-2 px-2.5 whitespace-nowrap text-[11px] text-[#a1a1aa]">
                        <div className="flex items-center gap-1.5">
                          <span className="text-[#f4f4f5]">{m.sourceShelfName || 'Externe'}</span>
                          <span>→</span>
                          <span className="text-[#fafafa] font-medium">{m.destinationShelfName || 'Sortie'}</span>
                        </div>
                      </td>

                      {/* Serial Number */}
                      <td className="py-2 px-2.5 whitespace-nowrap text-[11px]">
                        {m.serialNumberCode ? (
                          <span className="text-[#fafafa] bg-[#18181b] px-1.5 py-0.5 rounded border border-[#3f3f46]">
                            {m.serialNumberCode}
                          </span>
                        ) : (
                          <span className="text-[#a1a1aa]/50">—</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
