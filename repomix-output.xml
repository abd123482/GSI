<file path="src/lib/movement-draft.ts">
import type { Equipment } from '@/types/equipment';
import type {
  CreateMovementInput,
  CreateMovementItemInput,
  MovementType,
} from '@/types/movement';

const SQL_INT_MAX = 2_147_483_647;
const MAX_MOVEMENT_LINES = 100;

export interface MovementDraft {
  id: string;
  equipment: Equipment;

  /**
   * Used only for standard/non-serialized equipment.
   */
  quantity: number;

  /**
   * Used only for serialized equipment.
   * One selected serial becomes one movement item with quantity = 1.
   */
  serialNumberIds: string[];
}

export interface BuildMovementPayloadArgs {
  movementType: MovementType;
  sourceShelfId?: string | null;
  destinationShelfId?: string | null;
  drafts: MovementDraft[];
}

export function createMovementDraft(
  equipment: Equipment,
  id = equipment.equipmentId,
): MovementDraft {
  return {
    id,
    equipment,
    quantity: 1,
    serialNumberIds: [],
  };
}

function normalizeShelfId(value?: string | null): string | null {
  const normalized = value?.trim();
  return normalized ? normalized : null;
}

function getStandardAvailableQuantity(
  equipment: Equipment,
  shelfId: string,
): number {
  return (
    equipment.equipmentShelfs
      ?.filter(
        (row) =>
          row.shelfId.toLowerCase() === shelfId.toLowerCase(),
      )
      .reduce(
        (sum, row) =>
          sum + Number(row.equipmentQuantity || 0),
        0,
      ) ?? 0
  );
}

/**
 * Builds one canonical V3 movement document.
 *
 * V3 invariant:
 * - movement type is selected ONCE
 * - source is selected ONCE
 * - destination is selected ONCE
 * - child items contain only equipment/serial/quantity
 */
export function buildMovementPayload({
  movementType,
  sourceShelfId,
  destinationShelfId,
  drafts,
}: BuildMovementPayloadArgs): CreateMovementInput {
  if (!drafts.length) {
    throw new Error('Sélectionnez au moins un article.');
  }

  const source = normalizeShelfId(sourceShelfId);
  const destination = normalizeShelfId(destinationShelfId);

  if (movementType === 'IN') {
    if (source) {
      throw new Error(
        'Une entrée ne doit pas avoir d’emplacement source.',
      );
    }

    if (!destination) {
      throw new Error(
        'Choisissez un emplacement de destination.',
      );
    }
  }

  if (movementType === 'OUT') {
    if (!source) {
      throw new Error(
        'Choisissez un emplacement source.',
      );
    }

    if (destination) {
      throw new Error(
        'Une sortie ne doit pas avoir d’emplacement de destination.',
      );
    }
  }

  if (movementType === 'TRANSFER') {
    if (!source || !destination) {
      throw new Error(
        'Choisissez un emplacement source et un emplacement de destination.',
      );
    }

    if (source.toLowerCase() === destination.toLowerCase()) {
      throw new Error(
        'La source et la destination doivent être différentes.',
      );
    }
  }

  const items: CreateMovementItemInput[] = [];
  const selectedSerialIds = new Set<string>();
  const selectedStandardEquipmentIds = new Set<string>();

  for (const draft of drafts) {
    const equipment = draft.equipment;
    const equipmentId = equipment.equipmentId;
    const equipmentName =
      equipment.equipmentName ?? equipment.equipmentId;

    const fail = (message: string): never => {
      throw new Error(`${equipmentName} : ${message}`);
    };

    if (!equipmentId) {
      fail('identifiant article manquant.');
    }

    if (equipment.hasSerialNumber) {
      if (!draft.serialNumberIds.length) {
        fail('sélectionnez au moins un numéro de série.');
      }

      for (const serialNumberId of draft.serialNumberIds) {
        const normalizedSerialId =
          serialNumberId.trim().toLowerCase();

        if (!normalizedSerialId) {
          fail('numéro de série invalide.');
        }

        if (selectedSerialIds.has(normalizedSerialId)) {
          fail(
            'un numéro de série est sélectionné plusieurs fois.',
          );
        }

        selectedSerialIds.add(normalizedSerialId);

        items.push({
          equipmentId,
          serialNumberId,
          movementQuantity: 1,
        });
      }

      continue;
    }

    const normalizedEquipmentId =
      equipmentId.toLowerCase();

    if (
      selectedStandardEquipmentIds.has(
        normalizedEquipmentId,
      )
    ) {
      fail(
        'un article standard ne peut apparaître qu’une seule fois dans le même mouvement.',
      );
    }

    selectedStandardEquipmentIds.add(
      normalizedEquipmentId,
    );

    if (
      !Number.isInteger(draft.quantity) ||
      draft.quantity <= 0
    ) {
      fail(
        'la quantité doit être un entier strictement positif.',
      );
    }

    if (draft.quantity > SQL_INT_MAX) {
      fail('la quantité est trop élevée.');
    }

    if (
      (movementType === 'OUT' ||
        movementType === 'TRANSFER') &&
      source
    ) {
      const available =
        getStandardAvailableQuantity(
          equipment,
          source,
        );

      if (draft.quantity > available) {
        fail(
          `stock insuffisant sur la source (${available} disponible(s)).`,
        );
      }
    }

    items.push({
      equipmentId,
      movementQuantity: draft.quantity,
    });
  }

  if (items.length > MAX_MOVEMENT_LINES) {
    throw new Error(
      `Un mouvement accepte au maximum ${MAX_MOVEMENT_LINES} lignes.`,
    );
  }

  const total = items.reduce(
    (sum, item) =>
      sum + item.movementQuantity,
    0,
  );

  if (total > SQL_INT_MAX) {
    throw new Error(
      'La quantité totale du mouvement est trop élevée.',
    );
  }

  return {
    movementType,
    
    
    items,
  };
}
</file>

<file path="src/lib/movement-ledger.ts">
import type {
  Movement,
  MovementAuditSummary,
  MovementLedgerEntry,
  MovementType,
} from '@/types/movement';

function canonicalType(movement: Movement): MovementType {
  const status = movement.mouvementStatus?.toUpperCase();

  if (
    status === 'IN' ||
    status === 'ENTRY' ||
    status === 'ENTRÉE'
  ) {
    return 'IN';
  }

  if (
    status === 'OUT' ||
    status === 'EXIT' ||
    status === 'SORTIE'
  ) {
    return 'OUT';
  }

  if (status === 'TRANSFER') {
    return 'TRANSFER';
  }

  // Historical fallback only.
  if (!movement.sourceShelfId && movement.destinationShelfId) {
    return 'IN';
  }

  if (movement.sourceShelfId && !movement.destinationShelfId) {
    return 'OUT';
  }

  return 'TRANSFER';
}

/**
 * Flatten V3 movement headers into line-shaped records for equipment history.
 *
 * New creation never uses per-line routes/types, but the backend still mirrors
 * those values on MovementEquipment for traceability. Historical aliases are
 * kept readable here only.
 */
export function flattenMovementLines(
  movements: Movement[],
  equipmentId?: string,
): Movement[] {
  const unique = new Map<string, Movement>();
  const equipmentFilter = equipmentId?.toLowerCase();

  for (const header of movements) {
    if (header.items?.length) {
      for (const item of header.items) {
        if (
          equipmentFilter &&
          item.equipmentId.toLowerCase() !== equipmentFilter
        ) {
          continue;
        }

        const line: Movement = {
          ...header,
          mouvementEquipmentId: item.mouvementEquipmentId,
          equipmentId: item.equipmentId,
          serialNumberId: item.serialNumberId,
          mouvementQuantity: item.mouvementQuantity,
          mouvementStatus:
            item.mouvementStatus ?? header.mouvementStatus,
          sourceShelfId:
            item.sourceShelfId ?? header.sourceShelfId,
          destinationShelfId:
            item.destinationShelfId ?? header.destinationShelfId,
          equipment: item.equipment ?? header.equipment,
          serialNumber: item.serialNumber ?? header.serialNumber,
          sourceShelf: item.sourceShelf ?? header.sourceShelf,
          destinationShelf:
            item.destinationShelf ?? header.destinationShelf,
          items: undefined,
        };

        unique.set(
          item.mouvementEquipmentId.toLowerCase(),
          line,
        );
      }

      continue;
    }

    if (
      equipmentFilter &&
      header.equipmentId?.toLowerCase() !== equipmentFilter
    ) {
      continue;
    }

    unique.set(
      (
        header.mouvementEquipmentId ??
        header.mouvementId
      ).toLowerCase(),
      header,
    );
  }

  const time = (value?: string | null) => {
    if (!value) return 0;
    const parsed = Date.parse(value);
    return Number.isFinite(parsed) ? parsed : 0;
  };

  return [...unique.values()].sort(
    (a, b) =>
      time(a.createdAt) -
      time(b.createdAt) ||
      a.mouvementId.localeCompare(b.mouvementId) ||
      (a.mouvementEquipmentId ?? '').localeCompare(
        b.mouvementEquipmentId ?? '',
      ),
  );
}

/**
 * Standard-equipment global stock audit:
 * initial + IN - OUT = current.
 *
 * TRANSFER has zero impact on global equipmentQuantity.
 *
 * Do not use this global-balance formula for serialized equipment because
 * serialized equipmentQuantity is the number of serial identities and is
 * maintained by SerialNumber create/delete, not by movements.
 */
export function calculateMovementAudit(
  movements: Movement[],
  currentStock: number,
  equipmentId?: string,
): MovementAuditSummary {
  const lines = flattenMovementLines(
    movements,
    equipmentId,
  );

  const equipmentIds = new Set(
    lines
      .map((line) => line.equipmentId?.toLowerCase())
      .filter(Boolean),
  );

  if (equipmentIds.size > 1) {
    throw new Error(
      'An equipment ID is required to calculate a multi-equipment ledger',
    );
  }

  let totalIn = 0;
  let totalOut = 0;

  for (const line of lines) {
    const type = canonicalType(line);
    const quantity = line.mouvementQuantity ?? 0;

    if (type === 'IN') totalIn += quantity;
    if (type === 'OUT') totalOut += quantity;
  }

  const initialQuantity = Math.max(
    0,
    currentStock - totalIn + totalOut,
  );

  let runningBalance = initialQuantity;

  const ledger: MovementLedgerEntry[] = lines.map(
    (movement) => {
      const type = canonicalType(movement);
      const quantity = movement.mouvementQuantity ?? 0;

      const delta =
        type === 'IN'
          ? quantity
          : type === 'OUT'
            ? -quantity
            : 0;

      runningBalance += delta;

      return {
        movement,
        type,
        delta,
        runningBalance,
      };
    },
  );

  return {
    initialQuantity,
    totalIn,
    totalOut,
    currentQuantity: currentStock,
    ledger,
  };
}
</file>

