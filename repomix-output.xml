USE [yacinedb_rebuild_test];
GO

SELECT
    @@SERVERNAME AS CurrentServer,
    DB_NAME() AS CurrentDatabase;

SELECT
    name AS TableName
FROM sys.tables
WHERE name IN (
    'Role',
    'Permission',
    'User',
    'StockStatus',
    'Stock',
    'Shelf',
    'Equipment',
    'EquipmentShelfs',
    'SerialNumber',
    'Mouvement',
    'MovementEquipment',
    'Inventory',
    'Inventory_User',
    'Order',
    'InventoryWorkUnit',
    'InventoryCountAttempt',
    'Inventory_Equipment_Shelf_Snapshot',
    'Inventory_SerialNumber_Snapshot',
    'InventoryInvestigationIssue',
    'Notification'
)
ORDER BY name;

SELECT
    stockStatusId,
    stockStatusName
FROM dbo.StockStatus
ORDER BY stockStatusName;

SELECT
    r.roleName,
    COUNT(p.permissionId) AS PermissionCount
FROM dbo.Role r
LEFT JOIN dbo.Permission p
    ON p.roleId = r.roleId
GROUP BY r.roleId, r.roleName
ORDER BY r.roleName;

SELECT
    OBJECT_NAME(parent_object_id) AS TableName,
    name AS ForeignKeyName,
    is_disabled AS IsDisabled,
