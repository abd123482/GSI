                  <div className="flex items-center justify-between pb-3 border-b border-[#3f3a36]">
                    <div className="flex items-center gap-2">
                      <Layers className="w-5 h-5 text-[#10b981]" />
                      <h3 className="text-base font-semibold text-[#f7f5f0]">
                        Ajouter un emplacement pour cet article
                      </h3>
                    </div>
                    <button
                      type="button"
                      onClick={() => setIsAddShelfModalOpen(false)}
                      className="text-[#aea69c] hover:text-[#f7f5f0] cursor-pointer text-lg leading-none"
                    >
                      ×
                    </button>
                  </div>

                  <div className="space-y-2">
                    <input
                      type="text"
                      placeholder="Rechercher un emplacement..."
                      value={shelfModalSearch}
                      onChange={(e) => setShelfModalSearch(e.target.value)}
                      className="w-full h-9 px-3 text-xs bg-[#383330] border border-[#3f3a36] rounded-[3px] text-[#f7f5f0] placeholder:text-[#6a625b] font-mono focus:outline-none focus:border-[#10b981]"
                    />
                  </div>

                  <div className="max-h-60 overflow-y-auto space-y-1.5 pr-1">
                    {availableOtherShelves
                      .filter((s: any) =>
                        !shelfModalSearch.trim() ||
                        s.shelfName?.toLowerCase().includes(shelfModalSearch.trim().toLowerCase())
                      )
                      .map((sh: any) => (
                        <div
                          key={`modal-shelf-${sh.shelfId}`}
                          className="flex items-center justify-between p-2.5 bg-[#26221f] border border-[#3f3a36] rounded-[3px] hover:border-[#10b981] transition-colors"
                        >
                          <div className="flex items-center gap-2">
                            <Layers className="w-4 h-4 text-[#10b981]" />
                            <span className="text-xs font-semibold text-[#f7f5f0]">{sh.shelfName}</span>
                          </div>
                          <button
                            type="button"
                            onClick={() => {
                              setExtraArticleShelves((prev) => [
                                ...prev,
                                { shelfId: sh.shelfId, shelfName: sh.shelfName },
                              ]);
                              setIsAddShelfModalOpen(false);
                              toast.success(`Emplacement "${sh.shelfName}" ajouté`);
                            }}
                            className="px-3 py-1 bg-[#10b981] hover:bg-[#059669] text-[#1f1b18] text-xs font-semibold rounded-[2px] transition-colors cursor-pointer flex items-center gap-1"
                          >
                            <Plus className="w-3.5 h-3.5" /> Ajouter
                          </button>
                        </div>
                      ))}
                    {availableOtherShelves.length === 0 && (
                      <p className="text-xs text-[#aea69c] text-center py-3">
                        Tous les emplacements du magasin sont déjà affichés.
                      </p>
                    )}
                  </div>
                </div>
              </div>
            )}
          </>
        )}

        {/* ========================================================================= */}
        {/* MODAL: ADD ARTICLE TO CURRENT SHELF (Catalog Picker)                     */}
        {/* ========================================================================= */}
        {isAddArticleModalOpen && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-4 backdrop-blur-xs">
            <div className="bg-[#2f2a26] border border-[#3f3a36] rounded-[4px] max-w-lg w-full p-5 space-y-4 shadow-xl">
              <div className="flex items-center justify-between pb-3 border-b border-[#3f3a36]">
                <div className="flex items-center gap-2">
                  <Package className="w-5 h-5 text-[#10b981]" />
                  <h3 className="text-base font-semibold text-[#f7f5f0]">
                    Ajouter un article sur "{targetShelfName}"
                  </h3>
                </div>
                <button
                  type="button"
                  onClick={() => setIsAddArticleModalOpen(false)}
                  className="p-1 rounded text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#383330] cursor-pointer"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>

              <div className="relative">
                <Search className="absolute left-2.5 top-2.5 w-4 h-4 text-[#aea69c]" />
                <input
                  type="text"
                  placeholder="Rechercher par nom d'article dans le catalogue..."
                  value={catalogSearch}
                  onChange={(e) => setCatalogSearch(e.target.value)}
                  className="w-full h-9 pl-9 pr-3 text-xs bg-[#1f1b18] border border-[#3f3a36] rounded-[3px] text-[#f7f5f0] placeholder:text-[#6a625b] font-mono focus:outline-none focus:border-[#10b981]"
                />
              </div>

              <div className="max-h-60 overflow-y-auto space-y-1.5 pr-1">
                {availableCatalogEquipments.length === 0 ? (
                  <div className="text-center py-6 text-xs text-[#aea69c]">
                    Aucun article disponible à ajouter.
                  </div>
                ) : (
                  availableCatalogEquipments.map((eq: any) => (
                    <div
                      key={`cat-${eq.equipmentId}`}
                      className="p-2.5 rounded-[3px] border border-[#3f3a36] bg-[#26221f] hover:border-[#aea69c] flex items-center justify-between gap-2 transition-colors"
                    >
                      <div>
                        <span className="text-xs font-medium text-[#f7f5f0] block">
                          {eq.equipmentName}
                        </span>
                        <span className="text-[10px] font-mono text-[#aea69c] flex items-center gap-1.5">
                          {eq.hasSerialNumber ? (
                            <span className="text-[#c9c0ad]">● Sérialisé (N° de série)</span>
                          ) : (
                            <span className="text-[#10b981]">● Quantitatif</span>
                          )}
                          <span>Stock global : {eq.equipmentQuantity ?? 0}</span>
                        </span>
                      </div>
                      <button
                        type="button"
                        onClick={() => handleAddEquipmentFromCatalog(eq)}
                        className="px-3 py-1 bg-[#10b981] hover:bg-[#059669] text-[#1f1b18] text-xs font-semibold rounded-[2px] transition-colors cursor-pointer shrink-0 flex items-center gap-1"
                      >
                        <Plus className="w-3 h-3" />
                        <span>Ajouter</span>
                      </button>
                    </div>
                  ))
                )}
              </div>

              <div className="pt-2 border-t border-[#3f3a36] flex justify-end">
                <button
                  type="button"
                  onClick={() => setIsAddArticleModalOpen(false)}
                  className="px-4 py-2 bg-[#383330] hover:bg-[#3f3a36] text-xs text-[#f7f5f0] rounded-[3px] cursor-pointer"
                >
                  Fermer
                </button>
              </div>
            </div>
          </div>
        )}

        {/* ========================================================================= */}
        {/* MODAL: CAMERA QR / BARCODE SCANNER                                        */}
        {/* ========================================================================= */}
        {isCameraScannerOpen && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-4 backdrop-blur-md">
            <div className="bg-[#26221f] border border-[#3f3a36] rounded-[6px] max-w-md w-full overflow-hidden shadow-2xl flex flex-col">
              {/* Header */}
              <div className="p-4 bg-[#1f1b18] border-b border-[#3f3a36] flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Camera className="w-5 h-5 text-[#10b981]" />
                  <div>
                    <h3 className="text-sm font-semibold text-[#f7f5f0]">Scanner QR & Code-barres</h3>
                    <p className="text-[10px] font-mono text-[#aea69c]">Caméra active en continu</p>
                  </div>
                </div>
                <button
                  type="button"
                  onClick={stopCameraScanner}
                  className="p-1.5 rounded text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#383330] cursor-pointer"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              {/* Viewfinder Viewport */}
              <div className="relative aspect-square w-full bg-black flex items-center justify-center overflow-hidden">
                <video
                  ref={videoRef}
                  autoPlay
                  playsInline
                  muted
                  className="w-full h-full object-cover"
                />

                {/* Guide overlay viewport frame */}
                <div className="absolute inset-0 pointer-events-none flex items-center justify-center">
                  <div className="w-64 h-64 border-2 border-[#10b981] rounded-lg relative shadow-[0_0_0_9999px_rgba(0,0,0,0.5)]">
                    <div className="absolute top-0 left-0 w-4 h-4 border-t-4 border-l-4 border-[#10b981] -mt-1 -ml-1" />
                    <div className="absolute top-0 right-0 w-4 h-4 border-t-4 border-r-4 border-[#10b981] -mt-1 -mr-1" />
                    <div className="absolute bottom-0 left-0 w-4 h-4 border-b-4 border-l-4 border-[#10b981] -mb-1 -ml-1" />
                    <div className="absolute bottom-0 right-0 w-4 h-4 border-b-4 border-r-4 border-[#10b981] -mb-1 -mr-1" />
                    <div className="absolute inset-x-0 top-1/2 h-0.5 bg-red-500/80 animate-pulse" />
                  </div>
                </div>

                {!isCameraActive && (
                  <div className="absolute inset-0 bg-[#1f1b18] flex flex-col items-center justify-center p-6 text-center space-y-2">
                    <Loader2 className="w-8 h-8 animate-spin text-[#10b981]" />
                    <span className="text-xs text-[#aea69c]">Initialisation de la caméra...</span>
                  </div>
                )}
              </div>

              {/* Footer notice */}
              <div className="p-4 bg-[#1f1b18] border-t border-[#3f3a36] flex items-center justify-between">
                <span className="text-xs text-[#aea69c] font-mono">
                  Pointez vers le code pour l'ajouter automatiquement
                </span>
                <button
                  type="button"
                  onClick={stopCameraScanner}
                  className="px-4 py-2 bg-[#f7f5f0] text-[#2b2622] font-semibold text-xs rounded-[3px] hover:bg-[#dad2c1] cursor-pointer"
                >
                  Terminer
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </main>
  );
}
</file>

<file path="frontend/src/app/page.tsx">
'use client';

import React from 'react';
import { useAuth } from '@clerk/nextjs';
import { Loader2 } from 'lucide-react';
import { usePermissions } from '@/hooks/use-permissions';
import { useDashboard } from '@/hooks/use-dashboard';
import { DashboardHeader } from '@/components/dashboard/DashboardHeader';
import { DashboardKpiGrid } from '@/components/dashboard/DashboardKpiGrid';
import { DashboardCharts } from '@/components/dashboard/DashboardCharts';
import { DashboardTables } from '@/components/dashboard/DashboardTables';
import { DashboardRestrictedView } from '@/components/dashboard/DashboardRestrictedView';
import { DashboardGuestView } from '@/components/dashboard/DashboardGuestView';

export default function HomePage() {
  const { isSignedIn, isLoaded } = useAuth();
  const {
    authUser,
    roleName,
    isAdmin,
    canReadDashboard,
    canCreateEquipment,
    canCreateInventory,
    canManageRoles,
    canReadEquipment,
    canReadShelf,
    canReadStock,
    canReadInventory,
    isLoading: isAuthLoading,
  } = usePermissions();

  const {
    stats,
    isLoading: isDashboardLoading,
    refetch,
    isRefetching,
  } = useDashboard();

  // 1. Loading State
  if (!isLoaded || isAuthLoading) {
    return (
      <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex items-center justify-center">
        <div className="flex items-center gap-2.5 text-xs font-mono text-[#aea69c]">
          <Loader2 className="w-4 h-4 animate-spin text-[#f7f5f0]" />
          <span>Chargement de l'espace Somépharm...</span>
        </div>
      </main>
    );
  }

  // 2. Unauthenticated Guest View
  if (!isSignedIn) {
    return (
      <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
        <DashboardGuestView />
      </main>
    );
  }

  // 3. Authenticated but lacks dashboard.read Permission
  if (!canReadDashboard) {
    return (
      <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
        <DashboardRestrictedView
          userName={authUser?.userName}
          roleName={roleName}
          canReadEquipment={canReadEquipment}
          canReadShelves={canReadShelf}
          canReadStock={canReadStock}
          canReadInventory={canReadInventory}
        />
      </main>
    );
  }

  // 4. Authorized Executive Dashboard View (Admin or dashboard.read)
  return (
    <main className="min-h-[calc(100vh-3.5rem)] bg-[#2b2622] text-[#f7f5f0] flex flex-col">
      <div className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">
        {/* Header */}
        <DashboardHeader
          userName={authUser?.userName}
          roleName={roleName}
          isAdmin={isAdmin}
        />

        {isDashboardLoading && !stats ? (
          <div className="py-24 flex flex-col items-center justify-center gap-2 text-xs font-mono text-[#aea69c]">
            <Loader2 className="w-5 h-5 animate-spin text-[#f7f5f0]" />
            <span>Chargement des indicateurs et graphiques du tableau de bord...</span>
          </div>
        ) : stats ? (
          <>
            {/* Row 1: KPI Cards Grid */}
            <DashboardKpiGrid stats={stats} />

            {/* Row 2: Recharts Visualizations (Flux & Entrepôts) */}
            <DashboardCharts stats={stats} />

            {/* Row 3: Operational Data Tables (Mouvements, Inventaires, Alertes) */}
            <DashboardTables stats={stats} />
          </>
        ) : (
          <div className="py-20 text-center text-xs font-mono text-rose-400 bg-[#2d1616] border border-[#451e1e] rounded p-6">
            Impossible de charger les données du tableau de bord. Veuillez vérifier votre connexion au serveur backend.
          </div>
        )}
      </div>
    </main>
  );
}
</file>

<file path="frontend/src/components/shelf/CreateShelfModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState, useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { createShelfSchema, CreateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import { Stock } from '@/types/stock';
import { REQUIRED_CREATE_PERMISSION } from '@/services/shelf.service';
import { InsufficientPermissionException } from '@/services/shelf.errors';
import {
  X,
  Plus,
  Loader2,
  ShieldAlert,
  Layers,
  Hash,
  Warehouse,
  Database,
  AlertCircle,
} from 'lucide-react';

const DEFAULT_STOCK_ID = '606d4178-e0a8-48b9-be6d-9538fa61135a';

interface CreateShelfModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function CreateShelfModal({ isOpen, onClose, onSuccess }: CreateShelfModalProps) {
  const api = useApi();
  const { createShelf, isCreating } = useShelves();
  const { canCreateShelf, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [stocks, setStocks] = useState<Stock[]>([]);
  const [isLoadingStocks, setIsLoadingStocks] = useState(false);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors, isSubmitting },
  } = useForm<CreateShelfFormValues>({
    resolver: zodResolver(createShelfSchema),
    defaultValues: {
      shelfName: '',
      shelfCode: '',
      stockId: DEFAULT_STOCK_ID,
    },
    mode: 'onChange',
  });

  useEffect(() => {
    if (isOpen) {
      let isMounted = true;
      setIsLoadingStocks(true);
      StockService.getAllStocks(api, { limit: 100 })
        .then((res) => {
          if (isMounted && res?.stocks) {
            setStocks(res.stocks);
          }
        })
        .catch((err) => {
          console.warn('[CreateShelfModal] Failed to load stocks list:', err);
        })
        .finally(() => {
          if (isMounted) setIsLoadingStocks(false);
        });
      return () => {
        isMounted = false;
      };
    }
  }, [isOpen, api]);

  if (!isOpen) return null;

  const onSubmit = async (values: CreateShelfFormValues) => {
    setServerError(null);

    // Explicit client-side permission enforcement check
    if (!canCreateShelf) {
      const err = new InsufficientPermissionException(
        REQUIRED_CREATE_PERMISSION,
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne dispose pas de la permission '${REQUIRED_CREATE_PERMISSION}' requise pour insérer un nouvel emplacement.`,
      );
      setServerError(err.message);
      throw err;
    }

    try {
      await createShelf(values);
      reset();
      onClose();
      if (onSuccess) onSuccess();
    } catch (err: unknown) {
      console.error('[CreateShelfModal] Failed to submit shelf:', err);
      setServerError(getErrorMessage(err, 'Échec de la création de l’emplacement'));
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-xs p-4 animate-in fade-in duration-150">
      {/* Modal Surface (#6b7b97 Theme) */}
      <div
        className="w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-xl overflow-hidden animate-in zoom-in-95 duration-150"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        {/* Modal Header */}
        <div className="px-6 py-5 border-b border-[#3f3a36] flex items-center justify-between bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0]">
              <Layers className="w-5 h-5" />
            </div>
            <div>
              <h2 id="modal-title" className="text-lg font-semibold text-white tracking-tight">
                Nouvel emplacement
              </h2>
            </div>
          </div>

          <button
            type="button"
            onClick={onClose}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer"
            aria-label="Fermer la fenêtre"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Security & Entitlement Check Banner */}
        {!canCreateShelf && (
          <div className="mx-6 mt-5 p-3.5 bg-amber-950/50 border border-amber-500/50 rounded-lg flex items-start gap-3 text-left">
            <ShieldAlert className="w-5 h-5 text-amber-300 shrink-0 mt-0.5" />
            <div className="text-xs text-amber-200 space-y-1">
              <p className="font-semibold">Autorisation requise : {REQUIRED_CREATE_PERMISSION}</p>
              <p>
                Votre compte actuel ne possède pas la permission nécessaire pour créer un enregistrement dans
                la table <code className="bg-black/30 px-1 py-0.5 rounded font-mono text-white">Shelf</code>.
                Toute tentative d’écriture lèvera une exception de sécurité.
              </p>
            </div>
          </div>
        )}

        {/* Server or Exception Alert */}
        {serverError && (
          <div className="mx-6 mt-4 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg flex items-start gap-3 text-left animate-in shake-1">
            <AlertCircle className="w-5 h-5 text-rose-300 shrink-0 mt-0.5" />
            <div className="text-xs text-rose-200 space-y-0.5">
              <p className="font-semibold">Erreur de création</p>
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Field: shelfName */}
          <div className="space-y-1.5">
            <label
              htmlFor="shelfName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom de l’emplacement <span className="text-rose-300">*</span></span>
              <span className="text-[11px] text-white/70">ex: Emplacement A-01, Zone Nord</span>
            </label>
            <div className="relative">
              <input
                id="shelfName"
                type="text"
                disabled={isCreating || isSubmitting}
                placeholder="Entrez le nom ou l'identifiant visuel..."
                className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                  errors.shelfName
                    ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                    : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
                }`}
                {...register('shelfName')}
              />
            </div>
            {errors.shelfName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.shelfName.message}
              </p>
            )}
          </div>

          {/* Field: stockId (Rattachement Stock) */}
          <div className="space-y-1.5">
            <label
              htmlFor="stockId"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span className="flex items-center gap-1.5">
                <Warehouse className="w-3.5 h-3.5 text-[#f7f5f0]" />
                Stock / Entrepôt de rattachement
              </span>
              <span className="text-[11px] text-white/70">Par défaut : Principal</span>
            </label>
            <div className="relative">
              <select
                id="stockId"
                disabled={isCreating || isSubmitting || isLoadingStocks}
                className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20 cursor-pointer disabled:opacity-50"
                {...register('stockId')}
              >
                {stocks.length > 0 ? (
                  stocks.map((stock) => (
                    <option key={stock.stockId} value={stock.stockId} className="bg-[#2b2622] text-white">
                      {stock.stockName || 'Stock sans nom'} {stock.stockId === DEFAULT_STOCK_ID ? '(Par défaut)' : ''}
                    </option>
                  ))
                ) : (
                  <option value={DEFAULT_STOCK_ID} className="bg-[#2b2622] text-white">
                    Stock Principal Yacine (Par défaut)
                  </option>
                )}
              </select>
            </div>
            {errors.stockId && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockId.message}
              </p>
            )}
          </div>

          {/* Stock Info Note: Decoupled Stock Management */}
          <div className="p-3.5 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg text-xs flex items-center justify-between">
            <div className="space-y-0.5">
              <span className="font-semibold text-white flex items-center gap-1.5">
                <Hash className="w-3.5 h-3.5 text-white" />
                Stock initial (Quantité : 0)
              </span>
              <p className="text-[11px] text-white/75">
                Chaque nouvel emplacement est initialisé à 0. Les stocks sont alimentés exclusivement via les mouvements d&apos;entrée.
              </p>
            </div>
          </div>

          {/* Optional Code reference */}
          <div className="space-y-1.5">
            <label
              htmlFor="shelfCode"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Code de repérage interne (Optionnel)</span>
              <span className="text-[11px] text-white/70">Code barre / QR Code</span>
            </label>
            <input
              id="shelfCode"
              type="text"
              disabled={isCreating || isSubmitting}
              placeholder="ex: SH-001-A"
              className="w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20"
              {...register('shelfCode')}
            />
          </div>


          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isCreating || isSubmitting}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isCreating || isSubmitting || !canCreateShelf}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isCreating || isSubmitting ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Plus className="w-4 h-4" />
                  <span>Créer l’emplacement</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/shelf/ShelfDetailModal.tsx">
'use client';

import { useState } from 'react';
import { Shelf } from '@/types/shelf';
import { getShelfVisualTheme } from './shelf-icons';
import {
  X,
  Copy,
  Check,
  Database,
  Hash,
  Layers,
  ShieldCheck,
  Code,
  MapPin,
  RefreshCw,
  Edit3,
  Trash2,
  Warehouse,
} from 'lucide-react';
import { toast } from 'sonner';

interface ShelfDetailModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onRefresh?: () => void;
  onOpenUpdate?: (shelf: Shelf) => void;
  onOpenDelete?: (shelf: Shelf) => void;
  canUpdateShelf?: boolean;
  canDeleteShelf?: boolean;
  isLoading?: boolean;
}

export function ShelfDetailModal({
  shelf,
  isOpen,
  onClose,
  onRefresh,
  onOpenUpdate,
  onOpenDelete,
  canUpdateShelf = true,
  canDeleteShelf = true,
  isLoading = false,
}: ShelfDetailModalProps) {
  const [copiedId, setCopiedId] = useState(false);

  if (!isOpen || !shelf) return null;

  const visualTheme = getShelfVisualTheme(shelf.shelfName);
  const IconComp = visualTheme.icon;

  const handleCopyId = () => {
    navigator.clipboard.writeText(shelf.shelfId);
    setCopiedId(true);
    toast.success('Identifiant copié dans le presse-papier !');
    setTimeout(() => setCopiedId(false), 2000);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-xs p-4 animate-in fade-in duration-150">
      {/* Document Card (#6b7b97 Slate Blue Theme) */}
      <div
        className="w-full max-w-xl bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-2xl overflow-hidden animate-in zoom-in-95 duration-150 text-left"
        role="dialog"
        aria-modal="true"
        aria-labelledby="shelf-detail-title"
      >
        {/* Cover Banner */}
        <div className="h-24 bg-[#2b2622] border-b border-[#3f3a36] relative flex items-end px-6 pb-0">
          {/* Top Bar Actions */}
          <div className="absolute top-3 right-3 flex items-center gap-1.5">
            {onRefresh && (
              <button
                type="button"
                onClick={onRefresh}
                disabled={isLoading}
                className="p-1.5 rounded-md bg-white/20 hover:bg-white/30 text-white transition-colors cursor-pointer border border-white/30"
                title="Rafraîchir"
              >
                <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? 'animate-spin' : ''}`} />
              </button>
            )}

            <button
              type="button"
              onClick={onClose}
              className="p-1.5 rounded-md bg-white/20 hover:bg-white/30 text-white transition-colors cursor-pointer border border-white/30"
              aria-label="Fermer"
            >
              <X className="w-4 h-4" />
            </button>
          </div>

          {/* Overlapping Icon Tile */}
          <div
            className="w-14 h-14 rounded-xl bg-[#2b2622] border-2 border-white/80 shadow-md flex items-center justify-center text-[#f7f5f0] translate-y-5"
          >
            <IconComp className="w-7 h-7" />
          </div>
        </div>

        {/* Modal Body */}
        <div className="pt-8 px-6 pb-6 space-y-6">
          {/* Title & Type Badge */}
          <div className="space-y-1.5">
            <div className="flex items-center gap-2 flex-wrap">
              <h2
                id="shelf-detail-title"
                className="text-2xl font-semibold text-white tracking-tight"
              >
                {shelf.shelfName ?? 'Emplacement sans nom'}
              </h2>
              <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950/40 text-emerald-200 border border-emerald-400/40">
                <ShieldCheck className="w-3.5 h-3.5" />
                Tuple Actif
              </span>
            </div>
            <p className="text-xs text-white/80">
              {visualTheme.label}
            </p>
          </div>

          {/* Property Table */}
          <div className="border border-[#3f3a36] rounded-lg divide-y divide-[#5a6f98] text-xs bg-[#2b2622]/70">
            {/* Property: UUID */}
            <div className="p-3 flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/85 w-36 shrink-0">
                <Database className="w-3.5 h-3.5 text-white" />
                <span className="font-medium">Identifiant</span>
              </div>
              <div className="flex items-center gap-2 font-mono text-[11px] text-white min-w-0">
                <span className="truncate">{shelf.shelfId}</span>
                <button
                  type="button"
                  onClick={handleCopyId}
                  className="p-1 hover:bg-white/20 text-white/80 hover:text-white rounded transition-colors cursor-pointer shrink-0"
                  title="Copier l'identifiant"
                >
                  {copiedId ? (
                    <Check className="w-3.5 h-3.5 text-emerald-300" />
                  ) : (
                    <Copy className="w-3.5 h-3.5" />
                  )}
                </button>
              </div>
            </div>

            {/* Property: shelfName */}
            <div className="p-3 flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/85 w-36 shrink-0">
                <Layers className="w-3.5 h-3.5 text-white" />
                <span className="font-medium">Nom de l&apos;emplacement</span>
              </div>
              <div className="text-sm font-semibold text-white text-right">
                {shelf.shelfName ?? 'Non défini'}
              </div>
            </div>

            {/* Property: shelfQuantity */}
            <div className="p-3 flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/85 w-36 shrink-0">
                <Hash className="w-3.5 h-3.5 text-white" />
                <span className="font-medium">Capacité / Stock</span>
              </div>
              <div>
                <span
                  className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold ${
                    shelf.shelfQuantity > 0
                      ? 'bg-emerald-950/40 text-emerald-200 border border-emerald-400/40'
                      : 'bg-amber-950/40 text-amber-200 border border-amber-400/40'
                  }`}
                >
                  <Hash className="w-3 h-3" />
                  {shelf.shelfQuantity} {shelf.shelfQuantity > 1 ? 'unités enregistrées' : 'unité enregistrée'}
                </span>
              </div>
            </div>

            {/* Property: Stock */}
            <div className="p-3 flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/85 w-36 shrink-0">
                <Warehouse className="w-3.5 h-3.5 text-white" />
                <span className="font-medium">Stock / Entrepôt</span>
              </div>
              <div className="text-xs text-white font-medium flex items-center gap-1.5">
                <span className="text-[#f7f5f0] font-semibold">
                  {shelf.stock?.stockName ?? 'Stock Principal Yacine'}
                </span>
                {shelf.stockId && (
                  <span className="font-mono text-[10px] text-white/70">
                    ({shelf.stockId.slice(0, 8)}...)
                  </span>
                )}
              </div>
            </div>

            {/* Property: Physical Location */}
            <div className="p-3 flex items-center justify-between gap-2">
              <div className="flex items-center gap-2 text-white/85 w-36 shrink-0">
                <MapPin className="w-3.5 h-3.5 text-white" />
                <span className="font-medium">Emplacement dépôt</span>
              </div>
              <div className="text-xs text-white font-medium">
                Zone Principale • Somépharm Workspace
              </div>
            </div>
          </div>

          {/* Modal Footer */}
          <div className="pt-3 border-t border-[#3f3a36] flex flex-wrap items-center justify-between gap-2.5">
            <button
              type="button"
              onClick={handleCopyId}
              className="inline-flex items-center gap-1.5 px-3 py-2 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-xs font-medium rounded-lg transition-colors cursor-pointer"
            >
              <Copy className="w-3.5 h-3.5 text-white" />
              <span>Copier l'identifiant</span>
            </button>

            <div className="flex items-center gap-2">
              {/* Update Button */}
              <button
                type="button"
                onClick={() => {
                  if (onOpenUpdate) onOpenUpdate(shelf);
                }}
                disabled={!canUpdateShelf}
                className="inline-flex items-center gap-1.5 px-3 py-2 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-xs font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
                title={canUpdateShelf ? "Modifier cet emplacement (shelf.update)" : "Permission 'shelf.update' manquante"}
              >
                <Edit3 className="w-3.5 h-3.5" />
                <span>Modifier</span>
              </button>

              {/* Delete Button */}
              <button
                type="button"
                onClick={() => {
                  if (onOpenDelete) onOpenDelete(shelf);
                }}
                disabled={!canDeleteShelf}
                className="inline-flex items-center gap-1.5 px-3 py-2 bg-red-600/90 hover:bg-red-600 text-white border border-red-400/40 text-xs font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
                title={canDeleteShelf ? "Supprimer cet emplacement (shelf.delete)" : "Permission 'shelf.delete' manquante"}
              >
                <Trash2 className="w-3.5 h-3.5" />
                <span>Supprimer</span>
              </button>

              <button
                type="button"
                onClick={onClose}
                className="px-4.5 py-2 bg-[#2b2622] hover:bg-[#3f3a36] text-white text-xs font-medium rounded-lg border border-[#4d4742] shadow-xs transition-colors cursor-pointer"
              >
                Fermer
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/components/shelf/ShelfListTable.tsx">
'use client';

import { useState } from 'react';
import { Shelf } from '@/types/shelf';
import {
  Search,
  RefreshCw,
  Copy,
  Check,
  Database,
  Hash,
  Archive,
  ChevronLeft,
  ChevronRight,
  ChevronsLeft,
  ChevronsRight,
  LayoutGrid,
  Table as TableIcon,
  Eye,
  ArrowRight,
  Pencil,
  Trash2,
  Plus,
  Warehouse,
} from 'lucide-react';
import { toast } from 'sonner';

interface ShelfListTableProps {
  shelves: Shelf[];
  totalShelves: number;
  totalPages: number;
  currentPage: number;
  limit: number;
  searchTerm: string;
  onSearchChange: (search: string) => void;
  onPageChange: (page: number) => void;
  onLimitChange: (limit: number) => void;
  onSelectShelf: (shelf: Shelf) => void;
  onLookupById?: (id: string) => void;
  onOpenUpdate?: (shelf: Shelf) => void;
  onOpenDelete?: (shelf: Shelf) => void;
  isLoading: boolean;
  onRefresh: () => void;
  onOpenCreateModal: () => void;
  canCreateShelf: boolean;
  canUpdateShelf?: boolean;
  canDeleteShelf?: boolean;
}

export function ShelfListTable({
  shelves,
  totalShelves,
  totalPages,
  currentPage,
  limit,
  searchTerm,
  onSearchChange,
  onPageChange,
  onLimitChange,
  onSelectShelf,
  onLookupById,
  onOpenUpdate,
  onOpenDelete,
  isLoading,
  onRefresh,
  onOpenCreateModal,
  canCreateShelf,
  canUpdateShelf = true,
  canDeleteShelf = true,
}: ShelfListTableProps) {
  const [copiedId, setCopiedId] = useState<string | null>(null);
  const [viewMode, setViewMode] = useState<'table' | 'grid'>('table');
  const [idLookupInput, setIdLookupInput] = useState('');

  const handleCopyId = (e: React.MouseEvent, id: string) => {
    e.stopPropagation();
    navigator.clipboard.writeText(id);
    setCopiedId(id);
    toast.success('Identifiant copié dans le presse-papier !');
    setTimeout(() => setCopiedId(null), 2000);
  };

  const handleLookupSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!idLookupInput.trim()) return;
    if (onLookupById) {
      onLookupById(idLookupInput.trim());
    }
  };

  // Calculate indexing ranges
  const startItem = totalShelves === 0 ? 0 : (currentPage - 1) * limit + 1;
  const endItem = Math.min(currentPage * limit, totalShelves);

  return (
    <div className="w-full bg-[#383330] border border-[#3f3a36] rounded-[4px] shadow-xs overflow-hidden text-left space-y-0">
      {/* Table Toolbar & Search by Name */}
      <div className="p-3 border-b border-[#3f3a36] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3 bg-[#383330]">
        {/* Search by Name input */}
        <div className="flex items-center gap-2 w-full lg:w-auto flex-1 max-w-lg">
          <div className="relative w-full">
            <Search className="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-[#aea69c]" />
            <input
              type="text"
              value={searchTerm}
              onChange={(e) => onSearchChange(e.target.value)}
              placeholder="Rechercher par nom d'emplacement..."
              className="w-full h-8 pl-8 pr-7 bg-[#2b2622] text-xs font-mono text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] outline-none focus:border-[#f7f5f0] placeholder:text-[#aea69c] transition-colors"
            />
            {searchTerm && (
              <button
                type="button"
                onClick={() => onSearchChange('')}
                className="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-[#aea69c] hover:text-[#f7f5f0] cursor-pointer"
              >
                ×
              </button>
            )}
          </div>
        </div>

        {/* Quick UUID Lookup Input */}
        <form
          onSubmit={handleLookupSubmit}
          className="flex items-center gap-1.5 w-full sm:w-auto max-w-sm"
        >
          <div className="relative flex-1">
            <Database className="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-[#aea69c]" />
            <input
              type="text"
              value={idLookupInput}
              onChange={(e) => setIdLookupInput(e.target.value)}
              placeholder="Inspecter par UUID..."
              className="w-full h-8 pl-8 pr-2 bg-[#2b2622] text-xs font-mono text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] outline-none focus:border-[#f7f5f0] placeholder:text-[#aea69c] transition-colors"
            />
          </div>
          <button
            type="submit"
            disabled={!idLookupInput.trim() || isLoading}
            className="h-8 px-2.5 bg-[#2b2622] hover:bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] text-xs font-medium rounded-[3px] transition-colors cursor-pointer disabled:opacity-40 flex items-center gap-1"
            title="Consulter l'emplacement par UUID (GET /shelves/:id)"
          >
            <span>Ouvrir</span>
            <ArrowRight className="w-3 h-3" />
          </button>
        </form>

        {/* View Mode & Page Limit & Refresh Controls */}
        <div className="flex items-center flex-wrap gap-2 w-full lg:w-auto justify-between lg:justify-end">
          {/* View Mode Toggle */}
          <div className="inline-flex items-center bg-[#2b2622] p-0.5 rounded-[3px] border border-[#3f3a36]">
            <button
              type="button"
              onClick={() => setViewMode('table')}
              className={`px-2 py-1 rounded-[2px] text-xs font-medium flex items-center gap-1.5 transition-all cursor-pointer ${
                viewMode === 'table'
                  ? 'bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] shadow-xs'
                  : 'text-[#aea69c] hover:text-[#f7f5f0]'
              }`}
              title="Vue Liste / Table"
            >
              <TableIcon className="w-3.5 h-3.5" />
              <span>Table</span>
            </button>
            <button
              type="button"
              onClick={() => setViewMode('grid')}
              className={`px-2 py-1 rounded-[2px] text-xs font-medium flex items-center gap-1.5 transition-all cursor-pointer ${
                viewMode === 'grid'
                  ? 'bg-[#383330] text-[#f7f5f0] border border-[#3f3a36] shadow-xs'
                  : 'text-[#aea69c] hover:text-[#f7f5f0]'
              }`}
              title="Vue Galerie / Cartes"
            >
              <LayoutGrid className="w-3.5 h-3.5" />
              <span>Galerie</span>
            </button>
          </div>

          {/* Page size limit selector */}
          <div className="flex items-center gap-1.5 text-xs text-[#c9c0ad]">
            <select
              value={limit}
              onChange={(e) => onLimitChange(Number(e.target.value))}
              className="h-8 px-2 bg-[#2b2622] border border-[#3f3a36] rounded-[3px] text-xs font-mono text-[#f7f5f0] outline-none focus:border-[#f7f5f0] cursor-pointer"
            >
              <option value={5}>5 / page</option>
              <option value={10}>10 / page</option>
              <option value={20}>20 / page</option>
              <option value={50}>50 / page</option>
            </select>
          </div>

          {/* Refresh button */}
          <button
            type="button"
            onClick={onRefresh}
            disabled={isLoading}
            className="h-8 px-2.5 bg-[#2b2622] hover:bg-[#383330] text-[#c9c0ad] hover:text-[#f7f5f0] border border-[#3f3a36] rounded-[3px] text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer disabled:opacity-40"
            title="Actualiser"
          >
            <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? 'animate-spin text-[#f7f5f0]' : ''}`} />
            <span className="hidden sm:inline">Actualiser</span>
          </button>
        </div>
      </div>

      {/* Main View: Table View OR Grid View */}
      {viewMode === 'table' ? (
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs">
            <thead>
              <tr className="border-b border-[#3f3a36] bg-[#2b2622] text-[11px] font-mono text-[#aea69c] tracking-wider uppercase">
                <th className="py-2.5 px-4 w-16 text-center">Index</th>
                <th className="py-2.5 px-4">Emplacement</th>
                <th className="py-2.5 px-4 text-center">Quantité Stockée</th>
                <th className="py-2.5 px-4">Identifiant</th>
                <th className="py-2.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-[#3f3a36] text-xs text-[#f7f5f0]">
              {isLoading && shelves.length === 0 ? (
                <tr>
                  <td colSpan={5} className="py-16 text-center text-[#aea69c]">
                    <div className="flex flex-col items-center justify-center gap-2">
                      <RefreshCw className="w-5 h-5 animate-spin text-[#f7f5f0]" />
                      <p className="text-xs font-mono">Chargement des emplacements...</p>
                    </div>
                  </td>
                </tr>
              ) : shelves.length === 0 ? (
                <tr>
                  <td colSpan={5} className="py-16 text-center text-[#aea69c]">
                    <div className="flex flex-col items-center justify-center gap-3">
                      <div className="w-10 h-10 rounded-[3px] bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#aea69c]">
                        <Archive className="w-5 h-5" />
                      </div>
                      <div className="space-y-1">
                        <p className="text-sm font-medium text-[#f7f5f0]">Aucun emplacement trouvé</p>
                        <p className="text-xs text-[#c9c0ad] max-w-sm">
                          {searchTerm
                            ? `Aucun emplacement ne correspond à "${searchTerm}".`
                            : 'Aucun emplacement enregistré pour le moment.'}
                        </p>
                      </div>
                      {canCreateShelf && !searchTerm && (
                        <button
                          type="button"
                          onClick={onOpenCreateModal}
                          className="mt-1 px-3.5 py-1.5 bg-[#f7f5f0] hover:bg-[#dad2c1] text-[#2b2622] rounded-[3px] text-xs font-medium cursor-pointer transition-colors inline-flex items-center gap-1.5"
                        >
                          <Plus className="w-3.5 h-3.5" />
                          <span>Créer un emplacement</span>
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ) : (
                shelves.map((shelf, idx) => {
                  const globalIndex = (currentPage - 1) * limit + idx + 1;
                  const formattedIndex = String(globalIndex).padStart(2, '0');

                  return (
                    <tr
                      key={shelf.shelfId}
                      onClick={() => onSelectShelf(shelf)}
                      className="hover:bg-[#2b2622]/50 transition-colors group cursor-pointer"
                    >
                      {/* 1. Global Index Number */}
                      <td className="py-3 px-4 text-center font-mono text-xs text-[#aea69c]">
                        <span className="inline-block px-1.5 py-0.5 rounded-[2px] bg-[#2b2622] border border-[#3f3a36] text-[#dad2c1] text-[10px]">
                          #{formattedIndex}
                        </span>
                      </td>

                      {/* 2. Shelf Name */}
                      <td className="py-3 px-4 font-medium text-[#f7f5f0]">
                        <div className="flex items-center gap-2.5">
                          <div className="min-w-0">
                            <p className="font-medium text-xs text-[#f7f5f0] truncate max-w-xs group-hover:text-white transition-colors">
                              {shelf.shelfName ?? 'Emplacement sans nom'}
                            </p>
                            <span className="text-[11px] font-mono text-[#aea69c] flex items-center gap-1">
                              <span>Emplacement</span>
                              {shelf.stock?.stockName && (
                                <>
                                  <span>•</span>
                                  <span className="text-[#f7f5f0] flex items-center gap-0.5">
                                    <Warehouse className="w-3 h-3" />
                                    {shelf.stock.stockName}
                                  </span>
                                </>
                              )}
                              <span>•</span>
                              <span className="text-[#dad2c1]">
                                RACK-{formattedIndex}
                              </span>
                            </span>
                          </div>
                        </div>
                      </td>

                      {/* 3. Quantity Badge */}
                      <td className="py-3 px-4 text-center">
                        <span
                          className={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] font-mono text-[10px] border ${
                            shelf.shelfQuantity > 0
                              ? 'bg-[#162b22] text-[#10b981] border-[#1e3d30]'
                              : 'bg-[#2d1616] text-[#ef4444] border-[#451e1e]'
                          }`}
                        >
                          <Hash className="w-3 h-3" />
                          <span>
                            {shelf.shelfQuantity} {shelf.shelfQuantity > 1 ? 'unités' : 'unité'}
                          </span>
                        </span>
                      </td>

                      {/* 4. GUID (shelfId) */}
                      <td className="py-3 px-4">
                        <div className="flex items-center gap-1.5 font-mono text-xs text-[#aea69c]">
                          <span className="truncate max-w-[160px]">{shelf.shelfId}</span>
                          <button
                            type="button"
                            onClick={(e) => handleCopyId(e, shelf.shelfId)}
                            className="p-1 text-[#aea69c] hover:text-[#f7f5f0] rounded-[2px] hover:bg-[#2b2622] transition-colors cursor-pointer"
                            title="Copier l'identifiant"
                          >
                            {copiedId === shelf.shelfId ? (
                              <Check className="w-3.5 h-3.5 text-[#10b981]" />
                            ) : (
                              <Copy className="w-3.5 h-3.5" />
                            )}
                          </button>
                        </div>
                      </td>

                      {/* 5. Actions */}
                      <td className="py-3 px-4 text-right">
                        <div className="inline-flex items-center gap-1" onClick={(e) => e.stopPropagation()}>
                          <button
                            type="button"
                            onClick={() => onSelectShelf(shelf)}
                            className="p-1.5 rounded-[2px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#2b2622] transition-colors cursor-pointer"
                            title="Consulter les détails"
                          >
                            <Eye className="w-3.5 h-3.5" />
                          </button>

                          <button
                            type="button"
                            onClick={() => onOpenUpdate && onOpenUpdate(shelf)}
                            disabled={!canUpdateShelf}
                            className="p-1.5 rounded-[2px] text-[#aea69c] hover:text-[#f7f5f0] hover:bg-[#2b2622] transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            title={canUpdateShelf ? "Modifier l'emplacement" : "Permission manquante"}
                          >
                            <Pencil className="w-3.5 h-3.5" />
                          </button>

                          <button
                            type="button"
                            onClick={() => onOpenDelete && onOpenDelete(shelf)}
                            disabled={!canDeleteShelf}
                            className="p-1.5 rounded-[2px] text-[#ef4444] hover:bg-[#2d1616] transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            title={canDeleteShelf ? "Supprimer l'emplacement" : "Permission manquante"}
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      ) : (
        /* GALLERY / GRID VIEW */
        <div className="p-4 bg-[#2b2622]">
          {isLoading && shelves.length === 0 ? (
            <div className="py-14 text-center text-[#aea69c] flex flex-col items-center justify-center gap-2">
              <RefreshCw className="w-5 h-5 animate-spin text-[#f7f5f0]" />
              <p className="text-xs font-mono">Chargement des cartes emplacements...</p>
            </div>
          ) : shelves.length === 0 ? (
            <div className="py-14 text-center text-[#aea69c] flex flex-col items-center justify-center gap-2">
              <Archive className="w-8 h-8 text-[#aea69c]" />
              <p className="text-sm font-medium text-[#f7f5f0]">Aucun emplacement disponible</p>
            </div>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {shelves.map((shelf, idx) => {
                const globalIndex = (currentPage - 1) * limit + idx + 1;
                const formattedIndex = String(globalIndex).padStart(2, '0');

                return (
                  <div
                    key={shelf.shelfId}
                    onClick={() => onSelectShelf(shelf)}
                    className="bg-[#383330] border border-[#3f3a36] hover:border-[#4d4742] rounded-[4px] p-4 shadow-xs transition-all text-left space-y-3 relative group cursor-pointer"
                  >
                    {/* Header */}
                    <div className="flex items-center justify-between">
                      <span className="px-1.5 py-0.5 rounded-[2px] bg-[#2b2622] border border-[#3f3a36] text-[10px] font-mono text-[#dad2c1]">
                        INDEX #{formattedIndex}
                      </span>
                    </div>

                    {/* Title */}
                    <div className="flex items-start gap-3">
                      <div className="min-w-0 flex-1">
                        <h3 className="font-medium text-xs text-[#f7f5f0] truncate group-hover:text-white transition-colors">
                          {shelf.shelfName ?? 'Emplacement sans nom'}
                        </h3>
                      </div>
                    </div>

                    {/* Stats & Quantity */}
                    <div className="pt-2 border-t border-[#3f3a36] flex items-center justify-between text-xs">
                      <span className="text-[#aea69c] font-mono text-[11px] flex items-center gap-1">
                        {shelf.stock?.stockName ? (
                          <>
                            <Warehouse className="w-3 h-3 text-[#f7f5f0]" />
                            <span className="text-[#f7f5f0] truncate max-w-[110px]">{shelf.stock.stockName}</span>
                          </>
                        ) : (
                          'Stock initial :'
                        )}
                      </span>
                      <span
                        className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-[2px] text-[10px] font-mono border ${
                          shelf.shelfQuantity > 0
                            ? 'bg-[#162b22] text-[#10b981] border-[#1e3d30]'
                            : 'bg-[#2d1616] text-[#ef4444] border-[#451e1e]'
                        }`}
                      >
                        {shelf.shelfQuantity} unités
                      </span>
                    </div>

                    {/* Action Bar */}
                    <div className="bg-[#2b2622] border border-[#3f3a36] rounded-[3px] p-2 flex items-center justify-between text-[11px] font-mono text-[#aea69c]">
                      <span className="truncate max-w-[140px]">{shelf.shelfId}</span>
                      <div className="flex items-center gap-1" onClick={(e) => e.stopPropagation()}>
                        <button
                          type="button"
                          onClick={(e) => handleCopyId(e, shelf.shelfId)}
                          className="p-1 hover:text-[#f7f5f0] rounded-[2px] transition-colors"
                          title="Copier le GUID"
                        >
                          {copiedId === shelf.shelfId ? (
                            <Check className="w-3.5 h-3.5 text-[#10b981]" />
                          ) : (
                            <Copy className="w-3.5 h-3.5" />
                          )}
                        </button>
                        <button
                          type="button"
                          onClick={() => onSelectShelf(shelf)}
                          className="p-1 hover:text-[#f7f5f0] rounded-[2px] transition-colors"
                          title="Voir les détails"
                        >
                          <Eye className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => onOpenUpdate?.(shelf)}
                          disabled={!canUpdateShelf}
                          className="p-1 hover:text-[#f7f5f0] rounded-[2px] transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
                          title={canUpdateShelf ? "Modifier" : "Permission manquante"}
                        >
                          <Pencil className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => onOpenDelete?.(shelf)}
                          disabled={!canDeleteShelf}
                          className="p-1 text-[#ef4444] hover:bg-[#2d1616] rounded-[2px] transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
                          title={canDeleteShelf ? "Supprimer" : "Permission manquante"}
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* Pagination Footer */}
      {totalPages > 1 && (
        <div className="px-4 py-2.5 bg-[#2b2622] border-t border-[#3f3a36] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#aea69c] font-mono">
          <div>
            Page <span className="text-[#f7f5f0]">{currentPage}</span> /{' '}
            <span className="text-[#f7f5f0]">{totalPages}</span> ({totalShelves} emplacements)
          </div>

          <div className="flex items-center gap-1">
            <button
              type="button"
              onClick={() => onPageChange(1)}
              disabled={currentPage <= 1 || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Première page"
            >
              <ChevronsLeft className="w-3.5 h-3.5" />
            </button>
            <button
              type="button"
              onClick={() => onPageChange(Math.max(1, currentPage - 1))}
              disabled={currentPage <= 1 || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Page précédente"
            >
              <ChevronLeft className="w-3.5 h-3.5" />
            </button>

            {/* Page buttons */}
            <div className="flex items-center gap-1 px-1">
              {(() => {
                const pages: number[] = [];
                if (totalPages <= 5) {
                  for (let i = 1; i <= Math.max(totalPages, 1); i++) pages.push(i);
                } else if (currentPage <= 3) {
                  pages.push(1, 2, 3, 4, 5);
                } else if (currentPage >= totalPages - 2) {
                  for (let i = totalPages - 4; i <= totalPages; i++) pages.push(i);
                } else {
                  pages.push(currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2);
                }

                return pages.map((pageNum) => {
                  const isActive = pageNum === currentPage;
                  return (
                    <button
                      key={`page-btn-${pageNum}`}
                      type="button"
                      onClick={() => onPageChange(pageNum)}
                      disabled={isLoading}
                      className={`w-6 h-6 rounded-[2px] text-xs font-mono transition-colors cursor-pointer flex items-center justify-center ${
                        isActive
                          ? 'bg-[#f7f5f0] text-[#2b2622] font-semibold'
                          : 'bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] border border-[#3f3a36]'
                      }`}
                    >
                      {pageNum}
                    </button>
                  );
                });
              })()}
            </div>

            <button
              type="button"
              onClick={() => onPageChange(Math.min(totalPages, currentPage + 1))}
              disabled={currentPage >= totalPages || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Page suivante"
            >
              <ChevronRight className="w-3.5 h-3.5" />
            </button>
            <button
              type="button"
              onClick={() => onPageChange(totalPages)}
              disabled={currentPage >= totalPages || isLoading}
              className="p-1 rounded-[2px] border border-[#3f3a36] bg-[#383330] hover:bg-[#3f3a36] text-[#c9c0ad] hover:text-[#f7f5f0] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
              title="Dernière page"
            >
              <ChevronsRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/components/shelf/UpdateShelfModal.tsx">
'use client';

import { getErrorMessage } from '@/lib/error-message';

import { useState, useEffect } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { updateShelfSchema, UpdateShelfFormValues } from '@/schemas/shelf.schema';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { useApi } from '@/hooks/use-api';
import { StockService } from '@/services/stock.service';
import { Stock } from '@/types/stock';
import { REQUIRED_UPDATE_PERMISSION } from '@/services/shelf.service';
import { InsufficientPermissionException } from '@/services/shelf.errors';
import { Shelf } from '@/types/shelf';
import {
  X,
  Edit3,
  Loader2,
  ShieldAlert,
  Hash,
  Warehouse,
  Database,
  AlertCircle,
} from 'lucide-react';

const DEFAULT_STOCK_ID = '606d4178-e0a8-48b9-be6d-9538fa61135a';

interface UpdateShelfModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function UpdateShelfModal(props: UpdateShelfModalProps) {
  if (!props.isOpen || !props.shelf) return null;

  return (
    <UpdateShelfModalContent
      key={`${props.shelf.shelfId}:${props.shelf.shelfName}:${props.shelf.stockId ?? ''}`}
      {...props}
    />
  );
}

function UpdateShelfModalContent({
  shelf,
  isOpen,
  onClose,
  onSuccess,
}: UpdateShelfModalProps) {
  const api = useApi();
  const { updateShelf, isUpdating } = useShelves();
  const { canUpdateShelf, roleName } = usePermissions();
  const [serverError, setServerError] = useState<string | null>(null);
  const [stocks, setStocks] = useState<Stock[]>([]);
  const [isLoadingStocks, setIsLoadingStocks] = useState(false);

  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<UpdateShelfFormValues>({
    resolver: zodResolver(updateShelfSchema),
    defaultValues: {
      shelfName: shelf?.shelfName ?? '',
      stockId: shelf?.stockId ?? DEFAULT_STOCK_ID,
    },
    mode: 'onChange',
  });

  useEffect(() => {
    if (isOpen) {
      let isMounted = true;
      setIsLoadingStocks(true);
      StockService.getAllStocks(api, { limit: 100 })
        .then((res) => {
          if (isMounted && res?.stocks) {
            setStocks(res.stocks);
          }
        })
        .catch((err) => {
          console.warn('[UpdateShelfModal] Failed to load stocks list:', err);
        })
        .finally(() => {
          if (isMounted) setIsLoadingStocks(false);
        });
      return () => {
        isMounted = false;
      };
    }
  }, [isOpen, api]);

  if (!isOpen || !shelf) return null;

  const onSubmit = async (values: UpdateShelfFormValues) => {
    setServerError(null);

    // Client-side permission guard check
    if (!canUpdateShelf) {
      const err = new InsufficientPermissionException(
        REQUIRED_UPDATE_PERMISSION,
        `Action interdite : Votre rôle (${roleName ?? 'Utilisateur'}) ne possède pas la permission '${REQUIRED_UPDATE_PERMISSION}' pour modifier cet emplacement.`,
      );
      setServerError(err.message);
      throw err;
    }

    try {
      await updateShelf({
        id: shelf.shelfId,
        data: values,
      });
      onClose();
      if (onSuccess) onSuccess();
    } catch (err: unknown) {
      console.error('[UpdateShelfModal] Update failed:', err);
      setServerError(getErrorMessage(err, 'Échec de la modification de l’emplacement.'));
    }
  };

  return (
    <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-xs p-4 animate-in fade-in duration-150">
      {/* Modal Surface (#6b7b97 Theme) */}
      <div
        className="w-full max-w-lg bg-[#383330] border border-[#3f3a36] text-white rounded-xl shadow-xl overflow-hidden animate-in zoom-in-95 duration-150"
        role="dialog"
        aria-modal="true"
        aria-labelledby="update-shelf-title"
      >
        {/* Modal Header */}
        <div className="px-6 py-5 border-b border-[#3f3a36] flex items-center justify-between bg-[#2b2622]">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-lg bg-[#2b2622] border border-[#3f3a36] flex items-center justify-center text-[#f7f5f0]">
              <Edit3 className="w-5 h-5" />
            </div>
            <div>
              <h2 id="update-shelf-title" className="text-lg font-semibold text-white tracking-tight">
                Modifier l’emplacement
              </h2>
            </div>
          </div>

          <button
            type="button"
            onClick={onClose}
            className="text-white/80 hover:text-white hover:bg-white/20 p-1.5 rounded-md transition-colors cursor-pointer"
            aria-label="Fermer"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Security & Entitlement Warning Banner */}
        {!canUpdateShelf && (
          <div className="mx-6 mt-5 p-3.5 bg-amber-950/50 border border-amber-500/50 rounded-lg flex items-start gap-3 text-left">
            <ShieldAlert className="w-5 h-5 text-amber-300 shrink-0 mt-0.5" />
            <div className="text-xs text-amber-200 space-y-1">
              <p className="font-semibold">Autorisation requise : {REQUIRED_UPDATE_PERMISSION}</p>
              <p>
                Votre rôle ne dispose pas de la permission nécessaire pour exécuter la méthode PATCH sur cet emplacement.
              </p>
            </div>
          </div>
        )}

        {/* Error Alert */}
        {serverError && (
          <div className="mx-6 mt-4 p-3.5 bg-rose-950/50 border border-rose-500/50 rounded-lg flex items-start gap-3 text-left">
            <AlertCircle className="w-5 h-5 text-rose-300 shrink-0 mt-0.5" />
            <div className="text-xs text-rose-200 space-y-0.5">
              <p className="font-semibold">Erreur de modification</p>
              <p>{serverError}</p>
            </div>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSubmit(onSubmit)} className="p-6 space-y-5 text-left">
          {/* Target Shelf UUID info */}
          <div className="p-3 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg text-xs space-y-1 text-white">
            <div className="flex items-center justify-between text-white/85">
              <span className="font-medium flex items-center gap-1.5">
                <Database className="w-3.5 h-3.5 text-white" />
                Identifiant
              </span>
              <span className="font-mono text-[11px] text-white truncate max-w-[200px]">
                {shelf.shelfId}
              </span>
            </div>
          </div>

          {/* Field: shelfName */}
          <div className="space-y-1.5">
            <label
              htmlFor="edit-shelfName"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span>Nom de l’emplacement</span>
              <span className="text-[11px] text-white/70">1 à 100 caractères</span>
            </label>
            <input
              id="edit-shelfName"
              type="text"
              disabled={isUpdating || isSubmitting}
              className={`w-full h-11 px-3.5 bg-[#2b2622] text-white placeholder-white/50 text-sm border rounded-lg transition-all outline-none ${
                errors.shelfName
                  ? 'border-rose-400 focus:ring-2 focus:ring-rose-400/30'
                  : 'border-[#3f3a36] focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20'
              }`}
              {...register('shelfName')}
            />
            {errors.shelfName && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.shelfName.message}
              </p>
            )}
          </div>

          {/* Field: stockId (Rattachement Stock) */}
          <div className="space-y-1.5">
            <label
              htmlFor="edit-stockId"
              className="flex items-center justify-between text-xs font-medium text-white"
            >
              <span className="flex items-center gap-1.5">
                <Warehouse className="w-3.5 h-3.5 text-[#f7f5f0]" />
                Stock / Entrepôt de rattachement
              </span>
            </label>
            <div className="relative">
              <select
                id="edit-stockId"
                disabled={isUpdating || isSubmitting || isLoadingStocks}
                className="w-full h-11 px-3.5 bg-[#2b2622] text-white text-sm border border-[#3f3a36] rounded-lg transition-all outline-none focus:bg-[#383330] focus:border-white focus:ring-2 focus:ring-white/20 cursor-pointer disabled:opacity-50"
                {...register('stockId')}
              >
                {stocks.length > 0 ? (
                  stocks.map((stock) => (
                    <option key={stock.stockId} value={stock.stockId} className="bg-[#2b2622] text-white">
                      {stock.stockName || 'Stock sans nom'} {stock.stockId === DEFAULT_STOCK_ID ? '(Principal)' : ''}
                    </option>
                  ))
                ) : (
                  <option value={DEFAULT_STOCK_ID} className="bg-[#2b2622] text-white">
                    Stock Principal Yacine
                  </option>
                )}
              </select>
            </div>
            {errors.stockId && (
              <p className="text-xs text-rose-300 flex items-center gap-1 mt-1">
                <AlertCircle className="w-3.5 h-3.5" />
                {errors.stockId.message}
              </p>
            )}
          </div>

          {/* Read-only Shelf Quantity Card */}
          <div className="p-3.5 bg-[#2b2622]/60 border border-[#3f3a36] rounded-lg text-xs flex items-center justify-between">
            <div className="space-y-0.5">
              <span className="font-semibold text-white flex items-center gap-1.5">
                <Hash className="w-3.5 h-3.5 text-white" />
                Quantité en stock actuelle
              </span>
              <p className="text-[11px] text-white/75">
                Les stocks sont gérés exclusivement via les mouvements d&apos;entrée et de transfert.
              </p>
            </div>
            <span className="text-base font-bold font-mono px-3 py-1 bg-[#2b2622] border border-[#3f3a36] rounded-md text-white">
              {shelf.shelfQuantity}
            </span>
          </div>

          {/* Action Buttons */}
          <div className="pt-2 flex items-center justify-end gap-2.5 border-t border-[#3f3a36]">
            <button
              type="button"
              onClick={onClose}
              disabled={isUpdating || isSubmitting}
              className="px-4 py-2.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 text-sm font-medium rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              disabled={isUpdating || isSubmitting || !canUpdateShelf}
              className="px-4.5 py-2.5 bg-[#2b2622] hover:bg-[#3f3a36] text-white border border-[#4d4742] text-sm font-medium rounded-lg shadow-xs transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {isUpdating || isSubmitting ? (
                <>
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Enregistrement...</span>
                </>
              ) : (
                <>
                  <Edit3 className="w-4 h-4" />
                  <span>Enregistrer les modifications</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/hooks/use-inventory.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useApi } from './use-api';

// Types can be imported from our definitions
