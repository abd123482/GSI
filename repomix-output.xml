<file path="backend/scripts/check-rebuild-readiness.mjs">
import 'dotenv/config';

import { PrismaMssql } from '@prisma/adapter-mssql';
import { PrismaClient } from '../dist/generated/prisma/client.js';
import fs from 'node:fs';
import path from 'node:path';

function required(name) {
  const value = process.env[name];

  if (!value) {
    throw new Error(`Missing environment variable: ${name}`);
  }

  return value;
}

function makeClient() {
  const adapter = new PrismaMssql({
    server: required('DB_HOST'),
    port: Number(process.env.DB_PORT ?? 1433),
    database: required('DB_NAME'),
    user: required('DB_USER'),
    password: required('DB_PASSWORD'),
    options: {
      encrypt: true,
      trustServerCertificate: true,
    },
  });

  return new PrismaClient({ adapter });
}

function jsonReplacer(_key, value) {
  if (typeof value === 'bigint') {
    return value.toString();
  }

  return value;
}

const prisma = makeClient();

async function raw(sql) {
  return prisma.$queryRawUnsafe(sql);
}

async function main() {
  await prisma.$connect();

  const identity = (
    await raw(`
      SELECT
        @@SERVERNAME AS currentServer,
        DB_NAME() AS currentDatabase,
        SUSER_SNAME() AS loginName
    `)
  )[0];

  /*
   * SQL Server treats ROWCOUNT as a keyword.
   * Use totalRows instead of the previous unquoted rowCount alias.
   */
  const userTables = await raw(`
    SELECT
      s.name AS schemaName,
      t.name AS tableName,
      SUM(
        CASE
          WHEN p.index_id IN (0, 1) THEN p.rows
          ELSE 0
        END
      ) AS totalRows
    FROM sys.tables t
    JOIN sys.schemas s
      ON s.schema_id = t.schema_id
    LEFT JOIN sys.partitions p
      ON p.object_id = t.object_id
    WHERE t.is_ms_shipped = 0
    GROUP BY
      s.name,
      t.name
    ORDER BY
      s.name,
      t.name
  `);

  let backupHistoryAccessible = true;
  let backupHistoryError = null;
  let backupHistory = [];

  try {
    backupHistory = await raw(`
      SELECT TOP (200)
        bs.database_name AS databaseName,
        bs.type AS backupTypeCode,
        bs.backup_start_date AS backupStart,
        bs.backup_finish_date AS backupFinish,
        bs.backup_size AS backupSizeBytes,
        bs.compressed_backup_size AS compressedBackupSizeBytes,
        bs.recovery_model AS recoveryModel,
        bs.is_copy_only AS isCopyOnly,
        bmf.physical_device_name AS physicalDevice
      FROM msdb.dbo.backupset bs
      LEFT JOIN msdb.dbo.backupmediafamily bmf
        ON bmf.media_set_id = bs.media_set_id
      WHERE
        LOWER(bs.database_name) =
        LOWER(DB_NAME())
      ORDER BY
        bs.backup_finish_date DESC
    `);
  } catch (error) {
    backupHistoryAccessible = false;
    backupHistoryError =
      error instanceof Error
        ? error.message
        : String(error);
  }

  let restoreHistoryAccessible = true;
  let restoreHistoryError = null;
  let restoreHistory = [];

  try {
    restoreHistory = await raw(`
      SELECT TOP (200)
        rh.destination_database_name AS destinationDatabase,
        rh.restore_date AS restoreDate,
        rh.restore_type AS restoreType,
        rh.replace AS usedReplace,
        rh.recovery AS recovery,
        bs.database_name AS sourceDatabase,
        bs.backup_finish_date AS sourceBackupFinish,
        bmf.physical_device_name AS sourcePhysicalDevice
      FROM msdb.dbo.restorehistory rh
      LEFT JOIN msdb.dbo.backupset bs
        ON bs.backup_set_id = rh.backup_set_id
      LEFT JOIN msdb.dbo.backupmediafamily bmf
        ON bmf.media_set_id = bs.media_set_id
      WHERE
        LOWER(rh.destination_database_name) =
          LOWER(DB_NAME())
        OR LOWER(bs.database_name) =
          LOWER(DB_NAME())
      ORDER BY
        rh.restore_date DESC
    `);
  } catch (error) {
    restoreHistoryAccessible = false;
    restoreHistoryError =
      error instanceof Error
        ? error.message
        : String(error);
  }

  const fullBackups = backupHistory.filter(
    (row) =>
      String(
        row.backupTypeCode ?? '',
      ).toUpperCase() === 'D',
  );

  const nonSystemUserTables = userTables.filter(
    (row) =>
      String(row.tableName) !==
      '_prisma_migrations',
  );

  let decision =
    'STOP_REVIEW_REQUIRED';

  const reasons = [];

  if (!backupHistoryAccessible) {
    reasons.push(
      'msdb backup history could not be read; do not assume no backup exists.',
    );
  }

  if (!restoreHistoryAccessible) {
    reasons.push(
      'msdb restore history could not be read.',
    );
  }

  if (fullBackups.length > 0) {
    reasons.push(
      `${fullBackups.length} FULL backup record(s) exist for the current database; recovery should be evaluated before rebuilding.`,
    );
  }

  if (nonSystemUserTables.length > 0) {
    reasons.push(
      `${nonSystemUserTables.length} user table(s) still exist in the current database; clean rebuild must not overwrite them without review.`,
    );
  }

  if (
    backupHistoryAccessible &&
    restoreHistoryAccessible &&
    fullBackups.length === 0 &&
    nonSystemUserTables.length === 0
  ) {
    decision =
      'READY_TO_GENERATE_REBUILD_CANDIDATE';

    reasons.push(
      'No FULL backup record was found in readable msdb history and the current database has no user tables.',
    );
  }

  const report = {
    generatedAt:
      new Date().toISOString(),

    identity,
    decision,
    reasons,

    userTables,
    nonSystemUserTableCount:
      nonSystemUserTables.length,

    backupHistoryAccessible,
    backupHistoryError,
    backupHistory,
    fullBackupCount:
      fullBackups.length,

    restoreHistoryAccessible,
    restoreHistoryError,
    restoreHistory,
  };

  const outputPath =
    path.resolve(
      process.cwd(),
      'sql',
      'rebuild-readiness-report.json',
    );

  fs.mkdirSync(
    path.dirname(outputPath),
    {
      recursive: true,
    },
  );

  fs.writeFileSync(
    outputPath,
    JSON.stringify(
      report,
      jsonReplacer,
      2,
    ),
    'utf8',
  );

  console.log('');
  console.log(
    'SOMIPHARM CLEAN REBUILD READINESS',
  );
  console.log(
    '=================================',
  );

  console.log(
    `Server:   ${
      identity?.currentServer ??
      'unknown'
    }`,
  );

  console.log(
    `Database: ${
      identity?.currentDatabase ??
      'unknown'
    }`,
  );

  console.log(
    `User tables: ${nonSystemUserTables.length}`,
  );

  console.log(
    `FULL backups in msdb: ${fullBackups.length}`,
  );

  console.log(
    `Backup history readable: ${
      backupHistoryAccessible
        ? 'YES'
        : 'NO'
    }`,
  );

  console.log(
    `Restore history readable: ${
      restoreHistoryAccessible
        ? 'YES'
        : 'NO'
    }`,
  );

  console.log('');
  console.log(
    `DECISION: ${decision}`,
  );

  for (const reason of reasons) {
    console.log(`- ${reason}`);
  }

  console.log('');
  console.log(
    `Report saved to: ${outputPath}`,
  );

  if (
    decision ===
    'READY_TO_GENERATE_REBUILD_CANDIDATE'
  ) {
    process.exitCode = 0;
  } else {
    process.exitCode = 2;
  }
}

main()
  .catch((error) => {
    console.error(error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma
      .$disconnect()
      .catch(
        () => undefined,
      );
  });
</file>

<file path="backend/scripts/discover-app-databases.mjs">
import 'dotenv/config';

import { PrismaMssql } from '@prisma/adapter-mssql';
import { PrismaClient } from '../dist/generated/prisma/client.js';
import fs from 'node:fs';
import path from 'node:path';

const EXPECTED_TABLES = [
  'Stock',
  'StockStatus',
  'Shelf',
  'Equipment',
  'EquipmentShelfs',
  'SerialNumber',
  'Mouvement',
  'MovementEquipment',
  'Inventory',
  'InventoryWorkUnit',
  'InventoryCountAttempt',
  'Order',
];

const STRONG_HINTS = [
  'Stock',
  'Shelf',
  'Equipment',
  'SerialNumber',
  'Mouvement',
  'Inventory',
];

function required(name) {
  const value = process.env[name];

  if (!value) {
    throw new Error(`Missing environment variable: ${name}`);
  }

  return value;
}

function quoteSqlIdentifier(identifier) {
  return `[${String(identifier).replaceAll(']', ']]')}]`;
}

function makeClient() {
  const adapter = new PrismaMssql({
    server: required('DB_HOST'),
    port: Number(process.env.DB_PORT ?? 1433),
    database: required('DB_NAME'),
    user: required('DB_USER'),
    password: required('DB_PASSWORD'),
    options: {
      encrypt: true,
      trustServerCertificate: true,
    },
  });

  return new PrismaClient({ adapter });
}

const prisma = makeClient();

async function raw(sql) {
  return prisma.$queryRawUnsafe(sql);
}

async function inspectDatabase(databaseName) {
  const db = quoteSqlIdentifier(databaseName);

  try {
    const tables = await raw(`
      SELECT t.name AS tableName
      FROM ${db}.sys.tables t
      WHERE t.is_ms_shipped = 0
      ORDER BY t.name
    `);

    const tableNames = tables.map((row) => String(row.tableName));
    const set = new Set(tableNames);

    const expectedFound = EXPECTED_TABLES.filter((name) => set.has(name));
    const strongFound = STRONG_HINTS.filter((name) => set.has(name));

    return {
      databaseName,
      accessible: true,
      expectedFound,
      expectedCount: expectedFound.length,
      strongHintsFound: strongFound,
      strongHintCount: strongFound.length,
      totalUserTables: tableNames.length,
      allUserTables: tableNames,
    };
  } catch (error) {
    return {
      databaseName,
      accessible: false,
      expectedFound: [],
      expectedCount: 0,
      strongHintsFound: [],
      strongHintCount: 0,
      totalUserTables: 0,
      allUserTables: [],
      error:
        error instanceof Error
          ? error.message
          : String(error),
    };
  }
}

async function main() {
  await prisma.$connect();

  const identity = (
    await raw(`
      SELECT
        @@SERVERNAME AS currentServer,
        DB_NAME() AS currentDatabase,
        SUSER_SNAME() AS loginName
    `)
  )[0];

  const databases = await raw(`
    SELECT
      name,
      state_desc AS stateDesc,
      recovery_model_desc AS recoveryModel,
      create_date AS createDate
    FROM sys.databases
    WHERE
      state_desc = 'ONLINE'
      AND HAS_DBACCESS(name) = 1
    ORDER BY name
  `);

  const inspected = [];

  for (const database of databases) {
    inspected.push(
      await inspectDatabase(String(database.name)),
    );
  }

  inspected.sort((a, b) => {
    if (b.expectedCount !== a.expectedCount) {
      return b.expectedCount - a.expectedCount;
    }

    if (b.strongHintCount !== a.strongHintCount) {
      return b.strongHintCount - a.strongHintCount;
    }

    return a.databaseName.localeCompare(b.databaseName);
  });

  const candidates = inspected.filter(
    (db) => db.expectedCount > 0 || db.strongHintCount > 0,
  );

  const exactCandidates = inspected.filter(
    (db) => db.expectedCount === EXPECTED_TABLES.length,
  );

  const report = {
    generatedAt: new Date().toISOString(),
    server: identity?.currentServer ?? null,
    currentDatabase: identity?.currentDatabase ?? null,
    loginName: identity?.loginName ?? null,
    expectedTables: EXPECTED_TABLES,
    exactCandidateCount: exactCandidates.length,
    candidateCount: candidates.length,
    exactCandidates: exactCandidates.map((db) => db.databaseName),
    candidates,
    allAccessibleDatabases: inspected.map((db) => ({
      databaseName: db.databaseName,
      accessible: db.accessible,
      expectedCount: db.expectedCount,
      strongHintCount: db.strongHintCount,
      totalUserTables: db.totalUserTables,
      error: db.error,
    })),
  };

  const outputPath = path.resolve(
    process.cwd(),
    'sql',
    'database-discovery-report.json',
  );

  fs.mkdirSync(path.dirname(outputPath), {
    recursive: true,
  });

  fs.writeFileSync(
    outputPath,
    JSON.stringify(report, null, 2),
    'utf8',
  );

  console.log('');
  console.log('SOMIPHARM DATABASE DISCOVERY');
  console.log('============================');
  console.log(`Server:           ${report.server ?? 'unknown'}`);
  console.log(`Current database: ${report.currentDatabase ?? 'unknown'}`);
  console.log(`Accessible DBs:   ${inspected.length}`);
  console.log('');

  if (candidates.length === 0) {
    console.log(
      'NO candidate database contains any of the expected SOMIPHARM tables.',
    );
    console.log('');
    console.log(
      'This strongly suggests the schema was deleted/reset, or exists on another SQL Server instance/login.',
    );
  } else {
    console.log('Candidates ranked by expected table count:');
    console.log('');

    for (const db of candidates) {
      console.log(
        `${db.databaseName.padEnd(32)} ${String(db.expectedCount).padStart(2)}/${EXPECTED_TABLES.length} expected tables`,
      );

      if (db.expectedFound.length > 0) {
        console.log(`  found: ${db.expectedFound.join(', ')}`);
      }

      if (db.totalUserTables > 0) {
        console.log(`  user tables total: ${db.totalUserTables}`);
      }
    }
  }

  console.log('');
  console.log(`Report saved to: ${outputPath}`);

  if (exactCandidates.length === 1) {
    console.log('');
    console.log(
      `LIKELY APPLICATION DATABASE: ${exactCandidates[0].databaseName}`,
    );
    process.exitCode = 0;
    return;
  }

  if (exactCandidates.length > 1) {
    console.log('');
    console.log(
      'Multiple databases contain all expected tables. Manual review is required.',
    );
    process.exitCode = 2;
    return;
  }

  if (candidates.length > 0) {
    console.log('');
    console.log(
      'Partial candidate(s) found. Do not change .env yet; review the report first.',
    );
    process.exitCode = 3;
    return;
  }

  process.exitCode = 4;
}

main()
  .catch((error) => {
    console.error(error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect().catch(() => undefined);
  });
</file>

<file path="backend/scripts/inspect-baseline-test-state.mjs">
import 'dotenv/config';

import { PrismaMssql } from '@prisma/adapter-mssql';
import { PrismaClient } from '../dist/generated/prisma/client.js';

const DATABASE = 'yacinedb_baseline_test';
const BASELINE = '20260923_baseline';

function required(name) {
  const value = process.env[name];

  if (!value) {
    throw new Error(`Missing environment variable: ${name}`);
  }

  return value;
}

const prisma = new PrismaClient({
  adapter: new PrismaMssql({
    server: required('DB_HOST'),
    port: Number(process.env.DB_PORT ?? 1433),
    database: DATABASE,
    user: required('DB_USER'),
    password: required('DB_PASSWORD'),
    options: {
      encrypt: true,
      trustServerCertificate: true,
    },
  }),
});

async function main() {
  await prisma.$connect();

  const identity = (
    await prisma.$queryRawUnsafe(`
      SELECT
        @@SERVERNAME AS currentServer,
        DB_NAME() AS currentDatabase
    `)
  )[0];

  if (
    String(identity?.currentDatabase ?? '').toLowerCase() !==
    DATABASE
  ) {
    throw new Error(
      `Safety stop: connected to ${identity?.currentDatabase}, expected ${DATABASE}.`,
    );
  }

  const tables = await prisma.$queryRawUnsafe(`
    SELECT
      s.name AS schemaName,
      t.name AS tableName
    FROM sys.tables t
    JOIN sys.schemas s
      ON s.schema_id = t.schema_id
    WHERE
      t.is_ms_shipped = 0
    ORDER BY
      s.name,
      t.name
  `);

  const hasMigrationTable =
    tables.some(
      (row) =>
        String(row.tableName) === '_prisma_migrations',
    );

  let migrations = [];

  if (hasMigrationTable) {
    migrations = await prisma.$queryRawUnsafe(`
      SELECT
        migration_name AS migrationName,
        started_at AS startedAt,
        finished_at AS finishedAt,
        rolled_back_at AS rolledBackAt,
        applied_steps_count AS appliedStepsCount
      FROM dbo._prisma_migrations
      ORDER BY started_at
    `);
  }

  const baselineRows = migrations.filter(
    (row) =>
      String(row.migrationName) === BASELINE,
  );

  const baselineApplied =
    baselineRows.length === 1 &&
    Boolean(baselineRows[0].finishedAt) &&
    !baselineRows[0].rolledBackAt;

  const failedOrRolledBack =
    baselineRows.some(
      (row) =>
        !row.finishedAt ||
        Boolean(row.rolledBackAt),
    );

  console.log('');
  console.log('BASELINE TEST DATABASE STATE');
  console.log('============================');
  console.log(`Database: ${identity?.currentDatabase}`);
  console.log(`User tables: ${tables.length}`);
  console.log(
    `Prisma migration table: ${hasMigrationTable ? 'YES' : 'NO'}`,
  );
  console.log(
    `Migration rows: ${migrations.length}`,
  );

  for (const row of migrations) {
    console.log(
      `- ${row.migrationName} | finished=${row.finishedAt ? 'YES' : 'NO'} | rolledBack=${row.rolledBackAt ? 'YES' : 'NO'}`,
    );
  }

  console.log('');
  console.log(
    `Validated baseline row applied: ${baselineApplied ? 'YES' : 'NO'}`,
  );

  if (baselineApplied && !failedOrRolledBack) {
    console.log(
      'RESUME_OK: baseline migration is already applied; continue with seed + verification.',
    );
    process.exitCode = 0;
    return;
  }

  console.log(
    'RESUME_BLOCKED: do not seed or register production yet.',
  );

  if (!hasMigrationTable) {
    console.log(
      'Reason: populated test DB has no Prisma migration history.',
    );
  } else if (baselineRows.length === 0) {
    console.log(
      'Reason: 20260923_baseline is not recorded as applied.',
    );
  } else if (failedOrRolledBack) {
    console.log(
      'Reason: baseline migration row is failed or rolled back.',
    );
  } else if (baselineRows.length > 1) {
    console.log(
      'Reason: duplicate baseline migration rows exist.',
    );
  }

  process.exitCode = 3;
}

main()
  .catch((error) => {
    console.error(error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect().catch(() => undefined);
  });
</file>

<file path="backend/scripts/inspect-db-targets.mjs">
import 'dotenv/config';

import { PrismaMssql } from '@prisma/adapter-mssql';
import { PrismaClient } from '../dist/generated/prisma/client.js';
import fs from 'node:fs';
import path from 'node:path';

function required(name) {
  const value = process.env[name];

  if (!value) {
    throw new Error(`Missing environment variable: ${name}`);
  }

  return value;
}

function parseBoolean(value, fallback) {
  if (value == null || value === '') {
    return fallback;
  }

  return String(value).toLowerCase() === 'true';
}

function parseSqlServerUrl(url) {
  const prefix = 'sqlserver://';

  if (!url.startsWith(prefix)) {
    throw new Error('DATABASE_URL must start with sqlserver://');
  }

  const body = url.slice(prefix.length);
  const parts = body.split(';');
  const serverPart = parts.shift() ?? '';
  const lastColon = serverPart.lastIndexOf(':');

  const server =
    lastColon > -1
      ? serverPart.slice(0, lastColon)
      : serverPart;

  const port =
    lastColon > -1
      ? Number(serverPart.slice(lastColon + 1))
      : 1433;

  const options = {};

  for (const part of parts) {
    const separator = part.indexOf('=');

    if (separator <= 0) {
      continue;
    }

    const key = part
      .slice(0, separator)
      .trim()
      .toLowerCase();

    const value = part
      .slice(separator + 1)
      .trim();

    options[key] = value;
  }

  return {
    server,
    port,
    database:
      options.database ?? '',
    user:
      options.user ?? '',
    password:
      options.password ?? '',
    encrypt: parseBoolean(
      options.encrypt,
      true,
    ),
    trustServerCertificate:
      parseBoolean(
        options.trustservercertificate,
        true,
      ),
  };
}

function runtimeConfig() {
  return {
    server:
      required('DB_HOST'),

    port:
      Number(
        process.env.DB_PORT ??
          1433,
      ),

    database:
      required('DB_NAME'),

    user:
      required('DB_USER'),

    password:
      required('DB_PASSWORD'),

    encrypt: true,
    trustServerCertificate: true,
  };
}

function cliConfig() {
  return parseSqlServerUrl(
    required(
      'DATABASE_URL',
    ),
  );
}

function safeConfig(config) {
  return {
    server:
      config.server,

    port:
      config.port,

    database:
      config.database,

    user:
      config.user,

    encrypt:
      config.encrypt,

    trustServerCertificate:
      config.trustServerCertificate,
  };
}

async function inspect(
  label,
  config,
) {
  const adapter =
    new PrismaMssql({
      server:
        config.server,

      port:
        config.port,

      database:
        config.database,

      user:
        config.user,

      password:
        config.password,

      options: {
        encrypt:
          config.encrypt,

        trustServerCertificate:
          config.trustServerCertificate,
      },
    });

  const prisma =
    new PrismaClient({
      adapter,
    });

  try {
    await prisma.$connect();

    const identityRows =
      await prisma.$queryRawUnsafe(`
        SELECT
          DB_NAME() AS currentDatabase,
          @@SERVERNAME AS currentServer
      `);

    const tableRows =
      await prisma.$queryRawUnsafe(`
        SELECT
          t.name AS tableName
        FROM sys.tables t
        WHERE t.name IN (
          'Stock',
          'StockStatus',
          'Shelf',
          'Equipment',
          'EquipmentShelfs',
          'SerialNumber',
          'Mouvement',
          'MovementEquipment',
          'Inventory',
          'InventoryWorkUnit',
          'InventoryCountAttempt',
          'Order'
        )
        ORDER BY t.name
      `);

    return {
      label,

      configured:
        safeConfig(
          config,
        ),

      connected: true,

      identity:
        identityRows[0] ??
        null,

      expectedTablesFound:
        tableRows.map(
          (row) =>
            row.tableName,
        ),
    };
  } catch (error) {
    return {
      label,

      configured:
        safeConfig(
          config,
        ),

      connected: false,

      error:
        error instanceof Error
          ? error.message
          : String(error),
    };
  } finally {
    await prisma
      .$disconnect()
      .catch(
        () => undefined,
      );
  }
}

const runtime =
  runtimeConfig();

const cli =
  cliConfig();

const [
  runtimeResult,
  cliResult,
] =
  await Promise.all([
    inspect(
      'Nest runtime DB_*',
      runtime,
    ),

    inspect(
      'Prisma CLI DATABASE_URL',
      cli,
    ),
  ]);

const sameConfiguredTarget =
  runtime.server.toLowerCase() ===
    cli.server.toLowerCase() &&
  Number(runtime.port) ===
    Number(cli.port) &&
  runtime.database.toLowerCase() ===
    cli.database.toLowerCase();

const sameConnectedTarget =
  runtimeResult.connected &&
  cliResult.connected &&
  String(
    runtimeResult.identity
      ?.currentServer ??
      '',
  ).toLowerCase() ===
    String(
      cliResult.identity
        ?.currentServer ??
        '',
    ).toLowerCase() &&
  String(
    runtimeResult.identity
      ?.currentDatabase ??
      '',
  ).toLowerCase() ===
    String(
      cliResult.identity
        ?.currentDatabase ??
        '',
    ).toLowerCase();

const report = {
  generatedAt:
    new Date().toISOString(),

  sameConfiguredTarget,
  sameConnectedTarget,

  runtime:
    runtimeResult,

  prismaCli:
    cliResult,
};

const outputPath =
  path.resolve(
    process.cwd(),
    'sql',
    'db-target-alignment-report.json',
  );

fs.mkdirSync(
  path.dirname(
    outputPath,
  ),
  {
    recursive: true,
  },
);

fs.writeFileSync(
  outputPath,
  JSON.stringify(
    report,
    null,
    2,
  ),
  'utf8',
);

console.log('');
console.log(
  'SOMIPHARM DATABASE TARGET ALIGNMENT',
);
console.log(
  '==================================',
);
console.log(
  `Configured target match: ${
    sameConfiguredTarget
      ? 'YES'
      : 'NO'
  }`,
);
console.log(
  `Connected target match:  ${
    sameConnectedTarget
      ? 'YES'
      : 'NO'
  }`,
);
console.log('');

for (
  const result of [
    runtimeResult,
    cliResult,
  ]
) {
  console.log(
    result.label,
  );

  console.log(
    `  configured server:   ${result.configured.server}:${result.configured.port}`,
  );

  console.log(
    `  configured database: ${result.configured.database}`,
  );

  console.log(
    `  configured user:     ${result.configured.user}`,
  );

  if (result.connected) {
    console.log(
      `  connected server:    ${
        result.identity
          ?.currentServer ??
        'unknown'
      }`,
    );

    console.log(
      `  connected database:  ${
        result.identity
          ?.currentDatabase ??
        'unknown'
      }`,
    );

    console.log(
      `  expected tables:     ${result.expectedTablesFound.length}/12`,
    );
  } else {
    console.log(
      '  connection:           FAILED',
    );

    console.log(
      `  error:                ${result.error}`,
    );
  }

  console.log('');
}

console.log(
  `Report saved to: ${outputPath}`,
);

if (
  !sameConfiguredTarget ||
  !sameConnectedTarget
) {
  process.exitCode = 2;
}
