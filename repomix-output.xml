const fs = require('fs');
const path = require('path');

const filePath = path.resolve(__dirname, '../backend/src/inventory/inventory.service.ts');
let code = fs.readFileSync(filePath, 'utf8');

// Replace this.prisma.inventoryInvestigationIssue.findMany
code = code.replace(
