                          >
                            <span
                              className={`w-1.5 h-1.5 rounded-full ${
                                status === 'ACTIVE'
                                  ? 'bg-[#10b981]'
                                  : 'bg-[#f59e0b]'
                              }`}
                            />
                            <span>{status}</span>
                          </span>
                        </td>

                        {/* Shelves count */}
                        <td className="px-4 py-3">
