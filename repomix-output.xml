<file path="frontend/src/components/shelf/DeleteShelfModal.tsx">
'use client';

import { useState } from 'react';
import { AlertTriangle, Loader2, ShieldAlert, Trash2, X } from 'lucide-react';

import type { Shelf } from '@/types/shelf';
import { useShelves } from '@/hooks/use-shelves';
import { usePermissions } from '@/hooks/use-permissions';
import { getErrorMessage } from '@/lib/error-message';

interface DeleteShelfModalProps {
  shelf: Shelf | null;
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export function DeleteShelfModal({ shelf, isOpen, onClose, onSuccess }: DeleteShelfModalProps) {
  const { deleteShelf, isDeleting } = useShelves({ enabled: false });
  const { canDeleteShelf } = usePermissions();
  const [error, setError] = useState<string | null>(null);

  if (!isOpen || !shelf) return null;

  async function handleDelete() {
    setError(null);
    if (!canDeleteShelf) {
      setError("Permission 'shelf.delete' requise.");
      return;
    }

    try {
      await deleteShelf(shelf!.shelfId);
      onSuccess?.();
      onClose();
    } catch (cause: unknown) {
      setError(getErrorMessage(cause, 'Impossible de supprimer cet emplacement.'));
    }
  }

  return (
    <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/55 p-4 backdrop-blur-sm">
      <div className="w-full max-w-md overflow-hidden rounded-xl border border-[#3f3f46] bg-[#27272a] text-white shadow-2xl">
        <header className="flex items-center justify-between border-b border-[#3f3f46] bg-[#18181b] px-5 py-4">
          <h2 className="flex items-center gap-2 text-sm font-semibold"><Trash2 className="h-4 w-4 text-rose-300" />Supprimer l’emplacement</h2>
          <button type="button" onClick={onClose} className="rounded p-1.5 text-white/60 hover:bg-white/10"><X className="h-4 w-4" /></button>
        </header>

        <div className="space-y-4 p-5">
          {error && <div className="flex gap-2 rounded-lg border border-rose-500/40 bg-rose-950/40 p-3 text-xs text-rose-200"><ShieldAlert className="h-4 w-4 shrink-0" />{error}</div>}
          <div className="flex gap-2.5 rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-[11px] text-amber-100">
            <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
            <div className="space-y-1"><p className="font-semibold">Suppression protégée.</p><p>Le backend refusera la suppression si l’emplacement contient du stock, un numéro de série ou un historique de mouvements.</p></div>
          </div>
          <div className="rounded-lg border border-[#3f3f46] bg-[#18181b]/65 p-3 text-xs">
            <p className="font-semibold">{shelf.shelfName ?? 'Emplacement sans nom'}</p>
          </div>
        </div>

        <footer className="flex justify-end gap-2 border-t border-[#3f3f46] bg-[#18181b] px-5 py-3">
          <button type="button" onClick={onClose} disabled={isDeleting} className="rounded border border-[#3f3f46] px-3 py-1.5 text-xs">Annuler</button>
          <button type="button" onClick={handleDelete} disabled={isDeleting || !canDeleteShelf} className="inline-flex items-center gap-1.5 rounded bg-rose-600 px-3.5 py-1.5 text-xs disabled:opacity-40">
            {isDeleting && <Loader2 className="h-3.5 w-3.5 animate-spin" />}Supprimer
          </button>
        </footer>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/hooks/use-equipments.ts">
'use client';

import {
  keepPreviousData,
  useMutation,
  useQuery,
  useQueryClient,
} from '@tanstack/react-query';
import {
  useCallback,
  useState,
} from 'react';
import {
  toast,
} from 'sonner';

import {
  useApi,
} from './use-api';
import { useAuthQueryContext } from './use-auth-query-context';
import {
  usePermissions,
} from './use-permissions';

import {
  EquipmentService,
} from '@/services/equipment.service';

import type {
  CreateEquipmentDirectInput,
  EquipmentPaginationQuery,
  UpdateEquipmentInput,
} from '@/types/equipment';

interface UseEquipmentsOptions
  extends EquipmentPaginationQuery {
  initialSearch?: string;
  enabled?: boolean;
}

export function useEquipments(
  options?: UseEquipmentsOptions,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient =
    useQueryClient();

  const {
    permissions,
  } = usePermissions();

  const [
    page,
    setPage,
  ] = useState(
    options?.page ?? 1,
  );

  const [
    limit,
    setLimit,
  ] = useState(
    options?.limit ?? 10,
  );

  const [
    searchTerm,
    setSearchTerm,
  ] = useState(
    options?.initialSearch ??
      '',
  );

  const [
    equipmentStatus,
    setEquipmentStatus,
  ] = useState(
    options?.equipmentStatus,
  );

  const [
    hasSerialNumber,
    setHasSerialNumber,
  ] = useState<
    boolean | undefined
  >(
    options?.hasSerialNumber,
  );

  const equipmentsQuery =
    useQuery({
      queryKey: [
        'equipments',
        {
          page,
          limit,
          searchTerm,
          equipmentStatus,
          hasSerialNumber,
        }, userId],

      queryFn: () => {
        const filtered =
          Boolean(
            searchTerm.trim(),
          ) ||
          equipmentStatus !==
            undefined ||
          hasSerialNumber !==
            undefined;

        return filtered
          ? EquipmentService.searchEquipments(
              api,
              {
                page,
                limit,
                equipmentName:
                  searchTerm.trim() ||
                  undefined,
                equipmentStatus,
                hasSerialNumber,
              },
            )
          : EquipmentService.getAllEquipments(
              api,
              {
                page,
                limit,
              },
            );
      },

      enabled:
        options?.enabled ??
        true,

      placeholderData:
        keepPreviousData,

      staleTime: 20_000,
    });

  const createMutation =
    useMutation({
      mutationFn: (
        input: CreateEquipmentDirectInput,
      ) =>
        EquipmentService.createEquipmentDirect(
          api,
          input,
          permissions,
        ),

      onSuccess:
        async (equipment) => {
          await Promise.all([
            queryClient.invalidateQueries({
              queryKey: [
                'equipments', userId],
            }),
            queryClient.invalidateQueries({
              queryKey: [
                'serial-numbers', userId],
            }),
          ]);

          toast.success(
            'Article créé',
            {
              description:
                equipment.equipmentName ??
                'Nouvel article',
            },
          );
        },
    });

  const updateMutation =
    useMutation({
      mutationFn: ({
        id,
        input,
      }: {
        id: string;
        input: UpdateEquipmentInput;
      }) =>
        EquipmentService.updateEquipment(
          api,
          id,
          input,
          permissions,
        ),

      onSuccess:
        async (equipment) => {
          await Promise.all([
            queryClient.invalidateQueries({
              queryKey: [
                'equipments', userId],
            }),
            queryClient.invalidateQueries({
              queryKey: [
                'equipment',
                equipment.equipmentId, userId],
            }),
            queryClient.invalidateQueries({
              queryKey: [
                'serial-numbers', userId],
            }),
          ]);

          toast.success(
            'Article modifié',
          );
        },
    });

  const deleteMutation =
    useMutation({
      mutationFn: (
        id: string,
      ) =>
        EquipmentService.deleteEquipment(
          api,
          id,
          permissions,
        ),

      onSuccess: async () => {
        await queryClient.invalidateQueries({
          queryKey: [
            'equipments', userId],
        });

        toast.success(
          'Article supprimé',
        );
      },
    });

  const handleSearch =
    useCallback(
      (value: string) => {
        setSearchTerm(
          value,
        );
        setPage(1);
      },
      [],
    );

  return {
    equipments:
      equipmentsQuery.data
        ?.equipments ?? [],

    totalEquipments:
      equipmentsQuery.data
        ?.totalEquipments ?? 0,

    totalPages:
      equipmentsQuery.data
        ?.totalPages ?? 1,

    currentPage: page,
    limit,
    searchTerm,
    equipmentStatus,
    hasSerialNumber,

    setSearchTerm:
      handleSearch,

    setEquipmentStatus: (value: boolean | undefined) => {
      setEquipmentStatus(
        value,
      );
      setPage(1);
    },

    setHasSerialNumber: (
      value:
        | boolean
        | undefined,
    ) => {
      setHasSerialNumber(
        value,
      );
      setPage(1);
    },

    setPage,
    setLimit,

    isLoading:
      equipmentsQuery.isLoading,
    isFetching:
      equipmentsQuery.isFetching,
    isError:
      equipmentsQuery.isError,
    error:
      equipmentsQuery.error,
    refetch:
      equipmentsQuery.refetch,

    getEquipmentById:
      (
        id: string,
      ) =>
        EquipmentService.getEquipmentById(
          api,
          id,
        ),

    getEquipmentShelves:
      (
        id: string,
      ) =>
        EquipmentService.getEquipmentShelves(
          api,
          id,
          permissions,
        ),

    createEquipment:
      createMutation.mutateAsync,
    isCreatingEquipment:
      createMutation.isPending,

    updateEquipment:
      updateMutation.mutateAsync,
    isUpdating:
      updateMutation.isPending,

    deleteEquipment:
      deleteMutation.mutateAsync,
    isDeleting:
      deleteMutation.isPending,
  };
}

export function useEquipmentAllocations(equipmentId: string, enabled = true) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const { permissions } = usePermissions();

  return useQuery({
    queryKey: ['equipment', equipmentId, 'allocations', userId],
    queryFn: () => EquipmentService.getEquipmentShelves(api, equipmentId, permissions),
    enabled: enabled && Boolean(equipmentId),
    staleTime: 30_000,
  });
}
</file>

<file path="frontend/src/hooks/use-inventory.ts">
'use client';

import {
  keepPreviousData,
  useMutation,
  useQuery,
  useQueryClient,
} from '@tanstack/react-query';
import {
  toast,
} from 'sonner';

import { useApi } from './use-api';
import { useAuthQueryContext } from './use-auth-query-context';
import { getErrorMessage } from '@/lib/error-message';

import type {
  CreateInventoryInput,
  Inventory,
  InventoryProgress,
  InventoryReport,
  InventoryTask,
  PaginatedInventoriesResponse,
  SubmitInventoryTaskInput,
} from '@/types/inventory';

export function useInventories(
  page = 1,
  limit = 20,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  return useQuery<PaginatedInventoriesResponse>({
    queryKey: ['inventories', page, limit, userId],
    enabled: Boolean(authReady && userId),
    queryFn: async () => {
      const response =
        await api.get<PaginatedInventoriesResponse>(
          '/inventory',
          {
            params: { page, limit },
          },
        );

      return response.data;
    },
    placeholderData: keepPreviousData,
  });
}

export function useInventoryById(
  inventoryId?: string | null,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  return useQuery<Inventory>({
    queryKey: ['inventories', 'detail', inventoryId, userId],
    
    queryFn: async () => {
      const response =
        await api.get<Inventory>(
          `/inventory/${inventoryId}`,
        );

      return response.data;
    },
    enabled: Boolean(inventoryId),
  });
}

export function useMyTasks() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  return useQuery<InventoryTask[]>({
    queryKey: ['inventory', 'my-tasks', userId],
    enabled: Boolean(authReady && userId),
    queryFn: async () => {
      const response =
        await api.get<InventoryTask[]>(
          '/inventory/my-tasks',
        );

      return response.data;
    },
    refetchInterval: 5000,
  });
}

export function useInventoryTask(
  taskId?: string | null,
) {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();

  return useQuery<InventoryTask>({
    queryKey: ['inventory', 'task', taskId, userId],
    
    queryFn: async () => {
      const response =
        await api.get<InventoryTask>(
          `/inventory/tasks/${taskId}`,
        );

      return response.data;
    },
    enabled: Boolean(taskId),
  });
}

export function useCreateInventory() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async (
      data: CreateInventoryInput,
    ) => {
      const response =
        await api.post<Inventory>(
          '/inventory',
          data,
        );

      return response.data;
    },

    onSuccess: async () => {
      await queryClient.invalidateQueries({
        queryKey: ['inventories', userId],
      });

      toast.success('Inventaire créé');
    },

    onError: (error: unknown) => {
      toast.error('Création impossible', {
        description: getErrorMessage(
          error,
          'Impossible de créer l’inventaire.',
        ),
      });
    },
  });
}

export function useLaunchInventory() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async (
      inventoryId: string,
    ) => {
      const response =
        await api.post(
          `/inventory/${inventoryId}/launch`,
        );

      return response.data;
    },

    onSuccess: async (_, inventoryId) => {
      await Promise.all([
        queryClient.invalidateQueries({
          queryKey: ['inventories', userId],
        }),
        queryClient.invalidateQueries({
          queryKey: ['inventories', 'detail', inventoryId, userId],
        }),
        queryClient.invalidateQueries({
          queryKey: ['inventory', 'my-tasks', userId],
        }),
      ]);

      toast.success('Inventaire lancé');
    },

    onError: (error: unknown) => {
      toast.error('Lancement impossible', {
        description: getErrorMessage(
          error,
          'Le périmètre est peut-être occupé par une autre opération.',
        ),
      });
    },
  });
}

export function useSaveInventoryTaskDraft() {
  const api = useApi();
  const { userId, authReady } = useAuthQueryContext();
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async ({
      taskId,
      data,
    }: {
      taskId: string;
      data: SubmitInventoryTaskInput;
    }) => {
      const response =
        await api.patch(
          `/inventory/tasks/${taskId}/draft`,
          {
            ...data,
            isDraft: true,
          },
        );

      return response.data;
    },

    onSuccess: async (_, variables) => {
      await queryClient.invalidateQueries({
        queryKey: ['inventory', 'task', variables.taskId, userId],
