                        {issue.deltaQuantity
                          ? ` • écart ${issue.deltaQuantity}`
                          : ''}
                      </p>
                    </div>
                  ),
                )}
              </div>
            ) : (
              <p className="mt-3 text-xs text-[#71717a]">
                Aucun écart d’investigation enregistré.
              </p>
            )}
          </div>

          <div className="rounded-lg border border-[#3f3f46] bg-[#27272a] p-4">
            <h2 className="flex items-center gap-2 text-xs font-semibold">
              <CheckCircle2 className="h-3.5 w-3.5 text-emerald-300" />
              Traçabilité
            </h2>

            <div className="mt-3 space-y-2 text-xs text-[#d4d4d8]">
              <p>
                Créé :{' '}
                {formatDate(
                  r.inventory
                    .createdAt,
                )}
              </p>

              <p>
                Lancé :{' '}
                {formatDate(
                  r.inventory
                    .launchedAt,
                )}
              </p>

              <p>
                Finalisé :{' '}
                {formatDate(
                  r.inventory
                    .finalizedAt,
                )}
              </p>

              <p>
                Mouvements d’ajustement :{' '}
                {
                  r.adjustmentMovements
                    .length
                }
              </p>
            </div>
          </div>
        </section>
      </div>
    </main>
  );
}

function SummaryCard({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="rounded border border-[#3f3f46] bg-[#27272a] p-3">
      <p className="text-[9px] uppercase tracking-wider text-[#71717a]">
        {label}
      </p>

      <p className="mt-2 font-mono text-lg font-semibold">
        {value}
      </p>
    </div>
  );
}

function ControllerCard({
  title,
  data,
  conditional = false,
}: {
  title: string;
  data: {
    user: {
      userName:
        string | null;
      userEmail:
        string | null;
    } | null;
    completedUnits: number;
    totalUnits?: number;
    requiredUnits?: number;
    isActive?: boolean;
    isFinished: boolean;
  };
  conditional?: boolean;
}) {
  const total =
    conditional
      ? data.requiredUnits ??
        0
      : data.totalUnits ??
        0;

  return (
    <div className="rounded border border-[#3f3f46] bg-[#27272a] p-4">
      <div className="flex items-center gap-2">
        <Users className="h-4 w-4 text-[#a1a1aa]" />

        <div>
          <p className="text-xs font-semibold">
            {title}
          </p>

          <p className="mt-0.5 text-[9px] text-[#71717a]">
            {data.user
              ?.userName ??
              data.user
                ?.userEmail ??
              'Non assigné'}
          </p>
        </div>
      </div>

      <div className="mt-3 flex items-center justify-between text-xs">
        <span className="text-[#a1a1aa]">
          {conditional
            ? 'Unités requises'
            : 'Progression'}
        </span>

        <span className="font-mono font-semibold">
          {
            data.completedUnits
          }
          /
          {total}
        </span>
      </div>

      {conditional &&
        total === 0 && (
          <p className="mt-2 text-[10px] text-emerald-200">
            Aucun C3 requis pour le moment.
          </p>
        )}
    </div>
  );
}

function ResultCell({
  value,
  strong = false,
}: {
  value: string;
  strong?: boolean;
}) {
  return (
    <td
      className={`px-3 py-3 ${
        strong
          ? 'font-semibold text-white'
          : 'text-[#d4d4d8]'
      }`}
    >
      {value}
    </td>
  );
}

function ComparisonCell({
  status,
  missing,
  surplus,
}: {
  status: InventoryComparisonStatus;
  missing: number;
  surplus: number;
}) {
  return (
    <td className="px-3 py-3">
      <span
        className={`inline-flex rounded border px-2 py-1 text-[9px] font-semibold ${comparisonClass(
          status,
        )}`}
      >
        {status}
        {missing > 0
          ? ` -${missing}`
          : surplus > 0
            ? ` +${surplus}`
            : ''}
      </span>
    </td>
  );
}
