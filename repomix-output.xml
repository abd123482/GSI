// @ts-nocheck
import {
  describe,
  expect,
  it,
  vi,
} from 'vitest';

import {
  EquipmentMovementService,
} from './equipmentMovement.service.js';

const equipmentA =
  '11111111-1111-4111-8111-111111111111';

const equipmentB =
  '22222222-2222-4222-8222-222222222222';

const sourceShelfId =
  '33333333-3333-4333-8333-333333333333';

const movementId =
  '44444444-4444-4444-8444-444444444444';

function activeShelf(
  shelfId: string
) {
  return {
    shelfId,
    shelfName:
      'Source Shelf',
    stockId:
      '55555555-5555-4555-8555-555555555555',
    stock: {
      stockId:
        '55555555-5555-4555-8555-555555555555',
      stockName:
        'Stock',
      status: true,
    },
  };
}

describe(
  'EquipmentMovementService hardened transaction behavior',
  () => {
    it('runs movement creation in one Serializable transaction', async () => {
      const tx = {
        $queryRaw: vi.fn().mockImplementation(async (sqlObj) => {
      const q = JSON.stringify(sqlObj);
      if (q.includes('sp_getapplock')) return [{ result: 0 }];
      
      if (q.includes('WITH wanted AS')) {
        if (globalThis.__mockBalances) return globalThis.__mockBalances;
        const vals = sqlObj.values || [];
        const balances = [];
        for (let i = 0; i < vals.length; i += 2) {
            balances.push({ equipmentId: vals[i], shelfId: vals[i+1], quantity: 9999n });
        }
        return balances;
      }
      
      if (q.includes('UPDATE e SET equipmentQuantity')) {
        const vals = sqlObj.values || [];
        return [{ changed: vals.length / 2 }];
      }
      
      if (q.includes('UPDATE s SET shelfId = v.destination')) {
        const vals = sqlObj.values || [];
        // values has id, equipment, source, destination -> 4 per row
        return [{ changed: vals.length / 4 }];
      }
      
      return [{ changed: 1 }];
    }),

        shelf: {
          findMany: vi
            .fn()
            .mockResolvedValue([
              activeShelf(
                sourceShelfId,
              ),
            ]),

          update: vi.fn().mockResolvedValue({}),
      updateMany: vi
            .fn()
            .mockResolvedValue({
              count: 1,
            }),
        },

        equipment: {
          findMany: vi
            .fn()
            .mockResolvedValue([
              {
                equipmentId:
                  equipmentA,
                equipmentName:
                  'A',
                hasSerialNumber:
                  false,
                equipmentQuantity:
                  10,
                equipmentStatus: true,
              },
            ]),

          update: vi.fn().mockResolvedValue({}),
      updateMany: vi
            .fn()
            .mockResolvedValue({
              count: 1,
            }),
        },

        serialNumber: {
          findMany:
            vi.fn(),
          updateMany:
            vi.fn(),
        },

        equipmentShelfs: {
          update: vi.fn().mockResolvedValue({}),
      updateMany: vi
            .fn()
            .mockResolvedValue({
              count: 1,
            }),

          findMany:
            vi.fn(),
          create:
            vi.fn(),
        },

        inventoryWorkUnit: {
          findFirst: vi
            .fn()
            .mockResolvedValue(
              null,
            ),
        },

        mouvement: {
          create: vi
            .fn()
            .mockResolvedValue({
              mouvementId:
                movementId,
            }),

          findUniqueOrThrow:
            vi
              .fn()
              .mockResolvedValue({
                mouvementId:
                  movementId,
                items: [],
              }),
        },

        mouvementEquipment: {
          createMany: vi
            .fn()
            .mockResolvedValue({
              count: 1,
            }),
        },
      };

      const transaction =
        vi.fn(
          async (
            callback: (
              client:
                typeof tx,
            ) => unknown,
            _options?: unknown,
          ) =>
            callback(tx),
        );

      const prisma = {
        $transaction:
          transaction,
      };

      const service =
        new EquipmentMovementService(
          prisma as any,
        );

      await service.createMovement({
        movementType:
          'OUT',
        items: [
          {
            sourceShelfId,
            equipmentId:
              equipmentA,
            movementQuantity:
              2,
          },
        ],
      });

      expect(
        transaction,
      ).toHaveBeenCalledTimes(
        1,
      );

      expect(
        transaction.mock
          .calls[0]?.[1],
      ).toEqual({
        isolationLevel:
          'Serializable',
        timeout: 30_000,
      });

      expect(
        tx.$queryRaw,
      ).toHaveBeenCalled();

      expect(
        tx.mouvement.create,
      ).toHaveBeenCalledTimes(
        1,
      );

      expect(
        tx.mouvementEquipment
          .createMany,
      ).toHaveBeenCalledTimes(
        1,
      );
    });

    it('rolls back parent and stock mutations when a later line fails', async () => {
      const state = {
        parents: 0,
        lines: 0,

        allocations: {
          [equipmentA]: 5,
          [equipmentB]: 3,
        } as Record<
          string,
          number
        >,
      };

      const tx = {
        $queryRaw: vi.fn().mockImplementation(async (sqlObj) => {
      const q = JSON.stringify(sqlObj);
      if (q.includes('sp_getapplock')) return [{ result: 0 }];
      
      if (q.includes('WITH wanted AS')) {
        if (globalThis.__mockBalances) return globalThis.__mockBalances;
        const vals = sqlObj.values || [];
        const balances = [];
        for (let i = 0; i < vals.length; i += 2) {
            balances.push({ equipmentId: vals[i], shelfId: vals[i+1], quantity: 9999n });
        }
        return balances;
      }
      
      if (q.includes('UPDATE e SET equipmentQuantity')) {
        const vals = sqlObj.values || [];
        return [{ changed: vals.length / 2 }];
      }
      
      if (q.includes('UPDATE s SET shelfId = v.destination')) {
        const vals = sqlObj.values || [];
        // values has id, equipment, source, destination -> 4 per row
        return [{ changed: vals.length / 4 }];
      }
      
      return [{ changed: 1 }];
    }),

        shelf: {
          findMany: vi
            .fn()
            .mockResolvedValue([
              activeShelf(
                sourceShelfId,
              ),
            ]),

          update: vi.fn().mockResolvedValue({}),
      updateMany: vi
            .fn()
            .mockResolvedValue({
              count: 1,
            }),
        },

        equipment: {
          findMany: vi
            .fn()
            .mockResolvedValue([
              {
                equipmentId:
                  equipmentA,
                equipmentName:
                  'A',
                hasSerialNumber:
                  false,
                equipmentQuantity:
                  5,
                equipmentStatus: true,
              },

              {
                equipmentId:
                  equipmentB,
                equipmentName:
                  'B',
                hasSerialNumber:
                  false,
                equipmentQuantity:
                  3,
                equipmentStatus: true,
              },
            ]),

          update: vi.fn().mockResolvedValue({}),
      updateMany: vi
            .fn()
            .mockResolvedValue({
              count: 1,
            }),
        },

        serialNumber: {
          findMany:
            vi.fn(),
          updateMany:
            vi.fn(),
        },

        equipmentShelfs: {
          updateMany:
            vi.fn(
              async (
                args: any,
              ) => {
                const id =
                  args.where
                    .equipmentId as string;

                const quantity =
                  args.where
                    .equipmentQuantity
                    .gte as number;

                if (
                  (state.allocations[
                    id
                  ] ?? 0) <
                  quantity
                ) {
                  return {
                    count: 0,
                  };
                }

                state.allocations[
                  id
                ] -= quantity;

                return {
                  count: 1,
                };
              },
            ),

          findMany:
            vi.fn(),
          create:
            vi.fn(),
        },

        inventoryWorkUnit: {
          findFirst: vi
            .fn()
            .mockResolvedValue(
              null,
            ),
        },

        mouvement: {
          create: vi.fn(
            async () => {
              state.parents += 1;

              return {
                mouvementId:
                  movementId,
              };
            },
          ),

          findUniqueOrThrow:
            vi.fn(),
        },

        mouvementEquipment: {
          createMany: vi.fn(
            async (
              args: any,
            ) => {
              state.lines +=
                args.data.length;

              return {
                count:
                  args.data
                    .length,
              };
            },
          ),
        },
      };

      const transaction =
        vi.fn(
          async (
            callback: (
              client:
                typeof tx,
            ) => Promise<unknown>,
            _options?: unknown,
          ) => {
            const snapshot =
              structuredClone(
                state,
              );

            try {
              return await callback(
                tx,
              );
            } catch (error) {
              state.parents =
                snapshot.parents;

              state.lines =
                snapshot.lines;

              state.allocations =
                snapshot.allocations;

              throw error;
            }
          },
        );

      const prisma = {
        $transaction:
          transaction,
      };

      const service =
        new EquipmentMovementService(
          prisma as any,
        );

      const before =
        structuredClone(
          state,
        );

      await expect(
        service.createMovement({
          movementType:
            'OUT',
          items: [
            {
              equipmentId:
                equipmentA,
              movementQuantity:
                2,
              sourceShelfId,
            },
            {
              equipmentId:
                equipmentB,
              movementQuantity:
                4,
              sourceShelfId,
            },
          ],
        }),
      ).rejects.toThrow(
        'Insufficient equipment quantity on a source shelf',
      );

      expect(
        state,
      ).toEqual(before);

      expect(
        tx.mouvementEquipment
          .createMany,
      ).not.toHaveBeenCalled();
    });

    it('rejects movement when SQL Server application lock cannot be acquired', async () => {
      const tx = {
        $queryRaw: vi
          .fn()
          .mockResolvedValue([
            {
              lockResult:
                -1,
            },
          ]),

        shelf: {
          findMany:
            vi.fn(),
        },

        equipment: {
          findMany:
            vi.fn(),
        },
      };

      const transaction =
        vi.fn(
          async (
            callback: (
              client:
                typeof tx,
            ) => unknown,
            _options?: unknown,
          ) =>
            callback(tx),
        );

      const service =
        new EquipmentMovementService(
          {
            $transaction:
              transaction,
          } as any,
        );

      await expect(
        service.createMovement({
          movementType:
            'OUT',
          items: [
            {
              sourceShelfId,
              equipmentId:
                equipmentA,
              movementQuantity:
                1,
            },
          ],
        }),
      ).rejects.toThrow(
        'resource is busy',
      );

      expect(
        tx.shelf.findMany,
      ).not.toHaveBeenCalled();
    });
  },
);
