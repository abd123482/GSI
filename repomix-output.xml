                                  <Trash2 className="h-4 w-4" />
                                </button>
                              )}
                            </div>
                          </div>

                          <div className="p-4 space-y-3">
                            {rowsInShelf.length === 0 ? (
                              <div className="flex flex-col items-center justify-center py-4 text-center">
