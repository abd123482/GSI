                                      className="flex items-center gap-2"
                                    >
                                      <span className="w-6 text-right font-mono text-[11px] text-white/40">
                                        {idx + 1}.
                                      </span>
                                      <SerialCodeInput
                                        value={row.code}
                                        onChange={(value) =>
                                          setSerialRows((current) =>
                                            current.map((item) =>
                                              item.id === row.id
