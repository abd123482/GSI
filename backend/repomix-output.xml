    expect(result.reconciled).toEqual([
      {
        unitId,
        result:
          'THIRD_REQUIRED',
      },
    ]);

    expect(
      tx.inventoryCountAttempt.create,
    ).toHaveBeenCalledWith({
      data:
        expect.objectContaining({
          unitId,
          sequence: 2,
          purpose:
            'FINAL_RECOUNT',
          status: 'AVAILABLE',
        }),
    });

    expect(
      tx.inventoryWorkUnit.update,
    ).toHaveBeenCalledWith({
      where: { unitId },
      data:
        expect.objectContaining({
