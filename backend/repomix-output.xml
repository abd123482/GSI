async getInventoryProgress(
  inventoryId: string,
) {
  const inventory =
    await this.prisma.inventory.findUnique({
      where: { inventoryId },
      include: {
        Inventory_User: {
          include: {
            User: {
              select: {
                userId: true,
                userName: true,
                userEmail: true,
              },
            },
          },
          orderBy: {
            sequence: 'asc',
          },
        },
        workUnits: {
          include: {
            attempts: {
              include: {
                assignedUser: {
                  select: {
                    userId: true,
                    userName: true,
                  },
                },
              },
              orderBy: {
                sequence: 'asc',
              },
            },
          },
          orderBy: {
            unitOrder: 'asc',
          },
        },
      },
    });

  if (!inventory) {
    throw new NotFoundException(
      'Inventaire introuvable',
    );
  }

  const totalUnits =
    inventory.workUnits.length;

  const participants =
    inventory.Inventory_User;

  const countSubmitted =
    (purpose: AttemptPurpose) =>
      inventory.workUnits.filter(
        (unit) =>
          unit.attempts.some(
            (attempt) =>
              attempt.purpose === purpose &&
              attempt.status === 'SUBMITTED',
          ),
      ).length;

  const c1Completed =
    countSubmitted('PRIMARY_1');

  const c2Completed =
    countSubmitted('PRIMARY_2');

  const c3Required =
    inventory.workUnits.filter(
      (unit) =>
        [
          'THIRD_REQUIRED',
          'THIRD_RESOLVED',
        ].includes(
          unit.reconciliationStatus,
        ),
    ).length;

  const c3Completed =
    countSubmitted(
      'FINAL_RECOUNT',
    );

  const reconciledUnits =
    inventory.workUnits.filter(
      (unit) =>
        RECONCILED_STATUSES.includes(
          unit.reconciliationStatus as UnitReconciliationStatus,
        ),
    ).length;

  return {
    inventoryId:
      inventory.inventoryId,
    title:
      inventory.title,
    typeInventory:
      inventory.typeInventory,
    status:
      inventory.status,
    policyVersion:
      inventory.policyVersion,
    totalUnits,
    reconciledUnits,

    controllers: {
      controller1: {
        user:
          participants[0]?.User ??
          null,
        responsibility:
          'PRIMARY_COUNTER_1',
        completedUnits:
          c1Completed,
        totalUnits,
        isFinished:
          c1Completed === totalUnits &&
          totalUnits > 0,
      },

      controller2: {
        user:
          participants[1]?.User ??
          null,
        responsibility:
          'PRIMARY_COUNTER_2',
        completedUnits:
          c2Completed,
        totalUnits,
        isFinished:
          c2Completed === totalUnits &&
          totalUnits > 0,
      },

      controller3: {
        user:
          participants[2]?.User ??
          null,
        responsibility:
          'FINAL_CONTROLLER',
        requiredUnits:
          c3Required,
        completedUnits:
          c3Completed,
        isActive:
          c3Required > c3Completed,
        isFinished:
          c3Required > 0 &&
          c3Completed === c3Required,
      },
    },

    workUnits:
      inventory.workUnits.map(
        (unit) => ({
          unitId:
            unit.unitId,
          unitOrder:
            unit.unitOrder,
          equipmentId:
            unit.equipmentId,
          shelfId:
            unit.shelfId,
          status:
            unit.status,
          reconciliationStatus:
            unit.reconciliationStatus,
          acceptedAttemptId:
            unit.acceptedAttemptId,
          reconciledAt:
            unit.reconciledAt,

          c1Status:
            unit.attempts.find(
              (attempt) =>
                attempt.purpose ===
                'PRIMARY_1',
            )?.status ??
            'BLOCKED',

          c2Status:
            unit.attempts.find(
              (attempt) =>
                attempt.purpose ===
                'PRIMARY_2',
            )?.status ??
            'BLOCKED',

          c3Status:
            unit.attempts.find(
              (attempt) =>
                attempt.purpose ===
                'FINAL_RECOUNT',
            )?.status ??
            'NOT_REQUIRED',
        }),
      ),
  };
}

async getInventoryComparison(
  inventoryId: string,
) {
  const inventory =
    await this.loadInventoryForReporting(
      inventoryId,
    );

  const units =
    inventory.workUnits.map(
      (unit: any) =>
        this.buildUnitReport(unit),
    );

  return {
    inventoryId:
      inventory.inventoryId,
    title:
      inventory.title,
    status:
      inventory.status,
    typeInventory:
      inventory.typeInventory,
    units,
    summary:
      this.summarizeUnitReports(
        units,
      ),
  };
}

