private buildUnitReport(
  unit: any,
) {
  const c1 =
    unit.attempts.find(
      (attempt: any) =>
        attempt.purpose ===
        'PRIMARY_1',
    ) ?? null;

  const c2 =
    unit.attempts.find(
      (attempt: any) =>
        attempt.purpose ===
        'PRIMARY_2',
    ) ?? null;

  const c3 =
    unit.attempts.find(
      (attempt: any) =>
        attempt.purpose ===
        'FINAL_RECOUNT',
    ) ?? null;

  const accepted =
    unit.acceptedAttempt ??
    (
      unit.acceptedAttemptId
        ? unit.attempts.find(
            (attempt: any) =>
              attempt.attemptId ===
              unit.acceptedAttemptId,
          )
        : null
    );

  const c1Cells =
    this.attemptCells(
      unit,
      c1,
    );

  const c2Cells =
    this.attemptCells(
      unit,
      c2,
    );

  const c3Cells =
    this.attemptCells(
      unit,
      c3,
    );

  const finalCells =
    this.attemptCells(
      unit,
      accepted,
    );

  const keys =
    new Set([
      ...c1Cells.keys(),
      ...c2Cells.keys(),
      ...c3Cells.keys(),
      ...finalCells.keys(),
    ]);

  const rows =
    [...keys]
      .sort()
      .map((key) => {
        const first =
          c1Cells.get(key) ??
          null;

        const second =
          c2Cells.get(key) ??
          null;

        const third =
          c3Cells.get(key) ??
          null;

        const final =
          finalCells.get(key) ??
          null;

        const sample =
          final ??
          third ??
          second ??
          first;

        const kind =
          key.startsWith('SER|')
            ? 'SERIALIZED'
            : key.startsWith('STD|')
              ? 'STANDARD'
              : 'UNKNOWN';

        return {
          key,
          kind,
          equipmentId:
            sample?.equipmentId ??
            null,
          equipmentName:
            sample?.equipmentName ??
            null,
          shelfId:
            sample?.shelfId ??
            null,
          shelfName:
            sample?.shelfName ??
            null,
          serialNumberCode:
            sample?.serialNumberCode ??
            null,

          controller1:
            first,
          controller2:
            second,
          controller3:
            third,
          accepted:
            final,

          controller1VsAccepted:
            this.compareReportCells(
              kind,
              first,
              final,
            ),

          controller2VsAccepted:
            this.compareReportCells(
              kind,
              second,
              final,
            ),
        };
      });

  return {
    unitId:
      unit.unitId,
    unitOrder:
      unit.unitOrder,
    equipmentId:
      unit.equipmentId,
    shelfId:
      unit.shelfId,
    status:
      unit.status,
    reconciliationStatus:
      unit.reconciliationStatus,
    acceptedAttemptId:
      unit.acceptedAttemptId,
    acceptedPurpose:
      accepted?.purpose ??
      null,

    attempts: {
      controller1: c1
        ? {
            attemptId:
              c1.attemptId,
            user:
              c1.assignedUser ??
              null,
            submittedAt:
              c1.submittedAt,
          }
        : null,

      controller2: c2
        ? {
            attemptId:
              c2.attemptId,
            user:
              c2.assignedUser ??
              null,
            submittedAt:
              c2.submittedAt,
          }
        : null,

      controller3: c3
        ? {
            attemptId:
              c3.attemptId,
            user:
              c3.assignedUser ??
              null,
            submittedAt:
              c3.submittedAt,
          }
        : null,
    },

    rows,
  };
}

private attemptCells(
  unit: any,
  attempt: any,
) {
  const cells =
    new Map<
      string,
      ReportCell
    >();

  if (!attempt) {
    return cells;
  }

  for (
    const order of
    attempt.orders ?? []
  ) {
    const equipmentId =
      order.observedEquipmentId ??
      order.equipmentId ??
      unit.equipmentId ??
      null;

    const shelfId =
      order.observedShelfId ??
      order.shelfId ??
      unit.shelfId ??
      null;

    const serialCode =
      (
        order.scannedSerialCode ??
        order.serialNumber
          ?.serialNumberCode ??
        ''
      )
        .toString()
        .trim();

    if (serialCode) {
      const key =
        `SER|${serialCode.toLowerCase()}`;

      cells.set(
        key,
        {
          quantity: 1,
          serialNumberCode:
            serialCode,
          serialNumberId:
            order.serialNumberId ??
            null,
          equipmentId,
          equipmentName:
            order.equipment
              ?.equipmentName ??
            null,
          shelfId,
          shelfName:
            order.shelf
              ?.shelfName ??
            null,
          isUnexpected:
            Boolean(
              order.isUnexpected,
            ),
          notes:
            order.notes
              ? [order.notes]
              : [],
        },
      );

      continue;
    }

    if (
      equipmentId &&
      shelfId
    ) {
      const key =
        `STD|${equipmentId.toLowerCase()}|${shelfId.toLowerCase()}`;

      const existing =
        cells.get(key);

      cells.set(
        key,
        {
          quantity:
            (
              existing?.quantity ??
              0
            ) +
            Number(
              order.quantityCalculated ??
                0,
            ),
          serialNumberCode:
            null,
          serialNumberId:
            null,
          equipmentId,
          equipmentName:
            order.equipment
              ?.equipmentName ??
            existing
              ?.equipmentName ??
            null,
          shelfId,
          shelfName:
            order.shelf
              ?.shelfName ??
            existing
              ?.shelfName ??
            null,
          isUnexpected:
            Boolean(
              existing?.isUnexpected,
            ) ||
            Boolean(
              order.isUnexpected,
            ),
          notes: [
            ...(
              existing?.notes ??
              []
            ),
            ...(
              order.notes
                ? [order.notes]
                : []
            ),
          ],
        },
      );

      continue;
    }

    if (
      order.unknownItemEvidence
    ) {
      const value =
        String(
          order.unknownItemEvidence,
        );

      const key =
        `UNK|${value.toLowerCase()}`;

      cells.set(
        key,
        {
          quantity:
            Number(
              order.quantityCalculated ??
                1,
            ),
          serialNumberCode:
            serialCode || null,
          serialNumberId:
            order.serialNumberId ??
            null,
          equipmentId,
          equipmentName: null,
          shelfId,
          shelfName: null,
          isUnexpected: true,
          notes: [value],
        },
      );
    }
  }

  return cells;
}

private compareReportCells(
  kind: string,
  controller:
    ReportCell | null,
  accepted:
    ReportCell | null,
) {
  if (!accepted) {
    return {
      status: 'PENDING',
      delta: null,
      missing: 0,
      surplus: 0,
    };
  }

  if (kind === 'STANDARD') {
    const controllerQuantity =
      controller?.quantity ?? 0;

    const delta =
      controllerQuantity -
      accepted.quantity;

    if (delta === 0) {
      return {
        status: 'CONFORME',
        delta: 0,
        missing: 0,
        surplus: 0,
      };
    }

    if (delta < 0) {
      return {
        status: 'MANQUE',
        delta,
        missing:
          Math.abs(delta),
        surplus: 0,
      };
    }

    return {
      status: 'SURPLUS',
      delta,
      missing: 0,
      surplus: delta,
    };
  }

  if (
    kind === 'SERIALIZED'
  ) {
    if (!controller) {
      return {
        status: 'MANQUE',
        delta: -1,
        missing: 1,
        surplus: 0,
      };
    }

    if (
      (
        controller.equipmentId ??
        ''
      ).toLowerCase() !==
      (
        accepted.equipmentId ??
        ''
      ).toLowerCase()
    ) {
      return {
        status:
          'MAUVAIS_ARTICLE',
        delta: 0,
        missing: 0,
        surplus: 0,
      };
    }

    if (
      (
        controller.shelfId ??
        ''
      ).toLowerCase() !==
      (
        accepted.shelfId ??
        ''
      ).toLowerCase()
    ) {
      return {
        status:
          'MAUVAISE_POSITION',
        delta: 0,
        missing: 0,
        surplus: 0,
      };
    }

    return {
      status: 'CONFORME',
      delta: 0,
      missing: 0,
      surplus: 0,
    };
  }

  return {
    status:
      controller
        ? 'ECART'
        : 'MANQUE',
    delta: null,
    missing:
      controller
        ? 0
        : 1,
    surplus: 0,
  };
}

private summarizeUnitReports(
  units: any[],
) {
  let primaryMatchUnits =
    0;
  let thirdResolvedUnits =
    0;
  let thirdRequiredUnits =
    0;
  let compliantRows = 0;
  let controller1Missing =
    0;
  let controller1Surplus =
    0;
  let controller2Missing =
    0;
  let controller2Surplus =
    0;
  let locationMismatches =
    0;

  for (const unit of units) {
    if (
      unit.reconciliationStatus ===
      'PRIMARY_MATCH'
    ) {
      primaryMatchUnits += 1;
    }

    if (
      unit.reconciliationStatus ===
      'THIRD_RESOLVED'
    ) {
      thirdResolvedUnits += 1;
    }

    if (
      unit.reconciliationStatus ===
      'THIRD_REQUIRED'
    ) {
      thirdRequiredUnits += 1;
    }

    for (const row of unit.rows) {
      if (
        row.controller1VsAccepted
          .status ===
          'CONFORME' &&
        row.controller2VsAccepted
          .status ===
          'CONFORME'
      ) {
        compliantRows += 1;
      }

      controller1Missing +=
        row.controller1VsAccepted
          .missing ?? 0;

      controller1Surplus +=
        row.controller1VsAccepted
          .surplus ?? 0;

      controller2Missing +=
        row.controller2VsAccepted
          .missing ?? 0;

      controller2Surplus +=
        row.controller2VsAccepted
          .surplus ?? 0;

      if (
        [
          row.controller1VsAccepted
            .status,
          row.controller2VsAccepted
            .status,
        ].includes(
          'MAUVAISE_POSITION',
        )
      ) {
        locationMismatches += 1;
      }
    }
  }

  return {
    totalUnits:
      units.length,
    primaryMatchUnits,
    thirdRequiredUnits,
    thirdResolvedUnits,
    compliantRows,
    controller1: {
      missing:
        controller1Missing,
      surplus:
        controller1Surplus,
    },
    controller2: {
      missing:
        controller2Missing,
      surplus:
        controller2Surplus,
    },
    locationMismatches,
  };
}


  // --------------------------------------------------------------------------
  // Finalization + append-only adjustment movements
  // --------------------------------------------------------------------------

  async finalizeInventory(
    inventoryId: string,
    finalizerId: string,
  ) {
    const result = await this.prisma.$transaction(
      async (tx) => {
        const inventory =
          await tx.inventory.findUnique({
            where: { inventoryId },
            include: {
              workUnits: {
                include: {
                  acceptedAttempt: {
                    include: {
                      orders: {
                        include: {
                          serialNumber: true,
                          equipment: true,
                          shelf: true,
                        },
                      },
                    },
                  },
                },
                orderBy: {
                  unitOrder: 'asc',
                },
              },
            },
          });

        if (!inventory) {
          throw new NotFoundException(
            'Inventaire introuvable',
          );
        }

        if (
          inventory.status ===
          'FINALIZED'
        ) {
          throw new BadRequestException(
            'Cet inventaire est déjà finalisé.',
          );
        }

        if (
          inventory.status !==
          'COMPLETED'
        ) {
          throw new BadRequestException(
            'Toutes les unités doivent être réconciliées avant la finalisation.',
          );
        }

        const unresolved =
          inventory.workUnits.filter(
            (unit) =>
              !RECONCILED_STATUSES.includes(
                unit.reconciliationStatus as UnitReconciliationStatus,
              ) ||
              !unit.acceptedAttempt,
          );

        if (unresolved.length) {
          throw new BadRequestException(
            "Une ou plusieurs unités n'ont pas encore de tentative acceptée.",
          );
        }

        const scopeEquipmentIds =
          this.parseScopeIds(
            inventory.equipmentScopeIds,
          );

        const scopeShelfIds =
          this.parseScopeIds(
            inventory.shelfScopeIds,
          );

        await this.acquireResourceLocks(
          tx,
          scopeEquipmentIds,
          scopeShelfIds,
        );

        await this.assertNoOtherActiveInventory(
          tx,
          inventoryId,
          scopeEquipmentIds,
          scopeShelfIds,
        );

        const accepted =
          this.buildAcceptedPhysicalTruth(
            inventory.workUnits,
          );

        await tx.inventory_Equipment_Shelf_Snapshot.deleteMany({
          where: {
            inventoryId,
            phase: 'FINALIZED',
          },
        });

        await tx.inventory_SerialNumber_Snapshot.deleteMany({
          where: {
            inventoryId,
            phase: 'FINALIZED',
          },
        });

        for (
          const value of
          accepted.physical.values()
        ) {
          await tx.inventory_Equipment_Shelf_Snapshot.create({
            data: {
              inventoryId,
              equipmentId:
                value.equipmentId,
              shelfId:
                value.shelfId,
              phase: 'FINALIZED',
              quantity:
                value.quantity,
              provenance:
                'PER_UNIT_ACCEPTED_ATTEMPT',
            },
          });
        }

        for (
          const serial of
          accepted.serials.values()
        ) {
          await tx.inventory_SerialNumber_Snapshot.create({
            data: {
              inventoryId,
              equipmentId:
                serial.equipmentId,
              shelfId:
                serial.shelfId,
              serialNumberId:
                serial.serialNumberId,
              serialNumberCode:
                serial.serialCode,
              phase: 'FINALIZED',
              provenance:
                'PER_UNIT_ACCEPTED_ATTEMPT',
            },
          });
        }

        const launchPhysical =
          await tx.inventory_Equipment_Shelf_Snapshot.findMany({
            where: {
              inventoryId,
              phase:
                'LIVE_AT_LAUNCH',
            },
          });

        const launchSerials =
          await tx.inventory_SerialNumber_Snapshot.findMany({
            where: {
              inventoryId,
              phase:
                'LIVE_AT_LAUNCH',
            },
          });

        await tx.inventoryInvestigationIssue.deleteMany({
          where: { inventoryId },
        });

        await this.createVarianceIssues(
          tx,
          inventoryId,
          launchPhysical,
          launchSerials,
          accepted,
        );

        const allEquipmentIds =
          new Set<string>();

        for (
          const row of
          launchPhysical
        ) {
          allEquipmentIds.add(
            row.equipmentId,
          );
        }

        for (
          const row of
          accepted.physical.values()
        ) {
          allEquipmentIds.add(
            row.equipmentId,
          );
        }

        const equipmentRows =
          await tx.equipment.findMany({
            where: {
              equipmentId: {
                in: [
                  ...allEquipmentIds,
                ],
              },
            },
            select: {
              equipmentId: true,
              hasSerialNumber: true,
            },
          });

        const serializedByEquipment =
          new Map(
            equipmentRows.map(
              (item) => [
                item.equipmentId,
                item.hasSerialNumber,
              ],
            ),
          );

        await this.applyStandardInventoryAdjustments(
          tx,
          inventory,
          finalizerId,
          launchPhysical,
          accepted.physical,
          serializedByEquipment,
        );

        await this.applySerializedInventoryAdjustments(
          tx,
          inventory,
          finalizerId,
          launchSerials,
          accepted.serials,
        );

        const updated =
          await tx.inventory.update({
            where: { inventoryId },
            data: {
              status: 'FINALIZED',
              finalizedAt:
                new Date(),
              adjustmentApproverId:
                finalizerId ||
                null,
              adjustmentReason:
                "Ajustements d'inventaire appliqués par mouvements append-only.",
              finalResultSource:
                'PER_UNIT_ACCEPTED_ATTEMPT',
              thirdCountRequired:
                false,
            },
          });

        this.logger.log(
          `Inventory ${inventoryId} finalized with per-unit accepted attempts.`,
        );

        return updated;
      },
      {
        isolationLevel:
          'Serializable',
        timeout: 60_000,
      },
    );

    const equipmentIdsQuery = await this.prisma.inventoryWorkUnit.findMany({
      where: { inventoryId },
      select: { equipmentId: true }
    });
    const uniqueEquipmentIds = [
      ...new Set(
        equipmentIdsQuery
          .map((unit: { equipmentId: string | null }) => unit.equipmentId)
          .filter(Boolean) as string[]
      )
    ];
    await this.notificationsService.checkAndSendLowStockAlerts(uniqueEquipmentIds);

    return result;
  }

  private buildAcceptedPhysicalTruth(
    workUnits: any[],
  ) {
    const standard =
      new Map<
        string,
        CanonicalStandardValue
      >();

    const serials =
      new Map<
        string,
        CanonicalSerialValue
      >();

    const physical =
      new Map<
        string,
        CanonicalStandardValue
      >();

    for (
      const unit of workUnits
    ) {
      const attempt =
        unit.acceptedAttempt;

      if (!attempt) {
        continue;
      }

      const canonical =
        this.canonicalizeAttempt(
          unit,
          attempt,
        );

      for (
        const [
          key,
          value,
        ] of canonical.standard
      ) {
        const existing =
          standard.get(key);

        standard.set(
          key,
          {
            ...value,
            quantity:
              (
                existing?.quantity ??
                0
              ) +
              value.quantity,
          },
        );

        const physicalExisting =
          physical.get(key);

        physical.set(
          key,
          {
            ...value,
            quantity:
              (
                physicalExisting
                  ?.quantity ??
                0
              ) +
              value.quantity,
          },
        );
      }

      for (
        const [
          code,
          serial,
        ] of canonical.serials
      ) {
        const existing =
          serials.get(code);

        if (
          existing &&
          (
            existing.equipmentId.toLowerCase() !==
              serial.equipmentId.toLowerCase() ||
            (
              existing.shelfId ?? ''
            ).toLowerCase() !==
              (
                serial.shelfId ?? ''
              ).toLowerCase()
          )
        ) {
          throw new BadRequestException(
            `Le numéro de série '${serial.serialCode}' apparaît comme résultat accepté dans plusieurs positions.`,
          );
        }

        serials.set(
          code,
          serial,
        );

        if (
          serial.equipmentId &&
          serial.shelfId
        ) {
          const key =
            `${serial.equipmentId.toLowerCase()}:${serial.shelfId.toLowerCase()}`;

          const current =
            physical.get(key);

          physical.set(
            key,
            {
              equipmentId:
                serial.equipmentId,
              shelfId:
                serial.shelfId,
              quantity:
                (
                  current?.quantity ??
                  0
                ) + 1,
            },
          );
        }
      }
    }

    return {
      standard,
      serials,
      physical,
    };
  }

  private async createVarianceIssues(
    tx: Prisma.TransactionClient,
    inventoryId: string,
    launchPhysical: any[],
    launchSerials: any[],
    accepted: ReturnType<
      InventoryService['buildAcceptedPhysicalTruth']
    >,
  ) {
    const launchMap =
      new Map<
        string,
        {
          equipmentId: string;
          shelfId: string;
          quantity: number;
        }
      >();

    for (
      const row of launchPhysical
    ) {
      launchMap.set(
        `${row.equipmentId.toLowerCase()}:${row.shelfId.toLowerCase()}`,
        {
          equipmentId:
            row.equipmentId,
          shelfId:
            row.shelfId,
          quantity:
            row.quantity,
        },
      );
    }

    const quantityKeys =
      new Set([
        ...launchMap.keys(),
        ...accepted.physical.keys(),
      ]);

    for (
      const key of quantityKeys
    ) {
      const before =
        launchMap.get(key);

      const after =
        accepted.physical.get(key);

      const expected =
        before?.quantity ?? 0;

      const final =
        after?.quantity ?? 0;

      const delta =
        final - expected;

      if (delta === 0) {
        continue;
      }

      await tx.inventoryInvestigationIssue.create({
        data: {
          inventoryId,
          issueType:
            delta < 0
              ? 'QUANTITY_SHORTAGE'
              : 'QUANTITY_OVERAGE',
          status: 'OPEN',
          equipmentId:
            after?.equipmentId ??
            before?.equipmentId ??
            null,
          expectedShelfId:
            after?.shelfId ??
            before?.shelfId ??
            null,
          expectedQuantity:
            expected,
          finalQuantity:
            final,
          deltaQuantity:
            Math.abs(delta),
          movementExplanation:
            'UNEXPLAINED_VARIANCE',
        },
      });
    }

    const launchSerialMap =
      new Map<string, any>(
        launchSerials.map(
          (row) => [
            row.serialNumberCode
              .trim()
              .toLowerCase(),
            row,
          ],
        ),
      );

    const serialCodes =
      new Set([
        ...launchSerialMap.keys(),
        ...accepted.serials.keys(),
      ]);

    for (
      const code of serialCodes
    ) {
      const before =
        launchSerialMap.get(code);

      const after =
        accepted.serials.get(code);

      if (
        before &&
        !after
      ) {
        await tx.inventoryInvestigationIssue.create({
          data: {
            inventoryId,
            issueType:
              'SERIAL_MISSING',
            status: 'OPEN',
            equipmentId:
              before.equipmentId,
            serialNumberId:
              before.serialNumberId,
            serialNumberCode:
              before.serialNumberCode,
            expectedShelfId:
              before.shelfId,
            expectedQuantity: 1,
            finalQuantity: 0,
            deltaQuantity: 1,
            movementExplanation:
              'UNEXPLAINED_VARIANCE',
          },
        });

        continue;
      }

      if (
        !before &&
        after
      ) {
        await tx.inventoryInvestigationIssue.create({
          data: {
            inventoryId,
            issueType:
              after.serialNumberId
                ? 'SERIAL_UNEXPECTED'
                : 'SERIAL_UNKNOWN',
            status: 'OPEN',
            equipmentId:
              after.equipmentId ||
              null,
            serialNumberId:
              after.serialNumberId,
            serialNumberCode:
              after.serialCode,
            finalObservedShelfId:
              after.shelfId,
            expectedQuantity: 0,
            finalQuantity: 1,
            deltaQuantity: 1,
            movementExplanation:
              'UNEXPLAINED_VARIANCE',
          },
        });

        continue;
      }

      if (
        before &&
        after &&
        (
          before.equipmentId.toLowerCase() !==
            after.equipmentId.toLowerCase() ||
          (
            before.shelfId ?? ''
          ).toLowerCase() !==
            (
              after.shelfId ?? ''
            ).toLowerCase()
        )
      ) {
        await tx.inventoryInvestigationIssue.create({
          data: {
            inventoryId,
            issueType:
              before.equipmentId.toLowerCase() !==
              after.equipmentId.toLowerCase()
                ? 'SERIAL_EQUIPMENT_MISMATCH'
                : 'LOCATION_MISMATCH',
            status: 'OPEN',
            equipmentId:
              after.equipmentId ||
              before.equipmentId,
            serialNumberId:
              after.serialNumberId ??
              before.serialNumberId,
            serialNumberCode:
              after.serialCode,
            expectedShelfId:
              before.shelfId,
            finalObservedShelfId:
              after.shelfId,
            expectedQuantity: 1,
            finalQuantity: 1,
            deltaQuantity: 0,
            movementExplanation:
              'UNEXPLAINED_VARIANCE',
          },
        });
      }
    }
  }

  private async applyStandardInventoryAdjustments(
    tx: Prisma.TransactionClient,
    inventory: any,
    finalizerId: string,
    launchPhysical: any[],
    acceptedPhysical:
      Map<
        string,
        CanonicalStandardValue
      >,
    serializedByEquipment:
      Map<string, boolean>,
  ) {
    const launchMap =
      new Map<
        string,
        {
          equipmentId: string;
          shelfId: string;
          quantity: number;
        }
      >();

    for (
      const row of launchPhysical
    ) {
      if (
        serializedByEquipment.get(
          row.equipmentId,
        )
      ) {
        continue;
      }

      launchMap.set(
        `${row.equipmentId.toLowerCase()}:${row.shelfId.toLowerCase()}`,
        {
          equipmentId:
            row.equipmentId,
          shelfId:
            row.shelfId,
          quantity:
            row.quantity,
        },
      );
    }

    const acceptedStandard =
      new Map<
        string,
        CanonicalStandardValue
      >();

    for (
      const [
        key,
        value,
      ] of acceptedPhysical
    ) {
      if (
        serializedByEquipment.get(
          value.equipmentId,
        )
      ) {
        continue;
      }

      acceptedStandard.set(
        key,
        value,
      );
    }

    const keys =
      new Set([
        ...launchMap.keys(),
        ...acceptedStandard.keys(),
      ]);

    for (
      const key of keys
    ) {
      const before =
        launchMap.get(key);

      const after =
        acceptedStandard.get(key);

      const beforeQuantity =
        before?.quantity ?? 0;

      const afterQuantity =
        after?.quantity ?? 0;

      const delta =
        afterQuantity -
        beforeQuantity;

      if (delta === 0) {
        continue;
      }

      const equipmentId =
        after?.equipmentId ??
        before!.equipmentId;

      const shelfId =
        after?.shelfId ??
        before!.shelfId;

      const unitOrder =
        this.findUnitOrderForAdjustment(
          inventory,
          equipmentId,
          shelfId,
        );

      await this.appendAdjustmentMovement(
        tx,
        {
          inventoryId:
            inventory.inventoryId,
          finalizerId,
          equipmentId,
          quantity:
            Math.abs(delta),
          movementType:
            delta > 0
              ? 'IN'
              : 'OUT',
          sourceShelfId:
            delta < 0
              ? shelfId
              : null,
          destinationShelfId:
            delta > 0
              ? shelfId
              : null,
          serialNumberId: null,
          equipmentTypeSnapshot:
            'STANDARD',
          reason:
            `Ajustement inventaire - unité #${unitOrder + 1}`,
        },
      );
    }
  }

  private async applySerializedInventoryAdjustments(
    tx: Prisma.TransactionClient,
    inventory: any,
    finalizerId: string,
    launchSerials: any[],
    acceptedSerials:
      Map<
        string,
        CanonicalSerialValue
      >,
  ) {
    const launch =
      new Map<string, any>(
        launchSerials.map(
          (row) => [
            row.serialNumberCode
              .trim()
              .toLowerCase(),
            row,
          ],
        ),
      );

    const codes =
      new Set([
        ...launch.keys(),
        ...acceptedSerials.keys(),
      ]);

    for (
      const code of codes
    ) {
      const before =
        launch.get(code);

      const after =
        acceptedSerials.get(code);

      const serialNumberId =
        after?.serialNumberId ??
        before?.serialNumberId ??
        null;

      // Unknown serials remain investigation issues and are never auto-created.
      if (!serialNumberId) {
        continue;
      }

      const current =
        await tx.serialNumber.findUnique({
          where: {
            serialNumberId,
          },
          select: {
            serialNumberId: true,
            equipmentId: true,
            shelfId: true,
          },
        });

      if (!current) {
        continue;
      }

      const targetShelfId =
        after?.shelfId ??
        null;

      if (
        current.shelfId ===
        targetShelfId
      ) {
        continue;
      }

      const equipmentId =
        after?.equipmentId ??
        before?.equipmentId ??
        current.equipmentId;

      const unitOrder =
        this.findUnitOrderForAdjustment(
          inventory,
          equipmentId,
          targetShelfId ??
            current.shelfId,
        );

      if (
        current.shelfId &&
        targetShelfId
      ) {
        await this.appendAdjustmentMovement(
          tx,
          {
            inventoryId:
              inventory.inventoryId,
            finalizerId,
            equipmentId,
            quantity: 1,
            movementType:
              'TRANSFER',
            sourceShelfId:
              current.shelfId,
            destinationShelfId:
              targetShelfId,
            serialNumberId,
            equipmentTypeSnapshot:
              'SERIALIZED',
            reason:
              `Ajustement inventaire série - unité #${unitOrder + 1}`,
          },
        );

        continue;
      }

      if (
        !current.shelfId &&
        targetShelfId
      ) {
        await this.appendAdjustmentMovement(
          tx,
          {
            inventoryId:
              inventory.inventoryId,
            finalizerId,
            equipmentId,
            quantity: 1,
            movementType: 'IN',
            sourceShelfId: null,
            destinationShelfId:
              targetShelfId,
            serialNumberId,
            equipmentTypeSnapshot:
              'SERIALIZED',
            reason:
              `Ajustement inventaire série - unité #${unitOrder + 1}`,
          },
        );

        continue;
      }

      if (
        current.shelfId &&
        !targetShelfId
      ) {
        await this.appendAdjustmentMovement(
          tx,
          {
            inventoryId:
              inventory.inventoryId,
            finalizerId,
            equipmentId,
            quantity: 1,
            movementType: 'OUT',
            sourceShelfId:
              current.shelfId,
            destinationShelfId:
              null,
            serialNumberId,
            equipmentTypeSnapshot:
              'SERIALIZED',
            reason:
              `Ajustement inventaire série - unité #${unitOrder + 1}`,
          },
        );
      }
    }
  }

  private findUnitOrderForAdjustment(
    inventory: any,
    equipmentId: string,
    shelfId: string | null,
  ) {
    const unit =
      inventory.workUnits.find(
        (item: any) =>
          (
            item.equipmentId &&
            item.equipmentId.toLowerCase() ===
              equipmentId.toLowerCase()
          ) ||
          (
            shelfId &&
            item.shelfId &&
            item.shelfId.toLowerCase() ===
              shelfId.toLowerCase()
          ),
      );

    return unit?.unitOrder ?? 0;
  }

  private async appendAdjustmentMovement(
    tx: Prisma.TransactionClient,
    input: {
      inventoryId: string;
      finalizerId: string;
      equipmentId: string;
      quantity: number;
      movementType:
        | 'IN'
        | 'OUT'
        | 'TRANSFER';
      sourceShelfId:
        string | null;
      destinationShelfId:
        string | null;
      serialNumberId:
        string | null;
      equipmentTypeSnapshot:
        | 'STANDARD'
        | 'SERIALIZED';
      reason: string;
    },
  ) {
    const shelfIds = [
      input.sourceShelfId,
      input.destinationShelfId,
    ].filter(
      (
        value,
      ): value is string =>
        Boolean(value),
    );

    await this.acquireResourceLocks(
      tx,
      [input.equipmentId],
      shelfIds,
      input.serialNumberId
        ? [input.serialNumberId]
        : [],
    );

    await this.assertNoOtherActiveInventory(
      tx,
      input.inventoryId,
      [input.equipmentId],
      shelfIds,
    );

    await this.assertAdjustmentResourcesActive(
      tx,
      input.equipmentId,
      shelfIds,
    );

    const header =
      await tx.mouvement.create({
        data: {
          mouvementStatus:
            input.movementType,
          mouvementQuantity:
            input.quantity,
          sourceShelfId:
            input.sourceShelfId,
          destinationShelfId:
            input.destinationShelfId,
          equipmentId: null,
          serialNumberId: null,
          createdByUserId:
            input.finalizerId ||
            null,
          inventoryId:
            input.inventoryId,
          origin:
            'INVENTORY_ADJUSTMENT',
          reason:
            input.reason,
        },
        select: {
          mouvementId: true,
        },
      });

    if (input.sourceShelfId) {
      const allocation =
        await tx.equipmentShelfs.updateMany({
          where: {
            equipmentId:
              input.equipmentId,
            shelfId:
              input.sourceShelfId,
            equipmentQuantity: {
              gte:
                input.quantity,
            },
          },
          data: {
            equipmentQuantity: {
              decrement:
                input.quantity,
            },
          },
        });

      if (
        allocation.count !== 1
      ) {
        throw new BadRequestException(
          "La quantité source est insuffisante pour appliquer l'ajustement d'inventaire.",
        );
      }

      const sourceShelf =
        await tx.shelf.updateMany({
          where: {
            shelfId:
              input.sourceShelfId,
            shelfQuantity: {
              gte:
                input.quantity,
            },
          },
          data: {
            shelfQuantity: {
              decrement:
                input.quantity,
            },
          },
        });

      if (
        sourceShelf.count !== 1
      ) {
        throw new BadRequestException(
          "La quantité globale de l'emplacement source est incohérente.",
        );
      }
    }

    if (input.destinationShelfId) {
      const existing =
        await tx.equipmentShelfs.findUnique({
          where: {
            equipmentId_shelfId: {
              equipmentId:
                input.equipmentId,
              shelfId:
                input.destinationShelfId,
            },
          },
        });

      if (existing) {
        if (
          existing.equipmentQuantity >
          SQL_INT_MAX -
            input.quantity
        ) {
          throw new BadRequestException(
            'La quantité destination dépasse la capacité SQL Server.',
          );
        }

        await tx.equipmentShelfs.update({
          where: {
            equipmentShelfId:
              existing.equipmentShelfId,
          },
          data: {
            equipmentQuantity: {
              increment:
                input.quantity,
            },
          },
        });
      } else {
        await tx.equipmentShelfs.create({
          data: {
            equipmentId:
              input.equipmentId,
            shelfId:
              input.destinationShelfId,
            equipmentQuantity:
              input.quantity,
          },
        });
      }

      const destination =
        await tx.shelf.findUnique({
          where: {
            shelfId:
              input.destinationShelfId,
          },
          select: {
            shelfQuantity: true,
          },
        });

      if (!destination) {
        throw new NotFoundException(
          'Emplacement destination introuvable.',
        );
      }

      if (
        destination.shelfQuantity >
        SQL_INT_MAX -
          input.quantity
      ) {
        throw new BadRequestException(
          "La quantité globale de l'emplacement destination dépasse la capacité SQL Server.",
        );
      }

      await tx.shelf.update({
        where: {
          shelfId:
            input.destinationShelfId,
        },
        data: {
          shelfQuantity: {
            increment:
              input.quantity,
          },
        },
      });
    }

    if (
      input.movementType === 'IN'
    ) {
      const equipment =
        await tx.equipment.updateMany({
          where: {
            equipmentId:
              input.equipmentId,
            equipmentStatus:
              'ACTIVE',
            equipmentQuantity: {
              lte:
                SQL_INT_MAX -
                input.quantity,
            },
          },
          data: {
            equipmentQuantity: {
              increment:
                input.quantity,
            },
          },
        });

      if (
        equipment.count !== 1
      ) {
        throw new BadRequestException(
          "Impossible d'augmenter le stock article pendant l'ajustement.",
        );
      }
    }

    if (
      input.movementType === 'OUT'
    ) {
      const equipment =
        await tx.equipment.updateMany({
          where: {
            equipmentId:
              input.equipmentId,
            equipmentStatus:
              'ACTIVE',
            equipmentQuantity: {
              gte:
                input.quantity,
            },
          },
          data: {
            equipmentQuantity: {
              decrement:
                input.quantity,
            },
          },
        });

      if (
        equipment.count !== 1
      ) {
        throw new BadRequestException(
          "La quantité article globale est insuffisante pendant l'ajustement.",
        );
      }
    }

    if (input.serialNumberId) {
      const expectedShelfId =
        input.movementType === 'IN'
          ? null
          : input.sourceShelfId;

      const nextShelfId =
        input.movementType === 'OUT'
          ? null
          : input.destinationShelfId;

      const serial =
        await tx.serialNumber.updateMany({
          where: {
            serialNumberId:
              input.serialNumberId,
            equipmentId:
              input.equipmentId,
            shelfId:
              expectedShelfId,
          },
          data: {
            shelfId:
              nextShelfId,
          },
        });

      if (
        serial.count !== 1
      ) {
        throw new BadRequestException(
          "La position du numéro de série a changé. Actualisez avant de finaliser l'inventaire.",
        );
      }
    }

    await tx.mouvementEquipment.create({
      data: {
        mouvementId:
          header.mouvementId,
        rowNum: 1,
        equipmentId:
          input.equipmentId,
        equipmentTypeSnapshot:
          input.equipmentTypeSnapshot,
        serialNumberId:
          input.serialNumberId,
        mouvementQuantity:
          input.quantity,
        mouvementStatus:
          input.movementType,
        sourceShelfId:
          input.sourceShelfId,
        destinationShelfId:
          input.destinationShelfId,
      },
    });
  }

  private async assertAdjustmentResourcesActive(
    tx: Prisma.TransactionClient,
    equipmentId: string,
    shelfIds: string[],
  ) {
    const equipment =
      await tx.equipment.findUnique({
        where: { equipmentId },
        select: {
          equipmentId: true,
          equipmentStatus: true,
        },
      });

    if (!equipment) {
      throw new NotFoundException(
        'Article introuvable pendant la finalisation.',
      );
    }

    if (
      equipment.equipmentStatus !==
      'ACTIVE'
    ) {
      throw new BadRequestException(
        'Un article INACTIVE ne peut pas recevoir un mouvement d’ajustement.',
      );
    }

    if (!shelfIds.length) {
      return;
    }

    const shelves =
      await tx.shelf.findMany({
        where: {
          shelfId: {
            in: shelfIds,
          },
        },
        select: {
          shelfId: true,
          shelfName: true,
          stock: {
            select: {
              stockName: true,
              stockStatus: {
                select: {
                  stockStatusName: true,
                },
              },
            },
          },
        },
      });

    if (
      shelves.length !== shelfIds.length
    ) {
      throw new NotFoundException(
        "Un emplacement d'ajustement est introuvable.",
      );
    }

    const inactive =
      shelves.find(
        (shelf) =>
          shelf.stock
            .stockStatus
            .stockStatusName !==
          'ACTIVE',
      );

    if (inactive) {
      throw new BadRequestException(
        `L'emplacement '${inactive.shelfName ?? inactive.shelfId}' appartient à un stock INACTIVE. Aucun mouvement d'ajustement n'est autorisé.`,
      );
    }
  }

  // --------------------------------------------------------------------------
  // Report + issues
  // --------------------------------------------------------------------------

  async getInventoryReport(
    inventoryId: string,
  ) {
    const comparison =
      await this.getInventoryComparison(
        inventoryId,
      );

    const inventory =
      await this.prisma.inventory.findUnique({
        where: { inventoryId },
        include: {
          Inventory_User: {
            include: {
              User: {
                select: {
                  userId: true,
                  userName: true,
                  userEmail: true,
                },
              },
            },
            orderBy: {
              sequence: 'asc',
            },
          },
          investigationIssues: {
            include: {
              equipment: {
                select: {
                  equipmentId: true,
                  equipmentName: true,
                },
              },
              serialNumber: {
                select: {
                  serialNumberId: true,
                  serialNumberCode: true,
                },
              },
              expectedShelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                },
              },
              finalObservedShelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                },
              },
              resolutionShelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                },
              },
            },
            orderBy: {
              createdAt: 'desc',
            },
          },
          adjustmentMovements: {
            orderBy: {
              createdAt: 'asc',
            },
            include: {
              items: {
                orderBy: {
                  rowNum: 'asc',
                },
                include: {
                  equipment: true,
                  serialNumber: true,
                },
              },
              sourceShelf: true,
              destinationShelf: true,
            },
          },
        },
      });

    if (!inventory) {
      throw new NotFoundException(
        'Inventaire introuvable',
      );
    }

    const [
      launchQuantities,
      finalQuantities,
      launchSerials,
      finalSerials,
    ] = await Promise.all([
      this.prisma.inventory_Equipment_Shelf_Snapshot.findMany({
        where: {
          inventoryId,
          phase:
            'LIVE_AT_LAUNCH',
        },
      }),

      this.prisma.inventory_Equipment_Shelf_Snapshot.findMany({
        where: {
          inventoryId,
          phase: 'FINALIZED',
        },
      }),

      this.prisma.inventory_SerialNumber_Snapshot.findMany({
        where: {
          inventoryId,
          phase:
            'LIVE_AT_LAUNCH',
        },
      }),

      this.prisma.inventory_SerialNumber_Snapshot.findMany({
        where: {
          inventoryId,
          phase: 'FINALIZED',
        },
      }),
    ]);

    return {
      inventory: {
        inventoryId:
          inventory.inventoryId,
        title:
          inventory.title,
        typeInventory:
          inventory.typeInventory,
        status:
          inventory.status,
        createdAt:
          inventory.createdAt,
        launchedAt:
          inventory.launchedAt,
        finalizedAt:
          inventory.finalizedAt,
        policyVersion:
          inventory.policyVersion,
      },

      controllers:
        inventory.Inventory_User.map(
          (participant) => ({
            sequence:
              participant.sequence,
            responsibility:
              participant.responsibility,
            user:
              participant.User,
          }),
        ),

      units:
        comparison.units,

      summary:
        comparison.summary,

      baselineLaunch: {
        quantities:
          launchQuantities,
        serials:
          launchSerials,
      },

      physicalTruth: {
        quantities:
          finalQuantities,
        serials:
          finalSerials,
      },

      investigationIssues:
        inventory.investigationIssues,

      adjustmentMovements:
        inventory.adjustmentMovements,
    };
  }

  async getInventoryIssues(
    inventoryId: string,
  ) {
    return this.prisma.inventoryInvestigationIssue.findMany({
      where: { inventoryId },
      include: {
        equipment: true,
        serialNumber: true,
        expectedShelf: true,
        finalObservedShelf: true,
        resolutionShelf: true,
        resolvedByUser: {
          select: {
            userId: true,
            userName: true,
            userEmail: true,
          },
        },
      },
      orderBy: {
        createdAt: 'desc',
      },
    });
  }

  async resolveInvestigationIssue(
    inventoryId: string,
    issueId: string,
    userId: string,
    dto: ResolveIssueDTO,
  ) {
    const data =
      resolveIssueSchema.parse(dto);

    return this.prisma.$transaction(async (tx) => {
      const issue =
        await tx.inventoryInvestigationIssue.findUnique({
          where: { issueId },
        });

      if (!issue) {
        throw new NotFoundException(
          "Problème d'investigation introuvable",
        );
      }

      if (
        issue.inventoryId !== inventoryId
      ) {
        throw new BadRequestException(
          'Le problème ne correspond pas à cet inventaire.',
        );
      }

      if (
        issue.status === 'RESOLVED'
      ) {
        throw new BadRequestException(
          'Ce problème a déjà été résolu.',
        );
      }

      if (data.resolutionShelfId) {
        const shelf =
          await tx.shelf.findUnique({
            where: {
              shelfId:
                data.resolutionShelfId,
            },
            select: {
              shelfId: true,
            },
          });

        if (!shelf) {
          throw new NotFoundException(
            'Emplacement de résolution introuvable.',
          );
        }
      }

      // No direct stock mutation here. Finalization uses adjustment movements.
      return tx.inventoryInvestigationIssue.update({
        where: { issueId },
        data: {
          status: 'RESOLVED',
          resolutionType:
            data.resolutionType,
          resolutionShelfId:
            data.resolutionShelfId ??
            null,
          resolutionNotes:
            data.notes ?? null,
          resolvedByUserId:
            userId,
          resolvedAt:
            new Date(),
        },
        include: {
          equipment: true,
          serialNumber: true,
          expectedShelf: true,
          finalObservedShelf: true,
          resolutionShelf: true,
          resolvedByUser: true,
        },
      });
    });
  }

  // --------------------------------------------------------------------------
  // Delete
  // --------------------------------------------------------------------------

  async deleteInventory(
    inventoryId: string,
  ) {
    const existing =
      await this.prisma.inventory.findUnique({
        where: { inventoryId },
      });

    if (!existing) {
      throw new NotFoundException(
        'Inventaire introuvable',
      );
    }

    if (
      existing.status !== 'DRAFT'
    ) {
      throw new BadRequestException(
        "Seul un inventaire DRAFT peut être supprimé. Après lancement, l'historique doit être conservé.",
      );
    }

    return this.prisma.$transaction(async (tx) => {
      await tx.inventory_User.deleteMany({
        where: { inventoryId },
      });

      return tx.inventory.delete({
        where: { inventoryId },
      });
    });
  }

  // --------------------------------------------------------------------------
  // Legacy compatibility
  // --------------------------------------------------------------------------

  async getAdjudicationUnit(
    unitId: string,
  ) {
    const unit =
      await this.prisma.inventoryWorkUnit.findUnique({
        where: { unitId },
        include: {
          inventory: true,
          attempts: {
            include: {
              orders: {
                include: {
                  serialNumber: true,
                  equipment: true,
                  shelf: true,
                },
              },
            },
          },
        },
      });

    if (!unit) {
      throw new NotFoundException(
        'Unité introuvable',
      );
    }

    return unit;
  }

  async manualAdjudicate(
    unitId: string,
    _adjudicatorId: string,
    _data: AdjudicateDTO,
  ) {
    const unit =
      await this.prisma.inventoryWorkUnit.findUnique({
        where: { unitId },
        include: {
          inventory: true,
        },
      });

    if (!unit) {
      throw new NotFoundException(
        'Unité introuvable',
      );
    }

    if (
      (
        unit.inventory.policyVersion ??
        1
      ) >= 2
    ) {
      throw new BadRequestException(
        "L'adjudication manuelle est désactivée. Les écarts C1/C2 déclenchent automatiquement C3 uniquement pour l'unité concernée.",
      );
    }

    return {
      success: true,
      message:
        'Legacy adjudication processed',
    };
  }

  async assignThirdUser(
    inventoryId: string,
    _unitId: string,
    _thirdUserId: string,
    _currentUserId: string,
    _notes?: string,
  ) {
    const inventory =
      await this.prisma.inventory.findUnique({
        where: { inventoryId },
      });

    if (
      inventory &&
      (
        inventory.policyVersion ??
        1
      ) >= 2
    ) {
      throw new BadRequestException(
        "Le troisième contrôleur est préassigné à la création. Sa tâche est créée automatiquement uniquement pour une unité en écart.",
      );
    }

    return {
      success: true,
      message:
        'Legacy third user assigned',
    };
  }

  async assignThirdUserToAll(
    inventoryId: string,
    _thirdUserId: string,
    _currentUserId: string,
    _notes?: string,
  ) {
    const inventory =
      await this.prisma.inventory.findUnique({
        where: { inventoryId },
      });

    if (
      inventory &&
      (
        inventory.policyVersion ??
        1
      ) >= 2
    ) {
      throw new BadRequestException(
        'Le recomptage global C3 est supprimé. C3 est déclenché uniquement pour les unités en écart.',
      );
    }

    return {
      success: true,
      message:
        'Legacy third user assigned',
    };
  }

  async autoCompleteCounts(
    _inventoryId: string,
    _currentUserId: string,
  ) {
    if (
      process.env.NODE_ENV ===
      'production'
    ) {
      throw new ForbiddenException(
        'La complétion automatique de test est désactivée en production.',
      );
    }

    return {
      success: true,
      message:
        'Auto-complete bypass route',
    };
  }

  async notifyPendingControllerForUnit(
    inventoryId: string,
    unitId: string,
    _senderUserId?: string,
  ) {
    const attempt =
      await this.prisma.inventoryCountAttempt.findFirst({
        where: {
          unitId,
          unit: {
            inventoryId,
          },
          status: {
            in: [
              'AVAILABLE',
              'IN_PROGRESS',
            ],
          },
        },
        orderBy: {
          sequence: 'asc',
        },
      });

    if (!attempt) {
      throw new NotFoundException(
        'Aucune tâche en attente pour cette unité.',
      );
    }

    await this.prisma.notification.create({
      data: {
        recipientId:
          attempt.assignedUserId,
        eventType:
          'INVENTORY_TASK_REMINDER',
        payload: JSON.stringify({
          inventoryId,
          unitId,
          taskId:
            attempt.attemptId,
        }),
      },
    });

    return {
      success: true,
      message:
        'Notification envoyée',
    };
  }

  async notifyAllPendingControllers(
    inventoryId: string,
    _senderUserId?: string,
  ) {
    const attempts =
      await this.prisma.inventoryCountAttempt.findMany({
        where: {
          unit: {
            inventoryId,
          },
          status: {
            in: [
              'AVAILABLE',
              'IN_PROGRESS',
            ],
          },
        },
      });

    for (
      const attempt of attempts
    ) {
      await this.prisma.notification.create({
        data: {
          recipientId:
            attempt.assignedUserId,
          eventType:
            'INVENTORY_TASK_REMINDER',
          payload: JSON.stringify({
            inventoryId,
            taskId:
              attempt.attemptId,
          }),
        },
      });
    }

    return {
      success: true,
      count:
        attempts.length,
      message:
        'Notifications envoyées',
    };
  }
}
