<file path="src/equipment/equipment.service.ts">
import {
  BadRequestException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';

import type { Prisma } from '../generated/prisma/client.js';
import { PrismaService } from '../prisma/prisma.service.js';

import {
  type CreateEquipmentDTO,
  createEquipmentSchema,
  type UpdateEquipmentDTO,
  updateEquipmentSchema,
  type SearchEquipmentDTO,
  searchEquipmentSchema,
  type PaginationDTO,
  paginationSchema,
} from './dto/index.js';

const EQUIPMENT_LIST_SELECT = {
  equipmentId: true,
  equipmentName: true,
  hasSerialNumber: true,
  equipmentQuantity: true,
  minequipmentQuantity: true,
  equipmentStatus: true,

  equipmentShelfs: {
    where: {
      equipmentQuantity: {
        gt: 0,
      },
    },
    select: {
      equipmentShelfId: true,
      equipmentId: true,
      shelfId: true,
      equipmentQuantity: true,
      shelf: {
        select: {
          shelfId: true,
          shelfName: true,
          stockId: true,
        },
      },
    },
    orderBy: {
      equipmentQuantity:
        'desc' as const,
    },
  },

  _count: {
    select: {
      serialNumbers: true,
      equipmentShelfs: true,
    },
  },
} satisfies Prisma.EquipmentSelect;

@Injectable()
export class EquipmentService {
  constructor(
    private readonly prisma: PrismaService,
  ) {}

  private async assertEquipmentNameAvailable(
    equipmentName: string,
    excludeEquipmentId?: string,
  ): Promise<void> {
    const existing =
      await this.prisma.equipment.findFirst({
        where: {
          equipmentName,
          ...(excludeEquipmentId
            ? {
                equipmentId: {
                  not:
                    excludeEquipmentId,
                },
              }
            : {}),
        },
        select: {
          equipmentId: true,
        },
      });

    if (existing) {
      throw new BadRequestException(
        `Equipment '${equipmentName}' already exists`,
      );
    }
  }

  async createEquipment(
    dto: CreateEquipmentDTO,
  ) {
    const data =
      createEquipmentSchema.parse(dto);

    await this.assertEquipmentNameAvailable(
      data.equipmentName,
    );

    return this.prisma.equipment.create({
      data: {
        equipmentName:
          data.equipmentName,
        hasSerialNumber:
          data.hasSerialNumber,
        equipmentQuantity: 0,
        minequipmentQuantity:
          data.minEquipmentQuantity ??
          0,
        equipmentStatus:
          data.equipmentStatus ??
          'ACTIVE',
      },
      select: {
        equipmentId: true,
        equipmentName: true,
        hasSerialNumber: true,
        equipmentQuantity: true,
        minequipmentQuantity: true,
        equipmentStatus: true,
      },
    });
  }

  async getAllEquipments(
    query: PaginationDTO,
  ) {
    const {
      page,
      limit,
    } = paginationSchema.parse(
      query ?? {},
    );

    const skip =
      (page - 1) * limit;

    const [
      equipments,
      totalEquipments,
    ] = await Promise.all([
      this.prisma.equipment.findMany({
        skip,
        take: limit,
        select:
          EQUIPMENT_LIST_SELECT,
        orderBy: [
          {
            equipmentName: 'asc',
          },
          {
            equipmentId: 'asc',
          },
        ],
      }),

      this.prisma.equipment.count(),
    ]);

    return {
      equipments,
      totalEquipments,
      totalPages:
        Math.ceil(
          totalEquipments / limit,
        ) || 1,
      currentPage: page,
      limit,
    };
  }

  async searchEquipments(
    query: SearchEquipmentDTO,
    pagination: PaginationDTO,
  ) {
    const filters =
      searchEquipmentSchema.parse(
        query ?? {},
      );

    const {
      page,
      limit,
    } = paginationSchema.parse(
      pagination ?? {},
    );

    const skip =
      (page - 1) * limit;

    const where:
      Prisma.EquipmentWhereInput = {};

    if (filters.equipmentName) {
      where.equipmentName = {
        contains:
          filters.equipmentName,
      };
    }

    if (
      filters.hasSerialNumber !==
      undefined
    ) {
      where.hasSerialNumber =
        filters.hasSerialNumber;
    }

    if (filters.equipmentStatus) {
      where.equipmentStatus =
        filters.equipmentStatus;
    }

    if (
      filters.equipmentQuantity !==
      undefined
    ) {
      where.equipmentQuantity =
        filters.equipmentQuantity;
    }

    if (
      filters.minEquipmentQuantity !==
      undefined
    ) {
      where.minequipmentQuantity =
        filters.minEquipmentQuantity;
    }

    if (
      filters.shelfId ||
      filters.equipmentShelfId
    ) {
      where.equipmentShelfs = {
        some: {
          ...(filters.shelfId
            ? {
                shelfId:
                  filters.shelfId,
              }
            : {}),

          ...(filters.equipmentShelfId
            ? {
                equipmentShelfId:
                  filters.equipmentShelfId,
              }
            : {}),
        },
      };
    }

    const [
      equipments,
      totalEquipments,
    ] = await Promise.all([
      this.prisma.equipment.findMany({
        where,
        skip,
        take: limit,
        select:
          EQUIPMENT_LIST_SELECT,
        orderBy: [
          {
            equipmentName: 'asc',
          },
          {
            equipmentId: 'asc',
          },
        ],
      }),

      this.prisma.equipment.count({
        where,
      }),
    ]);

    return {
      equipments,
      totalEquipments,
      totalPages:
        Math.ceil(
          totalEquipments / limit,
        ) || 1,
      currentPage: page,
      limit,
    };
  }

  async getEquipmentById(
    id: string,
  ) {
    const equipmentId =
      id?.trim();

    if (!equipmentId) {
      throw new BadRequestException(
        'Equipment ID is required',
      );
    }

    const equipment =
      await this.prisma.equipment.findUnique({
        where: {
          equipmentId,
        },
        select:
          EQUIPMENT_LIST_SELECT,
      });

    if (!equipment) {
      throw new NotFoundException(
        `Equipment with ID '${equipmentId}' not found`,
      );
    }

    return equipment;
  }

  async updateEquipment(
    id: string,
    dto: UpdateEquipmentDTO,
  ) {
    const equipmentId =
      id?.trim();

    if (!equipmentId) {
      throw new BadRequestException(
        'Equipment ID is required',
      );
    }

    const data =
      updateEquipmentSchema.parse(dto);

    const current =
      await this.prisma.equipment.findUnique({
        where: {
          equipmentId,
        },
        select: {
          equipmentId: true,
          equipmentName: true,
          hasSerialNumber: true,
          equipmentQuantity: true,
          equipmentStatus: true,
        },
      });

    if (!current) {
      throw new NotFoundException(
        `Equipment with ID '${equipmentId}' not found`,
      );
    }

    if (
      data.equipmentName !==
        undefined &&
      data.equipmentName !==
        current.equipmentName
    ) {
      await this.assertEquipmentNameAvailable(
        data.equipmentName,
        equipmentId,
      );
    }

    if (
      current.hasSerialNumber &&
      data.hasSerialNumber === false
    ) {
      throw new BadRequestException(
        'Serialized equipment cannot be converted back to standard equipment',
      );
    }

    const convertingToSerialized =
      !current.hasSerialNumber &&
      data.hasSerialNumber === true;

    if (
      !convertingToSerialized &&
      data.conversionSerials !==
        undefined
    ) {
      throw new BadRequestException(
        'conversionSerials are only valid during Standard -> Serialized conversion',
      );
    }

    if (convertingToSerialized) {
      return this.convertStandardToSerialized(
        equipmentId,
        data,
      );
    }

    return this.prisma.equipment.update({
      where: {
        equipmentId,
      },
      data: {
        ...(data.equipmentName !==
          undefined && {
          equipmentName:
            data.equipmentName,
        }),

        ...(data.minEquipmentQuantity !==
          undefined && {
          minequipmentQuantity:
            data.minEquipmentQuantity,
        }),

        ...(data.equipmentStatus !==
          undefined && {
          equipmentStatus:
            data.equipmentStatus,
        }),
      },
      select: {
        equipmentId: true,
        equipmentName: true,
        hasSerialNumber: true,
        equipmentQuantity: true,
        minequipmentQuantity: true,
        equipmentStatus: true,
      },
    });
  }

  private async convertStandardToSerialized(
    equipmentId: string,
    data: ReturnType<
      typeof updateEquipmentSchema.parse
    >,
  ) {
    return this.prisma.$transaction(
      async (tx) => {
        const current =
          await tx.equipment.findUnique({
            where: {
              equipmentId,
            },
            select: {
              equipmentId: true,
              equipmentName: true,
              hasSerialNumber: true,
              equipmentQuantity: true,
              equipmentStatus: true,
              equipmentShelfs: {
                where: {
                  equipmentQuantity: {
                    gt: 0,
                  },
                },
                select: {
                  shelfId: true,
                  equipmentQuantity:
                    true,
                },
              },
              _count: {
                select: {
                  serialNumbers: true,
                },
              },
            },
          });

        if (!current) {
          throw new NotFoundException(
            `Equipment with ID '${equipmentId}' not found`,
          );
        }

        const resource = `SOMIPHARM:EQUIPMENT:${equipmentId.toLowerCase()}`;
        const lockQuery = await tx.$queryRaw<Array<{ lockResult: number }>>`
          DECLARE @lockResult int;
          EXEC @lockResult = sys.sp_getapplock
            @Resource = ${resource},
            @LockMode = 'Exclusive',
            @LockOwner = 'Transaction',
            @LockTimeout = 10000;
          SELECT @lockResult AS lockResult;
        `;
        const lockResult = Number(lockQuery[0]?.lockResult);
        if (!Number.isFinite(lockResult) || lockResult < 0) {
          throw new BadRequestException('Equipment is currently busy. Please try again.');
        }

        if (
          current.hasSerialNumber
        ) {
          throw new BadRequestException(
            'Equipment is already serialized',
          );
        }

        if (
          current._count.serialNumbers >
          0
        ) {
          throw new BadRequestException(
            'Standard equipment already has serial records and cannot be converted safely',
          );
        }

        const conversionSerials =
          data.conversionSerials ?? [];

        if (
          current.equipmentQuantity ===
          0
        ) {
          if (
            conversionSerials.length >
            0
          ) {
            throw new BadRequestException(
              'Equipment has no physical stock; conversion serial mappings are not required',
            );
          }

          return tx.equipment.update({
            where: {
              equipmentId,
            },
            data: {
              hasSerialNumber: true,

              ...(data.equipmentName !==
                undefined && {
                equipmentName:
                  data.equipmentName,
              }),

              ...(data.minEquipmentQuantity !==
                undefined && {
                minequipmentQuantity:
                  data.minEquipmentQuantity,
              }),

              ...(data.equipmentStatus !==
                undefined && {
                equipmentStatus:
                  data.equipmentStatus,
              }),
            },
            select: {
              equipmentId: true,
              equipmentName: true,
              hasSerialNumber: true,
              equipmentQuantity: true,
              minequipmentQuantity: true,
              equipmentStatus: true,
            },
          });
        }

        const allocatedTotal =
          current.equipmentShelfs.reduce(
            (
              sum,
              allocation,
            ) =>
              sum +
              allocation.equipmentQuantity,
            0,
          );

        if (
          allocatedTotal !==
          current.equipmentQuantity
        ) {
          throw new BadRequestException(
            'Equipment physical quantity and shelf allocations are inconsistent; conversion is blocked',
          );
        }

        if (
          conversionSerials.length !==
          current.equipmentQuantity
        ) {
          throw new BadRequestException(
            `Conversion requires exactly ${current.equipmentQuantity} serial codes mapped to the current shelves`,
          );
        }

        const normalized =
          conversionSerials.map(
            (item) => ({
              serialNumberCode:
                item.serialNumberCode.trim(),
              shelfId:
                item.shelfId,
            }),
          );

        const codes =
          normalized.map(
            (item) =>
              item.serialNumberCode,
          );

        if (
          new Set(codes).size !==
          codes.length
        ) {
          throw new BadRequestException(
            'Duplicate serial number codes exist in the conversion request',
          );
        }

        const allocationByShelf =
          new Map(
            current.equipmentShelfs.map(
              (allocation) => [
                allocation.shelfId,
                allocation.equipmentQuantity,
              ],
            ),
          );

        const conversionCountByShelf =
          new Map<string, number>();

        for (
          const item of normalized
        ) {
          if (
            !allocationByShelf.has(
              item.shelfId,
            )
          ) {
            throw new BadRequestException(
              `Shelf '${item.shelfId}' does not contain this equipment`,
            );
          }

          conversionCountByShelf.set(
            item.shelfId,
            (conversionCountByShelf.get(
              item.shelfId,
            ) ?? 0) + 1,
          );
        }

        for (
          const [
            shelfId,
            quantity,
          ] of allocationByShelf
        ) {
          if (
            (conversionCountByShelf.get(
              shelfId,
            ) ?? 0) !== quantity
          ) {
            throw new BadRequestException(
              `Serial mapping count does not match physical quantity on shelf '${shelfId}'`,
            );
          }
        }

        const existingCodes =
          await tx.serialNumber.findMany({
            where: {
              serialNumberCode: {
                in: codes,
              },
            },
            select: {
              serialNumberCode: true,
            },
          });

        if (
          existingCodes.length > 0
        ) {
          throw new BadRequestException(
            `Serial number(s) already exist: ${existingCodes
              .map(
                (item) =>
                  item.serialNumberCode,
              )
              .join(', ')}`,
          );
        }

        await tx.serialNumber.createMany({
          data: normalized.map(
            (item) => ({
              serialNumberCode:
                item.serialNumberCode,
              serialNumberStatus:
                'AVAILABLE',
              equipmentId,
              shelfId:
                item.shelfId,
            }),
          ),
        });

        return tx.equipment.update({
          where: {
            equipmentId,
          },
          data: {
            hasSerialNumber: true,

            ...(data.equipmentName !==
              undefined && {
              equipmentName:
                data.equipmentName,
            }),

            ...(data.minEquipmentQuantity !==
              undefined && {
              minequipmentQuantity:
                data.minEquipmentQuantity,
            }),

            ...(data.equipmentStatus !==
              undefined && {
              equipmentStatus:
                data.equipmentStatus,
            }),
          },
          select: {
            equipmentId: true,
            equipmentName: true,
            hasSerialNumber: true,
            equipmentQuantity: true,
            minequipmentQuantity: true,
            equipmentStatus: true,
          },
        });
      },
      {
        isolationLevel:
          'Serializable',
        timeout: 30_000,
      },
    );
  }

  async deleteEquipment(
    id: string,
  ) {
    const equipmentId =
      id?.trim();

    if (!equipmentId) {
      throw new BadRequestException(
        'Equipment ID is required',
      );
    }

    const equipment =
      await this.prisma.equipment.findUnique({
        where: {
          equipmentId,
        },
        select: {
          equipmentId: true,
          equipmentName: true,
        },
      });

    if (!equipment) {
      throw new NotFoundException(
        `Equipment with ID '${equipmentId}' not found`,
      );
    }

    const [
      movementLine,
      legacyMovementHeader,
      serialNumber,
      positiveAllocation,
    ] = await Promise.all([
      this.prisma.mouvementEquipment.findFirst({
        where: {
          equipmentId,
        },
        select: {
          mouvementEquipmentId:
            true,
        },
      }),

      this.prisma.mouvement.findFirst({
        where: {
          equipmentId,
        },
        select: {
          mouvementId: true,
        },
      }),

      this.prisma.serialNumber.findFirst({
        where: {
          equipmentId,
        },
        select: {
          serialNumberId: true,
        },
      }),

      this.prisma.equipmentShelfs.findFirst({
        where: {
          equipmentId,
          equipmentQuantity: {
            gt: 0,
          },
        },
        select: {
          equipmentShelfId: true,
        },
      }),
    ]);

    if (
      movementLine ||
      legacyMovementHeader
    ) {
      throw new BadRequestException(
        'This equipment has movement history and cannot be physically deleted',
      );
    }

    if (serialNumber) {
      throw new BadRequestException(
        'Delete or retire the equipment serial numbers before deleting the equipment',
      );
    }

    if (positiveAllocation) {
      throw new BadRequestException(
        'This equipment still has stock allocated to a shelf',
      );
    }

    return this.prisma.$transaction(
      async (tx) => {
        await tx.equipmentShelfs.deleteMany({
          where: {
            equipmentId,
          },
        });

        return tx.equipment.delete({
          where: {
            equipmentId,
          },
          select: {
            equipmentId: true,
            equipmentName: true,
            hasSerialNumber: true,
            equipmentQuantity: true,
            minequipmentQuantity: true,
            equipmentStatus: true,
          },
        });
      },
    );
  }

  async getEquipmentShelves(
    equipmentId: string,
  ) {
    const id =
      equipmentId?.trim();

    if (!id) {
      throw new BadRequestException(
        'Equipment ID is required',
      );
    }

    const equipment =
      await this.prisma.equipment.findUnique({
        where: {
          equipmentId: id,
        },
        select: {
          equipmentId: true,
          equipmentName: true,
          hasSerialNumber: true,
          equipmentQuantity: true,
          equipmentStatus: true,

          equipmentShelfs: {
            where: {
              equipmentQuantity: {
                gt: 0,
              },
            },
            select: {
              equipmentShelfId: true,
              shelfId: true,
              equipmentQuantity: true,
              shelf: {
                select: {
                  shelfId: true,
                  shelfName: true,
                  stockId: true,
                },
              },
            },
            orderBy: {
              equipmentQuantity:
                'desc',
            },
          },
        },
      });

    if (!equipment) {
      throw new NotFoundException(
        `Equipment with ID '${id}' not found`,
      );
    }

    const totalAllocated =
      equipment.equipmentShelfs.reduce(
        (
          sum,
          allocation,
        ) =>
          sum +
          allocation.equipmentQuantity,
        0,
      );

    return {
      ...equipment,
      totalAllocated,
      unallocatedQuantity:
        Math.max(
          0,
          equipment.equipmentQuantity -
            totalAllocated,
        ),
      shelvesCount:
        equipment.equipmentShelfs
          .length,
    };
  }

  async getSerialNumbersByEquipmentId(
    equipmentId: string,
    pagination: PaginationDTO,
  ) {
    const id =
      equipmentId?.trim();

    if (!id) {
      throw new BadRequestException(
        'Equipment ID is required',
      );
    }

    const {
      page,
      limit,
    } = paginationSchema.parse(
      pagination ?? {},
    );

    const equipment =
      await this.prisma.equipment.findUnique({
        where: {
          equipmentId: id,
        },
        select: {
          equipmentId: true,
          hasSerialNumber: true,
        },
      });

    if (!equipment) {
      throw new NotFoundException(
        `Equipment with ID '${id}' not found`,
      );
    }

    if (
      !equipment.hasSerialNumber
    ) {
      return {
        serialNumbers: [],
        totalSerialNumbers: 0,
        totalPages: 1,
        currentPage: page,
        limit,
      };
    }

    const skip =
      (page - 1) * limit;

    const [
      serialNumbers,
      totalSerialNumbers,
    ] = await Promise.all([
      this.prisma.serialNumber.findMany({
        where: {
          equipmentId: id,
        },
        skip,
        take: limit,
        select: {
          serialNumberId: true,
          serialNumberCode: true,
          serialNumberStatus: true,
          equipmentId: true,
          shelfId: true,
          shelf: {
            select: {
              shelfId: true,
              shelfName: true,
              stockId: true,
            },
          },
        },
        orderBy: [
          {
            serialNumberCode: 'asc',
          },
          {
            serialNumberId: 'asc',
          },
        ],
      }),

      this.prisma.serialNumber.count({
        where: {
          equipmentId: id,
        },
      }),
    ]);

    return {
      serialNumbers,
      totalSerialNumbers,
      totalPages:
        Math.ceil(
          totalSerialNumbers / limit,
        ) || 1,
      currentPage: page,
      limit,
    };
  }
}
</file>

<file path="src/equipment/equipmentAssignment.spec.ts">
import {
  beforeEach,
  describe,
  expect,
  it,
  vi,
} from 'vitest';

import { EquipmentService } from './equipment.service.js';
import { SerialNumberService } from '../serial-numbers/serialNumber.service.js';

describe('Equipment + SerialNumber V3', () => {
  let prisma: any;
  let equipmentService: EquipmentService;
  let serialNumberService: SerialNumberService;

  const equipmentId =
    '11111111-1111-4111-8111-111111111111';

  const serialId =
    '22222222-2222-4222-8222-222222222222';

  const shelfId =
    '33333333-3333-4333-8333-333333333333';

  beforeEach(() => {
    const tx = {
      equipment: {
        findUnique: vi.fn(),
        update: vi.fn(),
        delete: vi.fn(),
      },

      serialNumber: {
        findMany: vi.fn().mockResolvedValue([]),
        createMany: vi.fn().mockResolvedValue({
          count: 2,
        }),
      },

      equipmentShelfs: {
        deleteMany: vi.fn(),
      },
      $queryRaw: vi.fn().mockResolvedValue([{ lockResult: 0 }]),
    };

    prisma = {
      equipment: {
        findFirst: vi.fn().mockResolvedValue(null),

        findUnique: vi.fn().mockResolvedValue({
          equipmentId,
          equipmentName: 'Equipment',
          hasSerialNumber: false,
          equipmentQuantity: 0,
          minequipmentQuantity: 2,
          equipmentStatus: 'ACTIVE',
        }),

        create: vi.fn().mockResolvedValue({
          equipmentId,
          equipmentName: 'Equipment',
          hasSerialNumber: false,
          equipmentQuantity: 0,
          minequipmentQuantity: 2,
          equipmentStatus: 'ACTIVE',
        }),

        update: vi.fn(),
      },

      serialNumber: {
        findUnique: vi.fn().mockResolvedValue(null),
        findMany: vi.fn().mockResolvedValue([]),
        findFirst: vi.fn().mockResolvedValue(null),

        create: vi.fn().mockResolvedValue({
          serialNumberId: serialId,
          serialNumberCode: 'SN-1',
          serialNumberStatus: 'AVAILABLE',
          equipmentId,
          shelfId: null,
          equipment: {
            equipmentId,
            equipmentName: 'Serialized',
            hasSerialNumber: true,
            equipmentStatus: 'ACTIVE',
          },
          shelf: null,
        }),

        createMany: vi.fn().mockResolvedValue({
          count: 3,
        }),
      },

      mouvementEquipment: {
        findFirst: vi.fn().mockResolvedValue(null),
      },

      mouvement: {
        findFirst: vi.fn().mockResolvedValue(null),
      },

      equipmentShelfs: {
        findFirst: vi.fn().mockResolvedValue(null),
      },

      $transaction: vi.fn(
        async (
          callback: (client: typeof tx) => unknown,
          _options?: unknown,
        ) => callback(tx),
      ),

      _tx: tx,
    };

    equipmentService =
      new EquipmentService(prisma as any);

    serialNumberService =
      new SerialNumberService(prisma as any);
  });

  it('creates equipment as metadata only with quantity zero and ACTIVE status', async () => {
    await equipmentService.createEquipment({
      equipmentName: 'Equipment',
      hasSerialNumber: false,
      minEquipmentQuantity: 2,
    });

    expect(prisma.equipment.create).toHaveBeenCalledWith(
      expect.objectContaining({
        data: {
          equipmentName: 'Equipment',
          hasSerialNumber: false,
          equipmentQuantity: 0,
          minequipmentQuantity: 2,
          equipmentStatus: 'ACTIVE',
        },
      }),
    );
  });

  it('creates batch serial identities with shelfId null without changing physical quantity', async () => {
    prisma.equipment.findUnique.mockResolvedValue({
      equipmentId,
      equipmentName: 'Serialized',
      hasSerialNumber: true,
      equipmentStatus: 'ACTIVE',
    });

    const result =
      await serialNumberService.createBatchSerialNumbers({
        equipmentId,
        serialNumberCodes: ['SN-A', 'SN-B', 'SN-C'],
      });

    expect(result).toEqual({
      success: true,
      count: 3,
      equipmentId,
    });

    expect(
      prisma.serialNumber.createMany,
    ).toHaveBeenCalledWith({
      data: [
        {
          serialNumberCode: 'SN-A',
          serialNumberStatus: 'AVAILABLE',
          equipmentId,
          shelfId: null,
        },
        {
          serialNumberCode: 'SN-B',
          serialNumberStatus: 'AVAILABLE',
          equipmentId,
          shelfId: null,
        },
        {
          serialNumberCode: 'SN-C',
          serialNumberStatus: 'AVAILABLE',
          equipmentId,
          shelfId: null,
        },
      ],
    });

    expect(prisma.equipment.update).not.toHaveBeenCalled();
  });

  it('creates a single serial identity with shelfId null without changing physical quantity', async () => {
    prisma.equipment.findUnique.mockResolvedValue({
      equipmentId,
      equipmentName: 'Serialized',
      hasSerialNumber: true,
      equipmentStatus: 'ACTIVE',
    });

    prisma.serialNumber.findUnique.mockResolvedValue(null);

    await serialNumberService.createSerialNumber({
      equipmentId,
      serialNumberCode: 'SN-1',
    });

    expect(
      prisma.serialNumber.create,
    ).toHaveBeenCalledWith(
      expect.objectContaining({
        data: {
          serialNumberCode: 'SN-1',
          serialNumberStatus: 'AVAILABLE',
          equipmentId,
          shelfId: null,
        },
      }),
    );

    expect(prisma.equipment.update).not.toHaveBeenCalled();
  });

  it('does not allow EquipmentService to edit stock quantity directly', async () => {
    await expect(
      equipmentService.updateEquipment(
        equipmentId,
        {
          equipmentQuantity: 50,
        } as any,
      ),
    ).rejects.toThrow();

    expect(prisma.equipment.update).not.toHaveBeenCalled();
  });

  it('allows Standard -> Serialized conversion when physical quantity is zero', async () => {
    prisma.equipment.findUnique.mockResolvedValue({
      equipmentId,
      equipmentName: 'Equipment',
      hasSerialNumber: false,
      equipmentQuantity: 0,
      equipmentStatus: 'ACTIVE',
    });

    prisma._tx.equipment.findUnique.mockResolvedValue({
      equipmentId,
      equipmentName: 'Equipment',
      hasSerialNumber: false,
      equipmentQuantity: 0,
      equipmentStatus: 'ACTIVE',
      equipmentShelfs: [],
      _count: {
        serialNumbers: 0,
      },
    });

    prisma._tx.equipment.update.mockResolvedValue({
      equipmentId,
      equipmentName: 'Equipment',
      hasSerialNumber: true,
      equipmentQuantity: 0,
      minequipmentQuantity: 2,
      equipmentStatus: 'ACTIVE',
    });

    const result =
      await equipmentService.updateEquipment(
        equipmentId,
        {
          hasSerialNumber: true,
        },
      );

    expect(result.hasSerialNumber).toBe(true);

    expect(
      prisma._tx.equipment.update,
    ).toHaveBeenCalledWith(
      expect.objectContaining({
        where: {
          equipmentId,
        },
        data: expect.objectContaining({
          hasSerialNumber: true,
        }),
      }),
    );
  });

  it('blocks Serialized -> Standard conversion', async () => {
    prisma.equipment.findUnique.mockResolvedValue({
      equipmentId,
      equipmentName: 'Serialized',
      hasSerialNumber: true,
      equipmentQuantity: 0,
      equipmentStatus: 'ACTIVE',
    });

    await expect(
      equipmentService.updateEquipment(
        equipmentId,
        {
          hasSerialNumber: false,
        },
      ),
    ).rejects.toThrow(
      'cannot be converted back',
    );
  });

  it('blocks equipment deletion when movement history exists', async () => {
    prisma.equipment.findUnique.mockResolvedValue({
      equipmentId,
      equipmentName: 'Equipment',
    });

    prisma.mouvementEquipment.findFirst.mockResolvedValue({
      mouvementEquipmentId: 'history',
    });

    await expect(
      equipmentService.deleteEquipment(equipmentId),
    ).rejects.toThrow('movement history');

    expect(prisma.$transaction).not.toHaveBeenCalled();
  });
});
