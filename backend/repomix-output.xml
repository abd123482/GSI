<file path="sql/final_hardening_readonly_audit.sql">
/*
    SOMIPHARM FINAL HARDENING AUDIT
    READ ONLY.

    This script intentionally contains no INSERT / UPDATE / DELETE /
    ALTER / CREATE / DROP statements.
*/

SET NOCOUNT ON;

PRINT '1. CONNECTION';
SELECT
    @@SERVERNAME AS CurrentServer,
    DB_NAME() AS CurrentDatabase,
    SUSER_SNAME() AS LoginName;

PRINT '2. EXPECTED HARDENING TRIGGERS';
WITH ExpectedTrigger(TriggerName) AS (
    SELECT *
    FROM (VALUES
        ('TR_Shelf_RequireActiveStock'),
        ('TR_EquipmentShelfs_RequireActiveStock'),
        ('TR_Mouvement_RequireActiveStocks'),
        ('TR_SerialNumber_Guards'),
        ('TR_InventoryWorkUnit_AcceptedAttempt'),
        ('TR_MovementEquipment_MatchHeader')
    ) v(TriggerName)
)
SELECT
    e.TriggerName,
    CASE
        WHEN tr.object_id IS NULL THEN 'MISSING'
        WHEN tr.is_disabled = 1 THEN 'DISABLED'
        ELSE 'ENABLED'
    END AS TriggerState
FROM ExpectedTrigger e
LEFT JOIN sys.triggers tr
    ON tr.name = e.TriggerName
ORDER BY e.TriggerName;

PRINT '3. DISABLED / UNTRUSTED FOREIGN KEYS';
SELECT
    OBJECT_NAME(parent_object_id) AS TableName,
    name AS ForeignKeyName,
    OBJECT_NAME(referenced_object_id) AS ReferencedTable,
    is_disabled AS IsDisabled,
    is_not_trusted AS IsNotTrusted
FROM sys.foreign_keys
WHERE
    (is_disabled = 1 OR is_not_trusted = 1)
    AND OBJECT_NAME(parent_object_id) IN (
        'Stock',
        'Shelf',
        'Equipment',
        'EquipmentShelfs',
        'SerialNumber',
        'Mouvement',
        'MovementEquipment',
        'Inventory',
        'InventoryWorkUnit',
        'InventoryCountAttempt',
        'Order'
    )
ORDER BY TableName, ForeignKeyName;

PRINT '4. DISABLED / UNTRUSTED CHECK CONSTRAINTS';
SELECT
    OBJECT_NAME(parent_object_id) AS TableName,
    name AS ConstraintName,
    definition,
    is_disabled AS IsDisabled,
    is_not_trusted AS IsNotTrusted
FROM sys.check_constraints
WHERE
    (is_disabled = 1 OR is_not_trusted = 1)
    AND OBJECT_NAME(parent_object_id) IN (
        'Stock',
        'StockStatus',
        'Shelf',
        'Equipment',
        'EquipmentShelfs',
        'SerialNumber',
        'Mouvement',
        'MovementEquipment',
        'Inventory',
        'InventoryWorkUnit',
        'InventoryCountAttempt'
    )
ORDER BY TableName, ConstraintName;

PRINT '5. STOCK STATUS DOMAIN';
IF OBJECT_ID(N'dbo.StockStatus', N'U') IS NOT NULL
BEGIN
    SELECT
        stockStatusId,
        stockStatusName
    FROM dbo.StockStatus
    ORDER BY stockStatusName;
END;

PRINT '6. NEGATIVE QUANTITIES';
IF COL_LENGTH('dbo.Equipment', 'equipmentQuantity') IS NOT NULL
BEGIN
    SELECT TOP (100)
        'Equipment' AS SourceTable,
        equipmentId AS EntityId,
        equipmentQuantity AS BadQuantity
    FROM dbo.Equipment
    WHERE equipmentQuantity < 0;
END;

IF COL_LENGTH('dbo.Shelf', 'shelfQuantity') IS NOT NULL
BEGIN
    SELECT TOP (100)
        'Shelf' AS SourceTable,
        shelfId AS EntityId,
        shelfQuantity AS BadQuantity
    FROM dbo.Shelf
    WHERE shelfQuantity < 0;
END;

IF COL_LENGTH('dbo.EquipmentShelfs', 'equipmentQuantity') IS NOT NULL
BEGIN
    SELECT TOP (100)
        'EquipmentShelfs' AS SourceTable,
        equipmentShelfId AS EntityId,
        equipmentQuantity AS BadQuantity
    FROM dbo.EquipmentShelfs
    WHERE equipmentQuantity < 0;
END;

PRINT '7. DUPLICATE EQUIPMENT/SHELF ALLOCATIONS';
IF
    COL_LENGTH('dbo.EquipmentShelfs', 'equipmentId') IS NOT NULL
    AND COL_LENGTH('dbo.EquipmentShelfs', 'shelfId') IS NOT NULL
BEGIN
    SELECT TOP (100)
        equipmentId,
        shelfId,
        COUNT_BIG(*) AS DuplicateRows
    FROM dbo.EquipmentShelfs
    GROUP BY equipmentId, shelfId
    HAVING COUNT_BIG(*) > 1
    ORDER BY DuplicateRows DESC;
END;

PRINT '8. STANDARD GLOBAL QUANTITY VS ALLOCATIONS';
IF
    COL_LENGTH('dbo.Equipment', 'hasSerialNumber') IS NOT NULL
    AND COL_LENGTH('dbo.Equipment', 'equipmentQuantity') IS NOT NULL
    AND COL_LENGTH('dbo.EquipmentShelfs', 'equipmentQuantity') IS NOT NULL
BEGIN
    SELECT TOP (100)
        e.equipmentId,
        e.equipmentName,
        e.equipmentQuantity AS GlobalQuantity,
        COALESCE(a.AllocatedQuantity, 0) AS AllocatedQuantity
    FROM dbo.Equipment e
    OUTER APPLY (
        SELECT
            SUM(es.equipmentQuantity) AS AllocatedQuantity
        FROM dbo.EquipmentShelfs es
        WHERE es.equipmentId = e.equipmentId
    ) a
    WHERE
        e.hasSerialNumber = 0
        AND COALESCE(e.equipmentQuantity, 0) <>
            COALESCE(a.AllocatedQuantity, 0)
    ORDER BY e.equipmentName;
END;

PRINT '9. SERIALIZED GLOBAL QUANTITY VS PHYSICAL SERIALS';
IF
    COL_LENGTH('dbo.Equipment', 'hasSerialNumber') IS NOT NULL
    AND COL_LENGTH('dbo.Equipment', 'equipmentQuantity') IS NOT NULL
    AND COL_LENGTH('dbo.SerialNumber', 'shelfId') IS NOT NULL
BEGIN
    SELECT TOP (100)
        e.equipmentId,
        e.equipmentName,
        e.equipmentQuantity AS GlobalQuantity,
        COALESCE(s.PhysicalSerials, 0) AS PhysicalSerials
    FROM dbo.Equipment e
    OUTER APPLY (
        SELECT COUNT_BIG(*) AS PhysicalSerials
        FROM dbo.SerialNumber sn
        WHERE
            sn.equipmentId = e.equipmentId
            AND sn.shelfId IS NOT NULL
    ) s
    WHERE
        e.hasSerialNumber = 1
        AND COALESCE(e.equipmentQuantity, 0) <>
            COALESCE(s.PhysicalSerials, 0)
    ORDER BY e.equipmentName;
END;

PRINT '10. SHELF TOTAL VS ALLOCATIONS';
IF
    COL_LENGTH('dbo.Shelf', 'shelfQuantity') IS NOT NULL
    AND COL_LENGTH('dbo.EquipmentShelfs', 'equipmentQuantity') IS NOT NULL
BEGIN
    SELECT TOP (100)
        s.shelfId,
        s.shelfName,
        s.shelfQuantity AS ShelfQuantity,
        COALESCE(a.AllocatedQuantity, 0) AS AllocatedQuantity
    FROM dbo.Shelf s
    OUTER APPLY (
        SELECT
            SUM(es.equipmentQuantity) AS AllocatedQuantity
        FROM dbo.EquipmentShelfs es
        WHERE es.shelfId = s.shelfId
    ) a
    WHERE
        COALESCE(s.shelfQuantity, 0) <>
        COALESCE(a.AllocatedQuantity, 0)
    ORDER BY s.shelfName;
END;

PRINT '11. INVENTORY ACCEPTED ATTEMPT MUST BELONG TO SAME UNIT';
IF
    COL_LENGTH('dbo.InventoryWorkUnit', 'acceptedAttemptId') IS NOT NULL
    AND OBJECT_ID(N'dbo.InventoryCountAttempt', N'U') IS NOT NULL
BEGIN
    SELECT TOP (100)
        u.unitId,
        u.reconciliationStatus,
        u.acceptedAttemptId,
        a.unitId AS AcceptedAttemptUnitId,
        a.purpose,
        a.status
    FROM dbo.InventoryWorkUnit u
    JOIN dbo.InventoryCountAttempt a
        ON a.attemptId = u.acceptedAttemptId
    WHERE a.unitId <> u.unitId;
END;

PRINT '12. PRIMARY_MATCH ACCEPTED ATTEMPT';
IF
    COL_LENGTH('dbo.InventoryWorkUnit', 'reconciliationStatus') IS NOT NULL
    AND COL_LENGTH('dbo.InventoryWorkUnit', 'acceptedAttemptId') IS NOT NULL
BEGIN
    SELECT TOP (100)
        u.unitId,
        u.reconciliationStatus,
        u.acceptedAttemptId,
        a.purpose,
        a.status
    FROM dbo.InventoryWorkUnit u
    LEFT JOIN dbo.InventoryCountAttempt a
        ON a.attemptId = u.acceptedAttemptId
    WHERE
        u.reconciliationStatus = 'PRIMARY_MATCH'
        AND (
            u.acceptedAttemptId IS NULL
            OR a.purpose <> 'PRIMARY_1'
            OR a.status <> 'SUBMITTED'
        );
END;

PRINT '13. THIRD_REQUIRED MUST NOT HAVE ACCEPTED RESULT YET';
IF
    COL_LENGTH('dbo.InventoryWorkUnit', 'reconciliationStatus') IS NOT NULL
    AND COL_LENGTH('dbo.InventoryWorkUnit', 'acceptedAttemptId') IS NOT NULL
BEGIN
    SELECT TOP (100)
        unitId,
        reconciliationStatus,
        acceptedAttemptId
    FROM dbo.InventoryWorkUnit
    WHERE
        reconciliationStatus = 'THIRD_REQUIRED'
        AND acceptedAttemptId IS NOT NULL;
END;

PRINT '14. THIRD_RESOLVED ACCEPTED ATTEMPT';
IF
    COL_LENGTH('dbo.InventoryWorkUnit', 'reconciliationStatus') IS NOT NULL
    AND COL_LENGTH('dbo.InventoryWorkUnit', 'acceptedAttemptId') IS NOT NULL
BEGIN
    SELECT TOP (100)
        u.unitId,
        u.reconciliationStatus,
        u.acceptedAttemptId,
        a.purpose,
        a.status
    FROM dbo.InventoryWorkUnit u
    LEFT JOIN dbo.InventoryCountAttempt a
        ON a.attemptId = u.acceptedAttemptId
    WHERE
        u.reconciliationStatus = 'THIRD_RESOLVED'
        AND (
            u.acceptedAttemptId IS NULL
            OR a.purpose <> 'FINAL_RECOUNT'
            OR a.status <> 'SUBMITTED'
        );
END;

PRINT 'AUDIT COMPLETE - NOTHING WAS MODIFIED';
</file>

<file path="sql/final_live_db_audit.sql">
/*
  SOMIPHARM FINAL LIVE DATABASE AUDIT
  ----------------------------------
  READ-ONLY.
  This file performs SELECT-only inspection.

  IMPORTANT:
  - Run this only after selecting the SQL Server/database you believe the app uses.
  - Do NOT run prisma db push / migrate reset / migrate dev / migrate deploy
    as part of this audit.
*/

SET NOCOUNT ON;

PRINT '============================================================';
PRINT '1. SERVER / DATABASE';
PRINT '============================================================';

SELECT
    @@SERVERNAME AS CurrentServer,
    DB_NAME() AS CurrentDatabase,
    SUSER_SNAME() AS LoginName;

PRINT '============================================================';
PRINT '2. EXPECTED APPLICATION TABLES';
PRINT '============================================================';

WITH ExpectedTables(TableName) AS (
    SELECT *
    FROM (VALUES
        ('Stock'),
        ('StockStatus'),
        ('Shelf'),
        ('Equipment'),
        ('EquipmentShelfs'),
        ('SerialNumber'),
        ('Mouvement'),
        ('MovementEquipment'),
        ('Inventory'),
        ('InventoryWorkUnit'),
        ('InventoryCountAttempt'),
        ('Order')
    ) v(TableName)
)
SELECT
    e.TableName,
    CASE
        WHEN t.object_id IS NULL THEN 'MISSING'
        ELSE 'PRESENT'
    END AS Result
FROM ExpectedTables e
LEFT JOIN sys.tables t
    ON t.name = e.TableName
ORDER BY e.TableName;

PRINT '============================================================';
PRINT '3. IMPORTANT COLUMNS';
PRINT '============================================================';

WITH ExpectedColumns(TableName, ColumnName) AS (
    SELECT *
    FROM (VALUES
        ('Equipment', 'equipmentStatus'),
        ('InventoryWorkUnit', 'acceptedAttemptId'),
        ('InventoryWorkUnit', 'reconciledAt'),
        ('InventoryWorkUnit', 'reconciliationStatus'),
        ('Mouvement', 'inventoryId'),
        ('Mouvement', 'origin'),
        ('Mouvement', 'reason'),
        ('MovementEquipment', 'equipmentTypeSnapshot'),
        ('Shelf', 'stockId'),
        ('Stock', 'stockStatusId'),
        ('SerialNumber', 'serialNumberStatus'),
        ('SerialNumber', 'shelfId')
    ) v(TableName, ColumnName)
)
SELECT
    e.TableName,
    e.ColumnName,
    CASE
        WHEN c.column_id IS NULL THEN 'MISSING'
        ELSE 'PRESENT'
    END AS Result,
    ty.name AS SqlType,
    c.max_length AS MaxLength,
    c.is_nullable AS IsNullable
FROM ExpectedColumns e
LEFT JOIN sys.tables t
    ON t.name = e.TableName
LEFT JOIN sys.columns c
    ON c.object_id = t.object_id
    AND c.name = e.ColumnName
LEFT JOIN sys.types ty
    ON ty.user_type_id = c.user_type_id
ORDER BY e.TableName, e.ColumnName;

PRINT '============================================================';
PRINT '4. FOREIGN KEYS';
PRINT '============================================================';

SELECT
    OBJECT_SCHEMA_NAME(fk.parent_object_id) AS SchemaName,
    OBJECT_NAME(fk.parent_object_id) AS TableName,
    fk.name AS ForeignKeyName,
    OBJECT_NAME(fk.referenced_object_id) AS ReferencedTable,
    fk.is_disabled AS IsDisabled,
    fk.is_not_trusted AS IsNotTrusted,
    fk.delete_referential_action_desc AS DeleteAction,
    fk.update_referential_action_desc AS UpdateAction
FROM sys.foreign_keys fk
WHERE
    OBJECT_NAME(fk.parent_object_id) IN (
        'Stock',
        'Shelf',
        'Equipment',
        'EquipmentShelfs',
        'SerialNumber',
        'Mouvement',
        'MovementEquipment',
        'Inventory',
        'InventoryWorkUnit',
        'InventoryCountAttempt',
        'Order'
    )
ORDER BY TableName, ForeignKeyName;

PRINT '============================================================';
PRINT '5. CHECK CONSTRAINTS';
PRINT '============================================================';

SELECT
    OBJECT_SCHEMA_NAME(cc.parent_object_id) AS SchemaName,
    OBJECT_NAME(cc.parent_object_id) AS TableName,
    cc.name AS ConstraintName,
    cc.definition,
    cc.is_disabled AS IsDisabled,
    cc.is_not_trusted AS IsNotTrusted
FROM sys.check_constraints cc
WHERE
    OBJECT_NAME(cc.parent_object_id) IN (
        'Stock',
        'StockStatus',
        'Shelf',
        'Equipment',
        'EquipmentShelfs',
        'SerialNumber',
        'Mouvement',
        'MovementEquipment',
        'Inventory',
        'InventoryWorkUnit',
        'InventoryCountAttempt'
    )
ORDER BY TableName, ConstraintName;

PRINT '============================================================';
PRINT '6. STOCK STATUS DOMAIN';
PRINT '============================================================';

IF OBJECT_ID(N'dbo.StockStatus', N'U') IS NOT NULL
BEGIN
    SELECT
        stockStatusId,
        stockStatusName
    FROM dbo.StockStatus
    ORDER BY stockStatusName;
END
ELSE
BEGIN
    SELECT
        CAST(NULL AS uniqueidentifier) AS stockStatusId,
        CAST('StockStatus table is missing' AS varchar(100)) AS stockStatusName;
END;

PRINT '============================================================';
PRINT '7. CUSTOM HARDENING OBJECTS';
PRINT '============================================================';

WITH ExpectedObjects(ObjectName, ExpectedType) AS (
    SELECT *
    FROM (VALUES
        ('TR_Shelf_RequireActiveStock', 'TRIGGER'),
        ('TR_EquipmentShelfs_RequireActiveStock', 'TRIGGER'),
        ('TR_Mouvement_RequireActiveStocks', 'TRIGGER'),
        ('TR_SerialNumber_Guards', 'TRIGGER'),
        ('TR_InventoryWorkUnit_AcceptedAttempt', 'TRIGGER'),
        ('TR_MovementEquipment_MatchHeader', 'TRIGGER')
    ) v(ObjectName, ExpectedType)
)
SELECT
    e.ObjectName,
    e.ExpectedType,
    CASE
        WHEN o.object_id IS NULL THEN 'MISSING'
        ELSE 'PRESENT'
    END AS Result,
    o.type_desc AS ActualType
FROM ExpectedObjects e
LEFT JOIN sys.objects o
    ON o.name = e.ObjectName
ORDER BY e.ObjectName;

PRINT '============================================================';
PRINT '8. TABLE ROW COUNTS (READ ONLY)';
PRINT '============================================================';

SELECT
    t.name AS TableName,
    SUM(p.rows) AS ApproxRows
FROM sys.tables t
JOIN sys.partitions p
    ON p.object_id = t.object_id
    AND p.index_id IN (0, 1)
WHERE
    t.name IN (
        'Stock',
        'StockStatus',
        'Shelf',
        'Equipment',
        'EquipmentShelfs',
        'SerialNumber',
        'Mouvement',
        'MovementEquipment',
        'Inventory',
        'InventoryWorkUnit',
        'InventoryCountAttempt',
        'Order'
    )
GROUP BY t.name
ORDER BY t.name;

PRINT '============================================================';
PRINT 'AUDIT COMPLETE - NO DATA OR SCHEMA WAS MODIFIED';
PRINT '============================================================';
</file>

<file path="sql/production_apply_guard.sql">
/*
  Run this BEFORE opening FINAL_yacinedb_rebuild.sql.

  READ ONLY.
*/

USE [yacinedb];
GO

IF EXISTS (
    SELECT 1
    FROM sys.tables
    WHERE
        is_ms_shipped = 0
        AND name <> '_prisma_migrations'
)
BEGIN
    THROW 51200,
        'SAFETY STOP: yacinedb is not empty. Do not execute the final rebuild SQL.',
        1;
END;

IF NOT EXISTS (
    SELECT 1
    FROM msdb.dbo.backupset
    WHERE
        LOWER(database_name) = LOWER('yacinedb')
        AND type = 'D'
)
BEGIN
    THROW 51201,
        'SAFETY STOP: no FULL yacinedb backup is recorded in msdb.',
        1;
END;

SELECT
    'READY' AS ProductionDatabaseState,
    DB_NAME() AS DatabaseName;

SELECT TOP (1)
    backup_finish_date AS LatestFullBackupFinish,
    bmf.physical_device_name AS BackupDevice
FROM msdb.dbo.backupset bs
LEFT JOIN msdb.dbo.backupmediafamily bmf
    ON bmf.media_set_id = bs.media_set_id
WHERE
    LOWER(bs.database_name) = LOWER('yacinedb')
    AND bs.type = 'D'
ORDER BY
    bs.backup_finish_date DESC;
GO
</file>

