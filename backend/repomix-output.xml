        AND t.name <> '_prisma_migrations'
      ORDER BY
        s.name,
        t.name
    `);

    return {
      identity,
      userTableCount: userTables.length,
      userTables,
      passed: userTables.length === 0,
    };
  } finally {
    await prisma.$disconnect().catch(() => undefined);
  }
}

async function main() {
