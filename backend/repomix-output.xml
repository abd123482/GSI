    it('23. should update user status when user has user.manage permission', async () => {
      mockPrisma.user.findUnique.mockResolvedValue({
        userId: 'uuid-target-user',
        userStatus: 'PENDING',
      });
      mockPrisma.user.update.mockResolvedValue({
        userId: 'uuid-target-user',
        userStatus: 'ACTIVE',
      });

      const result = await usersAdminService.updateUserStatus(
        'uuid-target-user',
        'ACTIVE',
      );
      expect(mockPrisma.user.update).toHaveBeenCalledWith(
        expect.objectContaining({
          where: { userId: 'uuid-target-user' },
          data: { userStatus: 'ACTIVE' },
        }),
      );
      expect(result.userStatus).toBe('ACTIVE');
    });

    it('24. should reject role assignment without role.manage permission (403)', () => {
      expect(rolesGuard).toBeDefined();
      vi.spyOn(reflector, 'getAllAndOverride').mockReturnValue(['role.manage']);
      const context = createMockContext({}, { permissions: ['user.manage'] });
      expect(() => permissionsGuard.canActivate(context)).toThrow(
        ForbiddenException,
      );
    });

    it('25. should assign role when user has role.manage and role exists', async () => {
      mockPrisma.user.findUnique.mockResolvedValue({
        userId: 'uuid-target-user',
      });
      mockPrisma.role.findUnique.mockResolvedValue({
        roleId: 'role-tech-id',
        roleName: 'TECHNICIAN',
      });
      mockPrisma.user.update.mockResolvedValue({
        userId: 'uuid-target-user',
        roleId: 'role-tech-id',
      });

      const result = await usersAdminService.updateUserRole(
        'uuid-target-user',
        'role-tech-id',
      );
      expect(mockPrisma.user.update).toHaveBeenCalledWith(
        expect.objectContaining({
          where: { userId: 'uuid-target-user' },
          data: { roleId: 'role-tech-id' },
        }),
      );
      expect(result.roleId).toBe('role-tech-id');
    });

    it('26. should allow ADMIN user with zero permissions to access any protected permission route', () => {
      vi.spyOn(reflector, 'getAllAndOverride').mockReturnValue(['stock.delete', 'equipment.delete']);
      const adminContext = createMockContext({}, { roleName: 'ADMIN', permissions: [] });
      expect(permissionsGuard.canActivate(adminContext)).toBe(true);
    });

    it('27. should allow ADMIN user to access route requiring a different specific role', () => {
      vi.spyOn(reflector, 'getAllAndOverride').mockReturnValue(['TECHNICIAN']);
      const adminContext = createMockContext({}, { roleName: 'ADMIN', permissions: [] });
      expect(rolesGuard.canActivate(adminContext)).toBe(true);
    });
  });
});
