# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ============================================================
# CLERK AUTHENTICATION
# ============================================================

CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWT_KEY=your_clerk_jwt_public_key_or_pem
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret

# ============================================================
# SQL SERVER / PRISMA
# ============================================================

DATABASE_URL="sqlserver://localhost:1433;database=YOUR_DATABASE_NAME;user=YOUR_USERNAME;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

DB_HOST=localhost
DB_PORT=1433
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
