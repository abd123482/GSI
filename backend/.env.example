# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

PORT=3001

FRONTEND_URL=http://localhost:3000


# ============================================================
# SQL SERVER / PRISMA
# ============================================================

DATABASE_URL="sqlserver://localhost:1433;database=YOUR_DATABASE_NAME;user=YOUR_USERNAME;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"


# ============================================================
# JWT
# ============================================================

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d


# ============================================================
# SECURITY
# ============================================================

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
