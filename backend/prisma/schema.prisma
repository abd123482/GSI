generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlserver"
}

model Role {
  roleId      String       @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  roleName    String       @db.VarChar(100)
  permissions Permission[]
  users       User[]

  @@map("Role")
}

model Permission {
  permissionId   String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  permissionName String  @db.VarChar(200)
  roleId         String? @db.UniqueIdentifier

  role Role? @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Permission")
}

model User {
  userId       String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  userName     String  @default("yacine") @db.VarChar(50)
  userEmail    String  @db.VarChar(100)
  hashPassword String? @db.VarChar(255)
  roleId       String? @db.UniqueIdentifier
  userStatus   String  @default("ACTIVE") @db.VarChar(50)
  clerkUserId  String? @unique(map: "idx_user_clerkUserId_unique", where: raw("([clerkUserId] IS NOT NULL)")) @db.VarChar(255)

  role                       Role?                 @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
  movementsCreated           Mouvement[]           @relation("MovementCreatedByUser")
  notifications              Notification[]
  inventoryControllers       InventoryController[]
  inventoryIssuesResolved    InventoryIssue[]      @relation("InventoryIssueResolvedBy")
  inventoriesCreated         Inventory[]           @relation("InventoryCreator")
  inventoryAdjustmentsApproved Inventory[]         @relation("InventoryAdjustmentApprover")

  @@map("User")
}

model Equipment {
  equipmentId         String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  equipmentName       String @unique(map: "UX_Equipment_EquipmentName") @db.VarChar(200)
  hasSerialNumber     Boolean
  minequipmentQuantity Int    @default(0)
  equipmentStatus     String @db.VarChar(30)

  movementItems  MovementEquipment[]
  serialNumbers  SerialNumber[]
  inventoryUnits InventoryUnit[]

  @@map("Equipment")
}

model SerialNumber {
  serialNumberId     String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  serialNumberCode   String @unique(map: "UX_SerialNumber_Code") @db.VarChar(200)
  serialNumberStatus String @db.VarChar(100)
  equipmentId        String @db.UniqueIdentifier

  equipment     Equipment           @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction)
  movementItems MovementEquipment[]

  @@map("SerialNumber")
}

model Stock {
  stockId   String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  stockName String? @db.VarChar(100)
  status    Boolean @default(true)

  shelves Shelf[]

  @@map("Stock")
}

model Shelf {
  shelfId   String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  shelfName String? @db.VarChar(100)
  stockId   String  @db.UniqueIdentifier
  status    Boolean @default(true)

  stock                Stock               @relation(fields: [stockId], references: [stockId], onDelete: NoAction, onUpdate: NoAction)
  movementSources      MovementEquipment[] @relation("MovementItemSource")
  movementDestinations MovementEquipment[] @relation("MovementItemDestination")
  inventoryUnits       InventoryUnit[]

  @@map("Shelf")
}

model Inventory {
  inventoryId          String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  typeInventory        String?   @db.VarChar(50)
  createdAt            DateTime? @default(dbgenerated("sysdatetime()")) @db.DateTime2
  parentInventoryId    String?   @db.UniqueIdentifier
  status               String    @default("DRAFT") @db.VarChar(50)
  cancellationReason   String?   @db.VarChar(500)
  policyVersion        Int?      @default(1)
  finalizedAt          DateTime? @db.DateTime2
  title                String?   @db.VarChar(200)
  launchedAt           DateTime? @db.DateTime2
  creatorId            String?   @db.UniqueIdentifier
  adjustmentApproverId String?   @db.UniqueIdentifier

  parentInventory    Inventory? @relation("InventoryHierarchy", fields: [parentInventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction)
  subInventories     Inventory[] @relation("InventoryHierarchy")

  creator            User? @relation("InventoryCreator", fields: [creatorId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  adjustmentApprover User? @relation("InventoryAdjustmentApprover", fields: [adjustmentApproverId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  controllers InventoryController[]
  units       InventoryUnit[]
  issues      InventoryIssue[]
  movements   Mouvement[]

  @@map("Inventory")
}

model InventoryController {
  inventoryControllerId String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId           String @db.UniqueIdentifier
  userId                String @db.UniqueIdentifier
  round                 Int

  inventory Inventory        @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction)
  user      User             @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  counts    InventoryCount[]

  @@map("InventoryController")
}

model InventoryCount {
  countId               String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  unitId                String    @db.UniqueIdentifier
  inventoryControllerId String    @db.UniqueIdentifier
  resultData            String?   @db.NVarChar(Max)
  createdAt             DateTime  @default(dbgenerated("sysdatetime()")) @db.DateTime2
  submittedAt           DateTime? @db.DateTime2

  unit                InventoryUnit       @relation("InventoryUnitCounts", fields: [unitId], references: [unitId], onDelete: NoAction, onUpdate: NoAction)
  inventoryController InventoryController @relation(fields: [inventoryControllerId], references: [inventoryControllerId], onDelete: NoAction, onUpdate: NoAction)
  acceptedByUnits     InventoryUnit[]     @relation("InventoryAcceptedCount")

  @@map("InventoryCount")
}

model InventoryIssue {
  issueId          String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId      String    @db.UniqueIdentifier
  unitId           String?   @db.UniqueIdentifier
  type             String    @db.VarChar(100)
  data             String    @db.NVarChar(Max)
  resolvedByUserId String?   @db.UniqueIdentifier
  resolvedAt       DateTime? @db.DateTime2
  createdAt        DateTime  @default(dbgenerated("sysdatetime()")) @db.DateTime2

  inventory      Inventory      @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction)
  unit           InventoryUnit? @relation(fields: [unitId], references: [unitId], onDelete: NoAction, onUpdate: NoAction)
  resolvedByUser User?          @relation("InventoryIssueResolvedBy", fields: [resolvedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("InventoryIssue")
}

model InventoryUnit {
  unitId               String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId          String    @db.UniqueIdentifier
  equipmentId          String?   @db.UniqueIdentifier
  shelfId              String?   @db.UniqueIdentifier
  status               String    @default("DRAFT") @db.VarChar(50)
  reconciliationStatus String    @default("PENDING") @db.VarChar(30)
  acceptedCountId      String?   @db.UniqueIdentifier
  snapshotData         String?   @db.NVarChar(Max)
  reconciledAt         DateTime? @db.DateTime2

  inventory     Inventory       @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction)
  equipment     Equipment?      @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction)
  shelf         Shelf?          @relation(fields: [shelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction)

  counts        InventoryCount[] @relation("InventoryUnitCounts")
  acceptedCount InventoryCount?  @relation("InventoryAcceptedCount", fields: [acceptedCountId], references: [countId], onDelete: NoAction, onUpdate: NoAction)
  issues        InventoryIssue[]

  @@map("InventoryUnit")
}

model Mouvement {
  mouvementId       String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  mouvementStatus   String?   @db.VarChar(50)
  createdAt         DateTime? @default(dbgenerated("sysdatetime()")) @db.DateTime2
  createdByUserId   String?   @db.UniqueIdentifier
  inventoryId       String?   @db.UniqueIdentifier
  origin            Boolean
  reason            String?   @db.NVarChar(1000)
  happenedAt        DateTime  @default(dbgenerated("sysutcdatetime()")) @db.DateTime2

  createdByUser User?      @relation("MovementCreatedByUser", fields: [createdByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  inventory     Inventory? @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction)
  items         MovementEquipment[]

  @@map("Mouvement")
}

model MovementEquipment {
  movementEquipmentId  String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  movementId           String  @db.UniqueIdentifier
  equipmentId          String  @db.UniqueIdentifier
  sourceShelfId        String? @db.UniqueIdentifier
  destinationShelfId   String? @db.UniqueIdentifier
  serialNumberId       String? @db.UniqueIdentifier
  equipmentQuantity    Int
  equipmentTypeSnapshot String @default("STANDARD") @db.VarChar(20)

  movement         Mouvement     @relation(fields: [movementId], references: [mouvementId], onDelete: Cascade, onUpdate: NoAction)
  equipment        Equipment     @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction)
  sourceShelf      Shelf?        @relation("MovementItemSource", fields: [sourceShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction)
  destinationShelf Shelf?        @relation("MovementItemDestination", fields: [destinationShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction)
  serialNumber     SerialNumber? @relation(fields: [serialNumberId], references: [serialNumberId], onDelete: NoAction, onUpdate: NoAction)

  @@map("MovementEquipment")
}

model Notification {
  notificationId String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  recipientId    String    @db.UniqueIdentifier
  eventType      String    @db.VarChar(100)
  payload        String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(dbgenerated("sysdatetime()")) @db.DateTime2
  readAt         DateTime? @db.DateTime2

  recipient User @relation(fields: [recipientId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Notification")
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id @default(autoincrement())
  version      Int?
  definition   Bytes? @db.VarBinary(Max)

  @@unique([principal_id, name])
  @@map("sysdiagrams")
}