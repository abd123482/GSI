generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlserver"
}

model Role {
  roleId      String       @id(map: "PK_Role") @default(dbgenerated("newid()"), map: "DF__Role__roleId__43A1090D") @db.UniqueIdentifier
  roleName    String       @db.VarChar(100)
  permissions Permission[]
  users       User[]
  orders      Order[]

  @@map("Role")
}

model Permission {
  permissionId   String  @id(map: "PK_Permission") @default(dbgenerated("newid()"), map: "DF__Permissio__permi__4C364F0E") @db.UniqueIdentifier
  permissionName String  @db.VarChar(200)
  roleId         String? @db.UniqueIdentifier
  role           Role?   @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Permission_Role")

  @@map("Permission")
}

model User {
  userId           String                        @id(map: "PK_User") @default(dbgenerated("newid()"), map: "DF__User__userId__467D75B8") @db.UniqueIdentifier
  userName         String                        @default("yacine", map: "DF__User__userName__477199F1") @db.VarChar(50)
  userEmail        String                        @db.VarChar(100)
  hashPassword     String?                       @db.VarChar(255)
  roleId           String?                       @db.UniqueIdentifier
  userStatus       String                        @default("ACTIVE", map: "DF__User__userStatus__4865BE2A") @db.VarChar(50)
  clerkUserId      String?                       @unique(map: "idx_user_clerkUserId_unique", where: raw("([clerkUserId] IS NOT NULL)")) @db.VarChar(255)
  Inventory_User   Inventory_User[]
  sessions         Session[]
  orders           Order[]
  attempts         InventoryCountAttempt[]
  notifications    Notification[]
  movementsCreated Mouvement[]                   @relation("MovementCreatedByUser")
  issuesResolved   InventoryInvestigationIssue[] @relation("IssueResolvedByUser")
  role             Role?                         @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction, map: "FK_User_Role")

  @@map("User")
}

model Session {
  sessionId String   @id(map: "PK_Session") @default(dbgenerated("newid()"), map: "DF__Session__session__5006DFF2") @db.UniqueIdentifier
  createdAt DateTime @default(dbgenerated("sysdatetime()"), map: "DF__Session__created__50FB042B")
  expiresAt DateTime
  userId    String   @db.UniqueIdentifier
  user      User     @relation(fields: [userId], references: [userId], onUpdate: NoAction, map: "FK_Session_User")

  @@map("Session")
}

model Equipment {
  movementItems        MouvementEquipment[]
  equipmentId          String                            @id(map: "PK_Equipment") @unique(map: "UX_Equipment_EquipmentId") @default(dbgenerated("newid()"), map: "DF__Equipment__equip__1E6F845E") @db.UniqueIdentifier
  equipmentName        String                            @unique(map: "UX_Equipment_EquipmentName") @db.VarChar(200)
  hasSerialNumber      Boolean
  equipmentQuantity    Int
  minequipmentQuantity Int                               @default(0, map: "DF__Equipment__mineq__1F63A897")
  equipmentStatus      String                            @default("ACTIVE", map: "DF_Equipment_EquipmentStatus") @db.VarChar(30)
  equipmentShelfId     String?                           @db.UniqueIdentifier
  equipmentMouvements  EquipmentMouvement[]
  equipmentShelfs      EquipmentShelfs[]
  mouvements           Mouvement[]
  serialNumbers        SerialNumber[]
  orders               Order[]
  serialSnapshots      Inventory_SerialNumber_Snapshot[]
  investigationIssues  InventoryInvestigationIssue[]

  @@index([equipmentId], map: "IDX_Equipment_EquipmentId")
  @@index([equipmentName], map: "IDX_Equipment_EquipmentName")
  @@index([equipmentShelfId], map: "IDX_Equipment_EquipmentShelfId")
  @@index([hasSerialNumber], map: "IDX_Equipment_HasSerialNumber")
  @@index([minequipmentQuantity], map: "IDX_Equipment_MinEquipmentQuantity")
  @@index([equipmentName], map: "IX_Equipment_EquipmentName")
  @@index([equipmentStatus], map: "IX_Equipment_Status")
  @@map("Equipment")
}

model SerialNumber {
  movementItems       MouvementEquipment[]
  serialNumberId      String                        @id(map: "PK_SerialNumber") @default(dbgenerated("newid()"), map: "DF__SerialNum__seria__22401542") @db.UniqueIdentifier
  serialNumberCode    String                        @unique(map: "UX_SerialNumber_Code") @db.VarChar(200)
  serialNumberStatus  String                        @default("AVAILABLE", map: "DF_SerialNumber_Status") @db.VarChar(100)
  equipmentId         String                        @db.UniqueIdentifier
  shelfId             String?                       @db.UniqueIdentifier
  mouvements          Mouvement[]
  orders              Order[]
  investigationIssues InventoryInvestigationIssue[]
  equipment           Equipment                     @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_SerialNumber_Equipment")
  shelf               Shelf?                        @relation(fields: [shelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_SerialNumber_Shelf")

  @@index([serialNumberCode], map: "IDX_SerialNumber_SerialNumberCode")
  @@index([serialNumberId], map: "IDX_SerialNumber_SerialNumberId")
  @@index([equipmentId, shelfId], map: "IX_SerialNumber_Equipment_Shelf")
  @@index([shelfId], map: "IX_SerialNumber_ShelfId")
  @@index([serialNumberStatus], map: "IX_SerialNumber_Status")
  @@map("SerialNumber")
}

model Shelf {
  movementSources       MouvementEquipment[]              @relation("MovementItemSource")
  movementDestinations  MouvementEquipment[]              @relation("MovementItemDestination")
  shelfId               String                            @id(map: "PK_Shelf") @default(dbgenerated("newid()"), map: "DF__Shelf__shelfId__29E1370A") @db.UniqueIdentifier
  shelfName             String?                           @db.VarChar(100)
  shelfQuantity         Int                               @default(0, map: "DF_Shelf_ShelfQuantity")
  stockId               String                            @db.UniqueIdentifier
  equipmentShelfs       EquipmentShelfs[]
  sourceMouvements      Mouvement[]                       @relation("SourceShelf")
  destinationMouvements Mouvement[]                       @relation("DestinationShelf")
  serialNumbers         SerialNumber[]
  orders                Order[]
  serialSnapshots       Inventory_SerialNumber_Snapshot[]
  expectedIssues        InventoryInvestigationIssue[]     @relation("ExpectedShelf")
  observedIssues        InventoryInvestigationIssue[]     @relation("ObservedShelf")
  resolutionIssues      InventoryInvestigationIssue[]     @relation("ResolutionShelf")
  stock                 Stock                             @relation(fields: [stockId], references: [stockId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Shelf_Stock")

  @@index([shelfId], map: "INDEX_Shelf_ShelfId")
  @@index([shelfName], map: "INDEX_Shelf_ShelfName")
  @@index([shelfQuantity], map: "INDEX_Shelf_ShelfQuantity")
  @@index([stockId], map: "IX_Shelf_StockId")
  @@map("Shelf")
}

model StockStatus {
  stockStatusId   String  @id(map: "PK__StockSta__EC5FDC3570BCF5AF") @default(dbgenerated("newid()"), map: "DF__StockStat__stock__7073AF84") @db.UniqueIdentifier
  stockStatusName String  @unique(map: "UQ__StockSta__E053D81017965D3C") @db.VarChar(50)
  stocks          Stock[]

  @@map("StockStatus")
}

model Stock {
  stockId       String      @id(map: "PK__Stock__CBAD876353C2F93A") @default(dbgenerated("newid()"), map: "DF__Stock__stockId__69C6B1F5") @db.UniqueIdentifier
  stockName     String?     @db.VarChar(100)
  stockStatusId String      @db.UniqueIdentifier
  shelves       Shelf[]
  stockStatus   StockStatus @relation(fields: [stockStatusId], references: [stockStatusId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Stock_StockStatus")

  @@index([stockId], map: "Stock_StockId")
  @@index([stockName], map: "Stock_StockName")
  @@index([stockStatusId], map: "IX_Stock_StockStatusId")
  @@map("Stock")
}

model Mouvement {
  items       MouvementEquipment[]
  mouvementId String               @id(map: "mouvementId") @default(dbgenerated("newid()"), map: "DF__Mouvement__mouve__2DB1C7EE") @db.UniqueIdentifier

  // Header summary only. Child lines in MovementEquipment are authoritative.
  // If all child lines have the same type this is IN / OUT / TRANSFER.
  // If child lines have different types this is MIXED.
  mouvementStatus String? @db.VarChar(50)

  // Sum of child line quantities.
  mouvementQuantity Int? @map("movementQuantity")

  // Legacy compatibility fields. New multi-line movements keep these NULL.
  // A single-line movement may mirror its child values here.
  equipmentId        String? @db.UniqueIdentifier
  sourceShelfId      String? @db.UniqueIdentifier
  destinationShelfId String? @db.UniqueIdentifier
  serialNumberId     String? @db.UniqueIdentifier

  createdAt       DateTime? @default(dbgenerated("sysdatetime()"))
  createdByUserId String?   @db.UniqueIdentifier

  // Inventory adjustment audit fields added in SQL Server.
  inventoryId String? @db.UniqueIdentifier
  origin      String  @default("USER", map: "DF_Mouvement_Origin") @db.VarChar(30)
  reason      String? @db.NVarChar(1000)

  createdByUser    User?         @relation("MovementCreatedByUser", fields: [createdByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Mouvement_CreatedByUser")
  inventory        Inventory?    @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Mouvement_Inventory")
  serialNumber     SerialNumber? @relation(fields: [serialNumberId], references: [serialNumberId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Mouvement_SerialNumber")
  sourceShelf      Shelf?        @relation("SourceShelf", fields: [sourceShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Mouvement_Shelfsource")
  equipment        Equipment?    @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_MouvementEequipment")
  destinationShelf Shelf?        @relation("DestinationShelf", fields: [destinationShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_SerialNumber_Shelfdestination")

  @@index([equipmentId], map: "IDX_Mouvement_EquipmentId")
  @@index([createdAt, mouvementId], map: "IX_Mouvement_CreatedAt_Id")
  @@index([mouvementStatus], map: "IX_Mouvement_Status")
  @@index([inventoryId], map: "IX_Mouvement_InventoryId")
  @@map("Mouvement")
}

model EquipmentShelfs {
  equipmentShelfId  String    @id(map: "PK_EquipmentShelfs") @default(dbgenerated("newid()"), map: "DF__Equipment__equip__2610A626") @db.UniqueIdentifier
  equipmentQuantity Int       @default(0, map: "DF_EquipmentShelfs_Quantity")
  equipmentId       String    @db.UniqueIdentifier
  shelfId           String    @db.UniqueIdentifier
  equipment         Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_EquipmentShelfs_Equipment")
  shelf             Shelf     @relation(fields: [shelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_EquipmentShelfs_Shelf")

  // One equipment can have only one allocation row per shelf.
  @@unique([equipmentId, shelfId], map: "UX_EquipmentShelfs_Equipment_Shelf")
  @@index([equipmentId], map: "IX_EquipmentShelfs_EquipmentId")
  @@index([shelfId], map: "IX_EquipmentShelfs_ShelfId")
  @@map("EquipmentShelfs")
}

model EquipmentMouvement {
  equipmentMouvementsId String     @id(map: "PK_EqipmentMouvements") @default(dbgenerated("newid()"), map: "DF__EqipmentM__equip__318258D2") @db.UniqueIdentifier
  equipmentQuantity     Int?
  equipmentId           String?    @db.UniqueIdentifier
  shelfId               String?    @db.UniqueIdentifier
  equipment             Equipment? @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_EqipmentMouvements_Equipment")

  @@map("EqipmentMouvements")
}

model Inventory {
  inventoryId        String    @id(map: "PK__Inventor__C4B7BC02CCF87E0E") @default(dbgenerated("newid()"), map: "DF__Inventory__inven__7AF13DF7") @db.UniqueIdentifier
  typeInventory      String?   @db.VarChar(50)
  createdAt          DateTime? @default(now(), map: "DF__Inventory__creat__7BE56230")
  parentInventoryId  String?   @db.UniqueIdentifier
  status             String    @default("DRAFT") @db.VarChar(50)
  cancellationReason String?   @db.VarChar(500)
  cutoffVersion      Int?      @default(0)
  policyVersion      Int?      @default(1)
  finalizedAt        DateTime?
  title              String?   @db.VarChar(200)

  // V2 Workflow Fields
  finalResultSource  String?   @db.VarChar(50)
  thirdCountRequired Boolean   @default(false)
  launchedAt         DateTime?
  creatorId          String?   @db.UniqueIdentifier

  // Merged Adjustment Fields
  adjustmentApproverId String? @db.UniqueIdentifier
  adjustmentReason     String? @db.NVarChar(1000)
  adjustmentBatchData  String? @db.NVarChar(Max)

  // Merged Scope Fields
  equipmentScopeIds String? @db.NVarChar(Max)
  shelfScopeIds     String? @db.NVarChar(Max)

  parentInventory     Inventory?                        @relation("InventoryHierarchy", fields: [parentInventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction, map: "FK__Inventory__paren__7CD98669")
  subInventories      Inventory[]                       @relation("InventoryHierarchy")
  Inventory_User      Inventory_User[]
  orders              Order[]
  workUnits           InventoryWorkUnit[]
  serialSnapshots     Inventory_SerialNumber_Snapshot[]
  investigationIssues InventoryInvestigationIssue[]
  adjustmentMovements Mouvement[]

  @@index([status], map: "IX_Inventory_Status")
}

model Inventory_User {
  inventoryId    String    @db.UniqueIdentifier
  userId         String    @db.UniqueIdentifier
  sequence       Int       @default(0)
  responsibility String?   @db.VarChar(50)
  roleSnapshot   String?   @db.VarChar(100)
  Inventory      Inventory @relation(fields: [inventoryId], references: [inventoryId], onUpdate: NoAction, map: "FK__Inventory__inven__7FB5F314")
  User           User      @relation(fields: [userId], references: [userId], onUpdate: NoAction, map: "FK__Inventory__userI__00AA174D")

  @@id([inventoryId, userId], map: "PK__Inventor__280E1DCDF3168EB2")
  @@unique([inventoryId, sequence], map: "UX_Inventory_User_Inventory_Sequence")
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B613770EED4") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}

model Order {
  orderId             String   @id(map: "PK_Order") @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId         String?  @db.UniqueIdentifier
  serialNumberId      String?  @db.UniqueIdentifier
  scannedSerialCode   String?  @db.VarChar(200)
  equipmentId         String?  @db.UniqueIdentifier
  shelfId             String?  @db.UniqueIdentifier
  roleId              String?  @db.UniqueIdentifier
  userId              String?  @db.UniqueIdentifier
  quantityCalculated  Int?
  isExplicitZero      Boolean  @default(false)
  isUnexpected        Boolean  @default(false)
  createdAt           DateTime @default(dbgenerated("sysdatetime()"))
  attemptId           String?  @db.UniqueIdentifier
  observedEquipmentId String?  @db.UniqueIdentifier
  observedShelfId     String?  @db.UniqueIdentifier
  notes               String?  @db.NVarChar(1000)
  unknownItemEvidence String?  @db.NVarChar(Max)

  equipment    Equipment?             @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_Equipment")
  inventory    Inventory?             @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_Inventory")
  role         Role?                  @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_Role")
  serialNumber SerialNumber?          @relation(fields: [serialNumberId], references: [serialNumberId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_SerialNumber")
  shelf        Shelf?                 @relation(fields: [shelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_Shelf")
  user         User?                  @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_User")
  attempt      InventoryCountAttempt? @relation(fields: [attemptId], references: [attemptId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Order_Attempt")

  @@index([equipmentId], map: "IDX_Order_EquipmentId")
  @@index([inventoryId], map: "IDX_Order_InventoryId")
  @@index([roleId], map: "IDX_Order_RoleId")
  @@index([serialNumberId], map: "IDX_Order_SerialNumberId")
  @@index([shelfId], map: "IDX_Order_ShelfId")
  @@index([userId], map: "IDX_Order_UserId")
  @@index([attemptId], map: "IDX_Order_AttemptId")
  @@map("Order")
}

model InventoryWorkUnit {
  unitId      String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId String  @db.UniqueIdentifier
  equipmentId String? @db.UniqueIdentifier
  shelfId     String? @db.UniqueIdentifier
  unitOrder   Int     @default(0)
  status      String  @default("DRAFT") @db.VarChar(50)
  version     Int     @default(0)
  coverage    String? @db.NVarChar(Max) // JSON describing coverage metadata

  // Per-unit reconciliation fields added in SQL Server.
  reconciliationStatus String    @default("PENDING", map: "DF_InventoryWorkUnit_ReconciliationStatus") @db.VarChar(30)
  acceptedAttemptId    String?   @db.UniqueIdentifier
  reconciledAt         DateTime? @db.DateTime2

  // Merged Discrepancy Fields
  discrepancyType       String? @db.VarChar(100)
  discrepancyState      String? @db.VarChar(50)
  discrepancyBeforeData String? @db.NVarChar(Max)
  discrepancyAfterData  String? @db.NVarChar(Max)
  discrepancyActorId    String? @db.UniqueIdentifier
  discrepancyReason     String? @db.NVarChar(1000)

  inventory       Inventory               @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction, map: "FK_WorkUnit_Inventory")
  attempts        InventoryCountAttempt[] @relation("UnitAttempts")
  acceptedAttempt InventoryCountAttempt?  @relation("AcceptedAttempt", fields: [acceptedAttemptId], references: [attemptId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventoryWorkUnit_AcceptedAttempt")

  @@index([inventoryId], map: "IDX_WorkUnit_InventoryId")
  @@index([equipmentId, inventoryId], map: "IX_InventoryWorkUnit_Equipment_Inventory")
  @@index([shelfId, inventoryId], map: "IX_InventoryWorkUnit_Shelf_Inventory")
  @@index([inventoryId, reconciliationStatus], map: "IX_InventoryWorkUnit_Reconciliation")
  @@map("InventoryWorkUnit")
}

model InventoryCountAttempt {
  attemptId            String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  unitId               String    @db.UniqueIdentifier
  assignedUserId       String    @db.UniqueIdentifier
  sequence             Int       @default(0)
  purpose              String    @db.VarChar(50) // e.g. "PRIMARY_1", "PRIMARY_2", "FINAL_RECOUNT"
  status               String    @default("AVAILABLE") @db.VarChar(50) // "BLOCKED", "AVAILABLE", "IN_PROGRESS", "SUBMITTED", "SKIPPED", "CANCELLED"
  draftData            String?   @db.NVarChar(Max)
  createdAt            DateTime  @default(now())
  submittedAt          DateTime?
  version              Int       @default(0)
  linkedPriorAttemptId String?   @db.UniqueIdentifier

  unit                InventoryWorkUnit   @relation("UnitAttempts", fields: [unitId], references: [unitId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Attempt_WorkUnit")
  acceptedByWorkUnits InventoryWorkUnit[] @relation("AcceptedAttempt")
  assignedUser        User                @relation(fields: [assignedUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Attempt_User")
  orders              Order[]

  @@unique([unitId, sequence], map: "UX_InventoryCountAttempt_Unit_Sequence")
  @@index([unitId], map: "IDX_Attempt_UnitId")
  @@index([assignedUserId], map: "IDX_Attempt_UserId")
  @@map("InventoryCountAttempt")
}

model Inventory_Equipment_Shelf_Snapshot {
  snapshotId        String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId       String  @db.UniqueIdentifier
  equipmentId       String  @db.UniqueIdentifier
  shelfId           String  @db.UniqueIdentifier
  phase             String  @db.VarChar(50) // "PREVIOUS", "LIVE_AT_LAUNCH", "FINALIZED"
  quantity          Int
  provenance        String? @db.NVarChar(1000)
  sourceInventoryId String? @db.UniqueIdentifier
  coverage          String? @db.NVarChar(Max)

  @@index([inventoryId], map: "IDX_Snapshot_InventoryId")
  @@index([equipmentId, shelfId], map: "IDX_Snapshot_Eq_Shelf")
  @@map("Inventory_Equipment_Shelf_Snapshot")
}

model Inventory_SerialNumber_Snapshot {
  snapshotId         String   @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId        String   @db.UniqueIdentifier
  phase              String   @db.VarChar(50) // "PREVIOUS", "LIVE_AT_LAUNCH", "FINALIZED"
  serialNumberId     String?  @db.UniqueIdentifier
  serialNumberCode   String   @db.VarChar(200)
  equipmentId        String   @db.UniqueIdentifier
  shelfId            String?  @db.UniqueIdentifier
  serialNumberStatus String?  @db.VarChar(100)
  provenance         String?  @db.NVarChar(1000)
  sourceInventoryId  String?  @db.UniqueIdentifier
  createdAt          DateTime @default(dbgenerated("sysdatetime()"))

  inventory Inventory @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction, map: "FK_SnSnapshot_Inventory")
  equipment Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_SnSnapshot_Equipment")
  shelf     Shelf?    @relation(fields: [shelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_SnSnapshot_Shelf")

  @@index([inventoryId], map: "IDX_SnSnapshot_InventoryId")
  @@index([equipmentId], map: "IDX_SnSnapshot_EquipmentId")
  @@index([serialNumberCode], map: "IDX_SnSnapshot_SerialCode")
  @@map("Inventory_SerialNumber_Snapshot")
}

model InventoryInvestigationIssue {
  issueId              String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  inventoryId          String    @db.UniqueIdentifier
  issueType            String    @db.VarChar(100)
  status               String    @default("OPEN") @db.VarChar(50) // "OPEN", "RESOLVED", "CANCELLED"
  equipmentId          String?   @db.UniqueIdentifier
  serialNumberId       String?   @db.UniqueIdentifier
  serialNumberCode     String?   @db.VarChar(200)
  expectedShelfId      String?   @db.UniqueIdentifier
  finalObservedShelfId String?   @db.UniqueIdentifier
  expectedQuantity     Int?
  finalQuantity        Int?
  deltaQuantity        Int?
  movementExplanation  String?   @db.VarChar(100) // "EXPLAINED_BY_RECORDED_MOVEMENT", "PARTIALLY_EXPLAINED", "UNEXPLAINED_VARIANCE", "MOVEMENT_HISTORY_UNAVAILABLE"
  resolutionType       String?   @db.VarChar(100) // "FOUND_IN_ANOTHER_LOCATION", "MOVED_WITHOUT_RECORDED_MOVEMENT", "LOST"
  resolutionShelfId    String?   @db.UniqueIdentifier
  resolutionNotes      String?   @db.NVarChar(1000)
  resolvedByUserId     String?   @db.UniqueIdentifier
  resolvedAt           DateTime?
  createdAt            DateTime  @default(dbgenerated("sysdatetime()"))

  inventory          Inventory     @relation(fields: [inventoryId], references: [inventoryId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_Inventory")
  equipment          Equipment?    @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_Equipment")
  serialNumber       SerialNumber? @relation(fields: [serialNumberId], references: [serialNumberId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_SerialNumber")
  expectedShelf      Shelf?        @relation("ExpectedShelf", fields: [expectedShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_ExpectedShelf")
  finalObservedShelf Shelf?        @relation("ObservedShelf", fields: [finalObservedShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_ObservedShelf")
  resolutionShelf    Shelf?        @relation("ResolutionShelf", fields: [resolutionShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_ResolutionShelf")
  resolvedByUser     User?         @relation("IssueResolvedByUser", fields: [resolvedByUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvIssue_User")

  @@index([inventoryId], map: "IDX_InvIssue_InventoryId")
  @@index([status], map: "IDX_InvIssue_Status")
  @@index([equipmentId], map: "IDX_InvIssue_EquipmentId")
  @@map("InventoryInvestigationIssue")
}

model Notification {
  notificationId String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  recipientId    String    @db.UniqueIdentifier
  eventType      String    @db.VarChar(100)
  payload        String?   @db.NVarChar(Max) // JSON
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  recipient User @relation(fields: [recipientId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Notification_User")

  @@index([recipientId], map: "IDX_Notification_RecipientId")
  @@index([createdAt], map: "IDX_Notification_CreatedAt")
  @@map("Notification")
}

// Equipment and shelf allocations belonging to one movement header.
model MouvementEquipment {
  // Prisma field names stay compatible with the existing NestJS code.
  // @map/@@map align them with the physical SQL names shown in SSMS.
  mouvementEquipmentId String @id @default(dbgenerated("newid()")) @map("movementEquipmentId") @db.UniqueIdentifier
  mouvementId          String @map("movementId") @db.UniqueIdentifier
  equipmentId          String @db.UniqueIdentifier
  rowNum               Int    @map("RowNum")

  sourceShelfId      String? @db.UniqueIdentifier
  destinationShelfId String? @db.UniqueIdentifier
  serialNumberId     String? @db.UniqueIdentifier

  // Physical SQL column: equipmentQuantity.
  mouvementQuantity Int @map("equipmentQuantity")

  // Canonical movement type FOR THIS ARTICLE LINE.
  // Allowed canonical values written by new code: IN / OUT / TRANSFER.
  mouvementStatus String @map("movementStatus") @db.VarChar(50)

  // Historical equipment type at movement time.
  equipmentTypeSnapshot String @default("STANDARD", map: "DF_MovementEquipment_TypeSnapshot") @db.VarChar(20)

  mouvement        Mouvement     @relation(fields: [mouvementId], references: [mouvementId], onDelete: Cascade, onUpdate: NoAction, map: "FK_MovementEquipment_Mouvement")
  equipment        Equipment     @relation(fields: [equipmentId], references: [equipmentId], onDelete: NoAction, onUpdate: NoAction, map: "FK_MovementEquipment_Equipment")
  sourceShelf      Shelf?        @relation("MovementItemSource", fields: [sourceShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_MovementEquipment_SourceShelf")
  destinationShelf Shelf?        @relation("MovementItemDestination", fields: [destinationShelfId], references: [shelfId], onDelete: NoAction, onUpdate: NoAction, map: "FK_MovementEquipment_DestinationShelf")
  serialNumber     SerialNumber? @relation(fields: [serialNumberId], references: [serialNumberId], onDelete: NoAction, onUpdate: NoAction, map: "FK_MovementEquipment_SerialNumber")

  @@unique([mouvementId, rowNum], map: "UX_MovementEquipment_Movement_RowNum")
  @@index([mouvementId], map: "IX_MovementEquipment_MovementId")
  @@index([equipmentId], map: "IX_MovementEquipment_EquipmentId")
  @@index([mouvementStatus], map: "IX_MovementEquipment_Status")
  @@index([sourceShelfId], map: "IX_MovementEquipment_SourceShelfId")
  @@index([destinationShelfId], map: "IX_MovementEquipment_DestinationShelfId")
  @@index([serialNumberId], map: "IX_MovementEquipment_SerialNumberId")
  @@map("MovementEquipment")
}
